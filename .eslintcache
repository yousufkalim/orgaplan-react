ctjs/src/pages/Admin/Means/Historic.js",["443","444","445","446","447","448","449","450","451","452","453","454","455","456"],"import React, { useState, useEffect } from \"react\";\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\nimport * as Yup from \"yup\";\n\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\n\nimport { useFormik } from \"formik\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\n// import Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SmallButton from \"../../../components/SmallButton\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport FormInput from \"../../../components/FormInput\";\n\nimport SiteImage from \"../../../assets/images/Site.png\";\nimport { Images } from \"../../../assets/Assets\";\n\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  link: {\n    marginRight: 20,\n    whiteSpace: \"nowrap\",\n    color: theme.palette.primary.contrastText,\n  },\n  image: {\n    height: 70,\n    borderRadius: theme.shape.borderRadius,\n  },\n}));\n\nconst addClientYup = Yup.object().shape({\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\n  name: Yup.string().required(\"Required\"),\n  color: Yup.string().required(\"Required\"),\n  firstName: Yup.string().required(\"Required\"),\n  lastName: Yup.string().required(\"Required\"),\n  email: Yup.string().required(\"Required\"),\n  phone: Yup.number()\n    .test(\n      \"len\",\n      \"Must be exactly 10 characters\",\n      (val) => val && val.toString().length === 10,\n    )\n    .required(\"Required\"),\n  contractType: Yup.string().required(\"Required\"),\n  contractStartDate: Yup.string().required(\"Required\"),\n  contractEndDate: Yup.string().required(\"Required\"),\n  functionality: Yup.string().required(\"Required\"),\n  additionalInfo: Yup.string(),\n  notificationPriorToDays: Yup.number(),\n  notificationTo: Yup.array(),\n});\n\nconst Historic = () => {\n  const classes = useStyles();\n  const theme = useTheme();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [loading, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n  const [page] = useState(1);\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.SITES}?page=${page}`,\n      });\n      setItems(result.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const rows = GLOBALS.Data.meansOfHistoric.items.map((item) => {\n    return [...item];\n  });\n\n  async function onArchive(itemId) {\n    try {\n      if (window.confirm(\"Are you sure, you want to do this?\")) {\n        setLoading(true);\n        await GLOBALS.API({\n          method: \"PUT\",\n          token: store.token,\n          uri: GLOBALS.Constants.SITE_ARCHIVE + \"/\" + itemId,\n        });\n        const itemsArray = items.filter((item) => item._id !== itemId);\n        setItems(itemsArray);\n        setLoading(false);\n      }\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const formik = useFormik({\n    initialValues: {\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    // validationSchema: addClientYup,\n    // onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row alignItems=\"center\">\n        <Heading primary=\"LIST OF MEANS - HISTORIC\" noWrap />\n        <div>\n          <Form.Row\n            alignItems=\"flex-start\"\n            noMargin\n            justifyContent=\"flex-end\"\n            style={{ paddingRight: \"50px\" }}\n          >\n            <Form.Column style={{ width: \"50%\", marginRight: \"50px\" }}>\n              <img src={Images.site} alt=\"\" />\n            </Form.Column>\n          </Form.Row>\n        </div>\n      </Form.Row>\n      <Form.Row alignItems=\"center\" noMargin>\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          {/* <SearchInput\n            placeholder=\"Site name\"\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          /> */}\n          <FormSelect\n            placeholder=\"Company\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Mean\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\n          See archived sites\n        </NavLink> */}\n      </Form.Row>\n      <div className={classes.content}>\n        <Table headers={GLOBALS.Data.meansOfHistoric.headings} rows={rows} />\n      </div>\n    </div>\n  );\n};\n\nexport default Historic;\n",["457","458"],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/AddMean.js",["459","460","461","462","463","464","465","466","467","468","469","470","471","472","473","474","475","476"],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/EditMean.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Organigramme/Organigramme.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/Means.js",["477","478","479","480","481","482","483","484","485","486","487","488","489","490","491","492","493","494","495","496","497","498","499","500","501","502","503","504","505","506"],"import React, { useState, useEffect } from \"react\";\nimport { useSelector } from \"react-redux\";\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles } from \"@material-ui/core/styles\";\n// import * as Yup from \"yup\";\n\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\n\nimport { useFormik } from \"formik\";\n\n// import Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport FormInput from \"../../../components/FormInput\";\n\nimport moment from \"moment\";\nimport SiteImage from \"../../../assets/images/Site.png\";\nimport { Images } from \"../../../assets/Assets\";\n\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  link: {\n    marginRight: 20,\n    whiteSpace: \"nowrap\",\n    color: theme.palette.primary.contrastText,\n  },\n  image: {\n    height: 70,\n    borderRadius: theme.shape.borderRadius,\n  },\n}));\n\nconst Means = () => {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const [loading, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n\n  const [siteDeliveryAreas, setSiteDeliveryAreas] = useState([]);\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\n  const [\n    selectedSiteDeliveryAreadIndex,\n    seltSelectedSiteDeliveryAreaIndex,\n  ] = useState(null);\n\n  const [locations, setLocations] = useState([]);\n  const [dropdownLocations, setDropdownLocations] = useState([]);\n  const [selectedLocationIndex, setSelectedLocationIndex] = useState(0);\n  const [selectedLocation, setSelectedLocation] = useState(\"\");\n\n  const [types, setTypes] = useState([]);\n  const [doropdownTypes, setDropdownTypes] = useState([]);\n  const [selectedTypeIndex, setSelectedTypeIndex] = useState(0);\n  const [selectedType, setSelectedType] = useState(\"\");\n\n  const [status, setStatus] = useState([]);\n  const [dropdownStatus, setDropdownStatus] = useState([]);\n  const [selectedStatusIndex, setSelectedStatusIndex] = useState(0);\n  const [selectedStatus, setSelectedStatus] = useState(\"\");\n\n  const [company, setCompany] = useState([]);\n  const [dropdownCompany, setDropdownCompany] = useState([]);\n  const [selectedCompanyIndex, setSeletedCompanyIndex] = useState(0);\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\n\n  const [levels, setLevels] = useState([]);\n  const [dropdownLevels, setDropdownLevels] = useState([]);\n  const [selectedDropdownLevelIndex, setSelectedDropdownLevelIndex] = useState(\n    0,\n  );\n  const [selectedLevel, setSelectedLevel] = useState(\"\");\n  const [disableDropdpwn, setDisableDropdown] = useState(false);\n\n  const [storageAreas, setStorageAreas] = useState([]);\n  const [droprownStorageAreas, setDropdownStorageAreas] = useState([]);\n  const [\n    selectedDropdownStorageAreaIndex,\n    setSelectedDropdownStorageAreaIndex,\n  ] = useState(0);\n  const [selectedStorageArea, setSelectedStorageArea] = useState(\"\");\n  const [storageMeans, setStorageMeans] = useState([]);\n  const [means, setMeans] = useState([]);\n  const [meanText, setMeanText] = useState(\"\");\n\n  const getMeans = async () => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_LIST_OF_MEANS}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n      if (response.success) {\n        setMeans(response.data.means);\n\n        if (response.data.means != null) {\n          let temp = [];\n\n          response.data.means.map((item, index) => {\n            let data = [];\n            data[0] = item.name;\n            data[1] = item.status;\n            data[2] = item.meanType;\n            data[3] = item.location\n              .map((innerItem, index) => innerItem.storageArea.name)\n              .toString();\n            data[4] = item.location\n              .map((innerItem, index) => innerItem.deliveryArea.name)\n              .toString();\n            temp.push(data);\n          });\n          setItems(temp);\n        }\n\n        if (response.data.site_delivery_areas != null) {\n          const temp = [];\n          response.data.site_delivery_areas.map((item, index) => {\n            temp.push({ label: item.name, value: item.name });\n          });\n          setSiteDeliveryAreas(response.data.site_delivery_areas);\n          setDropdownDeliveryAreas(temp);\n        }\n\n        if (response.data.site_companies != null) {\n          const temp = [];\n          response.data.site_companies.map((item, index) => {\n            temp.push({ label: item.name, value: item.name });\n          });\n          setCompany(response.data.site_companies);\n          setDropdownCompany(temp);\n        }\n\n        if (response.data.site_locations != null) {\n          setLocations(response.data.site_locations);\n          const temp = [];\n          response.data.site_locations.map((item, index) => {\n            temp.push({ label: item.name, value: item.name });\n          });\n          setDropdownLocations(temp);\n        }\n\n        if (response.data.mean_types != null) {\n          setTypes(response.data.mean_types);\n          const temp = [];\n          response.data.mean_types.map((item, index) => {\n            temp.push({ label: item, value: item });\n          });\n          setDropdownTypes(temp);\n        }\n\n        if (response.data.mean_status != null) {\n          setStatus(response.data.mean_status);\n          const temp = [];\n          response.data.mean_status.map((item, index) => {\n            temp.push({ label: item, value: item });\n          });\n          setDropdownStatus(temp);\n        }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getExternalMeans = async () => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_EXTERIOR_MEANS}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setStorageAreas(response.data);\n        if (response.data != null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) => {\n            temp.push({ label: item.name, value: item.name });\n          });\n\n          setDropdownStorageAreas(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getLevels = async (buidlingId) => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_LEVELS}/${buidlingId}`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setLevels(response.data);\n        if (response.data != null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) => {\n            temp.push({ label: item.name, value: item.name });\n          });\n\n          setDropdownLevels(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const formik = useFormik({\n    initialValues: {\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    // validationSchema: addClientYup,\n    // onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  useEffect(() => {\n    filterMean();\n  }, [\n    selectedSiteDeliveryAreadIndex,\n    selectedLocationIndex,\n    selectedDropdownLevelIndex,\n    selectedDropdownStorageAreaIndex,\n    selectedStorageArea,\n    selectedTypeIndex,\n    selectedType,\n    selectedCompanyIndex,\n    selectedCompany,\n    selectedStatusIndex,\n    selectedStatus,\n    formik.values.contractStartDate,\n    formik.values.contractEndDate,\n  ]);\n\n  const filterMean = async () => {\n    try {\n      setLoading(true);\n      const params = { siteId: \"6008169bedbb7816d40b197d\" };\n      if (meanText.length != 0) params[\"name\"] = meanText;\n      if (selectedDropdownArea.length != 0)\n        params[\"deliveryArea\"] =\n          siteDeliveryAreas[selectedSiteDeliveryAreadIndex]._id;\n      if (selectedStorageArea.length != 0)\n        params[\"storageArea\"] =\n          storageAreas[selectedDropdownStorageAreaIndex]._id;\n\n      if (selectedType.length != 0) params[\"type\"] = types[selectedTypeIndex];\n      if (selectedStatus.length != 0)\n        params[\"status\"] = status[selectedStatusIndex];\n      if (!isNaN(moment(formik.values.contractStartDate)))\n        params[\"startDate\"] = formik.values.contractStartDate;\n      if (!isNaN(moment(formik.values.contractEndDate)))\n        params[\"endDate\"] = formik.values.contractEndDate;\n      console.log(JSON.stringify(params, null, 2));\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.FILTER_MEANS}`,\n        token: store.token,\n        method: \"POST\",\n        body: JSON.stringify(params),\n      });\n      if (response.success) {\n        let temp = [];\n\n        response.data.map((item, index) => {\n          let data = [];\n          data[0] = item.name;\n          data[1] = item.status;\n          data[2] = item.meanType;\n          data[3] = item.location\n            .map((innerItem, index) => innerItem.storageArea.name)\n            .toString();\n          data[4] = item.location\n            .map((innerItem, index) => innerItem.deliveryArea.name)\n            .toString();\n          temp.push(data);\n        });\n        setItems(temp);\n\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getStorageAreasByLevel = async (levelId) => {\n    try {\n      setLoading(true);\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_LEVEL_ID}/${levelId}`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setStorageAreas(response.data);\n        if (response.data != null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) => {\n            temp.push({ label: item.name, value: item.name });\n          });\n\n          setDropdownStorageAreas(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    getMeans();\n    // eslint-disable-next-line\n  }, []);\n\n  const rows = items.map((item) => {\n    return [\n      ...item,\n      <div>\n        <NavLink\n          to=\"/means/edit-mean\"\n          style={{ color: \"#959491 !important\", textDecoration: \"none\" }}\n        >\n          <Pencil style={{ width: 18, height: 15, cursor: \"pointer\" }} />\n        </NavLink>\n        <img\n          src={Images.calender}\n          style={{ width: 18, height: 15, paddingLeft: 5 }}\n          alt=\"Icon\"\n        />\n\n        <img\n          src={Images.incidents}\n          style={{ width: 18, height: 15, paddingLeft: 5 }}\n          alt=\"Icon\"\n        />\n      </div>,\n    ];\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row alignItems=\"center\">\n        <Heading primary=\"LIST OF MEANS\" noWrap />\n        <div>\n          <Form.Row\n            alignItems=\"flex-start\"\n            noMargin\n            justifyContent=\"flex-end\"\n            style={{ paddingRight: \"50px\" }}\n          >\n            <SubHeading\n              disableMargin\n              topPadding\n              primary={`TOTAL : ${means.length} means`}\n              bold\n            />\n            <Form.Column style={{ width: \"50%\" }}>\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"ADD A MEAN\"\n                to={\"/means/add-mean\"}\n                style={{\n                  marginLeft: \"20px\",\n                  marginBottom: \"7px\",\n                  width: \"200px\",\n                }}\n              />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"MEANS REQUEST\"\n                to={\"/sites/means-request\"}\n                style={{ marginLeft: \"20px\", width: \"200px\" }}\n              />\n            </Form.Column>\n          </Form.Row>\n        </div>\n      </Form.Row>\n      <Form.Row alignItems=\"center\" noMargin>\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          <FormSelect\n            placeholder=\"Delivery area\"\n            values={dropdownDeliveryAreas}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n\n              if (index != -1) {\n                console.log(\"HERE 1\");\n                const item = event.target.value;\n                console.log(\"HERE 2\");\n                seltSelectedSiteDeliveryAreaIndex(index);\n                console.log(\"HERE 3\");\n                setSelectedDropdownArea(item);\n                console.log(\"HERE 4\");\n                // filterMean();\n                console.log(\"HERE 5\");\n              } else {\n                seltSelectedSiteDeliveryAreaIndex(null);\n                console.log(\"HERE 6\");\n                setSelectedDropdownArea(\"\");\n                console.log(\"HERE 7\");\n                // filterMean();\n                console.log(\"HERE 8\");\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Location\"\n            values={dropdownLocations}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index != -1) {\n                const item = event.target.value;\n\n                setSelectedLocationIndex(index);\n                setSelectedLocation(item);\n                // Reset Levels\n                setSelectedDropdownLevelIndex(0);\n                setSelectedLevel(\"\");\n                setDropdownLevels([]);\n                // Reset Storage Area\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                setDropdownStorageAreas([]);\n                // Reset Storage Means\n                setStorageMeans([]);\n                if (locations[index].locationType == \"EXTERIOR\") {\n                  setDisableDropdown(true);\n                  getExternalMeans();\n                } else {\n                  setDisableDropdown(false);\n                  getLevels(locations[index].building._id);\n                }\n              } else {\n                setSelectedLocationIndex(0);\n                setSelectedLocation(\"\");\n                // Reset Levels\n                setSelectedDropdownLevelIndex(0);\n                setSelectedLevel(\"\");\n                setDropdownLevels([]);\n                // Reset Storage Area\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                setDropdownStorageAreas([]);\n                // Reset Storage Means\n                setStorageMeans([]);\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Level\"\n            values={dropdownLevels}\n            disabled={disableDropdpwn}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index != -1) {\n                const item = event.target.value;\n                setSelectedDropdownLevelIndex(index);\n                setSelectedLevel(item);\n                // Reset Storage Area\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                setDropdownStorageAreas([]);\n                // Reset Storage Means\n                setStorageMeans([]);\n\n                getStorageAreasByLevel(levels[index]._id);\n              } else {\n                setSelectedDropdownLevelIndex(0);\n                setSelectedLevel(\"\");\n                // Reset Storage Area\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                setDropdownStorageAreas([]);\n                // Reset Storage Means\n                setStorageMeans([]);\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Storage area\"\n            values={droprownStorageAreas}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index != -1) {\n                const item = event.target.value;\n\n                setSelectedDropdownStorageAreaIndex(index);\n                setSelectedStorageArea(item);\n                // Reset Storage Means\n                setStorageMeans([]);\n\n                // filterMean();\n              } else {\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                //  filterMean();\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Type\"\n            values={doropdownTypes}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index != -1) {\n                const item = event.target.value;\n                setSelectedTypeIndex(index);\n                setSelectedType(item);\n                // Reset Storage Means\n                //filterMean();\n              } else {\n                setSelectedTypeIndex(0);\n                setSelectedType(\"\");\n                // Reset Storage Means\n                //filterMean();\n              }\n            }}\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\n          See archived sites\n        </NavLink> */}\n      </Form.Row>\n\n      <Form.Row alignItems=\"center\" noMargin className=\"mt-3\">\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          <FormSelect\n            placeholder=\"Company\"\n            values={dropdownCompany}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n\n              const item = event.target.value;\n\n              if (index != -1) {\n                setSeletedCompanyIndex(index);\n                setSelectedCompany(item);\n                //   filterMean();\n              } else {\n                setSeletedCompanyIndex(0);\n                setSelectedCompany(\"\");\n                // filterMean();\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Status\"\n            values={dropdownStatus}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index != -1) {\n                const item = event.target.value;\n                setSelectedStatusIndex(index);\n                setSelectedStatus(item);\n                // filterMean();\n              } else {\n                setSelectedStatusIndex(0);\n                setSelectedStatus(\"\");\n                //filterMean();\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormInput\n            type=\"date\"\n            placeholder=\"Start date\"\n            name=\"startDate\"\n            icon\n            onChange={formik.handleChange}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormInput\n            type=\"date\"\n            placeholder=\"End date\"\n            name=\"contractEndDate\"\n            icon\n            onChange={formik.handleChange}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <SearchInput\n            placeholder=\"Mean name\"\n            value={meanText}\n            on
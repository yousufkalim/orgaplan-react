th);\r\n  const dispatch = useDispatch();\r\n  const [loading, setLoading] = useState(true);\r\n\r\n  React.useEffect(() => {\r\n    dispatch(Actions.auth.checkLogin()).then(() => {\r\n      setTimeout(() => {\r\n        setLoading(false);\r\n      }, 1000);\r\n    });\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  return (\r\n    <>\r\n     <Admin />\r\n      {/* {store.loading && <Loader.AbsoluteLinear />}\r\n      {loading ? (\r\n        <Loader.CenterProgress />\r\n      ) : store.auth ? (\r\n        <SuperAdmin />\r\n      ) : (\r\n        <UnAuth />\r\n      )} */}\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\ErrorBoundary.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Loader.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\actions\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\reducers\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\UnAuth\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\actions\\auth.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\reducers\\auth.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\reducers\\notistack.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\actions\\notistack.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\UnAuth\\ForgotPassword.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\UnAuth\\LandingPage.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\UnAuth\\Login.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Home.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Logs.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\SuperAdminHeader.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Admins\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\actions\\actionTypes.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\utility.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\SmallText.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Input.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Heading.js",["441"],"import React from \"react\";\r\nimport Typography from \"@material-ui/core/Typography\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport {Images} from \"../assets/Assets\";\r\n\r\nexport default function Heading({ className, bold, ...props }) {\r\n  const useStyles = makeStyles((theme) => ({\r\n    heading: {\r\n      fontWeight: \"bold\",\r\n      fontSize: theme.typography.pxToRem(26),\r\n      color: theme.palette.primary.contrastText,\r\n      margin: props.disableMargin ? 0 : props.margin || \"0 0 10px 0\",\r\n    },\r\n  }));\r\n  const classes = useStyles();\r\n\r\n  return (\r\n   <>\r\n    <Typography\r\n      className={`${classes.heading} ${className}`}\r\n      style={props.style}\r\n      {...props}\r\n    >\r\n       \r\n      {props.primary}\r\n      {\r\n        props.icon && (\r\n          <span className=\"pl-5\" > <img src={Images.uploadIcon} style={{width: \"1.5rem\"}} /></span>\r\n        )\r\n      }\r\n    </Typography>\r\n  \r\n   </>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Button.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Form.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\SubHeading.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Card.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\UnAuth\\UnAuthHeader.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Admins\\AddAdmin.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Admins\\Admins.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\ArchivedSites.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddZAC.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\Sites.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\ZACs.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\VerifyClient.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\AddClient.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\Invoices.js",["442"],"import React, { useState, useEffect } from \"react\";\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport moment from \"moment\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\r\nimport { ReactComponent as Cross } from \"../../../assets/icons/Cross.svg\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n}));\r\n\r\nexport default function Invoices(props) {\r\n  const classes = useStyles();\r\n\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const [loading, setLoading] = useState(true);\r\n  const [items, setItems] = useState([]);\r\n  const [page] = useState(1);\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  async function fetchData() {\r\n    try {\r\n      const result = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.INVOICES}/${props.match.params.clientId}?page=${page}`,\r\n      });\r\n      setItems(result.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  async function onDelete(itemId) {\r\n    try {\r\n      if (window.confirm(\"Are you sure, you want to delete this?\")) {\r\n        setLoading(true);\r\n        await GLOBALS.API({\r\n          method: \"DELETE\",\r\n          token: store.token,\r\n          uri: GLOBALS.Constants.INVOICE_DELETE + \"/\" + itemId,\r\n        });\r\n        const itemsArray = items.filter((item) => item._id !== itemId);\r\n        setItems(itemsArray);\r\n        setLoading(false);\r\n      }\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const rows = items.map((item) => [\r\n    item.clientId.companyId.name,\r\n    moment(item.startDate).format(\"DD/MM/YYYY\"),\r\n    moment(item.endDate).format(\"DD/MM/YYYY\"),\r\n    item.siteId.name,\r\n    item.amount,\r\n    item.description,\r\n    <>\r\n      <IconButton>\r\n        <Pencil style={{ width: 18, height: 18 }} />\r\n      </IconButton>\r\n      <IconButton onClick={() => onDelete(item._id)}>\r\n        <Cross style={{ width: 18, height: 18, color: \"red\" }} />\r\n      </IconButton>\r\n    </>,\r\n  ]);\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Form.Row alignItems=\"center\">\r\n        <Heading primary=\"INVOICES\" noWrap />\r\n        <Button\r\n          fullWidth={false}\r\n          component={NavLink}\r\n          text=\"CREATE AN INVOICE\"\r\n          to=\"/clients/add-invoice\"\r\n        />\r\n      </Form.Row>\r\n      <Form.Row noMargin>\r\n        <FormSelect\r\n          placeholder=\"Client\"\r\n          values={[\r\n            { value: \"green\", label: \"Green\" },\r\n            { value: \"Yellow\", label: \"Yellow\" },\r\n            { value: \"Red\", label: \"Red\" },\r\n            { value: \"Blue\", label: \"Blue\" },\r\n            { value: \"Orange\", label: \"Orange\" },\r\n            { value: \"Purple\", label: \"Purple\" },\r\n            { value: \"Magenta\", label: \"Magenta\" },\r\n          ]}\r\n          style={{ maxWidth: 250 }}\r\n        />\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Table headers={GLOBALS.Data.invoices.headings} rows={rows} />\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\Clients.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\AddInvoice.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Footer.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\API.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\Styles.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\Constants.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormInput.js",["443"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormLabel.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormSelect.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormMultipleUpload.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Modal.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Table.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\AvatarUpload.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\SearchInput.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\SmallButton.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\RadioButton.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\MultiAdderInput.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Stepper.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep3.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep2.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep1.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\OpeningTimes.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\UnavailabilityTimes.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\MultiAdderInputModal.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\index.js",["444"],"import React from \"react\";\r\nimport { Switch, Route, Redirect } from \"react-router-dom\";\r\nimport AdminHeader from \"./AdminHeader\";\r\nimport Calender from \"./Calender/Calender\";\r\nimport Companies from \"./Companies\";\r\nimport Incidents from \"./Incidents/\";\r\nimport Invoices from \"./Invoices/Invoices\";\r\nimport Means from \"./Means\";\r\nimport Organigramme from \"./Organigramme\";\r\nimport Pic from \"./Pic\"\r\n\r\nimport Home from \"./Home\";\r\n\r\nexport default function UnAuth() {\r\n  return (\r\n    <>\r\n      <AdminHeader>\r\n        <Switch>\r\n          <Route exact path=\"/\" component={Calender} />\r\n          <Route path=\"/calender\" component={Calender} />\r\n          <Route path=\"/companies\" component={Companies} />\r\n          <Route path=\"/incidents\" component={Incidents} />\r\n          <Route path=\"/invoices\" component={Invoices} />\r\n          <Route path=\"/means\" component={Means} />\r\n          <Route path=\"/pic-interactive\" component={Pic} />\r\n          <Route path=\"/organigramme\" component={Organigramme} />\r\n          <Redirect from=\"*\" to=\"/\" />\r\n        </Switch>\r\n      </AdminHeader>\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Home.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\AdminHeader.js",["445","446"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\Calender.js",["447"],"import React from 'react';\r\nimport GLOBALS from \"../../../globals\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n    root: {\r\n      padding: GLOBALS.Styles.pagePadding,\r\n    },\r\n    content: {\r\n      overflow: \"hidden\",\r\n      borderRadius: theme.shape.borderRadius,\r\n      padding: GLOBALS.Styles.pageContentPadding,\r\n      marginTop: GLOBALS.Styles.pageContentMargin,\r\n      backgroundColor: theme.palette.secondary.main,\r\n    },\r\n  }));\r\n\r\nconst Calender = () => {\r\n    const classes = useStyles();\r\n    return (\r\n        <div  className={classes.root}>\r\n            calender\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default Calender\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\Companies.js",["448","449","450"],"import React, { useState, useEffect } from \"react\";\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n// import * as Yup from \"yup\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Modal from \"../../../components/Modal\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport AvatarUpload from \"../../../components/AvatarUpload\";\r\nimport uploadIcon from \"../../../assets/images/upload.png\";\r\nimport { Images } from \"../../../assets/Assets\";\r\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n}));\r\n\r\n// const updateAdminYup = Yup.object().shape({\r\n//   email: Yup.string().required(\"Required\"),\r\n//   phone: Yup.number()\r\n//     .test(\r\n//       \"len\",\r\n//       \"Must be exactly 10 characters\",\r\n//       (val) => val && val.toString().length === 10,\r\n//     )\r\n//     .required(\"Required\"),\r\n//   image: Yup.object().optional(\"\"),\r\n//   companyId: Yup.string().required(\"Required\"),\r\n// });\r\n\r\nexport default function Companies(props) {\r\n  const theme = useTheme();\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const [page] = useState(1);\r\n  const [items, setItems] = useState([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const [companies, setCompanies] = useState([]);\r\n\r\n  const [modal, setModal] = useState(false);\r\n  const [selectedItem, setSelectedItem] = useState(\"\");\r\n\r\n  const [firstName, setFirstName] = useState(\"\");\r\n  const [lastName, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [image, setImage] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [companyName, setCompanyName] = useState(\"\");\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    console.log(\"items\", items);\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  async function fetchData() {\r\n    try {\r\n      const admins = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.ADMINS}?page=${page}`,\r\n      });\r\n      const companies = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.COMPANY}`,\r\n      });\r\n\r\n      const companiesArray = [];\r\n      companies.data.items.map((item) => {\r\n        if (!item.adminId) {\r\n          companiesArray.push({\r\n            value: item._id,\r\n            label: item.name,\r\n          });\r\n        }\r\n        return true;\r\n      });\r\n\r\n      setItems(admins.data.items);\r\n      setCompanies(companiesArray);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"firstName\") setFirstName(value);\r\n    else if (name === \"lastName\") setLastName(value);\r\n    else if (name === \"phone\") setPhone(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"companyId\") setCompanyId(value);\r\n  };\r\n\r\n  const onUpdate = async (e) => {\r\n    try {\r\n      e.preventDefault();\r\n      setLoading(true);\r\n      var formdata = new FormData();\r\n      formdata.append(\"firstName\", firstName);\r\n      formdata.append(\"lastName\", lastName);\r\n      formdata.append(\"phone\", phone);\r\n      formdata.append(\"companyId\", companyId);\r\n      formdata.append(\"userId\", selectedItem._id);\r\n      image.file && formdata.append(\"image\", image.file);\r\n\r\n      const result = await GLOBALS.API({\r\n        method: \"PUT\",\r\n        uri: GLOBALS.Constants.ADMINS,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      const itemsArray = items.map((item) =>\r\n        item._id === selectedItem._id ? result.data : item,\r\n      );\r\n      setItems(itemsArray);\r\n      setLoading(false);\r\n      setModal(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const rows = GLOBALS.Data.companies.items.map((item) => {\r\n    return [\r\n      <img src={Images.site} alt=\"Icon\" />,\r\n      ...item,\r\n      <div>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <NavLink to=\"/companies/user-list\">\r\n          <img\r\n            src={Images.comapnies}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n          </NavLink>\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <NavLink to=\"/companies/edit-companies\">\r\n            <Pencil style={{ width: 18, height: 15 }} />\r\n          </NavLink>\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <img\r\n            src={Images.calender}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <img\r\n            src={Images.invoices}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <img\r\n            src={Images.incidents}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </IconButton>\r\n      </div>,\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <>\r\n      <div className={classes.root}>\r\n        <Form.Row alignItems=\"center\">\r\n          <Heading primary=\"LIST OF COMPANIES\" noWrap />\r\n          <div>\r\n            <Form.Row alignItems=\"center\" noMargin>\r\n              <SubHeading disableMargin primary=\"Total : 234 COMPANIES\" bold />\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"ADD A COMPANY\"\r\n                style={{ marginLeft: \"20px\" }}\r\n                to={\"/companies/add-companies\"}\r\n              />\r\n            </Form.Row>\r\n          </div>\r\n        </Form.Row>\r\n        <Form.Row noMargin>\r\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\r\n            <SearchInput placeholder=\"Name OF RESPONSIBLE\" />\r\n            <SearchInput\r\n              style={{ marginLeft: \"20px\" }}\r\n              placeholder=\"Name OF COMPANY\"\r\n            />\r\n            <a href=\"#\">\r\n              <img\r\n                style={{\r\n                  width: \"1.3rem\",\r\n                  marginLeft: \"20px\",\r\n                  marginTop: \"10px\",\r\n                }}\r\n                src={uploadIcon}\r\n                alt=\"File Upload Icon\"\r\n              />\r\n            </a>\r\n          </Form.Row>\r\n          <Button\r\n            fullWidth={true}\r\n            component={NavLink}\r\n            text=\"ACCESS REQUEST TO ZONES\"\r\n            style={{ width: \"295px\" }}\r\n            to={\"/admins/add-admin\"}\r\n          />\r\n        </Form.Row>\r\n        <div className={classes.content}>\r\n          <Table headers={GLOBALS.Data.companies.headings} rows={rows} />\r\n        </div>\r\n      </div>\r\n      <Modal\r\n        title=\"EDIT ADMIN\"\r\n        open={selectedItem ? modal : false}\r\n        onClose={() => setModal((st) => !st)}\r\n        body={\r\n          <Form.Form onSubmit={onUpdate}>\r\n            <Form.Row justifyContent=\"center\">\r\n              <AvatarUpload\r\n                value={image}\r\n                // error={image}\r\n                onChange={(file) => {\r\n                  const uri = URL.createObjectURL(file);\r\n                  handleChange(\"image\", { file, uri });\r\n                }}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"firstName\"\r\n                value={firstName}\r\n                // error={firstName}\r\n                placeholder=\"First Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"lastName\"\r\n                value={lastName}\r\n                // error={lastName}\r\n                placeholder=\"Last Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"phone\"\r\n                placeholder=\"Phone Number\"\r\n                value={phone}\r\n                // error={phone}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                style={GLOBALS.Styles.inputWidth}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormSelect\r\n                name=\"companyId\"\r\n                value={companyId}\r\n                // error={companyId}\r\n                values={companies}\r\n                placeholder={companyName}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Column alignItems=\"center\">\r\n              <Form.Row justifyContent=\"center\">\r\n                <Button\r\n                  type=\"submit\"\r\n                  minWidth={200}\r\n                  text=\"VALIDATE\"\r\n                  fullWidth={false}\r\n                  loading={loading}\r\n                  disabled={\r\n                    loading ||\r\n                    !firstName ||\r\n                    !lastName ||\r\n                    !phone ||\r\n                    image === \"\" ||\r\n                    !companyId\r\n                  }\r\n                />\r\n              </Form.Row>\r\n              <Form.Row justifyContent=\"center\">\r\n                <Button\r\n                  text=\"DELETE\"\r\n                  minWidth=\"30%\"\r\n                  fullWidth={false}\r\n                  disabled={loading || true}\r\n                  color={theme.palette.error.main}\r\n                />\r\n              </Form.Row>\r\n            </Form.Column>\r\n          </Form.Form>\r\n        }\r\n      />\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Incidents\\Incidents.js",["451","452","453","454","455","456","457","458","459","460","461"],"import React, { useState, useEffect } from \"react\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\nimport * as Yup from \"yup\";\r\n\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport { useFormik } from \"formik\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\n\r\n// import Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SmallButton from \"../../../components/SmallButton\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport { Images } from \"../../../assets/Assets\";\r\n\r\nimport SiteImage from \"../../../assets/images/Site.png\";\r\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n  link: {\r\n    marginRight: 20,\r\n    whiteSpace: \"nowrap\",\r\n    color: theme.palette.primary.contrastText,\r\n  },\r\n  image: {\r\n    height: 70,\r\n    borderRadius: theme.shape.borderRadius,\r\n  },\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nconst Incidents = () => {\r\n  const classes = useStyles();\r\n  const theme = useTheme();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const [loading, setLoading] = useState(true);\r\n  const [items, setItems] = useState([]);\r\n  const [page] = useState(1);\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  async function fetchData() {\r\n    try {\r\n      const result = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.SITE}?page=${page}`,\r\n      });\r\n      setItems(result.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const rows = GLOBALS.Data.incidents.items.map((item) => [...item]);\r\n\r\n  async function onArchive(itemId) {\r\n    try {\r\n      if (window.confirm(\"Are you sure, you want to do this?\")) {\r\n        setLoading(true);\r\n        await GLOBALS.API({\r\n          method: \"PUT\",\r\n          token: store.token,\r\n          uri: GLOBALS.Constants.SITE_ARCHIVE + \"/\" + itemId,\r\n        });\r\n        const itemsArray = items.filter((item) => item._id !== itemId);\r\n        setItems(itemsArray);\r\n        setLoading(false);\r\n      }\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    // validationSchema: addClientYup,\r\n    // onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <Form.Row alignItems=\"center\">\r\n        <Heading icon primary=\"RE-INVOICING\" noWrap />\r\n        <div>\r\n          <Form.Row\r\n            alignItems=\"flex-start\"\r\n            noMargin\r\n            justifyContent=\"flex-end\"\r\n            style={{ paddingRight: \"50px\" }}\r\n          >\r\n            <SubHeading\r\n              disableMargin\r\n              topPadding\r\n              style={{ color: \"#F80303\" }}\r\n              primary=\"TOTAL : 5 RE-INVOICING\r\n              345€ \r\n\"\r\n              bold\r\n            />\r\n            <Form.Column style={{ width: \"50%\" }}>\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"CREATE AN INCIDENT\"\r\n                to={\"/sites/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"20px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"200px\",\r\n                  fontWeight: \"bold\",\r\n                  backgroundColor: \"#F80303\",\r\n                }}\r\n              />\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"MEANS REQUEST\"\r\n                to={\"/sites/means-request\"}\r\n                style={{ marginLeft: \"20px\", width: \"200px\" }}\r\n              />\r\n            </Form.Column>\r\n          </Form.Row>\r\n        </div>\r\n      </Form.Row>\r\n      <Form.Row alignItems=\"center\" noMargin>\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          {/* <SearchInput\r\n            placeholder=\"Site name\"\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          /> */}\r\n          <FormSelect\r\n            placeholder=\"Delivery area\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Location\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Level\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Storage area\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Type\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\r\n          See archived sites\r\n        </NavLink> */}\r\n      </Form.Row>\r\n\r\n      <Form.Row alignItems=\"center\" className=\"mt-3\">\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          <FormSelect\r\n            placeholder=\"Company\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n\r\n          <FormInput\r\n            type=\"date\"\r\n            style={GLOBALS.Styles.inputWidth}\r\n            placeholder=\"Start date\"\r\n            name=\"contractStartDate\"\r\n            icon\r\n            onChange={formik.handleChange}\r\n            // value={formik.values.contractStartDate}\r\n            // error={formik.errors.contractStartDate}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormInput\r\n            type=\"date\"\r\n            style={GLOBALS.Styles.inputWidth}\r\n            placeholder=\"End date\"\r\n            name=\"contractStartDate\"\r\n            icon\r\n            onChange={formik.handleChange}\r\n            // value={formik.values.contractStartDate}\r\n            // error={formik.errors.contractStartDate}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Status\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <SearchInput\r\n            placeholder=\"Designation\"\r\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Table headers={GLOBALS.Data.incidents.headings} rows={rows} />\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Incidents;\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Invoices\\Invoices.js",["462"],"import React from 'react';\r\nimport GLOBALS from \"../../../globals\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n    root: {\r\n      padding: GLOBALS.Styles.pagePadding,\r\n    },\r\n    content: {\r\n      overflow: \"hidden\",\r\n      borderRadius: theme.shape.borderRadius,\r\n      padding: GLOBALS.Styles.pageContentPadding,\r\n      marginTop: GLOBALS.Styles.pageContentMargin,\r\n      backgroundColor: theme.palette.secondary.main,\r\n    },\r\n  }));\r\n\r\nconst Invoices = () => {\r\n    const classes = useStyles();\r\n    return (\r\n        <div  className={classes.root}>\r\n            Invoices\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default Invoices\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Organigramme\\Organigramme.js",["463","464","465"],"import React, { useState, useEffect } from \"react\";\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n// import * as Yup from \"yup\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport {Images} from \"../../../assets/Assets\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Modal from \"../../../components/Modal\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport AvatarUpload from \"../../../components/AvatarUpload\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n}));\r\n\r\n// const updateAdminYup = Yup.object().shape({\r\n//   email: Yup.string().required(\"Required\"),\r\n//   phone: Yup.number()\r\n//     .test(\r\n//       \"len\",\r\n//       \"Must be exactly 10 characters\",\r\n//       (val) => val && val.toString().length === 10,\r\n//     )\r\n//     .required(\"Required\"),\r\n//   image: Yup.object().optional(\"\"),\r\n//   companyId: Yup.string().required(\"Required\"),\r\n// });\r\n\r\nexport default function Organigramme() {\r\n  const theme = useTheme();\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const[open, setOpen] = useState(false);\r\n  const [page] = useState(1);\r\n  const [items, setItems] = useState([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const [companies, setCompanies] = useState([]);\r\n\r\n  const [modal, setModal] = useState(false);\r\n  const [selectedItem] = useState(\"\");\r\n\r\n  const [firstName, setFirstName] = useState(\"\");\r\n  const [lastName, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [image, setImage] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [companyName] = useState(\"\");\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    console.log(\"items\", items);\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  async function fetchData() {\r\n    try {\r\n      const admins = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.ADMINS}?page=${page}`,\r\n      });\r\n      const companies = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.COMPANY}`,\r\n      });\r\n\r\n      const companiesArray = [];\r\n      companies.data.items.map((item) => {\r\n        if (!item.adminId) {\r\n          companiesArray.push({\r\n            value: item._id,\r\n            label: item.name,\r\n          });\r\n        }\r\n        return true;\r\n      });\r\n\r\n      setItems(admins.data.items);\r\n      setCompanies(companiesArray);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"firstName\") setFirstName(value);\r\n    else if (name === \"lastName\") setLastName(value);\r\n    else if (name === \"phone\") setPhone(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"companyId\") setCompanyId(value);\r\n  };\r\n\r\n  const onUpdate = async (e) => {\r\n    try {\r\n      e.preventDefault();\r\n      setLoading(true);\r\n      var formdata = new FormData();\r\n      formdata.append(\"firstName\", firstName);\r\n      formdata.append(\"lastName\", lastName);\r\n      formdata.append(\"phone\", phone);\r\n      formdata.append(\"companyId\", companyId);\r\n      formdata.append(\"userId\", selectedItem._id);\r\n      image.file && formdata.append(\"image\", image.file);\r\n\r\n      const result = await GLOBALS.API({\r\n        method: \"PUT\",\r\n        uri: GLOBALS.Constants.ADMINS,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      const itemsArray = items.map((item) =>\r\n        item._id === selectedItem._id ? result.data : item,\r\n      );\r\n      setItems(itemsArray);\r\n      setLoading(false);\r\n      setModal(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n  const handleClickOpen = () => {\r\n    setOpen(true);\r\n  };\r\n  const rows = GLOBALS.Data.oranigramme.items.map((item) => {\r\n    return [<img src={Images.avatar} style={{width:50, height:50}} />,...item];\r\n  });\r\n\r\n  const modalHandler = (btn) => {\r\n    setOpen(btn)\r\n  }\r\n  return (\r\n    <>\r\n      <div className={classes.root}>\r\n        <Form.Row alignItems=\"center\">\r\n          <Heading primary=\"ORGANNIGRAMME\" noWrap />\r\n          <div>\r\n            <Form.Row alignItems=\"center\" noMargin>\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"ADD A CONTACT\"\r\n                style={{ marginLeft: \"20px\" }}\r\n                to={\"/organigramme/add-contact\"}\r\n              />\r\n            </Form.Row>\r\n          </div>\r\n        </Form.Row>\r\n        <Form.Row noMargin>\r\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\r\n            <Button\r\n              fullWidth={false}\r\n              component={NavLink}\r\n              text=\"SITE ORGANIGAMME\"\r\n              style={{\r\n                marginLeft: \"20px\",\r\n                backgroundColor: \"#140772\",\r\n              }}\r\n              to={\"/\"}\r\n            />\r\n            <Button\r\n              fullWidth={false}\r\n              component={NavLink}\r\n              text=\"LOGISTIC ORGANIGAMME\"\r\n              style={{\r\n                marginLeft: \"20px\",\r\n                backgroundColor: \"#fff\",\r\n                border: \"1px solid #707070\",\r\n              }}\r\n              textColor=\"#7E7878\"\r\n              to={\"/\"}\r\n            />\r\n          </Form.Row>\r\n        </Form.Row>\r\n        <div className={classes.content}>\r\n          <Table headers={GLOBALS.Data.oranigramme.headings} rows={rows} modalHandler={modalHandler}  />\r\n        </div>\r\n      </div>\r\n      <Modal\r\n        title=\"THIERRY MARLES\"\r\n        open={open}\r\n        onClose={() => modalHandler(false)}\r\n        body={\r\n          <Form.Form onSubmit={onUpdate}>\r\n            <Form.Row justifyContent=\"center\">\r\n              <AvatarUpload\r\n                value={image}\r\n                // error={image}\r\n                onChange={(file) => {\r\n                  const uri = URL.createObjectURL(file);\r\n                  handleChange(\"image\", { file, uri });\r\n                }}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"firstName\"\r\n                value={firstName}\r\n                // error={firstName}\r\n                placeholder=\"First Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"lastName\"\r\n                value={lastName}\r\n                // error={lastName}\r\n                placeholder=\"Last Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"phone\"\r\n                placeholder=\"Phone Number\"\r\n                value={phone}\r\n                // error={phone}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                style={GLOBALS.Styles.inputWidth}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormSelect\r\n                name=\"companyId\"\r\n                value={companyId}\r\n                // error={companyId}\r\n                values={companies}\r\n                placeholder={companyName}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Column alignItems=\"center\">\r\n              <Form.Row justifyContent=\"center\">\r\n                <Button\r\n                  type=\"submit\"\r\n                  minWidth={200}\r\n                  text=\"VALIDATE\"\r\n                  fullWidth={false}\r\n                  loading={loading}\r\n                  disabled={\r\n                    loading ||\r\n                    !firstName ||\r\n                    !lastName ||\r\n                    !phone ||\r\n                    image === \"\" ||\r\n                    !companyId\r\n                  }\r\n                />\r\n              </Form.Row>\r\n              <Form.Row justifyContent=\"center\">\r\n                <Button\r\n                  text=\"DELETE\"\r\n                  minWidth=\"30%\"\r\n                  fullWidth={false}\r\n                  disabled={loading || true}\r\n                  color={theme.palette.error.main}\r\n                />\r\n              </Form.Row>\r\n            </Form.Column>\r\n          </Form.Form>\r\n        }\r\n      />\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\assets\\Assets.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\Means.js",["466","467","468","469","470","471","472","473","474"],"import React, { useState, useEffect } from \"react\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\nimport * as Yup from \"yup\";\r\n\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport { useFormik } from \"formik\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\n\r\n// import Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SmallButton from \"../../../components/SmallButton\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport FormInput from \"../../../components/FormInput\";\r\n\r\nimport SiteImage from \"../../../assets/images/Site.png\";\r\nimport { Images } from \"../../../assets/Assets\";\r\n\r\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n  link: {\r\n    marginRight: 20,\r\n    whiteSpace: \"nowrap\",\r\n    color: theme.palette.primary.contrastText,\r\n  },\r\n  image: {\r\n    height: 70,\r\n    borderRadius: theme.shape.borderRadius,\r\n  },\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nconst Means = () => {\r\n  const classes = useStyles();\r\n  const theme = useTheme();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const [loading, setLoading] = useState(true);\r\n  const [items, setItems] = useState([]);\r\n  const [page] = useState(1);\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  async function fetchData() {\r\n    try {\r\n      const result = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.SITE}?page=${page}`,\r\n      });\r\n      setItems(result.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const rows = GLOBALS.Data.means.items.map((item) => {\r\n    return [\r\n      ...item,\r\n      <div>\r\n        <NavLink to=\"/means/edit-mean\" style={{color: '#959491 !important', textDecoration: \"none\"}}>\r\n          <Pencil style={{ width: 18, height: 15, cursor: \"pointer\"}} />\r\n        </NavLink>\r\n        <img\r\n          src={Images.calender}\r\n          style={{ width: 18, height: 15, paddingLeft: 5 }}\r\n          alt=\"Icon\"\r\n        />\r\n\r\n        <img\r\n          src={Images.incidents}\r\n          style={{ width: 18, height: 15, paddingLeft: 5 }}\r\n          alt=\"Icon\"\r\n        />\r\n      </div>,\r\n    ];\r\n  });\r\n\r\n  async function onArchive(itemId) {\r\n    try {\r\n      if (window.confirm(\"Are you sure, you want to do this?\")) {\r\n        setLoading(true);\r\n        await GLOBALS.API({\r\n          method: \"PUT\",\r\n          token: store.token,\r\n          uri: GLOBALS.Constants.SITE_ARCHIVE + \"/\" + itemId,\r\n        });\r\n        const itemsArray = items.filter((item) => item._id !== itemId);\r\n        setItems(itemsArray);\r\n        setLoading(false);\r\n      }\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    // validationSchema: addClientYup,\r\n    // onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <Form.Row alignItems=\"center\">\r\n        <Heading primary=\"LIST OF MEANS\" noWrap />\r\n        <div>\r\n          <Form.Row\r\n            alignItems=\"flex-start\"\r\n            noMargin\r\n            justifyContent=\"flex-end\"\r\n            style={{ paddingRight: \"50px\" }}\r\n          >\r\n            <SubHeading\r\n              disableMargin\r\n              topPadding\r\n              primary=\"TOTAL : 54 means\"\r\n              bold\r\n            />\r\n            <Form.Column style={{ width: \"50%\" }}>\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"ADD A MEAN\"\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"20px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"200px\",\r\n                }}\r\n              />\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"MEANS REQUEST\"\r\n                to={\"/sites/means-request\"}\r\n                style={{ marginLeft: \"20px\", width: \"200px\" }}\r\n              />\r\n            </Form.Column>\r\n          </Form.Row>\r\n        </div>\r\n      </Form.Row>\r\n      <Form.Row alignItems=\"center\" noMargin>\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          {/* <SearchInput\r\n            placeholder=\"Site name\"\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          /> */}\r\n          <FormSelect\r\n            placeholder=\"Delivery area\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Location\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Level\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Storage area\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Type\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\r\n          See archived sites\r\n        </NavLink> */}\r\n      </Form.Row>\r\n\r\n      <Form.Row alignItems=\"center\" noMargin className=\"mt-3\">\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          <FormSelect\r\n            placeholder=\"Company\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Location\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormInput\r\n            type=\"date\"\r\n            style={GLOBALS.Styles.inputWidth}\r\n            placeholder=\"Start date\"\r\n            name=\"contractStartDate\"\r\n            icon\r\n            onChange={formik.handleChange}\r\n            // value={formik.values.contractStartDate}\r\n            // error={formik.errors.contractStartDate}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormInput\r\n            type=\"date\"\r\n            style={GLOBALS.Styles.inputWidth}\r\n            placeholder=\"End date\"\r\n            name=\"contractStartDate\"\r\n            icon\r\n            onChange={formik.handleChange}\r\n            // value={formik.values.contractStartDate}\r\n            // error={formik.errors.contractStartDate}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <SearchInput\r\n            placeholder=\"Mean name\"\r\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Table headers={GLOBALS.Data.means.headings} rows={rows} />\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Means;\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\Index.js",["475"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Pic\\Pic.js",["476","477","478","479","480","481","482","483","484"],"import React, { useState, useEffect } from \"react\";\r\nimport './Pic.css';\r\nimport GLOBALS from \"../../../globals\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\nimport * as Yup from \"yup\";\r\n\r\n\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport { useFormik } from \"formik\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport {Images} from \"../.../../../../assets/Assets\";\r\n\r\n// import Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SmallButton from \"../../../components/SmallButton\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport FormInput from \"../../../components/FormInput\";\r\n\r\n\r\nimport SiteImage from \"../../../assets/images/Site.png\";\r\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n  link: {\r\n    marginRight: 20,\r\n    whiteSpace: \"nowrap\",\r\n    color: theme.palette.primary.contrastText,\r\n  },\r\n  image: {\r\n    height: 70,\r\n    borderRadius: theme.shape.borderRadius,\r\n  },\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nconst Pic = () => {\r\n  const classes = useStyles();\r\n  const theme = useTheme();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const [loading, setLoading] = useState(true);\r\n  const [items, setItems] = useState([]);\r\n  const [page] = useState(1);\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  async function fetchData() {\r\n    try {\r\n      const result = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.SITE}?page=${page}`,\r\n      });\r\n      setItems(result.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const rows = items.map((item) => [\r\n    <img\r\n      src={item.logo ? GLOBALS.Constants.BASE_URL + item.logo : SiteImage}\r\n      alt=\"siteimage\"\r\n      className={classes.image}\r\n    />,\r\n    item.name,\r\n    item.zacId ? item.zacId.name : \"N/A\",\r\n    `${item.adminId.userId.firstName} ${item.adminId.userId.lastName}`,\r\n    item.status,\r\n    <Form.Row alignItems=\"center\" justifyContent=\"center\">\r\n      <IconButton>\r\n        <Pencil style={{ width: 18, height: 18 }} />\r\n      </IconButton>\r\n      <SmallButton\r\n        text=\"Archive\"\r\n        disabled={loading}\r\n        onClick={() => onArchive(item._id)}\r\n        color={theme.palette.primary.contrastText}\r\n        style={{\r\n          marginLeft: 10,\r\n          borderRadius: 4,\r\n        }}\r\n      />\r\n    </Form.Row>,\r\n  ]);\r\n\r\n  async function onArchive(itemId) {\r\n    try {\r\n      if (window.confirm(\"Are you sure, you want to do this?\")) {\r\n        setLoading(true);\r\n        await GLOBALS.API({\r\n          method: \"PUT\",\r\n          token: store.token,\r\n          uri: GLOBALS.Constants.SITE_ARCHIVE + \"/\" + itemId,\r\n        });\r\n        const itemsArray = items.filter((item) => item._id !== itemId);\r\n        setItems(itemsArray);\r\n        setLoading(false);\r\n      }\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n     \r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    // validationSchema: addClientYup,\r\n    // onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <Form.Row alignItems=\"center\">\r\n        <Heading primary=\"PIC\" noWrap />\r\n       \r\n      </Form.Row>\r\n\r\n      \r\n\r\n      <Form.Row alignItems=\"center\" noMargin className=\"mt-3\">\r\n      <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          <FormSelect\r\n            placeholder=\"Select a building\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Select a level\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n        </Form.Row>\r\n      <div className=\"admin-pic\">\r\n        <div className=\"admin-pic-image\">\r\n<img src={Images.picMap} />\r\n        </div>\r\n        <div className=\"admin-pic-content\">\r\n        <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n               \r\n                text=\"EDIT THIS MAP\"\r\n                to={\"/sites/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"10px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"270px\",\r\n                  fontWeight: \"bold\",\r\n                  textAlign: \"center\"\r\n                  \r\n                }}\r\n              />\r\n               <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n               \r\n                text=\"EDIT THE PLAN\"\r\n                to={\"/sites/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"10px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"270px\",\r\n                  fontWeight: \"bold\",\r\n                  textAlign: \"center\",\r\n                  marginTop: \"1.5rem\",\r\n                  \r\n                }}\r\n              />\r\n              <div className=\"admin-pic-content-historic\">\r\n              Historic of the plans\r\n              </div>\r\n<img src={Images.mapIcon} className=\"admin-pic-map-icon\" />\r\n\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Pic;\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\index.js",["485"],"import React from \"react\";\r\nimport { Switch, Route, Redirect } from \"react-router-dom\";\r\nimport AddMean from \"./AddMean\";\r\nimport Mean from \"./Means\";\r\nimport EditMean from \"./EditMean\";\r\nimport Historic from \"./Historic\";\r\n\r\n// import ZACs from \"./ZACs\";\r\n// import Sites from \"./Sites\";\r\n// import AddZAC from \"./AddZAC\";\r\n// import AddSite from \"./AddSite\";\r\n// import ArchivedSites from \"./ArchivedSites\";\r\n\r\nexport default function Index(props) {\r\n  console.log(props.match.path + \"/add-mean\")\r\n  return (\r\n    <Switch>\r\n      {console.log(props.match.path)}\r\n      <Route exact path={props.match.path + \"/\"} component={Mean} />\r\n      {/* <Route exact path={props.match.path + \"/zacs\"} component={ZACs} /> */}\r\n      <Route exact path={props.match.path + \"/add-mean\"} component={AddMean} />\r\n      <Route exact path={props.match.path + \"/edit-mean\"} component={EditMean} />\r\n      {/* <Route exact path={props.match.path + \"/add-site\"} component={AddSite} /> */}\r\n      {/* <Route\r\n        exact\r\n        path={props.match.path + \"/archives\"}\r\n        component={ArchivedSites}\r\n      /> */}\r\n      <Redirect from=\"*\" to={props.match.path + \"/\"} />\r\n    </Switch>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\AddMean.js",["486","487","488","489","490","491","492","493","494","495","496","497","498","499","500"],"import React , { useState, useEffect }from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport { NavLink } from \"react-router-dom\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/CustomFormInput\";\r\nimport SmallText from \"../../../components/SmallText\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport MultiAdderInput from \"../../../components/MultiAdderInput\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport CustomInputModal from \"../../../components/CustomInputModal\";\r\nimport CustomButtonModal from \"../../../components/CustomButtonModal\";\r\nimport { Images } from \"../../../assets/Assets\";\r\nimport DateRangeIcon from '@material-ui/icons/DateRange';\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function AddMean(props) {\r\n    const [addresses, setAddresses] = useState([]);\r\n    const [update, setUpdate] = useState(false);\r\n\r\n    const [name, setName] = useState(\"\");\r\n    const [type, setType] = useState(\"\");\r\n    const [color, setColor] = useState(\"\");\r\n    const [image, setImage] = useState([]);\r\n    const [location, setLocation] = useState([]);\r\n    const [startDate, setStartDate] = useState(\"\");\r\n    const [endDate, setEndDate] = useState(\"\");\r\n    const [techSheet, setTechSheet] = useState([]);\r\n    const [rate, setRate] = useState(\"\");\r\n    const [addInfo, setAddInfo] = useState(\"\");\r\n\r\n\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const onSubmit = async (values) => {\r\n   \r\n  };\r\n  \r\n  function handleChange(name, value) {\r\n    if( name === \"name\") setName(value);\r\n    else if (name === \"type\") setType(value);\r\n    else if (name === \"color\") setColor(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"location\") setLocation(value);\r\n    else if (name === \"startDate\") setStartDate(value);\r\n    else if (name === \"endDate\") setEndDate(value);\r\n    else if (name === \"techSheet\") setTechSheet(value);\r\n    else if (name === \"rate\") setRate(value);\r\n    else if (name === \"addInfo\") setAddInfo(value);\r\n  }\r\n\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <Form.Row>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n\r\n      </IconButton>\r\n      <div className=\"text-center pr-5\">\r\n        <img src={Images.profile2} />\r\n        <div>Thierry Marles</div>\r\n      </div>\r\n\r\n      </Form.Row>\r\n      <Form.Row>\r\n      <Heading primary=\"ADD A MEAN\" />\r\n      <CustomButtonModal\r\n       name=\"addresses\"\r\n       values={addresses}\r\n       title=\"LOCALISATION\"\r\n       // error={addresses}\r\n    //    style={GLOBALS.Styles.inputWidth}\r\n        style={{width: \"250px\", marginRight: \"240px\"}}\r\n       placeholder=\"Enter site addresses\"\r\n       onChange={(values) => handleChange(\"addresses\", values)}\r\n       />\r\n      {/* <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"LOCALISATION\"\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginRight: \"100px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\"\r\n                }}\r\n              /> */}\r\n\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Form.Form >\r\n          <Form.Row >\r\n            <FormLabel bold primary=\"IDENTITY : \" />\r\n            <Form.Row noMargin width=\"65%\" style={{gap: \"20px\"}}>\r\n            <FormInput\r\n              name=\"name\"\r\n              error\r\n              style={GLOBALS.Styles.inputWidth}\r\n              placeholder=\"Company name\"\r\n              onChange={({ target: { name, value } }) =>\r\n              handleChange(name, value)\r\n            }\r\n              value={name}\r\n              validateSchema={Yup.string().required()}\r\n            />\r\n             <FormSelect\r\n                placeholder=\"Type\"\r\n                name=\"type\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                handleChange(name, value)\r\n              }\r\n                value={type}\r\n                values={[\r\n                  { value: \"green\", label: \"Green\" },\r\n                  { value: \"Yellow\", label: \"Yellow\" },\r\n                  { value: \"Red\", label: \"Red\" },\r\n                  { value: \"Blue\", label: \"Blue\" },\r\n                  { value: \"Orange\", label: \"Orange\" },\r\n                  { value: \"Purple\", label: \"Purple\" },\r\n                  { value: \"Magenta\", label: \"Magenta\" },\r\n                ]}\r\n              />\r\n               <FormSelect\r\n                placeholder=\"color\"\r\n                name=\"color\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                handleChange(name, value)\r\n              }\r\n                value={color}\r\n                values={[\r\n                  { value: \"green\", label: \"Green\" },\r\n                  { value: \"Yellow\", label: \"Yellow\" },\r\n                  { value: \"Red\", label: \"Red\" },\r\n                  { value: \"Blue\", label: \"Blue\" },\r\n                  { value: \"Orange\", label: \"Orange\" },\r\n                  { value: \"Purple\", label: \"Purple\" },\r\n                  { value: \"Magenta\", label: \"Magenta\" },\r\n                ]}\r\n              />\r\n              <FormMultipleUpload\r\n                name=\"image\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                \r\n                values={image}\r\n                onChange={(values) => handleChange(\"profile\", values)}\r\n              />\r\n            </Form.Row>\r\n           \r\n          </Form.Row>\r\n\r\n        <Form.Row>\r\n          <FormLabel bold primary=\"LOCATION :  \" />\r\n          <Form.Row noMargin width=\"65%\">\r\n          <CustomInputModal\r\n            name=\"location\"\r\n            values={location}\r\n            // error={addresses}\r\n            style={GLOBALS.Styles.inputWidth}\r\n            placeholder=\"Enter Delivery areas\"\r\n            onChange={(values) => handleChange(\"addresses\", values)}\r\n          />\r\n          </Form.Row>\r\n        </Form.Row>\r\n\r\n        <Form.Row>\r\n            <FormLabel bold primary=\"DISPONIBILITE :\" />\r\n            <Form.Row noMargin width=\"65%\" justifyContent=\"flex-start\" style={{gap: \"20px\"}}>\r\n              <FormInput\r\n                type=\"date\"\r\n                style={{width: \"300px\"}}\r\n                placeholder={`Date de début`}\r\n                name=\"startDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                handleChange(name, value)\r\n              }\r\n                value={startDate}\r\n              />\r\n              <FormInput\r\n                type=\"date\"\r\n                placeholder=\"Date de fin\"\r\n                style={{width: \"300px\"}}\r\n                name=\"endDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                handleChange(name, value)\r\n              }\r\n                value={endDate}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"FICHE TECHNIQUE : \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormMultipleUpload\r\n                name=\"techSheet\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                handleChange(name, value)\r\n              }\r\n                values={techSheet}\r\n              />\r\n              \r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"INDISPONIBILITES: \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n            <div\r\n                // name=\"availability\"\r\n               \r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"0px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  color: \"#fff\",\r\n                  padding: \"0.8rem 0\",\r\n                  borderRadius: \"8px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\"\r\n                }}\r\n              >\r\nSHOW UNAVAILABILITIES\r\n              </div>\r\n              \r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n\r\n         \r\n         \r\n          \r\n          \r\n         \r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"TARIF HORAIRE : \" />\r\n           <Form.Row noMargin width=\"65%\">\r\n           <FormInput\r\n              textArea\r\n              rows={1}\r\n              style={{width: \"300px\", textAlign: \"right\"}}\r\n              \r\n              placeholder=\"€\"\r\n              name=\"rate\"\r\n              onChange={({ target: { name, value } }) =>\r\n              handleChange(name, value)\r\n            }\r\n              value={rate}\r\n            />\r\n           </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"INFORMATIONS COMPLÉMENTAIRES :\" />\r\n           <Form.Row noMargin width=\"65%\">\r\n           <FormInput\r\n              textArea\r\n              rows={3}\r\n              style={{width: \"600px\"}}\r\n          \r\n              placeholder=\"Informations complémentaires\"\r\n              name=\"addInfo\"\r\n              onChange={({ target: { name, value } }) =>\r\n              (console.log(\"add, info\", value),\r\n              handleChange(name, value))\r\n            }\r\n              value={addInfo}\r\n            />\r\n           </Form.Row>\r\n          </Form.Row>\r\n          \r\n         \r\n          <Form.Row>\r\n          <Form.ButtonContainer style={{width: \"80%\"}}>\r\n            <Button\r\n              type=\"submit\"\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              disabled={\r\n            \r\n                !name ||\r\n                location.length === 0 ||\r\n                !type ||\r\n                !color ||\r\n                !startDate\r\n              }\r\n            />\r\n          </Form.ButtonContainer>\r\n          </Form.Row>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\n\r\n/*\r\n onChange={(value) => {\r\n            if(props.validte) \r\n            {\r\n              props.ypuprop.validate(value)\r\n            }\r\n          }}\r\n        */","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\EditMean.js",["501","502","503","504","505","506"],"import React , { useState, useEffect }from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport { NavLink } from \"react-router-dom\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport SmallText from \"../../../components/SmallText\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport MultiAdderInput from \"../../../components/MultiAdderInput\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport MultiAdderInputModal from \"../../../components/MultiAdderInputModal\";\r\nimport { Images } from \"../../../assets/Assets\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function EditMean(props) {\r\n    const [addresses, setAddresses] = useState([]);\r\n    const [update, setUpdate] = useState(false);\r\n\r\n\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const onSubmit = async (values) => {\r\n    const notificationTo = values.notificationTo.map((item) => item.label);\r\n\r\n    var formdata = new FormData();\r\n    formdata.append(\"logo\", values.logo[0].file);\r\n    formdata.append(\"name\", values.name);\r\n    formdata.append(\"color\", values.color);\r\n    formdata.append(\"firstName\", values.firstName);\r\n    formdata.append(\"lastName\", values.lastName);\r\n    formdata.append(\"email\", values.email);\r\n    formdata.append(\"phone\", values.phone);\r\n    formdata.append(\"contractType\", values.contractType);\r\n    formdata.append(\"contractStartDate\", values.contractStartDate);\r\n    formdata.append(\"contractEndDate\", values.contractEndDate);\r\n    formdata.append(\"functionality\", values.functionality);\r\n    formdata.append(\"additionalInfo\", values.additionalInfo);\r\n    formdata.append(\"notificationPriorToDays\", values.notificationPriorToDays);\r\n    formdata.append(\"notificationTo\", JSON.stringify(notificationTo));\r\n\r\n    await GLOBALS.API({\r\n      method: \"POST\",\r\n      uri: GLOBALS.Constants.CLIENTS,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      logo: [],\r\n      name: \"\",\r\n      color: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    validationSchema: addClientYup,\r\n    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n\r\n  function handleChange(name, value) {\r\n    if (name === \"addresses\") {\r\n      setUpdate((st) => !st);\r\n      setAddresses(value);\r\n    } \r\n  }\r\n\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <Form.Row>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n\r\n      </IconButton>\r\n      <div className=\"text-center pr-5\">\r\n      <img src={Images.profile2} />\r\n      <div>Thierry Marles</div>\r\n      </div>\r\n\r\n      </Form.Row>\r\n      <Form.Row>\r\n      <Heading primary=\"EDIT A MEAN\" />\r\n      <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"EDIT LOCATION\"\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginRight: \"100px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  textAlign: \"left\",\r\n                  backgroundColor: \"#140772\"\r\n                }}\r\n              />\r\n\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={formik.handleSubmit}>\r\n          <Form.Row >\r\n            <FormLabel bold primary=\"IDENTITY : \" />\r\n            <Form.Row noMargin width=\"65%\" style={{gap: \"20px\"}}>\r\n            <FormInput\r\n              name=\"name\"\r\n              style={GLOBALS.Styles.inputWidth}\r\n              placeholder=\"Company name\"\r\n              onChange={formik.handleChange}\r\n              value={formik.values.name}\r\n              error={formik.errors.name}\r\n            />\r\n             <FormSelect\r\n                placeholder=\"Type\"\r\n                name=\"color\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={formik.handleChange}\r\n                value={formik.values.color}\r\n                error={formik.errors.color}\r\n                values={[\r\n                  { value: \"green\", label: \"Green\" },\r\n                  { value: \"Yellow\", label: \"Yellow\" },\r\n                  { value: \"Red\", label: \"Red\" },\r\n                  { value: \"Blue\", label: \"Blue\" },\r\n                  { value: \"Orange\", label: \"Orange\" },\r\n                  { value: \"Purple\", label: \"Purple\" },\r\n                  { value: \"Magenta\", label: \"Magenta\" },\r\n                ]}\r\n              />\r\n               <FormSelect\r\n                placeholder=\"color\"\r\n                name=\"color\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={formik.handleChange}\r\n                value={formik.values.color}\r\n                error={formik.errors.color}\r\n                values={[\r\n                  { value: \"green\", label: \"Green\" },\r\n                  { value: \"Yellow\", label: \"Yellow\" },\r\n                  { value: \"Red\", label: \"Red\" },\r\n                  { value: \"Blue\", label: \"Blue\" },\r\n                  { value: \"Orange\", label: \"Orange\" },\r\n                  { value: \"Purple\", label: \"Purple\" },\r\n                  { value: \"Magenta\", label: \"Magenta\" },\r\n                ]}\r\n              />\r\n              <FormMultipleUpload\r\n                name=\"logo\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                error={formik.errors.logo}\r\n                values={formik.values.logo}\r\n                onChange={(values) =>\r\n                  formik.handleChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"logo\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n              />\r\n            </Form.Row>\r\n           \r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n          <FormLabel bold primary=\"\" />\r\n          <Form.Row noMargin width=\"65%\">\r\n          <MultiAdderInputModal\r\n            name=\"addresses\"\r\n            values={addresses}\r\n            // error={addresses}\r\n            style={GLOBALS.Styles.inputWidth}\r\n            placeholder=\"Enter site addresses\"\r\n            onChange={(values) => handleChange(\"addresses\", values)}\r\n          />\r\n          </Form.Row>\r\n        </Form.Row>\r\n\r\n        <Form.Row>\r\n            <FormLabel bold primary=\"DISPONIBILITE : \" />\r\n            <Form.Row noMargin width=\"65%\" justifyContent=\"flex-start\" style={{gap: \"20px\"}}>\r\n              <FormInput\r\n                type=\"date\"\r\n                style={{width: \"300px\"}}\r\n                placeholder=\"Date de début\"\r\n                name=\"contractStartDate\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.contractStartDate}\r\n                error={formik.errors.contractStartDate}\r\n              />\r\n              <FormInput\r\n                type=\"date\"\r\n                placeholder=\"Date de fin\"\r\n                style={{width: \"300px\"}}\r\n                name=\"contractEndDate\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.contractEndDate}\r\n                error={formik.errors.contractEndDate}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"FICHE TECHNIQUE : \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormMultipleUpload\r\n                name=\"logo\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                error={formik.errors.logo}\r\n                values={formik.values.logo}\r\n                onChange={(values) =>\r\n                  formik.handleChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"logo\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n              />\r\n              \r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"INDISPONIBILITES : \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n            <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"VOIR LES INDISPONIBILITÉS\"\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"0px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\"\r\n                }}\r\n              />\r\n              \r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n\r\n         \r\n         \r\n          \r\n          \r\n         \r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"TARIF HORAIRE : \" />\r\n           <Form.Row noMargin width=\"65%\">\r\n           <FormInput\r\n              textArea\r\n              rows={1}\r\n              style={{width: \"300px\", textAlign: \"right\"}}\r\n              onChange={formik.handleChange}\r\n              placeholder=\"€\"\r\n              name=\"additionalInfo\"\r\n              value={formik.values.additionalInfo}\r\n              error={formik.errors.additionalInfo}\r\n            />\r\n           </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"INFORMATIONS COMPLÉMENTAIRES : \" />\r\n           <Form.Row noMargin width=\"65%\">\r\n           <FormInput\r\n              textArea\r\n              rows={3}\r\n              style={{width: \"600px\"}}\r\n              onChange={formik.handleChange}\r\n              placeholder=\"Informations complémentaires\"\r\n              name=\"additionalInfo\"\r\n              value={formik.values.additionalInfo}\r\n              error={formik.errors.additionalInfo}\r\n            />\r\n           </Form.Row>\r\n          </Form.Row>\r\n          \r\n         \r\n          <Form.Row>\r\n          <Form.ButtonContainer style={{width: \"80%\"}}>\r\n            <Button\r\n              type=\"submit\"\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              fullWidth={false}\r\n              loading={formik.isSubmitting}\r\n              disabled={formik.isSubmitting}\r\n            />\r\n          </Form.ButtonContainer>\r\n          </Form.Row>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\Historic.js",["507","508","509","510","511","512","513","514","515","516","517","518","519","520"],"import React, { useState, useEffect } from \"react\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\nimport * as Yup from \"yup\";\r\n\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport { useFormik } from \"formik\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\n\r\n// import Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SmallButton from \"../../../components/SmallButton\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport FormInput from \"../../../components/FormInput\";\r\n\r\nimport SiteImage from \"../../../assets/images/Site.png\";\r\nimport { Images } from \"../../../assets/Assets\";\r\n\r\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n  link: {\r\n    marginRight: 20,\r\n    whiteSpace: \"nowrap\",\r\n    color: theme.palette.primary.contrastText,\r\n  },\r\n  image: {\r\n    height: 70,\r\n    borderRadius: theme.shape.borderRadius,\r\n  },\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nconst Historic = () => {\r\n  const classes = useStyles();\r\n  const theme = useTheme();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const [loading, setLoading] = useState(true);\r\n  const [items, setItems] = useState([]);\r\n  const [page] = useState(1);\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  async function fetchData() {\r\n    try {\r\n      const result = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.SITE}?page=${page}`,\r\n      });\r\n      setItems(result.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const rows = GLOBALS.Data.meansOfHistoric.items.map((item) => {\r\n    return [...item];\r\n  });\r\n\r\n  async function onArchive(itemId) {\r\n    try {\r\n      if (window.confirm(\"Are you sure, you want to do this?\")) {\r\n        setLoading(true);\r\n        await GLOBALS.API({\r\n          method: \"PUT\",\r\n          token: store.token,\r\n          uri: GLOBALS.Constants.SITE_ARCHIVE + \"/\" + itemId,\r\n        });\r\n        const itemsArray = items.filter((item) => item._id !== itemId);\r\n        setItems(itemsArray);\r\n        setLoading(false);\r\n      }\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    // validationSchema: addClientYup,\r\n    // onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <Form.Row alignItems=\"center\">\r\n        <Heading primary=\"LIST OF MEANS - HISTORIC\" noWrap />\r\n        <div>\r\n          <Form.Row\r\n            alignItems=\"flex-start\"\r\n            noMargin\r\n            justifyContent=\"flex-end\"\r\n            style={{ paddingRight: \"50px\" }}\r\n          >\r\n            <Form.Column style={{ width: \"50%\", marginRight: \"50px\" }}>\r\n              <img src={Images.site} alt=\"\" />\r\n            </Form.Column>\r\n          </Form.Row>\r\n        </div>\r\n      </Form.Row>\r\n      <Form.Row alignItems=\"center\" noMargin>\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          {/* <SearchInput\r\n            placeholder=\"Site name\"\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          /> */}\r\n          <FormSelect\r\n            placeholder=\"Company\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Mean\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\r\n          See archived sites\r\n        </NavLink> */}\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Table headers={GLOBALS.Data.meansOfHistoric.headings} rows={rows} />\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Historic;\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\CustomInputModal.js",["521","522"],"import React, { useState } from \"react\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n// import * as Yup from \"yup\";\r\nimport Grid from \"@material-ui/core/Grid\";\r\nimport Chip from \"@material-ui/core/Chip\";\r\nimport { useFormik } from \"formik\";\r\nimport GLOBALS from \"../globals\";\r\nimport FormSelect from \"../components/FormSelect\";\r\n\r\n\r\n\r\nimport Form from \"./Form\";\r\nimport Modal from \"./Modal\";\r\nimport Button from \"./Button\";\r\nimport FormInput from \"./FormInput\";\r\n\r\nimport { ReactComponent as Plus } from \"../assets/icons/Plus.svg\";\r\n\r\n// const addAddressesYup = Yup.object().shape({\r\n//   street: Yup.string().required(\"Required\"),\r\n//   city: Yup.string().required(\"Required\"),\r\n//   postal: Yup.string().required(\"Required\"),\r\n// });\r\n\r\nexport default function CustomInputModal(props) {\r\n  const theme = useTheme();\r\n\r\n  const error = theme.palette.error.main;\r\n  const white = theme.palette.common.white;\r\n  const primaryColor = theme.palette.primary.contrastText;\r\n  const borderColor = props.error ? error : theme.palette.grey[100];\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      logo: [],\r\n      name: \"\",\r\n      storage: \"\",\r\n      deliveryAreas:\"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    \r\n    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n\r\n  const useStyles = makeStyles((theme) => ({\r\n    root: {\r\n      position: \"relative\",\r\n    },\r\n    container: {\r\n      width: 45,\r\n      height: 45,\r\n      outline: 0,\r\n      borderWidth: 1,\r\n      display: \"grid\",\r\n      cursor: \"pointer\",\r\n      borderStyle: \"solid\",\r\n      placeItems: \"center\",\r\n      backgroundColor: white,\r\n      borderColor: borderColor,\r\n    },\r\n    chips: {\r\n      margin: 0,\r\n      marginTop: 15,\r\n      display: \"flex\",\r\n      flexWrap: \"wrap\",\r\n      listStyle: \"none\",\r\n      justifyContent: \"center\",\r\n    },\r\n    chip: {\r\n      color: primaryColor,\r\n      margin: theme.spacing(0.5),\r\n    },\r\n    error: {\r\n      color: error,\r\n      fontWeight: 400,\r\n      position: \"absolute\",\r\n      fontSize: theme.typography.pxToRem(12),\r\n    },\r\n  }));\r\n\r\n  const classes = useStyles();\r\n  const [modal, setModal] = useState(false);\r\n  const [update, setUpdate] = useState(false);\r\n\r\n  const [street, setStreet] = useState(\"\");\r\n  const [city, setCity] = useState(\"\");\r\n  const [postal, setPostal] = useState(\"\");\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"street\") setStreet(value);\r\n    else if (name === \"city\") setCity(value);\r\n    else if (name === \"postal\") setPostal(value);\r\n  };\r\n\r\n  async function onSubmit() {\r\n    let newValues = props.values;\r\n\r\n    const values = {\r\n      key: newValues.length,\r\n      street: street,\r\n      city: city,\r\n      postal: postal,\r\n      label: `${street} ${city} ${postal}`,\r\n    };\r\n    newValues.push(values);\r\n    props.onChange(newValues);\r\n\r\n    setUpdate((st) => !st);\r\n    setModal(false);\r\n    setStreet(\"\");\r\n    setCity(\"\");\r\n    setPostal(\"\");\r\n  }\r\n\r\n  const handleDelete = (value) => () => {\r\n    const newValues = props.values.filter((chip) => chip.key !== value.key);\r\n    props.onChange(newValues);\r\n    setUpdate((st) => !st);\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <div className={`${classes.root} ${props.className}`} style={props.style}>\r\n        <Grid container spacing={2}>\r\n          <Grid item xs={4}>\r\n            <div className={classes.container}>\r\n              <div\r\n                onClick={() => {\r\n                  setModal(true);\r\n                  props.onBlur && props.onBlur();\r\n                }}\r\n              >\r\n                <Plus style={{ width: 20, height: 20 }} />\r\n              </div>\r\n            </div>\r\n            {props.error !== \"\" && (\r\n              <span className={classes.error}>{props.error}</span>\r\n            )}\r\n          </Grid>\r\n          {update && \"\"}\r\n          <ul className={classes.chips}>\r\n            {props.values.map((data) => (\r\n              <li key={data.key}>\r\n                <Chip\r\n                  label={data.label}\r\n                  className={classes.chip}\r\n                  onDelete={handleDelete(data)}\r\n                />\r\n              </li>\r\n            ))}\r\n          </ul>\r\n        </Grid>\r\n      </div>\r\n      <Modal\r\n        title=\"ADD LOCATION\"\r\n        open={modal}\r\n        onClose={() => setModal((st) => !st)}\r\n        body={\r\n          <Form.Form>\r\n            \r\n            <Form.Row>\r\n            <FormSelect\r\n                placeholder=\"Storage\"\r\n                name=\"Storage\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={formik.handleChange}\r\n                value={formik.values.storage}\r\n                error={formik.errors.storage}\r\n                values={[\r\n                  { value: \"green\", label: \"Green\" },\r\n                  { value: \"Yellow\", label: \"Yellow\" },\r\n                  { value: \"Red\", label: \"Red\" },\r\n                  { value: \"Blue\", label: \"Blue\" },\r\n                  { value: \"Orange\", label: \"Orange\" },\r\n                  { value: \"Purple\", label: \"Purple\" },\r\n                  { value: \"Magenta\", label: \"Magenta\" },\r\n                ]}\r\n              />\r\n              <FormSelect\r\n                placeholder=\"Delivery Areas\"\r\n                name=\"deliveryAreas\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={formik.handleChange}\r\n                value={formik.values.deliveryAreas}\r\n                error={formik.errors.deliveryAreas}\r\n                values={[\r\n                  { value: \"green\", label: \"Green\" },\r\n                  { value: \"Yellow\", label: \"Yellow\" },\r\n                  { value: \"Red\", label: \"Red\" },\r\n                  { value: \"Blue\", label: \"Blue\" },\r\n                  { value: \"Orange\", label: \"Orange\" },\r\n                  { value: \"Purple\", label: \"Purple\" },\r\n                  { value: \"Magenta\", label: \"Magenta\" },\r\n                ]}\r\n              />\r\n            </Form.Row>\r\n            \r\n    \r\n            <Form.Row justifyContent=\"center\">\r\n              <Button\r\n                minWidth={200}\r\n                text=\"VALIDATE\"\r\n                fullWidth={false}\r\n                onClick={onSubmit}\r\n                disabled={ !formik.values.storage || !formik.values.deliveryAreas}\r\n              />\r\n            </Form.Row>\r\n          </Form.Form>\r\n        }\r\n      />\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\CustomButtonModal.js",["523","524","525","526"],"import React, { useState } from \"react\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n// import * as Yup from \"yup\";\r\nimport Grid from \"@material-ui/core/Grid\";\r\nimport Chip from \"@material-ui/core/Chip\";\r\nimport { useFormik } from \"formik\";\r\nimport GLOBALS from \"../globals\";\r\nimport FormSelect from \"../components/FormSelect\";\r\n\r\n\r\n\r\nimport Form from \"./Form\";\r\nimport Modal from
ding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n}));\n\nexport default function Clients(props) {\n  const theme = useTheme();\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [loading, setLoading] = useState(true);\n  const [clients, setClients] = useState([]);\n  const [page, setPage] = useState(1);\n\n  const [modal, setModal] = useState(false);\n\n  const [avatar, setAvatar] = useState(\"\");\n  const [endDate, setEndDate] = useState(\"\");\n  const [startDate, setStartDate] = useState(\"\");\n  const [notifyDays, setNotifyDays] = useState(\"\");\n  const [information, setInformation] = useState(\"\");\n  const [functionality, setFunctionality] = useState(\"DELIVERY\");\n  const [typeOfContract, setTypeOfContract] = useState(\"CLIENTPERSITE\");\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_CLIENTS}?page=${page}`,\n      });\n      let resultArray = result.data.items.map((item) => [\n        item.companyId.name,\n        item.companyId.incharge.firstName +\n          \" \" +\n          item.companyId.incharge.lastName,\n        item.companyId.incharge.phone,\n        2,\n        moment(item.contractStartDate).format(\"DD/MM/YY\"),\n        moment(item.contractEndDate).format(\"DD/MM/YY\"),\n        item.isPendingResponse ? \"Requested\" : item.companyId.type,\n      ]);\n      setClients(resultArray);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err, \"error\"),\n        ),\n      );\n    }\n  }\n\n  return (\n    <>\n      <div className={classes.root}>\n        <Form.Row alignItems=\"center\">\n          <Heading primary=\"CLIENTS LIST\" noWrap />\n          <div>\n            <Form.Row alignItems=\"center\" noMargin>\n              <SubHeading disableMargin primary=\"Total : 234 Clients\" bold />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"CREATE A CLIENT\"\n                style={{ marginLeft: \"20px\" }}\n                to={\"/clients/add-client\"}\n              />\n            </Form.Row>\n          </div>\n        </Form.Row>\n        <Form.Row noMargin>\n          <SearchInput placeholder=\"Name of Client\" />\n        </Form.Row>\n        <div className={classes.content}>\n          <Table\n            headers={GLOBALS.Data.clients.headings}\n            rows={clients.map((item) =>\n              item[6] === \"Requested\"\n                ? [\n                    ...item,\n                    <IconButton>\n                      <Plus style={{ width: 18, height: 18 }} />\n                    </IconButton>,\n                  ]\n                : [\n                    ...item,\n                    <>\n                      <IconButton onClick={() => setModal(true)}>\n                        <Pencil style={{ width: 18, height: 18 }} />\n                      </IconButton>\n                      <IconButton component={NavLink} to=\"/clients/invoices\">\n                        <Report style={{ width: 18, height: 18 }} />\n                      </IconButton>\n                    </>,\n                  ],\n            )}\n          />\n        </div>\n      </div>\n      <Modal\n        open={modal}\n        title={\"EDIT CLIENT\"}\n        onClose={() => setModal((st) => !st)}\n        body={\n          <Form.Form>\n            <Form.Row justifyContent=\"center\">\n              <AvatarUpload\n                onChange={(file) => {\n                  const uri = URL.createObjectURL(file);\n                  setAvatar({ file, uri });\n                }}\n                value={avatar}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                placeholder=\"Color\"\n                style={GLOBALS.Styles.inputWidth}\n              />\n            </Form.Row>\n            <Form.Row>\n              <FormInput\n                placeholder=\"First Name\"\n                style={GLOBALS.Styles.inputWidth}\n              />\n              <FormInput\n                placeholder=\"Last Name\"\n                style={GLOBALS.Styles.inputWidth}\n              />\n            </Form.Row>\n            <Form.Row>\n              <FormInput\n                placeholder=\"E-mail\"\n                style={GLOBALS.Styles.inputWidth}\n              />\n              <FormInput\n                placeholder=\"Phone\"\n                style={GLOBALS.Styles.inputWidth}\n              />\n            </Form.Row>\n            <Form.Row>\n              <FormInput\n                type=\"date\"\n                value={startDate}\n                placeholder=\"Start date\"\n                style={GLOBALS.Styles.inputWidth}\n                onChance={({ target: { value } }) => setStartDate(value)}\n              />\n              <FormInput\n                type=\"date\"\n                value={endDate}\n                placeholder=\"End date\"\n                style={GLOBALS.Styles.inputWidth}\n                onChance={({ target: { value } }) => setEndDate(value)}\n              />\n            </Form.Row>\n            <Form.Row>\n              <RadioButton\n                value={typeOfContract}\n                onChange={({ target: { value } }) => setTypeOfContract(value)}\n                items={[\n                  { value: \"CLIENTPERSITE\", label: \"Per Site\" },\n                  { value: \"MASTERCLIENT\", label: \"Master Contract\" },\n                ]}\n              />\n            </Form.Row>\n            <Form.Row>\n              <RadioButton\n                value={functionality}\n                onChange={({ target: { value } }) => setFunctionality(value)}\n                items={[{ value: \"DELIVERY\", label: \"Delivery module\" }]}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <Form.Row noMargin alignItems=\"center\" width=\"150px\">\n                <FormInput\n                  type=\"number\"\n                  value={notifyDays}\n                  placeholder=\"Price\"\n                  style={{ ...GLOBALS.Styles.inputWidth, maxWidth: 100 }}\n                  onChange={({ target: { value } }) => setNotifyDays(value)}\n                />\n                <SmallText primary=\"€/month\" />\n              </Form.Row>\n            </Form.Row>\n            <Form.Row>\n              <FormInput\n                textArea\n                rows={3}\n                value={information}\n                // style={GLOBALS.Styles.inputWidth}\n                placeholder=\"Additional information\"\n                onChange={({ target: { value } }) => setInformation(value)}\n              />\n            </Form.Row>\n          </Form.Form>\n        }\n        actions={\n          <Form.Column alignItems=\"center\">\n            <Form.Row justifyContent=\"center\">\n              <Button text=\"VALIDATE\" fullWidth={false} minWidth=\"30%\" />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <Button\n                text=\"DELETE\"\n                fullWidth={false}\n                minWidth=\"30%\"\n                color={theme.palette.error.main}\n              />\n            </Form.Row>\n          </Form.Column>\n        }\n      />\n    </>\n  );\n}\n","/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Clients/AddClient.js",["277","278","279","280","281","282","283","284","285","286","287","288","289","290","291","292"],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/components/FormInput.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/components/FormLabel.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/components/RadioButton.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/components/MultiAdderInput.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/components/FormSelect.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/components/FormMultipleUpload.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Clients/Invoices.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Sites/index.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Sites/Sites.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Sites/ZACs.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Sites/ArchivedSites.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/components/SmallButton.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Sites/AddSite/index.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep1.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep2.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep3.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/components/Stepper.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Admins/index.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Admins/Admins.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Admins/AddAdmin.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/globals/Styles.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Sites/AddZAC.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/components/Modal.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/components/AvatarUpload.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/redux/store.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/redux/reducers/index.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/redux/actions/actionTypes.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/redux/reducers/auth.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/redux/utility.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/redux/actions/index.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/redux/actions/auth.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/redux/index.js",["293"],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/pages/UnAuth/UnAuthHeader.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/components/ErrorBoundary.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/redux/actions/notistack.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/redux/Notifier.js",[],"/Users/invalid/Desktop/Talha/OrgaPlan/OrgaPlan-React/src/redux/reducers/notistack.js",[],{"ruleId":"294","replacedBy":"295"},{"ruleId":"296","replacedBy":"297"},{"ruleId":"298","severity":1,"message":"299","line":44,"column":9,"nodeType":"300","messageId":"301","endLine":44,"endColumn":14},{"ruleId":"298","severity":1,"message":"302","line":46,"column":10,"nodeType":"300","messageId":"301","endLine":46,"endColumn":17},{"ruleId":"298","severity":1,"message":"303","line":48,"column":16,"nodeType":"300","messageId":"301","endLine":48,"endColumn":23},{"ruleId":"298","severity":1,"message":"304","line":2,"column":10,"nodeType":"300","messageId":"301","endLine":2,"endColumn":17},{"ruleId":"298","severity":1,"message":"305","line":70,"column":23,"nodeType":"300","messageId":"301","endLine":70,"endColumn":30},{"ruleId":"298","severity":1,"message":"306","line":71,"column":24,"nodeType":"300","messageId":"301","endLine":71,"endColumn":32},{"ruleId":"298","severity":1,"message":"307","line":72,"column":39,"nodeType":"300","messageId":"301","endLine":72,"endColumn":51},{"ruleId":"298","severity":1,"message":"308","line":73,"column":38,"nodeType":"300","messageId":"301","endLine":73,"endColumn":49},{"ruleId":"298","severity":1,"message":"309","line":74,"column":35,"nodeType":"300","messageId":"301","endLine":74,"endColumn":43},{"ruleId":"298","severity":1,"message":"310","line":75,"column":35,"nodeType":"300","messageId":"301","endLine":75,"endColumn":43},{"ruleId":"298","severity":1,"message":"311","line":76,"column":26,"nodeType":"300","messageId":"301","endLine":76,"endColumn":43},{"ruleId":"298","severity":1,"message":"312","line":77,"column":29,"nodeType":"300","messageId":"301","endLine":77,"endColumn":41},{"ruleId":"298","severity":1,"message":"313","line":78,"column":27,"nodeType":"300","messageId":"301","endLine":78,"endColumn":37},{"ruleId":"298","severity":1,"message":"314","line":79,"column":35,"nodeType":"300","messageId":"301","endLine":79,"endColumn":51},{"ruleId":"298","severity":1,"message":"315","line":80,"column":33,"nodeType":"300","messageId":"301","endLine":80,"endColumn":47},{"ruleId":"298","severity":1,"message":"316","line":81,"column":35,"nodeType":"300","messageId":"301","endLine":81,"endColumn":48},{"ruleId":"298","severity":1,"message":"317","line":84,"column":10,"nodeType":"300","messageId":"301","endLine":84,"endColumn":16},{"ruleId":"298","severity":1,"message":"318","line":84,"column":18,"nodeType":"300","messageId":"301","endLine":84,"endColumn":27},{"ruleId":"319","severity":1,"message":"320","line":126,"column":5,"nodeType":"321","messageId":"322","endLine":126,"endColumn":9},{"ruleId":"323","severity":1,"message":"324","line":1,"column":1,"nodeType":"325","endLine":1,"endColumn":34},"no-native-reassign",["326"],"no-negated-in-lhs",["327"],"no-unused-vars","'store' is assigned a value but never used.","Identifier","unusedVar","'loading' is assigned a value but never used.","'setPage' is assigned a value but never used.","'useForm' is defined but never used.","'setName' is assigned a value but never used.","'setColor' is assigned a value but never used.","'setFirstName' is assigned a value but never used.","'setLastName' is assigned a value but never used.","'setEmail' is assigned a value but never used.","'setPhone' is assigned a value but never used.","'setTypeOfContract' is assigned a value but never used.","'setStartDate' is assigned a value but never used.","'setEndDate' is assigned a value but never used.","'setFunctionality' is assigned a value but never used.","'setInformation' is assigned a value but never used.","'setNotifyDays' is assigned a value but never used.","'errors' is assigned a value but never used.","'setErrors' is assigned a value but never used.","no-eval","eval can be harmful.","CallExpression","unexpected","import/no-anonymous-default-export","Assign literal to a variable before exporting as module default","ExportDefaultDeclaration","no-global-assign","no-unsafe-negation"]
x.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Calender/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Incidents/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Companies/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Means/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Pic/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Organigramme/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Button.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/globals/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/assets/Assets.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Admins/AddAdmin.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Companies/AddUser.js",["483","484","485","486","487","488","489","490","491","492"],"import React, { useState, useEffect } from \"react\";\nimport { useFormik } from \"formik\";\nimport { useSelector, useDispatch } from \"react-redux\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport * as Yup from \"yup\";\n\nimport GLOBALS from \"../../../globals\";\nimport Form from \"../../../components/Form\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport FormLabel from \"../../../components/FormLabel\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\nimport TextField from \"@material-ui/core/TextField\";\nimport Actions from \"../../../redux/actions\";\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n}));\n\nconst addClientYup = Yup.object().shape({\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\n  name: Yup.string().required(\"Required\"),\n  email: Yup.string().required(\"Required\"),\n  firstName: Yup.string().required(\"Required\"),\n  lastName: Yup.string().required(\"Required\"),\n  site: Yup.string().required(\"Required\"),\n  phone: Yup.number()\n    .test(\n      \"len\",\n      \"Must be exactly 10 characters\",\n      (val) => val && val.toString().length === 10,\n    )\n    .required(\"Required\"),\n});\n\nexport default function AddUser(props) {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n  const [page] = useState(1);\n  const [companies, setCompanies] = useState([]);\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\n\n  const [roles, setRoles] = useState([]);\n  const [dropdownRoles, setDropdownRoles] = useState([]);\n  const [selectedRole, setSelectedRole] = useState(\"\");\n  const [selectedRoleIndex, setSelectedRoleIndex] = useState(null);\n\n  const [siteParams, setSiteParams] = useState([]);\n\n  const [users, setUsers] = useState([]);\n\n  useEffect(() => {\n    getData();\n  }, []);\n\n  const getData = async () => {\n    try {\n      formik.setFieldValue(\"site\", adminStore.site.siteId.name);\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_ADD_USER}/${adminStore.site.siteId._id}/${store.user._id}`,\n        token: store.token,\n      });\n      if (response.success) {\n        setCompanies(response.data.site_companies.companies);\n        setRoles(response.data.site_companies.companies);\n        setUsers(response.data.users);\n        if (response.data.site_companies != null) {\n          const companyTemp = [];\n\n          response.data.site_companies.companies.map((item, index) => {\n            return companyTemp.push({ label: item.name, value: item.name });\n          });\n          setDropdownCompanies(companyTemp);\n        }\n        if (response.data.roles != null) {\n          const rolesTemp = [];\n\n          response.data.roles.map((item, index) => {\n            return rolesTemp.push({ label: item, value: item });\n          });\n          setDropdownRoles(rolesTemp);\n        }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getUserCompany = async (userId) => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_USER_COMPANY}/${adminStore.site.siteId._id}/${userId}`,\n        token: store.token,\n      });\n      if (response.success) {\n        console.log(JSON.stringify(response, null, 2));\n        if (response.data) {\n          companies.forEach((item, index) => {\n            if (item._id === response.data._id) {\n              item.users.forEach((innerItem, innerIndex) => {\n                console.log(\"innser \", innerItem.userId);\n                if (innerItem.userId === userId) {\n                  setSelectedRoleIndex(innerIndex);\n\n                  setSelectedRole(innerItem.role);\n                }\n              });\n              setSelectedCompanyIndex(index);\n\n              setSelectedCompany(item.name);\n            }\n          });\n        }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const onSubmit = async () => {\n    const values = formik.values;\n    const sites = [];\n    siteParams.forEach((item) => {\n      sites.push({ siteId: item.id, role: selectedRole });\n    });\n    var formdata = new FormData();\n    formdata.append(\"image\", values.logo[0].file);\n    //formdata.append(\"name\", values.name);\n    formdata.append(\"firstName\", values.firstName);\n    formdata.append(\"lastName\", values.lastName);\n    formdata.append(\"email\", values.email);\n    formdata.append(\"phone\", values.phone);\n    formdata.append(\"sites\", JSON.stringify(sites));\n    formdata.append(\"companyId\", companies[selectedCompanyIndex]._id);\n\n    await GLOBALS.API({\n      method: \"POST\",\n      uri: GLOBALS.Constants.ADD_USER_ADMIN,\n      headers: {\n        Authorization: store.token,\n      },\n      body: formdata,\n    });\n    formik.setSubmitting(false);\n    props.history.push(\"/clients\");\n  };\n\n  const formik = useFormik({\n    initialValues: {\n      logo: [],\n      name: \"\",\n      color: \"\",\n      firstName: \"\",\n      lastName: \"\",\n      email: \"\",\n      phone: \"\",\n      site: \"\",\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n    },\n    validationSchema: addClientYup,\n    onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n      <Heading primary=\"ADD USER\" />\n      <div className={classes.content}>\n        <Form.Form onSubmit={formik.handleSubmit}>\n          <Form.Row>\n            <FormLabel bold primary=\"CONTACT INFO* :\" />\n            <Form.Row width=\"48%\">\n              {/* <FormInput\n                name=\"name\"\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\n                placeholder=\"Adresse e-mail\"\n                onChange={formik.handleChange}\n                value={formik.values.name}\n                error={formik.errors.name}\n              /> */}\n              <Autocomplete\n                id=\"free-solo-demo\"\n                freeSolo\n                style={{\n                  ...GLOBALS.Styles.inputWidth,\n                  marginRight: \"10px\",\n                }}\n                onSelect={(event) => {\n                  users.forEach((item, index) => {\n                    if (item.userId.email === event.target.value) {\n                      console.log(JSON.stringify(item.sites, null, 2));\n                      formik.setFieldValue(\"firstName\", item.userId.firstName);\n                      formik.setFieldValue(\"lastName\", item.userId.lastName);\n                      formik.setFieldValue(\"phone\", item.userId.phone);\n                      formik.setFieldValue(\"logo\", [\n                        { uri: item.userId.image },\n                      ]);\n\n                      getUserCompany(item.userId._id);\n                    }\n                  });\n                }}\n                options={users.map((option) => {\n                  if (option.userId.email != undefined)\n                    return option.userId.email;\n                })}\n                renderInput={(params) => (\n                  <TextField\n                    {...params}\n                    label=\"Email\"\n                    margin=\"normal\"\n                    variant=\"outlined\"\n                    name=\"email\"\n                    value={formik.values.email}\n                    error={formik.errors.email}\n                    onChange={formik.handleChange}\n                  />\n                )}\n              />\n              <FormInput\n                name=\"phone\"\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\n                placeholder=\"Téléphone\"\n                onChange={formik.handleChange}\n                value={formik.values.phone}\n                error={formik.errors.phone}\n              />\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"INDENTITY* :\" />\n            <Form.Row width=\"48%\">\n              <FormInput\n                name=\"firstName\"\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\n                placeholder=\"FIRST NAME\"\n                onChange={formik.handleChange}\n                value={formik.values.firstName}\n                error={formik.errors.firstName}\n              />\n              <FormInput\n                name=\"lastName\"\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\n                placeholder=\"LAST NAME\"\n                onChange={formik.handleChange}\n                value={formik.values.lastName}\n                error={formik.errors.name}\n              />\n              <FormMultipleUpload\n                name=\"logo\"\n                style={GLOBALS.Styles.inputWidth}\n                error={formik.errors.logo}\n                values={formik.values.logo}\n                onChange={(values) =>\n                  formik.handleChange({\n                    target: {\n                      type: \"text\",\n                      name: \"logo\",\n                      value: values,\n                    },\n                  })\n                }\n              />\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"COMPANY : \" />\n            <Form.Row noMargin width=\"48%\">\n              <FormSelect\n                placeholder=\"Company\"\n                values={dropdownCompanies}\n                value={selectedCompany}\n                onChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n\n                  if (index !== -1) {\n                    const item = event.target.value;\n\n                    setSelectedCompanyIndex(index);\n\n                    setSelectedCompany(item);\n                  } else {\n                    setSelectedCompanyIndex(null);\n\n                    setSelectedCompany(\"\");\n                  }\n                }}\n                style={{ marginRight: \"20px\", maxWidth: 250 }}\n              />\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"RÔLE : \" />\n            <Form.Row noMargin width=\"48%\">\n              <FormSelect\n                placeholder=\"RÔLE : \"\n                name=\"color\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={formik.handleChange}\n                value={formik.values.color}\n                error={formik.errors.color}\n                values={dropdownRoles}\n                value={selectedRole}\n                onChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n\n                  if (index !== -1) {\n                    const item = event.target.value;\n\n                    setSelectedRoleIndex(index);\n\n                    setSelectedRole(item);\n                  } else {\n                    setSelectedRoleIndex(null);\n\n                    setSelectedRole(\"\");\n                  }\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"CONSTRUCTION SITE : \" />\n            <Form.Row noMargin width=\"48%\">\n              <FormInput\n                name=\"site\"\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\n                placeholder=\"Site\"\n                onChange={formik.handleChange}\n                value={formik.values.site}\n                error={formik.errors.site}\n                disabled={true}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.ButtonContainer>\n            <Button\n              minWidth={200}\n              text=\"CONTINUER\"\n              fullWidth={false}\n              onClick={() => {\n                onSubmit();\n              }}\n              loading={formik.isSubmitting}\n              disabled={formik.isSubmitting}\n            />\n          </Form.ButtonContainer>\n        </Form.Form>\n      </div>\n    </div>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Companies/UserList.js",["493","494"],"import React, { useState, useEffect } from \"react\";\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n// import * as Yup from \"yup\";\n\nimport GLOBALS from \"../../../globals\";\nimport Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Modal from \"../../../components/Modal\";\nimport SmallButton from \"../../../components/SmallButton\";\n\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport AvatarUpload from \"../../../components/AvatarUpload\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n}));\n\n// const updateAdminYup = Yup.object().shape({\n//   email: Yup.string().required(\"Required\"),\n//   phone: Yup.number()\n//     .test(\n//       \"len\",\n//       \"Must be exactly 10 characters\",\n//       (val) => val && val.toString().length === 10,\n//     )\n//     .required(\"Required\"),\n//   image: Yup.object().optional(\"\"),\n//   companyId: Yup.string().required(\"Required\"),\n// });\n\nexport default function UserList(props) {\n  const theme = useTheme();\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n  const [page] = useState(1);\n  const [items, setItems] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [companies, setCompanies] = useState([]);\n  const [open, setOpen] = useState(false);\n\n  const [selectedItem] = useState(\"\");\n\n  const [firstName, setFirstName] = useState(\"\");\n  const [lastName, setLastName] = useState(\"\");\n  const [phone, setPhone] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [companyId, setCompanyId] = useState(\"\");\n  const [companyName, setCompanyName] = useState(\"\");\n  const [users, setUsers] = useState([]);\n  useEffect(() => {\n    getData();\n    // eslint-disable-next-line\n  }, []);\n\n  const getData = async () => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_COMPANY_USERS}/${adminStore.site.siteId._id}/${props.location.id}`,\n        token: store.token,\n      });\n      //console.log(JSON.stringify(response.data[0].usersArray, null, 2));\n      if (response.success) {\n        setCompanyName(response.data[0].company.name);\n        setUsers(response.data[0].usersArray);\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n  const resendVerificaiontRequest = () => {};\n  const handleChange = (name, value) => {\n    if (name === \"firstName\") setFirstName(value);\n    else if (name === \"lastName\") setLastName(value);\n    else if (name === \"phone\") setPhone(value);\n    else if (name === \"image\") setImage(value);\n    else if (name === \"companyId\") setCompanyId(value);\n  };\n\n  const onUpdate = async (e) => {\n    try {\n      e.preventDefault();\n      setLoading(true);\n      var formdata = new FormData();\n      formdata.append(\"firstName\", firstName);\n      formdata.append(\"lastName\", lastName);\n      formdata.append(\"phone\", phone);\n      formdata.append(\"companyId\", companyId);\n      formdata.append(\"userId\", selectedItem._id);\n      image.file && formdata.append(\"image\", image.file);\n\n      const result = await GLOBALS.API({\n        method: \"PUT\",\n        uri: GLOBALS.Constants.ADMINS,\n        headers: {\n          Authorization: store.token,\n        },\n        body: formdata,\n      });\n      const itemsArray = items.map((item) =>\n        item._id === selectedItem._id ? result.data : item,\n      );\n      setItems(itemsArray);\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n  const handleClickOpen = () => {\n    setOpen(true);\n  };\n  const rows = users.map((item) => {\n    console.log(JSON.stringify(item, null, 2));\n    const user = item;\n    return [\n      user.firstName + \" \" + user.lastName,\n      companyName,\n      item.role,\n      user.isVerified ? \"Inscrit\" : \"En attente\",\n      user.email,\n      <SmallButton\n        text={user.isVerified ? \"Edit\" : \"Re-Send\"}\n        onClick={user.isVerified ? handleClickOpen : resendVerificaiontRequest}\n        color={theme.palette.primary.contrastText}\n        to={\"/companies\"}\n        // component={NavLink}\n        style={{\n          marginLeft: 10,\n          borderRadius: 4,\n        }}\n      />,\n    ];\n  });\n\n  return (\n    <>\n      <div className={classes.root}>\n        <Form.Row alignItems=\"center\" className=\"pr-3\">\n          <Heading primary=\"LIST OF USERS\" noWrap />\n          <div>\n            <Form.Row alignItems=\"center\" noMargin>\n              <SubHeading\n                disableMargin\n                primary={`Total : ${users.length} Users`}\n                bold\n              />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"ADD A USER\"\n                style={{ marginLeft: \"20px\" }}\n                to={\"/companies/add-user\"}\n              />\n            </Form.Row>\n          </div>\n        </Form.Row>\n        {companies && \"\"}\n        <Form.Row noMargin>\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\n            <SearchInput placeholder=\"Name OF USER\" />\n            <FormSelect\n              placeholder=\"Company\"\n              name=\"color\"\n              style={{ marginLeft: \"20px\", maxWidth: 250 }}\n              values={[\n                { value: \"green\", label: \"Green\" },\n                { value: \"Yellow\", label: \"Yellow\" },\n                { value: \"Red\", label: \"Red\" },\n                { value: \"Blue\", label: \"Blue\" },\n                { value: \"Orange\", label: \"Orange\" },\n                { value: \"Purple\", label: \"Purple\" },\n                { value: \"Magenta\", label: \"Magenta\" },\n              ]}\n            />\n          </Form.Row>\n        </Form.Row>\n        <div className={classes.content}>\n          <Table headers={GLOBALS.Data.userList.headings} rows={rows} />\n        </div>\n      </div>\n      <Modal\n        title=\"THEIRRY MARLES\"\n        open={open}\n        onClose={() => setOpen(false)}\n        body={\n          <Form.Form onSubmit={onUpdate}>\n            <Form.Row justifyContent=\"center\">\n              <AvatarUpload\n                value={image}\n                // error={image}\n                onChange={(file) => {\n                  const uri = URL.createObjectURL(file);\n                  handleChange(\"image\", { file, uri });\n                }}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"thier@contrco.com\"\n                value={firstName}\n                // error={firstName}\n                placeholder=\"First Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"lastName\"\n                value={lastName}\n                // error={lastName}\n                placeholder=\"Last Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\"></Form.Row>\n            <Form.ButtonContainer>\n              <Button\n                type=\"submit\"\n                minWidth={200}\n                text=\"VALIDATE\"\n                fullWidth={false}\n                disabled={loading}\n              />\n            </Form.ButtonContainer>\n          </Form.Form>\n        }\n      />\n    </>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Companies/EditCompanies.js",["495","496","497","498","499","500","501","502","503","504","505","506","507","508","509","510","511","512","513","514","515","516","517"],"import React, { useState, useEffect } from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport MultiAdderInput from \"../../../components/MultiAdderInput\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport { InputSharp } from \"@material-ui/icons\";\r\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\r\nimport TextField from \"@material-ui/core/TextField\";\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n  error: {\r\n    color: \"red\",\r\n  },\r\n  radioLabel: {\r\n    marginLeft: \"7px\",\r\n    color: \"#7E7878\",\r\n    marginRight: \"50px\",\r\n  },\r\n  radioBtn: {},\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  images: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function EditCompany(props) {\r\n  const dispatch = useDispatch();\r\n\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [name, setName] = useState(\"\");\r\n  const [nameError, setNameError] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [colorError, setColorError] = useState(\"\");\r\n  const [images, setImages] = useState([]);\r\n  const [companyType, setCompanyType] = useState(\"subcontractor\");\r\n  const [companyTypeError, setCompanyTypeError] = useState(\"\");\r\n  const [contract, setContract] = useState(\"\");\r\n  const [contractError, setContractError] = useState(\"\");\r\n  const [typeError, setTypeError] = useState(\"\");\r\n  const [update, setUpdate] = useState(false);\r\n  const [email, setEmail] = useState(\"\");\r\n  const [emailError, setEmailError] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [phoneError, setPhoneError] = useState(\"\");\r\n  const [fname, setFname] = useState(\"\");\r\n  const [lname, setLname] = useState(\"\");\r\n  const [website, setWebsite] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  const [trades, setTrades] = useState([]);\r\n  const [dropdownTrades, setDropdownTrades] = useState([]);\r\n  const [selectedTrade, setSelectedTrade] = useState(\"\");\r\n  const [listOfTrades, setListOfTrades] = useState([]);\r\n  const [fieldsEnabled, setFieldsEnabled] = useState(true);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n  }, []);\r\n  useEffect(() => {\r\n    getCompanyAutoFill();\r\n  }, [companyId]);\r\n  const getData = async () => {\r\n    setCompanyId(props.location.id);\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_COMPANY}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.site_companies);\r\n        setTrades(response.data.site_trades);\r\n        if (response.data.site_companies != null) {\r\n          const companyTemp = [];\r\n\r\n          response.data.site_companies.map((item, index) => {\r\n            return companyTemp.push({\r\n              label: item.companyId.name,\r\n              value: item.companyId.name,\r\n            });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n\r\n        if (response.data.site_trades != null) {\r\n          const tradesTemp = [];\r\n\r\n          response.data.site_trades.map((item, index) => {\r\n            return tradesTemp.push({\r\n              label: item,\r\n              value: item,\r\n            });\r\n          });\r\n          setDropdownTrades(tradesTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getCompanyAutoFill = async () => {\r\n    if (companyId.length === 0) return;\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_COMPANY_AUTOFILL}/${adminStore.site.siteId._id}/${companyId}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.site_companies.length != 0) {\r\n          const company = response.data.site_companies[0].companyId;\r\n          const trades = response.data.site_companies[0].trades;\r\n          formik.setFieldValue(\"email\", company.name);\r\n          setName(company.name);\r\n          if (company.incharge != undefined) {\r\n            const incharge = company.incharge;\r\n            setFname(incharge.firstName);\r\n            setLname(incharge.lastName);\r\n            setEmail(incharge.email);\r\n            setPhone(incharge.phone);\r\n          } else {\r\n            setFname(\"\");\r\n            setLname(\"\");\r\n            setEmail(\"\");\r\n            setPhone(\"\");\r\n          }\r\n          if (company.color != undefined) setColor(company.color);\r\n          if (company.website != undefined) setWebsite(company.website);\r\n          else setWebsite(\"\");\r\n          if (company.description != undefined) setAddInfo(company.description);\r\n          else setAddInfo(\"\");\r\n          if (trades != undefined) {\r\n            const tradesTemp = [];\r\n            trades.forEach((item, index) => {\r\n              tradesTemp.push({ key: item, label: item });\r\n            });\r\n            setListOfTrades(tradesTemp);\r\n          }\r\n        }\r\n        await getGeneralContractor();\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getGeneralContractor = async () => {\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_GENERAL_CONTRACTOR}/${adminStore.site.siteId._id}/${companyId}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.companies.length === 0) {\r\n          await setCompanyType(\"generalcontractor\");\r\n          setSelectedCompany(\"\");\r\n          setSelectedCompanyIndex(null);\r\n        } else {\r\n          await setCompanyType(\"subcontractor\");\r\n          const company = response.data.companies[0].companyId;\r\n          let companyIndex = null;\r\n          let companyValue = null;\r\n          companies.forEach((item, index) => {\r\n            if (item.companyId._id === company._id) {\r\n              companyIndex = index;\r\n              companyValue = item.companyId.name;\r\n            }\r\n          });\r\n          if (companyIndex != null && companyValue != null) {\r\n            setSelectedCompany(companyValue);\r\n            setSelectedCompanyIndex(companyIndex);\r\n          } else {\r\n            setSelectedCompany(\"\");\r\n            setSelectedCompanyIndex(null);\r\n          }\r\n        }\r\n        console.log(JSON.stringify(response, null, 2));\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  // const [startDate, setStartDate] = useState(\"\");\r\n  // const [startDateError, setStartDateError] = useState(\"\");\r\n  // const [isDateSelect, setIsDateSelect] = useState(\"\");\r\n  // const [endDate, setEndDate] = useState(\"\");\r\n  // const [endDateError, setEndDateError] = useState(\"\");\r\n  // const [available, setAvailable] = useState(\"VOIR LES INDISPONIBILITÉS\");\r\n  // const [techSheet, setTechSheet] = useState([]);\r\n  // const [rate, setRate] = useState(\"\");\r\n  // const [rateError, setRateError] = useState(\"\");\r\n\r\n  const onSubmit = async () => {\r\n    // const notificationTo = values.notificationTo.map((item) => item.label);\r\n    const values = formik.values;\r\n    const isSubContractor = companyType === \"subcontractor\";\r\n    let parentCompanyId = undefined;\r\n    if (\r\n      companies.length != 0 &&\r\n      isSubContractor &&\r\n      companies[selectedCompanyIndex].companyId != undefined\r\n    )\r\n      parentCompanyId = companies[selectedCompanyIndex].companyId._id;\r\n\r\n    const trades = [];\r\n\r\n    listOfTrades.forEach((item, index) => {\r\n      trades.push(item.label);\r\n    });\r\n\r\n    var formdata = new FormData();\r\n    //formdata.append(\"logo\", values.images[0].file);\r\n\r\n    formdata.append(\"name\", name);\r\n    formdata.append(\"color\", color);\r\n    formdata.append(\"website\", website);\r\n    formdata.append(\"description\", addInfo);\r\n    formdata.append(\"trades\", JSON.stringify(trades));\r\n    formdata.append(\"siteId\", adminStore.site.siteId._id);\r\n\r\n    if (isSubContractor) {\r\n      if (parentCompanyId === undefined)\r\n        alert(\"You need to select a general contractor\");\r\n      formdata.append(\"parentCompanyId\", parentCompanyId);\r\n    }\r\n    if (\r\n      fname.length !== 0 &&\r\n      lname.length !== 0 &&\r\n      email.length !== 0 &&\r\n      phone.length !== 0\r\n    ) {\r\n      const incharge = {\r\n        firstName: fname,\r\n        lastName: lname,\r\n        email: email,\r\n        phone: phone,\r\n      };\r\n      formdata.append(\"incharge\", JSON.stringify(incharge));\r\n    }\r\n\r\n    const response = await GLOBALS.API({\r\n      method: \"POST\",\r\n\r\n      uri: GLOBALS.Constants.CREATE_COMPANY,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    if (response.success) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(response.message, \"success\"),\r\n        ),\r\n      );\r\n    }\r\n\r\n    formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n\r\n  const inputChange = (e) => {\r\n    if (e.target.name === \"name\") {\r\n      setName(e.target.value);\r\n      if (e.target.name === \"\" || name === null) {\r\n        setNameError(true);\r\n      } else {\r\n        setNameError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"color\") {\r\n      setColor(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setColorError(true);\r\n      } else {\r\n        setColorError(false);\r\n      }\r\n    }\r\n\r\n    if (e.target.name === \"contract\") {\r\n      setContract(e.target.value);\r\n      if (\r\n        e.target.value === \"\" ||\r\n        e.target.value === null ||\r\n        e.target.value === undefined\r\n      ) {\r\n        setContractError(true);\r\n      } else {\r\n        setContractError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"email\") {\r\n      setEmail(e.target.value);\r\n      var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n      if (!e.target.value.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"phone\") {\r\n      setPhone(e.target.value);\r\n      if (e.target.value.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    }\r\n\r\n    if (e.target.name === \"images\") {\r\n      setImages(e.target.value);\r\n    }\r\n    if (e.target.name === \"trades\") {\r\n      setTrades(e.target.value);\r\n    }\r\n\r\n    if (e.target.name === \"addInfo\") {\r\n      setAddInfo(e.target.value);\r\n    }\r\n  };\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"trades\") {\r\n      if (value !== \"\") {\r\n        setUpdate((st) => !st);\r\n        setTrades(value);\r\n      }\r\n    }\r\n  };\r\n\r\n  const submitHandler = (e) => {\r\n    var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n    e.preventDefault();\r\n    if (name === \"\" || name === null) {\r\n      setNameError(true);\r\n    }\r\n    if (color === \"\" || color === null) {\r\n      setColorError(true);\r\n    }\r\n    if (\r\n      companyType === \"\" ||\r\n      companyType === null ||\r\n      companyType === undefined\r\n    ) {\r\n      setCompanyTypeError(true);\r\n    }\r\n    if (contract === \"\" || contract === null || contract === undefined) {\r\n      setContractError(true);\r\n    }\r\n    if (email !== \"\") {\r\n      if (!email.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (phone !== \"\") {\r\n      if (phone.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    } else {\r\n    }\r\n  };\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      images: [],\r\n      name: \"\",\r\n      color: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    validationSchema: addClientYup,\r\n    //    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"Edit A COMPANY\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <Autocomplete\r\n                  id=\"free-solo-demo\"\r\n                  freeSolo\r\n                  disabled={true}\r\n                  defaultValue={name}\r\n                  value={name}\r\n                  style={{\r\n                    ...GLOBALS.Styles.inputWidth,\r\n                    marginRight: \"10px\",\r\n                  }}\r\n                  onSelect={(event) => {\r\n                    let companyId = \"\";\r\n                    let logo = null;\r\n                    companies.forEach((item, index) => {\r\n                      if (item.companyId.name === event.target.value) {\r\n                        companyId = item.companyId._id;\r\n                        logo = item.companyId.logo;\r\n                        setName(item.companyId.name);\r\n                      }\r\n                    });\r\n\r\n                    //                  let fileClone = [{ uri: mean.image }];\r\n                    // setImage(fileClone);\r\n\r\n                    if (companyId.length != 0) {\r\n                      setCompanyId(companyId);\r\n                      setFieldsEnabled(false);\r\n                      formik.setFieldValue(\"images\", [{ uri: logo }]);\r\n                    }\r\n                  }}\r\n                  options={companies.map((option) => {\r\n                    if (option.companyId.name != undefined)\r\n                      return option.companyId.name;\r\n                  })}\r\n                  renderInput={(params) => (\r\n                    <TextField\r\n                      {...params}\r\n                      label=\"Name\"\r\n                      margin=\"normal\"\r\n                      variant=\"outlined\"\r\n                      defaultValue={name}\r\n                      name=\"name\"\r\n                      disabled={true}\r\n                      onChange={(event) => {\r\n                        console.log(event);\r\n                        setName(event.target.value);\r\n                        formik.setFieldValue(\"email\", event.target.value);\r\n                      }}\r\n                      value={formik.values.email}\r\n                      error={formik.errors.email}\r\n                    />\r\n                  )}\r\n                />\r\n                {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"color\"\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Color\"\r\n                  value={color}\r\n                />\r\n                {colorError && (\r\n                  <div className={classes.error}>Please enter color</div>\r\n                )}\r\n              </div>\r\n              <FormMultipleUpload\r\n                name=\"images\"\r\n                enabled={!fieldsEnabled}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={formik.values.images}\r\n                onChange={(values) =>\r\n                  inputChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"images\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n                // onChange={inputChange}\r\n                // onChange={(values) =>\r\n\r\n                //      ( {type: \"text\",\r\n                //       name: \"trades\",\r\n                //       value: values})\r\n\r\n                // }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF COMPANY* :\" />\r\n            <Form.Row width=\"55%\">\r\n              <RadioButton\r\n                name=\"contractType\"\r\n                value={companyType}\r\n                // error={contractType}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  setCompanyType(value)\r\n                }\r\n                items={[\r\n                  {\r\n                    value: \"generalcontractor\",\r\n                    label: \"General Contractor\",\r\n                  },\r\n                  { value: \"subcontractor\", label: \"Subcontractor\" },\r\n                ]}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"GENERAL CONTRACTOR : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"100%\", height: \"100%\" }}>\r\n                <FormSelect\r\n                  placeholder=\"Company\"\r\n                  values={dropdownCompanies}\r\n                  value={selectedCompany}\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  onChange={(event) => {\r\n                    const index = event.target.selectedIndex - 1;\r\n\r\n                    if (index !== -1) {\r\n                      const item = event.target.value;\r\n\r\n                      setSelectedCompanyIndex(index);\r\n\r\n                      setSelectedCompany(item);\r\n                    } else {\r\n                      setSelectedCompanyIndex(null);\r\n\r\n                      setSelectedCompany(\"\");\r\n                    }\r\n                  }}\r\n                  style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n                />\r\n                {/* <select\r\n                  name=\"contract\"\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  id=\"contract\"\r\n                  type={contract}\r\n                  style={{\r\n                    width: \"40%\",\r\n                    height: \"45px\",\r\n                    color: \"#8B8989\",\r\n                    padding: \"0px 10px\",\r\n                  }}\r\n                  onChange={inputChange}\r\n                >\r\n                \r\n                </select> */}\r\n                {contractError === true && (\r\n                  <div className={classes.error}>Please select contract</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TRADES : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <CustomInputModal\r\n                name=\"trades\"\r\n                values={dropdownTrades}\r\n                value={selectedTrade}\r\n                placeholder=\"Select Trades\"\r\n                chipDefaultValues={listOfTrades}\r\n                chipValues={(values) => {\r\n                  const valuesTemp = [];\r\n                  values.forEach((item, index) => {\r\n                    valuesTemp.push(item);\r\n                  });\r\n                  setListOfTrades(valuesTemp);\r\n\r\n                  // setSiteParams(values);\r\n                }}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedTrade(item);\r\n                  } else {\r\n                    setSelectedTrade(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDEMTITY OF RESPONSIBLE* : \" />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"email\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Adresse e-mail\"\r\n                  onChange={inputChange}\r\n                  value={email}\r\n                />\r\n                {emailError === true && (\r\n                  <div className={classes.error}>Please enter valid email</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"phone\"\r\n                  type=\"number\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Téléphone\"\r\n                  onChange={inputChange}\r\n                  value={phone}\r\n                />\r\n                {phoneError === true && (\r\n                  <div className={classes.error}>\r\n                    Telephone should be 10 digits\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"fname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"First Name\"\r\n                  onChange={(e) => setFname(e.target.value)}\r\n                  value={fname}\r\n                />\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"lname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Last Name\"\r\n                  onChange={(e) => setLname(e.target.value)}\r\n                  value={lname}\r\n                />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"Website : \" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                name=\"website\"\r\n                style={{ width: \"50%\" }}\r\n                placeholder=\"http://\"\r\n                onChange={(e) => setWebsite(e.target.value)}\r\n                value={website}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                style={{ width: \"90%\" }}\r\n                onChange={(e) => setAddInfo(e.target.value)}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              onClick={() => {\r\n                onSubmit();\r\n              }}\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              disabled={name === \"\" || color === \"\" || companyType === \"\"}\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Organigramme/Organigramme.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Pic/Pic.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Means/Historic.js",["518"],"import React, { useState, useEffect } from \"react\";\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport { useSelector, useDispatch } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\n\n// import Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Heading from \"../../../components/Heading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport moment from \"moment\";\nimport { Images } from \"../../../assets/Assets\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  link: {\n    marginRight: 20,\n    whiteSpace: \"nowrap\",\n    color: theme.palette.primary.contrastText,\n  },\n  image: {\n    height: 70,\n    borderRadius: theme.shape.borderRadius,\n  },\n}));\n\nconst Historic = (props) => {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n  const [isLoading, setLoading] = useState(true);\n  const [history, setHistory] = useState([]);\n\n  const [means, setMeans] = useState([]);\n  const [dorpdownMeans, setDropdownMeans] = useState([]);\n  const [selectedMean, setSelectedMean] = useState(\"\");\n  const [selectedMeanIndex, setSelectedMeanIndex] = useState(null);\n\n  const [companies, setCompanies] = useState([]);\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\n\n  useEffect(() => {\n    getData();\n    // eslint-disable-next-line\n  }, []);\n\n  useEffect(() => {\n    filterBooking();\n    // eslint-disable-next-line\n  }, [selectedMeanIndex, selectedCompanyIndex]);\n\n  const filterBooking = async () => {\n    try {\n      setLoading(true);\n      const params = { siteId: adminStore.site.siteId._id };\n      if (selectedMean.length !== 0)\n        params[\"meanId\"] = means[selectedMeanIndex]._id;\n      if (selectedCompany.length !== 0)\n        params[\"companyId\"] = companies[selectedCompanyIndex].companyId._id;\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.FILTER_BOOKING}`,\n        token: store.token,\n        method: \"POST\",\n        body: JSON.stringify(params),\n      });\n      if (response.success) {\n        setHistory(response.data);\n\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getData = async () => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_MEAN_HISTORY}/${props.location.mean._id}/${adminStore.site.siteId._id}`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setHistory(response.data.history);\n        setCompanies(response.data.site_companies);\n        if (response.data.site_means != null) {\n          setMeans(response.data.site_means);\n          let selectedMeanIndex = 0;\n\n          const temp = [];\n          const companyTemp = [];\n          response.data.site_means.map((item, index) => {\n            if (item._id === props.location.mean._id) {\n              selectedMeanIndex = index;\n              setSelectedMean(item.name);\n            }\n            return temp.push({ label: item.name, value: item.name });\n          });\n          setDropdownMeans(temp);\n\n          setSelectedMeanIndex(selectedMeanIndex);\n\n          response.data.site_companies.map((item, index) => {\n            return companyTemp.push({\n              label: item.companyId.name,\n              value: item.companyId.name,\n            });\n          });\n          setDropdownCompanies(companyTemp);\n        }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const rows = history.map((item) => {\n    return [\n      moment(item.startDate).format(\"MM/DD/yyy\") + \" \" + item.startTime,\n      moment(item.endDate).format(\"MM/DD/yyy\") + \" \" + item.endTime,\n      item.companyId.name,\n      item.bookingReason,\n    ];\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row alignItems=\"center\">\n        <Heading primary=\"LIST OF MEANS - HISTORIC\" noWrap />\n        <div>\n          <Form.Row\n            alignItems=\"flex-start\"\n            noMargin\n            justifyContent=\"flex-end\"\n            style={{ paddingRight: \"50px\" }}\n          >\n            <Form.Column style={{ width: \"50%\", marginRight: \"50px\" }}>\n              <img src={Images.site} alt=\"\" />\n            </Form.Column>\n          </Form.Row>\n        </div>\n      </Form.Row>\n      <Form.Row alignItems=\"center\" noMargin>\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          {/* <SearchInput\n            placeholder=\"Site name\"\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          /> */}\n          <FormSelect\n            placeholder=\"Company\"\n            values={dropdownCompanies}\n            value={selectedCompany}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n\n              if (index !== -1) {\n                const item = event.target.value;\n\n                setSelectedCompanyIndex(index);\n\n                setSelectedCompany(item);\n              } else {\n                setSelectedCompanyIndex(null);\n\n                setSelectedCompany(\"\");\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Mean\"\n            values={dorpdownMeans}\n            value={selectedMean}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n\n              if (index !== -1) {\n                const item = event.target.value;\n\n                setSelectedMeanIndex(index);\n\n                setSelectedMean(item);\n              } else {\n                setSelectedMeanIndex(null);\n\n                setSelectedMean(\"\");\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\n          See archived sites\n        </NavLink> */}\n      </Form.Row>\n      <div className={classes.content}>\n        <Table headers={GLOBALS.Data.meansOfHistoric.headings} rows={rows} />\n      </div>\n    </div>\n  );\n};\n\nexport default Historic;\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Means/EditMean.js",["519","520","521"],"import React, { useState, useEffect } from \"react\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport * as Yup from \"yup\";\nimport { useSelector, useDispatch } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\nimport GLOBALS from \"../../../globals\";\nimport Form from \"../../../components/Form\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/CustomFormInput\";\nimport FormLabel from \"../../../components/FormLabel\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\nimport CustomInputModal from \"../../../components/CustomInputModal\";\nimport moment from \"moment\";\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n}));\n\nconst accessabilityPoints = [\n  { label: \"Storage Area\", value: \"Storage Area\" },\n  { label: \"Delivery Area\", value: \"Delivery Area\" },\n];\n\nexport default function EditMean(props) {\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n  const [name, setName] = useState(\"\");\n  const [type, setType] = useState(\"\");\n  const [color, setColor] = useState(\"\");\n  const [image, setImage] = useState([]);\n  const [startDate, setStartDate] = useState(\"\");\n  const [endDate, setEndDate] = useState(\"\");\n  const [techSheet, setTechSheet] = useState([]);\n  const [rate, setRate] = useState(\"\");\n  const [addInfo, setAddInfo] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n  const classes = useStyles();\n\n  const [accessabilityPoint, setAccessabilityPoint] = useState(\"\");\n  const [DeliveryAreas, setDeliveryAreas] = useState([]);\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\n  const [\n    selectedSiteDeliveryAreadIndex,\n    seltSelectedSiteDeliveryAreaIndex,\n  ] = useState(null);\n\n  const [storageAreas, setStorageAreas] = useState([]);\n  const [dropdownStorageAreas, setDropdownStorageAreas] = useState([]);\n  const [\n    selectedDropdownStorageArea,\n    setSelectedDropdownStorageArea,\n  ] = useState(\"\");\n  const [selectedStorageAreaIndex, setSelectedStorageAreaIndex] = useState(\n    null,\n  );\n\n  const [deliveryAreaId, setDeilveryAreaId] = useState(\"\");\n  const [storageAreaId, setStorageAreaId] = useState(\"\");\n\n  const [\n    deliveryAndStorageLocations,\n    setDeliveryAndStorageLocations,\n  ] = useState([]);\n\n  const [buildings, setBuidings] = useState([]);\n  const [dropdownBuildings, setDropdownBuildings] = useState([]);\n  const [selectedBuildingIndex, setSelectedBuildingIndex] = useState(null);\n\n  const [levels, setLevels] = useState([]);\n  const [selectedDropdownIndex] = useState(null);\n\n  const [meanTypes, setMeanTypes] = useState([]);\n  const [dropdownMeanTypes, setDropdownMeanTypes] = useState([]);\n  const [selectedMeanType, setSelectedMeanType] = useState(\"\");\n  const [selecetedMeanTypeIndex, setSelectedMeanTypeIndex] = useState(null);\n\n  useEffect(() => {\n    getData();\n\n    // eslint-disable-next-line\n  }, []);\n\n  const setValues = () => {\n    const mean = props.location.mean;\n    setName(mean.name);\n    let fileClone = [{ uri: mean.image }];\n    setImage(fileClone);\n    setSelectedMeanType(mean.meanType);\n    let meanTypeIndex = 0;\n    dropdownMeanTypes.forEach((item, index) => {\n      if (item.value === mean.meanType) meanTypeIndex = index;\n    });\n\n    setSelectedMeanTypeIndex(meanTypeIndex);\n\n    setColor(mean.color);\n\n    setStartDate(moment(mean.availability.start).format(\"MM/DD/yyyy\"));\n    setEndDate(moment(mean.availability.end).format(\"MM/DD/yyyy\"));\n    setRate(mean.pricePerHour);\n    setAddInfo(mean.additionalInfo);\n    const locationTemp = [];\n    mean.location.forEach((item, index) => {\n      let loc = { key: \"\", label: \"\", id: \"\", type: \"\" };\n\n      if (item.locationType === \"STORAGEAREA\") {\n        loc.key = item.storageArea._id;\n        loc.label = item.storageArea.name;\n        loc.id = item.storageArea._id;\n        loc.type = accessabilityPoints[0].value;\n        locationTemp.push(loc);\n      }\n      if (item.locationType === \"DELIVERYAREA\") {\n        loc.key = item.deliveryArea._id;\n        loc.label = item.deliveryArea.name;\n        loc.id = item.deliveryArea._id;\n        loc.type = accessabilityPoints[1].value;\n        locationTemp.push(loc);\n      }\n    });\n    setDeliveryAndStorageLocations(locationTemp);\n    console.log(JSON.stringify(locationTemp, null, 2));\n    // \"key\": \"61615286801076\",\n    // \"label\": \"storqg\",\n    // \"id\": \"60096007880eb61e9d7188d2\",\n    // \"type\": \"Storage Area\"\n  };\n  useEffect(() => {}, [\n    meanTypes,\n    dropdownMeanTypes,\n    selecetedMeanTypeIndex,\n    selectedMeanType,\n  ]);\n\n  const getData = async () => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_ADD_MEAN}/${adminStore.site.siteId._id}`,\n        token: store.token,\n      });\n      if (response.success) {\n        if (response.data.site_delivery_areas !== null) {\n          const temp = [];\n          response.data.site_delivery_areas.map((item, index) =>\n            temp.push({ label: item.name, value: item.name, id: item._id }),\n          );\n          await setDeliveryAreas(response.data.site_delivery_areas);\n          await setDropdownDeliveryAreas(temp);\n        }\n\n        if (response.data.site_storage_areas !== null) {\n          const temp = [];\n          response.data.site_storage_areas.map((item, index) =>\n            temp.push({ label: item.name, value: item.name, id: item._id }),\n          );\n          await setStorageAreas(response.data.site_storage_areas);\n          await setDropdownStorageAreas(temp);\n        }\n\n        if (response.data.site_buildings !== null) {\n          const temp = [];\n          response.data.site_buildings.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n          await setBuidings(response.data.site_buildings);\n          await setDropdownBuildings(temp);\n        }\n\n        if (response.data.mean_types !== null) {\n          const temp = [];\n          response.data.mean_types.map((item, index) =>\n            temp.push({ label: item, value: item }),\n          );\n          await setMeanTypes(response.data.mean_types);\n          await setDropdownMeanTypes(temp);\n        }\n        // if (response.data.mean_types !== null) {\n        //   setTypes(response.data.mean_types);\n        //   const temp = [];\n        //   response.data.mean_types.map((item, index) => {\n        //     temp.push({ label: item, value: item });\n        //   });\n        //   setDropdownTypes(temp);\n        // }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n      await setValues();\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  function handleChange(name, value) {\n    //alert(JSON.stringify(value, null, 2));\n    if (name === \"name\") setName(value);\n    else if (name === \"type\") setType(value);\n    else if (name === \"color\") setColor(value);\n    else if (name === \"image\") setImage(value);\n    else if (name === \"startDate\") setStartDate(value);\n    else if (name === \"endDate\") setEndDate(value);\n    else if (name === \"techSheet\") setTechSheet(value);\n    else if (name === \"rate\") setRate(value);\n    else if (name === \"addInfo\") setAddInfo(value);\n  }\n\n  const updateMean = async () => {\n    try {\n      setLoading(true);\n\n      var formdata = new FormData();\n\n      let locations = [];\n\n      deliveryAndStorageLocations.forEach((item) => {\n        if (item.type === accessabilityPoints[0].value) {\n          let loc = {\n            locationType: \"STORAGEAREA\",\n            storageArea: item.id,\n          };\n          locations.push(loc);\n        }\n        if (item.type === accessabilityPoints[1].value) {\n          let loc = {\n            locationType: \"DELIVERYAREA\",\n            deliveryArea: item.id,\n          };\n          locations.push(loc);\n        }\n      });\n\n      let availabilities = {\n        start: startDate,\n        end: endDate,\n      };\n\n      // TEST DATA , CALENDAR NOT MADE YET\n\n      // const sampleDateOne = new Date(\"05/20/2021\");\n      // const sampleDateTwo = new Date(\"05/28/2021\");\n      // const unavailabilities = [\n      //   {\n      //     date: sampleDateOne,\n      //     reason: \"Public Holiday\",\n      //     startingHour: new Date().getTime(),\n      //     endingHour: new Date().getTime(),\n      //   },\n      //   {\n      //     date: sampleDateTwo,\n      //     reason: \"Maintenance\",\n      //     startingHour: new Date().getTime(),\n      //     endingHour: new Date().getTime(),\n      //   },\n      // ];\n\n      formdata.append(\"name\", name);\n      formdata.append(\"color\", color);\n      if (image.length !== 0 && image[0].file !== undefined)\n        formdata.append(\"image\", image[0].file);\n      if (image.length !== 0 && image[0].file !== undefined)\n        formdata.append(\"sheet\", image[0].file);\n      formdata.append(\"pricePerHour\", rate);\n      formdata.append(\"additionalInfo\", addInfo);\n      formdata.append(\"siteId\", adminStore.site.siteId._id);\n      formdata.append(\"meanType\", selectedMeanType);\n      formdata.append(\"location\", JSON.stringify(locations));\n      formdata.append(\"availability\", JSON.stringify(availabilities));\n      //formdata.append(\"unavailability\", JSON.stringify(unavailabilities));\n\n      const response = await GLOBALS.API({\n        method: \"PUT\",\n        uri: GLOBALS.Constants.UPDATE_MEAN + \"/\" + props.location.mean._id,\n        headers: {\n          Authorization: store.token,\n        },\n        body: formdata,\n      });\n\n      if (response.success) {\n        setLoading(false);\n      } else {\n        setLoading(false);\n        dispatch(\n          Actions.notistack.enqueueSnackbar(\n            Actions.notistack.snackbar(response.message, \"error\"),\n          ),\n        );\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getDeliveryArea = async () => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setLevels(response.data);\n        if (response.data !== null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n\n          setDropdownDeliveryAreas(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getStorageArea = async () => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setLevels(response.data);\n        if (response.data !== null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n\n          setDropdownStorageAreas(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n\n      <Form.Row>\n        <Heading primary=\"EDIT A MEAN\" />\n\n        {/* <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"LOCALISATION\"\n                to={\"/means/add-mean\"}\n                style={{\n                  marginRight: \"100px\",\n                  marginBottom: \"7px\",\n                  width: \"320px\",\n                  textAlign: \"center\",\n                  backgroundColor: \"#140772\"\n                }}\n              /> */}\n      </Form.Row>\n      {loading && \"\"}\n      {levels && \"\"}\n      {selectedDropdownIndex && \"\"}\n      {meanTypes && \"\"}\n      {selectedBuildingIndex && \"\"}\n      {DeliveryAreas && \"\"}\n      {selectedSiteDeliveryAreadIndex && \"\"}\n      {storageAreas && \"\"}\n      {selectedStorageAreaIndex && \"\"}\n      <div className={classes.content}>\n        <Form.Form>\n          <Form.Row>\n            <FormLabel bold primary=\"IDENTITY : \" />\n            <Form.Row noMargin width=\"65%\" style={{ gap: \"20px\" }}>\n              <FormInput\n                name=\"name\"\n                error\n                style={GLOBALS.Styles.inputWidth}\n                placeholder=\"name\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={name}\n                validateSchema={Yup.string().required()}\n              />\n              <FormSelect\n                placeholder=\"Type\"\n                name=\"type\"\n                value={selectedMeanType}\n                style={GLOBALS.Styles.inputWidth}\n                onChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n\n                  if (index !== -1) {\n                    const item = event.target.value;\n                    setSelectedMeanTypeIndex(index);\n                    setSelectedMeanType(item);\n                  } else {\n                    setSelectedMeanTypeIndex(null);\n                    setSelectedMeanType(\"\");\n                  }\n                }}\n                values={dropdownMeanTypes}\n              />\n              <FormSelect\n                placeholder=\"color\"\n                name=\"color\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={color}\n                values={[\n                  { value: \"green\", label: \"Green\" },\n                  { value: \"Yellow\", label: \"Yellow\" },\n                  { value: \"Red\", label: \"Red\" },\n                  { value: \"Blue\", label: \"Blue\" },\n                  { value: \"Orange\", label: \"Orange\" },\n                  { value: \"Purple\", label: \"Purple\" },\n                  { value: \"Magenta\", label: \"Magenta\" },\n                ]}\n              />\n              <FormMultipleUpload\n                name=\"image\"\n                style={GLOBALS.Styles.inputWidth}\n                values={image}\n                onChange={(values) => {\n                  handleChange(\"image\", values);\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"LOCATION :  \" />\n            <Form.Row noMargin width=\"65%\">\n              <CustomInputModal\n                name=\"location\"\n                values={accessabilityPoints}\n                chipDefaultValues={deliveryAndStorageLocations}\n                leftValue={accessabilityPoint}\n                rightValue={\n                  accessabilityPoint === accessabilityPoints[0].value\n                    ? selectedDropdownStorageArea\n                    : selectedDropdownArea\n                }\n                leftId={accessabilityPoint}\n                rightId={\n                  accessabilityPoint === accessabilityPoints[0].value\n                    ? storageAreaId\n                    : deliveryAreaId\n                }\n                chipValues={(values) => {\n                  setDeliveryAndStorageLocations(values);\n                }}\n                leftDropdownValues={accessabilityPoints}\n                leftDropdwonPlaceholder={\"Select Location Type\"}\n                rightDropdownPlaceholder={\"Select Location\"}\n                leftDropdwonValueChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n                  if (index !== -1) {\n                    const item = event.target.value;\n                    setAccessabilityPoint(item);\n                    if (item === accessabilityPoints[0].value) {\n                      getStorageArea();\n                    }\n                    if (item === accessabilityPoints[1].value) {\n                      getDeliveryArea();\n                    } else {\n                      seltSelectedSiteDeliveryAreaIndex(0);\n                      setSelectedDropdownArea(\"\");\n                      setDeilveryAreaId(\"\");\n\n                      setSelectedStorageAreaIndex(0);\n                      setSelectedDropdownStorageArea(\"\");\n                      setStorageAreaId(\"\");\n                    }\n                  } else {\n                    seltSelectedSiteDeliveryAreaIndex(0);\n                    setSelectedDropdownArea(\"\");\n                    setDeilveryAreaId(\"\");\n\n                    setSelectedStorageAreaIndex(0);\n                    setSelectedDropdownStorageArea(\"\");\n                    setStorageAreaId(\"\");\n                  }\n                }}\n                rightDropdownValues={\n                  accessabilityPoint === accessabilityPoints[0].value\n                    ? dropdownStorageAreas\n                    : dropdownDeliveryAreas\n                }\n                // error={addresses}\n                style={GLOBALS.Styles.inputWidth}\n                rightDropdwonValueChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n                  if (index !== -1) {\n                    const item = event.target.value;\n                    if (accessabilityPoints[0].value === accessabilityPoint) {\n                      setStorageAreaId(storageAreas[index]._id);\n                      setSelectedStorageAreaIndex(index);\n                      setSelectedDropdownStorageArea(item);\n                    } else {\n                      setSelectedStorageAreaIndex(0);\n                      setSelectedDropdownStorageArea(\"\");\n                    }\n\n                    if (accessabilityPoints[1].value === accessabilityPoint) {\n                      setDeilveryAreaId(DeliveryAreas[index]._id);\n                      seltSelectedSiteDeliveryAreaIndex(index);\n                      setSelectedDropdownArea(item);\n                    } else {\n                      seltSelectedSiteDeliveryAreaIndex(0);\n                      setSelectedDropdownArea(\"\");\n                    }\n                  } else {\n                    setSelectedStorageAreaIndex(0);\n                    setSelectedDropdownStorageArea(\"\");\n                    seltSelectedSiteDeliveryAreaIndex(0);\n                    setSelectedDropdownArea(\"\");\n                  }\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"DISPONIBILITE :\" />\n            <Form.Row\n              noMargin\n              width=\"65%\"\n              justifyContent=\"flex-start\"\n              style={{ gap: \"20px\" }}\n            >\n              <FormInput\n                type=\"date\"\n                style={{ width: \"300px\" }}\n                placeholder={`Date de début`}\n                name=\"startDate\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={startDate}\n              />\n              <FormInput\n                type=\"date\"\n                placeholder=\"Date de fin\"\n                style={{ width: \"300px\" }}\n                name=\"endDate\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={endDate}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"FICHE TECHNIQUE : \" />\n            <Form.Row noMargin width=\"65%\">\n              <FormMultipleUpload\n                name=\"techSheet\"\n                style={GLOBALS.Styles.inputWidth}\n                values={techSheet}\n                onChange={(values) => {\n                  handleChange(\"techSheet\", values);\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"INDISPONIBILITES: \" />\n            <Form.Row noMargin width=\"65%\">\n              <div\n                // name=\"availability\"\n\n                to={\"/means/add-mean\"}\n                style={{\n                  marginLeft: \"0px\",\n                  marginBottom: \"7px\",\n                  width: \"320px\",\n                  color: \"#fff\",\n                  padding: \"0.8rem 0\",\n                  borderRadius: \"8px\",\n                  textAlign: \"center\",\n                  backgroundColor: \"#140772\",\n                }}\n              >\n                SHOW UNAVAILABILITIES\n              </div>\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"TARIF HORAIRE : \" />\n            <Form.Row noMargin width=\"65%\">\n              <FormInput\n                textArea\n                rows={1}\n                style={{ width: \"300px\", textAlign: \"right\" }}\n                placeholder=\"€\"\n                name=\"rate\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={rate}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"INFORMATIONS COMPLÉMENTAIRES :\" />\n            <Form.Row noMargin width=\"65%\">\n              <FormInput\n                textArea\n                rows={3}\n                style={{ width: \"600px\" }}\n                placeholder=\"Informations complémentaires\"\n                name=\"addInfo\"\n                onChange={({ target: { name, value } }) => {\n                  handleChange(name, value);\n                }}\n                value={addInfo}\n              />\n            </Form.Row>\n          </Form.Row>\n          {type && \"\"}\n          <Form.Row>\n            <Form.ButtonContainer style={{ width: \"80%\" }}>\n              <Button\n                minWidth={200}\n                text=\"VALIDATE\"\n                fullWidth={false}\n                onClick={async () => {\n                  await updateMean();\n                }}\n                // loading={formik.isSubmitting}\n                // disabled={\n                //   !name ||\n                //   location.length === 0 ||\n                //   !type ||\n                //   !color ||\n                //   !startDate\n                // }\n              />\n            </Form.ButtonContainer>\n          </Form.Row>\n        </Form.Form>\n      </div>\n    </div>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Means/Means.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Means/AddMean.js",["522","523","524","525","526","527","528","529","530"],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Companies/Companies.js",["531","532","533","534","535"],"import React, { useState, useEffect } from \"react\";\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n// import * as Yup from \"yup\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\nimport GLOBALS from \"../../../globals\";\nimport Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Modal from \"../../../components/Modal\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport AvatarUpload from \"../../../components/AvatarUpload\";\nimport uploadIcon from \"../../../assets/images/upload.png\";\nimport { Images } from \"../../../assets/Assets\";\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n}));\n\n// const updateAdminYup = Yup.object().shape({\n//   email: Yup.string().required(\"Required\"),\n//   phone: Yup.number()\n//     .test(\n//       \"len\",\n//       \"Must be exactly 10 characters\",\n//       (val) => val && val.toString().length === 10,\n//     )\n//     .required(\"Required\"),\n//   image: Yup.object().optional(\"\"),\n//   companyId: Yup.string().required(\"Required\"),\n// });\n\nexport default function Companies(props) {\n  const theme = useTheme();\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n\n  const [page] = useState(1);\n  const [items, setItems] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [companies, setCompanies] = useState([]);\n  const [modal, setModal] = useState(false);\n  const [selectedItem] = useState(\"\");\n  const [firstName, setFirstName] = useState(\"\");\n  const [lastName, setLastName] = useState(\"\");\n  const [phone, setPhone] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [companyId, setCompanyId] = useState(\"\");\n  const [nameOfResponsible, setNameOfResponsible] = useState(\"\");\n  const [nameOfCompany, setNameOfCompany] = useState(\"\");\n\n  useEffect(() => {\n    getData();\n\n    // eslint-disable-next-line\n  }, []);\n\n  const getData = async () => {\n    try {\n      console.log(adminStore.site.siteId._id);\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_SITE_COMPANIES}/${adminStore.site.siteId._id}`,\n        token: store.token,\n      });\n      if (response.success) {\n        setCompanies(response.data.companies);\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n  const handleChange = (name, value) => {\n    if (name === \"firstName\") setFirstName(value);\n    else if (name === \"lastName\") setLastName(value);\n    else if (name === \"phone\") setPhone(value);\n    else if (name === \"image\") setImage(value);\n    else if (name === \"companyId\") setCompanyId(value);\n  };\n\n  const onUpdate = async (e) => {\n    try {\n      e.preventDefault();\n      setLoading(true);\n      var formdata = new FormData();\n      formdata.append(\"firstName\", firstName);\n      formdata.append(\"lastName\", lastName);\n      formdata.append(\"phone\", phone);\n      formdata.append(\"companyId\", companyId);\n      formdata.append(\"userId\", selectedItem._id);\n      image.file && formdata.append(\"image\", image.file);\n\n      const result = await GLOBALS.API({\n        method: \"PUT\",\n        uri: GLOBALS.Constants.ADMINS,\n        headers: {\n          Authorization: store.token,\n        },\n        body: formdata,\n      });\n      const itemsArray = items.map((item) =>\n        item._id === selectedItem._id ? result.data : item,\n      );\n      setItems(itemsArray);\n      setLoading(false);\n      setModal(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getSubContractors = (subcontractors) => {\n    if (subcontractors && subcontractors.length > 0) {\n      const value = subcontractors\n        .map((item, index) => {\n          if (item.name != undefined) return item.name;\n          return \"N/A\";\n        })\n        .toString()\n        .replace(/,/g, \" \");\n      return value;\n    }\n    return \"N/A\";\n  };\n\n  const filterCompany = async () => {\n    try {\n      setLoading(true);\n      const params = { siteId: \"6008169bedbb7816d40b197d\" };\n      if (nameOfCompany.length !== 0) params[\"companyName\"] = nameOfCompany;\n      if (nameOfResponsible.length !== 0)\n        params[\"responsibleName\"] = nameOfResponsible;\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.FILTER_COMPANY_SITES}`,\n        token: store.token,\n        method: \"POST\",\n        body: JSON.stringify(params),\n      });\n      if (response.success) {\n        setCompanies(response.data.companies);\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const rows = companies.map((item) => {\n    return [\n      <img src={Images.site} alt=\"Icon\" />,\n      item.companyId.name,\n      getSubContractors(item.subContractors),\n      item.companyId.incharge != undefined\n        ? item.companyId.incharge.firstName +\n          \" \" +\n          item.companyId.incharge.lastName\n        : \"N/A\",\n      item.companyId.incharge != undefined\n        ? item.companyId.incharge.phone\n        : \"N/A\",\n      item.companyId.incharge != undefined\n        ? item.companyId.incharge.email\n        : \"N/A\",\n\n      <div>\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\n          <NavLink\n            to={{\n              pathname: \"/companies/user-list\",\n              id: item.companyId._id,\n            }}\n          >\n            <img\n              src={Images.comapnies}\n              style={{ width: 18, height: 17 }}\n              alt=\"Icon\"\n            />\n          </NavLink>\n        </IconButton>\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\n          <NavLink\n            to={{\n              pathname: \"/companies/edit-companies\",\n              id: item.companyId._id,\n            }}\n          >\n            <Pencil style={{ width: 18, height: 15 }} />\n          </NavLink>\n        </IconButton>\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\n          <img\n            src={Images.calender}\n            style={{ width: 18, height: 17 }}\n            alt=\"Icon\"\n          />\n        </IconButton>\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\n          <img\n            src={Images.invoices}\n            style={{ width: 18, height: 17 }}\n            alt=\"Icon\"\n          />\n        </IconButton>\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\n          <img\n            src={Images.incidents}\n            style={{ width: 18, height: 17 }}\n            alt=\"Icon\"\n          />\n        </IconButton>\n      </div>,\n    ];\n  });\n\n  return (\n    <>\n      <div className={classes.root}>\n        <Form.Row alignItems=\"center\" className=\"pr-3\">\n          <Heading primary=\"LIST OF COMPANIES\" noWrap />\n          <div>\n            <Form.Row alignItems=\"center\" noMargin>\n              <SubHeading\n                disableMargin\n                primary={`Total : ${companies.length} COMPANIES`}\n                bold\n              />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"ADD A COMPANY\"\n                style={{ marginLeft: \"20px\" }}\n                to={\"/companies/add-companies\"}\n              />\n            </Form.Row>\n          </div>\n        </Form.Row>\n        <Form.Row noMargin className=\"pr-3\">\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\n            <SearchInput\n              placeholder=\"Name of responsible\"\n              value={nameOfResponsible}\n              onClick={() => {\n                filterCompany();\n              }}\n              onChange={(event) => {\n                setNameOfResponsible(event.target.value);\n              }}\n            />\n            <SearchInput\n              style={{ marginLeft: \"20px\" }}\n              placeholder=\"Name of company\"\n              value={nameOfCompany}\n              onClick={() => {\n                filterCompany();\n              }}\n              onChange={(event) => {\n                setNameOfCompany(event.target.value);\n              }}\n            />\n            <a href=\"#companies\">\n              <img\n                style={{\n                  width: \"1.3rem\",\n                  marginLeft: \"20px\",\n                  marginTop: \"10px\",\n                }}\n                src={uploadIcon}\n                alt=\"File Upload Icon\"\n              />\n            </a>\n          </Form.Row>\n          <Button\n            fullWidth={true}\n            component={NavLink}\n            text=\"ACCESS REQUEST TO ZONES\"\n            style={{ width: \"330px\" }}\n            to={\"/admins/add-admin\"}\n          />\n        </Form.Row>\n        <div className={classes.content}>\n          <Table headers={GLOBALS.Data.companies.headings} rows={rows} />\n        </div>\n      </div>\n      <Modal\n        title=\"EDIT ADMIN\"\n        open={selectedItem ? modal : false}\n        onClose={() => setModal((st) => !st)}\n        body={\n          <Form.Form onSubmit={onUpdate}>\n            <Form.Row justifyContent=\"center\">\n              <AvatarUpload\n                value={image}\n                // error={image}\n                onChange={(file) => {\n                  const uri = URL.createObjectURL(file);\n                  handleChange(\"image\", { file, uri });\n                }}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"firstName\"\n                value={firstName}\n                // error={firstName}\n                placeholder=\"First Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"lastName\"\n                value={lastName}\n                // error={lastName}\n                placeholder=\"Last Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"phone\"\n                placeholder=\"Phone Number\"\n                value={phone}\n                // error={phone}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                style={GLOBALS.Styles.inputWidth}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormSelect\n                name=\"companyId\"\n                value={companyId}\n                // error={companyId}\n                values={companies}\n                placeholder=\"Company Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Column alignItems=\"center\">\n              <Form.Row justifyContent=\"center\">\n                <Button\n                  type=\"submit\"\n                  minWidth={200}\n                  text=\"VALIDATE\"\n                  fullWidth={false}\n                  loading={loading}\n                  disabled={\n                    loading ||\n                    !firstName ||\n                    !lastName ||\n                    !phone ||\n                    image === \"\" ||\n                    !companyId\n                  }\n                />\n              </Form.Row>\n              <Form.Row justifyContent=\"center\">\n                <Button\n                  text=\"DELETE\"\n                  minWidth=\"30%\"\n                  fullWidth={false}\n                  disabled={loading || true}\n                  color={theme.palette.error.main}\n                />\n              </Form.Row>\n            </Form.Column>\n          </Form.Form>\n        }\n      />\n    </>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Calender/components/MyWorkWeek.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Calender/components/popoverModal.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Calender/components/events.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/ArchivedSites.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddZAC.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Organigramme/AddContact.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Companies/AddCompanies.js",["536","537","538","539","540","541","542","543","544","545","546","547","548","549","550","551","552"],"import React, { useState, useEffect } from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\r\nimport TextField from \"@material-ui/core/TextField\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n  error: {\r\n    color: \"red\",\r\n  },\r\n  radioLabel: {\r\n    marginLeft: \"7px\",\r\n    color: \"#7E7878\",\r\n    marginRight: \"50px\",\r\n  },\r\n  radioBtn: {},\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  images: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function AddCompanies(props) {\r\n  const dispatch = useDispatch();\r\n\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [name, setName] = useState(\"\");\r\n  const [nameError, setNameError] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [colorError, setColorError] = useState(\"\");\r\n  const [images, setImages] = useState([]);\r\n  const [companyType, setCompanyType] = useState(\"subcontractor\");\r\n  const [companyTypeError, setCompanyTypeError] = useState(\"\");\r\n  const [contract, setContract] = useState(\"\");\r\n  const [contractError, setContractError] = useState(\"\");\r\n  const [update, setUpdate] = useState(false);\r\n  const [email, setEmail] = useState(\"\");\r\n  const [emailError, setEmailError] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [phoneError, setPhoneError] = useState(\"\");\r\n  const [fname, setFname] = useState(\"\");\r\n  const [lname, setLname] = useState(\"\");\r\n  const [website, setWebsite] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  const [trades, setTrades] = useState([]);\r\n  const [dropdownTrades, setDropdownTrades] = useState([]);\r\n  const [selectedTrade, setSelectedTrade] = useState(\"\");\r\n  const [listOfTrades, setListOfTrades] = useState([]);\r\n  const [fieldsEnabled, setFieldsEnabled] = useState(true);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    getCompanyAutoFill();\r\n  }, [companyId]);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_COMPANY}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        console.log(\"Response\", JSON.stringify(response, null, 2));\r\n        setCompanies(response.data.site_companies);\r\n        setTrades(response.data.site_trades);\r\n        if (response.data.site_companies != null) {\r\n          const companyTemp = [];\r\n\r\n          response.data.site_companies.map((item, index) => {\r\n            return companyTemp.push({\r\n              label: item.companyId.name,\r\n              value: item.companyId.name,\r\n            });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n\r\n        if (response.data.site_trades != null) {\r\n          const tradesTemp = [];\r\n\r\n          response.data.site_trades.map((item, index) => {\r\n            return tradesTemp.push({\r\n              label: item,\r\n              value: item,\r\n            });\r\n          });\r\n          setDropdownTrades(tradesTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getCompanyAutoFill = async () => {\r\n    if (companyId.length === 0) return;\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_COMPANY_AUTOFILL}/${adminStore.site.siteId._id}/${companyId}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.site_companies.length != 0) {\r\n          const company = response.data.site_companies[0].companyId;\r\n          const trades = response.data.site_companies[0].trades;\r\n          if (company.incharge != undefined) {\r\n            const incharge = company.incharge;\r\n            setFname(incharge.firstName);\r\n            setLname(incharge.lastName);\r\n            setEmail(incharge.email);\r\n            setPhone(incharge.phone);\r\n          } else {\r\n            setFname(\"\");\r\n            setLname(\"\");\r\n            setEmail(\"\");\r\n            setPhone(\"\");\r\n          }\r\n          if (company.color != undefined) setColor(company.color);\r\n          if (company.website != undefined) setWebsite(company.website);\r\n          else setWebsite(\"\");\r\n          if (company.description != undefined) setAddInfo(company.description);\r\n          else setAddInfo(\"\");\r\n          if (trades != undefined) {\r\n            const tradesTemp = [];\r\n            trades.forEach((item, index) => {\r\n              tradesTemp.push({ key: item, label: item });\r\n            });\r\n            setListOfTrades(tradesTemp);\r\n          }\r\n        }\r\n        await getGeneralContractor();\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getGeneralContractor = async () => {\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_GENERAL_CONTRACTOR}/${adminStore.site.siteId._id}/${companyId}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.companies.length === 0) {\r\n          await setCompanyType(\"generalcontractor\");\r\n\r\n          setSelectedCompany(\"\");\r\n          setSelectedCompanyIndex(null);\r\n        } else {\r\n          await setCompanyType(\"subcontractor\");\r\n\r\n          const company = response.data.companies[0].companyId;\r\n          let companyIndex = null;\r\n          let companyValue = null;\r\n          companies.forEach((item, index) => {\r\n            if (item.companyId._id === company._id) {\r\n              companyIndex = index;\r\n              companyValue = item.companyId.name;\r\n            }\r\n          });\r\n          if (companyIndex != null && companyValue != null) {\r\n            setSelectedCompany(companyValue);\r\n            setSelectedCompanyIndex(companyIndex);\r\n          } else {\r\n            setSelectedCompany(\"\");\r\n            setSelectedCompanyIndex(null);\r\n          }\r\n        }\r\n        console.log(JSON.stringify(response, null, 2));\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  // const [startDate, setStartDate] = useState(\"\");\r\n  // const [startDateError, setStartDateError] = useState(\"\");\r\n  // const [isDateSelect, setIsDateSelect] = useState(\"\");\r\n  // const [endDate, setEndDate] = useState(\"\");\r\n  // const [endDateError, setEndDateError] = useState(\"\");\r\n  // const [available, setAvailable] = useState(\"VOIR LES INDISPONIBILITÉS\");\r\n  // const [techSheet, setTechSheet] = useState([]);\r\n  // const [rate, setRate] = useState(\"\");\r\n  // const [rateError, setRateError] = useState(\"\");\r\n\r\n  const onSubmit = async () => {\r\n    // const notificationTo = values.notificationTo.map((item) => item.label);\r\n    const values = formik.values;\r\n    const isSubContractor = companyType === \"subcontractor\";\r\n    let parentCompanyId = undefined;\r\n    if (\r\n      companies.length != 0 &&\r\n      isSubContractor &&\r\n      companies[selectedCompanyIndex].companyId != undefined\r\n    )\r\n      parentCompanyId = companies[selectedCompanyIndex].companyId._id;\r\n\r\n    const trades = [];\r\n\r\n    listOfTrades.forEach((item, index) => {\r\n      trades.push(item.label);\r\n    });\r\n\r\n    var formdata = new FormData();\r\n    formdata.append(\"logo\", values.images[0].file);\r\n\r\n    formdata.append(\"name\", name);\r\n    formdata.append(\"color\", color);\r\n    formdata.append(\"website\", website);\r\n    formdata.append(\"description\", addInfo);\r\n    formdata.append(\"trades\", JSON.stringify(trades));\r\n    formdata.append(\"siteId\", adminStore.site.siteId._id);\r\n\r\n    if (isSubContractor) {\r\n      if (parentCompanyId === undefined)\r\n        alert(\"You need to select a general contractor\");\r\n      formdata.append(\"parentCompanyId\", parentCompanyId);\r\n    }\r\n    if (\r\n      fname.length !== 0 &&\r\n      lname.length !== 0 &&\r\n      email.length !== 0 &&\r\n      phone.length !== 0\r\n    ) {\r\n      const incharge = {\r\n        firstName: fname,\r\n        lastName: lname,\r\n        email: email,\r\n        phone: phone,\r\n      };\r\n      formdata.append(\"incharge\", JSON.stringify(incharge));\r\n    }\r\n\r\n    const response = await GLOBALS.API({\r\n      method: \"POST\",\r\n\r\n      uri: GLOBALS.Constants.CREATE_COMPANY,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    if (response.success) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(response.message, \"success\"),\r\n        ),\r\n      );\r\n    }\r\n\r\n    formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n\r\n  const inputChange = (e) => {\r\n    if (e.target.name === \"name\") {\r\n      setName(e.target.value);\r\n      if (e.target.name === \"\" || name === null) {\r\n        setNameError(true);\r\n      } else {\r\n        setNameError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"color\") {\r\n      setColor(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setColorError(true);\r\n      } else {\r\n        setColorError(false);\r\n      }\r\n    }\r\n\r\n    if (e.target.name === \"contract\") {\r\n      setContract(e.target.value);\r\n      if (\r\n        e.target.value === \"\" ||\r\n        e.target.value === null ||\r\n        e.target.value === undefined\r\n      ) {\r\n        setContractError(true);\r\n      } else {\r\n        setContractError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"email\") {\r\n      setEmail(e.target.value);\r\n      var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n      if (!e.target.value.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"phone\") {\r\n      setPhone(e.target.value);\r\n      if (e.target.value.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    }\r\n\r\n    if (e.target.name === \"images\") {\r\n      setImages(e.target.value);\r\n    }\r\n    if (e.target.name === \"trades\") {\r\n      setTrades(e.target.value);\r\n    }\r\n\r\n    if (e.target.name === \"addInfo\") {\r\n      setAddInfo(e.target.value);\r\n    }\r\n  };\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"trades\") {\r\n      if (value !== \"\") {\r\n        setUpdate((st) => !st);\r\n        setTrades(value);\r\n      }\r\n    }\r\n  };\r\n\r\n  const submitHandler = (e) => {\r\n    var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n    e.preventDefault();\r\n    if (name === \"\" || name === null) {\r\n      setNameError(true);\r\n    }\r\n    if (color === \"\" || color === null) {\r\n      setColorError(true);\r\n    }\r\n    if (\r\n      companyType === \"\" ||\r\n      companyType === null ||\r\n      companyType === undefined\r\n    ) {\r\n      setCompanyTypeError(true);\r\n    }\r\n    if (contract === \"\" || contract === null || contract === undefined) {\r\n      setContractError(true);\r\n    }\r\n    if (email !== \"\") {\r\n      if (!email.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (phone !== \"\") {\r\n      if (phone.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    } else {\r\n    }\r\n  };\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      images: [],\r\n      name: \"\",\r\n      color: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    validationSchema: addClientYup,\r\n    //    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"ADD A COMPANY\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <Autocomplete\r\n                  id=\"free-solo-demo\"\r\n                  freeSolo\r\n                  disabled={!fieldsEnabled}\r\n                  style={{\r\n                    ...GLOBALS.Styles.inputWidth,\r\n                    marginRight: \"10px\",\r\n                  }}\r\n                  onSelect={(event) => {\r\n                    let companyId = \"\";\r\n                    let logo = null;\r\n                    companies.forEach((item, index) => {\r\n                      if (item.companyId.name === event.target.value) {\r\n                        companyId = item.companyId._id;\r\n                        logo = item.companyId.logo;\r\n                        setName(item.companyId.name);\r\n                      }\r\n                    });\r\n\r\n                    //                  let fileClone = [{ uri: mean.image }];\r\n                    // setImage(fileClone);\r\n\r\n                    if (companyId.length != 0) {\r\n                      setCompanyId(companyId);\r\n                      setFieldsEnabled(false);\r\n                      formik.setFieldValue(\"images\", [{ uri: logo }]);\r\n                    }\r\n                  }}\r\n                  options={companies.map((option) => {\r\n                    if (option.companyId.name != undefined)\r\n                      return option.companyId.name;\r\n                  })}\r\n                  renderInput={(params) => (\r\n                    <TextField\r\n                      {...params}\r\n                      label=\"Name\"\r\n                      margin=\"normal\"\r\n                      variant=\"outlined\"\r\n                      name=\"name\"\r\n                      disabled={!fieldsEnabled}\r\n                      onChange={(event) => {\r\n                        console.log(event);\r\n                        setName(event.target.value);\r\n                        formik.setFieldValue(\"email\", event.target.value);\r\n                      }}\r\n                      value={formik.values.email}\r\n                      error={formik.errors.email}\r\n                    />\r\n                  )}\r\n                />\r\n                {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"color\"\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Color\"\r\n                  value={color}\r\n                />\r\n                {colorError && (\r\n                  <div className={classes.error}>Please enter color</div>\r\n                )}\r\n              </div>\r\n              <FormMultipleUpload\r\n                name=\"images\"\r\n                enabled={!fieldsEnabled}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={formik.values.images}\r\n                onChange={(values) =>\r\n                  inputChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"images\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n                // onChange={inputChange}\r\n                // onChange={(values) =>\r\n\r\n                //      ( {type: \"text\",\r\n                //       name: \"trades\",\r\n                //       value: values})\r\n\r\n                // }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF COMPANY* :\" />\r\n            <Form.Row width=\"55%\">\r\n              <RadioButton\r\n                name=\"contractType\"\r\n                value={companyType}\r\n                // error={contractType}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  setCompanyType(value)\r\n                }\r\n                items={[\r\n                  {\r\n                    value: \"generalcontractor\",\r\n                    label: \"General Contractor\",\r\n                  },\r\n                  { value: \"subcontractor\", label: \"Subcontractor\" },\r\n                ]}\r\n              />\r\n\r\n              {/* <input\r\n                    className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    onChange={(e) => {\r\n                      setCompanyType(\"generalcontractor\");\r\n                    }}\r\n                    id=\"generalcontractor\"\r\n                    name=\"companyType\"\r\n                    value={companyType}\r\n                  />\r\n                  <label for=\"generalcontractor\" className={classes.radioLabel}>\r\n                    General Contractor\r\n                  </label>\r\n                  <input\r\n                    className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"subcontractor\"\r\n                    name=\"companyType\"\r\n                    onChange={(e) => {\r\n                      setCompanyType(\"subcontractor\");\r\n                    }}\r\n                    value={companyType}\r\n                    defaultChecked\r\n                  />\r\n                  <label for=\"subcontractor\" className={classes.radioLabel}>\r\n                    Sub contractor\r\n                  </label> */}\r\n              {companyTypeError === true && (\r\n                <div className={classes.error}>Please select company</div>\r\n              )}\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"GENERAL CONTRACTOR : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"100%\", height: \"100%\" }}>\r\n                <FormSelect\r\n                  placeholder=\"Company\"\r\n                  values={dropdownCompanies}\r\n                  value={selectedCompany}\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  onChange={(event) => {\r\n                    const index = event.target.selectedIndex - 1;\r\n\r\n                    if (index !== -1) {\r\n                      const item = event.target.value;\r\n\r\n                      setSelectedCompanyIndex(index);\r\n\r\n                      setSelectedCompany(item);\r\n                    } else {\r\n                      setSelectedCompanyIndex(null);\r\n\r\n                      setSelectedCompany(\"\");\r\n                    }\r\n                  }}\r\n                  style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n                />\r\n                {/* <select\r\n                  name=\"contract\"\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  id=\"contract\"\r\n                  type={contract}\r\n                  style={{\r\n                    width: \"40%\",\r\n                    height: \"45px\",\r\n                    color: \"#8B8989\",\r\n                    padding: \"0px 10px\",\r\n                  }}\r\n                  onChange={inputChange}\r\n                >\r\n                \r\n                </select> */}\r\n                {contractError === true && (\r\n                  <div className={classes.error}>Please select contract</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TRADES : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <CustomInputModal\r\n                name=\"trades\"\r\n                values={dropdownTrades}\r\n                value={selectedTrade}\r\n                placeholder=\"Select Trades\"\r\n                chipDefaultValues={listOfTrades}\r\n                chipValues={(values) => {\r\n                  const valuesTemp = [];\r\n                  values.forEach((item, index) => {\r\n                    valuesTemp.push(item);\r\n                  });\r\n                  setListOfTrades(valuesTemp);\r\n\r\n                  // setSiteParams(values);\r\n                }}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedTrade(item);\r\n                  } else {\r\n                    setSelectedTrade(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDEMTITY OF RESPONSIBLE* : \" />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"email\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Adresse e-mail\"\r\n                  onChange={inputChange}\r\n                  value={email}\r\n                />\r\n                {emailError === true && (\r\n                  <div className={classes.error}>Please enter valid email</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"phone\"\r\n                  type=\"number\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Téléphone\"\r\n                  onChange={inputChange}\r\n                  value={phone}\r\n                />\r\n                {phoneError === true && (\r\n                  <div className={classes.error}>\r\n                    Telephone should be 10 digits\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"fname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"First Name\"\r\n                  onChange={(e) => setFname(e.target.value)}\r\n                  value={fname}\r\n                />\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"lname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Last Name\"\r\n                  onChange={(e) => setLname(e.target.value)}\r\n                  value={lname}\r\n                />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"Website : \" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                name=\"website\"\r\n                style={{ width: \"50%\" }}\r\n                placeholder=\"http://\"\r\n                onChange={(e) => setWebsite(e.target.value)}\r\n                value={website}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                style={{ width: \"90%\" }}\r\n                onChange={(e) => setAddInfo(e.target.value)}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              onClick={() => {\r\n                onSubmit();\r\n              }}\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              disabled={name === \"\" || color === \"\" || companyType === \"\"}\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Organigramme/EditContact.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Incidents/editIncidents.js",["553","554","555","556","557","558","559","560","561","562"],"import React, { useState, useEffect } from \"react\";\n\nimport { useFormik } from \"formik\";\nimport { useSelector } from \"react-redux\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport * as Yup from \"yup\";\n\nimport GLOBALS from \"../../../globals\";\nimport Form from \"../../../components/Form\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport SmallText from \"../../../components/SmallText\";\nimport FormLabel from \"../../../components/FormLabel\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\n\nconst useStyles = makeStyles(() => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n  error: {\n    color: \"red\",\n  },\n}));\n\n\n\nexport default function AddIncidents(props) {\n  const classes = useStyles();\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n\n  const [name, setName] = useState(\"\");\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\n  const [dropdownLocationType, setDropdownLocationType] = useState([]);\n  const [dropdownLocation, setDropdownLocation] = useState([]);\n  const [selectedLocation, setSelectedLocation] = useState([]);\n\n  const [location, setLocations] = useState([]);\n  const [selectedLocationType, setselectedLocationType] = useState(\"\");\n\n  const [companyId, setCompanyId] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n\n  const [date, setDate] = useState(\"\");\n  const [time, setTime] = useState(\"\");\n\n  const [isBillable, setBillable] = useState(false);\n  const [price, setPrice] = useState(\"\");\n  const [comment, setComment] = useState(\"\");\n  const [selctedLocationObject, setselctedLocationObject] = useState(\"\");\n\n  const [nameError, setNameError] = useState(\"\"); //working\n\n  const [comapnyError, setComapnyError] = useState(\"\");\n  const [dateError, setDateError] = useState(\"\");\n  const [timeError, setTimeError] = useState(\"\");\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n  useEffect(() => {\n    fetchLocationDataOnTypeChange();\n    // eslint-disable-next-line\n  }, [selectedLocationType]);\n\n  const fetchData = async () => {\n    const response = await GLOBALS.API({\n      uri: `${GLOBALS.Constants.GET_SITE_INCIDENT}/${adminStore.site.siteId._id}`,\n      token: store.token,\n    });\n\n    console.log(response);\n\n    if (response.success) {\n      if (response.data.site_companies) {\n        const temp = [];\n        response.data.site_companies.map((item, index) => {\n          return temp.push({\n            label: item.companyId.name,\n            value: item.companyId._id,\n          });\n        });\n        setDropdownCompanies(temp);\n\n        console.log(dropdownCompanies);\n      }\n\n      if (response.data.locationTypes) {\n        setLocations(response.data.locationTypes);\n        const temp = [];\n        response.data.locationTypes.map((item, index) => {\n          return temp.push({ label: item, value: item });\n        });\n        setDropdownLocationType(temp);\n      }\n    }\n    await setValues();\n  };\n\n  const setValues = () => {\n    const incident = props?.location?.data;\n    setName(incident.name);\n    setCompanyId(incident?.companyId?._id);\n    setDate(incident?.date);\n    setBillable(incident?.isBillable);\n    setPrice(incident?.price);\n    console.log(props.location?.data);\n\n    // setType(contactInfo.type);\n    // setEmail(contactInfo.email);\n    // setPhone(contactInfo.phone);\n    // setFirstName(contactInfo.firstName);\n    // setLastName(contactInfo.lastName);\n    // setImage([{ key: 0, file: undefined, uri: contactInfo.image }]);\n\n    // // setImage(fileClone);\n\n    // setCompany(contactInfo.company);\n    // setRole(contactInfo.role);\n  };\n\n  const onFormSubmit = async () => {\n    // const notificationTo = values.notificationTo.map((item) => item.label);\n\n    var formdata = new FormData();\n    // formdata.append(\"photos\", values.logo[0].file);\n    formdata.append(\"name\", name);\n    formdata.append(\"date\", date);\n\n    formdata.append(\"time\", time);\n    formdata.append(\"description\", description);\n    formdata.append(\"isBillable\", isBillable);\n    formdata.append(\"price\", price);\n    formdata.append(\"comment\", comment);\n    formdata.append(\n      \"location\",\n      JSON.stringify({ deliveryArea: \"600952a9df49e51b42fab57b\" }),\n    );\n    // formdata.append(\"type\", );\n    formdata.append(\"companyId\", companyId);\n    formdata.append(\"siteId\", adminStore.site.siteId._id);\n    console.log(store.token);\n    await GLOBALS.API({\n      method: \"POST\",\n      uri: GLOBALS.Constants.POST_ADD_SITE_INCIDENTS,\n      headers: {\n        Authorization: store.token,\n      },\n      body: formdata,\n    });\n\n    props.history.push(\"/incidents\");\n  };\n  const nameChange = (e) => {\n    console.log(e.target.value, e.target.label);\n    if (e.target.name === \"name\") {\n      setName(e.target.value);\n      if (e.target.name === \"\" || name === null) {\n        setNameError(true);\n      } else {\n        setNameError(false);\n      }\n    }\n    if (e.target.name === \"comapnyId\") {\n      setCompanyId(e.target.value);\n      if (e.target.value === \"\" || e.target.value === null) {\n        setComapnyError(true);\n      } else {\n        setComapnyError(false);\n      }\n    }\n    if (e.target.name === \"date\") {\n      setDate(e.target.value);\n      // console.log(date)\n      if (e.target.value === \"\" || e.target.value === null) {\n        setDateError(true);\n      } else {\n        setDateError(false);\n      }\n    }\n    if (e.target.name === \"time\") {\n      setTime(e.target.value);\n      if (e.target.value === \"\" || e.target.value === null) {\n        setTimeError(true);\n      } else {\n        setTimeError(false);\n      }\n    }\n    if (e.target.name === \"location\") {\n      // setTime(e.target.value);\n      const selectedObject = dropdownLocation.filter(\n        (x) => x.value === e.target.value,\n      );\n      console.log(selectedObject[0]);\n      setSelectedLocation(selectedObject[0]);\n      const locationObject = {};\n      locationObject[0] = selectedLocationType;\n\n      locationObject[1] = e.target.value;\n      setselctedLocationObject(locationObject);\n\n      if (e.target.value === \"\" || e.target.value === null) {\n        setTimeError(true);\n      } else {\n        setTimeError(false);\n      }\n    }\n    if (e.target.name === \"description\") {\n      setDescription(e.target.value);\n      // if (e.target.value === \"\" || e.target.value === null) {\n      //   setTimeError(true);\n      // } else {\n      //   setTimeError(false);\n      // }\n    }\n    if (e.target.name === \"setBillable\") {\n      setBillable(e.target.value);\n      // if (e.target.value === \"\" || e.target.value === null) {\n      //   setTimeError(true);\n      // } else {\n      //   setTimeError(false);\n      // }\n    }\n    if (e.target.name === \"price\") {\n      setPrice(e.target.value);\n      // if (e.target.value === \"\" || e.target.value === null) {\n      //   setTimeError(true);\n      // } else {\n      //   setTimeError(false);\n      // }\n    }\n    if (e.target.name === \"comment\") {\n      //working\n      setComment(e.target.value);\n      // if (e.target.value === \"\" || e.target.value === null) {\n      //   setTimeError(true);\n      // } else {\n      //   setTimeError(false);\n      // }\n    }\n  };\n\n  const fetchLocationDataOnTypeChange = async () => {\n    if (selectedLocationType === \"STORAGEAREA\") {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\n        token: store.token,\n      });\n      if (response.success) {\n      }\n      console.log(response);\n    }\n    if (selectedLocationType === \"DELIVERYAREA\") {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\n        token: store.token,\n      });\n      if (response.success) {\n        if (response.data) {\n          const temp = [];\n          response.data.map((item, index) => {\n            return temp.push({ label: item.name, value: item._id });\n          });\n          setDropdownLocation(temp);\n        }\n      }\n      console.log(response);\n    }\n  };\n  const locationTypeChange = (e) => {\n    setselectedLocationType(e.target.value);\n  };\n  const submitHandler = (e) => {\n    e.preventDefault();\n    if (name === \"\" || name === null) {\n      setNameError(true);\n    }\n    // if (types === \"\" || types === null) {\n    //   setTypeError(true);\n    // }\n    // if (color === \"\" || color === null) {\n    //   setColorError(true);\n    // }\n    // if (startDate === \"\" || startDate === undefined || startDate === null) {\n    //   setStartDateError(true);\n    //   setIsDateSelect(true);\n\n    // }\n    // if (endDate === \"\" || endDate === undefined || endDate === null) {\n    //   setEndDateError(true);\n    // }\n    // if( rate === \"\" || rate === null){\n    //   setRateError(true);\n    // }\n    // if( name !== \"\" && types !== \"\" && color !== \"\" && startDate !== \"\" && endDate !== \"\"){\n    //   clearFileds();\n    // }\n    else {\n      // clearFileds();\n      // submitIncident()\n    }\n    onFormSubmit();\n  };\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n      <Heading primary=\"EDIT AN INCIDENTS\" />\n      <div className={classes.content}>\n        <Form.Form onSubmit={submitHandler}>\n          <Form.Row>\n            <FormLabel bold primary=\"DESIGNATION* :\" />\n            <FormInput\n              name=\"name\"\n              style={GLOBALS.Styles.inputWidth}\n              placeholder=\"Name of incident\"\n              onChange={nameChange}\n              value={name}\n            />\n            {/* {nameError && (\n                  <div className={classes.error}>Please enter name</div>\n                )} */}\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"NAME OF COMPANY* :\" />\n            <Form.Row noMargin width=\"48%\">\n              <FormSelect\n                placeholder=\"Nom de I'enterprise\"\n                name=\"comapnyId\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={nameChange}\n                value={companyId}\n                values={dropdownCompanies}\n              />\n              <span\n                style={{\n                  textAlign: \"center\",\n                  marginRight: \"50px\",\n                  marginTop: \"10px\",\n                }}\n              >\n                General Contractor name\n              </span>\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"DATE AND TIME : \" />\n            <Form.Row noMargin width=\"48%\">\n              <FormInput\n                type=\"date\"\n                style={GLOBALS.Styles.inputWidth}\n                placeholder=\"Date\"\n                name=\"date\"\n                onChange={nameChange}\n                value=\"{date}\"\n                // error={formik.errors.contractStartDate}\n              />\n              <FormInput\n                placeholder=\"TIME\"\n                type=\"number\"\n                name=\"time\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={nameChange}\n                value=\"time\"\n                // value={formik.values.color}\n                // error={formik.errors.color}\n              />\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"LOCATION : \" />\n            <Form.Row noMargin width=\"48%\">\n              <FormSelect\n                placeholder=\"Type of location\"\n                name=\"color\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={locationTypeChange}\n                // value={formik.values.color}\n                // error={formik.errors.color}\n                values={dropdownLocationType}\n              />\n              <FormSelect\n                placeholder=\"LOCATION\"\n                name=\"location\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={nameChange}\n                // value={formik.values.color}\n                // error={formik.errors.color}\n                value=\"\"\n                values={dropdownLocation}\n              />\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"DESCRIPTION : \" />\n            <FormInput\n              textArea\n              rows={3}\n              style={GLOBALS.Styles.inputWidth}\n              onChange={nameChange}\n              placeholder=\"Information complementaires\"\n              name=\"description\"\n              // value={formik.values.additionalInfo} //working\n              // error={formik.errors.additionalInfo}\n            />\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"ADD PICTURES : \" />\n            <Form.Row noMargin width=\"48%\">\n              {/* <FormMultipleUpload\n                name=\"profile\"\n                // error={image}\n                values={image}\n                style={GLOBALS.Styles.inputWidth}\n                onChange={(values) => handleChange(\"profile\", values)}\n              /> */}\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"BILLABLE* : \" />\n            <FormSelect\n              placeholder=\"Select\"\n              name=\"billable\"\n              style={GLOBALS.Styles.inputWidth}\n              onChange={nameChange}\n              value={isBillable}\n              values={[\n                { value: \"true\", label: \"Yes\" },\n                { value: \"false\", label: \"No\" },\n              ]}\n            />\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"AMOUNT :\" />\n            <Form.Row width=\"48%\" noMargin alignItems=\"center\">\n              <Form.Row width=\"24%\" noMargin alignItems=\"center\">\n                <FormInput\n                  type=\"number\"\n                  name=\"price\"\n                  onChange={nameChange}\n                  value={price}\n\n                  // error={penaltyforLateDelivery}\n                />\n                <SmallText style={{ marginLeft: 10 }} primary=\"€\" />\n              </Form.Row>\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"COMMENT ON INVOICE : \" />\n            <FormInput\n              textArea\n              rows={3}\n              style={GLOBALS.Styles.inputWidth}\n              onChange={nameChange}\n              value={comment}\n              placeholder=\"Ajouter un commentaire\"\n              name=\"comment\"\n            />\n          </Form.Row>\n          <Form.ButtonContainer>\n            <Button\n              type=\"submit\"\n              minWidth={200}\n              text=\"VALIDER\"\n              fullWidth={false}\n            />\n          </Form.ButtonContainer>\n        </Form.Form>\n      </div>\n    </div>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Incidents/addIncidents.js",["563","564","565","566","567","568","569","570","571","572","573"],"import React, { useState, useEffect } from \"react\";\n\nimport { useFormik } from \"formik\";\nimport { useSelector } from \"react-redux\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport * as Yup from \"yup\";\n\nimport GLOBALS from \"../../../globals\";\nimport Form from \"../../../components/Form\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport Input from \"../../../components/Input\";\n\nimport SmallText from \"../../../components/SmallText\";\nimport FormLabel from \"../../../components/FormLabel\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\n\nconst useStyles = makeStyles(() => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n   error: {\n    color: \"red\",\n  },\n}));\n\n// const addClientYup = Yup.object().shape({\n//   logo: Yup.array().min(1, \"Required\").required(\"Required\"),\n//   name: Yup.string().required(\"Required\"),\n//   color: Yup.string().required(\"Required\"),\n//   firstName: Yup.string().required(\"Required\"),\n//   lastName: Yup.string().required(\"Required\"),\n//   email: Yup.string().required(\"Required\"),\n//   phone: Yup.number()\n//     .test(\n//       \"len\",\n//       \"Must be exactly 10 characters\",\n//       (val) => val && val.toString().length === 10,\n//     )\n//     .required(\"Required\"),\n//   contractType: Yup.string().required(\"Required\"),\n//   contractStartDate: Yup.string().required(\"Required\"),\n//   contractEndDate: Yup.string().required(\"Required\"),\n//   functionality: Yup.string().required(\"Required\"),\n//   additionalInfo: Yup.string(),\n//   notificationPriorToDays: Yup.number(),\n//   notificationTo: Yup.array(),\n// });\n\nexport default function AddIncidents(props) {\n  const classes = useStyles();\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n\n  const [name, setName] = useState(\"\");\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\n  const [dropdownLocationType, setDropdownLocationType] = useState([]);\n  const [dropdownLocation, setDropdownLocation] = useState([]);\n  const [selectedLocation, setSelectedLocation] = useState([]);\n\n  const [location, setLocations] = useState([]);\n  const [selectedLocationType, setselectedLocationType] = useState(\"\");\n\n  const [companyId, setCompanyId] = useState(\"\");\n    const [description, setDescription] = useState(\"\");\n\n  const [date, setDate] = useState(\"\");\n  const [time, setTime] = useState(\"\");\n\n  const [isBillable, seIsBillable] = useState(false);\n  const [price, setPrice] = useState(\"\");\n  const [comment, setComment] = useState(\"\");\n  const [selctedLocationObject, setselctedLocationObject] = useState(\"\");\n\n\n\n  const [nameError, setNameError] = useState(\"\"); //working\n\n  const [comapnyError, setComapnyError] = useState(\"\");\n  const [dateError, setDateError] = useState(\"\");\n  const [timeError, setTimeError] = useState(\"\");\n\n    useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n   useEffect(() => {\n    fetchLocationDataOnTypeChange();\n    // eslint-disable-next-line\n  }, [selectedLocationType]);\n\n const fetchData = async () => {\n   const response = await GLOBALS.API({\n  
uired\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function EditCompanies(props) {\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const [name, setName] = useState(\"\");\r\n  const [nameError, setNameError] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [colorError, setColorError] = useState(\"\");\r\n  const [images, setImages] = useState([]);\r\n  const [companyType, setCompanyType] = useState(\"\");\r\n  const [companyTypeError, setCompanyTypeError] = useState(\"\");\r\n  const [contract, setContract] = useState(\"\");\r\n  const [contractError, setContractError] = useState(\"\");\r\n  const [typeError, setTypeError] = useState(\"\");\r\n  const [trades, setTrades] = useState([]);\r\n  const [update, setUpdate] = useState(false);\r\n  const [email, setEmail] = useState(\"\");\r\n  const [emailError, setEmailError] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [phoneError, setPhoneError] = useState(\"\");\r\n  const [fname, setFname] = useState(\"\");\r\n  const [lname, setLname] = useState(\"\");\r\n  const [website, setWebsite] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n\r\n\r\n\r\n\r\n  const inputChange = (e) => {\r\n    if (e.target.name === \"companyType\") {\r\n      setCompanyType(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setCompanyTypeError(true);\r\n      } else {\r\n        setCompanyTypeError(false);\r\n      }\r\n    }\r\n   \r\n    if (e.target.name === \"email\") {\r\n      setEmail(e.target.value);\r\n      var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n      if (!e.target.value.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"addInfo\") {\r\n      setAddInfo(e.target.value);\r\n    }\r\n   \r\n  };\r\n\r\n\r\n  // const onSubmit = async (values) => {\r\n  //   const notificationTo = values.notificationTo.map((item) => item.label);\r\n\r\n  //   var formdata = new FormData();\r\n  //   formdata.append(\"logo\", values.logo[0].file);\r\n  //   formdata.append(\"name\", values.name);\r\n  //   formdata.append(\"color\", values.color);\r\n  //   formdata.append(\"firstName\", values.firstName);\r\n  //   formdata.append(\"lastName\", values.lastName);\r\n  //   formdata.append(\"email\", values.email);\r\n  //   formdata.append(\"phone\", values.phone);\r\n  //   formdata.append(\"contractType\", values.contractType);\r\n  //   formdata.append(\"contractStartDate\", values.contractStartDate);\r\n  //   formdata.append(\"contractEndDate\", values.contractEndDate);\r\n  //   formdata.append(\"functionality\", values.functionality);\r\n  //   formdata.append(\"additionalInfo\", values.additionalInfo);\r\n  //   formdata.append(\"notificationPriorToDays\", values.notificationPriorToDays);\r\n  //   formdata.append(\"notificationTo\", JSON.stringify(notificationTo));\r\n\r\n  //   await GLOBALS.API({\r\n  //     method: \"POST\",\r\n  //     uri: GLOBALS.Constants.CLIENTS,\r\n  //     headers: {\r\n  //       Authorization: store.token,\r\n  //     },\r\n  //     body: formdata,\r\n  //   });\r\n  //   formik.setSubmitting(false);\r\n  //   props.history.push(\"/clients\");\r\n  // };\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"trades\") {\r\n     if(value !== \"\"){\r\n      setUpdate((st) => !st);\r\n      setTrades(value);\r\n      console.log(\"trades\", trades);\r\n    }\r\n     }\r\n  }\r\n\r\n  const submitHandler = (e) => {\r\n    var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n    e.preventDefault();\r\n   \r\n    // if (\r\n    //   companyType === \"\" ||\r\n    //   companyType === null ||\r\n    //   companyType === undefined\r\n    // ) {\r\n    //   setCompanyTypeError(true);\r\n    // }\r\n   \r\n    if (email !== \"\") {\r\n      if (!email.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n  else {\r\n      console.log(\"contarct submit\", companyType);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"EDIT A COMPANY\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"name\"\r\n                  disabled\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Company name\"\r\n                  value={name}\r\n                />\r\n                {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"color\"\r\n                  disabled\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Color\"\r\n                  value={color}\r\n                />\r\n                {colorError && (\r\n                  <div className={classes.error}>Please enter color</div>\r\n                )}\r\n              </div>\r\n              <FormMultipleUpload\r\n                name=\"images\"\r\n                \r\n                style={GLOBALS.Styles.inputWidth}\r\n                multiple\r\n                values={images}\r\n                onChange={(values) =>\r\n                  inputChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"images\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n                // onChange={inputChange}\r\n                // onChange={(values) =>\r\n                \r\n                   \r\n                //      ( {type: \"text\",\r\n                //       name: \"trades\",\r\n                //       value: values})\r\n                   \r\n               \r\n                // }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF COMPANY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div>\r\n                <div onChange={inputChange}>\r\n                  <input\r\n                  className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"generalcontractor\"\r\n                    name=\"companyType\"\r\n                    value=\"generalcontractor\"\r\n                  />\r\n                  <label for=\"generalcontractor\" className={classes.radioLabel}>General Contractor</label>\r\n                  <input\r\n                  className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"subcontractor\"\r\n                    name=\"companyType\"\r\n                    value=\"subcontractor\"\r\n                  />\r\n                  <label for=\"subcontractor\" className={classes.radioLabel}>Sub contractor</label>\r\n                </div>\r\n                {companyTypeError === true && (\r\n                  <div className={classes.error}>Please select company</div>\r\n                )}\r\n              </div>\r\n\r\n              {/* <RadioButton\r\n                name=\"contractType\"\r\n                style={{width: '80%'}}\r\n                value={formik.values.contractType}\r\n                error={formik.errors.contractType}\r\n                onChange={formik.handleChange}\r\n                items={[\r\n                  { value: \"GENERALCONTRACTOR\", label: \"General Contractor\" },\r\n                  { value: \"Subcontractor\", label: \"Subcontract\" },\r\n                ]}\r\n              /> */}\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"GENERAL CONTRACTOR : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"100%\", height: \"100%\" }}>\r\n                <select\r\n                  name=\"contract\"\r\n                  disabled\r\n                  id=\"contract\"\r\n                  type={contract}\r\n                  style={{ width: \"40%\", height: \"45px\", color: \"#8B8989\", padding: '0px 10px' }}\r\n                  onChange={inputChange}\r\n                >\r\n                  <option value=\"\">List</option>\r\n                  <option value=\"Yellow\">Yellow</option>\r\n                  <option value=\"Red\">Red</option>\r\n                  <option value=\"Blue\">Blue</option>\r\n                </select>\r\n                {contractError === true && (\r\n                  <div className={classes.error}>Please select contract</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TRADES : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n            <MultiAdderInput\r\n              name=\"trades\"\r\n              values={trades}\r\n              validateError=\"Please enter trades\"\r\n              placeholder=\"Trades\"\r\n              style={{width: \"40%\"}}\r\n              // disabled={contractType !== \"MASTERCLIENT\"}\r\n              onChange={(values) => handleChange(\"trades\", values)}\r\n              validate={(text) => {\r\n                if(text !== \"\"){\r\n                  return false;\r\n                }\r\n                else{\r\n                  return true;\r\n                }\r\n              }}\r\n            />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDEMTITY OF RESPONSIBLE* : \" />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"email\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Adresse e-mail\"\r\n                  onChange={inputChange}\r\n                  value={email}\r\n                />\r\n                {emailError === true && (\r\n                  <div className={classes.error}>Please enter valid email</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"phone\"\r\n                  disabled\r\n                  type=\"number\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Téléphone\"\r\n                  onChange={inputChange}\r\n                  value={phone}\r\n                />\r\n                {phoneError === true && (\r\n                  <div className={classes.error}>\r\n                    Telephone should be 11 digits\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"fname\"\r\n                  disabled\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"First Name\"\r\n                  onChange={(e) => setFname(e.target.value)}\r\n                  value={fname}\r\n                />\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"lname\"\r\n                  disabled\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Last Name\"\r\n                  onChange={(e) => setLname(e.target.value)}\r\n                  value={lname}\r\n                />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"Website : \" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                name=\"website\"\r\n                disabled\r\n                style={{width: '50%'}}\r\n                placeholder=\"http://\"\r\n                onChange={(e) => setWebsite(e.target.value)}\r\n                value={website}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\r\n            <Form.Row width=\"55%\">\r\n            <FormInput\r\n              textArea\r\n              rows={3}\r\n              style={{width: '90%'}}\r\n              onChange={(e) => setAddInfo(e.target.value)}\r\n              placeholder=\"Informations complémentaires\"\r\n              name=\"addInfo\"\r\n              value={addInfo}\r\n            />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              type=\"submit\"\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              // disabled={\r\n              //   name === \"\" ||\r\n              //   color === \"\" ||\r\n              //   companyType === \"\" ||\r\n              //   contract === \"\" ?\r\n              //   true : false\r\n              // }\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/AddCompanies.js",["578","579","580","581","582","583","584","585","586","587","588","589","590","591","592"],"import React, { useState, useEffect } from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport MultiAdderInput from \"../../../components/MultiAdderInput\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport { InputSharp } from \"@material-ui/icons\";\r\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\r\nimport TextField from \"@material-ui/core/TextField\";\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n  error: {\r\n    color: \"red\",\r\n  },\r\n  radioLabel: {\r\n    marginLeft: \"7px\",\r\n    color: \"#7E7878\",\r\n    marginRight: \"50px\",\r\n  },\r\n  radioBtn: {},\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  images: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function AddCompanies(props) {\r\n  const dispatch = useDispatch();\r\n\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [name, setName] = useState(\"\");\r\n  const [nameError, setNameError] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [colorError, setColorError] = useState(\"\");\r\n  const [images, setImages] = useState([]);\r\n  const [companyType, setCompanyType] = useState(\"subcontractor\");\r\n  const [companyTypeError, setCompanyTypeError] = useState(\"\");\r\n  const [contract, setContract] = useState(\"\");\r\n  const [contractError, setContractError] = useState(\"\");\r\n  const [typeError, setTypeError] = useState(\"\");\r\n  const [update, setUpdate] = useState(false);\r\n  const [email, setEmail] = useState(\"\");\r\n  const [emailError, setEmailError] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [phoneError, setPhoneError] = useState(\"\");\r\n  const [fname, setFname] = useState(\"\");\r\n  const [lname, setLname] = useState(\"\");\r\n  const [website, setWebsite] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  const [trades, setTrades] = useState([]);\r\n  const [dropdownTrades, setDropdownTrades] = useState([]);\r\n  const [selectedTrade, setSelectedTrade] = useState(\"\");\r\n  const [listOfTrades, setListOfTrades] = useState([]);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n  }, []);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_COMPANY}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.site_companies);\r\n        setTrades(response.data.site_trades);\r\n        if (response.data.site_companies != null) {\r\n          const companyTemp = [];\r\n\r\n          response.data.site_companies.map((item, index) => {\r\n            return companyTemp.push({\r\n              label: item.companyId.name,\r\n              value: item.companyId.name,\r\n            });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n\r\n        if (response.data.site_trades != null) {\r\n          const tradesTemp = [];\r\n\r\n          response.data.site_trades.map((item, index) => {\r\n            return tradesTemp.push({\r\n              label: item,\r\n              value: item,\r\n            });\r\n          });\r\n          setDropdownTrades(tradesTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  // const [startDate, setStartDate] = useState(\"\");\r\n  // const [startDateError, setStartDateError] = useState(\"\");\r\n  // const [isDateSelect, setIsDateSelect] = useState(\"\");\r\n  // const [endDate, setEndDate] = useState(\"\");\r\n  // const [endDateError, setEndDateError] = useState(\"\");\r\n  // const [available, setAvailable] = useState(\"VOIR LES INDISPONIBILITÉS\");\r\n  // const [techSheet, setTechSheet] = useState([]);\r\n  // const [rate, setRate] = useState(\"\");\r\n  // const [rateError, setRateError] = useState(\"\");\r\n\r\n  const onSubmit = async () => {\r\n    // const notificationTo = values.notificationTo.map((item) => item.label);\r\n    const values = formik.values;\r\n    const isSubContractor = companyType === \"subcontractor\";\r\n    const parentCompanyId = companies[selectedCompanyIndex].companyId._id;\r\n\r\n    alert(\r\n      name +\r\n        \" \" +\r\n        phone +\r\n        \" \" +\r\n        fname +\r\n        \" \" +\r\n        lname +\r\n        \" \" +\r\n        website +\r\n        \" \" +\r\n        addInfo,\r\n    );\r\n    return;\r\n\r\n    var formdata = new FormData();\r\n    formdata.append(\"logo\", values.images[0].file);\r\n    formdata.append(\"name\", name);\r\n    formdata.append(\"color\", values.color);\r\n    formdata.append(\"firstName\", values.firstName);\r\n    formdata.append(\"lastName\", values.lastName);\r\n    formdata.append(\"email\", values.email);\r\n    formdata.append(\"phone\", values.phone);\r\n    // formdata.append(\"contractType\", values.contractType);\r\n    //formdata.append(\"contractStartDate\", values.contractStartDate);\r\n    //formdata.append(\"contractEndDate\", values.contractEndDate);\r\n    //formdata.append(\"functionality\", values.functionality);\r\n    //formdata.append(\"additionalInfo\", values.additionalInfo);\r\n    //formdata.append(\"notificationPriorToDays\", values.notificationPriorToDays);\r\n    // formdata.append(\"notificationTo\", JSON.stringify(notificationTo));\r\n    await GLOBALS.API({\r\n      method: \"POST\",\r\n      uri: GLOBALS.Constants.CLIENTS,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n\r\n  const inputChange = (e) => {\r\n    if (e.target.name === \"name\") {\r\n      setName(e.target.value);\r\n      if (e.target.name === \"\" || name === null) {\r\n        setNameError(true);\r\n      } else {\r\n        setNameError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"color\") {\r\n      setColor(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setColorError(true);\r\n      } else {\r\n        setColorError(false);\r\n      }\r\n    }\r\n    // if (e.target.name === \"companyType\") {\r\n    //   console.log(e.target.value);\r\n    //   setCompanyType(e.target.value);\r\n    //   console.log(\"company type\", companyType);\r\n    //   if (e.target.value === \"\" || e.target.value === null) {\r\n    //     setCompanyTypeError(true);\r\n    //   } else {\r\n    //     setCompanyTypeError(false);\r\n    //   }\r\n    // }\r\n    if (e.target.name === \"contract\") {\r\n      setContract(e.target.value);\r\n      if (\r\n        e.target.value === \"\" ||\r\n        e.target.value === null ||\r\n        e.target.value === undefined\r\n      ) {\r\n        setContractError(true);\r\n      } else {\r\n        setContractError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"email\") {\r\n      setEmail(e.target.value);\r\n      var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n      if (!e.target.value.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"phone\") {\r\n      setPhone(e.target.value);\r\n      if (e.target.value.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    }\r\n\r\n    if (e.target.name === \"images\") {\r\n      setImages(e.target.value);\r\n    }\r\n    if (e.target.name === \"trades\") {\r\n      setTrades(e.target.value);\r\n    }\r\n\r\n    if (e.target.name === \"addInfo\") {\r\n      setAddInfo(e.target.value);\r\n    }\r\n  };\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"trades\") {\r\n      if (value !== \"\") {\r\n        setUpdate((st) => !st);\r\n        setTrades(value);\r\n        console.log(\"trades\", trades);\r\n      }\r\n    }\r\n  };\r\n\r\n  const submitHandler = (e) => {\r\n    var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n    e.preventDefault();\r\n    if (name === \"\" || name === null) {\r\n      setNameError(true);\r\n    }\r\n    if (color === \"\" || color === null) {\r\n      setColorError(true);\r\n    }\r\n    if (\r\n      companyType === \"\" ||\r\n      companyType === null ||\r\n      companyType === undefined\r\n    ) {\r\n      setCompanyTypeError(true);\r\n    }\r\n    if (contract === \"\" || contract === null || contract === undefined) {\r\n      setContractError(true);\r\n    }\r\n    if (email !== \"\") {\r\n      if (!email.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (phone !== \"\") {\r\n      if (phone.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    } else {\r\n      console.log(\"contarct submit\", companyType);\r\n    }\r\n  };\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      images: [],\r\n      name: \"\",\r\n      color: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    validationSchema: addClientYup,\r\n    //    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n  console.log(\"type ==> \", companyType);\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"ADD A COMPANY\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <Autocomplete\r\n                  id=\"free-solo-demo\"\r\n                  freeSolo\r\n                  style={{\r\n                    ...GLOBALS.Styles.inputWidth,\r\n                    marginRight: \"10px\",\r\n                  }}\r\n                  onSelect={(event) => {\r\n                    companies.forEach((item, index) => {\r\n                      if (item.companyId.name === event.target.value) {\r\n                        setName(item.companyId.name);\r\n                      }\r\n                    });\r\n                  }}\r\n                  options={companies.map((option) => {\r\n                    if (option.companyId.name != undefined)\r\n                      return option.companyId.name;\r\n                  })}\r\n                  renderInput={(params) => (\r\n                    <TextField\r\n                      {...params}\r\n                      label=\"Email\"\r\n                      margin=\"normal\"\r\n                      variant=\"outlined\"\r\n                      name=\"name\"\r\n                      value={formik.values.email}\r\n                      error={formik.errors.email}\r\n                      onChange={formik.handleChange}\r\n                    />\r\n                  )}\r\n                />\r\n                {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"color\"\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Color\"\r\n                  value={color}\r\n                />\r\n                {colorError && (\r\n                  <div className={classes.error}>Please enter color</div>\r\n                )}\r\n              </div>\r\n              <FormMultipleUpload\r\n                name=\"images\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={formik.values.images}\r\n                onChange={(values) =>\r\n                  inputChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"images\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n                // onChange={inputChange}\r\n                // onChange={(values) =>\r\n\r\n                //      ( {type: \"text\",\r\n                //       name: \"trades\",\r\n                //       value: values})\r\n\r\n                // }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF COMPANY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div>\r\n                <div>\r\n                  <input\r\n                    className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    onChange={(e) => setCompanyType(\"generalcontractor\")}\r\n                    id=\"generalcontractor\"\r\n                    name=\"companyType\"\r\n                    value=\"generalcontractor\"\r\n                  />\r\n                  <label for=\"generalcontractor\" className={classes.radioLabel}>\r\n                    General Contractor\r\n                  </label>\r\n                  <input\r\n                    className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"subcontractor\"\r\n                    name=\"companyType\"\r\n                    onChange={(e) => {\r\n                      setCompanyType(\"subcontractor\");\r\n                      console.log(companyType);\r\n                    }}\r\n                    value=\"subcontractor\"\r\n                    defaultChecked\r\n                  />\r\n                  <label for=\"subcontractor\" className={classes.radioLabel}>\r\n                    Sub contractor\r\n                  </label>\r\n                </div>\r\n                {companyTypeError === true && (\r\n                  <div className={classes.error}>Please select company</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"GENERAL CONTRACTOR : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"100%\", height: \"100%\" }}>\r\n                <FormSelect\r\n                  placeholder=\"Company\"\r\n                  values={dropdownCompanies}\r\n                  value={selectedCompany}\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  onChange={(event) => {\r\n                    const index = event.target.selectedIndex - 1;\r\n\r\n                    if (index !== -1) {\r\n                      const item = event.target.value;\r\n\r\n                      setSelectedCompanyIndex(index);\r\n\r\n                      setSelectedCompany(item);\r\n                    } else {\r\n                      setSelectedCompanyIndex(null);\r\n\r\n                      setSelectedCompany(\"\");\r\n                    }\r\n                  }}\r\n                  style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n                />\r\n                {/* <select\r\n                  name=\"contract\"\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  id=\"contract\"\r\n                  type={contract}\r\n                  style={{\r\n                    width: \"40%\",\r\n                    height: \"45px\",\r\n                    color: \"#8B8989\",\r\n                    padding: \"0px 10px\",\r\n                  }}\r\n                  onChange={inputChange}\r\n                >\r\n                \r\n                </select> */}\r\n                {contractError === true && (\r\n                  <div className={classes.error}>Please select contract</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TRADES : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <CustomInputModal\r\n                name=\"trades\"\r\n                values={dropdownTrades}\r\n                value={selectedTrade}\r\n                placeholder=\"Select Trades\"\r\n                chipValues={(values) => {\r\n                  const valuesTemp = [];\r\n                  values.forEach((item, index) => {\r\n                    valuesTemp.push(item.label);\r\n                  });\r\n                  setListOfTrades(valuesTemp);\r\n                  console.log(JSON.stringify(valuesTemp, null, 2));\r\n\r\n                  // setSiteParams(values);\r\n                }}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedTrade(item);\r\n                  } else {\r\n                    setSelectedTrade(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDEMTITY OF RESPONSIBLE* : \" />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"email\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Adresse e-mail\"\r\n                  onChange={inputChange}\r\n                  value={email}\r\n                />\r\n                {emailError === true && (\r\n                  <div className={classes.error}>Please enter valid email</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"phone\"\r\n                  type=\"number\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Téléphone\"\r\n                  onChange={inputChange}\r\n                  value={phone}\r\n                />\r\n                {phoneError === true && (\r\n                  <div className={classes.error}>\r\n                    Telephone should be 10 digits\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"fname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"First Name\"\r\n                  onChange={(e) => setFname(e.target.value)}\r\n                  value={fname}\r\n                />\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"lname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Last Name\"\r\n                  onChange={(e) => setLname(e.target.value)}\r\n                  value={lname}\r\n                />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"Website : \" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                name=\"website\"\r\n                style={{ width: \"50%\" }}\r\n                placeholder=\"http://\"\r\n                onChange={(e) => setWebsite(e.target.value)}\r\n                value={website}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                style={{ width: \"90%\" }}\r\n                onChange={(e) => setAddInfo(e.target.value)}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              onClick={() => {\r\n                onSubmit();\r\n              }}\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              disabled={name === \"\" || color === \"\" || companyType === \"\"}\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Incidents/Incidents.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/Companies.js",["593","594","595","596","597"],"import React, { useState, useEffect } from \"react\";\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n// import * as Yup from \"yup\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\nimport GLOBALS from \"../../../globals\";\nimport Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Modal from \"../../../components/Modal\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport AvatarUpload from \"../../../components/AvatarUpload\";\nimport uploadIcon from \"../../../assets/images/upload.png\";\nimport { Images } from \"../../../assets/Assets\";\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n}));\n\n// const updateAdminYup = Yup.object().shape({\n//   email: Yup.string().required(\"Required\"),\n//   phone: Yup.number()\n//     .test(\n//       \"len\",\n//       \"Must be exactly 10 characters\",\n//       (val) => val && val.toString().length === 10,\n//     )\n//     .required(\"Required\"),\n//   image: Yup.object().optional(\"\"),\n//   companyId: Yup.string().required(\"Required\"),\n// });\n\nexport default function Companies(props) {\n  const theme = useTheme();\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n\n  const [page] = useState(1);\n  const [items, setItems] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [companies, setCompanies] = useState([]);\n  const [modal, setModal] = useState(false);\n  const [selectedItem] = useState(\"\");\n  const [firstName, setFirstName] = useState(\"\");\n  const [lastName, setLastName] = useState(\"\");\n  const [phone, setPhone] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [companyId, setCompanyId] = useState(\"\");\n  const [nameOfResponsible, setNameOfResponsible] = useState(\"\");\n  const [nameOfCompany, setNameOfCompany] = useState(\"\");\n\n  useEffect(() => {\n    getData();\n\n    // eslint-disable-next-line\n  }, []);\n\n  const getData = async () => {\n    try {\n      console.log(adminStore.site.siteId._id);\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_SITE_COMPANIES}/${adminStore.site.siteId._id}`,\n        token: store.token,\n      });\n      if (response.success) {\n        setCompanies(response.data.companies);\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n  const handleChange = (name, value) => {\n    if (name === \"firstName\") setFirstName(value);\n    else if (name === \"lastName\") setLastName(value);\n    else if (name === \"phone\") setPhone(value);\n    else if (name === \"image\") setImage(value);\n    else if (name === \"companyId\") setCompanyId(value);\n  };\n\n  const onUpdate = async (e) => {\n    try {\n      e.preventDefault();\n      setLoading(true);\n      var formdata = new FormData();\n      formdata.append(\"firstName\", firstName);\n      formdata.append(\"lastName\", lastName);\n      formdata.append(\"phone\", phone);\n      formdata.append(\"companyId\", companyId);\n      formdata.append(\"userId\", selectedItem._id);\n      image.file && formdata.append(\"image\", image.file);\n\n      const result = await GLOBALS.API({\n        method: \"PUT\",\n        uri: GLOBALS.Constants.ADMINS,\n        headers: {\n          Authorization: store.token,\n        },\n        body: formdata,\n      });\n      const itemsArray = items.map((item) =>\n        item._id === selectedItem._id ? result.data : item,\n      );\n      setItems(itemsArray);\n      setLoading(false);\n      setModal(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getSubContractors = (subcontractors) => {\n    if (subcontractors && subcontractors.length > 0) {\n      const value = subcontractors\n        .map((item, index) => {\n          if (item.name != undefined) return item.name;\n          return \"N/A\";\n        })\n        .toString()\n        .replace(/,/g, \" \");\n      return value;\n    }\n    return \"N/A\";\n  };\n\n  const filterCompany = async () => {\n    try {\n      setLoading(true);\n      const params = { siteId: \"6008169bedbb7816d40b197d\" };\n      if (nameOfCompany.length !== 0) params[\"companyName\"] = nameOfCompany;\n      if (nameOfResponsible.length !== 0)\n        params[\"responsibleName\"] = nameOfResponsible;\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.FILTER_COMPANY_SITES}`,\n        token: store.token,\n        method: \"POST\",\n        body: JSON.stringify(params),\n      });\n      if (response.success) {\n        setCompanies(response.data.companies);\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const rows = companies.map((item) => {\n    return [\n      <img src={Images.site} alt=\"Icon\" />,\n      item.companyId.name,\n      getSubContractors(item.subContractors),\n      item.incharge != undefined\n        ? item.companyId.incharge.firstName +\n          \" \" +\n          item.companyId.incharge.lastName\n        : \"N/A\",\n      item.companyId.incharge != undefined\n        ? item.companyId.incharge.phone\n        : \"N/A\",\n      item.companyId.incharge != undefined\n        ? item.companyId.incharge.email\n        : \"N/A\",\n\n      <div>\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\n          <NavLink\n            to={{\n              pathname: \"/companies/user-list\",\n              id: item.companyId._id,\n            }}\n          >\n            <img\n              src={Images.comapnies}\n              style={{ width: 18, height: 17 }}\n              alt=\"Icon\"\n            />\n          </NavLink>\n        </IconButton>\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\n          <NavLink to=\"/companies/edit-companies\">\n            <Pencil style={{ width: 18, height: 15 }} />\n          </NavLink>\n        </IconButton>\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\n          <img\n            src={Images.calender}\n            style={{ width: 18, height: 17 }}\n            alt=\"Icon\"\n          />\n        </IconButton>\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\n          <img\n            src={Images.invoices}\n            style={{ width: 18, height: 17 }}\n            alt=\"Icon\"\n          />\n        </IconButton>\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\n          <img\n            src={Images.incidents}\n            style={{ width: 18, height: 17 }}\n            alt=\"Icon\"\n          />\n        </IconButton>\n      </div>,\n    ];\n  });\n\n  return (\n    <>\n      <div className={classes.root}>\n        <Form.Row alignItems=\"center\" className=\"pr-3\">\n          <Heading primary=\"LIST OF COMPANIES\" noWrap />\n          <div>\n            <Form.Row alignItems=\"center\" noMargin>\n              <SubHeading\n                disableMargin\n                primary={`Total : ${companies.length} COMPANIES`}\n                bold\n              />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"ADD A COMPANY\"\n                style={{ marginLeft: \"20px\" }}\n                to={\"/companies/add-companies\"}\n              />\n            </Form.Row>\n          </div>\n        </Form.Row>\n        <Form.Row noMargin className=\"pr-3\">\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\n            <SearchInput\n              placeholder=\"Name of responsible\"\n              value={nameOfResponsible}\n              onClick={() => {\n                filterCompany();\n              }}\n              onChange={(event) => {\n                setNameOfResponsible(event.target.value);\n              }}\n            />\n            <SearchInput\n              style={{ marginLeft: \"20px\" }}\n              placeholder=\"Name of company\"\n              value={nameOfCompany}\n              onClick={() => {\n                filterCompany();\n              }}\n              onChange={(event) => {\n                setNameOfCompany(event.target.value);\n              }}\n            />\n            <a href=\"#companies\">\n              <img\n                style={{\n                  width: \"1.3rem\",\n                  marginLeft: \"20px\",\n                  marginTop: \"10px\",\n                }}\n                src={uploadIcon}\n                alt=\"File Upload Icon\"\n              />\n            </a>\n          </Form.Row>\n          <Button\n            fullWidth={true}\n            component={NavLink}\n            text=\"ACCESS REQUEST TO ZONES\"\n            style={{ width: \"330px\" }}\n            to={\"/admins/add-admin\"}\n          />\n        </Form.Row>\n        <div className={classes.content}>\n          <Table headers={GLOBALS.Data.companies.headings} rows={rows} />\n        </div>\n      </div>\n      <Modal\n        title=\"EDIT ADMIN\"\n        open={selectedItem ? modal : false}\n        onClose={() => setModal((st) => !st)}\n        body={\n          <Form.Form onSubmit={onUpdate}>\n            <Form.Row justifyContent=\"center\">\n              <AvatarUpload\n                value={image}\n                // error={image}\n                onChange={(file) => {\n                  const uri = URL.createObjectURL(file);\n                  handleChange(\"image\", { file, uri });\n                }}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"firstName\"\n                value={firstName}\n                // error={firstName}\n                placeholder=\"First Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"lastName\"\n                value={lastName}\n                // error={lastName}\n                placeholder=\"Last Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"phone\"\n                placeholder=\"Phone Number\"\n                value={phone}\n                // error={phone}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                style={GLOBALS.Styles.inputWidth}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormSelect\n                name=\"companyId\"\n                value={companyId}\n                // error={companyId}\n                values={companies}\n                placeholder=\"Company Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Column alignItems=\"center\">\n              <Form.Row justifyContent=\"center\">\n                <Button\n                  type=\"submit\"\n                  minWidth={200}\n                  text=\"VALIDATE\"\n                  fullWidth={false}\n                  loading={loading}\n                  disabled={\n                    loading ||\n                    !firstName ||\n                    !lastName ||\n                    !phone ||\n                    image === \"\" ||\n                    !companyId\n                  }\n                />\n              </Form.Row>\n              <Form.Row justifyContent=\"center\">\n                <Button\n                  text=\"DELETE\"\n                  minWidth=\"30%\"\n                  fullWidth={false}\n                  disabled={loading || true}\n                  color={theme.palette.error.main}\n                />\n              </Form.Row>\n            </Form.Column>\n          </Form.Form>\n        }\n      />\n    </>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/ZACs.js",["598"],"import React, { useState, useEffect } from \"react\";\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\nimport GLOBALS from \"../../../globals\";\nimport Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Loader from \"../../../components/Loader\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport Pagination from \"../../../components/Pagination\";\nimport { ReactComponent as Cross } from \"../../../assets/icons/Cross.svg\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: \"40px 15px\",\n  },\n  content: {\n    padding: 15,\n    marginTop: 10,\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    backgroundColor: theme.palette.secondary.main,\n  },\n}));\n\nexport default function ZACS(props) {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [page, setPage] = useState(1);\n  const [data, setData] = useState(\"\");\n  const [items, setItems] = useState([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, [page]);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.ZACS}?page=${page}`,\n      });\n      setItems(result.data.items);\n      setData(result.data);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.messagerr, \"error\"),\n        ),\n      );\n    }\n  }\n\n  async function onDelete(itemId) {\n    try {\n      if (window.confirm(\"Are you sure, you want to delete this?\")) {\n        setLoading(true);\n        await GLOBALS.API({\n          method: \"DELETE\",\n          token: store.token,\n          uri: GLOBALS.Constants.ZAC_DELETE + \"/\" + itemId,\n        });\n        const itemsArray = items.filter((item) => item._id !== itemId);\n        setItems(itemsArray);\n        setLoading(false);\n      }\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const rows = [];\n  items.map((item) => {\n    rows.push([\n      item.name,\n      item.sites.length,\n      <IconButton disabled={loading} onClick={() => onDelete(item._id)}>\n        <Cross style={{ width: 15, height: 15, color: \"red\" }} />\n      </IconButton>,\n    ]);\n    return true;\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row>\n        <Heading primary=\"ZACS LIST\" noMargin />\n        <Button\n          fullWidth={false}\n          component={NavLink}\n          text=\"CREATE A ZAC\"\n          to=\"/sites/add-zac\"\n        />\n      </Form.Row>\n      <div className={classes.content}>\n        {loading ? (\n          <Loader.Progress />\n        ) : (\n          <Table headers={GLOBALS.Data.zacs.headings} rows={rows} />\n        )}\n        {!loading && data.totalItems > 10 && (\n          <Pagination\n            page={page}\n            count={data.totalPages}\n            onChange={(e, value) => {\n              setPage(value);\n            }}\n          />\n        )}\n      </div>\n    </div>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/Invoices.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/Sites.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/Clients.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Admins/AddAdmin.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Admins/Admins.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/globals/Constants.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/EditSite/index.js",["599"],"import React, { useState, useEffect } from \"react\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport { useDispatch } from \"react-redux\";\nimport moment from \"moment\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\nimport GLOBALS from \"../../../../globals\";\nimport Actions from \"../../../../redux/actions\";\n\nimport EditSiteStep1 from \"./EditSiteStep1\";\nimport EditSiteStep2 from \"./EditSiteStep2\";\nimport EditSiteStep3 from \"./EditSiteStep3\";\nimport Stepper from \"../../../../components/Stepper\";\nimport Heading from \"../../../../components/Heading\";\nimport { ReactComponent as BackArrow } from \"../../../../assets/icons/BackArrow.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n}));\n\nexport default function EditSite(props) {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  // const store = useSelector((state) => state.auth);\n\n  const [step, setStep] = useState(1);\n  const [data, setData] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n  const [step1Data, setStep1Data] = useState(\"\");\n  const [step2Data, setStep2Data] = useState(\"\");\n  const [step2SubmittedData, setStep2SubmittedData] = useState(\"\");\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      let response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.SITE_GET}/${props.match.params.siteId}`,\n      });\n      response = response.data;\n\n      const trades = response.trades.map((trade, index) => ({\n        key: index,\n        label: trade,\n      }));\n      const addresses = response.addresses.map((address, index) => ({\n        _id: index,\n        street: address.street,\n        city: address.city,\n        postal: address.postal,\n        label: `${address.street} ${address.city} ${address.postal}`,\n      }));\n      setStep1Data({\n        name: response.name,\n        logo: response.logo,\n        zacId: response.zacId?._id,\n        adminId: response.adminId._id,\n        functionality: response.functionality,\n        addresses: addresses,\n        trades: trades,\n        penaltyforLateDelivery: response.penaltyforLateDelivery,\n        penaltyforUnexpDelivery: response.penaltyforUnexpDelivery,\n      });\n\n      const openingHours = {};\n      response.openingHours.map((day) => {\n        openingHours[`day${day.day}Start`] = day.startHour;\n        openingHours[`day${day.day}End`] = day.endHour;\n        openingHours[`day${day.day}Off`] = day.dayOff;\n        return true;\n      });\n      const unavailabilityDates = [];\n\n      response.unavailabilityDates.map((key) => {\n        unavailabilityDates.push({\n          date: key.date,\n          dayOff: key.dayOff,\n          endHour: key.endHour,\n          reason: key.reason,\n          startHour: key.startHour,\n        });\n      });\n      const notificationToArray = response.notificationTo.map(\n        (notification, index) => ({\n          key: index,\n          label: notification,\n        }),\n      );\n      setStep2Data({\n        start: moment(response.start).format(\"YYYY-MM-DD\"),\n        end: moment(response.end).format(\"YYYY-MM-DD\"),\n        openingHours: openingHours,\n        unavailabilityDates: unavailabilityDates,\n        additionalInfo: response.additionalInfo,\n        notificationPriorToDays: response.notificationPriorToDays,\n        notificationTo: notificationToArray,\n      });\n\n      setData(response);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n      <Heading primary=\"EDIT A SITE\" />\n      <Stepper\n        disabled\n        step={step}\n        setStep={setStep}\n        steps={[\"Step 1: General Information\", \"Step 2: Dates\", \"Text 1: PIC\"]}\n      />\n      <div className={classes.content}>\n        {!loading &&\n          (step === 1 ? (\n            <EditSiteStep1\n              {...props}\n              data={data}\n              step={step}\n              setStep={setStep}\n              step1Data={step1Data}\n              step2Data={step2Data}\n              setStep1Data={setStep1Data}\n              setStep2Data={setStep2Data}\n            />\n          ) : step === 2 ? (\n            <EditSiteStep2\n              {...props}\n              data={data}\n              step={step}\n              setStep={setStep}\n              step1Data={step1Data}\n              step2Data={step2Data}\n              setStep1Data={setStep1Data}\n              setStep2Data={setStep2Data}\n              step2SubmittedData={step2SubmittedData}\n              setStep2SubmittedData={setStep2SubmittedData}\n            />\n          ) : (\n            <EditSiteStep3\n              {...props}\n              data={data}\n              step={step}\n              setStep={setStep}\n              step1Data={step1Data}\n              step2Data={step2Data}\n              setStep1Data={setStep1Data}\n              setStep2Data={setStep2Data}\n            />\n          ))}\n      </div>\n    </div>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/globals/Styles.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/globals/API.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/MeanCalender/index.js",["600"],"import React, { useState } from \"react\";\r\nimport \"./Calender.css\";\r\nimport { Modal, Button, Alert } from \"react-bootstrap\";\r\nimport Radio from \"@material-ui/core/Radio\";\r\nimport RadioGroup from \"@material-ui/core/RadioGroup\";\r\nimport FormControlLabel from \"@material-ui/core/FormControlLabel\";\r\nimport FormControl from \"@material-ui/core/FormControl\";\r\nimport myEventsList from \"./components/events\";\r\nimport moment from \"moment\";\r\nimport { Calendar, momentLocalizer } from \"react-big-calendar\";\r\nimport \"react-big-calendar/lib/css/react-big-calendar.css\";\r\nimport PopoverModal from \"./components/popoverModal\";\r\nimport MyWorkWeek from \"./components/MyWorkWeek\";\r\nimport TimePicker from \"react-time-picker\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport { addDays } from \"date-fns\";\r\nimport DatePicker from \"react-datepicker\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport \"react-datepicker/dist/react-datepicker.css\";\r\n\r\nlet view = {\r\n  month: true,\r\n  day: true,\r\n  work_week: MyWorkWeek,\r\n  agenda: true,\r\n};\r\n\r\nconst localizer = momentLocalizer(moment);\r\n\r\nlet formats = {\r\n  dateFormat: \"DD\",\r\n  monthHeaderFormat: \"DD/MM/YYYY\",\r\n  dayHeaderFormat: \"DD/MM/YYYY\",\r\n  dayRangeHeaderFormat: \"DD/MM/YYYY\",\r\n  timeGutterFormat: (date, culture, localizer) =>\r\n    localizer.format(date, \"HH:mm\", culture),\r\n  eventTimeRangeFormat: ({ start, end }, culture, localizer) =>\r\n    localizer.format(start, \"HH:mm\") + \"-\" + localizer.format(end, \"HH:mm\"),\r\n};\r\n\r\nconst Calender = () => {\r\n  const [alertBoxTime, setAlertBoxTime] = useState(false);\r\n  const [days] = useState([0]);\r\n  const [popoverShow, setpopoverShow] = useState(false);\r\n  const [eventID] = useState(\"\");\r\n  const [event] = useState(\"\");\r\n  const [events, setEvents] = useState(myEventsList);\r\n  const [show, setShow] = useState(false);\r\n  let [startTime, setStartTime] = useState(\"\");\r\n  let [endTime, setEndTime] = useState(\"\");\r\n  let [starttimeslice, setstarttimeslice] = useState(\"\");\r\n  let [Endtimeslice, setEndtimeslice] = useState(\"\");\r\n  const [title, setTitle] = useState(\"\");\r\n  const [value, setValue] = useState(\"\");\r\n  const [statusColor, setStatusColor] = useState(\"#FFFF00\");\r\n  const [showEdit, setShowEdit] = useState(false);\r\n  const [titleEdit, setTitleEdit] = useState(\"\");\r\n  let [startTimeEdit, setStartTimeEdit] = useState(\"\");\r\n  let [endTimeEdit, setEndTimeEdit] = useState(\"\");\r\n  let [starttimesliceEdit, setstarttimesliceEdit] = useState(\"\");\r\n  let [endtimesliceEdit, setEndtimesliceEdit] = useState(\"\");\r\n  const [statusColorEdit, setStatusColorEdit] = useState(\"\");\r\n  const [bookingslot, setbookingslot] = useState(false);\r\n  const [bookingEvent, setbookingEvent] = useState();\r\n  const [bookingTitle, setBookingTitle] = useState();\r\n  let [bookingstartTime, setBookingstartTime] = useState(\"\");\r\n  let [bookingEndTime, setBookingEndTime] = useState(\"\");\r\n  let [bookingstartTimeslice, setBookingstartTimeslice] = useState(\"\");\r\n  let [bookingendTimeslice, setBookingendTimeslice] = useState(\"\");\r\n  const [startDate, setStartDate] = useState(\"\");\r\n  const [cdate, setCdate] = useState(\"\");\r\n  // const [statusbooking, setStatusbooking] = useState(\"#FFFF00\");\r\n  const [overlap] = React.useState(\"Enable\");\r\n  // const [overlapOpen, setoverlapOpen] = React.useState(false);\r\n  // overlap functions **************\r\n  // const handleOverLapChange = (event) => {\r\n  //   setoverlap(event.target.value);\r\n  // };\r\n  // const handleOverLapClose = () => {\r\n  //   setoverlapOpen(false);\r\n  // };\r\n  // const handleOverLapOpen = () => {\r\n  //   setoverlapOpen(true);\r\n  // };\r\n  const handleClose = () => setShow(false);\r\n  let work_week_obj = {\r\n    Sunday: true,\r\n    Monday: true,\r\n    Tuesday: true,\r\n    Wednesday: true,\r\n    Thursday: true,\r\n    Friday: true,\r\n    Saturday: true,\r\n  };\r\n  for (let i = 0; i < days.length; i++) {\r\n    if (days[i] === 0) {\r\n      work_week_obj.Sunday = false;\r\n    } else if (days[i] === 1) {\r\n      work_week_obj.Monday = false;\r\n    } else if (days[i] === 2) {\r\n      work_week_obj.Tuesday = false;\r\n    } else if (days[i] === 3) {\r\n      work_week_obj.Wednesday = false;\r\n    } else if (days[i] === 4) {\r\n      work_week_obj.Thursday = false;\r\n    } else if (days[i] === 5) {\r\n      work_week_obj.Friday = false;\r\n    } else if (days[i] === 6) {\r\n      work_week_obj.Saturday = false;\r\n    }\r\n  }\r\n  // const [workWeekstate, workWeekSetState] = useState(work_week_obj);\r\n  // const workWeekHandleChange = (event) => {\r\n  //   workWeekSetState({\r\n  //     ...workWeekstate,\r\n  //     [event.target.name]: event.target.checked,\r\n  //   });\r\n\r\n  //   // if (event.target.checked === true) {\r\n  //   //   setavailabilitieModal(true);\r\n  //   // }\r\n\r\n  //   // sunday Start\r\n  //   if (event.target.name === \"Sunday\" && event.target.checked === true) {\r\n  //     let remove = days.indexOf(0);\r\n  //     days.splice(remove, 1)
[],"C:\\Users\\HP\\Desktop\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\index.js",["395","396","397","398","399","400","401","402","403","404","405","406","407","408","409","410","411","412","413","414","415","416","417","418"],"import React, { useState } from \"react\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\nimport { Modal, Button, Alert, Row, Col } from \"react-bootstrap\";\r\nimport Radio from \"@material-ui/core/Radio\";\r\nimport RadioGroup from \"@material-ui/core/RadioGroup\";\r\nimport FormControlLabel from \"@material-ui/core/FormControlLabel\";\r\nimport FormControl from \"@material-ui/core/FormControl\";\r\nimport myEventsList from \"./components/events\";\r\nimport moment from \"moment\";\r\nimport { Calendar, momentLocalizer } from \"react-big-calendar\";\r\nimport \"react-big-calendar/lib/css/react-big-calendar.css\";\r\nimport PopoverModal from \"./components/popoverModal\";\r\nimport MyWorkWeek from \"./components/MyWorkWeek\";\r\nimport FormGroup from \"@material-ui/core/FormGroup\";\r\nimport Checkbox from \"@material-ui/core/Checkbox\";\r\nimport OverLapSelect from \"./components/overlapSelect\";\r\nimport CheckBoxOutlineBlankIcon from \"@material-ui/icons/CheckBoxOutlineBlank\";\r\nimport CheckBoxIcon from \"@material-ui/icons/CheckBox\";\r\nimport TimePicker from \"react-time-picker\";\r\nimport DateTimePicker from \"react-datetime-picker\";\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n}));\r\nlet view = {\r\n  month: true,\r\n  day: true,\r\n  work_week: MyWorkWeek,\r\n  agenda: true,\r\n};\r\n\r\nconst localizer = momentLocalizer(moment);\r\nconst ColoredDateCellWrapper = ({ children }) =>\r\n  React.cloneElement(React.Children.only(children), {\r\n    style: {\r\n      backgroundColor: \"#fff\",\r\n    },\r\n  });\r\n\r\nlet formats = {\r\n  dateFormat: \"DD\",\r\n  monthHeaderFormat: \"DD/MM/YYYY\",\r\n  dayHeaderFormat: \"DD/MM/YYYY\",\r\n  dayRangeHeaderFormat: \"DD/MM/YYYY\",\r\n  timeGutterFormat: (date, culture, localizer) =>\r\n    localizer.format(date, \"HH:mm\", culture),\r\n  eventTimeRangeFormat: ({ start, end }, culture, localizer) =>\r\n    localizer.format(start, \"HH:mm\") + \"-\" + localizer.format(end, \"HH:mm\"),\r\n};\r\n\r\nconst Calender = () => {\r\n  const classes = useStyles();\r\n  const [availabilitieModal, setavailabilitieModal] = useState(false);\r\n  const [alertBoxTime, setAlertBoxTime] = useState(false);\r\n  const [days, setDays] = useState([0]);\r\n  const [popoverShow, setpopoverShow] = useState(false);\r\n  const [eventID, seteventID] = useState(\"\");\r\n  const [event, setEvent] = useState(\"\");\r\n  const [events, setEvents] = useState(myEventsList);\r\n  const [show, setShow] = useState(false);\r\n  let [startTime, setStartTime] = useState(\"\");\r\n  let [endTime, setEndTime] = useState(\"\");\r\n  let [starttimeslice, setstarttimeslice] = useState(\"\");\r\n  let [Endtimeslice, setEndtimeslice] = useState(\"\");\r\n  const [title, setTitle] = useState(\"\");\r\n  const [value, setValue] = useState(\"\");\r\n  const [statusColor, setStatusColor] = useState(\"#FFFF00\");\r\n  const [showEdit, setShowEdit] = useState(false);\r\n  const [titleEdit, setTitleEdit] = useState(\"\");\r\n  let [startTimeEdit, setStartTimeEdit] = useState(\"\");\r\n  let [endTimeEdit, setEndTimeEdit] = useState(\"\");\r\n  let [starttimesliceEdit, setstarttimesliceEdit] = useState(\"\");\r\n  let [endtimesliceEdit, setEndtimesliceEdit] = useState(\"\");\r\n  const [statusColorEdit, setStatusColorEdit] = useState(\"\");\r\n  const [dayLayoutAlgorithm, setdayLayoutAlgorithm] = useState(\"no-overlap\");\r\n  const [bookingslot, setbookingslot] = useState(false);\r\n  const [bookingEvent, setbookingEvent] = useState();\r\n  const [bookingTitle, setBookingTitle] = useState();\r\n  let [bookingstartTime, setBookingstartTime] = useState(\"\");\r\n  let [bookingEndTime, setBookingEndTime] = useState(\"\");\r\n  let [bookingstartTimeslice, setBookingstartTimeslice] = useState(\"\");\r\n  let [bookingendTimeslice, setBookingendTimeslice] = useState(\"\");\r\n  const [statusbooking, setStatusbooking] = useState(\"#FFFF00\");\r\n  const [overlap, setoverlap] = React.useState(\"Enable\");\r\n  const [overlapOpen, setoverlapOpen] = React.useState(false);\r\n  // overlap functions **************\r\n  const handleOverLapChange = (event) => {\r\n    setoverlap(event.target.value);\r\n  };\r\n  const handleOverLapClose = () => {\r\n    setoverlapOpen(false);\r\n  };\r\n  const handleOverLapOpen = () => {\r\n    setoverlapOpen(true);\r\n  };\r\n  const handleClose = () => setShow(false);\r\n  let work_week_obj = {\r\n    Sunday: true,\r\n    Monday: true,\r\n    Tuesday: true,\r\n    Wednesday: true,\r\n    Thursday: true,\r\n    Friday: true,\r\n    Saturday: true,\r\n  };\r\n  for (let i = 0; i < days.length; i++) {\r\n    if (days[i] === 0) {\r\n      work_week_obj.Sunday = false;\r\n    } else if (days[i] === 1) {\r\n      work_week_obj.Monday = false;\r\n    } else if (days[i] === 2) {\r\n      work_week_obj.Tuesday = false;\r\n    } else if (days[i] === 3) {\r\n      work_week_obj.Wednesday = false;\r\n    } else if (days[i] === 4) {\r\n      work_week_obj.Thursday = false;\r\n    } else if (days[i] === 5) {\r\n      work_week_obj.Friday = false;\r\n    } else if (days[i] === 6) {\r\n      work_week_obj.Saturday = false;\r\n    }\r\n  }\r\n  const [workWeekstate, workWeekSetState] = useState(work_week_obj);\r\n  const workWeekHandleChange = (event) => {\r\n    workWeekSetState({\r\n      ...workWeekstate,\r\n      [event.target.name]: event.target.checked,\r\n    });\r\n\r\n    // if (event.target.checked === true) {\r\n    //   setavailabilitieModal(true);\r\n    // }\r\n\r\n    // sunday Start\r\n    if (event.target.name === \"Sunday\" && event.target.checked === true) {\r\n      let remove = days.indexOf(0);\r\n      days.splice(remove, 1);\r\n      days.sort();\r\n      setDays(days);\r\n      // setAvailibilityDateMin();\r\n    } else if (\r\n      event.target.name === \"Sunday\" &&\r\n      event.target.checked === false\r\n    ) {\r\n      days.push(0);\r\n      days.sort();\r\n      setDays(days);\r\n    }\r\n    // sunday End\r\n    // Monday Start\r\n    else if (event.target.name === \"Monday\" && event.target.checked === true) {\r\n      let remove = days.indexOf(1);\r\n      days.splice(remove, 1);\r\n      days.sort();\r\n      setDays(days);\r\n    } else if (\r\n      event.target.name === \"Monday\" &&\r\n      event.target.checked === false\r\n    ) {\r\n      days.push(1);\r\n      days.sort();\r\n      setDays(days);\r\n    }\r\n    // Monday End\r\n    // Tuesday Start\r\n    else if (event.target.name === \"Tuesday\" && event.target.checked === true) {\r\n      let remove = days.indexOf(2);\r\n      days.splice(remove, 1);\r\n      days.sort();\r\n      setDays(days);\r\n    } else if (\r\n      event.target.name === \"Tuesday\" &&\r\n      event.target.checked === false\r\n    ) {\r\n      days.push(2);\r\n      days.sort();\r\n      setDays(days);\r\n    }\r\n    // Tuesday End\r\n    // Wednesday Start\r\n    else if (\r\n      event.target.name === \"Wednesday\" &&\r\n      event.target.checked === true\r\n    ) {\r\n      let remove = days.indexOf(3);\r\n      days.splice(remove, 1);\r\n      days.sort();\r\n      setDays(days);\r\n    } else if (\r\n      event.target.name === \"Wednesday\" &&\r\n      event.target.checked === false\r\n    ) {\r\n      days.push(3);\r\n      days.sort();\r\n      setDays(days);\r\n    }\r\n    // Wednesday End\r\n    // Thursday Start\r\n    else if (\r\n      event.target.name === \"Thursday\" &&\r\n      event.target.checked === true\r\n    ) {\r\n      let remove = days.indexOf(4);\r\n      days.splice(remove, 1);\r\n      days.sort();\r\n      setDays(days);\r\n    } else if (\r\n      event.target.name === \"Thursday\" &&\r\n      event.target.checked === false\r\n    ) {\r\n      days.push(4);\r\n      days.sort();\r\n      setDays(days);\r\n    }\r\n    // Thursday End\r\n    // Friday Start\r\n    else if (event.target.name === \"Friday\" && event.target.checked === true) {\r\n      let remove = days.indexOf(5);\r\n      days.splice(remove, 1);\r\n      days.sort();\r\n      setDays(days);\r\n    } else if (\r\n      event.target.name === \"Friday\" &&\r\n      event.target.checked === false\r\n    ) {\r\n      days.push(5);\r\n      days.sort();\r\n      setDays(days);\r\n    }\r\n    // Friday End\r\n    // Saturday Start\r\n    else if (\r\n      event.target.name === \"Saturday\" &&\r\n      event.target.checked === true\r\n    ) {\r\n      let remove = days.indexOf(6);\r\n      days.splice(remove, 1);\r\n      days.sort();\r\n      setDays(days);\r\n    } else if (\r\n      event.target.name === \"Saturday\" &&\r\n      event.target.checked === false\r\n    ) {\r\n      days.push(6);\r\n      days.sort();\r\n      setDays(days);\r\n    }\r\n    // Saturday End\r\n  };\r\n  const updateEvent = () => {\r\n    if (titleEdit !== \"\") {\r\n      /* start time*/\r\n      startTimeEdit = String(startTimeEdit);\r\n      starttimesliceEdit = String(starttimesliceEdit);\r\n      startTimeEdit = Array.from(startTimeEdit);\r\n      starttimesliceEdit = Array.from(starttimesliceEdit);\r\n      startTimeEdit[16] = starttimesliceEdit[0];\r\n      startTimeEdit[17] = starttimesliceEdit[1];\r\n      startTimeEdit[18] = starttimesliceEdit[2];\r\n      startTimeEdit[19] = starttimesliceEdit[3];\r\n      startTimeEdit[20] = starttimesliceEdit[4];\r\n      startTimeEdit = String(startTimeEdit);\r\n      startTimeEdit = startTimeEdit.replace(/,/g, \"\");\r\n      startTimeEdit = new Date(startTimeEdit);\r\n      /* start time*/\r\n      /* End time*/\r\n      endTimeEdit = String(endTimeEdit);\r\n      endtimesliceEdit = String(endtimesliceEdit);\r\n      endTimeEdit = Array.from(endTimeEdit);\r\n      endtimesliceEdit = Array.from(endtimesliceEdit);\r\n      endTimeEdit[16] = endtimesliceEdit[0];\r\n      endTimeEdit[17] = endtimesliceEdit[1];\r\n      endTimeEdit[18] = endtimesliceEdit[2];\r\n      endTimeEdit[19] = endtimesliceEdit[3];\r\n      endTimeEdit[20] = endtimesliceEdit[4];\r\n      endTimeEdit = String(endTimeEdit);\r\n      endTimeEdit = endTimeEdit.replace(/,/g, \"\");\r\n      endTimeEdit = new Date(endTimeEdit);\r\n      /* End time*/\r\n\r\n      let preDateTime = new Date();\r\n      let milliseconds = Date.parse(preDateTime);\r\n      milliseconds = milliseconds - 1 * 60 * 1000;\r\n      preDateTime = new Date(milliseconds);\r\n      if (startTimeEdit > preDateTime && startTimeEdit < endTimeEdit) {\r\n        const updateElement = events.filter((e) => e.id == eventID);\r\n        updateElement[0].title = titleEdit;\r\n        updateElement[0].start = startTimeEdit;\r\n        updateElement[0].end = endTimeEdit;\r\n        updateElement[0].color = statusColorEdit;\r\n        setEvents([...events, updateElement]);\r\n        setTitleEdit(\"\");\r\n        setShowEdit(false);\r\n      } else {\r\n        setAlertBoxTime(true);\r\n        setTimeout(function () {\r\n          setAlertBoxTime(false);\r\n        }, 2000);\r\n      }\r\n    } else {\r\n      setAlertBoxTime(true);\r\n      setTimeout(function () {\r\n        setAlertBoxTime(false);\r\n      }, 2000);\r\n    }\r\n  };\r\n  const saveEvent = () => {\r\n    if (title !== \"\") {\r\n      /* start time*/\r\n      startTime = String(startTime);\r\n      starttimeslice = String(starttimeslice);\r\n      startTime = Array.from(startTime);\r\n      starttimeslice = Array.from(starttimeslice);\r\n      startTime[16] = starttimeslice[0];\r\n      startTime[17] = starttimeslice[1];\r\n      startTime[18] = starttimeslice[2];\r\n      startTime[19] = starttimeslice[3];\r\n      startTime[20] = starttimeslice[4];\r\n      startTime = String(startTime);\r\n      startTime = startTime.replace(/,/g, \"\");\r\n      startTime = new Date(startTime);\r\n\r\n      /* start time*/\r\n      /* End time*/\r\n      endTime = String(endTime);\r\n      Endtimeslice = String(Endtimeslice);\r\n      endTime = Array.from(endTime);\r\n      Endtimeslice = Array.from(Endtimeslice);\r\n      endTime[16] = Endtimeslice[0];\r\n      endTime[17] = Endtimeslice[1];\r\n      endTime[18] = Endtimeslice[2];\r\n      endTime[19] = Endtimeslice[3];\r\n      endTime[20] = Endtimeslice[4];\r\n      endTime = String(endTime);\r\n      endTime = endTime.replace(/,/g, \"\");\r\n      endTime = new Date(endTime);\r\n      /* End time*/\r\n      let beforeTime = moment(startTime).format(\"DD/MM/YYYY HH:mm\");\r\n      let afterTime = moment(endTime).format(\"DD/MM/YYYY HH:mm\");\r\n      let dateCheck1 = events.find((item) => {\r\n        return (\r\n          moment(item.start).format(\"DD/MM/YYYY HH:mm\") == beforeTime ||\r\n          moment(item.end).format(\"DD/MM/YYYY HH:mm\") == afterTime\r\n        );\r\n      });\r\n\r\n      let dateCheck2 = events.findIndex((item) => {\r\n        return startTime > item.start;\r\n      });\r\n      let dateCheck3 = events.findIndex((item) => {\r\n        return startTime > item.end;\r\n      });\r\n\r\n      let uniqid = Math.random();\r\n\r\n      /*check not in previous day  Start */\r\n      let preDateTime = new Date();\r\n      let milliseconds = Date.parse(preDateTime);\r\n      milliseconds = milliseconds - 1 * 60 * 1000;\r\n      preDateTime = new Date(milliseconds);\r\n      /*check not in previous day End  */\r\n\r\n      if (startTime > preDateTime && startTime < endTime) {\r\n        if (overlap == \"Enable\") {\r\n          setShow(false);\r\n          const newElement = {\r\n            id: uniqid,\r\n            title: title,\r\n            start: startTime,\r\n            end: endTime,\r\n            color: statusColor,\r\n          };\r\n          setEvents([...events, newElement]);\r\n          setTitle(\"\");\r\n        } else if (\r\n          overlap == \"Disable\" &&\r\n          dateCheck2 !== -1 &&\r\n          dateCheck3 !== -1 &&\r\n          dateCheck1 !== undefined\r\n        ) {\r\n          setAlertBoxTime(true);\r\n          setTimeout(function () {\r\n            setAlertBoxTime(false);\r\n          }, 1000);\r\n        } else {\r\n          setShow(false);\r\n          const newElement = {\r\n            id: uniqid,\r\n            title: title,\r\n            start: startTime,\r\n            end: endTime,\r\n            color: statusColor,\r\n          };\r\n          setEvents([...events, newElement]);\r\n          setTitle(\"\");\r\n        }\r\n      } else {\r\n        setAlertBoxTime(true);\r\n        setTimeout(function () {\r\n          setAlertBoxTime(false);\r\n        }, 1000);\r\n      }\r\n    } else {\r\n      setAlertBoxTime(true);\r\n      setTimeout(function () {\r\n        setAlertBoxTime(false);\r\n      }, 1000);\r\n    }\r\n  };\r\n  const AddEvent = ({ start, end, slots }) => {\r\n    setAlertBoxTime(false);\r\n    let preDateTime = new Date();\r\n    let milliseconds = Date.parse(preDateTime);\r\n    milliseconds = milliseconds - 1 * 60 * 1000;\r\n    preDateTime = new Date(milliseconds);\r\n\r\n    if (\r\n      start.getDay() === days[0] ||\r\n      start.getDay() === days[1] ||\r\n      start.getDay() === days[2] ||\r\n      start.getDay() === days[3] ||\r\n      start.getDay() === days[4] ||\r\n      start.getDay() === days[5] ||\r\n      start.getDay() === days[6]\r\n    ) {\r\n      console.log(\"not active day\");\r\n    } else {\r\n      // active days\r\n      let beforeTime = moment(start).format(\"HH:mm\");\r\n      let afterTime = moment(end).format(\"HH:mm\");\r\n      let dateCheck = events.filter((item) => {\r\n        return (\r\n          moment(item.start).format(\"DD/MM/YYYY HH:mm\") === beforeTime &&\r\n          moment(item.end).format(\"DD/MM/YYYY HH:mm\") === afterTime\r\n        );\r\n      });\r\n      if (dateCheck.length == 0 && overlap) {\r\n        if (start > preDateTime && start < end) {\r\n          if (slots.length >= 2) {\r\n            var format = \"HH:mm\";\r\n            let time = moment(start, format);\r\n            let beforeTime = moment(start).format(\"HH:mm\");\r\n            let afterTime = moment(end).format(\"HH:mm\");\r\n            let checkDiff = time.isBetween(beforeTime, afterTime);\r\n            if (\r\n              beforeTime !== \"17:00\" &&\r\n              beforeTime !== \"17:30\" &&\r\n              checkDiff == false\r\n            ) {\r\n              setShow(!show);\r\n              setStartTime(start);\r\n              setEndTime(end);\r\n              let getstart = String(start);\r\n              let getend = String(end);\r\n              getstart = getstart.slice(16, 21);\r\n              getend = getend.slice(16, 21);\r\n              setstarttimeslice(getstart);\r\n              setEndtimeslice(getend);\r\n            } else {\r\n              return false;\r\n            }\r\n          } else {\r\n            setShow(!show);\r\n            setStartTime(start);\r\n            setEndTime(end);\r\n            let getstart = String(start);\r\n            let getend = String(end);\r\n            getstart = getstart.slice(16, 21);\r\n            getend = getend.slice(16, 21);\r\n            setstarttimeslice(getstart);\r\n            setEndtimeslice(getend);\r\n          }\r\n        } else {\r\n          setAlertBoxTime(true);\r\n          setTimeout(function () {\r\n            setAlertBoxTime(false);\r\n          }, 2000);\r\n          // console.log(\"disable time clicked\");\r\n        }\r\n      } else {\r\n        console.log(\"disable time clicked\");\r\n      }\r\n    }\r\n  };\r\n  const AddAvailability = ({ start, end }) => {};\r\n  const statusColorChange = (event) => {\r\n    setValue(event.target.value);\r\n  };\r\n  const handlePopoverClose = () => setpopoverShow(false);\r\n  const handleEditEvent = () => {\r\n    setpopoverShow(!popoverShow);\r\n    setShowEdit(true);\r\n    setAlertBoxTime(false);\r\n    const fill = events.filter((e) => e.id === eventID);\r\n    setTitleEdit(fill[0].title);\r\n    let getstart = String(fill[0].start);\r\n    let getend = String(fill[0].end);\r\n    setStartTimeEdit(getstart);\r\n    setEndTimeEdit(getend);\r\n    setStatusColorEdit(fill[0].color);\r\n    // Start slice a time\r\n    getstart = getstart.slice(16, 21);\r\n    getend = getend.slice(16, 21);\r\n    setstarttimesliceEdit(getstart);\r\n    setEndtimesliceEdit(getend);\r\n    // End slice a time\r\n  };\r\n  const handleDeleteEvent = () => {\r\n    const fill = events.filter((e) => e.id != eventID);\r\n    setEvents(fill);\r\n    setpopoverShow(!popoverShow);\r\n  };\r\n  const handlePopoverShow = (event) => {\r\n    // admin code Start\r\n    seteventID(event.id);\r\n    const fill = events.filter((e) => e.id === event.id);\r\n    setEvent(fill[0]);\r\n    setpopoverShow(!popoverShow);\r\n    // admin code end\r\n  };\r\n  const bookingSlot = (event) => {\r\n    // booking Event\r\n    setbookingslot(true);\r\n    const fill = events.filter((e) => e.id === event.id);\r\n    setbookingEvent(fill[0]);\r\n    setBookingstartTime(fill[0].start);\r\n    setBookingEndTime(fill[0].end);\r\n\r\n    /* show time start */\r\n    let getstart = String(fill[0].start);\r\n    let getend = String(fill[0].end);\r\n    getstart = getstart.slice(16, 21);\r\n    getend = getend.slice(16, 21);\r\n\r\n    setBookingstartTimeslice(getstart);\r\n    setBookingendTimeslice(getend);\r\n    /* show time End  */\r\n  };\r\n  const saveBooking = () => {\r\n    /* start time*/\r\n    bookingstartTime = String(bookingstartTime);\r\n    bookingstartTimeslice = String(bookingstartTimeslice);\r\n    bookingstartTime = Array.from(bookingstartTime);\r\n    bookingstartTimeslice = Array.from(bookingstartTimeslice);\r\n    bookingstartTime[16] = bookingstartTimeslice[0];\r\n    bookingstartTime[17] = bookingstartTimeslice[1];\r\n    bookingstartTime[18] = bookingstartTimeslice[2];\r\n    bookingstartTime[19] = bookingstartTimeslice[3];\r\n    bookingstartTime[20] = bookingstartTimeslice[4];\r\n    bookingstartTime = String(bookingstartTime);\r\n    bookingstartTime = bookingstartTime.replace(/,/g, \"\");\r\n    bookingstartTime = new Date(bookingstartTime);\r\n    /* start time*/\r\n    /* End  time*/\r\n    bookingEndTime = String(bookingEndTime);\r\n    bookingendTimeslice = String(bookingendTimeslice);\r\n    bookingEndTime = Array.from(bookingEndTime);\r\n    bookingendTimeslice = Array.from(bookingendTimeslice);\r\n    bookingEndTime[16] = bookingendTimeslice[0];\r\n    bookingEndTime[17] = bookingendTimeslice[1];\r\n    bookingEndTime[18] = bookingendTimeslice[2];\r\n    bookingEndTime[19] = bookingendTimeslice[3];\r\n    bookingEndTime[20] = bookingendTimeslice[4];\r\n    bookingEndTime = String(bookingEndTime);\r\n    bookingEndTime = bookingEndTime.replace(/,/g, \"\");\r\n    bookingEndTime = new Date(bookingEndTime);\r\n    /* End time*/\r\n    let uniqid = Math.random();\r\n    const newElement = {\r\n      p_id: bookingEvent.id,\r\n      id: uniqid,\r\n      title: bookingTitle,\r\n      start: bookingstartTime,\r\n      end: bookingEndTime,\r\n      color: statusbooking,\r\n    };\r\n    if (\r\n      bookingEvent.start <= bookingstartTime &&\r\n      bookingEvent.end >= bookingEndTime\r\n    ) {\r\n      console.log(\"Add time in array \");\r\n    } else {\r\n      setAlertBoxTime(true);\r\n      setTimeout(function () {\r\n        setAlertBoxTime(false);\r\n      }, 1000);\r\n    }\r\n  };\r\n  const statusBookingChange = (event) => {\r\n    setStatusbooking(event.target.value);\r\n  };\r\n  function Alertbox(props) {\r\n    return (\r\n      <Alert\r\n        show={alertBoxTime}\r\n        variant=\"danger\"\r\n        onClose={() => setAlertBoxTime(!alertBoxTime)}\r\n        dismissible\r\n      >\r\n        {props.message}\r\n      </Alert>\r\n    );\r\n  }\r\n  const customDayPropGetter = (date) => {\r\n    // console.log(getWeekDay(new Date()));\r\n\r\n    if (\r\n      date.getDay() === days[0] ||\r\n      date.getDay() === days[1] ||\r\n      date.getDay() === days[2] ||\r\n      date.getDay() === days[3] ||\r\n      date.getDay() === days[4] ||\r\n      date.getDay() === days[5] ||\r\n      date.getDay() === days[6]\r\n    )\r\n      return {\r\n        className: \"special-day\",\r\n        style: {\r\n          backgroundColor: \"#EBEBE4\",\r\n        },\r\n      };\r\n    else return {};\r\n  };\r\n  return (\r\n    <>\r\n      <div className=\"row \">\r\n        <div className=\"col-md-2\"></div>\r\n        <div className=\"col-md-2\"></div>\r\n        <div className=\"col-md-2\"></div>\r\n        <div className=\"col-md-6\">\r\n          <div\r\n            style={{\r\n              display: \"flex\",\r\n              \"flex-direction\": \"row\",\r\n              \"margin-top\": \"10px\",\r\n              \"align-items\": \"center\",\r\n              \"margin-bottom\": \"10px\",\r\n            }}\r\n          >\r\n            <span\r\n              style={{\r\n                \"background-color\": \"#FFFF00\",\r\n                height: \"20px\",\r\n                width: \"20px\",\r\n              }}\r\n            ></span>\r\n            <span style={{ \"margin-left\": \"10px\" }}>Pending validation</span>\r\n            <span\r\n              style={{\r\n                \"background-color\": \"#808080\",\r\n                height: \"20px\",\r\n                width: \"20px\",\r\n                \"margin-left\": \"10px\",\r\n              }}\r\n            ></span>\r\n            <span style={{ \"margin-left\": \"10px\" }}>Not availble</span>\r\n            <span\r\n              style={{\r\n                \"background-color\": \"#008000\",\r\n                height: \"20px\",\r\n                width: \"20px\",\r\n                \"margin-left\": \"10px\",\r\n              }}\r\n            ></span>\r\n            <span style={{ \"margin-left\": \"10px\" }}>Validate</span>\r\n            {/* <Button\r\n              variant=\"primary\"\r\n              style={{ \"margin-left\": \"auto\", \"margin-right\": \"10px\" }}\r\n              onClick={() => {\r\n                setavailabilitieModal(true);\r\n              }}\r\n            >\r\n              Add Availability\r\n            </Button> */}\r\n            <div style={{ \"margin-left\": \"auto\", \"margin-right\": \"10px\" }}>\r\n              <OverLapSelect\r\n                overlap={overlap}\r\n                overlapOpen={overlapOpen}\r\n                handleOpen={handleOverLapOpen}\r\n                handleClose={handleOverLapClose}\r\n                handleChange={handleOverLapChange}\r\n              />\r\n            </div>\r\n          </div>\r\n          <div className=\"Custom_weekdays\">\r\n            <label>Work week</label>\r\n            <FormGroup row>\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Sunday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Sunday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Sunday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Monday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Monday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Monday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Tuesday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Tuesday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Tuesday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Wednesday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Wednesday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Wednesday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Thursday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Thursday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Thursday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Friday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Friday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Friday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Saturday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Saturday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Saturday\"\r\n              />\r\n            </FormGroup>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Modal show={bookingslot} onHide={() => setbookingslot(false)}>\r\n        <Modal.Header closeButton>\r\n          <Modal.Title>Book a slot</Modal.Title>\r\n        </Modal.Header>\r\n        <Alertbox message=\"Invalid Time\" />\r\n        <Modal.Body>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-12\">\r\n              <div className=\"description\">\r\n                <div class=\"form-group\">\r\n                  <label for=\"exampleFormControlTextarea1\">Add message</label>\r\n                  <textarea\r\n                    class=\"form-control\"\r\n                    id=\"exampleFormControlTextarea1\"\r\n                    rows=\"3\"\r\n                    value={bookingTitle}\r\n                    onChange={(e) => setBookingTitle(e.target.value)}\r\n                  ></textarea>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-6\">\r\n              <div className=\"starttime\">\r\n                <label>Start time</label>\r\n                <TimePicker\r\n                  value={bookingstartTimeslice}\r\n                  onChange={(e) => setBookingstartTimeslice(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n              <div class=\"form-group statusColor\">\r\n                <label>Status Color </label>\r\n\r\n                <FormControl component=\"fieldset\">\r\n                  <RadioGroup\r\n                    aria-label=\"statusColor\"\r\n                    name=\"statusColor\"\r\n                    value={statusbooking}\r\n                    onChange={statusBookingChange}\r\n                  >\r\n                    <FormControlLabel\r\n                      value=\"#FFFF00\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusbooking(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Pending validation\"\r\n                      className=\"pending\"\r\n                    />\r\n\r\n                    <FormControlLabel\r\n                      value=\"#808080\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusbooking(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Not availble\"\r\n                      className=\"notAvailble\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#008000\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusbooking(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Validate\"\r\n                      className=\"validate\"\r\n                    />\r\n                  </RadioGroup>\r\n                </FormControl>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-md-6\">\r\n              <div className=\"endTime\">\r\n                <label>End Time</label>\r\n                <TimePicker\r\n                  value={bookingendTimeslice}\r\n                  onChange={(e) => setBookingendTimeslice(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </Modal.Body>\r\n        <Modal.Footer>\r\n          <Button variant=\"primary\" onClick={saveBooking}>\r\n            Add Booking\r\n          </Button>\r\n          <Button variant=\"secondary\" onClick={() => setbookingslot(false)}>\r\n            Close\r\n          </Button>\r\n        </Modal.Footer>\r\n      </Modal>\r\n      <Modal show={show} onHide={() => setShow(false)}>\r\n        <Modal.Header closeButton>\r\n          <Modal.Title>Add Event</Modal.Title>\r\n        </Modal.Header>\r\n        <Alertbox message=\"Please Add valid Time and Event\" />\r\n        <Modal.Body>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-12\">\r\n              <div className=\"description\">\r\n                <div class=\"form-group\">\r\n                  <label for=\"exampleFormControlTextarea1\">Add Event</label>\r\n                  <textarea\r\n                    class=\"form-control\"\r\n                    id=\"exampleFormControlTextarea1\"\r\n                    rows=\"3\"\r\n                    onChange={(e) => setTitle(e.target.value)}\r\n                  ></textarea>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-6\">\r\n              <div className=\"starttime\">\r\n                <label>Start time</label>\r\n                <TimePicker\r\n                  value={starttimeslice}\r\n                  onChange={(e) => setstarttimeslice(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n              <div class=\"form-group statusColor\">\r\n                <label>Status Color </label>\r\n                <FormControl component=\"fieldset\">\r\n                  <RadioGroup\r\n                    aria-label=\"gender\"\r\n                    name=\"statusColor\"\r\n                    value={statusColor}\r\n                    onChange={statusColorChange}\r\n                  >\r\n                    <FormControlLabel\r\n                      value=\"#FFFF00\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColor(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Pending validation\"\r\n                      className=\"pending\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#808080\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColor(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Not availble\"\r\n                      className=\"notAvailble\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#008000\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColor(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Validate\"\r\n                      className=\"validate\"\r\n                    />\r\n                  </RadioGroup>\r\n                </FormControl>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-md-6\">\r\n              <div className=\"endTime\">\r\n                <label>End Time</label>\r\n                <TimePicker\r\n                  value={Endtimeslice}\r\n                  onChange={(e) => setEndtimeslice(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </Modal.Body>\r\n        <Modal.Footer>\r\n          <Button variant=\"primary\" onClick={saveEvent}>\r\n            Save Event\r\n          </Button>\r\n          <Button variant=\"secondary\" onClick={handleClose}>\r\n            Close\r\n          </Button>\r\n        </Modal.Footer>\r\n      </Modal>\r\n      <Modal show={showEdit} onHide={() => setShowEdit(false)}>\r\n        <Modal.Header closeButton>\r\n          <Modal.Title>Edit Event </Modal.Title>\r\n        </Modal.Header>\r\n        <Alertbox message=\"Please Add valid Time and Event\" />\r\n        <Modal.Body>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-12\">\r\n              <div className=\"description\">\r\n                <div class=\"form-group\">\r\n                  <label for=\"exampleFormControlTextarea1\">Edit Event</label>\r\n                  <textarea\r\n                    class=\"form-control\"\r\n                    id=\"exampleFormControlTextarea1\"\r\n                    rows=\"3\"\r\n                    value={titleEdit}\r\n                    onChange={(e) => setTitleEdit(e.target.value)}\r\n                  ></textarea>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-6\">\r\n              <div className=\"starttime\">\r\n                <label>Start time</label>\r\n                <TimePicker\r\n                  value={starttimesliceEdit}\r\n                  onChange={(e) => setstarttimesliceEdit(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n              <div class=\"form-group statusColor\">\r\n                <label>Status Color </label>\r\n                <FormControl component=\"fieldset\">\r\n                  <RadioGroup\r\n                    aria-label=\"statusColor\"\r\n                    name=\"statusColor\"\r\n                    value={statusColorEdit}\r\n                    onChange={statusColorChange}\r\n                  >\r\n                    <FormControlLabel\r\n                      value=\"#FFFF00\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColorEdit(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Pending validation\"\r\n                      className=\"pending\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#808080\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColorEdit(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Not availble\"\r\n                      className=\"notAvailble\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#008000\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColorEdit(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Validate\"\r\n                      className=\"validate\"\r\n                    />\r\n                  </RadioGroup>\r\n                </FormControl>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-md-6\">\r\n              <div className=\"endTime\">\r\n                <label>End Time</label>\r\n                <TimePicker\r\n                  value={endtimesliceEdit}\r\n                  onChange={(e) => setEndtimesliceEdit(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </Modal.Body>\r\n        <Modal.Footer>\r\n          <Button variant=\"primary\" onClick={updateEvent}>\r\n            Update Event\r\n          </Button>\r\n          <Button variant=\"secondary\" onClick={() => setShowEdit(false)}>\r\n            Close\r\n          </Button>\r\n        </Modal.Footer>\r\n      </Modal>\r\n\r\n      <div>\r\n        <PopoverModal\r\n          popoverShow={popoverShow}\r\n          handlePopoverClose={handlePopoverClose}\r\n          handleDeleteEvent={handleDeleteEvent}\r\n          handleEditEvent={handleEditEvent}\r\n          event={event}\r\n        />\r\n\r\n        <Calendar\r\n          popup\r\n          selectable\r\n          formats={formats}\r\n          localizer={localizer}\r\n          events={events}\r\n          views={view}\r\n          step={60}\r\n          timeslots={1}\r\n          // onSelectEvent={handlePopoverShow}\r\n          onSelectEvent={bookingSlot}\r\n          onSelecting={false}\r\n          onSelectSlot={AddEvent}\r\n          // onSelectSlot={AddAvailability}\r\n          startAccessor=\"start\"\r\n          endAccessor=\"end\"\r\n          style={{\r\n            width: \"99%\",\r\n            padding: \"0px 10px\",\r\n            height: \"470px\",\r\n          }}\r\n          eventPropGetter={(events, start, end, isSelected) => {\r\n            let newStyle = {\r\n              backgroundColor: events[\"color\"],\r\n              color: \"black\",\r\n              borderRadius: \"0px\",\r\n              border: \"none\",\r\n            };\r\n\r\n            if (events.isMine) {\r\n              newStyle.backgroundColor = \"lightgreen\";\r\n            }\r\n\r\n            return {\r\n              className: \"\",\r\n              style: newStyle,\r\n            };\r\n          }}\r\n          messages={{\r\n            date: \"Date\",\r\n            time: \"Time\",\r\n            event: \"Event\",\r\n            allDay: \"All Day\",\r\n            week: \"week\",\r\n            work_week: \"Work Week\",\r\n            day: \"Day\",\r\n            month: \"Month\",\r\n            previous: \"Previous\",\r\n            next: \"Next\",\r\n            yesterday: \"Yesterday\",\r\n            tomorrow: \"Tomorrow\",\r\n            today: \"Today\",\r\n            agenda: \"Agenda\",\r\n            noEventsInRange: \"There are no events in this range.\",\r\n            showMore: function (e) {\r\n              return \"+\" + e + \" more\";\r\n            },\r\n          }}\r\n          custom_week_days={days}\r\n          dayPropGetter={customDayPropGetter}\r\n        />\r\n      </div>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default Calender;\r\n","C:\\Users\\HP\\Desktop\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\events.js",["419"],"export default [\r\n  {\r\n    id: 0,\r\n    title: \"All Day Event very long title\",\r\n    allDay: true,\r\n    start: new Date(),\r\n    end: new Date(),\r\n    color: \"#008000\",\r\n  },\r\n  {\r\n    id: 1,\r\n    title: \"Long Event\",\r\n    start: new Date(2021, 2, 24),\r\n    end: new Date(),\r\n    color: \"#FFFF00\",\r\n  },\r\n  {\r\n    id: 2,\r\n    title: \"mubashar is testing an event\",\r\n    start: new Date(),\r\n    end: new Date(),\r\n    color: \"#808080\",\r\n  },\r\n  {\r\n    id: 3,\r\n    title: \"Big Calendar testing an event\",\r\n    start: new Date(),\r\n    end: new Date(),\r\n    color: \"#008000\",\r\n  },\r\n];\r\n","C:\\Users\\HP\\Desktop\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\popoverModal.js",["420","421","422","423","424"],"import React from \"react\";\r\nimport { FontAwesomeIcon } from \"@fortawesome/react-fontawesome\";\r\nimport Modal from \"react-bootstrap/Modal\";\r\nimport Button from \"react-bootstrap/Button\";\r\nimport Card from \"react-bootstrap/Card\";\r\nimport moment from \"moment\";\r\nimport \"./sass/custom.scss\";\r\nvar days = [\r\n  \"Sunday\",\r\n  \"Monday\",\r\n  \"Tuesday\",\r\n  \"Wednesday\",\r\n  \"Thursday\",\r\n  \"Friday\",\r\n  \"Saturday\",\r\n];\r\nconst PopoverModal = ({\r\n  popoverShow,\r\n  handlePopoverClose,\r\n  handleDeleteEvent,\r\n  handleEditEvent,\r\n  event,\r\n}) => {\r\n  const getStartDate = (start) => {\r\n    var start = start;\r\n    var dd = String(start.getDate()).padStart(2, \"0\");\r\n    var mm = String(start.getMonth() + 1).padStart(2, \"0\"); //January is 0!\r\n    var yyyy = start.getFullYear();\r\n    start = mm + \"/\" + dd + \"/\" + yyyy;\r\n    return start;\r\n  };\r\n\r\n  const getStartTime = (date) => {\r\n    var dt = moment(date, [\"h:mm A\"]).format(\"HH:mm\");\r\n    return dt;\r\n  };\r\n  if (event) {\r\n    return (\r\n      <Modal show={popoverShow} onHide={handlePopoverClose}>\r\n        <Modal.Header closeButton>\r\n          <Modal.Title>Event Detail </Modal.Title>\r\n        </Modal.Header>\r\n        <Modal.Body>\r\n          <div className=\"showPopover\">\r\n            <h5>{event.title}</h5>\r\n            {/* {console.log(event)} */}\r\n            <p>\r\n              {/* {event.start.getDay()}-{event.start.getMonth() + 1}-\r\n                {event.start.getYear()} */}\r\n              <h6 style={{ \"font-size\": \"12px\", \"padding-top\": \"10px\" }}>\r\n                <span>\r\n                  <b>Start Time:</b> {getStartTime(event.start)}{\" \"}\r\n                </span>{\" \"}\r\n                <span>{getStartDate(event.start)}</span>\r\n                <br />\r\n                <span>\r\n                  <b>End Time:</b> {getStartTime(event.end)}{\" \"}\r\n                </span>{\" \"}\r\n                <span>{getStartDate(event.end)}</span>\r\n              </h6>\r\n            </p>\r\n\r\n            <hr />\r\n            <div className=\"popoverfooter\">\r\n              <div className=\"col-lg-6\">\r\n                <button\r\n                  className=\"btn text-white bg-primary\"\r\n                  onClick={handleEditEvent}\r\n                >\r\n                  <i class=\"fas fa-pencil\"></i> <span>edit</span>\r\n                </button>\r\n              </div>\r\n              <div className=\"col-lg-6\">\r\n                <button\r\n                  className=\"btn text-white bg-danger\"\r\n                  onClick={handleDeleteEvent}\r\n                >\r\n                  <i class=\"fas fa-trash\"></i> <span>Delete</span>\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </Modal.Body>\r\n      </Modal>\r\n    );\r\n  } else {\r\n    return \"\";\r\n  }\r\n};\r\nexport default PopoverModal;\r\n","C:\\Users\\HP\\Desktop\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\MyWorkWeek.js",["425"],"import PropTypes from \"prop-types\";\r\nimport React from \"react\";\r\nimport Week from \"react-big-calendar/lib/Week\";\r\nimport TimeGrid from \"react-big-calendar/lib/TimeGrid\";\r\n\r\nfunction workWeekRange(date, options, custom_week_days) {\r\n  if (custom_week_days == undefined) {\r\n    return Week.range(date, options).filter(\r\n      (d) => [0, 1].indexOf(d.getDay()) === -1\r\n    );\r\n  } else {\r\n    return Week.range(date, options).filter(\r\n      (d) => custom_week_days.indexOf(d.getDay()) === -1\r\n    );\r\n  }\r\n}\r\n\r\nclass MyWorkWeek extends React.Component {\r\n  render() {\r\n    let { custom_week_days, date, ...props } = this.props;\r\n    let range = workWeekRange(date, this.props, custom_week_days);\r\n    return <TimeGrid {...props} range={range} eventOffset={15} />;\r\n  }\r\n}\r\n\r\nMyWorkWeek.propTypes = {\r\n  date: PropTypes.instanceOf(Date).isRequired,\r\n};\r\n\r\nMyWorkWeek.defaultProps = TimeGrid.defaultProps;\r\n\r\nMyWorkWeek.range = workWeekRange;\r\n\r\nMyWorkWeek.navigate = Week.navigate;\r\n\r\nMyWorkWeek.title = (date, { localizer }) => {\r\n  let [start, ...rest] = workWeekRange(date, { localizer });\r\n  return localizer.format({ start, end: rest.pop() }, \"dayRangeHeaderFormat\");\r\n};\r\nexport default MyWorkWeek;\r\n","C:\\Users\\HP\\Desktop\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\overlapSelect.js",["426"],"import React from \"react\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport InputLabel from \"@material-ui/core/InputLabel\";\r\nimport MenuItem from \"@material-ui/core/MenuItem\";\r\nimport FormControl from \"@material-ui/core/FormControl\";\r\nimport Select from \"@material-ui/core/Select\";\r\nimport Button from \"@material-ui/core/Button\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  button: {\r\n    display: \"block\",\r\n    marginTop: theme.spacing(0),\r\n  },\r\n  formControl: {\r\n    minWidth: 170,\r\n    marginTop: theme.spacing(-2),\r\n  },\r\n}));\r\n\r\nexport default function ControlledOpenSelect({\r\n  overlap,\r\n  overlapOpen,\r\n  handleOpen,\r\n  handleClose,\r\n  handleChange,\r\n}) {\r\n  const classes = useStyles();\r\n\r\n  return (\r\n    <div>\r\n      <FormControl className={classes.formControl}>\r\n        <InputLabel id=\"demo-controlled-open-select-label\">Overlap</InputLabel>\r\n        <Select\r\n          labelId=\"demo-controlled-open-select-label\"\r\n          id=\"demo-controlled-open-select\"\r\n          open={overlapOpen}\r\n          onClose={handleClose}\r\n          onOpen={handleOpen}\r\n          value={overlap}\r\n          onChange={handleChange}\r\n        >\r\n          <MenuItem value=\"Enable\">Enable</MenuItem>\r\n          <MenuItem value=\"Disable\">Disable</MenuItem>\r\n        </Select>\r\n      </FormControl>\r\n    </div>\r\n  );\r\n}\r\n",{"ruleId":"427","replacedBy":"428"},{"ruleId":"429","replacedBy":"430"},{"ruleId":"431","severity":1,"message":"432","line":9,"column":8,"nodeType":"433","messageId":"434","endLine":9,"endColumn":13},{"ruleId":"431","severity":1,"message":"435","line":12,"column":8,"nodeType":"433","messageId":"434","endLine":12,"endColumn":12},{"ruleId":"431","severity":1,"message":"436","line":3,"column":22,"nodeType":"433","messageId":"434","endLine":3,"endColumn":30},{"ruleId":"431","severity":1,"message":"436","line":3,"column":22,"nodeType":"433","messageId":"434","endLine":3,"endColumn":30},{"ruleId":"431","severity":1,"message":"437","line":24,"column":9,"nodeType":"433","messageId":"434","endLine":24,"endColumn":15},{"ruleId":"431","severity":1,"message":"438","line":51,"column":7,"nodeType":"433","messageId":"434","endLine":51,"endColumn":19},{"ruleId":"439","severity":1,"message":"440","line":324,"column":17,"nodeType":"441","endLin
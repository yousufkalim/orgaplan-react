yles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport moment from \"moment\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport SmallText from \"../../../components/SmallText\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport MultiAdderInput from \"../../../components/MultiAdderInput\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport ColorPicker from \"../../../components/ColorPcker\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nexport default function AddClient(props) {\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const [loading, setLoading] = useState(false);\r\n  const [update, setUpdate] = useState(false);\r\n\r\n  const [logo, setLogo] = useState([]);\r\n  const [name, setName] = useState(\"\");\r\n  const [color, setColor] = useState(\"green\");\r\n  const [firstName, setFirstName] = useState(\"\");\r\n  const [lastName, setLastName] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [contractType, setContractType] = useState(\"CLIENTPERSITE\");\r\n  const [contractStartDate, setContractStartDate] = useState(\"\");\r\n  const [contractEndDate, setContractEndDate] = useState(\"\");\r\n  const [functionality, setFunctionality] = useState(\"DELIVERY\");\r\n  const [additionalInfo, setAdditionalInfo] = useState(\"\");\r\n  const [notificationPriorToDays, setNotificationPriorToDays] = useState(\"\");\r\n  const [notificationTo, setNotificationTo] = useState([]);\r\n  const [errors, setErrors] = useState({});\r\n  const handleChange = (name, value) => {\r\n    if (name === \"logo\") {\r\n      setUpdate((st) => !st);\r\n      setLogo(value);\r\n    } else if (name === \"name\") setName(value);\r\n    else if (name === \"color\") setColor(value);\r\n    else if (name === \"firstName\") setFirstName(value);\r\n    else if (name === \"lastName\") setLastName(value);\r\n    else if (name === \"email\") setEmail(value);\r\n    else if (name === \"phone\") setPhone(value);\r\n    else if (name === \"contractType\") {\r\n      setContractStartDate(\"\");\r\n      setContractEndDate(\"\");\r\n      setContractType(value);\r\n    } else if (name === \"contractStartDate\") {\r\n      setContractEndDate(\"\");\r\n      setContractStartDate(value);\r\n    } else if (name === \"contractEndDate\") setContractEndDate(value);\r\n    else if (name === \"functionality\") setFunctionality(value);\r\n    else if (name === \"additionalInfo\") setAdditionalInfo(value);\r\n    else if (name === \"notificationPriorToDays\")\r\n      setNotificationPriorToDays(value);\r\n    else if (name === \"notificationTo\") {\r\n      setUpdate((st) => !st);\r\n      setNotificationTo(value);\r\n    }\r\n    // Validation\r\n\r\n    if (name === \"name\") {\r\n      console.log(value.length);\r\n\r\n      if (value !== \"\") setErrors({ nameError: \"\" });\r\n      if (value.length > 30)\r\n        setErrors({ nameError: \"Max 30 characters are allowed\" });\r\n    }\r\n    if (name === \"firstName\") {\r\n      console.log(value.length);\r\n\r\n      if (value !== \"\") setErrors({ firstNameError: \"\" });\r\n      if (value.length > 30)\r\n        setErrors({ firstNameError: \"Max 30 characters are allowed\" });\r\n    }\r\n    if (name === \"lastName\") {\r\n      if (value !== \"\") setErrors({ lastNameError: \"\" });\r\n      if (value.length > 30)\r\n        setErrors({ lastNameError: \"Max 30 characters are allowed\" });\r\n    }\r\n    if (name === \"email\") {\r\n      const regEx = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n      if (value !== \"\") setErrors({ emailError: \"\" });\r\n      if (!value.match(regEx)) {\r\n        setErrors({ emailError: \"* Please Enter Your Valid Email\" });\r\n      }\r\n    }\r\n    if (name === \"phone\") {\r\n      if (value !== \"\") {\r\n        setErrors({\r\n          phoneError: \"\",\r\n        });\r\n      }\r\n      if (value.length > 10 || value.length < 10) {\r\n        setErrors({\r\n          phoneError: \"* Phone Number must have exact 10 digits\",\r\n        });\r\n      }\r\n      if (value[0] !== \"0\") {\r\n        setErrors({ phoneError: \"* Phone Number must start with 0\" });\r\n      }\r\n    }\r\n    if (name === \"additionalInfo\") {\r\n      if (value.length > 300) {\r\n        setErrors({\r\n          additionalInfoError: \"Maximum 300 Characters are allowed\",\r\n        });\r\n      } else {\r\n        setErrors({\r\n          additionalInfoError: \"\",\r\n        });\r\n      }\r\n    }\r\n  };\r\n  const handleChangecolor = (color) => {\r\n    setColor(color.hex);\r\n  };\r\n\r\n  const onSubmit = async (e) => {\r\n    try {\r\n      e.preventDefault();\r\n      setLoading(true);\r\n      const notificationToArray = notificationTo.map((item) => item.label);\r\n\r\n      var formdata = new FormData();\r\n      formdata.append(\"logo\", logo[0].file);\r\n      formdata.append(\"name\", name);\r\n      formdata.append(\"color\", color);\r\n      formdata.append(\"firstName\", firstName);\r\n      formdata.append(\"lastName\", lastName);\r\n      formdata.append(\"email\", email);\r\n      formdata.append(\"phone\", phone);\r\n      formdata.append(\"contractType\", contractType);\r\n      formdata.append(\"contractStartDate\", contractStartDate);\r\n      formdata.append(\"contractEndDate\", contractEndDate);\r\n      formdata.append(\"functionality\", functionality);\r\n      formdata.append(\"additionalInfo\", additionalInfo);\r\n      formdata.append(\"notificationPriorToDays\", notificationPriorToDays);\r\n      formdata.append(\"notificationTo\", JSON.stringify(notificationToArray));\r\n\r\n      await GLOBALS.API({\r\n        method: \"POST\",\r\n        uri: GLOBALS.Constants.CLIENTS,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      setLoading(false);\r\n      props.history.push(\"/clients\");\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"ADD A CLIENT\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={onSubmit}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"COMPANY NAME* :\" />\r\n            <FormInput\r\n              name=\"name\"\r\n              value={name}\r\n              maxLength=\"30\"\r\n              // error={name}\r\n              placeholder=\"Company name\"\r\n              style={GLOBALS.Styles.inputWidth}\r\n              onChange={({ target: { name, value } }) =>\r\n                handleChange(name, value)\r\n              }\r\n            />\r\n          </Form.Row>\r\n          <Form.Row noMargin width=\"48%\" alignItems=\"right\">\r\n            <FormLabel />\r\n            {errors[\"nameError\"] && (\r\n              <div style={{ color: \"red\" }}>{errors[\"nameError\"]}</div>\r\n            )}\r\n          </Form.Row>\r\n          {update && \"\"}\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"COMPANY LOGO* :\" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormMultipleUpload\r\n                name=\"logo\"\r\n                // error={logo}\r\n                values={logo}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={(values) => handleChange(\"logo\", values)}\r\n              />\r\n              <div style={{ width: \"45%\" }}>\r\n                <ColorPicker\r\n                  color={color}\r\n                  handleChange={handleChangecolor}\r\n                  onChange={({ target: { name, value } }) =>\r\n                    handleChange(name, value)\r\n                  }\r\n                />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"RESPONSIBLE COMPANY : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormInput\r\n                name=\"firstName\"\r\n                maxLength=\"30\"\r\n                value={firstName}\r\n                error={errors[\"firstNameErrors\"]}\r\n                placeholder=\"First Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n              <FormInput\r\n                name=\"lastName\"\r\n                value={lastName}\r\n                maxLength=\"30\"\r\n                // error={lastName}\r\n                placeholder=\"Last Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row noMargin width=\"48%\" alignItems=\"right\">\r\n            <FormLabel />\r\n            {errors[\"firstNameError\"] && (\r\n              <div style={{ color: \"red\" }}>{errors[\"firstNameError\"]}</div>\r\n            )}\r\n          </Form.Row>\r\n          <Form.Row noMargin width=\"48%\" alignItems=\"right\">\r\n            <FormLabel />\r\n            {errors[\"lastNameError\"] && (\r\n              <div style={{ color: \"red\" }}>{errors[\"lastNameError\"]}</div>\r\n            )}\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"RESPONSIBLE CONTACT : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormInput\r\n                name=\"email\"\r\n                value={email}\r\n                // error={email}\r\n                placeholder=\"E-mail Address\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                validate={(text) => {\r\n                  const re = /^\\w+([.-]?\\w+)@\\w+([.-]?\\w+)(\\.\\w{2,3})+$/;\r\n                  return !re.test(String(text).toLowerCase());\r\n                }}\r\n              />\r\n              <FormInput\r\n                name=\"phone\"\r\n                value={phone}\r\n                maxLength=\"30\"\r\n                // error={phone}\r\n                placeholder=\"Phone Number\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row noMargin width=\"48%\" alignItems=\"right\">\r\n            <FormLabel />\r\n            {errors[\"emailError\"] && (\r\n              <div style={{ color: \"red\" }}>{errors[\"emailError\"]}</div>\r\n            )}\r\n          </Form.Row>\r\n          <Form.Row noMargin width=\"100%\" alignItems=\"right\">\r\n            <FormLabel />\r\n            {errors[\"phoneError\"] && (\r\n              <div style={{ color: \"red\" }}>{errors[\"phoneError\"]}</div>\r\n            )}\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF CONTRACT* : \" />\r\n            <RadioButton\r\n              name=\"contractType\"\r\n              value={contractType}\r\n              // error={contractType}\r\n              style={GLOBALS.Styles.inputWidth}\r\n              onChange={({ target: { name, value } }) =>\r\n                handleChange(name, value)\r\n              }\r\n              items={[\r\n                { value: \"CLIENTPERSITE\", label: \"Per Site\" },\r\n                { value: \"MASTERCLIENT\", label: \"Master Contract\" },\r\n              ]}\r\n            />\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"CONTRACT DATE* : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormInput\r\n                type=\"date\"\r\n                placeholder=\"Start date\"\r\n                name=\"contractStartDate\"\r\n                value={contractStartDate}\r\n                // error={contractStartDate}\r\n                min={moment().format(\"YYYY-MM-DD\")}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                disabled={contractType !== \"MASTERCLIENT\"}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n              <FormInput\r\n                type=\"date\"\r\n                placeholder=\"End date\"\r\n                name=\"contractEndDate\"\r\n                value={contractEndDate}\r\n                // error={contractEndDate}\r\n                min={moment(contractStartDate)\r\n                  .add(1, \"days\")\r\n                  .format(\"YYYY-MM-DD\")}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                disabled={contractType !== \"MASTERCLIENT\"}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"FUNCTIONALITY SUBSCRIBED : \" />\r\n            <RadioButton\r\n              name=\"functionality\"\r\n              value={functionality}\r\n              // error={functionality}\r\n              style={GLOBALS.Styles.inputWidth}\r\n              items={[{ value: \"DELIVERY\", label: \"Delivery module\" }]}\r\n              onChange={({ target: { name, value } }) =>\r\n                handleChange(name, value)\r\n              }\r\n            />\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\r\n            <FormInput\r\n              textArea\r\n              rows={3}\r\n              maxLength=\"300\"\r\n              name=\"additionalInfo\"\r\n              value={additionalInfo}\r\n              // error={additionalInfo}\r\n              style={GLOBALS.Styles.inputWidth}\r\n              placeholder=\"Additional information\"\r\n              onChange={({ target: { name, value } }) =>\r\n                handleChange(name, value)\r\n              }\r\n            />\r\n          </Form.Row>\r\n          <Form.Row noMargin width=\"48%\" alignItems=\"right\">\r\n            <FormLabel />\r\n            {errors[\"additionalInfoError\"] && (\r\n              <div style={{ color: \"red\" }}>\r\n                {errors[\"additionalInfoError\"]}\r\n              </div>\r\n            )}\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"NOTIFICATION : \" />\r\n            <Form.Row\r\n              noMargin\r\n              width=\"48%\"\r\n              alignItems=\"center\"\r\n              justifyContent=\"center\"\r\n            >\r\n              <FormInput\r\n                type=\"number\"\r\n                placeholder=\"0\"\r\n                name=\"notificationPriorToDays\"\r\n                value={notificationPriorToDays}\r\n                // error={notificationPriorToDays}\r\n                disabled={contractType !== \"MASTERCLIENT\"}\r\n                style={{ ...GLOBALS.Styles.inputWidth, maxWidth: 100 }}\r\n                onChange={({ target: { name, value } }) =>\r\n                  value >= 0 && handleChange(name, value)\r\n                }\r\n              />\r\n              <SmallText\r\n                primary=\"Days before end of the contract\"\r\n                style={{ marginLeft: \"10px\" }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"NOTIFY THE ADDRESSES : \" />\r\n            <MultiAdderInput\r\n              name=\"notificationTo\"\r\n              values={notificationTo}\r\n              validateError=\"Invalid Email\"\r\n              placeholder=\"Enter email address\"\r\n              style={GLOBALS.Styles.inputWidth}\r\n              disabled={contractType !== \"MASTERCLIENT\"}\r\n              onChange={(values) => handleChange(\"notificationTo\", values)}\r\n              validate={(text) => {\r\n                const re = /^\\w+([.-]?\\w+)@\\w+([.-]?\\w+)(\\.\\w{2,3})+$/;\r\n                return !re.test(String(text).toLowerCase());\r\n              }}\r\n            />\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              type=\"submit\"\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              fullWidth={false}\r\n              loading={loading}\r\n              disabled={\r\n                loading ||\r\n                !name ||\r\n                name.length > 30 ||\r\n                logo.length === 0 ||\r\n                (contractType === \"MASTERCLIENT\" &&\r\n                  (!contractStartDate ||\r\n                    !contractEndDate ||\r\n                    moment(contractEndDate).diff(\r\n                      moment(contractStartDate),\r\n                      \"days\",\r\n                    ) <= 0)) ||\r\n                firstName.length > 30 ||\r\n                lastName.length > 30 ||\r\n                (phone.length > 0 &&\r\n                  (!phone.startsWith(\"0\") || phone.length !== 10)) ||\r\n                additionalInfo.length > 300 ||\r\n                Number(notificationPriorToDays) < 0\r\n              }\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\Invoices.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\Clients.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Pic\\Pic.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\EditMean.js",["525","526","527","528","529","530","531","532","533","534","535","536","537","538","539","540","541","542","543","544","545"],"import React, { useState, useEffect } from \"react\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/CustomFormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport CustomInputModal from \"../../../components/CustomInputModal\";\r\nimport CustomButtonModal from \"../../../components/CustomButtonModal\";\r\nimport moment from \"moment\";\r\nimport ColorPicker from \"../../../components/ColorPcker\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nconst accessabilityPoints = [\r\n  { label: \"Storage Area\", value: \"Storage Area\" },\r\n  { label: \"Delivery Area\", value: \"Delivery Area\" },\r\n];\r\n\r\nexport default function EditMean(props) {\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [name, setName] = useState(\"\");\r\n  const [type, setType] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [image, setImage] = useState([]);\r\n  const [startDate, setStartDate] = useState(\"\");\r\n  const [endDate, setEndDate] = useState(\"\");\r\n  const [techSheet, setTechSheet] = useState([]);\r\n  const [rate, setRate] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n  const [loading, setLoading] = useState(true);\r\n  const [disableDropdpwn, setDisableDropdown] = useState(false);\r\n  const classes = useStyles();\r\n\r\n  const [accessabilityPoint, setAccessabilityPoint] = useState(\"\");\r\n  const [DeliveryAreas, setDeliveryAreas] = useState([]);\r\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\r\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\r\n  const [\r\n    selectedSiteDeliveryAreadIndex,\r\n    seltSelectedSiteDeliveryAreaIndex,\r\n  ] = useState(null);\r\n\r\n  const [storageAreas, setStorageAreas] = useState([]);\r\n  const [dropdownStorageAreas, setDropdownStorageAreas] = useState([]);\r\n  const [\r\n    selectedDropdownStorageArea,\r\n    setSelectedDropdownStorageArea,\r\n  ] = useState(\"\");\r\n  const [selectedStorageAreaIndex, setSelectedStorageAreaIndex] = useState(\r\n    null,\r\n  );\r\n\r\n  const [deliveryAreaId, setDeilveryAreaId] = useState(\"\");\r\n  const [storageAreaId, setStorageAreaId] = useState(\"\");\r\n\r\n  const [\r\n    deliveryAndStorageLocations,\r\n    setDeliveryAndStorageLocations,\r\n  ] = useState([]);\r\n\r\n  const [buildings, setBuidings] = useState([]);\r\n  const [dropdownBuildings, setDropdownBuildings] = useState([]);\r\n  const [selectedDropdownBuilding, setSelectedDropdownBuilding] = useState(\"\");\r\n  const [selectedBuildingIndex, setSelectedBuildingIndex] = useState(null);\r\n\r\n  const [levels, setLevels] = useState([]);\r\n  const [dropdownLevels, setDropdownLevels] = useState([]);\r\n  const [selectedDropdownLevel, setSelectedDropdownLevel] = useState(\"\");\r\n  const [selectedDropdownIndex, setSelectedLevelIndex] = useState(null);\r\n\r\n  const [meanTypes, setMeanTypes] = useState([]);\r\n  const [dropdownMeanTypes, setDropdownMeanTypes] = useState([]);\r\n  const [selectedMeanType, setSelectedMeanType] = useState(\"\");\r\n  const [selecetedMeanTypeIndex, setSelectedMeanTypeIndex] = useState(null);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  const setValues = () => {\r\n    const mean = props.location.mean;\r\n    setName(mean.name);\r\n    let fileClone = [{ uri: mean.image }];\r\n    setImage(fileClone);\r\n    setSelectedMeanType(mean.meanType);\r\n    let meanTypeIndex = 0;\r\n    dropdownMeanTypes.forEach((item, index) => {\r\n      if (item.value === mean.meanType) meanTypeIndex = index;\r\n    });\r\n\r\n    setSelectedMeanTypeIndex(meanTypeIndex);\r\n\r\n    setColor(mean.color);\r\n\r\n    setStartDate(moment(mean.availability.start).format(\"MM/DD/yyyy\"));\r\n    setEndDate(moment(mean.availability.end).format(\"MM/DD/yyyy\"));\r\n    setRate(mean.pricePerHour);\r\n    setAddInfo(mean.additionalInfo);\r\n    const locationTemp = [];\r\n    mean.location.forEach((item, index) => {\r\n      let loc = { key: \"\", label: \"\", id: \"\", type: \"\" };\r\n\r\n      if (item.locationType === \"STORAGEAREA\") {\r\n        loc.key = item.storageArea._id;\r\n        loc.label = item.storageArea.name;\r\n        loc.id = item.storageArea._id;\r\n        loc.type = accessabilityPoints[0].value;\r\n        locationTemp.push(loc);\r\n      }\r\n      if (item.locationType === \"DELIVERYAREA\") {\r\n        loc.key = item.deliveryArea._id;\r\n        loc.label = item.deliveryArea.name;\r\n        loc.id = item.deliveryArea._id;\r\n        loc.type = accessabilityPoints[1].value;\r\n        locationTemp.push(loc);\r\n      }\r\n    });\r\n    setDeliveryAndStorageLocations(locationTemp);\r\n    console.log(JSON.stringify(locationTemp, null, 2));\r\n    // \"key\": \"61615286801076\",\r\n    // \"label\": \"storqg\",\r\n    // \"id\": \"60096007880eb61e9d7188d2\",\r\n    // \"type\": \"Storage Area\"\r\n  };\r\n  useEffect(() => {}, [\r\n    meanTypes,\r\n    dropdownMeanTypes,\r\n    selecetedMeanTypeIndex,\r\n    selectedMeanType,\r\n  ]);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_MEAN}/6008169bedbb7816d40b197d`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.site_delivery_areas !== null) {\r\n          const temp = [];\r\n          response.data.site_delivery_areas.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name, id: item._id }),\r\n          );\r\n          await setDeliveryAreas(response.data.site_delivery_areas);\r\n          await setDropdownDeliveryAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_storage_areas !== null) {\r\n          const temp = [];\r\n          response.data.site_storage_areas.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name, id: item._id }),\r\n          );\r\n          await setStorageAreas(response.data.site_storage_areas);\r\n          await setDropdownStorageAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_buildings !== null) {\r\n          const temp = [];\r\n          response.data.site_buildings.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n          await setBuidings(response.data.site_buildings);\r\n          await setDropdownBuildings(temp);\r\n        }\r\n\r\n        if (response.data.mean_types !== null) {\r\n          const temp = [];\r\n          response.data.mean_types.map((item, index) =>\r\n            temp.push({ label: item, value: item }),\r\n          );\r\n          await setMeanTypes(response.data.mean_types);\r\n          await setDropdownMeanTypes(temp);\r\n        }\r\n        // if (response.data.mean_types !== null) {\r\n        //   setTypes(response.data.mean_types);\r\n        //   const temp = [];\r\n        //   response.data.mean_types.map((item, index) => {\r\n        //     temp.push({ label: item, value: item });\r\n        //   });\r\n        //   setDropdownTypes(temp);\r\n        // }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n      await setValues();\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  function handleChange(name, value) {\r\n    //alert(JSON.stringify(value, null, 2));\r\n    if (name === \"name\") setName(value);\r\n    else if (name === \"type\") setType(value);\r\n    else if (name === \"color\") setColor(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"startDate\") setStartDate(value);\r\n    else if (name === \"endDate\") setEndDate(value);\r\n    else if (name === \"techSheet\") setTechSheet(value);\r\n    else if (name === \"rate\") setRate(value);\r\n    else if (name === \"addInfo\") setAddInfo(value);\r\n  }\r\n\r\n  const updateMean = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      var formdata = new FormData();\r\n\r\n      let locations = [];\r\n\r\n      deliveryAndStorageLocations.forEach((item) => {\r\n        if (item.type === accessabilityPoints[0].value) {\r\n          let loc = {\r\n            locationType: \"STORAGEAREA\",\r\n            storageArea: item.id,\r\n          };\r\n          locations.push(loc);\r\n        }\r\n        if (item.type === accessabilityPoints[1].value) {\r\n          let loc = {\r\n            locationType: \"DELIVERYAREA\",\r\n            deliveryArea: item.id,\r\n          };\r\n          locations.push(loc);\r\n        }\r\n      });\r\n\r\n      let availabilities = {\r\n        start: startDate,\r\n        end: endDate,\r\n      };\r\n\r\n      // TEST DATA , CALENDAR NOT MADE YET\r\n\r\n      const sampleDateOne = new Date(\"05/20/2021\");\r\n      const sampleDateTwo = new Date(\"05/28/2021\");\r\n      // const unavailabilities = [\r\n      //   {\r\n      //     date: sampleDateOne,\r\n      //     reason: \"Public Holiday\",\r\n      //     startingHour: new Date().getTime(),\r\n      //     endingHour: new Date().getTime(),\r\n      //   },\r\n      //   {\r\n      //     date: sampleDateTwo,\r\n      //     reason: \"Maintenance\",\r\n      //     startingHour: new Date().getTime(),\r\n      //     endingHour: new Date().getTime(),\r\n      //   },\r\n      // ];\r\n\r\n      formdata.append(\"name\", name);\r\n      formdata.append(\"color\", color);\r\n      if (image.length != 0 && image[0].file != undefined)\r\n        formdata.append(\"image\", image[0].file);\r\n      if (image.length != 0 && image[0].file != undefined)\r\n        formdata.append(\"sheet\", image[0].file);\r\n      formdata.append(\"pricePerHour\", rate);\r\n      formdata.append(\"additionalInfo\", addInfo);\r\n      formdata.append(\"siteId\", \"6008169bedbb7816d40b197d\");\r\n      formdata.append(\"meanType\", selectedMeanType);\r\n      formdata.append(\"location\", JSON.stringify(locations));\r\n      formdata.append(\"availability\", JSON.stringify(availabilities));\r\n      //formdata.append(\"unavailability\", JSON.stringify(unavailabilities));\r\n\r\n      const response = await GLOBALS.API({\r\n        method: \"PUT\",\r\n        uri: GLOBALS.Constants.UPDATE_MEAN + \"/\" + props.location.mean._id,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n        dispatch(\r\n          Actions.notistack.enqueueSnackbar(\r\n            Actions.notistack.snackbar(response.message, \"error\"),\r\n          ),\r\n        );\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getDeliveryArea = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data !== null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n\r\n          setDropdownDeliveryAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getStorageArea = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data !== null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n\r\n          setDropdownStorageAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const handleChangecolor = (color) => {\r\n    setColor(color.hex )\r\n    console.log(\"color is\", color.hex);\r\n  };\r\n\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n\r\n      <Form.Row>\r\n        <Heading primary=\"EDIT A MEAN\" />\r\n\r\n        {/* <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"LOCALISATION\"\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginRight: \"100px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\"\r\n                }}\r\n              /> */}\r\n      </Form.Row>\r\n      {loading && \"\"}\r\n      {levels && \"\"}\r\n      {selectedDropdownIndex && \"\"}\r\n      {meanTypes && \"\"}\r\n      {selectedBuildingIndex && \"\"}\r\n      {DeliveryAreas && \"\"}\r\n      {selectedSiteDeliveryAreadIndex && \"\"}\r\n      {storageAreas && \"\"}\r\n      {selectedStorageAreaIndex && \"\"}\r\n      <div className={classes.content}>\r\n        <Form.Form>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY * : \" />\r\n            <Form.Row noMargin width=\"65%\" style={{ gap: \"20px\" }}>\r\n              <FormInput\r\n                name=\"name\"\r\n              \r\n                style={{width: \"25%\"}}\r\n                placeholder=\"name\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={name}\r\n                \r\n              />\r\n              <FormSelect\r\n                placeholder=\"Type\"\r\n                name=\"type\"\r\n                value={selectedMeanType}\r\n                style={{width: \"25%\"}}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    setSelectedMeanTypeIndex(index);\r\n                    setSelectedMeanType(item);\r\n                  } else {\r\n                    setSelectedMeanTypeIndex(null);\r\n                    setSelectedMeanType(\"\");\r\n                  }\r\n                }}\r\n                values={dropdownMeanTypes}\r\n              />\r\n              <div style={{ width: \"25%\" }}>\r\n                <ColorPicker color={color} handleChange={handleChangecolor} />\r\n              </div>\r\n\r\n             \r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IMAGE :  \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n            <FormMultipleUpload\r\n                name=\"image\"\r\n                style={{width: \"40%\"}}\r\n                values={image}\r\n                onChange={(values) => {\r\n                  handleChange(\"image\", values);\r\n                }}\r\n              />\r\n            </Form.Row>\r\n            \r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"LOCATION * :  \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <CustomInputModal\r\n                name=\"location\"\r\n                values={accessabilityPoints}\r\n                chipDefaultValues={deliveryAndStorageLocations}\r\n                leftValue={accessabilityPoint}\r\n                rightValue={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? selectedDropdownStorageArea\r\n                    : selectedDropdownArea\r\n                }\r\n                leftId={accessabilityPoint}\r\n                rightId={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? storageAreaId\r\n                    : deliveryAreaId\r\n                }\r\n                chipValues={(values) => {\r\n                  setDeliveryAndStorageLocations(values);\r\n                }}\r\n                leftDropdownValues={accessabilityPoints}\r\n                leftDropdwonPlaceholder={\"Select Location Type\"}\r\n                rightDropdownPlaceholder={\"Select Location\"}\r\n                leftDropdwonValueChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    setAccessabilityPoint(item);\r\n                    if (item === accessabilityPoints[0].value) {\r\n                      getStorageArea();\r\n                    }\r\n                    if (item === accessabilityPoints[1].value) {\r\n                      getDeliveryArea();\r\n                    } else {\r\n                      seltSelectedSiteDeliveryAreaIndex(0);\r\n                      setSelectedDropdownArea(\"\");\r\n                      setDeilveryAreaId(\"\");\r\n\r\n                      setSelectedStorageAreaIndex(0);\r\n                      setSelectedDropdownStorageArea(\"\");\r\n                      setStorageAreaId(\"\");\r\n                    }\r\n                  } else {\r\n                    seltSelectedSiteDeliveryAreaIndex(0);\r\n                    setSelectedDropdownArea(\"\");\r\n                    setDeilveryAreaId(\"\");\r\n\r\n                    setSelectedStorageAreaIndex(0);\r\n                    setSelectedDropdownStorageArea(\"\");\r\n                    setStorageAreaId(\"\");\r\n                  }\r\n                }}\r\n                rightDropdownValues={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? dropdownStorageAreas\r\n                    : dropdownDeliveryAreas\r\n                }\r\n                // error={addresses}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                rightDropdwonValueChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    if (accessabilityPoints[0].value === accessabilityPoint) {\r\n                      setStorageAreaId(storageAreas[index]._id);\r\n                      setSelectedStorageAreaIndex(index);\r\n                      setSelectedDropdownStorageArea(item);\r\n                    } else {\r\n                      setSelectedStorageAreaIndex(0);\r\n                      setSelectedDropdownStorageArea(\"\");\r\n                    }\r\n\r\n                    if (accessabilityPoints[1].value === accessabilityPoint) {\r\n                      setDeilveryAreaId(DeliveryAreas[index]._id);\r\n                      seltSelectedSiteDeliveryAreaIndex(index);\r\n                      setSelectedDropdownArea(item);\r\n                    } else {\r\n                      seltSelectedSiteDeliveryAreaIndex(0);\r\n                      setSelectedDropdownArea(\"\");\r\n                    }\r\n                  } else {\r\n                    setSelectedStorageAreaIndex(0);\r\n                    setSelectedDropdownStorageArea(\"\");\r\n                    seltSelectedSiteDeliveryAreaIndex(0);\r\n                    setSelectedDropdownArea(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"AVAILAIBILITIES * :\" />\r\n            <Form.Row\r\n              noMargin\r\n              width=\"65%\"\r\n              justifyContent=\"flex-start\"\r\n              style={{ gap: \"20px\" }}\r\n            >\r\n              <FormInput\r\n                type=\"date\"\r\n                style={{ width: \"300px\" }}\r\n                placeholder={`Start date`}\r\n                name=\"startDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={startDate}\r\n              />\r\n              <FormInput\r\n                type=\"date\"\r\n                placeholder=\"End date\"\r\n                style={{ width: \"300px\" }}\r\n                name=\"endDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={endDate}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TECHNICAL SHEET :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormMultipleUpload\r\n                name=\"techSheet\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={techSheet}\r\n                onChange={(values) => {\r\n                  handleChange(\"techSheet\", values);\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"UNAVAILABILITIES\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <div\r\n                // name=\"availability\"\r\n\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"0px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  color: \"#fff\",\r\n                  padding: \"0.8rem 0\",\r\n                  borderRadius: \"8px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\",\r\n                }}\r\n              >\r\n                SHOW UNAVAILABILITIES\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n          <FormLabel bold primary=\"HOURLY RATE :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <div style={{ width: \"30%\", height: \"100%\", position: \"relative\" }}>\r\n                <FormInput\r\n            \r\n                  type=\"number\"\r\n                  name=\"rate\"\r\n                  onChange={({ target: { name, value } }) =>\r\n                    handleChange(name, value)\r\n                  }\r\n                  value={rate}\r\n                />\r\n               <span style={{position: \"absolute\", top: \"25%\", right: \"5%\"}}>€</span>\r\n              </div>\r\n             \r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONAL INFORMATION :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                maxLength=\"300\"\r\n                style={{ width: \"100%\" }}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                className=\"means-addinfo\"\r\n                onChange={({ target: { name, value } }) => {\r\n                  handleChange(name, value);\r\n                }}\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          {type && \"\"}\r\n          <Form.Row>\r\n            <Form.ButtonContainer style={{ width: \"80%\" }}>\r\n              <Button\r\n                minWidth={200}\r\n                text=\"VALIDATE\"\r\n                fullWidth={false}\r\n                onClick={async () => {\r\n                  await updateMean();\r\n                }}\r\n                // loading={formik.isSubmitting}\r\n                disabled={\r\n                  !name ||\r\n                  !selectedMeanType ||\r\n                  !color ||\r\n                  !startDate ||\r\n                  !deliveryAndStorageLocations\r\n                }\r\n              />\r\n            </Form.ButtonContainer>\r\n          </Form.Row>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\Historic.js",["546"],"import React, { useState, useEffect } from \"react\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\n// import Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Table from \"../../../components/Table\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport moment from \"moment\";\r\nimport { Images } from \"../../../assets/Assets\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n  link: {\r\n    marginRight: 20,\r\n    whiteSpace: \"nowrap\",\r\n    color: theme.palette.primary.contrastText,\r\n  },\r\n  image: {\r\n    height: 70,\r\n    borderRadius: theme.shape.borderRadius,\r\n  },\r\n}));\r\n\r\nconst Historic = (props) => {\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [isLoading, setLoading] = useState(true);\r\n  const [history, setHistory] = useState([]);\r\n\r\n  const [means, setMeans] = useState([]);\r\n  const [dorpdownMeans, setDropdownMeans] = useState([]);\r\n  const [selectedMean, setSelectedMean] = useState(\"\");\r\n  const [selectedMeanIndex, setSelectedMeanIndex] = useState(null);\r\n\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    filterBooking();\r\n    // eslint-disable-next-line\r\n  }, [selectedMeanIndex, selectedCompanyIndex]);\r\n\r\n  const filterBooking = async () => {\r\n    try {\r\n      setLoading(true);\r\n      const params = { siteId: adminStore.site.siteId._id };\r\n      if (selectedMean.length !== 0)\r\n        params[\"meanId\"] = means[selectedMeanIndex]._id;\r\n      if (selectedCompany.length !== 0)\r\n        params[\"companyId\"] = companies[selectedCompanyIndex].companyId._id;\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.FILTER_BOOKING}`,\r\n        token: store.token,\r\n        method: \"POST\",\r\n        body: JSON.stringify(params),\r\n      });\r\n      if (response.success) {\r\n        setHistory(response.data);\r\n\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getData = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_MEAN_HISTORY}/${props.location.mean._id}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setHistory(response.data.history);\r\n        setCompanies(response.data.site_companies);\r\n        if (response.data.site_means != null) {\r\n          setMeans(response.data.site_means);\r\n          let selectedMeanIndex = 0;\r\n\r\n          const temp = [];\r\n          const companyTemp = [];\r\n          response.data.site_means.map((item, index) => {\r\n            if (item._id === props.location.mean._id) {\r\n              selectedMeanIndex = index;\r\n              setSelectedMean(item.name);\r\n            }\r\n            return temp.push({ label: item.name, value: item.name });\r\n          });\r\n          setDropdownMeans(temp);\r\n\r\n          setSelectedMeanIndex(selectedMeanIndex);\r\n\r\n          response.data.site_companies.map((item, index) => {\r\n            return companyTemp.push({\r\n              label: item.companyId.name,\r\n              value: item.companyId.name,\r\n            });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const rows = history.map((item) => {\r\n    return [\r\n      moment(item.startDate).format(\"MM/DD/yyy\") + \" \" + item.startTime,\r\n      moment(item.endDate).format(\"MM/DD/yyy\") + \" \" + item.endTime,\r\n      item.companyId.name,\r\n      item.bookingReason,\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <Form.Row alignItems=\"center\">\r\n        <Heading primary=\"LIST OF MEANS - HISTORIC\" noWrap />\r\n        <div>\r\n          <Form.Row\r\n            alignItems=\"flex-start\"\r\n            noMargin\r\n            justifyContent=\"flex-end\"\r\n            style={{ paddingRight: \"50px\" }}\r\n          >\r\n            <Form.Column style={{ width: \"50%\", marginRight: \"50px\" }}>\r\n              <img src={Images.site} alt=\"\" />\r\n            </Form.Column>\r\n          </Form.Row>\r\n        </div>\r\n      </Form.Row>\r\n      <Form.Row alignItems=\"center\" noMargin>\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          {/* <SearchInput\r\n            placeholder=\"Site name\"\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          /> */}\r\n          <FormSelect\r\n            placeholder=\"Company\"\r\n            values={dropdownCompanies}\r\n            value={selectedCompany}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n\r\n                setSelectedCompanyIndex(index);\r\n\r\n                setSelectedCompany(item);\r\n              } else {\r\n                setSelectedCompanyIndex(null);\r\n\r\n                setSelectedCompany(\"\");\r\n              }\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Mean\"\r\n            values={dorpdownMeans}\r\n            value={selectedMean}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n\r\n                setSelectedMeanIndex(index);\r\n\r\n                setSelectedMean(item);\r\n              } else {\r\n                setSelectedMeanIndex(null);\r\n\r\n                setSelectedMean(\"\");\r\n              }\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\r\n          See archived sites\r\n        </NavLink> */}\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Table headers={GLOBALS.Data.meansOfHistoric.headings} rows={rows} />\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Historic;\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\Means.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\AddMean.js",["547","548","549","550","551","552","553","554","555"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\popoverModal.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\events.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\MyWorkWeek.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\AddUser.js",["556","557","558","559","560","561","562","563","564","565"],"import React, { useState, useEffect } from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\r\nimport TextField from \"@material-ui/core/TextField\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  site: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n});\r\n\r\nexport default function AddUser(props) {\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [page] = useState(1);\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  const [roles, setRoles] = useState([]);\r\n  const [dropdownRoles, setDropdownRoles] = useState([]);\r\n  const [selectedRole, setSelectedRole] = useState(\"\");\r\n  const [selectedRoleIndex, setSelectedRoleIndex] = useState(null);\r\n\r\n  const [siteParams, setSiteParams] = useState([]);\r\n\r\n  const [users, setUsers] = useState([]);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n  }, []);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_USER}/${adminStore.site.siteId._id}/${store.user._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.site_companies.companies);\r\n        setRoles(response.data.site_companies.companies);\r\n        setUsers(response.data.users);\r\n        if (response.data.site_companies != null) {\r\n          const companyTemp = [];\r\n\r\n          response.data.site_companies.companies.map((item, index) => {\r\n            return companyTemp.push({ label: item.name, value: item.name });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n        if (response.data.roles != null) {\r\n          const rolesTemp = [];\r\n\r\n          response.data.roles.map((item, index) => {\r\n            return rolesTemp.push({ label: item, value: item });\r\n          });\r\n          setDropdownRoles(rolesTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getUserCompany = async (userId) => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_USER_COMPANY}/${adminStore.site.siteId._id}/${userId}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        console.log(JSON.stringify(response, null, 2));\r\n        if (response.data) {\r\n          companies.forEach((item, index) => {\r\n            if (item._id === response.data._id) {\r\n              item.users.forEach((innerItem, innerIndex) => {\r\n                console.log(\"innser \", innerItem.userId);\r\n                if (innerItem.userId === userId) {\r\n                  setSelectedRoleIndex(innerIndex);\r\n\r\n                  setSelectedRole(innerItem.role);\r\n                }\r\n              });\r\n              setSelectedCompanyIndex(index);\r\n\r\n              setSelectedCompany(item.name);\r\n            }\r\n          });\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const onSubmit = async () => {\r\n    const values = formik.values;\r\n    const sites = [];\r\n    siteParams.forEach((item) => {\r\n      sites.push({ siteId: item.id, role: selectedRole });\r\n    });\r\n    var formdata = new FormData();\r\n    formdata.append(\"image\", values.logo[0].file);\r\n    //formdata.append(\"name\", values.name);\r\n    formdata.append(\"firstName\", values.firstName);\r\n    formdata.append(\"lastName\", values.lastName);\r\n    formdata.append(\"email\", values.email);\r\n    formdata.append(\"phone\", values.phone);\r\n    formdata.append(\"sites\", JSON.stringify(sites));\r\n    formdata.append(\"companyId\", companies[selectedCompanyIndex]._id);\r\n\r\n    await GLOBALS.API({\r\n      method: \"POST\",\r\n      uri: GLOBALS.Constants.ADD_USER_ADMIN,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      logo: [],\r\n      name: \"\",\r\n      color: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      site: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n    },\r\n    validationSchema: addClientYup,\r\n    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"ADD USER\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={formik.handleSubmit}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"CONTACT INFO* :\" />\r\n            <Form.Row width=\"48%\">\r\n              {/* <FormInput\r\n                name=\"name\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                placeholder=\"Adresse e-mail\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.name}\r\n                error={formik.errors.name}\r\n              /> */}\r\n              <Autocomplete\r\n                id=\"free-solo-demo\"\r\n                freeSolo\r\n                style={{\r\n                  ...GLOBALS.Styles.inputWidth,\r\n                  marginRight: \"10px\",\r\n                }}\r\n                onSelect={(event) => {\r\n                  users.forEach((item, index) => {\r\n                    if (item.userId.email === event.target.value) {\r\n                      console.log(JSON.stringify(item.sites, null, 2));\r\n                      formik.setFieldValue(\"firstName\", item.userId.firstName);\r\n                      formik.setFieldValue(\"lastName\", item.userId.lastName);\r\n                      formik.setFieldValue(\"phone\", item.userId.phone);\r\n                      formik.setFieldValue(\"logo\", [\r\n                        { uri: item.userId.image },\r\n                      ]);\r\n\r\n                      getUserCompany(item.userId._id);\r\n                    }\r\n                  });\r\n                }}\r\n                options={users.map((option) => {\r\n                  if (option.userId.email != undefined)\r\n                    return option.userId.email;\r\n                })}\r\n                renderInput={(params) => (\r\n                  <TextField\r\n                    {...params}\r\n                    label=\"Email\"\r\n                    margin=\"normal\"\r\n                    variant=\"outlined\"\r\n                    name=\"email\"\r\n                    value={formik.values.email}\r\n                    error={formik.errors.email}\r\n                    onChange={formik.handleChange}\r\n                  />\r\n                )}\r\n              />\r\n              <FormInput\r\n                name=\"phone\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                placeholder=\"Téléphone\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.phone}\r\n                error={formik.errors.phone}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"INDENTITY* :\" />\r\n            <Form.Row width=\"48%\">\r\n              <FormInput\r\n                name=\"firstName\"\r\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\r\n                placeholder=\"FIRST NAME\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.firstName}\r\n                error={formik.errors.firstName}\r\n              />\r\n              <FormInput\r\n                name=\"lastName\"\r\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\r\n                placeholder=\"LAST NAME\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.lastName}\r\n                error={formik.errors.name}\r\n              />\r\n              <FormMultipleUpload\r\n                name=\"logo\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                error={formik.errors.logo}\r\n                values={formik.values.logo}\r\n                onChange={(values) =>\r\n                  formik.handleChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"logo\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"COMPANY : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormSelect\r\n                placeholder=\"Company\"\r\n                values={dropdownCompanies}\r\n                value={selectedCompany}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedCompanyIndex(index);\r\n\r\n                    setSelectedCompany(item);\r\n                  } else {\r\n                    setSelectedCompanyIndex(null);\r\n\r\n                    setSelectedCompany(\"\");\r\n                  }\r\n                }}\r\n                style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"RÔLE : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormSelect\r\n                placeholder=\"RÔLE : \"\r\n                name=\"color\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={formik.handleChange}\r\n                value={formik.values.color}\r\n                error={formik.errors.color}\r\n                values={dropdownRoles}\r\n                value={selectedRole}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedRoleIndex(index);\r\n\r\n                    setSelectedRole(item);\r\n                  } else {\r\n                    setSelectedRoleIndex(null);\r\n\r\n                    setSelectedRole(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"CONSTRUCTION SITE : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormInput\r\n                name=\"site\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                placeholder=\"Site\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.site}\r\n                error={formik.errors.site}\r\n                disabled={true}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              minWidth={200}\r\n              text=\"CONTINUER\"\r\n              fullWidth={false}\r\n              onClick={() => {\r\n                onSubmit();\r\n              }}\r\n              loading={formik.isSubmitting}\r\n              disabled={formik.isSubmitting}\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\UserList.js",["566","567"],"import React, { useState, useEffect } from \"react\";\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n// import * as Yup from \"yup\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Modal from \"../../../components/Modal\";\r\nimport SmallButton from \"../../../components/SmallButton\";\r\n\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport AvatarUpload from \"../../../components/AvatarUpload\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n}));\r\n\r\n// const updateAdminYup = Yup.object().shape({\r\n//   email: Yup.string().required(\"Required\"),\r\n//   phone: Yup.number()\r\n//     .test(\r\n//       \"len\",\r\n//       \"Must be exactly 10 characters\",\r\n//       (val) => val && val.toString().length === 10,\r\n//     )\r\n//     .required(\"Required\"),\r\n//   image: Yup.object().optional(\"\"),\r\n//   companyId: Yup.string().required(\"Required\"),\r\n// });\r\n\r\nexport default function UserList(props) {\r\n  const theme = useTheme();\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [page] = useState(1);\r\n  const [items, setItems] = useState([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const [companies, setCompanies] = useState([]);\r\n  const [open, setOpen] = useState(false);\r\n\r\n  const [selectedItem] = useState(\"\");\r\n\r\n  const [firstName, setFirstName] = useState(\"\");\r\n  const [lastName, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [image, setImage] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [companyName, setCompanyName] = useState(\"\");\r\n  const [users, setUsers] = useState([]);\r\n  useEffect(() => {\r\n    getData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_COMPANY_USERS}/${adminStore.site.siteId._id}/${props.location.id}`,\r\n        token: store.token,\r\n      });\r\n      //console.log(JSON.stringify(response.data[0].usersArray, null, 2));\r\n      if (response.success) {\r\n        setCompanyName(response.data[0].company.name);\r\n        setUsers(response.data[0].usersArray);\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n  const resendVerificaiontRequest = () => {};\r\n  const handleChange = (name, value) => {\r\n    if (name === \"firstName\") setFirstName(value);\r\n    else if (name === \"lastName\") setLastName(value);\r\n    else if (name === \"phone\") setPhone(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"companyId\") setCompanyId(value);\r\n  };\r\n\r\n  const onUpdate = async (e) => {\r\n    try {\r\n      e.preventDefault();\r\n      setLoading(true);\r\n      var formdata = new FormData();\r\n      formdata.append(\"firstName\", firstName);\r\n      formdata.append(\"lastName\", lastName);\r\n      formdata.append(\"phone\", phone);\r\n      formdata.append(\"companyId\", companyId);\r\n      formdata.append(\"userId\", selectedItem._id);\r\n      image.file && formdata.append(\"image\", image.file);\r\n\r\n      const result = await GLOBALS.API({\r\n        method: \"PUT\",\r\n        uri: GLOBALS.Constants.ADMINS,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      const itemsArray = items.map((item) =>\r\n        item._id === selectedItem._id ? result.data : item,\r\n      );\r\n      setItems(itemsArray);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n  const handleClickOpen = () => {\r\n    setOpen(true);\r\n  };\r\n  const rows = users.map((item) => {\r\n    console.log(JSON.stringify(item, null, 2));\r\n    const user = item;\r\n    return [\r\n      user.firstName + \" \" + user.lastName,\r\n      companyName,\r\n      item.role,\r\n      user.isVerified ? \"Inscrit\" : \"En attente\",\r\n      user.email,\r\n      <SmallButton\r\n        text={user.isVerified ? \"Edit\" : \"Re-Send\"}\r\n        onClick={user.isVerified ? handleClickOpen : resendVerificaiontRequest}\r\n        color={theme.palette.primary.contrastText}\r\n        to={\"/companies\"}\r\n        // component={NavLink}\r\n        style={{\r\n          marginLeft: 10,\r\n          borderRadius: 4,\r\n        }}\r\n      />,\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <>\r\n      <div className={classes.root}>\r\n        <Form.Row alignItems=\"center\" className=\"pr-3\">\r\n          <Heading primary=\"LIST OF USERS\" noWrap />\r\n          <div>\r\n            <Form.Row alignItems=\"center\" noMargin>\r\n              <SubHeading\r\n                disableMargin\r\n                primary={`Total : ${users.length} Users`}\r\n                bold\r\n              />\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"ADD A USER\"\r\n                style={{ marginLeft: \"20px\" }}\r\n                to={\"/companies/add-user\"}\r\n              />\r\n            </Form.Row>\r\n          </div>\r\n        </Form.Row>\r\n        {companies && \"\"}\r\n        <Form.Row noMargin>\r\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\r\n            <SearchInput placeholder=\"Name OF USER\" />\r\n            <FormSelect\r\n              placeholder=\"Company\"\r\n              name=\"color\"\r\n              style={{ marginLeft: \"20px\", maxWidth: 250 }}\r\n              values={[\r\n                { value: \"green\", label: \"Green\" },\r\n                { value: \"Yellow\", label: \"Yellow\" },\r\n                { value: \"Red\", label: \"Red\" },\r\n                { value: \"Blue\", label: \"Blue\" },\r\n                { value: \"Orange\", label: \"Orange\" },\r\n                { value: \"Purple\", label: \"Purple\" },\r\n                { value: \"Magenta\", label: \"Magenta\" },\r\n              ]}\r\n            />\r\n          </Form.Row>\r\n        </Form.Row>\r\n        <div className={classes.content}>\r\n          <Table headers={GLOBALS.Data.userList.headings} rows={rows} />\r\n        </div>\r\n      </div>\r\n      <Modal\r\n        title=\"THEIRRY MARLES\"\r\n        open={open}\r\n        onClose={() => setOpen(false)}\r\n        body={\r\n          <Form.Form onSubmit={onUpdate}>\r\n            <Form.Row justifyContent=\"center\">\r\n              <AvatarUpload\r\n                value={image}\r\n                // error={image}\r\n                onChange={(file) => {\r\n                  const uri = URL.createObjectURL(file);\r\n                  handleChange(\"image\", { file, uri });\r\n                }}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"thier@contrco.com\"\r\n                value={firstName}\r\n                // error={firstName}\r\n                placeholder=\"First Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"lastName\"\r\n                value={lastName}\r\n                // error={lastName}\r\n                placeholder=\"Last Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\"></Form.Row>\r\n            <Form.ButtonContainer>\r\n              <Button\r\n                type=\"submit\"\r\n                minWidth={200}\r\n                text=\"VALIDATE\"\r\n                fullWidth={false}\r\n                disabled={loading}\r\n              />\r\n            </Form.ButtonContainer>\r\n          </Form.Form>\r\n        }\r\n      />\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\EditCompanies.js",["568","569","570","571","572","573","574","575","576","577","578","579","580","581","582","583","584","585","586","587","588","589","590","591","592","593","594","595","596","597"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\AddCompanies.js",["598","599","600","601","602","603","604","605","606","607","608","609","610","611","612","613","614","615","616","617","618","619","620","621","622","623"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\Companies.js",["624","625","626","627","628"],"import React, { useState, useEffect } from \"react\";\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n// import * as Yup from \"yup\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Modal from \"../../../components/Modal\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport AvatarUpload from \"../../../components/AvatarUpload\";\r\nimport uploadIcon from \"../../../assets/images/upload.png\";\r\nimport { Images } from \"../../../assets/Assets\";\r\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n}));\r\n\r\n// const updateAdminYup = Yup.object().shape({\r\n//   email: Yup.string().required(\"Required\"),\r\n//   phone: Yup.number()\r\n//     .test(\r\n//       \"len\",\r\n//       \"Must be exactly 10 characters\",\r\n//       (val) => val && val.toString().length === 10,\r\n//     )\r\n//     .required(\"Required\"),\r\n//   image: Yup.object().optional(\"\"),\r\n//   companyId: Yup.string().required(\"Required\"),\r\n// });\r\n\r\nexport default function Companies(props) {\r\n  const theme = useTheme();\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n\r\n  const [page] = useState(1);\r\n  const [items, setItems] = useState([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const [companies, setCompanies] = useState([]);\r\n  const [modal, setModal] = useState(false);\r\n  const [selectedItem] = useState(\"\");\r\n  const [firstName, setFirstName] = useState(\"\");\r\n  const [lastName, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [image, setImage] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [nameOfResponsible, setNameOfResponsible] = useState(\"\");\r\n  const [nameOfCompany, setNameOfCompany] = useState(\"\");\r\n\r\n  useEffect(() => {\r\n    getData();\r\n\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      console.log(adminStore.site.siteId._id);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_SITE_COMPANIES}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.companies);\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n  const handleChange = (name, value) => {\r\n    if (name === \"firstName\") setFirstName(value);\r\n    else if (name === \"lastName\") setLastName(value);\r\n    else if (name === \"phone\") setPhone(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"companyId\") setCompanyId(value);\r\n  };\r\n\r\n  const onUpdate = async (e) => {\r\n    try {\r\n      e.preventDefault();\r\n      setLoading(true);\r\n      var formdata = new FormData();\r\n      formdata.append(\"firstName\", firstName);\r\n      formdata.append(\"lastName\", lastName);\r\n      formdata.append(\"phone\", phone);\r\n      formdata.append(\"companyId\", companyId);\r\n      formdata.append(\"userId\", selectedItem._id);\r\n      image.file && formdata.append(\"image\", image.file);\r\n\r\n      const result = await GLOBALS.API({\r\n        method: \"PUT\",\r\n        uri: GLOBALS.Constants.ADMINS,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      const itemsArray = items.map((item) =>\r\n        item._id === selectedItem._id ? result.data : item,\r\n      );\r\n      setItems(itemsArray);\r\n      setLoading(false);\r\n      setModal(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getSubContractors = (subcontractors) => {\r\n    if (subcontractors && subcontractors.length > 0) {\r\n      const value = subcontractors\r\n        .map((item, index) => {\r\n          if (item.name != undefined) return item.name;\r\n          return \"N/A\";\r\n        })\r\n        .toString()\r\n        .replace(/,/g, \" \");\r\n      return value;\r\n    }\r\n    return \"N/A\";\r\n  };\r\n\r\n  const filterCompany = async () => {\r\n    try {\r\n      setLoading(true);\r\n      const params = { siteId: \"6008169bedbb7816d40b197d\" };\r\n      if (nameOfCompany.length !== 0) params[\"companyName\"] = nameOfCompany;\r\n      if (nameOfResponsible.length !== 0)\r\n        params[\"responsibleName\"] = nameOfResponsible;\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.FILTER_COMPANY_SITES}`,\r\n        token: store.token,\r\n        method: \"POST\",\r\n        body: JSON.stringify(params),\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.companies);\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const rows = companies.map((item) => {\r\n    return [\r\n      <img src={Images.site} alt=\"Icon\" />,\r\n      item.companyId.name,\r\n      getSubContractors(item.subContractors),\r\n      item.companyId.incharge != undefined\r\n        ? item.companyId.incharge.firstName +\r\n          \" \" +\r\n          item.companyId.incharge.lastName\r\n        : \"N/A\",\r\n      item.companyId.incharge != undefined\r\n        ? item.companyId.incharge.phone\r\n        : \"N/A\",\r\n      item.companyId.incharge != undefined\r\n        ? item.companyId.incharge.email\r\n        : \"N/A\",\r\n\r\n      <div>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <NavLink\r\n            to={{\r\n              pathname: \"/companies/user-list\",\r\n              id: item.companyId._id,\r\n            }}\r\n          >\r\n            <img\r\n              src={Images.comapnies}\r\n              style={{ width: 18, height: 17 }}\r\n              alt=\"Icon\"\r\n            />\r\n          </NavLink>\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <NavLink\r\n            to={{\r\n              pathname: \"/companies/edit-companies\",\r\n              id: item.companyId._id,\r\n            }}\r\n          >\r\n            <Pencil style={{ width: 18, height: 15 }} />\r\n          </NavLink>\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <img\r\n            src={Images.calender}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <img\r\n            src={Images.invoices}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <img\r\n            src={Images.incidents}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </IconButton>\r\n      </div>,\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <>\r\n      <div className={classes.root}>\r\n        <Form.Row alignItems=\"center\" className=\"pr-3\">\r\n          <Heading primary=\"LIST OF COMPANIES\" noWrap />\r\n          <div>\r\n            <Form.Row alignItems=\"center\" noMargin>\r\n              <SubHeading\r\n                disableMargin\r\n                primary={`Total : ${companies.length} COMPANIES`}\r\n                bold\r\n              />\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"ADD A COMPANY\"\r\n                style={{ marginLeft: \"20px\" }}\r\n                to={\"/companies/add-companies\"}\r\n              />\r\n            </Form.Row>\r\n          </div>\r\n        </Form.Row>\r\n        <Form.Row noMargin className=\"pr-3\">\r\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\r\n            <SearchInput\r\n              placeholder=\"Name of responsible\"\r\n              value={nameOfResponsible}\r\n              onClick={() => {\r\n                filterCompany();\r\n              }}\r\n              onChange={(event) => {\r\n                setNameOfResponsible(event.target.value);\r\n              }}\r\n            />\r\n            <SearchInput\r\n              style={{ marginLeft: \"20px\" }}\r\n              placeholder=\"Name of company\"\r\n              value={nameOfCompany}\r\n              onClick={() => {\r\n                filterCompany();\r\n              }}\r\n              onChange={(event) => {\r\n                setNameOfCompany(event.target.value);\r\n              }}\r\n            />\r\n            <a href=\"#companies\">\r\n              <img\r\n                style={{\r\n                  width: \"1.3rem\",\r\n                  marginLeft: \"20px\",\r\n                  marginTop: \"10px\",\r\n                }}\r\n                src={uploadIcon}\r\n                alt=\"File Upload Icon\"\r\n              />\r\n            </a>\r\n          </Form.Row>\r\n          <Button\r\n            fullWidth={true}\r\n            component={NavLink}\r\n            text=\"ACCESS REQUEST TO ZONES\"\r\n            style={{ width: \"330px\" }}\r\n            to={\"/admins/add-admin\"}\r\n          />\r\n        </Form.Row>\r\n        <div className={classes.content}>\r\n          <Table headers={GLOBALS.Data.companies.headings} rows={rows} />\r\n        </div>\r\n      </div>\r\n      <Modal\r\n        title=\"EDIT ADMIN\"\r\n        open={selectedItem ? modal : false}\r\n        onClose={() => setModal((st) => !st)}\r\n        body={\r\n          <Form.Form onSubmit={onUpdate}>\r\n            <Form.Row justifyContent=\"center\">\r\n              <AvatarUpload\r\n                value={image}\r\n                // error={image}\r\n                onChange={(file) => {\r\n                  const uri = URL.createObjectURL(file);\r\n                  handleChange(\"image\", { file, uri });\r\n                }}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"firstName\"\r\n                value={firstName}\r\n                // error={firstName}\r\n                placeholder=\"First Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"lastName\"\r\n                value={lastName}\r\n                // error={lastName}\r\n                placeholder=\"Last Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"phone\"\r\n                placeholder=\"Phone Number\"\r\n                value={phone}\r\n                // error={phone}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                style={GLOBALS.Styles.inputWidth}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormSelect\r\n                name=\"companyId\"\r\n                value={companyId}\r\n                // error={companyId}\r\n                values={companies}\r\n                placeholder=\"Company Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Column alignItems=\"center\">\r\n              <Form.Row justifyContent=\"center\">\r\n                <Button\r\n                  type=\"submit\"\r\n                  minWidth={200}\r\n                  text=\"VALIDATE\"\r\n                  fullWidth={false}\r\n                  loading={loading}\r\n                  disabled={\r\n                    loading ||\r\n                    !firstName ||\r\n                    !lastName ||\r\n                    !phone ||\r\n                    image === \"\" ||\r\n                    !companyId\r\n                  }\r\n                />\r\n              </Form.Row>\r\n              <Form.Row justifyContent=\"center\">\r\n                <Button\r\n                  text=\"DELETE\"\r\n                  minWidth=\"30%\"\r\n                  fullWidth={false}\r\n                  disabled={loading || true}\r\n                  color={theme.palette.error.main}\r\n                />\r\n              </Form.Row>\r\n            </Form.Column>\r\n          </Form.Form>\r\n        }\r\n      />\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Incidents\\editIncidents.js",["629","630","631","632","633","634","635","636"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Incidents\\addIncidents.js",["637","638","639","640","641","642","643","644"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Incidents\\Incidents.js",["645","646","647","648","649","650","651","652"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\Constants.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\Styles.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\API.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\index.js",["653","654","655","656","657","658","659"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Organigramme\\EditContact.js",["660","661","662","663"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Organigramme\\AddContact.js",["664","665","666","667","668"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormSelect.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\ColorPcker.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\CustomInputModal.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormMultipleUpload.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormLabel.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\CustomFormInput.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\SearchInput.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Table.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\CustomButtonModal.js",[],"C:\\Use
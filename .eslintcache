rorCount":0,"fixableWarningCount":0,"source":"323","usedDeprecatedRules":"168"},{"filePath":"324","messages":"325","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"326","usedDeprecatedRules":"168"},{"filePath":"327","messages":"328","errorCount":0,"warningCount":9,"fixableErrorCount":0,"fixableWarningCount":0,"source":"329","usedDeprecatedRules":"168"},{"filePath":"330","messages":"331","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"332","usedDeprecatedRules":"168"},{"filePath":"333","messages":"334","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"335","usedDeprecatedRules":"168"},{"filePath":"336","messages":"337","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"338","usedDeprecatedRules":"168"},{"filePath":"339","messages":"340","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"168"},"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/index.js",[],["341","342"],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/App.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/reportWebVitals.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/globals/i18n.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/redux/Notifier.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/redux/store.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/container/Main.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/ErrorBoundary.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Loader.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/redux/actions/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/redux/reducers/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/UnAuth/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/redux/actions/auth.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/redux/actions/notistack.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/redux/reducers/auth.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/redux/reducers/notistack.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Logs.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Home.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/SuperAdminHeader.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/UnAuth/Login.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/UnAuth/LandingPage.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/UnAuth/ForgotPassword.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Clients/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Admins/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/redux/actions/actionTypes.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/redux/utility.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Heading.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/SubHeading.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/SmallText.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Button.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Input.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Form.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/UnAuth/UnAuthHeader.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Footer.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/globals/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/ArchivedSites.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Admins/AddAdmin.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Admins/Admins.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Clients/AddInvoice.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Clients/VerifyClient.js",["343"],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Clients/Clients.js",["344"],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Clients/Invoices.js",["345"],"import React, { useState, useEffect } from \"react\";\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport moment from \"moment\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\nimport GLOBALS from \"../../../globals\";\nimport Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\nimport { ReactComponent as Cross } from \"../../../assets/icons/Cross.svg\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n}));\n\nexport default function Invoices(props) {\n  const classes = useStyles();\n\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [loading, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n  const [page] = useState(1);\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.INVOICES}/${props.match.params.clientId}?page=${page}`,\n      });\n      setItems(result.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  async function onDelete(itemId) {\n    try {\n      if (window.confirm(\"Are you sure, you want to delete this?\")) {\n        setLoading(true);\n        await GLOBALS.API({\n          method: \"DELETE\",\n          token: store.token,\n          uri: GLOBALS.Constants.INVOICE_DELETE + \"/\" + itemId,\n        });\n        const itemsArray = items.filter((item) => item._id !== itemId);\n        setItems(itemsArray);\n        setLoading(false);\n      }\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const rows = items.map((item) => [\n    item.clientId.companyId.name,\n    moment(item.startDate).format(\"DD/MM/YYYY\"),\n    moment(item.endDate).format(\"DD/MM/YYYY\"),\n    item.siteId.name,\n    item.amount,\n    item.description,\n    <>\n      <IconButton>\n        <Pencil style={{ width: 18, height: 18 }} />\n      </IconButton>\n      <IconButton onClick={() => onDelete(item._id)}>\n        <Cross style={{ width: 18, height: 18, color: \"red\" }} />\n      </IconButton>\n    </>,\n  ]);\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n      <Form.Row alignItems=\"center\">\n        <Heading primary=\"INVOICES\" noWrap />\n        <Button\n          fullWidth={false}\n          component={NavLink}\n          text=\"CREATE AN INVOICE\"\n          to=\"/clients/add-invoice\"\n        />\n      </Form.Row>\n      <Form.Row noMargin>\n        <FormSelect\n          placeholder=\"Client\"\n          values={[\n            { value: \"green\", label: \"Green\" },\n            { value: \"Yellow\", label: \"Yellow\" },\n            { value: \"Red\", label: \"Red\" },\n            { value: \"Blue\", label: \"Blue\" },\n            { value: \"Orange\", label: \"Orange\" },\n            { value: \"Purple\", label: \"Purple\" },\n            { value: \"Magenta\", label: \"Magenta\" },\n          ]}\n          style={{ maxWidth: 250 }}\n        />\n      </Form.Row>\n      <div className={classes.content}>\n        <Table headers={GLOBALS.Data.invoices.headings} rows={rows} />\n      </div>\n    </div>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Clients/AddClient.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/Sites.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/ZACs.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddZAC.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Card.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/globals/Styles.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/globals/API.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/globals/Constants.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Table.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/SmallButton.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/SearchInput.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/FormLabel.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/FormMultipleUpload.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/FormInput.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/FormSelect.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Modal.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/AvatarUpload.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Stepper.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep3.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep2.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep1.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/MultiAdderInput.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/RadioButton.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/MultiAdderInputModal.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/OpeningTimes.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/UnavailabilityTimes.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/index.js",["346"],"import React from \"react\";\nimport { Switch, Route, Redirect } from \"react-router-dom\";\nimport AdminHeader from \"./AdminHeader\";\nimport Calender from \"./Calender/Calender\";\nimport Comapnies from \"./Companies/Companies\";\nimport Incidents from \"./Incidents/Incidents\";\nimport Invoices from \"./Invoices/Invoices\";\nimport Means from \"./Means/Means\";\nimport Organigramme from \"./Organigramme/Organigramme\";\nimport Pic from \"./Pic/Pic\";\n\nimport Home from \"./Home\";\n\nexport default function UnAuth() {\n  return (\n    <>\n      <AdminHeader>\n        <Switch>\n          <Route exact path=\"/\" component={Calender} />\n          <Route exact path=\"/calender\" component={Calender} />\n          <Route exact path=\"/comapnies\" component={Comapnies} />\n          <Route exact path=\"/incidents\" component={Incidents} />\n          <Route exact path=\"/invoices\" component={Invoices} />\n          <Route exact path=\"/means\" component={Means} />\n          <Route exact path=\"/organigramme\" component={Organigramme} />\n          <Route exact path=\"/pic-interactive\" component={Pic} />\n          <Redirect from=\"*\" to=\"/\" />\n        </Switch>\n      </AdminHeader>\n    </>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Home.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/AdminHeader.js",["347","348"],"import React, { useState } from \"react\";\nimport clsx from \"clsx\";\nimport Fab from \"@material-ui/core/Fab\";\nimport List from \"@material-ui/core/List\";\nimport Drawer from \"@material-ui/core/Drawer\";\nimport MenuIcon from \"@material-ui/icons/Menu\";\nimport ListItem from \"@material-ui/core/ListItem\";\n// import ExitToAppIcon from \"@material-ui/icons/ExitToApp\";\nimport ListItemIcon from \"@material-ui/core/ListItemIcon\";\nimport ListItemText from \"@material-ui/core/ListItemText\";\nimport { useDispatch } from \"react-redux\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport { NavLink, useLocation } from \"react-router-dom\";\n\n// import Actions from \"../../redux/actions\";\nimport Logo from \"../../assets/icons/Logo.svg\";\nimport { ReactComponent as Calender } from \"../../assets/icons/calender.svg\";\nimport { ReactComponent as Means } from \"../../assets/icons/means.svg\";\nimport { ReactComponent as Invoices } from \"../../assets/icons/invoices.svg\";\nimport { ReactComponent as Incidents } from \"../../assets/icons/incidents.svg\";\nimport { ReactComponent as Organigramme } from \"../../assets/icons/organigramme.svg\";\nimport { ReactComponent as Companies } from \"../../assets/icons/companies.svg\";\nimport { ReactComponent as Pic } from \"../../assets/icons/pic.svg\";\n\nimport {Images} from \"../../assets/Assets.js\";\n\nconst drawerWidth = 240;\n\nconst useStyles = makeStyles((theme) => ({\n  root: { maxWidth: \"100vw\", overflow: \"hidden\" },\n  drawer: {\n    width: drawerWidth,\n    flexShrink: 0,\n  },\n  drawerPaper: {\n    width: drawerWidth,\n    border: \"none\",\n  },\n  drawerContainer: {\n    height: \"100%\",\n    overflow: \"auto\",\n    backgroundColor: theme.palette.secondary.main,\n  },\n  logoContainer: {\n    width: \"100%\",\n    height: \"140px\",\n    display: \"grid\",\n    placeItems: \"center\",\n  },\n  logo: {\n    width: \"126px\",\n    height: \"121px\",\n  },\n  listItemSelected: {\n    color: theme.palette.primary.main,\n  },\n  listItemIcon: {\n    justifyContent: \"center\",\n    marginRight: 15,\n  },\n  content: {\n    width: \"100vw\",\n    paddingLeft: 0,\n    paddingTop: 50,\n    backgroundColor: \"#fff\",\n    transition: theme.transitions.create(\"padding\", {\n      easing: theme.transitions.easing.sharp,\n      duration: theme.transitions.duration.leavingScreen,\n    }),\n    position: \"relative\",\n  },\n  contentShift: {\n    width: \"100vw\",\n    transition: theme.transitions.create(\"padding\", {\n      easing: theme.transitions.easing.easeOut,\n      duration: theme.transitions.duration.enteringScreen,\n    }),\n    paddingLeft: drawerWidth,\n  },\n  menuButton: {\n    position: \"absolute\",\n    margin: \"10px 14px\",\n    top: 0,\n  },\n  imageContainer: {\n    display: \"flex\",\n    flexDirection: \"column\",\n    alignItems: \"center\",\n    marginTop: \"1.5rem\",\n    marginBottom: \"1rem\"\n\n  }\n}));\n\nconst userItems = [\n  // {\n  //   name: \"Home\",\n  //   path: [\"/\", \"/home\"],\n  //   icon: <HomeIcon />,\n  // },\n  {\n    name: \"Calender\",\n    path: \"/calender\",\n    icon: <Calender />,\n  },\n  {\n    name: \"Comapnies\",\n    path: \"/comapnies\",\n    icon: <Companies />,\n  },\n  {\n    name: \"Incidents\",\n    path: \"/incidents\",\n    icon: <Incidents />,\n  },\n  {\n    name: \"Invoices\",\n    path: \"/invoices\",\n    icon: <Invoices />,\n  },\n  {\n    name: \"Means\",\n    path: \"/means\",\n    icon: <Means />,\n  },\n  {\n    name: \"Organigramme\",\n    path: \"/organigramme\",\n    icon: <Organigramme />,\n  },\n  {\n    name: \"P.I.C intéractif\",\n    path: \"/pic-interactive\",\n    icon: <Pic />,\n  },\n  // {\n  //   name: \"Logs\",\n  //   path: \"/logs\",\n  //   icon: <Logs />,\n  // },\n  // {\n  //   name: \"List of Admins\",\n  //   path: \"/admins\",\n  //   icon: <Admins />,\n  // },\n];\n\nexport default function AdminHeader(props) {\n  const classes = useStyles();\n  const location = useLocation();\n  const dispatch = useDispatch();\n\n  const [open, setOpen] = useState(false);\n\n  const handleDrawer = () => {\n    setOpen((st) => !st);\n  };\n\n  return (\n    <div className={classes.root}>\n      <Drawer\n        className={classes.drawer}\n        variant=\"persistent\"\n        anchor=\"left\"\n        open={open}\n        classes={{\n          paper: classes.drawerPaper,\n        }}\n      >\n        <div className={classes.drawerContainer}>\n          <div className={classes.logoContainer}>\n            <img src={Logo} alt=\"Orgaplan-Logo\" className={classes.logo} />\n          </div>\n          <div className={classes.imageContainer}>\n            <div style={{color: \"#7E7878\", fontWeight: \"bold\", fontSize: \"16px\", marginBottom: \"5px\"}}>Hôpital de la Tourelle</div>\n            <img src={Images.site} />\n\n          </div>\n          <List>\n            {userItems.map((item) => (\n              <ListItem\n                button\n                key={item.name}\n                component={NavLink}\n                to={Array.isArray(item.path) ? item.path[0] : item.path}\n                className={clsx({\n                  [classes.listItemSelected]: Array.isArray(item.path)\n                    ? item.path.some((it) => it === location.pathname)\n                    : location.pathname.startsWith(item.path),\n                })}\n              >\n                <ListItemIcon\n                  className={clsx(classes.listItemIcon, {\n                    [classes.listItemSelected]: Array.isArray(item.path)\n                      ? item.path.some((it) => it === location.pathname)\n                      : location.pathname.startsWith(item.path),\n                  })}\n                >\n\n                  {item.icon}\n                </ListItemIcon>\n                <ListItemText primary={item.name} />\n              </ListItem>\n            ))}\n            {/* <ListItem\n              button\n              key={\"logout\"}\n              onClick={() => dispatch(Actions.auth.do_logout())}\n            >\n              <ListItemIcon className={classes.listItemIcon}>\n                {<ExitToAppIcon />}\n              </ListItemIcon>\n              <ListItemText primary={\"Logout\"} />\n            </ListItem> */}\n          </List>\n        </div>\n      </Drawer>\n\n      <main\n        className={clsx(classes.content, {\n          [classes.contentShift]: open,\n        })}\n      >\n        <Fab\n          color=\"inherit\"\n          aria-label=\"handle-drawer\"\n          onClick={handleDrawer}\n          className={classes.menuButton}\n        >\n          <MenuIcon color=\"primary\" />\n        </Fab>\n        {props.children}\n      </main>\n    </div>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Organigramme/Organigramme.js",["349"],"import React from 'react';\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n\nconst useStyles = makeStyles((theme) => ({\n    root: {\n      padding: GLOBALS.Styles.pagePadding,\n    },\n    content: {\n      overflow: \"hidden\",\n      borderRadius: theme.shape.borderRadius,\n      padding: GLOBALS.Styles.pageContentPadding,\n      marginTop: GLOBALS.Styles.pageContentMargin,\n      backgroundColor: theme.palette.secondary.main,\n    },\n  }));\n\nconst Organigramme = () => {\n    const classes = useStyles();\n    return (\n        <div  className={classes.root}>\n            Organigramme\n        </div>\n    )\n}\n\nexport default Organigramme\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Means/Means.js",["350","351","352"],"import React, { useState, useEffect } from \"react\";\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\nimport * as Yup from \"yup\";\n\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\n\nimport { useFormik } from \"formik\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\n// import Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SmallButton from \"../../../components/SmallButton\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport FormInput from \"../../../components/FormInput\";\n\n\nimport SiteImage from \"../../../assets/images/Site.png\";\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  link: {\n    marginRight: 20,\n    whiteSpace: \"nowrap\",\n    color: theme.palette.primary.contrastText,\n  },\n  image: {\n    height: 70,\n    borderRadius: theme.shape.borderRadius,\n  },\n}));\n\nconst addClientYup = Yup.object().shape({\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\n  name: Yup.string().required(\"Required\"),\n  color: Yup.string().required(\"Required\"),\n  firstName: Yup.string().required(\"Required\"),\n  lastName: Yup.string().required(\"Required\"),\n  email: Yup.string().required(\"Required\"),\n  phone: Yup.number()\n    .test(\n      \"len\",\n      \"Must be exactly 10 characters\",\n      (val) => val && val.toString().length === 10,\n    )\n    .required(\"Required\"),\n  contractType: Yup.string().required(\"Required\"),\n  contractStartDate: Yup.string().required(\"Required\"),\n  contractEndDate: Yup.string().required(\"Required\"),\n  functionality: Yup.string().required(\"Required\"),\n  additionalInfo: Yup.string(),\n  notificationPriorToDays: Yup.number(),\n  notificationTo: Yup.array(),\n});\n\nconst Means = () => {\n  const classes = useStyles();\n  const theme = useTheme();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [loading, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n  const [page] = useState(1);\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.SITE}?page=${page}`,\n      });\n      setItems(result.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const rows = items.map((item) => [\n    <img\n      src={item.logo ? GLOBALS.Constants.BASE_URL + item.logo : SiteImage}\n      alt=\"siteimage\"\n      className={classes.image}\n    />,\n    item.name,\n    item.zacId ? item.zacId.name : \"N/A\",\n    `${item.adminId.userId.firstName} ${item.adminId.userId.lastName}`,\n    item.status,\n    <Form.Row alignItems=\"center\" justifyContent=\"center\">\n      <IconButton>\n        <Pencil style={{ width: 18, height: 18 }} />\n      </IconButton>\n      <SmallButton\n        text=\"Archive\"\n        disabled={loading}\n        onClick={() => onArchive(item._id)}\n        color={theme.palette.primary.contrastText}\n        style={{\n          marginLeft: 10,\n          borderRadius: 4,\n        }}\n      />\n    </Form.Row>,\n  ]);\n\n  async function onArchive(itemId) {\n    try {\n      if (window.confirm(\"Are you sure, you want to do this?\")) {\n        setLoading(true);\n        await GLOBALS.API({\n          method: \"PUT\",\n          token: store.token,\n          uri: GLOBALS.Constants.SITE_ARCHIVE + \"/\" + itemId,\n        });\n        const itemsArray = items.filter((item) => item._id !== itemId);\n        setItems(itemsArray);\n        setLoading(false);\n      }\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const formik = useFormik({\n    initialValues: {\n     \n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    // validationSchema: addClientYup,\n    // onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row alignItems=\"center\">\n        <Heading primary=\"LIST OF MEANS\" noWrap />\n        <div>\n          <Form.Row\n            alignItems=\"flex-start\"\n            noMargin\n            justifyContent=\"flex-end\"\n            style={{ paddingRight: \"50px\" }}\n          >\n            <SubHeading\n              disableMargin\n              topPadding\n              primary=\"TOTAL : 54 means\"\n              bold\n            />\n            <Form.Column style={{ width: \"50%\" }}>\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"ADD A MEAN\"\n                to={\"/sites/add-mean\"}\n                style={{\n                  marginLeft: \"20px\",\n                  marginBottom: \"7px\",\n                  width: \"200px\",\n                }}\n              />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"MEANS REQUEST\"\n                to={\"/sites/means-request\"}\n                style={{ marginLeft: \"20px\", width: \"200px\" }}\n              />\n            </Form.Column>\n          </Form.Row>\n        </div>\n      </Form.Row>\n      <Form.Row alignItems=\"center\" noMargin>\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          {/* <SearchInput\n            placeholder=\"Site name\"\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          /> */}\n          <FormSelect\n            placeholder=\"Delivery area\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Location\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Level\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Storage area\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Type\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\n          See archived sites\n        </NavLink> */}\n\n        \n      </Form.Row>\n\n      <Form.Row alignItems=\"center\" noMargin className=\"mt-3\">\n      <Form.Row justifyContent=\"flex-start\" noMargin>\n          <FormSelect\n            placeholder=\"Company\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Location\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormInput\n                type=\"date\"\n                style={GLOBALS.Styles.inputWidth}\n                placeholder=\"Start date\"\n                name=\"contractStartDate\"\n                icon\n                onChange={formik.handleChange}\n                // value={formik.values.contractStartDate}\n                // error={formik.errors.contractStartDate}\n                style={{ marginRight: \"20px\", maxWidth: 250 }}\n              />\n         <FormInput\n                type=\"date\"\n                style={GLOBALS.Styles.inputWidth}\n                placeholder=\"End date\"\n                name=\"contractStartDate\"\n                icon\n                onChange={formik.handleChange}\n                // value={formik.values.contractStartDate}\n                // error={formik.errors.contractStartDate}\n                style={{ marginRight: \"20px\", maxWidth: 250 }}\n              />\n           <SearchInput\n            placeholder=\"Mean name\"\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        </Form.Row>\n      <div className={classes.content}>\n        <Table headers={GLOBALS.Data.means.headings} rows={rows} />\n      </div>\n    </div>\n  );\n};\n\nexport default Means;\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Invoices/Invoices.js",["353"],"import React from 'react';\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n\nconst useStyles = makeStyles((theme) => ({\n    root: {\n      padding: GLOBALS.Styles.pagePadding,\n    },\n    content: {\n      overflow: \"hidden\",\n      borderRadius: theme.shape.borderRadius,\n      padding: GLOBALS.Styles.pageContentPadding,\n      marginTop: GLOBALS.Styles.pageContentMargin,\n      backgroundColor: theme.palette.secondary.main,\n    },\n  }));\n\nconst Invoices = () => {\n    const classes = useStyles();\n    return (\n        <div  className={classes.root}>\n            Invoices\n        </div>\n    )\n}\n\nexport default Invoices\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Pic/Pic.js",["354","355","356","357","358","359","360","361","362"],"import React, { useState, useEffect } from \"react\";\nimport './Pic.css';\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\nimport * as Yup from \"yup\";\n\n\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\n\nimport { useFormik } from \"formik\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport {Images} from \"../.../../../../assets/Assets\";\n\n// import Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SmallButton from \"../../../components/SmallButton\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport FormInput from \"../../../components/FormInput\";\n\n\nimport SiteImage from \"../../../assets/images/Site.png\";\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  link: {\n    marginRight: 20,\n    whiteSpace: \"nowrap\",\n    color: theme.palette.primary.contrastText,\n  },\n  image: {\n    height: 70,\n    borderRadius: theme.shape.borderRadius,\n  },\n}));\n\nconst addClientYup = Yup.object().shape({\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\n  name: Yup.string().required(\"Required\"),\n  color: Yup.string().required(\"Required\"),\n  firstName: Yup.string().required(\"Required\"),\n  lastName: Yup.string().required(\"Required\"),\n  email: Yup.string().required(\"Required\"),\n  phone: Yup.number()\n    .test(\n      \"len\",\n      \"Must be exactly 10 characters\",\n      (val) => val && val.toString().length === 10,\n    )\n    .required(\"Required\"),\n  contractType: Yup.string().required(\"Required\"),\n  contractStartDate: Yup.string().required(\"Required\"),\n  contractEndDate: Yup.string().required(\"Required\"),\n  functionality: Yup.string().required(\"Required\"),\n  additionalInfo: Yup.string(),\n  notificationPriorToDays: Yup.number(),\n  notificationTo: Yup.array(),\n});\n\nconst Pic = () => {\n  const classes = useStyles();\n  const theme = useTheme();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [loading, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n  const [page] = useState(1);\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.SITE}?page=${page}`,\n      });\n      setItems(result.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const rows = items.map((item) => [\n    <img\n      src={item.logo ? GLOBALS.Constants.BASE_URL + item.logo : SiteImage}\n      alt=\"siteimage\"\n      className={classes.image}\n    />,\n    item.name,\n    item.zacId ? item.zacId.name : \"N/A\",\n    `${item.adminId.userId.firstName} ${item.adminId.userId.lastName}`,\n    item.status,\n    <Form.Row alignItems=\"center\" justifyContent=\"center\">\n      <IconButton>\n        <Pencil style={{ width: 18, height: 18 }} />\n      </IconButton>\n      <SmallButton\n        text=\"Archive\"\n        disabled={loading}\n        onClick={() => onArchive(item._id)}\n        color={theme.palette.primary.contrastText}\n        style={{\n          marginLeft: 10,\n          borderRadius: 4,\n        }}\n      />\n    </Form.Row>,\n  ]);\n\n  async function onArchive(itemId) {\n    try {\n      if (window.confirm(\"Are you sure, you want to do this?\")) {\n        setLoading(true);\n        await GLOBALS.API({\n          method: \"PUT\",\n          token: store.token,\n          uri: GLOBALS.Constants.SITE_ARCHIVE + \"/\" + itemId,\n        });\n        const itemsArray = items.filter((item) => item._id !== itemId);\n        setItems(itemsArray);\n        setLoading(false);\n      }\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const formik = useFormik({\n    initialValues: {\n     \n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    // validationSchema: addClientYup,\n    // onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row alignItems=\"center\">\n        <Heading primary=\"PIC\" noWrap />\n       \n      </Form.Row>\n\n      \n\n      <Form.Row alignItems=\"center\" noMargin className=\"mt-3\">\n      <Form.Row justifyContent=\"flex-start\" noMargin>\n          <FormSelect\n            placeholder=\"Select a building\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Select a level\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        </Form.Row>\n      <div className=\"admin-pic\">\n        <div className=\"admin-pic-image\">\n<img src={Images.picMap} />\n        </div>\n        <div className=\"admin-pic-content\">\n        <Button\n                fullWidth={false}\n                component={NavLink}\n               \n                text=\"EDIT THIS MAP\"\n                to={\"/sites/add-mean\"}\n                style={{\n                  marginLeft: \"10px\",\n                  marginBottom: \"7px\",\n                  width: \"270px\",\n                  fontWeight: \"bold\",\n                  textAlign: \"center\"\n                  \n                }}\n              />\n               <Button\n                fullWidth={false}\n                component={NavLink}\n               \n                text=\"EDIT THE PLAN\"\n                to={\"/sites/add-mean\"}\n                style={{\n                  marginLeft: \"10px\",\n                  marginBottom: \"7px\",\n                  width: \"270px\",\n                  fontWeight: \"bold\",\n                  textAlign: \"center\",\n                  marginTop: \"1.5rem\",\n                  \n                }}\n              />\n              <div className=\"admin-pic-content-historic\">\n              Historic of the plans\n              </div>\n<img src={Images.mapIcon} className=\"admin-pic-map-icon\" />\n\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Pic;\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Companies/Companies.js",["363"],"import React from 'react';\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\nimport SubHeading from \"../../../components/SubHeading\";\n\n\nimport { NavLink } from \"react-router-dom\";\n\n\nimport Form from \"../../../components/Form\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\n\n\nconst useStyles = makeStyles((theme) => ({\n    root: {\n      padding: GLOBALS.Styles.pagePadding,\n    },\n    content: {\n      overflow: \"hidden\",\n      borderRadius: theme.shape.borderRadius,\n      padding: GLOBALS.Styles.pageContentPadding,\n      marginTop: GLOBALS.Styles.pageContentMargin,\n      backgroundColor: theme.palette.secondary.main,\n    },\n  }));\n\nconst Companies = () => {\n    const classes = useStyles();\n    return (\n        <div  className={classes.root}>\n            <Form.Row alignItems=\"center\">\n          <Heading primary=\"CLIENTS LIST\" noWrap />\n          <div>\n            <Form.Row alignItems=\"center\" noMargin>\n              <SubHeading disableMargin primary=\"Total : 234 Clients\" bold />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"CREATE A CLIENT\"\n                style={{ marginLeft: \"20px\" }}\n                to={\"/clients/add-client\"}\n              />\n            </Form.Row>\n          </div>\n        </Form.Row>\n        </div>\n    )\n}\nexport default Companies\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Calender/Calender.js",["364"],"import React from 'react';\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n\nconst useStyles = makeStyles((theme) => ({\n    root: {\n      padding: GLOBALS.Styles.pagePadding,\n    },\n    content: {\n      overflow: \"hidden\",\n      borderRadius: theme.shape.borderRadius,\n      padding: GLOBALS.Styles.pageContentPadding,\n      marginTop: GLOBALS.Styles.pageContentMargin,\n      backgroundColor: theme.palette.secondary.main,\n    },\n  }));\n\nconst Calender = () => {\n    const classes = useStyles();\n    return (\n        <div  className={classes.root}>\n            calender\n        </div>\n    )\n}\n\nexport default Calender\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/Admin/Incidents/Incidents.js",["365","366","367","368"],"import React, { useState, useEffect } from \"react\";\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\nimport * as Yup from \"yup\";\n\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\n\nimport { useFormik } from \"formik\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\n// import Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SmallButton from \"../../../components/SmallButton\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport FormInput from \"../../../components/FormInput\";\nimport {Images} from \"../../../assets/Assets\";\n\nimport SiteImage from \"../../../assets/images/Site.png\";\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  link: {\n    marginRight: 20,\n    whiteSpace: \"nowrap\",\n    color: theme.palette.primary.contrastText,\n  },\n  image: {\n    height: 70,\n    borderRadius: theme.shape.borderRadius,\n  },\n}));\n\nconst addClientYup = Yup.object().shape({\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\n  name: Yup.string().required(\"Required\"),\n  color: Yup.string().required(\"Required\"),\n  firstName: Yup.string().required(\"Required\"),\n  lastName: Yup.string().required(\"Required\"),\n  email: Yup.string().required(\"Required\"),\n  phone: Yup.number()\n    .test(\n      \"len\",\n      \"Must be exactly 10 characters\",\n      (val) => val && val.toString().length === 10,\n    )\n    .required(\"Required\"),\n  contractType: Yup.string().required(\"Required\"),\n  contractStartDate: Yup.string().required(\"Required\"),\n  contractEndDate: Yup.string().required(\"Required\"),\n  functionality: Yup.string().required(\"Required\"),\n  additionalInfo: Yup.string(),\n  notificationPriorToDays: Yup.number(),\n  notificationTo: Yup.array(),\n});\n\nconst Incidents = () => {\n  const classes = useStyles();\n  const theme = useTheme();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [loading, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n  const [page] = useState(1);\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.SITE}?page=${page}`,\n      });\n      setItems(result.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const rows = items.map((item) => [\n    <img\n      src={item.logo ? GLOBALS.Constants.BASE_URL + item.logo : SiteImage}\n      alt=\"siteimage\"\n      className={classes.image}\n    />,\n    item.name,\n    item.zacId ? item.zacId.name : \"N/A\",\n    `${item.adminId.userId.firstName} ${item.adminId.userId.lastName}`,\n    item.status,\n    <Form.Row alignItems=\"center\" justifyContent=\"center\">\n      <IconButton>\n        <Pencil style={{ width: 18, height: 18 }} />\n      </IconButton>\n      <SmallButton\n        text=\"Archive\"\n        disabled={loading}\n        onClick={() => onArchive(item._id)}\n        color={theme.palette.primary.contrastText}\n        style={{\n          marginLeft: 10,\n          borderRadius: 4,\n        }}\n      />\n    </Form.Row>,\n  ]);\n\n  async function onArchive(itemId) {\n    try {\n      if (window.confirm(\"Are you sure, you want to do this?\")) {\n        setLoading(true);\n        await GLOBALS.API({\n          method: \"PUT\",\n          token: store.token,\n          uri: GLOBALS.Constants.SITE_ARCHIVE + \"/\" + itemId,\n        });\n        const itemsArray = items.filter((item) => item._id !== itemId);\n        setItems(itemsArray);\n        setLoading(false);\n      }\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const formik = useFormik({\n    initialValues: {\n     \n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    // validationSchema: addClientYup,\n    // onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row alignItems=\"center\">\n        <Heading icon primary=\"RE-INVOICING\" noWrap />\n        <div>\n          <Form.Row\n            alignItems=\"flex-start\"\n            noMargin\n            justifyContent=\"flex-end\"\n            style={{ paddingRight: \"50px\" }}\n          >\n            <SubHeading\n              disableMargin\n              topPadding\n              style={{color: \"#F80303\"}}\n              \n              primary=\"TOTAL : 5 RE-INVOICING\n              345€ \n\"\n              bold\n            />\n            <Form.Column style={{ width: \"50%\" }}>\n              <Button\n                fullWidth={false}\n                component={NavLink}\n               \n                text=\"CREATE AN INCIDENT\"\n                to={\"/sites/add-mean\"}\n                style={{\n                  marginLeft: \"20px\",\n                  marginBottom: \"7px\",\n                  width: \"200px\",\n                  fontWeight: \"bold\",\n                  backgroundColor: \"#F80303\",\n                }}\n              />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"MEANS REQUEST\"\n                to={\"/sites/means-request\"}\n                style={{ marginLeft: \"20px\", width: \"200px\" }}\n              />\n            </Form.Column>\n          </Form.Row>\n        </div>\n      </Form.Row>\n      <Form.Row alignItems=\"center\" noMargin>\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          {/* <SearchInput\n            placeholder=\"Site name\"\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          /> */}\n          <FormSelect\n            placeholder=\"Delivery area\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Location\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Level\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Storage area\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Type\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\n          See archived sites\n        </NavLink> */}\n\n        \n      </Form.Row>\n\n      <Form.Row alignItems=\"center\" noMargin className=\"mt-3\">\n      <Form.Row justifyContent=\"flex-start\" noMargin>\n          <FormSelect\n            placeholder=\"Company\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          \n          <FormInput\n                type=\"date\"\n                style={GLOBALS.Styles.inputWidth}\n                placeholder=\"Start date\"\n                name=\"contractStartDate\"\n                icon\n                onChange={formik.handleChange}\n                // value={formik.values.contractStartDate}\n                // error={formik.errors.contractStartDate}\n                style={{ marginRight: \"20px\", maxWidth: 250 }}\n              />\n         <FormInput\n                type=\"date\"\n                style={GLOBALS.Styles.inputWidth}\n                placeholder=\"End date\"\n                name=\"contractStartDate\"\n                icon\n                onChange={formik.handleChange}\n                // value={formik.values.contractStartDate}\n                // error={formik.errors.contractStartDate}\n                style={{ marginRight: \"20px\", maxWidth: 250 }}\n              />\n              <FormSelect\n            placeholder=\"Status\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n           <SearchInput\n            placeholder=\"Designation\"\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        </Form.Row>\n      <div className={classes.content}>\n        <Table headers={GLOBALS.Data.incidents.headings} rows={rows} />\n      </div>\n    </div>\n  );\n};\n\nexport default Incidents;\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/assets/Assets.js",[],{"ruleId":"369","replacedBy":"370"},{"ruleId":"371","replacedBy":"372"},{"ruleId":"373","severity":1,"message":"374","line":62,"column":10,"nodeType":"375","messageId":"376","endLine":62,"endColumn":16},{"ruleId":"373","severity":1,"message":"374","line":71,"column":10,"nodeType":"375","messageId":"376","endLine":71,"endColumn":16},{"ruleId":"373","severity":1,"message":"377","line":39,"column":10,"nodeType":"375","messageId":"376","endLine":39,"endColumn":17},{"ruleId":"373","severity":1,"message":"378","line":12,"column":8,"nodeType":"375","messageId":"376","endLine":12,"endColumn":12},{"ruleId":"373","severity":1,"message":"379","line":151,"column":9,"nodeType":"375","messageId":"376","endLine":151,"endColumn":17},{"ruleId":"380","severity":1,"message":"381","line":176,"column":13,"nodeType":"382","endLine":176,"endColumn":38},{"ruleId":"373","severity":1,"message":"383","line":3,"column":22,"nodeType":"375","messageId":"376","endLine":3,"endColumn":30},{"ruleId":"373","severity":1,"message":"384","line":51,"column":7,"nodeType":"375","messageId":"376","endLine":51,"endColumn":19},{"ruleId":"385","severity":1,"message":"386","line":329,"column":17,"nodeType":"387","endLine":329,"endColumn":63},{"ruleId":"385","severity":1,"message":"386","line":340,"column":17,"nodeType":"387","endLine":340,"endColumn":63},{"ruleId":"373","severity":1,"message":"383","line":3,"column":22,"nodeType":"375","messageId":"376","endLine":3,"endColumn":30},{"ruleId":"373","severity":1,"message":"388","line":19,"column":8,"nodeType":"375","messageId":"376","endLine":19,"endColumn":13},{"ruleId":"373","severity":1,"message":"389","line":23,"column":8,"nodeType":"375","messageId":"376","endLine":23,"endColumn":18},{"ruleId":"373","severity":1,"message":"390","line":25,"column":8,"nodeType":"375","messageId":"376","endLine":25,"endColumn":19},{"ruleId":"373","severity":1,"message":"391","li
js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\events.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Pic\\Pic.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\globals\\Styles.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\globals\\API.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\globals\\Constants.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\SearchInput.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\index.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\FormSelect.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\FormMultipleUpload.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\FormLabel.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Form.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\index.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\AvatarUpload.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Table.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Modal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Pagination.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\index.js",["501","502","503","504","505","506","507"],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Stepper.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep3.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep2.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\components\\MyWorkWeek.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\components\\popoverModal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\components\\events.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep3.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep2.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep1.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\SmallButton.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\MultiAdderInput.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\OpeningTimes.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\UnavailabilityTimes.js",["508","509","510"],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\MultiAdderInputModal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\RadioButton.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Input.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep1.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\AddClient.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\Invoices.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\Clients.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\AddUser.js",["511","512","513","514","515","516","517","518","519","520"],"import React, { useState, useEffect } from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\r\nimport TextField from \"@material-ui/core/TextField\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  site: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n});\r\n\r\nexport default function AddUser(props) {\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [page] = useState(1);\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  const [roles, setRoles] = useState([]);\r\n  const [dropdownRoles, setDropdownRoles] = useState([]);\r\n  const [selectedRole, setSelectedRole] = useState(\"\");\r\n  const [selectedRoleIndex, setSelectedRoleIndex] = useState(null);\r\n\r\n  const [siteParams, setSiteParams] = useState([]);\r\n\r\n  const [users, setUsers] = useState([]);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n  }, []);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_USER}/${adminStore.site.siteId._id}/${store.user._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.site_companies.companies);\r\n        setRoles(response.data.site_companies.companies);\r\n        setUsers(response.data.users);\r\n        if (response.data.site_companies != null) {\r\n          const companyTemp = [];\r\n\r\n          response.data.site_companies.companies.map((item, index) => {\r\n            return companyTemp.push({ label: item.name, value: item.name });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n        if (response.data.roles != null) {\r\n          const rolesTemp = [];\r\n\r\n          response.data.roles.map((item, index) => {\r\n            return rolesTemp.push({ label: item, value: item });\r\n          });\r\n          setDropdownRoles(rolesTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getUserCompany = async (userId) => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_USER_COMPANY}/${adminStore.site.siteId._id}/${userId}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        console.log(JSON.stringify(response, null, 2));\r\n        if (response.data) {\r\n          companies.forEach((item, index) => {\r\n            if (item._id === response.data._id) {\r\n              item.users.forEach((innerItem, innerIndex) => {\r\n                console.log(\"innser \", innerItem.userId);\r\n                if (innerItem.userId === userId) {\r\n                  setSelectedRoleIndex(innerIndex);\r\n\r\n                  setSelectedRole(innerItem.role);\r\n                }\r\n              });\r\n              setSelectedCompanyIndex(index);\r\n\r\n              setSelectedCompany(item.name);\r\n            }\r\n          });\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const onSubmit = async () => {\r\n    const values = formik.values;\r\n    const sites = [];\r\n    siteParams.forEach((item) => {\r\n      sites.push({ siteId: item.id, role: selectedRole });\r\n    });\r\n    var formdata = new FormData();\r\n    formdata.append(\"image\", values.logo[0].file);\r\n    //formdata.append(\"name\", values.name);\r\n    formdata.append(\"firstName\", values.firstName);\r\n    formdata.append(\"lastName\", values.lastName);\r\n    formdata.append(\"email\", values.email);\r\n    formdata.append(\"phone\", values.phone);\r\n    formdata.append(\"sites\", JSON.stringify(sites));\r\n    formdata.append(\"companyId\", companies[selectedCompanyIndex]._id);\r\n\r\n    await GLOBALS.API({\r\n      method: \"POST\",\r\n      uri: GLOBALS.Constants.ADD_USER_ADMIN,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      logo: [],\r\n      name: \"\",\r\n      color: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      site: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n    },\r\n    validationSchema: addClientYup,\r\n    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"ADD USER\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={formik.handleSubmit}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"CONTACT INFO* :\" />\r\n            <Form.Row width=\"48%\">\r\n              {/* <FormInput\r\n                name=\"name\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                placeholder=\"Adresse e-mail\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.name}\r\n                error={formik.errors.name}\r\n              /> */}\r\n              <Autocomplete\r\n                id=\"free-solo-demo\"\r\n                freeSolo\r\n                style={{\r\n                  ...GLOBALS.Styles.inputWidth,\r\n                  marginRight: \"10px\",\r\n                }}\r\n                onSelect={(event) => {\r\n                  users.forEach((item, index) => {\r\n                    if (item.userId.email === event.target.value) {\r\n                      console.log(JSON.stringify(item.sites, null, 2));\r\n                      formik.setFieldValue(\"firstName\", item.userId.firstName);\r\n                      formik.setFieldValue(\"lastName\", item.userId.lastName);\r\n                      formik.setFieldValue(\"phone\", item.userId.phone);\r\n                      formik.setFieldValue(\"logo\", [\r\n                        { uri: item.userId.image },\r\n                      ]);\r\n\r\n                      getUserCompany(item.userId._id);\r\n                    }\r\n                  });\r\n                }}\r\n                options={users.map((option) => {\r\n                  if (option.userId.email != undefined)\r\n                    return option.userId.email;\r\n                })}\r\n                renderInput={(params) => (\r\n                  <TextField\r\n                    {...params}\r\n                    label=\"Email\"\r\n                    margin=\"normal\"\r\n                    variant=\"outlined\"\r\n                    name=\"email\"\r\n                    value={formik.values.email}\r\n                    error={formik.errors.email}\r\n                    onChange={formik.handleChange}\r\n                  />\r\n                )}\r\n              />\r\n              <FormInput\r\n                name=\"phone\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                placeholder=\"Téléphone\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.phone}\r\n                error={formik.errors.phone}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"INDENTITY* :\" />\r\n            <Form.Row width=\"48%\">\r\n              <FormInput\r\n                name=\"firstName\"\r\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\r\n                placeholder=\"FIRST NAME\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.firstName}\r\n                error={formik.errors.firstName}\r\n              />\r\n              <FormInput\r\n                name=\"lastName\"\r\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\r\n                placeholder=\"LAST NAME\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.lastName}\r\n                error={formik.errors.name}\r\n              />\r\n              <FormMultipleUpload\r\n                name=\"logo\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                error={formik.errors.logo}\r\n                values={formik.values.logo}\r\n                onChange={(values) =>\r\n                  formik.handleChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"logo\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"COMPANY : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormSelect\r\n                placeholder=\"Company\"\r\n                values={dropdownCompanies}\r\n                value={selectedCompany}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedCompanyIndex(index);\r\n\r\n                    setSelectedCompany(item);\r\n                  } else {\r\n                    setSelectedCompanyIndex(null);\r\n\r\n                    setSelectedCompany(\"\");\r\n                  }\r\n                }}\r\n                style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"RÔLE : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormSelect\r\n                placeholder=\"RÔLE : \"\r\n                name=\"color\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={formik.handleChange}\r\n                value={formik.values.color}\r\n                error={formik.errors.color}\r\n                values={dropdownRoles}\r\n                value={selectedRole}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedRoleIndex(index);\r\n\r\n                    setSelectedRole(item);\r\n                  } else {\r\n                    setSelectedRoleIndex(null);\r\n\r\n                    setSelectedRole(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"CONSTRUCTION SITE : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormInput\r\n                name=\"site\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                placeholder=\"Site\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.site}\r\n                error={formik.errors.site}\r\n                disabled={true}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              minWidth={200}\r\n              text=\"CONTINUER\"\r\n              fullWidth={false}\r\n              onClick={() => {\r\n                onSubmit();\r\n              }}\r\n              loading={formik.isSubmitting}\r\n              disabled={formik.isSubmitting}\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\EditCompanies.js",["521","522","523","524","525","526","527","528","529","530","531","532","533","534","535","536","537"],"import React, {useState} from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport MultiAdderInput from \"../../../components/MultiAdderInput\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n  error: {\r\n    color: \"red\",\r\n  },\r\n  radioLabel: {\r\n    marginLeft: \"7px\",\r\n    color: \"#7E7878\",\r\n    marginRight: \"50px\"\r\n\r\n  },\r\n  radioBtn: {\r\n\r\n  }\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function EditCompanies(props) {\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const [name, setName] = useState(\"\");\r\n  const [nameError, setNameError] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [colorError, setColorError] = useState(\"\");\r\n  const [images, setImages] = useState([]);\r\n  const [companyType, setCompanyType] = useState(\"\");\r\n  const [companyTypeError, setCompanyTypeError] = useState(\"\");\r\n  const [contract, setContract] = useState(\"\");\r\n  const [contractError, setContractError] = useState(\"\");\r\n  const [typeError, setTypeError] = useState(\"\");\r\n  const [trades, setTrades] = useState([]);\r\n  const [update, setUpdate] = useState(false);\r\n  const [email, setEmail] = useState(\"\");\r\n  const [emailError, setEmailError] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [phoneError, setPhoneError] = useState(\"\");\r\n  const [fname, setFname] = useState(\"\");\r\n  const [lname, setLname] = useState(\"\");\r\n  const [website, setWebsite] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n\r\n\r\n\r\n\r\n  const inputChange = (e) => {\r\n    if (e.target.name === \"companyType\") {\r\n      setCompanyType(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setCompanyTypeError(true);\r\n      } else {\r\n        setCompanyTypeError(false);\r\n      }\r\n    }\r\n   \r\n    if (e.target.name === \"email\") {\r\n      setEmail(e.target.value);\r\n      var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n      if (!e.target.value.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"addInfo\") {\r\n      setAddInfo(e.target.value);\r\n    }\r\n   \r\n  };\r\n\r\n\r\n  // const onSubmit = async (values) => {\r\n  //   const notificationTo = values.notificationTo.map((item) => item.label);\r\n\r\n  //   var formdata = new FormData();\r\n  //   formdata.append(\"logo\", values.logo[0].file);\r\n  //   formdata.append(\"name\", values.name);\r\n  //   formdata.append(\"color\", values.color);\r\n  //   formdata.append(\"firstName\", values.firstName);\r\n  //   formdata.append(\"lastName\", values.lastName);\r\n  //   formdata.append(\"email\", values.email);\r\n  //   formdata.append(\"phone\", values.phone);\r\n  //   formdata.append(\"contractType\", values.contractType);\r\n  //   formdata.append(\"contractStartDate\", values.contractStartDate);\r\n  //   formdata.append(\"contractEndDate\", values.contractEndDate);\r\n  //   formdata.append(\"functionality\", values.functionality);\r\n  //   formdata.append(\"additionalInfo\", values.additionalInfo);\r\n  //   formdata.append(\"notificationPriorToDays\", values.notificationPriorToDays);\r\n  //   formdata.append(\"notificationTo\", JSON.stringify(notificationTo));\r\n\r\n  //   await GLOBALS.API({\r\n  //     method: \"POST\",\r\n  //     uri: GLOBALS.Constants.CLIENTS,\r\n  //     headers: {\r\n  //       Authorization: store.token,\r\n  //     },\r\n  //     body: formdata,\r\n  //   });\r\n  //   formik.setSubmitting(false);\r\n  //   props.history.push(\"/clients\");\r\n  // };\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"trades\") {\r\n     if(value !== \"\"){\r\n      setUpdate((st) => !st);\r\n      setTrades(value);\r\n      console.log(\"trades\", trades);\r\n    }\r\n     }\r\n  }\r\n\r\n  const submitHandler = (e) => {\r\n    var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n    e.preventDefault();\r\n   \r\n    // if (\r\n    //   companyType === \"\" ||\r\n    //   companyType === null ||\r\n    //   companyType === undefined\r\n    // ) {\r\n    //   setCompanyTypeError(true);\r\n    // }\r\n   \r\n    if (email !== \"\") {\r\n      if (!email.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n  else {\r\n      console.log(\"contarct submit\", companyType);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"EDIT A COMPANY\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"name\"\r\n                  disabled\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Company name\"\r\n                  value={name}\r\n                />\r\n                {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"color\"\r\n                  disabled\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Color\"\r\n                  value={color}\r\n                />\r\n                {colorError && (\r\n                  <div className={classes.error}>Please enter color</div>\r\n                )}\r\n              </div>\r\n              <FormMultipleUpload\r\n                name=\"images\"\r\n                \r\n                style={GLOBALS.Styles.inputWidth}\r\n                multiple\r\n                values={images}\r\n                onChange={(values) =>\r\n                  inputChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"images\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n                // onChange={inputChange}\r\n                // onChange={(values) =>\r\n                \r\n                   \r\n                //      ( {type: \"text\",\r\n                //       name: \"trades\",\r\n                //       value: values})\r\n                   \r\n               \r\n                // }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF COMPANY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div>\r\n                <div onChange={inputChange}>\r\n                  <input\r\n                  className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"generalcontractor\"\r\n                    name=\"companyType\"\r\n                    value=\"generalcontractor\"\r\n                  />\r\n                  <label for=\"generalcontractor\" className={classes.radioLabel}>General Contractor</label>\r\n                  <input\r\n                  className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"subcontractor\"\r\n                    name=\"companyType\"\r\n                    value=\"subcontractor\"\r\n                  />\r\n                  <label for=\"subcontractor\" className={classes.radioLabel}>Sub contractor</label>\r\n                </div>\r\n                {companyTypeError === true && (\r\n                  <div className={classes.error}>Please select company</div>\r\n                )}\r\n              </div>\r\n\r\n              {/* <RadioButton\r\n                name=\"contractType\"\r\n                style={{width: '80%'}}\r\n                value={formik.values.contractType}\r\n                error={formik.errors.contractType}\r\n                onChange={formik.handleChange}\r\n                items={[\r\n                  { value: \"GENERALCONTRACTOR\", label: \"General Contractor\" },\r\n                  { value: \"Subcontractor\", label: \"Subcontract\" },\r\n                ]}\r\n              /> */}\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"GENERAL CONTRACTOR : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"100%\", height: \"100%\" }}>\r\n                <select\r\n                  name=\"contract\"\r\n                  disabled\r\n                  id=\"contract\"\r\n                  type={contract}\r\n                  style={{ width: \"40%\", height: \"45px\", color: \"#8B8989\", padding: '0px 10px' }}\r\n                  onChange={inputChange}\r\n                >\r\n                  <option value=\"\">List</option>\r\n                  <option value=\"Yellow\">Yellow</option>\r\n                  <option value=\"Red\">Red</option>\r\n                  <option value=\"Blue\">Blue</option>\r\n                </select>\r\n                {contractError === true && (\r\n                  <div className={classes.error}>Please select contract</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TRADES : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n            <MultiAdderInput\r\n              name=\"trades\"\r\n              values={trades}\r\n              validateError=\"Please enter trades\"\r\n              placeholder=\"Trades\"\r\n              style={{width: \"40%\"}}\r\n              // disabled={contractType !== \"MASTERCLIENT\"}\r\n              onChange={(values) => handleChange(\"trades\", values)}\r\n              validate={(text) => {\r\n                if(text !== \"\"){\r\n                  return false;\r\n                }\r\n                else{\r\n                  return true;\r\n                }\r\n              }}\r\n            />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDEMTITY OF RESPONSIBLE* : \" />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"email\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Adresse e-mail\"\r\n                  onChange={inputChange}\r\n                  value={email}\r\n                />\r\n                {emailError === true && (\r\n                  <div className={classes.error}>Please enter valid email</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"phone\"\r\n                  disabled\r\n                  type=\"number\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Téléphone\"\r\n                  onChange={inputChange}\r\n                  value={phone}\r\n                />\r\n                {phoneError === true && (\r\n                  <div className={classes.error}>\r\n                    Telephone should be 11 digits\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"fname\"\r\n                  disabled\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"First Name\"\r\n                  onChange={(e) => setFname(e.target.value)}\r\n                  value={fname}\r\n                />\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"lname\"\r\n                  disabled\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Last Name\"\r\n                  onChange={(e) => setLname(e.target.value)}\r\n                  value={lname}\r\n                />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"Website : \" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                name=\"website\"\r\n                disabled\r\n                style={{width: '50%'}}\r\n                placeholder=\"http://\"\r\n                onChange={(e) => setWebsite(e.target.value)}\r\n                value={website}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\r\n            <Form.Row width=\"55%\">\r\n            <FormInput\r\n              textArea\r\n              rows={3}\r\n              style={{width: '90%'}}\r\n              onChange={(e) => setAddInfo(e.target.value)}\r\n              placeholder=\"Informations complémentaires\"\r\n              name=\"addInfo\"\r\n              value={addInfo}\r\n            />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              type=\"submit\"\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              // disabled={\r\n              //   name === \"\" ||\r\n              //   color === \"\" ||\r\n              //   companyType === \"\" ||\r\n              //   contract === \"\" ?\r\n              //   true : false\r\n              // }\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\Historic.js",["538","539","540"],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\EditMean.js",["541","542","543","544","545","546","547","548","549","550","551","552","553","554","555","556","557","558","559","560"]
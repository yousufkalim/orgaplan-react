\" || e.target.value === null) {\r\n         setNameError(true);\r\n       } else {\r\n         setNameError(false);\r\n       }\r\n     }\r\n     if (e.target.name === \"comapnyId\") {\r\n       setCompanyId(e.target.value);\r\n       if (e.target.value === \"\" || e.target.value === null) {\r\n         setComapnyError(true);\r\n       } else {\r\n         setComapnyError(false);\r\n       }\r\n     }\r\n     if (e.target.name === \"date\") {\r\n       setDate(e.target.value);\r\n       // console.log(date)\r\n       if (e.target.value === \"\" || e.target.value === null) {\r\n         setDateError(true);\r\n       } else {\r\n         setDateError(false);\r\n       }\r\n     }\r\n     if (e.target.name === \"time\") {\r\n       setTime(e.target.value);\r\n       if (e.target.value === \"\" || e.target.value === null) {\r\n         setTimeError(true);\r\n       } else {\r\n         setTimeError(false);\r\n       }\r\n     }\r\n     if (e.target.name === \"location\") {\r\n       // setTime(e.target.value);\r\n       const selectedObject = dropdownLocation.filter(\r\n         (x) => x.value === e.target.value,\r\n       );\r\n\r\n       setSelectedLocation(selectedObject[0]);\r\n       const locationObject = {};\r\n       locationObject[0] = selectedLocationType;\r\n\r\n       locationObject[1] = e.target.value;\r\n       setselctedLocationObject(locationObject);\r\n\r\n       if (e.target.value === \"\" || e.target.value === null) {\r\n         setTimeError(true);\r\n       } else {\r\n         setTimeError(false);\r\n       }\r\n     }\r\n     if (e.target.name === \"description\") {\r\n       setDescription(e.target.value);\r\n \r\n     }\r\n     if (e.target.name === \"seIsBillable\") {\r\n       seIsBillable(e.target.value);\r\n\r\n     }\r\n     if (e.target.name === \"price\") {\r\n       setPrice(e.target.value);\r\n\r\n     }\r\n     if (e.target.name === \"comment\") {\r\n       setComment(e.target.value);\r\n     }\r\n     if (e.target.name === \"profile\") {\r\n       setImage(e.target.value);\r\n     }\r\n     if (e.target.name === \"type\") {\r\n       setType(e.target.value);\r\n     }\r\n   };\r\n  function handleChange(name, value) {\r\n    if (name === \"image\") setImage(value);\r\n  }\r\n\r\n  const fetchLocationDataOnTypeChange = async () => {\r\n    if(selectedLocationType === 'STORAGEAREA') {\r\n        const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if(response.success) {\r\n            if (response.data) {\r\n              const storageValue =[{\r\n                label: response.data.name,\r\n                value: response.data._id,\r\n              }\r\n            ];\r\n              // temp = storageValue;\r\n              // response.data.map((item, index) => {\r\n              //   return temp.push({ label: item.name, value: item._id });\r\n              // });\r\n              setDropdownLocation(storageValue);\r\n            }\r\n      }\r\n    }\r\n    if(selectedLocationType === 'DELIVERYAREA') {\r\n        const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if(response.success) {\r\n        if(response.data) {\r\n       const temp = [];\r\n          response.data.map((item, index) => {\r\n            return temp.push({ label: item.name, value: item._id });\r\n          });\r\n          setDropdownLocation(temp);\r\n        }\r\n      \r\n      }\r\n      console.log(response);\r\n    }\r\n  }\r\n  const locationTypeChange = (e)=> {\r\n     setselectedLocationType(e.target.value);\r\n  }\r\n  const timeChange = (e) => {\r\n    setTime(e?._d)\r\n    console.log(e)\r\n  }\r\n  const submitHandler = (e) => {\r\n    e.preventDefault();\r\n    if (name === \"\" || name === null) {\r\n      setNameError(true);\r\n    }\r\n    // if (types === \"\" || types === null) {\r\n    //   setTypeError(true);\r\n    // }\r\n    // if (color === \"\" || color === null) {\r\n    //   setColorError(true);\r\n    // }\r\n    // if (startDate === \"\" || startDate === undefined || startDate === null) {\r\n    //   setStartDateError(true);\r\n    //   setIsDateSelect(true);\r\n      \r\n    // } \r\n    // if (endDate === \"\" || endDate === undefined || endDate === null) {\r\n    //   setEndDateError(true);\r\n    // } \r\n    // if( rate === \"\" || rate === null){\r\n    //   setRateError(true);\r\n    // }\r\n    // if( name !== \"\" && types !== \"\" && color !== \"\" && startDate !== \"\" && endDate !== \"\"){\r\n    //   clearFileds();\r\n    // }\r\n    else {\r\n      // clearFileds();\r\n      // submitIncident()\r\n    }\r\n          onFormSubmit();\r\n\r\n  };\r\n\r\n\r\n   return (\r\n     <div className={classes.root}>\r\n       <IconButton onClick={() => props.history.goBack()}>\r\n         <BackArrow style={{ width: 30, height: 30 }} />\r\n       </IconButton>\r\n       <Heading primary=\"CREATE AN INCIDENTS\" />\r\n       <div className={classes.content}>\r\n         <Form.Form onSubmit={submitHandler}>\r\n           <Form.Row>\r\n             <FormLabel bold primary=\"DESIGNATION* :\" />\r\n             <FormInput\r\n               name=\"name\"\r\n               style={GLOBALS.Styles.inputWidth}\r\n               placeholder=\"Name of incident\"\r\n               onChange={nameChange}\r\n               value={name}\r\n             />\r\n           </Form.Row>\r\n           <Form.Row>\r\n             <FormLabel bold primary=\"NAME OF COMPANY* :\" />\r\n             <Form.Row noMargin width=\"48%\">\r\n               <FormSelect\r\n                 placeholder=\"Nom de I'enterprise\"\r\n                 name=\"comapnyId\"\r\n                 style={GLOBALS.Styles.inputWidth}\r\n                 onChange={nameChange}\r\n                 values={dropdownCompanies}\r\n               />\r\n               <span\r\n                 style={{\r\n                   textAlign: \"center\",\r\n                   marginRight: \"50px\",\r\n                   marginTop: \"10px\",\r\n                 }}\r\n               >\r\n                 General Contractor name\r\n               </span>\r\n             </Form.Row>\r\n           </Form.Row>\r\n\r\n           <Form.Row>\r\n             <FormLabel bold primary=\"DATE AND TIME* : \" />\r\n             <Form.Row noMargin width=\"48%\">\r\n               <FormInput\r\n                 type=\"date\"\r\n                 style={GLOBALS.Styles.inputWidth}\r\n                 placeholder=\"Date\"\r\n                 name=\"date\"\r\n                 onChange={nameChange}\r\n                 value={date}\r\n               />\r\n               <TimePicker\r\n                 name=\"time\"\r\n                 style={{ width: \"48%\", height: \"45px\", color: \"#8B8989\" }}\r\n                 onChange={timeChange}\r\n                 //  value={time}\r\n               />\r\n             </Form.Row>\r\n           </Form.Row>\r\n           <Form.Row>\r\n             <FormLabel bold primary=\"LOCATION : \" />\r\n             <Form.Row noMargin width=\"48%\">\r\n               <FormSelect\r\n                 placeholder=\"Type of location\"\r\n                 name=\"locationType\"\r\n                 style={GLOBALS.Styles.inputWidth}\r\n                 onChange={locationTypeChange}\r\n                 values={[\r\n                   { value: \"STORAGEAREA\", label: \"Storage Area\" },\r\n                   { value: \"DELIVERYAREA\", label: \"Delivery Area\" },\r\n                 ]}\r\n               />\r\n               <FormSelect\r\n                 placeholder=\"LOCATION\"\r\n                 name=\"location\"\r\n                 style={GLOBALS.Styles.inputWidth}\r\n                 onChange={nameChange}\r\n                 values={dropdownLocation}\r\n                 disabled={!selectedLocationType}\r\n               />\r\n             </Form.Row>\r\n           </Form.Row>\r\n           <Form.Row>\r\n             <FormLabel bold primary=\"GENERAL: \" />\r\n             <Form.Row width=\"48%\">\r\n               <FormSelect\r\n                 name=\"type\"\r\n                 id=\"bill\"\r\n                 style={{ width: \"40%\", height: \"45px\", color: \"#8B8989\" }}\r\n                 //  onChange={(e) => {\r\n                 //    seIsBillable(e.target.value);\r\n                 //    console.log(\"billable is\", isBillable);\r\n                 //    isBillable === \"No\" && console.log(\"value\");\r\n                 //  }}\r\n                 onChange={nameChange}\r\n                 value={type}\r\n                 values={[\r\n                   { value: \"INCIDENT\", label: \"Incident\" },\r\n                   { value: \"MEAN\", label: \"Mean\" },\r\n                   { value: \"DELAY\", label: \"Delay\" },\r\n                   { value: \"UNEXPRECTED\", label: \"Unexp\" },\r\n                 ]}\r\n               />\r\n             </Form.Row>\r\n           </Form.Row>\r\n           <Form.Row>\r\n             <FormLabel bold primary=\"DESCRIPTION : \" />\r\n             <FormInput\r\n               textArea\r\n               rows={5}\r\n               maxLength=\"300\"\r\n               style={GLOBALS.Styles.inputWidth}\r\n               onChange={nameChange}\r\n               placeholder=\"Information complementaires\"\r\n               name=\"description\"\r\n             />\r\n           </Form.Row>\r\n           <Form.Row>\r\n             <FormLabel bold primary=\"ADD PICTURES : \" />\r\n             <Form.Row noMargin width=\"48%\">\r\n               <FormMultipleUpload\r\n                 name=\"profile\"\r\n                 values={image}\r\n                 style={GLOBALS.Styles.inputWidth}\r\n                 onChange={(values) => {\r\n                   handleChange(\"image\", values);\r\n                 }}\r\n               />\r\n             </Form.Row>\r\n           </Form.Row>\r\n           <Form.Row>\r\n             <FormLabel bold primary=\"BILLABLE* : \" />\r\n             <Form.Row width=\"48%\">\r\n               <select\r\n                 name=\"bill\"\r\n                 id=\"bill\"\r\n                 style={{ width: \"40%\", height: \"45px\", color: \"#8B8989\" }}\r\n                 onChange={(e) => {\r\n                   seIsBillable(e.target.value);\r\n                   console.log(\"billable is\", isBillable);\r\n                 }}\r\n               >\r\n                 <option selected={true} value=\"true\">\r\n                   Yes\r\n                 </option>\r\n                 <option value=\"false\">No</option>\r\n               </select>\r\n             </Form.Row>\r\n           </Form.Row>\r\n           <Form.Row>\r\n             <FormLabel bold primary=\"AMOUNT :\" />\r\n             <Form.Row width=\"48%\" noMargin alignItems=\"center\">\r\n               <Form.Row width=\"24%\" noMargin alignItems=\"center\">\r\n                 <FormInput\r\n                   type=\"number\"\r\n                   name=\"price\"\r\n                   onChange={nameChange}\r\n                   disabled={isBillable == false}\r\n                   // error={penaltyforLateDelivery}\r\n                 />\r\n                 {/*<div >@</div>*/}\r\n                 <SmallText style={{ marginLeft: 10 }} primary=\"€\" />\r\n               </Form.Row>\r\n             </Form.Row>\r\n           </Form.Row>\r\n\r\n           <Form.Row alignItems=\"flex-start\">\r\n             <FormLabel bold primary=\"COMMENT ON INVOICE : \" />\r\n             <FormInput\r\n               textArea\r\n               maxLength=\"300\"\r\n               rows={3}\r\n               style={GLOBALS.Styles.inputWidth}\r\n               onChange={nameChange}\r\n               placeholder=\"Ajouter un commentaire\"\r\n               name=\"comment\"\r\n             />\r\n           </Form.Row>\r\n           <Form.ButtonContainer>\r\n             <Button\r\n               type=\"submit\"\r\n               minWidth={200}\r\n               text=\"VALIDER\"\r\n               fullWidth={false}\r\n               disabled={!name || !date || !dropdownCompanies || !isBillable}\r\n             />\r\n           </Form.ButtonContainer>\r\n         </Form.Form>\r\n       </div>\r\n     </div>\r\n   );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Incidents\\Incidents.js",["630","631","632","633","634","635","636","637"],"import React, { useState, useEffect } from \"react\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\n// import * as Yup from \"yup\";\r\nimport { useSelector } from \"react-redux\";\r\n\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport { useFormik } from \"formik\";\r\nimport moment from \"moment\";\r\n\r\n// import Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport FormInput from \"../../../components/FormInput\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n  link: {\r\n    marginRight: 20,\r\n    whiteSpace: \"nowrap\",\r\n    color: theme.palette.primary.contrastText,\r\n  },\r\n  image: {\r\n    height: 70,\r\n    borderRadius: theme.shape.borderRadius,\r\n  },\r\n}));\r\n\r\nconst Incidents = (props) => {\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  // const store = useSelector((state) => state.auth);\r\n\r\n  // const [loading, setLoading] = useState(true);\r\n  const [incidents, setIncidents] = useState([]);\r\n  const [completeIncidents, setCompleteIncidents] = useState([]);\r\n  const [items, setItems] = useState([]);\r\n  const [siteDeliveryArea, setSiteDeliveryArea] = useState([]);\r\n  const [siteStorageArea, setSiteStorageArea] = useState([]);\r\n  const [siteComapny, setSiteComapny] = useState([]); // setselectedStatus\r\n  const [selectedStatus, setselectedStatus] = useState([]);\r\n  const [status, setStatus] = useState([]);\r\n  // const [status, setStatus] = useState([]);\r\n  const [type, setType] = useState([]);\r\n  const [tatalInvoices, seTatalInvoices] = useState([]);\r\n  const [tatalPrice, seTatalPrice] = useState([]);\r\n  const [selectedFilterType, setSelectedFilterType] = useState(\"\");\r\n  const [nameText, setNameText] = useState(\"\");\r\n  const [loading, setLoading] = useState(true);\r\n  const [selectedTypeIndex, setSelectedTypeIndex] = useState(0);\r\n  const [selectedType, setSelectedType] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [startDate, setStartDate] = useState(\"\");\r\n  const [endDate, setEndDate] = useState(\"\");\r\n\r\n  // const [page, setPage] = useState(\"\");\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    filterIncidents();\r\n    // eslint-disable-next-line\r\n  }, [nameText, companyId, selectedType, ]);\r\n\r\n  async function fetchData() {\r\n    try {\r\n      const result = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ALL_SITE_INCIDENTS}/${adminStore.site.siteId._id}`,\r\n      });\r\n      if (result.success) {\r\n        setIncidents(result.data.incidents);\r\n        setCompleteIncidents(result.data.incidents);\r\n\r\n        if (result.data.incidents) {\r\n          seTatalInvoices(result.data.incidents.length);\r\n          getIncidentsfiltered(result.data.incidents);\r\n        }\r\n        if (result.data.site_delivery_areas) {\r\n          getDeliveryArea(result.data.site_delivery_areas);\r\n        }\r\n        if (result.data.site_storage_areas) {\r\n          getStorageArea(result.data.site_storage_areas);\r\n        }\r\n        if (result.data.type) {\r\n          getType(result.data.type);\r\n        }\r\n        if (result.data.status) {\r\n          getStatus(result.data.status);\r\n        }\r\n        if (result.data.site_companies) {\r\n          getCompanies(result.data.site_companies);\r\n        }\r\n      }\r\n      // setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  async function filterIncidents() {\r\n    try {\r\n      setLoading(true);\r\n      const params = { siteId: adminStore.site.siteId._id };\r\n      if (nameText.length !== 0) params[\"name\"] = nameText;\r\n      // if (selectedDropdownArea.length !== 0)\r\n      //   params[\"deliveryArea\"] =\r\n      //     siteDeliveryAreas[selectedSiteDeliveryAreadIndex]._id;\r\n      // if (selectedStorageArea.length !== 0)\r\n      //   params[\"storageArea\"] =\r\n      //     storageAreas[selectedDropdownStorageAreaIndex]._id;\r\n\r\n      if (companyId.length !== 0) params[\"company\"] = companyId;\r\n\r\n      if (selectedType.length !== 0) params[\"type\"] = selectedType;\r\n      if (selectedStatus.length !== 0) params[\"status\"] = selectedStatus;\r\n      // if (!isNaN(moment(formik.values.contractStartDate)))\r\n      //   params[\"startDate\"] = formik.values.contractStartDate;\r\n      // if (!isNaN(moment(formik.values.contractEndDate)))\r\n      // params[\"endDate\"] = formik.values.contractEndDate;\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.FILTER_INCIDENT}`,\r\n        token: store.token,\r\n        method: \"POST\",\r\n        body: JSON.stringify(params),\r\n      });\r\n      console.log(\"response\", response);\r\n      if (response.success) {\r\n        let temp = [];\r\n\r\n        getIncidentsfiltered(response.data);\r\n        // setItems(temp);\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  function getCompanies(data) {\r\n    let temp = [];\r\n    data.map((item, index) => {\r\n      return temp.push({\r\n        label: item.companyId.name,\r\n        value: item.companyId._id,\r\n      });\r\n    });\r\n    setSiteComapny(temp);\r\n  }\r\n  function getStatus(data) {\r\n    let temp = [];\r\n    data.map((item, index) => {\r\n      return temp.push({\r\n        label: item,\r\n        value: item,\r\n      });\r\n    });\r\n    setStatus(temp);\r\n  }\r\n\r\n  function getStorageArea(data) {\r\n    let temp = [];\r\n    data.map((item, index) => {\r\n      return temp.push({\r\n        label: item.name,\r\n        value: item._id,\r\n      });\r\n    });\r\n    setSiteStorageArea(temp);\r\n  }\r\n\r\n  function getType(data) {\r\n    let temp = [];\r\n    data.map((item, index) => {\r\n      return temp.push({\r\n        label: item,\r\n        value: item,\r\n      });\r\n    });\r\n    setType(temp);\r\n  }\r\n\r\n  function getDeliveryArea(data) {\r\n    let temp = [];\r\n    data.map((item, index) => {\r\n      return temp.push({\r\n        label: item.name,\r\n        value: item._id,\r\n      });\r\n    });\r\n    setSiteDeliveryArea(temp);\r\n  }\r\n\r\n  function getIncidentsfiltered(data) {\r\n    let temp = [];\r\n    let total = 0;\r\n\r\n    data.map((item, index) => {\r\n      total = total + item.price;\r\n      let data = [];\r\n      data[0] = item.date ? moment(item.date).format(\"MM/DD/yyyy\") : \" \";\r\n      data[1] = item?.type;\r\n      data[2] = item?.name;\r\n      data[3] = item.companyId?.name;\r\n      data[4] = item.status;\r\n      data[5] = item.location?.deliveryArea?.name;\r\n      data[6] = item?.isBillable ? \"Yes\" : \"No\";\r\n      data[7] = item?.price;\r\n      data[8] = item?.isBillable ? \"Yes\" : \"No\";\r\n      return temp.push(data);\r\n    });\r\n    seTatalPrice(total);\r\n    setItems(temp);\r\n  }\r\n\r\n  const rows = items.map((item, index) => {\r\n    return [\r\n      item[0] ? item[0] : \"\",\r\n      item[1] ? item[1] : \" \",\r\n      item[2] ? item[2] : \" \",\r\n      item[3] ? item[3] : \" \",\r\n      item[4] ? item[4] : \" \",\r\n      item[5] ? item[5] : \" \",\r\n      item[6] ? item[6] : \" \",\r\n      item[7] ? item[7] : \" \",\r\n      item[8] ? item[8] : \" \",\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <Form.Row alignItems=\"center\">\r\n        <Heading icon primary=\"RE-INVOICING\" noWrap />\r\n        <div>\r\n          <Form.Row alignItems=\"flex-start\" noMargin justifyContent=\"flex-end\">\r\n            <SubHeading\r\n              noMargin\r\n              topPadding\r\n              style={{ color: \"#F80303\" }}\r\n              primary={`TOTAL: ${tatalInvoices} RE-INVOICING\r\n              ${tatalPrice}€`}\r\n              bold\r\n            />\r\n            <Form.Column style={{ width: \"50%\" }}>\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"CREATE AN INCIDENT\"\r\n                to={\"/incidents/add-incidents\"}\r\n                style={{\r\n                  marginLeft: \"20px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"200px\",\r\n                  fontWeight: \"bold\",\r\n                  backgroundColor: \"#F80303\",\r\n                }}\r\n              />\r\n              {/* <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"MEANS REQUEST\"\r\n                to={\"/sites/means-request\"}\r\n                style={{ marginLeft: \"20px\", width: \"200px\" }}\r\n              /> */}\r\n            </Form.Column>\r\n          </Form.Row>\r\n        </div>\r\n      </Form.Row>\r\n      <Form.Row alignItems=\"center\" noMargin>\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          {/* <SearchInput\r\n            placeholder=\"Site name\"\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          /> */}\r\n          <FormSelect\r\n            placeholder=\"Delivery area\"\r\n            values={siteDeliveryArea}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Location\"\r\n            values={siteDeliveryArea}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Level\"\r\n            values={[]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Storage area\"\r\n            values={siteStorageArea}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Type\"\r\n            values={[\r\n              { value: \"INCIDENT\", label: \"Incident\" },\r\n              { value: \"MEAN\", label: \"Mean\" },\r\n              { value: \"DELAY\", label: \"Delay\" },\r\n              { value: \"UNEXPRECTED\", label: \"Unexp\" },\r\n            ]}\r\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n                setSelectedTypeIndex(index);\r\n                setSelectedType(item);\r\n                // Reset Storage Means\r\n                //filterMean();\r\n              } else {\r\n                setSelectedTypeIndex(0);\r\n                setSelectedType(\"\");\r\n                // Reset Storage Means\r\n                //filterMean();\r\n              }\r\n            }}\r\n          />\r\n        </Form.Row>\r\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\r\n          See archived sites\r\n        </NavLink> */}\r\n      </Form.Row>\r\n\r\n      <Form.Row alignItems=\"center\" className=\"mt-3\">\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          <FormSelect\r\n            placeholder=\"Company\"\r\n            value={companyId} //working\r\n            values={siteComapny}\r\n            onChange={(event) => {\r\n              setCompanyId(event.target.value);\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n\r\n          <FormInput\r\n            type=\"date\"\r\n            placeholder=\"Start date\"\r\n            name=\"startDate\"\r\n            icon\r\n            value={startDate}\r\n            onChange={(e) => {\r\n              setStartDate(e.target.value);\r\n            }}\r\n            // onChange={formik.handleChange}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormInput\r\n            type=\"date\"\r\n            placeholder=\"End date\"\r\n            name=\"endDate\"\r\n            value={endDate}\r\n            onChange={(e) => {\r\n              setEndDate(e.target.value);\r\n            }}\r\n            // icon\r\n            // onChange={formik.handleChange}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Status\"\r\n            values={status}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n            onChange={(event) => {\r\n              setselectedStatus(event.target.value);\r\n            }}\r\n          />\r\n          <SearchInput\r\n            placeholder=\"Designation\"\r\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\r\n            onChange={(event) => {\r\n              setNameText(event.target.value);\r\n            }}\r\n          />\r\n        </Form.Row>\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Table\r\n          headers={GLOBALS.Data.incidents.headings}\r\n          rows={rows}\r\n          onClick={(e) => {\r\n            return props.history.push({\r\n              pathname: \"/incidents/edit-incidents\",\r\n              data: incidents[e],\r\n            });\r\n          }}\r\n        />\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Incidents;\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Pic\\PicCanvas.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\Constants.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\Styles.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\API.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\SearchInput.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Pagination.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\SmallButton.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\AvatarUpload.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormSelect.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Table.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\ColorPcker.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormLabel.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormMultipleUpload.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Modal.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\CustomInputModalSingleSelect.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Stepper.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep3.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Canvas\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep2.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep1.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep3.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep2.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep1.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\UnavailabilityTimes.js",["638","639","640"],"import React, { useState } from \"react\";\r\nimport { useDispatch } from \"react-redux\";\r\nimport { useFormik } from \"formik\";\r\nimport GLOBALS from \"../globals\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\nimport * as Yup from \"yup\";\r\nimport Input from \"./Input\";\r\nimport moment from \"moment\";\r\nimport Form from \"./Form\";\r\nimport Modal from \"./Modal\";\r\nimport Button from \"./Button\";\r\nimport FormLabel from \"./FormLabel\";\r\nimport FormSelect from \"./FormSelect\";\r\nimport FormInput from \"./FormInput\";\r\nimport FormControlLabel from \"@material-ui/core/FormControlLabel\";\r\nimport Checkbox from \"@material-ui/core/Checkbox\";\r\nimport Actions from \"../redux/actions\";\r\nimport { FreeBreakfastOutlined } from \"@material-ui/icons\";\r\nimport \"./custom.css\";\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    position: \"relative\",\r\n  },\r\n  chips: {\r\n    margin: 0,\r\n    marginTop: 15,\r\n    display: \"flex\",\r\n    flexWrap: \"wrap\",\r\n    listStyle: \"none\",\r\n    justifyContent: \"center\",\r\n  },\r\n  chip: {\r\n    color: theme.palette.primary.contrastText,\r\n    margin: theme.spacing(0.5),\r\n  },\r\n}));\r\n\r\nconst addUnavailabilityYup = Yup.object().shape({\r\n  key: Yup.number().required(\"Required\"),\r\n  date: Yup.date().required(\"Required\"),\r\n  startHour: Yup.number().required(\"Required\"),\r\n  endHour: Yup.number().required(\"Required\"),\r\n  dayOff: Yup.bool().required(\"Required\"),\r\n  reason: Yup.string().optional(),\r\n});\r\n\r\nexport default function MultiAdderInputModal(props) {\r\n  const {\r\n    unavailabilityDates,\r\n    setUnavailabilityDates,\r\n    startRange,\r\n    endRange,\r\n  } = props;\r\n\r\n  const dispatch = useDispatch();\r\n  const theme = useTheme();\r\n\r\n  const classes = useStyles();\r\n\r\n  const [modal, setModal] = useState(false);\r\n  const [update, setUpdate] = useState(false);\r\n  const [date, setDate] = useState(\"\");\r\n  const [reason, setReason] = useState(\"\");\r\n  const [time, setTime] = useState({\r\n    start: \"0\",\r\n    end: \"23\",\r\n  });\r\n  const [dayOff, setDayOff] = useState(false);\r\n\r\n  async function onSubmit(values) {\r\n    let newValues = props.values;\r\n    props.onChange(newValues);\r\n    setUpdate((st) => !st);\r\n    // setModal(false);\r\n    formik.setSubmitting(false);\r\n    formik.handleReset();\r\n  }\r\n  const getTime = (e) => {\r\n    setTime({ ...time, [e.target.name]: e.target.value });\r\n  };\r\n  const getDate = (e) => {\r\n    setDate(e.target.value);\r\n  };\r\n  const getreason = (e) => {\r\n    setReason(e.target.value);\r\n  };\r\n  const deleteUnavailability = (id) => {\r\n    let deleteArray = [];\r\n    unavailabilityDates.map(\r\n      (key, index) => index !== id && deleteArray.push(key),\r\n    );\r\n    setUnavailabilityDates(deleteArray);\r\n  };\r\n  const handledayOff = (event) => {\r\n    setDayOff(event.target.checked);\r\n\r\n    if (event.target.checked) {\r\n      time.start = \"0\";\r\n      time.end = \"0\";\r\n      setTime(time);\r\n    } else {\r\n      time.start = \"0\";\r\n      time.end = \"23\";\r\n      setTime(time);\r\n    }\r\n  };\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      day1Start: 0,\r\n      day1End: 23,\r\n    },\r\n    validationSchema: addUnavailabilityYup,\r\n    onSubmit: onSubmit,\r\n  });\r\n\r\n  const values = [\r\n    { value: 0, label: \"0\" },\r\n    { value: 1, label: \"1\" },\r\n    { value: 2, label: \"2\" },\r\n    { value: 3, label: \"3\" },\r\n    { value: 4, label: \"4\" },\r\n    { value: 5, label: \"5\" },\r\n    { value: 6, label: \"6\" },\r\n    { value: 7, label: \"7\" },\r\n    { value: 8, label: \"8\" },\r\n    { value: 9, label: \"9\" },\r\n    { value: 10, label: \"10\" },\r\n    { value: 11, label: \"11\" },\r\n    { value: 12, label: \"12\" },\r\n    { value: 13, label: \"13\" },\r\n    { value: 14, label: \"14\" },\r\n    { value: 15, label: \"15\" },\r\n    { value: 16, label: \"16\" },\r\n    { value: 17, label: \"17\" },\r\n    { value: 18, label: \"18\" },\r\n    { value: 19, label: \"19\" },\r\n    { value: 20, label: \"20\" },\r\n    { value: 21, label: \"21\" },\r\n    { value: 22, label: \"22\" },\r\n    { value: 23, label: \"23\" },\r\n  ];\r\n\r\n  const unavailabilityDatesHandal = () => {\r\n    let loop_date1;\r\n    let loop_date2;\r\n    let date1, date2;\r\n    let addvalue = 1;\r\n    const newarray = {\r\n      date: date,\r\n      startHour: time.start,\r\n      endHour: time.end,\r\n      dayOff: dayOff,\r\n      reason: reason,\r\n    };\r\n    date1 = moment(date).format(\"MM-DD-YYYY HH:mm:ss\");\r\n    date1 = moment(date1).set(\"hour\", parseInt(time.start));\r\n    date2 = moment(date).format(\"MM-DD-YYYY HH:mm:ss\");\r\n    date2 = moment(date2).set(\"hour\", parseInt(time.end));\r\n    if (moment(date).isBetween(startRange, endRange, null, \"[]\")) {\r\n      if (\r\n        parseInt(time.start) < parseInt(time.end) ||\r\n        (time.start === \"0\" && time.end === \"0\")\r\n      ) {\r\n        for (let i = 0; i < unavailabilityDates.length; i++) {\r\n          addvalue = 0;\r\n          let localdate = unavailabilityDates[i].date;\r\n          let localstart = unavailabilityDates[i].startHour;\r\n          let localend = unavailabilityDates[i].endHour;\r\n          let localdayOff = unavailabilityDates[i].dayOff;\r\n\r\n          loop_date1 = moment(localdate).format(\"MM-DD-YYYY HH:mm:ss\");\r\n          loop_date1 = moment(loop_date1).set(\"hour\", parseInt(localstart));\r\n          loop_date2 = moment(localdate).format(\"MM-DD-YYYY HH:mm:ss\");\r\n          loop_date2 = moment(loop_date2).set(\"hour\", parseInt(localend));\r\n\r\n          if (\r\n            (moment(date1).isBefore(loop_date1) &&\r\n              moment(date2).isBefore(loop_date2)) ||\r\n            (moment(date1).isAfter(loop_date1) &&\r\n              moment(date2).isAfter(loop_date2))\r\n          ) {\r\n            if (\r\n              moment(date2).isBetween(loop_date1, loop_date2) ||\r\n              moment(date1).isBetween(loop_date1, loop_date2)\r\n            ) {\r\n              console.log(\"is between time\");\r\n              break;\r\n            } else {\r\n              console.log(\"greater or less\");\r\n              if (moment(localdate).isSame(date) && localdayOff === true) {\r\n                break;\r\n              } else if (\r\n                moment(localdate).isSame(date) &&\r\n                dayOff === true &&\r\n                localdayOff === false\r\n              ) {\r\n                break;\r\n              } else {\r\n                addvalue = 1;\r\n              }\r\n            }\r\n          } else {\r\n            console.log(\"greate or less no valid\");\r\n            addvalue = 0;\r\n            break;\r\n          }\r\n        }\r\n        if (addvalue) {\r\n          setUnavailabilityDates((prevState) => [...prevState, newarray]);\r\n          // set value are all value empty\r\n          setDate(\"\");\r\n          setReason(\"\");\r\n          setTime({ start: \"0\", end: \"23\" });\r\n          setDayOff(false);\r\n          // set value are all value empty\r\n        } else {\r\n          dispatch(\r\n            Actions.notistack.enqueueSnackbar(\r\n              Actions.notistack.snackbar(\"This time is not available\", \"error\"),\r\n            ),\r\n          );\r\n        }\r\n      } else {\r\n        dispatch(\r\n          Actions.notistack.enqueueSnackbar(\r\n            Actions.notistack.snackbar(\"Please select a Vaild time \", \"error\"),\r\n          ),\r\n        );\r\n      }\r\n    } else {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(\r\n            \"Please select a Date b/w Start and End Date \",\r\n            \"error\",\r\n          ),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <Button\r\n        minWidth={200}\r\n        fullWidth={false}\r\n        color={theme.palette.blue}\r\n        text=\"SEE UNAVAILABILITIES\"\r\n        onClick={() => setModal(true)}\r\n      />\r\n      {update && \"\"}\r\n      <Modal\r\n        open={modal}\r\n        title=\"UNAVAILABILITIES\"\r\n        onClose={() => setModal((st) => !st)}\r\n        body={\r\n          <>\r\n            <Form.Form>\r\n              <Form.Row>\r\n                <Form.Row noMargin>\r\n                  <FormLabel disableMargin bold primary=\"Date:\" />\r\n                </Form.Row>\r\n                <Form.Row noMargin>\r\n                  <FormInput\r\n                    type=\"date\"\r\n                    name=\"date\"\r\n                    value={date}\r\n                    placeholder=\"Date\"\r\n                    style={GLOBALS.Styles.inputWidth}\r\n                    max={endRange}\r\n                    min={startRange}\r\n                    onChange={getDate}\r\n                  />\r\n\r\n                  <FormControlLabel\r\n                    control={\r\n                      <Checkbox\r\n                        checked={dayOff}\r\n                        onChange={handledayOff}\r\n                        name=\"dayOff\"\r\n                        color=\"primary\"\r\n                      />\r\n                    }\r\n                    label=\"Day Off\"\r\n                  />\r\n                </Form.Row>\r\n              </Form.Row>\r\n              <Form.Row style={{ display: dayOff ? \"none\" : \"flex\" }}>\r\n                <Form.Row noMargin>\r\n                  <FormLabel disableMargin bold primary=\"Time:\" />\r\n                </Form.Row>\r\n\r\n                <Form.Row noMargin>\r\n                  <FormSelect\r\n                    values={values}\r\n                    name=\"start\"\r\n                    value={time.start}\r\n                    onChange={getTime}\r\n                    style={{ marginRight: \"5px\" }}\r\n                  />\r\n\r\n                  <FormSelect\r\n                    name=\"end\"\r\n                    values={values}\r\n                    value={time.end}\r\n                    onChange={getTime}\r\n                  />\r\n                </Form.Row>\r\n              </Form.Row>\r\n\r\n              <Form.Row>\r\n                <Form.Row noMargin>\r\n                  <FormLabel disableMargin bold primary=\"Reason:\" />\r\n                </Form.Row>\r\n\r\n                <Form.Row noMargin>\r\n                  <textarea\r\n                    name=\"reason\"\r\n                    rows=\"3\"\r\n                    value={reason}\r\n                    onChange={getreason}\r\n                    maxLength=\"50\"\r\n                    minLength=\"3\"\r\n                    placeholder=\"Reason\"\r\n                    style={{ width: \"100%\" }}\r\n                  />\r\n                </Form.Row>\r\n              </Form.Row>\r\n\r\n              <Form.Row>\r\n                <Form.Row noMargin></Form.Row>\r\n\r\n                <Form.Row noMargin justifyContent=\"center\">\r\n                  <Button\r\n                    minWidth={200}\r\n                    onClick={unavailabilityDatesHandal}\r\n                    text=\"Add\"\r\n                    fullWidth={false}\r\n                  />\r\n                </Form.Row>\r\n              </Form.Row>\r\n            </Form.Form>\r\n            <table className=\"table\">\r\n              {unavailabilityDates.length > 0 && (\r\n                <>\r\n                  <thead>\r\n                    <tr>\r\n                      <th>Date</th>\r\n                      <th>Start</th>\r\n                      <th>End</th>\r\n                      <th>Reason</th>\r\n                      <th>Action</th>\r\n                    </tr>\r\n                  </thead>\r\n                  <tbody>\r\n                    {unavailabilityDates.map((key, index) => {\r\n                      return (\r\n                        <tr key={index}>\r\n                          <td> {moment(key.date).format(\"DD-MM-YYYY\")} </td>\r\n                          <td>{key.startHour}</td>\r\n                          <td>{key.endHour}</td>\r\n                          <td>{key.reason}</td>\r\n                          <td>\r\n                            <button\r\n                              onClick={() => {\r\n                                deleteUnavailability(index);\r\n                              }}\r\n                              className=\"btn btn-danger\"\r\n                              style={{\r\n                                fontSize: \"13px\",\r\n                                padding: \"0px 12px\",\r\n                              }}\r\n                            >\r\n                              X\r\n                            </button>\r\n                          </td>\r\n                        </tr>\r\n                      );\r\n                    })}\r\n                  </tbody>\r\n                </>\r\n              )}\r\n            </table>\r\n          </>\r\n        }\r\n      />\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\MultiAdderInput.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\OpeningTimes.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Canvas\\Components\\Header.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Canvas\\ConvaExample.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\MultiAdderInputModal.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\RadioButton.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Canvas\\Components\\Rectangle.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Canvas\\Components\\Line.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Input.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Canvas\\Components\\data.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\Historic.js",["641"],"import React, { useState, useEffect } from \"react\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\n// import Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Table from \"../../../components/Table\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport moment from \"moment\";\r\nimport { Images } from \"../../../assets/Assets\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n  link: {\r\n    marginRight: 20,\r\n    whiteSpace: \"nowrap\",\r\n    color: theme.palette.primary.contrastText,\r\n  },\r\n  image: {\r\n    height: 70,\r\n    borderRadius: theme.shape.borderRadius,\r\n  },\r\n}));\r\n\r\nconst Historic = (props) => {\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [isLoading, setLoading] = useState(true);\r\n  const [history, setHistory] = useState([]);\r\n\r\n  const [means, setMeans] = useState([]);\r\n  const [dorpdownMeans, setDropdownMeans] = useState([]);\r\n  const [selectedMean, setSelectedMean] = useState(\"\");\r\n  const [selectedMeanIndex, setSelectedMeanIndex] = useState(null);\r\n\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    filterBooking();\r\n    // eslint-disable-next-line\r\n  }, [selectedMeanIndex, selectedCompanyIndex]);\r\n\r\n  const filterBooking = async () => {\r\n    try {\r\n      setLoading(true);\r\n      const params = { siteId: adminStore.site.siteId._id };\r\n      if (selectedMean.length !== 0)\r\n        params[\"meanId\"] = means[selectedMeanIndex]._id;\r\n      if (selectedCompany.length !== 0)\r\n        params[\"companyId\"] = companies[selectedCompanyIndex].companyId._id;\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.FILTER_BOOKING}`,\r\n        token: store.token,\r\n        method: \"POST\",\r\n        body: JSON.stringify(params),\r\n      });\r\n      if (response.success) {\r\n        setHistory(response.data);\r\n\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getData = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_MEAN_HISTORY}/${props.location.mean._id}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setHistory(response.data.history);\r\n        setCompanies(response.data.site_companies);\r\n        if (response.data.site_means != null) {\r\n          setMeans(response.data.site_means);\r\n          let selectedMeanIndex = 0;\r\n\r\n          const temp = [];\r\n          const companyTemp = [];\r\n          response.data.site_means.map((item, index) => {\r\n            if (item._id === props.location.mean._id) {\r\n              selectedMeanIndex = index;\r\n              setSelectedMean(item.name);\r\n            }\r\n            return temp.push({ label: item.name, value: item.name });\r\n          });\r\n          setDropdownMeans(temp);\r\n\r\n          setSelectedMeanIndex(selectedMeanIndex);\r\n\r\n          response.data.site_companies.map((item, index) => {\r\n            return companyTemp.push({\r\n              label: item.companyId.name,\r\n              value: item.companyId.name,\r\n            });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const rows = history.map((item) => {\r\n    return [\r\n      moment(item.startDate).format(\"MM/DD/yyy\") + \" \" + item.startTime,\r\n      moment(item.endDate).format(\"MM/DD/yyy\") + \" \" + item.endTime,\r\n      item.companyId.name,\r\n      item.bookingReason,\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <Form.Row alignItems=\"center\">\r\n        <Heading primary=\"LIST OF MEANS - HISTORIC\" noWrap />\r\n        <div>\r\n          <Form.Row\r\n            alignItems=\"flex-start\"\r\n            noMargin\r\n            justifyContent=\"flex-end\"\r\n            style={{ paddingRight: \"50px\" }}\r\n          >\r\n            <Form.Column style={{ width: \"50%\", marginRight: \"50px\" }}>\r\n              <img src={Images.site} alt=\"\" />\r\n            </Form.Column>\r\n          </Form.Row>\r\n        </div>\r\n      </Form.Row>\r\n      <Form.Row alignItems=\"center\" noMargin>\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          {/* <SearchInput\r\n            placeholder=\"Site name\"\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          /> */}\r\n          <FormSelect\r\n            placeholder=\"Company\"\r\n            values={dropdownCompanies}\r\n            value={selectedCompany}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n\r\n                setSelectedCompanyIndex(index);\r\n\r\n                setSelectedCompany(item);\r\n              } else {\r\n                setSelectedCompanyIndex(null);\r\n\r\n                setSelectedCompany(\"\");\r\n              }\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Mean\"\r\n            values={dorpdownMeans}\r\n            value={selectedMean}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n\r\n                setSelectedMeanIndex(index);\r\n\r\n                setSelectedMean(item);\r\n              } else {\r\n                setSelectedMeanIndex(null);\r\n\r\n                setSelectedMean(\"\");\r\n              }\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\r\n          See archived sites\r\n        </NavLink> */}\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Table headers={GLOBALS.Data.meansOfHistoric.headings} rows={rows} />\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Historic;\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\AddMean.js",["642","643","644","645","646","647","648","649","650"],"import React, { useState, useEffect } from \"react\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/CustomFormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport CustomInputModal from \"../../../components/CustomInputModal\";\r\nimport ColorPicker from \"../../../components/ColorPcker\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nconst accessabilityPoints = [\r\n  { label: \"Storage Area\", value: \"Storage Area\" },\r\n  { label: \"Delivery Area\", value: \"Delivery Area\" },\r\n];\r\n\r\nexport default function AddMean(props) {\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [name, setName] = useState(\"\");\r\n  const [type, setType] = useState(\"\");\r\n  const [color, setColor] = useState(\"#d71313\");\r\n  const [image, setImage] = useState([]);\r\n  const [location, setLocation] = useState([]);\r\n  const [startDate, setStartDate] = useState(\"\");\r\n  const [endDate, setEndDate] = useState(\"\");\r\n  const [techSheet, setTechSheet] = useState([]);\r\n  const [rate, setRate] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n  const [loading, setLoading] = useState(true);\r\n  const classes = useStyles();\r\n\r\n  const [accessabilityPoint, setAccessabilityPoint] = useState(\"\");\r\n  const [DeliveryAreas, setDeliveryAreas] = useState([]);\r\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\r\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\r\n  const [\r\n    selectedSiteDeliveryAreadIndex,\r\n    seltSelectedSiteDeliveryAreaIndex,\r\n  ] = useState(null);\r\n\r\n  const [storageAreas, setStorageAreas] = useState([]);\r\n  const [dropdownStorageAreas, setDropdownStorageAreas] = useState([]);\r\n  const [\r\n    selectedDropdownStorageArea,\r\n    setSelectedDropdownStorageArea,\r\n  ] = useState(\"\");\r\n  const [selectedStorageAreaIndex, setSelectedStorageAreaIndex] = useState(\r\n    null,\r\n  );\r\n\r\n  const [deliveryAreaId, setDeilveryAreaId] = useState(\"\");\r\n  const [storageAreaId, setStorageAreaId] = useState(\"\");\r\n\r\n  const [\r\n    deliveryAndStorageLocations,\r\n    setDeliveryAndStorageLocations,\r\n  ] = useState([]);\r\n\r\n  const [buildings, setBuidings] = useState([]);\r\n  const [dropdownBuildings, setDropdownBuildings] = useState([]);\r\n  const [selectedBuildingIndex] = useState(null);\r\n\r\n  const [levels, setLevels] = useState([]);\r\n  const [selectedDropdownIndex] = useState(null);\r\n\r\n  const [meanTypes, setMeanTypes] = useState([]);\r\n  const [dropdownMeanTypes, setDropdownMeanTypes] = useState([]);\r\n  const [selectedMeanType, setSelectedMeanType] = useState(\"\");\r\n  const [selecetedMeanTypeIndex, setSelectedMeanTypeIndex] = useState(null);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  useEffect(() => {}, [\r\n    meanTypes,\r\n    dropdownMeanTypes,\r\n    selecetedMeanTypeIndex,\r\n    selectedMeanType,\r\n  ]);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_MEAN}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.site_delivery_areas !== null) {\r\n          const temp = [];\r\n          response.data.site_delivery_areas.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name, id: item._id }),\r\n          );\r\n          setDeliveryAreas(response.data.site_delivery_areas);\r\n          setDropdownDeliveryAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_storage_areas !== null) {\r\n          const temp = [];\r\n          response.data.site_storage_areas.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name, id: item._id }),\r\n          );\r\n          setStorageAreas(response.data.site_storage_areas);\r\n          setDropdownStorageAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_buildings !== null) {\r\n          const temp = [];\r\n          response.data.site_buildings.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n          setBuidings(response.data.site_buildings);\r\n          setDropdownBuildings(temp);\r\n        }\r\n\r\n        if (response.data.mean_types !== null) {\r\n          const temp = [];\r\n          response.data.mean_types.map((item, index) =>\r\n            temp.push({ label: item, value: item }),\r\n          );\r\n          setMeanTypes(response.data.mean_types);\r\n          setDropdownMeanTypes(temp);\r\n        }\r\n        // if (response.data.mean_types !== null) {\r\n        //   setTypes(response.data.mean_types);\r\n        //   const temp = [];\r\n        //   response.data.mean_types.map((item, index) => {\r\n        //     temp.push({ label: item, value: item });\r\n        //   });\r\n        //   setDropdownTypes(temp);\r\n        // }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  function handleChange(name, value) {\r\n    if (name === \"name\") {\r\n      setName(value);\r\n    }\r\n    else if (name === \"type\") setType(value);\r\n    else if (name === \"color\") setColor(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"location\") setLocation(value);\r\n    else if (name === \"startDate\") setStartDate(value);\r\n    else if (name === \"endDate\") setEndDate(value);\r\n    else if (name === \"techSheet\") setTechSheet(value);\r\n    else if (name === \"rate\") setRate(value);\r\n    else if (name === \"addInfo\") setAddInfo(value);\r\n  }\r\n\r\n  const createMean = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      var formdata = new FormData();\r\n\r\n      let locations = [];\r\n\r\n      deliveryAndStorageLocations.forEach((item) => {\r\n        if (item.type === accessabilityPoints[0].value) {\r\n          let loc = {\r\n            locationType: \"STORAGEAREA\",\r\n            storageArea: item.id,\r\n          };\r\n          locations.push(loc);\r\n        }\r\n        if (item.type === accessabilityPoints[1].value) {\r\n          let loc = {\r\n            locationType: \"DELIVERYAREA\",\r\n            deliveryArea: item.id,\r\n          };\r\n          locations.push(loc);\r\n        }\r\n      });\r\n\r\n      let availabilities = {\r\n        start: startDate,\r\n        end: endDate,\r\n      };\r\n\r\n      // TEST DATA , CALENDAR NOT MADE YET\r\n\r\n      const sampleDateOne = new Date(\"05/20/2021\");\r\n      const sampleDateTwo = new Date(\"05/28/2021\");\r\n      const unavailabilities = [\r\n        {\r\n          date: sampleDateOne,\r\n          reason: \"Public Holiday\",\r\n          startingHour: new Date().getTime(),\r\n          endingHour: new Date().getTime(),\r\n        },\r\n        {\r\n          date: sampleDateTwo,\r\n          reason: \"Maintenance\",\r\n          startingHour: new Date().getTime(),\r\n          endingHour: new Date().getTime(),\r\n        },\r\n      ];\r\n\r\n      formdata.append(\"name\", name);\r\n      formdata.append(\"color\", color);\r\n      formdata.append(\"image\", image[0].file);\r\n      formdata.append(\"sheet\", image[0].file);\r\n      formdata.append(\"pricePerHour\", rate);\r\n      formdata.append(\"additionalInfo\", addInfo);\r\n      formdata.append(\"siteId\", adminStore.site.siteId._id);\r\n      formdata.append(\"meanType\", selectedMeanType);\r\n      formdata.append(\"location\", JSON.stringify(locations));\r\n      formdata.append(\"availability\", JSON.stringify(availabilities));\r\n      formdata.append(\"unavailability\", JSON.stringify(unavailabilities));\r\n\r\n      const response = await GLOBALS.API({\r\n        method: \"POST\",\r\n        uri: GLOBALS.Constants.CREATE_MEAN,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      console.log(JSON.stringify(response, null, 2));\r\n\r\n      if (response.success) {\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n        dispatch(\r\n          Actions.notistack.enqueueSnackbar(\r\n            Actions.notistack.snackbar(response.message, \"error\"),\r\n          ),\r\n        );\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getDeliveryArea = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data !== null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n\r\n          setDropdownDeliveryAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getStorageArea = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data !== null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n\r\n          setDropdownStorageAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  // const getLevels = async (buidlingId) => {\r\n  //   try {\r\n  //     setLoading(true);\r\n\r\n  //     const response = await GLOBALS.API({\r\n  //       uri: `${GLOBALS.Constants.GET_LEVELS}/${buidlingId}`,\r\n  //       token: store.token,\r\n  //     });\r\n\r\n  //     if (response.success) {\r\n  //       setLevels(response.data);\r\n  //       if (response.data !== null && response.data.length > 0) {\r\n  //         const temp = [];\r\n  //         response.data.map((item, index) =>\r\n  //           temp.push({ label: item.name, value: item.name }),\r\n  //         );\r\n\r\n  //         setDropdownLevels(temp);\r\n  //       }\r\n  //       setLoading(false);\r\n  //     } else {\r\n  //       setLoading(false);\r\n  //     }\r\n  //     setLoading(false);\r\n  //   } catch (err) {\r\n  //     setLoading(false);\r\n  //     dispatch(\r\n  //       Actions.notistack.enqueueSnackbar(\r\n  //         Actions.notistack.snackbar(err.message, \"error\"),\r\n  //       ),\r\n  //     );\r\n  //   }\r\n  // };\r\n  const handleChangecolor = (color) => {\r\n    setColor(color.hex )\r\n    console.log(\"color is\", color.hex);\r\n  };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n\r\n      <Form.Row>\r\n        <Heading primary=\"ADD A MEAN\" />\r\n\r\n        {/* <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"LOCALISATION\"\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginRight: \"100px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\"\r\n                }}\r\n              /> */}\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Form.Form>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY * : \" />\r\n            <Form.Row noMargin width=\"65%\" style={{ gap: \"20px\", justifyContent: \"flex-start\" }}>\r\n              <FormInput\r\n                name=\"name\"\r\n                value={name}\r\n                placeholder=\"name\"\r\n                style={{width: \"25%\"}}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n              <FormSelect\r\n                placeholder=\"Type\"\r\n                name=\"type\"\r\n                style={{width: \"25%\"}}\r\n                values={dropdownMeanTypes}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    setSelectedMeanTypeIndex(index);\r\n                    setSelectedMeanType(item);\r\n                  } else {\r\n                    setSelectedMeanTypeIndex(null);\r\n                    setSelectedMeanType(\"\");\r\n                  }\r\n                }}\r\n              />\r\n              <div style={{ width: \"25%\" }}>\r\n                <ColorPicker color={color} handleChange={handleChangecolor} />\r\n              </div>\r\n              {/* <FormSelect\r\n                placeholder=\"color\"\r\n                name=\"color\"  \r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={color}\r\n                values={[\r\n                  { value: \"green\", label: \"Green\" },\r\n                  { value: \"Yellow\", label: \"Yellow\" },\r\n                  { value: \"Red\", label: \"Red\" },\r\n                  { value: \"Blue\", label: \"Blue\" },\r\n                  { value: \"Orange\", label: \"Orange\" },\r\n                  { value: \"Purple\", label: \"Purple\" },\r\n                  { value: \"Magenta\", label: \"Magenta\" },\r\n                ]}\r\n              /> */}\r\n              \r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IMAGE :  \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n            <FormMultipleUpload\r\n                name=\"image\"\r\n                style={{width: \"40%\"}}\r\n                values={image}\r\n                onChange={(values) => {\r\n                  handleChange(\"image\", values);\r\n                }}\r\n              />\r\n            </Form.Row>\r\n            \r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"LOCATION * :  \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <CustomInputModal\r\n                name=\"location\"\r\n                values={accessabilityPoints}\r\n                leftValue={accessabilityPoint}\r\n                rightValue={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? selectedDropdownStorageArea\r\n                    : selectedDropdownArea\r\n                }\r\n                leftId={accessabilityPoint}\r\n                rightId={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? storageAreaId\r\n                    : deliveryAreaId\r\n                }\r\n                chipValues={(values) => {\r\n                  console.log(JSON.stringify(values, null, 2));\r\n                  setDeliveryAndStorageLocations(values);\r\n                }}\r\n                leftDropdownValues={accessabilityPoints}\r\n                leftDropdwonPlaceholder={\"Select Location Type\"}\r\n                rightDropdownPlaceholder={\"Select Location\"}\r\n                leftDropdwonValueChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    setAccessabilityPoint(item);\r\n                    if (item === accessabilityPoints[0].value) {\r\n                      getStorageArea();\r\n                    }\r\n                    if (item === accessabilityPoints[1].value) {\r\n                      getDeliveryArea();\r\n                    } else {\r\n                      seltSelectedSiteDeliveryAreaIndex(0);\r\n                      setSelectedDropdownArea(\"\");\r\n                      setDeilveryAreaId(\"\");\r\n\r\n                      setSelectedStorageAreaIndex(0);\r\n                      setSelectedDropdownStorageArea(\"\");\r\n                      setStorageAreaId(\"\");\r\n                    }\r\n                  } else {\r\n                    seltSelectedSiteDeliveryAreaIndex(0);\r\n                    setSelectedDropdownArea(\"\");\r\n                    setDeilveryAreaId(\"\");\r\n\r\n                    setSelectedStorageAreaIndex(0);\r\n                    setSelectedDropdownStorageArea(\"\");\r\n                    setStorageAreaId(\"\");\r\n                  }\r\n                }}\r\n                rightDropdownValues={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? dropdownStorageAreas\r\n                    : dropdownDeliveryAreas\r\n                }\r\n                // error={addresses}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                rightDropdwonValueChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    if (accessabilityPoints[0].value === accessabilityPoint) {\r\n                      setStorageAreaId(storageAreas[index]._id);\r\n                      setSelectedStorageAreaIndex(index);\r\n                      setSelectedDropdownStorageArea(item);\r\n                    } else {\r\n                      setSelectedStorageAreaIndex(0);\r\n                      setSelectedDropdownStorageArea(\"\");\r\n                    }\r\n\r\n                    if (accessabilityPoints[1].value === accessabilityPoint) {\r\n                      setDeilveryAreaId(DeliveryAreas[index]._id);\r\n                      seltSelectedSiteDeliveryAreaIndex(index);\r\n                      setSelectedDropdownArea(item);\r\n                    } else {\r\n                      seltSelectedSiteDeliveryAreaIndex(0);\r\n                      setSelectedDropdownArea(\"\");\r\n                    }\r\n                  } else {\r\n                    setSelectedStorageAreaIndex(0);\r\n                    setSelectedDropdownStorageArea(\"\");\r\n                    seltSelectedSiteDeliveryAreaIndex(0);\r\n                    setSelectedDropdownArea(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"AVAILABILITIES * :\" />\r\n            <Form.Row\r\n              noMargin\r\n              width=\"65%\"\r\n              justifyContent=\"flex-start\"\r\n              style={{ gap: \"20px\" }}\r\n            >\r\n              <FormInput\r\n                type=\"date\"\r\n                style={{ width: \"300px\" }}\r\n                placeholder={`Start date`}\r\n                name=\"startDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={startDate}\r\n              />\r\n              <FormInput\r\n                type=\"date\"\r\n                placeholder=\"End date\"\r\n                style={{ width: \"300px\" }}\r\n                name=\"endDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={endDate}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TECHNICAL SHEET :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormMultipleUpload\r\n                name=\"techSheet\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={techSheet}\r\n                onChange={(values) => {\r\n                  handleChange(\"techSheet\", values);\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"UNAVAILABILITIES\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <div\r\n                // name=\"availability\"\r\n\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"0px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  color: \"#fff\",\r\n                  padding: \"0.8rem 0\",\r\n                  borderRadius: \"8px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\",\r\n                }}\r\n              >\r\n                SHOW UNAVAILABILITIES\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n          <FormLabel bold primary=\"HOURLY RATE :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <div style={{ width: \"30%\", height: \"100%\", position: \"relative\" }}>\r\n                <FormInput\r\n            \r\n                  type=\"number\"\r\n                  name=\"rate\"\r\n                  onChange={({ target: { name, value } }) =>\r\n                    handleChange(name, value)\r\n                  }\r\n                  value={rate}\r\n                />\r\n               <span style={{position: \"absolute\", top: \"25%\", right: \"5%\"}}>€</span>\r\n              </div>\r\n             \r\n            </Form.Row>\r\n          </Form.Row>\r\n          {/* <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"TARIF HORAIRE : \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormInput\r\n                textArea\r\n                rows={1}\r\n                style={{ width: \"300px\", textAlign: \"right\" }}\r\n                placeholder=\"€\"\r\n                name=\"rate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={rate}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row> */}\r\n\r\n          \r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONAL INFORMATION :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                maxLength=\"300\"\r\n                style={{ width: \"100%\" }}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                className=\"means-addinfo\"\r\n                onChange={({ target: { name, value } }) => {\r\n                  handleChange(name, value);\r\n                }}\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          {type && \"\"}\r\n          <Form.Row>\r\n            <Form.ButtonContainer style={{ width: \"80%\" }}>\r\n              <Button\r\n                minWidth={200}\r\n                text=\"VALIDATE\"\r\n                fullWidth={false}\r\n                onClick={async () => {\r\n                  await createMean();\r\n                }}\r\n                // loading={formik.isSubmitting}\r\n                disabled={\r\n                  !name ||\r\n                  !selectedMeanType ||\r\n                  !color ||\r\n                  !startDate ||\r\n                  !deliveryAndStorageLocations\r\n                }\r\n              />\r\n            </Form.ButtonContainer>\r\n          </Form.Row>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\EditMean.js",["651","652","653","654","655","656","657","658","659","660","661","662","663","664","665","666","667","668","669","670","671"],"import React, { useState, useEffect } from \"react\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/CustomFormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport CustomInputModal from \"../../../components/CustomInputModal\";\r\nimport CustomButtonModal from \"../../../components/CustomButtonModal\";\r\nimport moment from \"moment\";\r\nimport ColorPicker from \"../../../components/ColorPcker\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nconst accessabilityPoints = [\r\n  { label: \"Storage Area\", value: \"Storage Area\" },\r\n  { label: \"Delivery Area\", value: \"Delivery Area\" },\r\n];\r\n\r\nexport default function EditMean(props) {\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [name, setName] = useState(\"\");\r\n  const [type, setType] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [image, setImage] = useState([]);\r\n  const [startDate, setStartDate] = useState(\"\");\r\n  const [endDate, setEndDate] = useState(\"\");\r\n  const [techSheet, setTechSheet] = useState([]);\r\n  const [rate, setRate] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n  const [loading, setLoading] = useState(true);\r\n  const [disableDropdpwn, setDisableDropdown] = useState(false);\r\n  const classes = useStyles();\r\n\r\n  const [accessabilityPoint, setAccessabilityPoint] = useState(\"\");\r\n  const [DeliveryAreas, setDeliveryAreas] = useState([]);\r\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\r\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\r\n  const [\r\n    selectedSiteDeliveryAreadIndex,\r\n    seltSelectedSiteDeliveryAreaIndex,\r\n  ] = useState(null);\r\n\r\n  const [storageAreas, setStorageAreas] = useState([]);\r\n  const [dropdownStorageAreas, setDropdownStorageAreas] = useState([]);\r\n  const [\r\n    selectedDropdownStorageArea,\r\n    setSelectedDropdownStorageArea,\r\n  ] = useState(\"\");\r\n  const [selectedStorageAreaIndex, setSelectedStorageAreaIndex] = useState(\r\n    null,\r\n  );\r\n\r\n  const [deliveryAreaId, setDeilveryAreaId] = useState(\"\");\r\n  const [storageAreaId, setStorageAreaId] = useState(\"\");\r\n\r\n  const [\r\n    deliveryAndStorageLocations,\r\n    setDeliveryAndStorageLocations,\r\n  ] = useState([]);\r\n\r\n  const [buildings, setBuidings] = useState([]);\r\n  const [dropdownBuildings, setDropdownBuildings] = useState([]);\r\n  const [selectedDropdownBuilding, setSelectedDropdownBuilding] = useState(\"\");\r\n  const [selectedBuildingIndex, setSelectedBuildingIndex] = useState(null);\r\n\r\n  const [levels, setLevels] = useState([]);\r\n  const [dropdownLevels, setDropdownLevels] = useState([]);\r\n  const [selectedDropdownLevel, setSelectedDropdownLevel] = useState(\"\");\r\n  const [selectedDropdownIndex, setSelectedLevelIndex] = useState(null);\r\n\r\n  const [meanTypes, setMeanTypes] = useState([]);\r\n  const [dropdownMeanTypes, setDropdownMeanTypes] = useState([]);\r\n  const [selectedMeanType, setSelectedMeanType] = useState(\"\");\r\n  const [selecetedMeanTypeIndex, setSelectedMeanTypeIndex] = useState(null);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  const setValues = () => {\r\n    const mean = props.location.mean;\r\n    setName(mean.name);\r\n    let fileClone = [{ uri: mean.image }];\r\n    setImage(fileClone);\r\n    setSelectedMeanType(mean.meanType);\r\n    let meanTypeIndex = 0;\r\n    dropdownMeanTypes.forEach((item, index) => {\r\n      if (item.value === mean.meanType) meanTypeIndex = index;\r\n    });\r\n\r\n    setSelectedMeanTypeIndex(meanTypeIndex);\r\n\r\n    setColor(mean.color);\r\n\r\n    setStartDate(moment(mean.availability.start).format(\"MM/DD/yyyy\"));\r\n    setEndDate(moment(mean.availability.end).format(\"MM/DD/yyyy\"));\r\n    setRate(mean.pricePerHour);\r\n    setAddInfo(mean.additionalInfo);\r\n    const locationTemp = [];\r\n    mean.location.forEach((item, index) => {\r\n      let loc = { key: \"\", label: \"\", id: \"\", type: \"\" };\r\n\r\n      if (item.locationType === \"STORAGEAREA\") {\r\n        loc.key = item.storageArea._id;\r\n        loc.label = item.storageArea.name;\r\n        loc.id = item.storageArea._id;\r\n        loc.type = accessabilityPoints[0].value;\r\n        locationTemp.push(loc);\r\n      }\r\n      if (item.locationType === \"DELIVERYAREA\") {\r\n        loc.key = item.deliveryArea._id;\r\n        loc.label = item.deliveryArea.name;\r\n        loc.id = item.deliveryArea._id;\r\n        loc.type = accessabilityPoints[1].value;\r\n        locationTemp.push(loc);\r\n      }\r\n    });\r\n    setDeliveryAndStorageLocations(locationTemp);\r\n    console.log(JSON.stringify(locationTemp, null, 2));\r\n    // \"key\": \"61615286801076\",\r\n    // \"label\": \"storqg\",\r\n    // \"id\": \"60096007880eb61e9d7188d2\",\r\n    // \"type\": \"Storage Area\"\r\n  };\r\n  useEffect(() => {}, [\r\n    meanTypes,\r\n    dropdownMeanTypes,\r\n    selecetedMeanTypeIndex,\r\n    selectedMeanType,\r\n  ]);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_MEAN}/6008169bedbb7816d40b197d`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.site_delivery_areas !== null) {\r\n          const temp = [];\r\n          response.data.site_delivery_areas.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name, id: item._id }),\r\n          );\r\n          await setDeliveryAreas(response.data.site_delivery_areas);\r\n          await setDropdownDeliveryAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_storage_areas !== null) {\r\n          const temp = [];\r\n          response.data.site_storage_areas.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name, id: item._id }),\r\n          );\r\n          await setStorageAreas(response.data.site_storage_areas);\r\n          await setDropdownStorageAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_buildings !== null) {\r\n          const temp = [];\r\n          response.data.site_buildings.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n          await setBuidings(response.data.site_buildings);\r\n          await setDropdownBuildings(temp);\r\n        }\r\n\r\n        if (response.data.mean_types !== null) {\r\n          const temp = [];\r\n          response.data.mean_types.map((item, index) =>\r\n            temp.push({ label: item, value: item }),\r\n          );\r\n          await setMeanTypes(response.data.mean_types);\r\n          await setDropdownMeanTypes(temp);\r\n        }\r\n        // if (response.data.mean_types !== null) {\r\n        //   setTypes(response.data.mean_types);\r\n        //   const temp = [];\r\n        //   response.data.mean_types.map((item, index) => {\r\n        //     temp.push({ label: item, value: item });\r\n        //   });\r\n        //   setDropdownTypes(temp);\r\n        // }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n      await setValues();\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  function handleChange(name, value) {\r\n    //alert(JSON.stringify(value, null, 2));\r\n    if (name === \"name\") setName(value);\r\n    else if (name === \"type\") setType(value);\r\n    else if (name === \"color\") setColor(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"startDate\") setStartDate(value);\r\n    else if (name === \"endDate\") setEndDate(value);\r\n    else if (name === \"techSheet\") setTechSheet(value);\r\n    else if (name === \"rate\") setRate(value);\r\n    else if (name === \"addInfo\") setAddInfo(value);\r\n  }\r\n\r\n  const updateMean = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      var formdata = new FormData();\r\n\r\n      let locations = [];\r\n\r\n      deliveryAndStorageLocations.forEach((item) => {\r\n        if (item.type === accessabilityPoints[0].value) {\r\n          let loc = {\r\n            locationType: \"STORAGEAREA\",\r\n            storageArea: item.id,\r\n          };\r\n          locations.push(loc);\r\n        }\r\n        if (item.type === accessabilityPoints[1].value) {\r\n          let loc = {\r\n            locationType: \"DELIVERYAREA\",\r\n            deliveryArea: item.id,\r\n          };\r\n          locations.push(loc);\r\n        }\r\n      });\r\n\r\n      let availabilities = {\r\n        start: startDate,\r\n        end: endDate,\r\n      };\r\n\r\n      // TEST DATA , CALENDAR NOT MADE YET\r\n\r\n      const sampleDateOne = new Date(\"05/20/2021\");\r\n      const sampleDateTwo = new Date(\"05/28/2021\");\r\n      // const unavailabilities = [\r\n      //   {\r\n      //     date: sampleDateOne,\r\n      //     reason: \"Public Holiday\",\r\n      //     startingHour: new Date().getTime(),\r\n      //     endingHour: new Date().getTime(),\r\n      //   },\r\n      //   {\r\n      //     date: sampleDateTwo,\r\n      //     reason: \"Maintenance\",\r\n      //     startingHour: new Date().getTime(),\r\n      //     endingHour: new Date().getTime(),\r\n      //   },\r\n      // ];\r\n\r\n      formdata.append(\"name\", name);\r\n      formdata.append(\"color\", color);\r\n      if (image.length != 0 && image[0].file != undefined)\r\n        formdata.append(\"image\", image[0].file);\r\n      if (image.length != 0 && image[0].file != undefined)\r\n        formdata.append(\"sheet\", image[0].file);\r\n      formdata.append(\"pricePerHour\", rate);\r\n      formdata.append(\"additionalInfo\", addInfo);\r\n      formdata.append(\"siteId\", \"6008169bedbb7816d40b197d\");\r\n      formdata.append(\"meanType\", selectedMeanType);\r\n      formdata.append(\"location\", JSON.stringify(locations));\r\n      formdata.append(\"availability\", JSON.stringify(availabilities));\r\n      //formdata.append(\"unavailability\", JSON.stringify(unavailabilities));\r\n\r\n      const response = await GLOBALS.API({\r\n        method: \"PUT\",\r\n        uri: GLOBALS.Constants.UPDATE_MEAN + \"/\" + props.location.mean._id,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n        dispatch(\r\n          Actions.notistack.enqueueSnackbar(\r\n            Actions.notistack.snackbar(response.message, \"error\"),\r\n          ),\r\n        );\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getDeliveryArea = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data !== null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n\r\n          setDropdownDeliveryAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getStorageArea = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data !== null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n\r\n          setDropdownStorageAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const handleChangecolor = (color) => {\r\n    setColor(color.hex);\r\n    console.log(\"color is\", color.hex);\r\n  };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n\r\n      <Form.Row>\r\n        <Heading primary=\"EDIT A MEAN\" />\r\n\r\n        {/* <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"LOCALISATION\"\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginRight: \"100px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\"\r\n                }}\r\n              /> */}\r\n      </Form.Row>\r\n      {loading && \"\"}\r\n      {levels && \"\"}\r\n      {selectedDropdownIndex && \"\"}\r\n      {meanTypes && \"\"}\r\n      {selectedBuildingIndex && \"\"}\r\n      {DeliveryAreas && \"\"}\r\n      {selectedSiteDeliveryAreadIndex && \"\"}\r\n      {storageAreas && \"\"}\r\n      {selectedStorageAreaIndex && \"\"}\r\n      <div className={classes.content}>\r\n        <Form.Form>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY * : \" />\r\n            <Form.Row noMargin width=\"65%\" style={{ gap: \"20px\" }}>\r\n              <FormInput\r\n                name=\"name\"\r\n                style={{ width: \"25%\" }}\r\n                placeholder=\"name\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={name}\r\n              />\r\n              <FormSelect\r\n                placeholder=\"Type\"\r\n                name=\"type\"\r\n                value={selectedMeanType}\r\n                style={{ width: \"25%\" }}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    setSelectedMeanTypeIndex(index);\r\n                    setSelectedMeanType(item);\r\n                  } else {\r\n                    setSelectedMeanTypeIndex(null);\r\n                    setSelectedMeanType(\"\");\r\n                  }\r\n                }}\r\n                values={dropdownMeanTypes}\r\n              />\r\n              <div style={{ width: \"25%\" }}>\r\n                <ColorPicker color={color} handleChange={handleChangecolor} />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IMAGE :  \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormMultipleUpload\r\n                name=\"image\"\r\n                style={{ width: \"40%\" }}\r\n                values={image}\r\n                onChange={(values) => {\r\n                  handleChange(\"image\", values);\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"LOCATION * :  \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <CustomInputModal\r\n                name=\"location\"\r\n                values={accessabilityPoints}\r\n                chipDefaultValues={deliveryAndStorageLocations}\r\n                leftValue={accessabilityPoint}\r\n                rightValue={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? selectedDropdownStorageArea\r\n                    : selectedDropdownArea\r\n                }\r\n                leftId={accessabilityPoint}\r\n                rightId={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? storageAreaId\r\n                    : deliveryAreaId\r\n                }\r\n                chipValues={(values) => {\r\n                  setDeliveryAndStorageLocations(values);\r\n                }}\r\n                leftDropdownValues={accessabilityPoints}\r\n                leftDropdwonPlaceholder={\"Select Location Type\"}\r\n                rightDropdownPlaceholder={\"Select Location\"}\r\n                leftDropdwonValueChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    setAccessabilityPoint(item);\r\n                    if (item === accessabilityPoints[0].value) {\r\n                      getStorageArea();\r\n                    }\r\n                    if (item === accessabilityPoints[1].value) {\r\n                      getDeliveryArea();\r\n                    } else {\r\n                      seltSelectedSiteDeliveryAreaIndex(0);\r\n                      setSelectedDropdownArea(\"\");\r\n                      setDeilveryAreaId(\"\");\r\n\r\n                      setSelectedStorageAreaIndex(0);\r\n                      setSelectedDropdownStorageArea(\"\");\r\n                      setStorageAreaId(\"\");\r\n                    }\r\n                  } else {\r\n                    seltSelectedSiteDeliveryAreaIndex(0);\r\n                    setSelectedDropdownArea(\"\");\r\n                    setDeilveryAreaId(\"\");\r\n\r\n                    setSelectedStorageAreaIndex(0);\r\n                    setSelectedDropdownStorageArea(\"\");\r\n                    setStorageAreaId(\"\");\r\n                  }\r\n                }}\r\n                rightDropdownValues={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? dropdownStorageAreas\r\n                    : dropdownDeliveryAreas\r\n                }\r\n                // error={addresses}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                rightDropdwonValueChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    if (accessabilityPoints[0].value === accessabilityPoint) {\r\n                      setStorageAreaId(storageAreas[index]._id);\r\n                      setSelectedStorageAreaIndex(index);\r\n                      setSelectedDropdownStorageArea(item);\r\n                    } else {\r\n                      setSelectedStorageAreaIndex(0);\r\n                      setSelectedDropdownStorageArea(\"\");\r\n                    }\r\n\r\n                    if (accessabilityPoints[1].value === accessabilityPoint) {\r\n                      setDeilveryAreaId(DeliveryAreas[index]._id);\r\n                      seltSelectedSiteDeliveryAreaIndex(index);\r\n                      setSelectedDropdownArea(item);\r\n                    } else {\r\n                      seltSelectedSiteDeliveryAreaIndex(0);\r\n                      setSelectedDropdownArea(\"\");\r\n                    }\r\n                  } else {\r\n                    setSelectedStorageAreaIndex(0);\r\n                    setSelectedDropdownStorageArea(\"\");\r\n                    seltSelectedSiteDeliveryAreaIndex(0);\r\n                    setSelectedDropdownArea(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"AVAILAIBILITIES * :\" />\r\n            <Form.Row\r\n              noMargin\r\n              width=\"65%\"\r\n              justifyContent=\"flex-start\"\r\n              style={{ gap: \"20px\" }}\r\n            >\r\n              <FormInput\r\n                type=\"date\"\r\n                style={{ width: \"300px\" }}\r\n                placeholder={`Start date`}\r\n                name=\"startDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={startDate}\r\n              />\r\n              <FormInput\r\n                type=\"date\"\r\n                placeholder=\"End date\"\r\n                style={{ width: \"300px\" }}\r\n                name=\"endDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={endDate}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TECHNICAL SHEET :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormMultipleUpload\r\n                name=\"techSheet\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={techSheet}\r\n                onChange={(values) => {\r\n                  handleChange(\"techSheet\", values);\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"UNAVAILABILITIES\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <div\r\n                // name=\"availability\"\r\n\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"0px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  color: \"#fff\",\r\n                  padding: \"0.8rem 0\",\r\n                  borderRadius: \"8px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\",\r\n                }}\r\n              >\r\n                SHOW UNAVAILABILITIES\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"HOURLY RATE :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <div\r\n                style={{ width: \"30%\", height: \"100%\", position: \"relative\" }}\r\n              >\r\n                <FormInput\r\n                  type=\"number\"\r\n                  name=\"rate\"\r\n                  onChange={({ target: { name, value } }) =>\r\n                    handleChange(name, value)\r\n                  }\r\n                  value={rate}\r\n                />\r\n                <span style={{ position: \"absolute\", top: \"25%\", right: \"5%\" }}>\r\n                  €\r\n                </span>\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONAL INFORMATION :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                maxLength=\"300\"\r\n                style={{ width: \"100%\" }}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                className=\"means-addinfo\"\r\n                onChange={({ target: { name, value } }) => {\r\n                  handleChange(name, value);\r\n                }}\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          {type && \"\"}\r\n          <Form.Row>\r\n            <Form.ButtonContainer style={{ width: \"80%\" }}>\r\n              <Button\r\n                minWidth={200}\r\n                text=\"VALIDATE\"\r\n                fullWidth={false}\r\n                onClick={async () => {\r\n                  await updateMean();\r\n                }}\r\n 
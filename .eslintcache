ading && <Loader.AbsoluteLinear />}\r\n      {loading ? (\r\n        <Loader.CenterProgress />\r\n      ) : store.auth ? (\r\n        <SuperAdmin />\r\n      ) : (\r\n        <UnAuth />\r\n      )} */}\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\ErrorBoundary.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Loader.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\actions\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\reducers\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\UnAuth\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\actions\\auth.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\reducers\\auth.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\reducers\\notistack.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\actions\\notistack.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\UnAuth\\ForgotPassword.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\UnAuth\\LandingPage.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\UnAuth\\Login.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Home.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Logs.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\SuperAdminHeader.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Admins\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\actions\\actionTypes.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\redux\\utility.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\SmallText.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Input.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Heading.js",["349"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Button.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Form.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\SubHeading.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Card.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\UnAuth\\UnAuthHeader.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Admins\\AddAdmin.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Admins\\Admins.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\ArchivedSites.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddZAC.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\Sites.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\ZACs.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\VerifyClient.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\AddClient.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\Invoices.js",["350"],"import React, { useState, useEffect } from \"react\";\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport moment from \"moment\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\r\nimport { ReactComponent as Cross } from \"../../../assets/icons/Cross.svg\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n}));\r\n\r\nexport default function Invoices(props) {\r\n  const classes = useStyles();\r\n\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const [loading, setLoading] = useState(true);\r\n  const [items, setItems] = useState([]);\r\n  const [page] = useState(1);\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  async function fetchData() {\r\n    try {\r\n      const result = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.INVOICES}/${props.match.params.clientId}?page=${page}`,\r\n      });\r\n      setItems(result.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  async function onDelete(itemId) {\r\n    try {\r\n      if (window.confirm(\"Are you sure, you want to delete this?\")) {\r\n        setLoading(true);\r\n        await GLOBALS.API({\r\n          method: \"DELETE\",\r\n          token: store.token,\r\n          uri: GLOBALS.Constants.INVOICE_DELETE + \"/\" + itemId,\r\n        });\r\n        const itemsArray = items.filter((item) => item._id !== itemId);\r\n        setItems(itemsArray);\r\n        setLoading(false);\r\n      }\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const rows = items.map((item) => [\r\n    item.clientId.companyId.name,\r\n    moment(item.startDate).format(\"DD/MM/YYYY\"),\r\n    moment(item.endDate).format(\"DD/MM/YYYY\"),\r\n    item.siteId.name,\r\n    item.amount,\r\n    item.description,\r\n    <>\r\n      <IconButton>\r\n        <Pencil style={{ width: 18, height: 18 }} />\r\n      </IconButton>\r\n      <IconButton onClick={() => onDelete(item._id)}>\r\n        <Cross style={{ width: 18, height: 18, color: \"red\" }} />\r\n      </IconButton>\r\n    </>,\r\n  ]);\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Form.Row alignItems=\"center\">\r\n        <Heading primary=\"INVOICES\" noWrap />\r\n        <Button\r\n          fullWidth={false}\r\n          component={NavLink}\r\n          text=\"CREATE AN INVOICE\"\r\n          to=\"/clients/add-invoice\"\r\n        />\r\n      </Form.Row>\r\n      <Form.Row noMargin>\r\n        <FormSelect\r\n          placeholder=\"Client\"\r\n          values={[\r\n            { value: \"green\", label: \"Green\" },\r\n            { value: \"Yellow\", label: \"Yellow\" },\r\n            { value: \"Red\", label: \"Red\" },\r\n            { value: \"Blue\", label: \"Blue\" },\r\n            { value: \"Orange\", label: \"Orange\" },\r\n            { value: \"Purple\", label: \"Purple\" },\r\n            { value: \"Magenta\", label: \"Magenta\" },\r\n          ]}\r\n          style={{ maxWidth: 250 }}\r\n        />\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Table headers={GLOBALS.Data.invoices.headings} rows={rows} />\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\Clients.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\AddInvoice.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Footer.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\API.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\Styles.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\globals\\Constants.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\index.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormInput.js",["351"],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormLabel.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormSelect.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\FormMultipleUpload.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Modal.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Table.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\AvatarUpload.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\SearchInput.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\SmallButton.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\RadioButton.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\MultiAdderInput.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\components\\Stepper.js",[],"C:\\Users\\user\\Documents\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep3.js",[],"C:\\Users\\user\\Documents\\or
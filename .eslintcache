uperAdmin/Sites/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Clients/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Admins/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/redux/actions/actionTypes.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/redux/utility.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Heading.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/SubHeading.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/SmallText.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Button.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Input.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Form.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/UnAuth/UnAuthHeader.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Footer.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/globals/index.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/ArchivedSites.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Admins/AddAdmin.js",["294"],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Admins/Admins.js",["295","296"],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Clients/AddInvoice.js",["297","298"],"import React, { useEffect, useState } from \"react\";\nimport { useFormik } from \"formik\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport { useSelector, useDispatch } from \"react-redux\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport * as Yup from \"yup\";\n\nimport GLOBALS from \"../../../globals\";\nimport Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport FormLabel from \"../../../components/FormLabel\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n}));\n\nconst addInvoiceYup = Yup.object().shape({\n  clientId: Yup.string().required(\"Required\"),\n  startData: Yup.string().required(\"Required\"),\n  endData: Yup.string().required(\"Required\"),\n  siteId: Yup.string().required(\"Required\"),\n  amount: Yup.number().min(1, \"Must have a value\").required(\"Required\"),\n  description: Yup.string().optional(),\n});\n\nexport default function AddInvoice(props) {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [items, setItems] = useState([]);\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.CLIENTS}`,\n      });\n      let itemsArray = result.data.items.map((item) => ({\n        value: item._id,\n        label: item.companyId.name,\n      }));\n      setItems(itemsArray);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const onSubmit = async (values) => {\n    const formdata = JSON.stringify({\n      clientId: values.clientId,\n      startData: values.startData,\n      endData: values.endData,\n      siteId: values.siteId,\n      amount: values.amount,\n      description: values.description,\n    });\n\n    // await GLOBALS.API({\n    //   method: \"POST\",\n    //   uri: GLOBALS.Constants.INVOICES,\n    // token: store.token\n    //   body: formdata,\n    // });\n    formik.setSubmitting(false);\n    // props.history.goBack();\n  };\n\n  const formik = useFormik({\n    initialValues: {\n      clientId: \"\",\n      startData: \"\",\n      endData: \"\",\n      siteId: \"\",\n      amount: 0,\n      description: \"\",\n    },\n    validationSchema: addInvoiceYup,\n    onSubmit,\n  });\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n      <Heading primary=\"ADD AN INVOICE\" />\n      <div className={classes.content}>\n        <Form.Form onSubmit={formik.handleSubmit}>\n          <Form.Row>\n            <FormLabel bold primary=\"CLIENT NAME* :\" />\n            <FormSelect\n              values={items}\n              name=\"clientId\"\n              placeholder=\"Client Name\"\n              onChange={formik.handleChange}\n              value={formik.values.clientId}\n              error={formik.errors.clientId}\n              style={GLOBALS.Styles.inputWidth}\n            />\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"INVOICE DATES* : \" />\n            <Form.Row noMargin width=\"48%\">\n              <FormInput\n                type=\"date\"\n                name=\"startData\"\n                placeholder=\"Start date\"\n                onChange={formik.handleChange}\n                value={formik.values.startData}\n                error={formik.errors.startData}\n                style={GLOBALS.Styles.inputWidth}\n              />\n              <FormInput\n                type=\"date\"\n                name=\"endData\"\n                placeholder=\"End date\"\n                value={formik.values.endData}\n                error={formik.errors.endData}\n                onChange={formik.handleChange}\n                style={GLOBALS.Styles.inputWidth}\n              />\n            </Form.Row>\n          </Form.Row>\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"CONSTRUCTION SITE*:\" />\n            <FormSelect\n              name=\"siteId\"\n              values={items}\n              value={formik.values.siteId}\n              error={formik.errors.siteId}\n              onChange={formik.handleChange}\n              placeholder=\"Construction Site\"\n              style={GLOBALS.Styles.inputWidth}\n            />\n          </Form.Row>\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"AMOUNT*:\" />\n            <FormInput\n              type=\"number\"\n              name=\"amount\"\n              value={formik.values.amount}\n              error={formik.errors.amount}\n              onChange={formik.handleChange}\n              style={GLOBALS.Styles.inputWidth}\n            />\n          </Form.Row>\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"DESCRIPTION:\" />\n            <FormInput\n              textArea\n              rows={3}\n              name=\"description\"\n              placeholder=\"Description\"\n              onChange={formik.handleChange}\n              style={GLOBALS.Styles.inputWidth}\n              value={formik.values.description}\n              error={formik.errors.description}\n            />\n          </Form.Row>\n          <Form.ButtonContainer>\n            <Button\n              type=\"submit\"\n              minWidth={200}\n              text=\"VALIDATE\"\n              fullWidth={false}\n              loading={formik.isSubmitting}\n              disabled={formik.isSubmitting}\n            />\n          </Form.ButtonContainer>\n        </Form.Form>\n      </div>\n    </div>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Clients/VerifyClient.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Clients/Clients.js",["299","300"],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Clients/Invoices.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Clients/AddClient.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/Sites.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/ZACs.js",["301"],"import React, { useState, useEffect } from \"react\";\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\nimport GLOBALS from \"../../../globals\";\nimport Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport { ReactComponent as Cross } from \"../../../assets/icons/Cross.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: \"40px 15px\",\n  },\n  content: {\n    padding: 15,\n    marginTop: 10,\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    backgroundColor: theme.palette.secondary.main,\n  },\n}));\n\nexport default function ZACS(props) {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [loading, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n  const [page, setPage] = useState(1);\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.ZACS}?page=${page}`,\n      });\n      setItems(result.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err, \"error\"),\n        ),\n      );\n    }\n  }\n\n  async function onDelete(itemId) {\n    try {\n      if (window.confirm(\"Are you sure, you want to delete this?\")) {\n        setLoading(true);\n        await GLOBALS.API({\n          method: \"DELETE\",\n          token: store.token,\n          uri: GLOBALS.Constants.ZACS + \"/\" + itemId,\n        });\n        const itemsArray = items.filter((item) => item._id !== itemId);\n        setItems(itemsArray);\n        setLoading(false);\n      }\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const rows = [];\n  items.map((item) => {\n    rows.push([\n      item.name,\n      item.sites.length,\n      <IconButton disabled={loading} onClick={() => onDelete(item._id)}>\n        <Cross style={{ width: 18, height: 18, color: \"red\" }} />\n      </IconButton>,\n    ]);\n    return true;\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row>\n        <Heading primary=\"ZACS LIST\" />\n        <Button\n          fullWidth={false}\n          component={NavLink}\n          text=\"CREATE A ZAC\"\n          to=\"/sites/add-zac\"\n        />\n      </Form.Row>\n      <div className={classes.content}>\n        <Table headers={GLOBALS.Data.zacs.headings} rows={rows} />\n      </div>\n    </div>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddZAC.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Card.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/globals/Styles.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/globals/API.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/globals/Constants.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/index.js",["302"],"import React, { useState } from \"react\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\nimport GLOBALS from \"../../../../globals\";\nimport AddSiteStep1 from \"./AddSiteStep1\";\nimport AddSiteStep2 from \"./AddSiteStep2\";\nimport AddSiteStep3 from \"./AddSiteStep3\";\nimport Stepper from \"../../../../components/Stepper\";\nimport Heading from \"../../../../components/Heading\";\nimport { ReactComponent as BackArrow } from \"../../../../assets/icons/BackArrow.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n}));\n\nexport default function AddSite(props) {\n  const classes = useStyles();\n\n  const [step, setStep] = useState(1);\n  const [step1Data, setStep1Data] = useState(\"\");\n  const [step2Data, setStep2Data] = useState(\"\");\n  const [siteCreated, setSiteCreated] = useState(\"\");\n\n  const onSubmit = () => {\n    console.log(\"onSubmit\", {\n      step1Data,\n      step2Data,\n      siteCreated,\n    });\n  };\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n      <Heading primary=\"CREATE A SITE\" />\n      <Stepper\n        disabled\n        step={step}\n        setStep={setStep}\n        steps={[\"Step 1: General Information\", \"Step 2: Dates\", \"Text 1: PIC\"]}\n      />\n      <div className={classes.content}>\n        {step === 1 ? (\n          <AddSiteStep1\n            step={step}\n            setStep={setStep}\n            step1Data={step1Data}\n            setStep1Data={setStep1Data}\n          />\n        ) : step === 2 ? (\n          <AddSiteStep2\n            step={step}\n            setStep={setStep}\n            step2Data={step2Data}\n            setStep2Data={setStep2Data}\n          />\n        ) : (\n          <AddSiteStep3\n            step={step}\n            setStep={setStep}\n            onSubmit={onSubmit}\n            siteCreated={siteCreated}\n          />\n        )}\n      </div>\n    </div>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Table.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/SmallButton.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/SearchInput.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/FormLabel.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/FormMultipleUpload.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/FormInput.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/FormSelect.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Modal.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/AvatarUpload.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/Stepper.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep3.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep2.js",["303"],"import React from \"react\";\nimport { useTheme } from \"@material-ui/core/styles\";\nimport { useFormik } from \"formik\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport * as Yup from \"yup\";\n\nimport GLOBALS from \"../../../../globals\";\nimport Actions from \"../../../../redux/actions\";\n\nimport Form from \"../../../../components/Form\";\nimport Button from \"../../../../components/Button\";\nimport SmallText from \"../../../../components/SmallText\";\nimport FormInput from \"../../../../components/FormInput\";\nimport FormLabel from \"../../../../components/FormLabel\";\nimport OpeningTimes from \"../../../../components/OpeningTimes\";\nimport UnavailabilityTimes from \"../../../../components/UnavailabilityTimes\";\nimport MultiAdderInput from \"../../../../components/MultiAdderInput\";\n\nconst addSiteYup = Yup.object().shape({\n  start: Yup.string().required(\"Required\"),\n  end: Yup.string().required(\"Required\"),\n  openingHours: Yup.object().shape({\n    day1Start: Yup.number().required(\"Required\"),\n    day1End: Yup.number().required(\"Required\"),\n    day2Start: Yup.number().required(\"Required\"),\n    day2End: Yup.number().required(\"Required\"),\n    day3Start: Yup.number().required(\"Required\"),\n    day3End: Yup.number().required(\"Required\"),\n    day4Start: Yup.number().required(\"Required\"),\n    day4End: Yup.number().required(\"Required\"),\n    day5Start: Yup.number().required(\"Required\"),\n    day5End: Yup.number().required(\"Required\"),\n    day6Start: Yup.number().required(\"Required\"),\n    day6End: Yup.number().required(\"Required\"),\n    day7Start: Yup.number().required(\"Required\"),\n    day7End: Yup.number().required(\"Required\"),\n  }),\n  unavailabilityDates: Yup.array()\n    .of(\n      Yup.object().shape({\n        key: Yup.number().required(\"Required\"),\n        date: Yup.date().required(\"Required\"),\n        startHour: Yup.number().required(\"Required\"),\n        endHour: Yup.number().required(\"Required\"),\n        dayOff: Yup.bool().required(\"Required\"),\n        reason: Yup.string().optional(),\n      }),\n    )\n    .optional(),\n  additionalInfo: Yup.string().optional(),\n  notificationPriorToDays: Yup.number().optional(),\n  notificationTo: Yup.array().optional(),\n});\n\nexport default function Profile(props) {\n  const theme = useTheme();\n  const store = useSelector((state) => state.auth);\n  const dispatch = useDispatch();\n\n  const onSubmit = async (values) => {\n    try {\n      console.log(\"values on Sumbit\", values);\n      props.setStep2Data(values);\n\n      const notificationTo = values.notificationTo.map((item) => item.label);\n\n      var formdata = new FormData();\n      formdata.append(\"logo\", values.logo[0].file);\n      formdata.append(\"name\", values.name);\n      formdata.append(\"zacId\", values.color);\n      formdata.append(\"adminId\", values.color);\n      formdata.append(\"functionality\", values.color);\n      formdata.append(\"addresses\", values.firstName);\n      formdata.append(\"trades\", values.lastName);\n      formdata.append(\"penaltyforLateDelivery\", values.email);\n      formdata.append(\"penaltyforUnexpDelivery\", values.phone);\n      formdata.append(\"start\", values.contractType);\n      formdata.append(\"end\", values.contractStartDate);\n      formdata.append(\"openingHours\", values.contractEndDate);\n      formdata.append(\"unavailabilityDates\", values.functionality);\n\n      formdata.append(\"additionalInfo\", values.additionalInfo);\n      formdata.append(\n        \"notificationPriorToDays\",\n        values.notificationPriorToDays,\n      );\n      formdata.append(\"notificationTo\", JSON.stringify(notificationTo));\n\n      await GLOBALS.API({\n        method: \"POST\",\n        uri: GLOBALS.Constants.SITE,\n        headers: {\n          Authorization: store.token,\n        },\n        body: formdata,\n      });\n\n      props.setStep(3);\n      formik.setSubmitting(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const formik = useFormik({\n    initialValues: {\n      start: \"\",\n      end: \"\",\n      openingHours: {\n        day1Start: 0,\n        day1End: 23,\n        day2Start: 0,\n        day2End: 23,\n        day3Start: 0,\n        day3End: 23,\n        day4Start: 0,\n        day4End: 23,\n        day5Start: 0,\n        day5End: 23,\n        day6Start: 0,\n        day6End: 23,\n        day7Start: 0,\n        day7End: 23,\n      },\n      unavailabilityDates: [],\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    validationSchema: addSiteYup,\n    onSubmit,\n    // validateOnBlur: false,\n    // validateOnChange: false,\n    // validateOnMount: false,\n  });\n\n  return (\n    <Form.Form onSubmit={formik.handleSubmit}>\n      <Form.Row>\n        <FormLabel bold primary=\"SITE DATES* : \" />\n        <Form.Row width=\"48%\" noMargin>\n          <FormInput\n            type=\"date\"\n            name=\"start\"\n            placeholder=\"Start date\"\n            value={formik.values.start}\n            error={formik.errors.start}\n            onChange={formik.handleChange}\n            style={GLOBALS.Styles.inputWidth}\n          />\n          <FormInput\n            name=\"end\"\n            type=\"date\"\n            placeholder=\"End date\"\n            value={formik.values.end}\n            error={formik.errors.end}\n            onChange={formik.handleChange}\n            style={GLOBALS.Styles.inputWidth}\n          />\n        </Form.Row>\n      </Form.Row>\n      <Form.Row>\n        <FormLabel bold primary=\"OPENING TIME : \" />\n        <Form.Row\n          noMargin\n          width=\"48%\"\n          alignItems=\"center\"\n          justifyContent=\"flex-start\"\n        >\n          <OpeningTimes\n            name=\"openingHours\"\n            style={GLOBALS.Styles.inputWidth}\n            values={formik.values.openingHours}\n            onBlur={() => formik.setFieldTouched(\"openingHours\", true, true)}\n            onChange={(values) => formik.setFieldValue(\"openingHours\", values)}\n          />\n        </Form.Row>\n      </Form.Row>\n      <Form.Row>\n        <FormLabel bold primary=\"UNAVAILABILITY TIME :\" />\n        <Form.Row\n          noMargin\n          width=\"48%\"\n          alignItems=\"center\"\n          justifyContent=\"flex-start\"\n        >\n          <UnavailabilityTimes\n            name=\"unavailabilityDates\"\n            style={GLOBALS.Styles.inputWidth}\n            values={formik.values.unavailabilityDates}\n            onBlur={() =>\n              formik.setFieldTouched(\"unavailabilityDates\", true, true)\n            }\n            onChange={(values) =>\n              formik.setFieldValue(\"unavailabilityDates\", values)\n            }\n          />\n        </Form.Row>\n      </Form.Row>\n      <Form.Row>\n        <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\n        <FormInput\n          textArea\n          rows={3}\n          name=\"additionalInfo\"\n          onChange={formik.handleChange}\n          style={GLOBALS.Styles.inputWidth}\n          placeholder=\"Additional information\"\n          value={formik.values.additionalInfo}\n          error={formik.errors.additionalInfo}\n        />\n      </Form.Row>\n      <Form.Row>\n        <FormLabel bold primary=\"NOTIFICATION : \" />\n        <Form.Row\n          noMargin\n          width=\"48%\"\n          justifyContent=\"flex-start\"\n          alignItems=\"center\"\n        >\n          <FormInput\n            type=\"number\"\n            name=\"notificationPriorToDays\"\n            onChange={formik.handleChange}\n            value={formik.values.notificationPriorToDays}\n            error={formik.errors.notificationPriorToDays}\n            style={{ ...GLOBALS.Styles.inputWidth, maxWidth: 100 }}\n          />\n          <SmallText\n            style={{ marginLeft: 10 }}\n            primary=\"Days before end of the site\"\n          />\n        </Form.Row>\n      </Form.Row>\n      <Form.Row style={{ alignItems: \"flex-start\" }}>\n        <FormLabel bold primary=\"NOTIFY THE ADDRESSES : \" />\n        <MultiAdderInput\n          name=\"notificationTo\"\n          validateError=\"Invalid Email\"\n          style={GLOBALS.Styles.inputWidth}\n          placeholder=\"Enter email address\"\n          values={formik.values.notificationTo}\n          onChange={(values) => formik.setFieldValue(\"notificationTo\", values)}\n          validate={(text) => {\n            const re = /^\\w+([.-]?\\w+)@\\w+([.-]?\\w+)(\\.\\w{2,3})+$/;\n            return !re.test(String(text).toLowerCase());\n          }}\n        />\n      </Form.Row>\n      <Form.ButtonContainer>\n        <Button\n          type=\"submit\"\n          minWidth={200}\n          text=\"VALIDATE\"\n          fullWidth={false}\n          loading={formik.isSubmitting}\n          disabled={formik.isSubmitting}\n        />\n      </Form.ButtonContainer>\n    </Form.Form>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep1.js",["304"],"import React, { useState, useEffect } from \"react\";\nimport { useFormik } from \"formik\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport * as Yup from \"yup\";\n\nimport GLOBALS from \"../../../../globals\";\nimport Actions from \"../../../../redux/actions\";\n\nimport Form from \"../../../../components/Form\";\nimport Button from \"../../../../components/Button\";\nimport SmallText from \"../../../../components/SmallText\";\nimport FormInput from \"../../../../components/FormInput\";\nimport FormLabel from \"../../../../components/FormLabel\";\nimport FormSelect from \"../../../../components/FormSelect\";\nimport RadioButton from \"../../../../components/RadioButton\";\nimport MultiAdderInput from \"../../../../components/MultiAdderInput\";\nimport FormMultipleUpload from \"../../../../components/FormMultipleUpload\";\nimport MultiAdderInputModal from \"../../../../components/MultiAdderInputModal\";\n\nconst addSiteYup = Yup.object().shape({\n  name: Yup.string().required(\"Required\"),\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\n  zacId: Yup.string().optional(),\n  adminId: Yup.string().optional(),\n  functionality: Yup.string().required(\"Required\"),\n  addresses: Yup.array()\n    .of(\n      Yup.object().shape({\n        key: Yup.number().required(\"Required\"),\n        street: Yup.string().required(\"Required\"),\n        city: Yup.string().required(\"Required\"),\n        postal: Yup.string().required(\"Required\"),\n      }),\n    )\n    .min(1, \"At least one address is required\")\n    // .max(3)\n    .required(\"Required\"),\n  trades: Yup.array().of(Yup.string()).optional(),\n  penaltyforLateDelivery: Yup.number()\n    .min(1, \"Value should be greater than 0\")\n    .max(9999)\n    .required(\"Required\"),\n  penaltyforUnexpDelivery: Yup.number()\n    .min(1, \"Value should be greater than 0\")\n    .max(9999)\n    .required(\"Required\"),\n});\n\nexport default function AddSiteStep1(props) {\n  const store = useSelector((state) => state.auth);\n  const dispatch = useDispatch();\n\n  const [loading, setLoading] = useState(false);\n  const [zacs, setZacs] = useState([]);\n  const [clients, setClients] = useState([]);\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const zacsResult = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.ZACS}`,\n      });\n      const clientsResult = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.CLIENTS}`,\n      });\n\n      const zacsArray = zacsResult.data.items.map((zac) => ({\n        value: zac._id,\n        label: zac.name,\n      }));\n      const clientsArray = [];\n      clientsResult.data.items.map((client) => {\n        if (client.contract.length > 0) {\n          if (client.companyId.type !== \"MASTERCLIENT\") {\n            clientsArray.push({\n              value: client._id,\n              label: `${client.userId.firstName} ${client.userId.lastName}`,\n            });\n          }\n        }\n        return true;\n      });\n\n      setZacs(zacsArray);\n      setClients(clientsArray);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const onSubmit = async (values) => {\n    console.log(\"values\", values);\n    props.setStep1Data(values);\n    formik.setSubmitting(false);\n    props.setStep(2);\n  };\n\n  const formik = useFormik({\n    initialValues: {\n      name: \"\",\n      logo: [],\n      zacId: \"\",\n      adminId: \"\",\n      functionality: \"DELIVERY\",\n      addresses: [],\n      trades: [],\n      penaltyforLateDelivery: 0,\n      penaltyforUnexpDelivery: 0,\n    },\n    validationSchema: addSiteYup,\n    onSubmit,\n    // validateOnBlur: false,\n    // validateOnChange: false,\n    // validateOnMount: false,\n  });\n\n  return (\n    <>\n      <Form.Form onSubmit={formik.handleSubmit}>\n        <Form.Row>\n          <FormLabel bold primary=\"SITE NAME* :\" />\n          <FormInput\n            name=\"name\"\n            placeholder=\"Site name\"\n            value={formik.values.name}\n            error={formik.errors.name}\n            onBlur={formik.handleBlur}\n            onChange={formik.handleChange}\n            style={GLOBALS.Styles.inputWidth}\n          />\n        </Form.Row>\n        <Form.Row>\n          <FormLabel bold primary=\"SITE PICTURE : \" />\n          <FormMultipleUpload\n            name=\"logo\"\n            error={formik.errors.logo}\n            values={formik.values.logo}\n            style={GLOBALS.Styles.inputWidth}\n            onBlur={() => formik.setFieldTouched(\"logo\", true, true)}\n            onChange={(values) => formik.setFieldValue(\"logo\", values)}\n          />\n        </Form.Row>\n        <Form.Row>\n          <FormLabel bold primary=\"ZAC OF THE SITE : \" />\n          <Form.Row width=\"48%\" noMargin>\n            <FormSelect\n              name=\"zacId\"\n              values={zacs}\n              placeholder=\"ZAC\"\n              onBlur={formik.handleBlur}\n              value={formik.values.zacId}\n              error={formik.errors.zacId}\n              onChange={formik.handleChange}\n              style={GLOBALS.Styles.inputWidth}\n            />\n          </Form.Row>\n        </Form.Row>\n        <Form.Row>\n          <FormLabel bold primary=\"SITE RESPONSIBLE* :\" />\n          <Form.Row width=\"48%\" noMargin>\n            <FormSelect\n              name=\"adminId\"\n              values={clients}\n              // placeholder=\"Admin\"\n              onBlur={formik.handleBlur}\n              value={formik.values.adminId}\n              error={formik.errors.adminId}\n              onChange={formik.handleChange}\n              style={GLOBALS.Styles.inputWidth}\n            />\n          </Form.Row>\n        </Form.Row>\n        <Form.Row>\n          <FormLabel bold primary=\"AVAILABLE FUNCTIONALITY : \" />\n          <RadioButton\n            name=\"functionality\"\n            onBlur={formik.handleBlur}\n            onChange={formik.handleChange}\n            style={GLOBALS.Styles.inputWidth}\n            value={formik.values.functionality}\n            error={formik.errors.functionality}\n            items={[{ value: \"DELIVERY\", label: \"Delivery module\" }]}\n          />\n        </Form.Row>\n\n        <Form.Row>\n          <FormLabel bold primary=\"SITE ADDRESS(ES)* : \" />\n          <MultiAdderInputModal\n            name=\"addresses\"\n            values={formik.values.addresses}\n            style={GLOBALS.Styles.inputWidth}\n            error={formik.errors.addresses}\n            placeholder=\"Enter site addresses\"\n            onBlur={() => formik.setFieldTouched(\"addresses\", true, true)}\n            onChange={(values) => formik.setFieldValue(\"addresses\", values)}\n          />\n        </Form.Row>\n        <Form.Row>\n          <FormLabel bold primary=\"TRADES : \" />\n          <MultiAdderInput\n            name=\"trades\"\n            placeholder=\"Entert trades\"\n            values={formik.values.trades}\n            style={GLOBALS.Styles.inputWidth}\n            onBlur={() => formik.setFieldTouched(\"trades\", true, true)}\n            onChange={(values) => formik.setFieldValue(\"trades\", values)}\n          />\n        </Form.Row>\n        <Form.Row>\n          <FormLabel bold primary=\"COST OF DELIVERY PENALITIES: \" />\n          <Form.Row width=\"48%\" noMargin>\n            <Form.Row width=\"48%\" noMargin alignItems=\"center\">\n              <FormInput\n                type=\"number\"\n                placeholder=\"Delay\"\n                onBlur={formik.handleBlur}\n                name=\"penaltyforLateDelivery\"\n                onChange={formik.handleChange}\n                value={formik.values.penaltyforLateDelivery}\n                error={formik.errors.penaltyforLateDelivery}\n              />\n              <SmallText style={{ marginLeft: 10 }} primary=\"€\" />\n            </Form.Row>\n            <Form.Row width=\"48%\" noMargin alignItems=\"center\">\n              <FormInput\n                type=\"number\"\n                onBlur={formik.handleBlur}\n                placeholder=\"Unexp delivery\"\n                name=\"penaltyforUnexpDelivery\"\n                onChange={formik.handleChange}\n                value={formik.values.penaltyforUnexpDelivery}\n                error={formik.errors.penaltyforUnexpDelivery}\n              />\n              <SmallText style={{ marginLeft: 10 }} primary=\"€\" />\n            </Form.Row>\n          </Form.Row>\n        </Form.Row>\n        <Form.ButtonContainer>\n          <Button\n            type=\"submit\"\n            minWidth={200}\n            text=\"VALIDATE\"\n            fullWidth={false}\n            loading={formik.isSubmitting}\n            disabled={formik.isSubmitting || loading}\n          />\n        </Form.ButtonContainer>\n      </Form.Form>\n    </>\n  );\n}\n","/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/MultiAdderInput.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/RadioButton.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/MultiAdderInputModal.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/OpeningTimes.js",[],"/Users/macbookpro/Desktop/Data/orgaplan/orgaplan-reactjs/src/components/UnavailabilityTimes.js",[],{"ruleId":"305","replacedBy":"306"},{"ruleId":"307","replacedBy":"308"},{"ruleId":"309","severity":1,"message":"310","line":29,"column":7,"nodeType":"311","messageId":"312","endLine":29,"endColumn":18},{"ruleId":"309","severity":1,"message":"313","line":59,"column":10,"nodeType":"311","messageId":"312","endLine":59,"endColumn":17},{"ruleId":"309","severity":1,"message":"314","line":61,"column":16,"nodeType":"311","messageId":"312","endLine":61,"endColumn":23},{"ruleId":"309","severity":1,"message":"315","line":41,"column":9,"nodeType":"311","messageId":"312","endLine":41,"endColumn":14},{"ruleId":"309","severity":1,"message":"316","line":70,"column":11,"nodeType":"311","messageId":"312","endLine":70,"endColumn":19},{"ruleId":"309","severity":1,"message":"314","line":72,"column":16,"nodeType":"311","messageId":"312","endLine":72,"endColumn":23},{"ruleId":"309","severity":1,"message":"317","line":85,"column":13,"nodeType":"311","messageId":"312","endLine":85,"endColumn":19},{"ruleId":"309","severity":1,"message":"314","line":36,"column":16,"nodeType":"311","messageId":"312","endLine":36,"endColumn":23},{"ruleId":"309","severity":1,"message":"318","line":29,"column":23,"nodeType":"311","messageId":"312","endLine":29,"endColumn":37},{"ruleId":"309","severity":1,"message":"319","line":56,"column":9,"nodeType":"311","messageId":"312","endLine":56,"endColumn":14},{"ruleId":"309","severity":1,"message":"315","line":50,"column":9,"nodeType":"311","messageId":"312","endLine":50,"endColumn":14},"no-native-reassign",["320"],"no-negated-in-lhs",["321"],"no-unused-vars","'addAdminYup' is assigned a value but never used.","Identifier","unusedVar","'loading' is assigned a value but never used.","'setPage' is assigned a value but never used.","'store' is assigned a value but never used.","'formdata' is assigned a value but never used.","'result' is assigned a value but never used.","'setSiteCreated' is assigned a value but never used.","'theme' is assigned a value but never used.","no-global-assign","no-unsafe-negation"]
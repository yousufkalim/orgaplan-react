conButton\";\n\nimport GLOBALS from \"../../../globals\";\nimport Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Modal from \"../../../components/Modal\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport AvatarUpload from \"../../../components/AvatarUpload\";\n\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n}));\n\nconst updateAdminYup = Yup.object().shape({\n  firstName: Yup.string().required(\"Required\"),\n  lastName: Yup.string().required(\"Required\"),\n  email: Yup.string().required(\"Required\"),\n  phone: Yup.number()\n    .test(\n      \"len\",\n      \"Must be exactly 10 characters\",\n      (val) => val && val.toString().length === 10,\n    )\n    .required(\"Required\"),\n  image: Yup.array().min(1, \"Required\").required(\"Required\"),\n  color: Yup.string().required(\"Required\"),\n});\n\nexport default function Admins(props) {\n  const theme = useTheme();\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [loading, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n  const [page, setPage] = useState(1);\n\n  const [modal, setModal] = useState(false);\n  const [selectedItem, setSelectedItem] = useState(\"\");\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.ADMINS}?page=${page}`,\n      });\n      setItems(result.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const onUpdate = async (values) => {\n    var formdata = new FormData();\n    formdata.append(\"image\", values.image.file);\n    formdata.append(\"color\", values.color);\n    formdata.append(\"userId\", selectedItem.userId._id);\n    formdata.append(\"firstName\", values.firstName);\n    formdata.append(\"lastName\", values.lastName);\n    formdata.append(\"email\", values.email);\n    formdata.append(\"phone\", values.phone);\n\n    const result = await GLOBALS.API({\n      method: \"PUT\",\n      uri: GLOBALS.Constants.ADMINS,\n      headers: {\n        Authorization: store.token,\n      },\n      body: formdata,\n    });\n    const itemsArray = items.map((item) =>\n      item._id === selectedItem._id ? result.data : item,\n    );\n    setItems(itemsArray);\n    setModal(false);\n    formik.setSubmitting(false);\n  };\n\n  const formik = useFormik({\n    initialValues: {\n      email: \"\",\n      phone: \"\",\n      firstName: \"\",\n      lastName: \"\",\n      image: \"\",\n      color: \"\",\n    },\n    validationSchema: updateAdminYup,\n    onSubmit: onUpdate,\n  });\n\n  return (\n    <>\n      <div className={classes.root}>\n        <Form.Row alignItems=\"center\">\n          <Heading primary=\"ADMINS LIST\" noWrap />\n          <div>\n            <Form.Row alignItems=\"center\" noMargin>\n              <SubHeading disableMargin primary=\"Total : 234 Admins\" bold />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"CREATE AN ADMIN\"\n                style={{ marginLeft: \"20px\" }}\n                to={\"/admins/add-admin\"}\n              />\n            </Form.Row>\n          </div>\n        </Form.Row>\n        <Form.Row noMargin>\n          <SearchInput placeholder=\"Name\" />\n        </Form.Row>\n        <div className={classes.content}>\n          <Table\n            headers={GLOBALS.Data.admins.headings}\n            rows={items.map((item) => {\n              const sendTo = [\n                \"-\",\n                item.firstName + \" \" + item.lastName,\n                item.phone,\n                0,\n              ];\n              return [\n                ...sendTo,\n                <IconButton\n                  onClick={() => {\n                    setSelectedItem(item);\n                    formik.setValues({\n                      image: {\n                        uri: GLOBALS.Constants.BASE_URL + item.image,\n                      },\n                      color: item.color,\n                      phone: item.phone,\n                      firstName: item.firstName,\n                      lastName: item.lastName,\n                      email: item.email,\n                    });\n                    setModal(true);\n                  }}\n                >\n                  <Pencil style={{ width: 18, height: 18 }} />\n                </IconButton>,\n              ];\n            })}\n          />\n        </div>\n      </div>\n      <Modal\n        title=\"EDIT ADMIN\"\n        open={selectedItem ? modal : false}\n        onClose={() => setModal((st) => !st)}\n        body={\n          <Form.Form onSubmit={formik.handleSubmit}>\n            <Form.Row justifyContent=\"center\">\n              <AvatarUpload\n                onChange={(file) => {\n                  const uri = URL.createObjectURL(file);\n                  formik.setFieldValue(\"image\", { file, uri });\n                }}\n                value={formik.values.image}\n                error={formik.errors.image}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"email\"\n                value={formik.values.email}\n                error={formik.errors.email}\n                placeholder=\"E-mail Address\"\n                onChange={formik.handleChange}\n                style={GLOBALS.Styles.inputWidth}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"phone\"\n                placeholder=\"Phone Number\"\n                value={formik.values.phone}\n                error={formik.errors.phone}\n                onChange={formik.handleChange}\n                style={GLOBALS.Styles.inputWidth}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormSelect\n                name=\"color\"\n                placeholder=\"Color\"\n                value={formik.values.color}\n                error={formik.errors.color}\n                onChange={formik.handleChange}\n                style={GLOBALS.Styles.inputWidth}\n                values={[\n                  \"Green\",\n                  \"Yellow\",\n                  \"Red\",\n                  \"Blue\",\n                  \"Orange\",\n                  \"Purple\",\n                  \"Magenta\",\n                ]}\n              />\n            </Form.Row>\n            <Form.Column alignItems=\"center\">\n              <Form.Row justifyContent=\"center\">\n                <Button\n                  type=\"submit\"\n                  minWidth=\"30%\"\n                  text=\"VALIDATE\"\n                  fullWidth={false}\n                  loading={formik.isSubmitting}\n                  disabled={formik.isSubmitting}\n                />\n              </Form.Row>\n              <Form.Row justifyContent=\"center\">\n                <Button\n                  text=\"DELETE\"\n                  minWidth=\"30%\"\n                  fullWidth={false}\n                  disabled={formik.isSubmitting}\n                  color={theme.palette.error.main}\n                />\n              </Form.Row>\n            </Form.Column>\n          </Form.Form>\n        }\n      />\n    </>\n  );\n}\n","/Users/invalid/Desktop/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Clients/Clients.js",["281"],"import React, { useState, useEffect } from \"react\";\nimport { useFormik } from \"formik\";\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\nimport * as Yup from \"yup\";\nimport moment from \"moment\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\nimport GLOBALS from \"../../../globals\";\nimport Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Modal from \"../../../components/Modal\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport SmallText from \"../../../components/SmallText\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport RadioButton from \"../../../components/RadioButton\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport AvatarUpload from \"../../../components/AvatarUpload\";\n\nimport { ReactComponent as Plus } from \"../../../assets/icons/Plus.svg\";\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\nimport { ReactComponent as Report } from \"../../../assets/icons/Report.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n}));\n\nconst updateClientYup = Yup.object().shape({\n  logo: Yup.mixed(),\n  color: Yup.string().required(\"Required\"),\n  firstName: Yup.string().required(\"Required\"),\n  lastName: Yup.string().required(\"Required\"),\n  email: Yup.string().required(\"Required\"),\n  phone: Yup.number()\n    .test(\n      \"len\",\n      \"Must be exactly 10 characters\",\n      (val) => val && val.toString().length === 10,\n    )\n    .required(\"Required\"),\n  contractType: Yup.string().required(\"Required\"),\n  contractStartDate: Yup.string().required(\"Required\"),\n  contractEndDate: Yup.string().required(\"Required\"),\n  functionality: Yup.string().required(\"Required\"),\n  additionalInfo: Yup.string(),\n  monthlyCost: Yup.number().test(\"len\", \"Invalid\", (val) => Number(val) >= 0),\n});\n\nexport default function Clients(props) {\n  const theme = useTheme();\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [loading, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n  const [page, setPage] = useState(1);\n\n  const [modal, setModal] = useState(false);\n  const [selectedItem, setSelectedItem] = useState(\"\");\n  const [selectedNestedItem, setSelectedNestedItem] = useState(\"\");\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.CLIENTS}?page=${page}`,\n      });\n      setItems(result.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err, \"error\"),\n        ),\n      );\n    }\n  }\n\n  async function onUpdate(values) {\n    var formdata = new FormData();\n    formdata.append(\"logo\", values.logo.file);\n    formdata.append(\"color\", values.color);\n    formdata.append(\"clientId\", selectedItem._id);\n    formdata.append(\"userId\", selectedItem.userId._id);\n    formdata.append(\"contractId\", selectedNestedItem._id);\n    formdata.append(\"companyId\", selectedItem.companyId._id);\n    formdata.append(\"firstName\", values.firstName);\n    formdata.append(\"lastName\", values.lastName);\n    formdata.append(\"email\", values.email);\n    formdata.append(\"phone\", values.phone);\n    formdata.append(\"contractType\", values.contractType);\n    formdata.append(\"contractStartDate\", values.contractStartDate);\n    formdata.append(\"contractEndDate\", values.contractEndDate);\n    formdata.append(\"functionality\", values.functionality);\n    formdata.append(\"additionalInfo\", values.additionalInfo);\n    formdata.append(\"monthlyCost\", values.monthlyCost);\n\n    const result = await GLOBALS.API({\n      method: \"PUT\",\n      uri: GLOBALS.Constants.CLIENTS,\n      headers: {\n        Authorization: store.token,\n      },\n      body: formdata,\n    });\n    const itemsArray = items.map((item) =>\n      item._id === selectedItem._id ? result.data : item,\n    );\n    setItems(itemsArray);\n    setModal(false);\n    formik.setSubmitting(false);\n  }\n\n  const formik = useFormik({\n    initialValues: {\n      logo: \"\",\n      color: \"\",\n      firstName: \"\",\n      lastName: \"\",\n      email: \"\",\n      phone: \"\",\n      contractType: \"\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"\",\n      additionalInfo: \"\",\n      monthlyCost: \"\",\n    },\n    validationSchema: updateClientYup,\n    onSubmit: onUpdate,\n  });\n\n  function modifyClick(item, contract) {\n    setSelectedItem(item);\n    setSelectedNestedItem(contract);\n    formik.setValues({\n      logo: {\n        uri: GLOBALS.Constants.BASE_URL + item.companyId.logo,\n      },\n      color: item.companyId.color,\n      firstName: item.companyId.incharge.firstName,\n      lastName: item.companyId.incharge.lastName,\n      email: item.companyId.incharge.email,\n      phone: item.companyId.incharge.phone,\n      contractType: contract.contractType,\n      contractStartDate: moment(contract.contractStartDate).format(\n        \"YYYY-MM-DD\",\n      ),\n      contractEndDate: moment(contract.contractEndDate).format(\"YYYY-MM-DD\"),\n      functionality: contract.functionality,\n      additionalInfo: contract.additionalInfo,\n      monthlyCost: contract.monthlyCost || 0,\n    });\n    setModal(true);\n  }\n\n  const rows = [];\n  items.map((item) => {\n    if (item.contract.length > 0) {\n      item.contract.map((contract) => {\n        rows.push([\n          item.companyId.name,\n          item.companyId.incharge.firstName +\n            \" \" +\n            item.companyId.incharge.lastName,\n          item.companyId.incharge.phone,\n          0,\n          contract.isPendingResponse\n            ? \"-\"\n            : moment(contract.contractStartDate).format(\"DD/MM/YY\"),\n          contract.isPendingResponse\n            ? \"-\"\n            : moment(contract.contractEndDate).format(\"DD/MM/YY\"),\n          contract.isPendingResponse ? \"Requested\" : contract.contractType,\n          <>\n            <IconButton\n              disabled={loading}\n              onClick={() => modifyClick(item, contract)}\n            >\n              <Pencil style={{ width: 18, height: 18 }} />\n            </IconButton>\n            <IconButton\n              disabled={loading}\n              component={NavLink}\n              to={`/clients/invoices/${item._id}/${contract._id}`}\n            >\n              <Report style={{ width: 18, height: 18 }} />\n            </IconButton>\n          </>,\n        ]);\n        return true;\n      });\n    } else {\n      rows.push([\n        item.companyId.name,\n        item.companyId.incharge.firstName +\n          \" \" +\n          item.companyId.incharge.lastName,\n        item.companyId.incharge.phone,\n        0,\n        \"-\",\n        \"-\",\n        \"Requested\",\n        <IconButton\n          disabled={loading}\n          onClick={() =>\n            props.history.push({\n              pathname: \"/clients/verify-client\",\n              item,\n            })\n          }\n        >\n          <Plus style={{ width: 18, height: 18 }} />\n        </IconButton>,\n      ]);\n      return true;\n    }\n    return true;\n  });\n\n  return (\n    <>\n      <div className={classes.root}>\n        <Form.Row alignItems=\"center\">\n          <Heading primary=\"CLIENTS LIST\" noWrap />\n          <div>\n            <Form.Row alignItems=\"center\" noMargin>\n              <SubHeading disableMargin primary=\"Total : 234 Clients\" bold />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"CREATE A CLIENT\"\n                style={{ marginLeft: \"20px\" }}\n                to={\"/clients/add-client\"}\n              />\n            </Form.Row>\n          </div>\n        </Form.Row>\n        <Form.Row noMargin>\n          <SearchInput placeholder=\"Name of Client\" />\n        </Form.Row>\n        <div className={classes.content}>\n          <Table headers={GLOBALS.Data.clients.headings} rows={rows} />\n        </div>\n      </div>\n      <Modal\n        title=\"EDIT CLIENT\"\n        open={selectedItem ? modal : false}\n        onClose={() => setModal((st) => !st)}\n        body={\n          <Form.Form onSubmit={formik.handleSubmit}>\n            <Form.Row justifyContent=\"center\">\n              <AvatarUpload\n                onChange={(file) => {\n                  const uri = URL.createObjectURL(file);\n                  formik.setFieldValue(\"logo\", { file, uri });\n                }}\n                value={formik.values.logo}\n                error={formik.errors.logo}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormSelect\n                placeholder=\"Color\"\n                name=\"color\"\n                onChange={formik.handleChange}\n                style={GLOBALS.Styles.inputWidth}\n                value={formik.values.color}\n                error={formik.errors.color}\n                values={[\n                  \"Green\",\n                  \"Yellow\",\n                  \"Red\",\n                  \"Blue\",\n                  \"Orange\",\n                  \"Purple\",\n                  \"Magenta\",\n                ]}\n              />\n            </Form.Row>\n            <Form.Row>\n              <FormInput\n                placeholder=\"First Name\"\n                onChange={formik.handleChange}\n                style={GLOBALS.Styles.inputWidth}\n                name=\"firstName\"\n                value={formik.values.firstName}\n                error={formik.errors.firstName}\n              />\n              <FormInput\n                placeholder=\"Last Name\"\n                onChange={formik.handleChange}\n                name=\"lastName\"\n                style={GLOBALS.Styles.inputWidth}\n                value={formik.values.lastName}\n                error={formik.errors.lastName}\n              />\n            </Form.Row>\n            <Form.Row>\n              <FormInput\n                placeholder=\"E-mail Address\"\n                onChange={formik.handleChange}\n                name=\"email\"\n                style={GLOBALS.Styles.inputWidth}\n                value={formik.values.email}\n                error={formik.errors.email}\n              />\n              <FormInput\n                placeholder=\"Phone Number\"\n                onChange={formik.handleChange}\n                name=\"phone\"\n                style={GLOBALS.Styles.inputWidth}\n                value={formik.values.phone}\n                error={formik.errors.phone}\n              />\n            </Form.Row>\n            <Form.Row>\n              <FormInput\n                type=\"date\"\n                placeholder=\"Start date\"\n                name=\"contractStartDate\"\n                onChange={formik.handleChange}\n                style={GLOBALS.Styles.inputWidth}\n                value={formik.values.contractStartDate}\n                error={formik.errors.contractStartDate}\n              />\n              <FormInput\n                type=\"date\"\n                placeholder=\"End date\"\n                name=\"contractEndDate\"\n                onChange={formik.handleChange}\n                style={GLOBALS.Styles.inputWidth}\n                value={formik.values.contractEndDate}\n                error={formik.errors.contractEndDate}\n              />\n            </Form.Row>\n            <Form.Row>\n              <RadioButton\n                name=\"contractType\"\n                style={GLOBALS.Styles.inputWidth}\n                value={formik.values.contractType}\n                error={formik.errors.contractType}\n                onChange={formik.handleChange}\n                items={[\n                  { value: \"CLIENTPERSITE\", label: \"Per Site\" },\n                  { value: \"MASTERCLIENT\", label: \"Master Contract\" },\n                ]}\n              />\n            </Form.Row>\n            <Form.Row>\n              <RadioButton\n                style={GLOBALS.Styles.inputWidth}\n                name=\"functionality\"\n                onChange={formik.handleChange}\n                value={formik.values.functionality}\n                error={formik.errors.functionality}\n                items={[{ value: \"DELIVERY\", label: \"Delivery module\" }]}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <Form.Row noMargin alignItems=\"center\" width=\"150px\">\n                <FormInput\n                  type=\"number\"\n                  name=\"monthlyCost\"\n                  onChange={formik.handleChange}\n                  value={formik.values.monthlyCost}\n                  error={formik.errors.monthlyCost}\n                  style={{ ...GLOBALS.Styles.inputWidth, maxWidth: 100 }}\n                />\n                <SmallText primary=\"€/month\" />\n              </Form.Row>\n            </Form.Row>\n            <Form.Row>\n              <FormInput\n                textArea\n                rows={3}\n                onChange={formik.handleChange}\n                placeholder=\"Additional information\"\n                name=\"additionalInfo\"\n                value={formik.values.additionalInfo}\n                error={formik.errors.additionalInfo}\n              />\n            </Form.Row>\n            <Form.Column alignItems=\"center\">\n              <Form.Row justifyContent=\"center\">\n                <Button\n                  type=\"submit\"\n                  minWidth=\"30%\"\n                  text=\"VALIDATE\"\n                  fullWidth={false}\n                  loading={formik.isSubmitting}\n                  disabled={formik.isSubmitting}\n                />\n              </Form.Row>\n              <Form.Row justifyContent=\"center\">\n                <Button\n                  text=\"DELETE\"\n                  minWidth=\"30%\"\n                  fullWidth={false}\n                  disabled={formik.isSubmitting}\n                  color={theme.palette.error.main}\n                />\n              </Form.Row>\n            </Form.Column>\n          </Form.Form>\n        }\n      />\n    </>\n  );\n}\n","/Users/invalid/Desktop/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Sites/ArchivedSites.js",[],"/Users/invalid/Desktop/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Sites/AddZAC.js",[],"/Users/invalid/Desktop/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Sites/Sites.js",[],"/Users/invalid/Desktop/OrgaPlan/OrgaPlan-React/src/pages/SuperAdmin/Clients/Invoices.js",[],"/Users/invalid/Desktop/OrgaP
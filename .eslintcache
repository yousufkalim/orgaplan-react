js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Input.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/globals/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddZAC.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/ArchivedSites.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Organigramme/AddContact.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Organigramme/Organigramme.js",["503","504","505","506","507","508"],"import React, { useState, useEffect } from \"react\";\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n\nimport GLOBALS from \"../../../globals\";\nimport Actions from \"../../../redux/actions\";\nimport { Images } from \"../../../assets/Assets\";\n\nimport Form from \"../../../components/Form\";\nimport Modal from \"../../../components/Modal\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport AvatarUpload from \"../../../components/AvatarUpload\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  unSelectedFilter: {\n    backgroundColor: \"#fff !important\",\n    border: \"1px solid #707070 !important\",\n    textColor: \"#7E7878 !important\",\n\n  },\n  selectedFilter: {\n    backgroundColor: \"#140772 !important\",\n  }\n  \n}));\n\n// const updateAdminYup = Yup.object().shape({\n//   email: Yup.string().required(\"Required\"),\n//   phone: Yup.number()\n//     .test(\n//       \"len\",\n//       \"Must be exactly 10 characters\",\n//       (val) => val && val.toString().length === 10,\n//     )\n//     .required(\"Required\"),\n//   image: Yup.object().optional(\"\"),\n//   companyId: Yup.string().required(\"Required\"),\n// });\n\nexport default function Organigramme(props) {\n  const theme = useTheme();\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n  const [open, setOpen] = useState(false);\n  const [page] = useState(1);\n  const [items, setItems] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [companies, setCompanies] = useState([]);\n  const [selectedItem] = useState(\"\");\n  const [firstName, setFirstName] = useState(\"\");\n  const [lastName, setLastName] = useState(\"\");\n  const [phone, setPhone] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [companyId, setCompanyId] = useState(\"\");\n  const [companyName] = useState(\"\");\n  const [organigramme, setOrganigrammes] = useState([]);  \n  const [completeOrganigramme, setCompleteOrganigrammes] = useState([]);\n  let [selectedFilter, setSelectedFilter] = useState(\"\");\n  let [selectedClass, setSelectedClass] = useState(\"\");\n  let [selectedClasss, setSelectedClasss] = useState(\"\");\n\n  useEffect(() => {\n   \n    fetchData();\n\n    // eslint-disable-next-line\n  }, []);\n   useEffect(() => {\n   \n    getOrganigramme(selectedFilter);\n\n    // eslint-disable-next-line\n  }, [selectedFilter]);\n\n  async function fetchData() {\n    try {\n      //  setSelectedClass(classes.selectedFilter);\n      //  setSelectedClasss(classes.unSelectedFilter);\n      // const admins = await GLOBALS.API({\n      //   uri: `${GLOBALS.Constants.ADMINS}?page=${page}`,\n      // });\n      // const companies = await GLOBALS.API({\n      //   uri: `${GLOBALS.Constants.COMPANY}`,\n      // });\n       const oranigramme = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_SITE_ORGANIGRAMMES}/${adminStore.site.siteId._id}`,\n       });\n      console.log('organigramme list', oranigramme);\n      // const companiesArray = [];\n      // companies.data.items.map((item) => {\n      //   if (!item.adminId) {\n      //     companiesArray.push({\n      //       value: item._id,\n      //       label: item.name,\n      //     });\n      //   }\n      //   return true;\n      // });\n      if(oranigramme.success) { //working\n        \n        setCompleteOrganigrammes(oranigramme.data)\n        setOrganigrammes(oranigramme.data)\n        setSelectedFilter('SITE')\n        // getOrganigramme('SITE');\n\n    //           let temp = [];\n\n    // oranigramme.data.map((item, index) => {\n    //       let data = [];\n    //       data[0] = item.firstName;\n    //       data[1] = item.lastName;\n    //       data[2] = item.company;\n    //       data[3] = item.role;\n    //       data[4] = item.phone;\n    //       data[5] = item.email;\n\n    //       return temp.push(data);\n    //     });\n    //   setItems(temp);\n\n      }\n\n\n\n\n      // setItems(admins.data.items);\n      // setCompanies(companiesArray);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const handleChange = (name, value) => {\n    if (name === \"firstName\") setFirstName(value);\n    else if (name === \"lastName\") setLastName(value);\n    else if (name === \"phone\") setPhone(value);\n    else if (name === \"image\") setImage(value);\n    else if (name === \"companyId\") setCompanyId(value);\n  };\n\n  const onUpdate = async (e) => {\n    try {\n      e.preventDefault();\n      setLoading(true);\n      var formdata = new FormData();\n      formdata.append(\"firstName\", firstName);\n      formdata.append(\"lastName\", lastName);\n      formdata.append(\"phone\", phone);\n      formdata.append(\"companyId\", companyId);\n      formdata.append(\"userId\", selectedItem._id);\n      image.file && formdata.append(\"image\", image.file);\n\n      const result = await GLOBALS.API({\n        method: \"PUT\",\n        uri: GLOBALS.Constants.ADMINS,\n        headers: {\n          Authorization: store.token,\n        },\n        body: formdata,\n      });\n      const itemsArray = items.map((item) =>\n        item._id === selectedItem._id ? result.data : item,\n      );\n      setItems(itemsArray);\n      setLoading(false);\n      \n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n\n\n  \n\n\n   \n  const rows = items.map((item, index) => {\n    return [\n      \n      <img src={Images.avatar} alt=\"Organigramme\" style={{ width: 50, height: 50 }} />,\n      ...item,\n    ];\n  });\n\n   function getOrganigramme (value)  {\n     setSelectedFilter(value)\n    // if(value === 'SITE') {\n    //   setSelectedClass(classes.selectedFilter);\n    //   setSelectedClasss(classes.unSelectedFilter);\n    // } else if (value === 'LOGISTICS') {\n    //   setSelectedClasss(classes.selectedFilter);\n    //   setSelectedClass(classes.unSelectedFilter);\n    // }\n\n    let filterData =  completeOrganigramme.filter(x=> x.type === value)\n    setOrganigrammes(filterData)\n    let temp = [];\n    filterData.map((item, index) => {\n    let data = [];\n    data[0] = item.firstName;\n    data[1] = item.lastName;\n    data[2] = item.company;\n    data[3] = item.role;\n    data[4] = item.phone;\n    data[5] = item.email;\n    return temp.push(data);\n    });\n      setItems(temp);\n  \n  }\n\n function editHandler (e, data )  {\n \n      console.log('called', data);\n  \n  }\n\n  const modalHandler = (btn) => {\n    setOpen(btn);\n  };\n  return (\n    <>\n      <div className={classes.root}>\n        <Form.Row alignItems=\"center\" className=\"pr-3\">\n          <Heading primary=\"ORGANNIGRAMME\" noWrap />\n          <div>\n            <Form.Row alignItems=\"center\" noMargin>\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"ADD A CONTACT\"\n                style={{ marginLeft: \"20px\" }}\n                to={\"/organigramme/add-contact\"}\n              />\n            </Form.Row>\n          </div>\n        </Form.Row>\n        <Form.Row noMargin>\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\n            <Button\n              // className={selectedClass}\n              fullWidth={false}\n              text=\"SITE ORGANIGAMME\"\n              style={{\n                marginLeft: \"20px\",\n                backgroundColor: selectedFilter === \"LOGISTICS\"? \"#fff\" : \"#140772\",\n              }}\n               textColor = {selectedFilter === 'LOGISTICS' ? '#7E7878' : ''}\n              onClick={()=> getOrganigramme('SITE') }\n            />\n            <Button\n              // className={selectedClasss}\n              fullWidth={false}\n              text=\"LOGISTIC ORGANIGAMME\"\n              style={{\n                marginLeft: \"20px\",\n                backgroundColor: selectedFilter === \"SITE\"? \"#fff\" : \"#140772\",\n              }}\n               textColor = {selectedFilter === 'SITE' ? '#7E7878' : ''}\n              onClick={()=> getOrganigramme('LOGISTICS') }\n\n            />\n          </Form.Row>\n        </Form.Row>\n        <div className={classes.content}>\n          <Table \n            headers={GLOBALS.Data.oranigramme.headings}\n            rows={rows}\n            onClick={ (e)=> { \n              props.history.push({ \n               pathname: \"/organigramme/edit-contact\",\n               data: organigramme[e],\n              })\n            console.log(props)\n             return editHandler(e, organigramme[e])\n            }  } \n           // modalHandler={modalHandler}  //working\n          />\n\n\n\n        </div>\n      </div>\n      <Modal\n        title=\"THIERRY MARLES\"\n        open={open}\n        onClose={() => modalHandler(false)}\n        body={\n          <Form.Form onSubmit={onUpdate}>\n            <Form.Row justifyContent=\"center\">\n              <AvatarUpload\n                value={image}\n                // error={image}\n                onChange={(file) => {\n                  const uri = URL.createObjectURL(file);\n                  handleChange(\"image\", { file, uri });\n                }}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"firstName\"\n                value={firstName}\n                // error={firstName}\n                placeholder=\"First Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"lastName\"\n                value={lastName}\n                // error={lastName}\n                placeholder=\"Last Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"phone\"\n                placeholder=\"Phone Number\"\n                value={phone}\n                // error={phone}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                style={GLOBALS.Styles.inputWidth}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormSelect\n                name=\"companyId\"\n                value={companyId}\n                // error={companyId}\n                values={companies}\n                placeholder={companyName}\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Column alignItems=\"center\">\n              <Form.Row justifyContent=\"center\">\n                <Button\n                  type=\"submit\"\n                  minWidth={200}\n                  text=\"VALIDATE\"\n                  fullWidth={false}\n                  loading={loading}\n                  disabled={\n                    loading ||\n                    !firstName ||\n                    !lastName ||\n                    !phone ||\n                    image === \"\" ||\n                    !companyId\n                  }\n                />\n              </Form.Row>\n              <Form.Row justifyContent=\"center\">\n                <Button\n                  text=\"DELETE\"\n                  minWidth=\"30%\"\n                  fullWidth={false}\n                  disabled={loading || true}\n                  color={theme.palette.error.main}\n                />\n              </Form.Row>\n            </Form.Column>\n          </Form.Form>\n        }\n      />\n    </>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/Historic.js",["509","510","511"],"import React, { useState, useEffect } from \"react\";\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport { useSelector, useDispatch } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\n\n// import Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Heading from \"../../../components/Heading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport moment from \"moment\";\nimport { Images } from \"../../../assets/Assets\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  link: {\n    marginRight: 20,\n    whiteSpace: \"nowrap\",\n    color: theme.palette.primary.contrastText,\n  },\n  image: {\n    height: 70,\n    borderRadius: theme.shape.borderRadius,\n  },\n}));\n\nconst Historic = (props) => {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n  const [isLoading, setLoading] = useState(true);\n  const [history, setHistory] = useState([]);\n\n  const [means, setMeans] = useState([]);\n  const [dorpdownMeans, setDropdownMeans] = useState([]);\n  const [selectedMean, setSelectedMean] = useState(\"\");\n  const [selectedMeanIndex, setSelectedMeanIndex] = useState(null);\n\n  const [companies, setCompanies] = useState([]);\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\n\n  useEffect(() => {\n    getData();\n  }, []);\n\n  useEffect(() => {\n    filterBooking();\n  }, [selectedMeanIndex, selectedCompanyIndex]);\n\n  const filterBooking = async () => {\n    try {\n      setLoading(true);\n      const params = { siteId: adminStore.site.siteId._id };\n      if (selectedMean.length !== 0)\n        params[\"meanId\"] = means[selectedMeanIndex]._id;\n      if (selectedCompany.length !== 0)\n        params[\"companyId\"] = companies[selectedCompanyIndex].companyId._id;\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.FILTER_BOOKING}`,\n        token: store.token,\n        method: \"POST\",\n        body: JSON.stringify(params),\n      });\n      if (response.success) {\n        setHistory(response.data);\n\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getData = async () => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_MEAN_HISTORY}/${props.location.mean._id}/${adminStore.site.siteId._id}`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setHistory(response.data.history);\n        setCompanies(response.data.site_companies);\n        if (response.data.site_means != null) {\n          setMeans(response.data.site_means);\n          let selectedMeanIndex = 0;\n\n          const temp = [];\n          const companyTemp = [];\n          response.data.site_means.map((item, index) => {\n            if (item._id === props.location.mean._id) {\n              selectedMeanIndex = index;\n              setSelectedMean(item.name);\n            }\n            return temp.push({ label: item.name, value: item.name });\n          });\n          setDropdownMeans(temp);\n\n          setSelectedMeanIndex(selectedMeanIndex);\n\n          response.data.site_companies.map((item, index) => {\n            return companyTemp.push({\n              label: item.companyId.name,\n              value: item.companyId.name,\n            });\n          });\n          setDropdownCompanies(companyTemp);\n        }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const rows = history.map((item) => {\n    return [\n      moment(item.startDate).format(\"MM/DD/yyy\") + \" \" + item.startTime,\n      moment(item.endDate).format(\"MM/DD/yyy\") + \" \" + item.endTime,\n      item.companyId.name,\n      item.bookingReason,\n    ];\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row alignItems=\"center\">\n        <Heading primary=\"LIST OF MEANS - HISTORIC\" noWrap />\n        <div>\n          <Form.Row\n            alignItems=\"flex-start\"\n            noMargin\n            justifyContent=\"flex-end\"\n            style={{ paddingRight: \"50px\" }}\n          >\n            <Form.Column style={{ width: \"50%\", marginRight: \"50px\" }}>\n              <img src={Images.site} alt=\"\" />\n            </Form.Column>\n          </Form.Row>\n        </div>\n      </Form.Row>\n      <Form.Row alignItems=\"center\" noMargin>\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          {/* <SearchInput\n            placeholder=\"Site name\"\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          /> */}\n          <FormSelect\n            placeholder=\"Company\"\n            values={dropdownCompanies}\n            value={selectedCompany}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n\n              if (index !== -1) {\n                const item = event.target.value;\n\n                setSelectedCompanyIndex(index);\n\n                setSelectedCompany(item);\n              } else {\n                setSelectedCompanyIndex(null);\n\n                setSelectedCompany(\"\");\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Mean\"\n            values={dorpdownMeans}\n            value={selectedMean}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n\n              if (index !== -1) {\n                const item = event.target.value;\n\n                setSelectedMeanIndex(index);\n\n                setSelectedMean(item);\n              } else {\n                setSelectedMeanIndex(null);\n\n                setSelectedMean(\"\");\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\n          See archived sites\n        </NavLink> */}\n      </Form.Row>\n      <div className={classes.content}>\n        <Table headers={GLOBALS.Data.meansOfHistoric.headings} rows={rows} />\n      </div>\n    </div>\n  );\n};\n\nexport default Historic;\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/EditMean.js",["512","513","514","515","516","517","518","519","520","521","522","523","524","525","526","527","528","529","530","531"],"import React, { useState, useEffect } from \"react\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport * as Yup from \"yup\";\nimport { useSelector, useDispatch } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\nimport GLOBALS from \"../../../globals\";\nimport Form from \"../../../components/Form\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/CustomFormInput\";\nimport FormLabel from \"../../../components/FormLabel\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\nimport CustomInputModal from \"../../../components/CustomInputModal\";\nimport CustomButtonModal from \"../../../components/CustomButtonModal\";\nimport moment from \"moment\";\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n}));\n\nconst accessabilityPoints = [\n  { label: \"Storage Area\", value: \"Storage Area\" },\n  { label: \"Delivery Area\", value: \"Delivery Area\" },\n];\n\nexport default function EditMean(props) {\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n  const [name, setName] = useState(\"\");\n  const [type, setType] = useState(\"\");\n  const [color, setColor] = useState(\"\");\n  const [image, setImage] = useState([]);\n  const [startDate, setStartDate] = useState(\"\");\n  const [endDate, setEndDate] = useState(\"\");\n  const [techSheet, setTechSheet] = useState([]);\n  const [rate, setRate] = useState(\"\");\n  const [addInfo, setAddInfo] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n  const [disableDropdpwn, setDisableDropdown] = useState(false);\n  const classes = useStyles();\n\n  const [accessabilityPoint, setAccessabilityPoint] = useState(\"\");\n  const [DeliveryAreas, setDeliveryAreas] = useState([]);\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\n  const [\n    selectedSiteDeliveryAreadIndex,\n    seltSelectedSiteDeliveryAreaIndex,\n  ] = useState(null);\n\n  const [storageAreas, setStorageAreas] = useState([]);\n  const [dropdownStorageAreas, setDropdownStorageAreas] = useState([]);\n  const [\n    selectedDropdownStorageArea,\n    setSelectedDropdownStorageArea,\n  ] = useState(\"\");\n  const [selectedStorageAreaIndex, setSelectedStorageAreaIndex] = useState(\n    null,\n  );\n\n  const [deliveryAreaId, setDeilveryAreaId] = useState(\"\");\n  const [storageAreaId, setStorageAreaId] = useState(\"\");\n\n  const [\n    deliveryAndStorageLocations,\n    setDeliveryAndStorageLocations,\n  ] = useState([]);\n\n  const [buildings, setBuidings] = useState([]);\n  const [dropdownBuildings, setDropdownBuildings] = useState([]);\n  const [selectedDropdownBuilding, setSelectedDropdownBuilding] = useState(\"\");\n  const [selectedBuildingIndex, setSelectedBuildingIndex] = useState(null);\n\n  const [levels, setLevels] = useState([]);\n  const [dropdownLevels, setDropdownLevels] = useState([]);\n  const [selectedDropdownLevel, setSelectedDropdownLevel] = useState(\"\");\n  const [selectedDropdownIndex, setSelectedLevelIndex] = useState(null);\n\n  const [meanTypes, setMeanTypes] = useState([]);\n  const [dropdownMeanTypes, setDropdownMeanTypes] = useState([]);\n  const [selectedMeanType, setSelectedMeanType] = useState(\"\");\n  const [selecetedMeanTypeIndex, setSelectedMeanTypeIndex] = useState(null);\n\n  useEffect(() => {\n    getData();\n\n    // eslint-disable-next-line\n  }, []);\n\n  const setValues = () => {\n    const mean = props.location.mean;\n    setName(mean.name);\n    let fileClone = [{ uri: mean.image }];\n    setImage(fileClone);\n    setSelectedMeanType(mean.meanType);\n    let meanTypeIndex = 0;\n    dropdownMeanTypes.forEach((item, index) => {\n      if (item.value === mean.meanType) meanTypeIndex = index;\n    });\n\n    setSelectedMeanTypeIndex(meanTypeIndex);\n\n    setColor(mean.color);\n\n    setStartDate(moment(mean.availability.start).format(\"MM/DD/yyyy\"));\n    setEndDate(moment(mean.availability.end).format(\"MM/DD/yyyy\"));\n    setRate(mean.pricePerHour);\n    setAddInfo(mean.additionalInfo);\n    const locationTemp = [];\n    mean.location.forEach((item, index) => {\n      let loc = { key: \"\", label: \"\", id: \"\", type: \"\" };\n\n      if (item.locationType === \"STORAGEAREA\") {\n        loc.key = item.storageArea._id;\n        loc.label = item.storageArea.name;\n        loc.id = item.storageArea._id;\n        loc.type = accessabilityPoints[0].value;\n        locationTemp.push(loc);\n      }\n      if (item.locationType === \"DELIVERYAREA\") {\n        loc.key = item.deliveryArea._id;\n        loc.label = item.deliveryArea.name;\n        loc.id = item.deliveryArea._id;\n        loc.type = accessabilityPoints[1].value;\n        locationTemp.push(loc);\n      }\n    });\n    setDeliveryAndStorageLocations(locationTemp);\n    console.log(JSON.stringify(locationTemp, null, 2));\n    // \"key\": \"61615286801076\",\n    // \"label\": \"storqg\",\n    // \"id\": \"60096007880eb61e9d7188d2\",\n    // \"type\": \"Storage Area\"\n  };\n  useEffect(() => {}, [\n    meanTypes,\n    dropdownMeanTypes,\n    selecetedMeanTypeIndex,\n    selectedMeanType,\n  ]);\n\n  const getData = async () => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_ADD_MEAN}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n      if (response.success) {\n        if (response.data.site_delivery_areas !== null) {\n          const temp = [];\n          response.data.site_delivery_areas.map((item, index) =>\n            temp.push({ label: item.name, value: item.name, id: item._id }),\n          );\n          await setDeliveryAreas(response.data.site_delivery_areas);\n          await setDropdownDeliveryAreas(temp);\n        }\n\n        if (response.data.site_storage_areas !== null) {\n          const temp = [];\n          response.data.site_storage_areas.map((item, index) =>\n            temp.push({ label: item.name, value: item.name, id: item._id }),\n          );\n          await setStorageAreas(response.data.site_storage_areas);\n          await setDropdownStorageAreas(temp);\n        }\n\n        if (response.data.site_buildings !== null) {\n          const temp = [];\n          response.data.site_buildings.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n          await setBuidings(response.data.site_buildings);\n          await setDropdownBuildings(temp);\n        }\n\n        if (response.data.mean_types !== null) {\n          const temp = [];\n          response.data.mean_types.map((item, index) =>\n            temp.push({ label: item, value: item }),\n          );\n          await setMeanTypes(response.data.mean_types);\n          await setDropdownMeanTypes(temp);\n        }\n        // if (response.data.mean_types !== null) {\n        //   setTypes(response.data.mean_types);\n        //   const temp = [];\n        //   response.data.mean_types.map((item, index) => {\n        //     temp.push({ label: item, value: item });\n        //   });\n        //   setDropdownTypes(temp);\n        // }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n      await setValues();\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  function handleChange(name, value) {\n    //alert(JSON.stringify(value, null, 2));\n    if (name === \"name\") setName(value);\n    else if (name === \"type\") setType(value);\n    else if (name === \"color\") setColor(value);\n    else if (name === \"image\") setImage(value);\n    else if (name === \"startDate\") setStartDate(value);\n    else if (name === \"endDate\") setEndDate(value);\n    else if (name === \"techSheet\") setTechSheet(value);\n    else if (name === \"rate\") setRate(value);\n    else if (name === \"addInfo\") setAddInfo(value);\n  }\n\n  const updateMean = async () => {\n    try {\n      setLoading(true);\n\n      var formdata = new FormData();\n\n      let locations = [];\n\n      deliveryAndStorageLocations.forEach((item) => {\n        if (item.type === accessabilityPoints[0].value) {\n          let loc = {\n            locationType: \"STORAGEAREA\",\n            storageArea: item.id,\n          };\n          locations.push(loc);\n        }\n        if (item.type === accessabilityPoints[1].value) {\n          let loc = {\n            locationType: \"DELIVERYAREA\",\n            deliveryArea: item.id,\n          };\n          locations.push(loc);\n        }\n      });\n\n      let availabilities = {\n        start: startDate,\n        end: endDate,\n      };\n\n      // TEST DATA , CALENDAR NOT MADE YET\n\n      const sampleDateOne = new Date(\"05/20/2021\");\n      const sampleDateTwo = new Date(\"05/28/2021\");\n      // const unavailabilities = [\n      //   {\n      //     date: sampleDateOne,\n      //     reason: \"Public Holiday\",\n      //     startingHour: new Date().getTime(),\n      //     endingHour: new Date().getTime(),\n      //   },\n      //   {\n      //     date: sampleDateTwo,\n      //     reason: \"Maintenance\",\n      //     startingHour: new Date().getTime(),\n      //     endingHour: new Date().getTime(),\n      //   },\n      // ];\n\n      formdata.append(\"name\", name);\n      formdata.append(\"color\", color);\n      if (image.length != 0 && image[0].file != undefined)\n        formdata.append(\"image\", image[0].file);\n      if (image.length != 0 && image[0].file != undefined)\n        formdata.append(\"sheet\", image[0].file);\n      formdata.append(\"pricePerHour\", rate);\n      formdata.append(\"additionalInfo\", addInfo);\n      formdata.append(\"siteId\", \"6008169bedbb7816d40b197d\");\n      formdata.append(\"meanType\", selectedMeanType);\n      formdata.append(\"location\", JSON.stringify(locations));\n      formdata.append(\"availability\", JSON.stringify(availabilities));\n      //formdata.append(\"unavailability\", JSON.stringify(unavailabilities));\n\n      const response = await GLOBALS.API({\n        method: \"PUT\",\n        uri: GLOBALS.Constants.UPDATE_MEAN + \"/\" + props.location.mean._id,\n        headers: {\n          Authorization: store.token,\n        },\n        body: formdata,\n      });\n\n      if (response.success) {\n        setLoading(false);\n      } else {\n        setLoading(false);\n        dispatch(\n          Actions.notistack.enqueueSnackbar(\n            Actions.notistack.snackbar(response.message, \"error\"),\n          ),\n        );\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getDeliveryArea = async () => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setLevels(response.data);\n        if (response.data !== null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n\n          setDropdownDeliveryAreas(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getStorageArea = async () => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setLevels(response.data);\n        if (response.data !== null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n\n          setDropdownStorageAreas(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n\n      <Form.Row>\n        <Heading primary=\"EDIT A MEAN\" />\n\n        {/* <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"LOCALISATION\"\n                to={\"/means/add-mean\"}\n                style={{\n                  marginRight: \"100px\",\n                  marginBottom: \"7px\",\n                  width: \"320px\",\n                  textAlign: \"center\",\n                  backgroundColor: \"#140772\"\n                }}\n              /> */}\n      </Form.Row>\n      {loading && \"\"}\n      {levels && \"\"}\n      {selectedDropdownIndex && \"\"}\n      {meanTypes && \"\"}\n      {selectedBuildingIndex && \"\"}\n      {DeliveryAreas && \"\"}\n      {selectedSiteDeliveryAreadIndex && \"\"}\n      {storageAreas && \"\"}\n      {selectedStorageAreaIndex && \"\"}\n      <div className={classes.content}>\n        <Form.Form>\n          <Form.Row>\n            <FormLabel bold primary=\"IDENTITY : \" />\n            <Form.Row noMargin width=\"65%\" style={{ gap: \"20px\" }}>\n              <FormInput\n                name=\"name\"\n                error\n                style={GLOBALS.Styles.inputWidth}\n                placeholder=\"name\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={name}\n                validateSchema={Yup.string().required()}\n              />\n              <FormSelect\n                placeholder=\"Type\"\n                name=\"type\"\n                value={selectedMeanType}\n                style={GLOBALS.Styles.inputWidth}\n                onChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n\n                  if (index !== -1) {\n                    const item = event.target.value;\n                    setSelectedMeanTypeIndex(index);\n                    setSelectedMeanType(item);\n                  } else {\n                    setSelectedMeanTypeIndex(null);\n                    setSelectedMeanType(\"\");\n                  }\n                }}\n                values={dropdownMeanTypes}\n              />\n              <FormSelect\n                placeholder=\"color\"\n                name=\"color\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={color}\n                values={[\n                  { value: \"green\", label: \"Green\" },\n                  { value: \"Yellow\", label: \"Yellow\" },\n                  { value: \"Red\", label: \"Red\" },\n                  { value: \"Blue\", label: \"Blue\" },\n                  { value: \"Orange\", label: \"Orange\" },\n                  { value: \"Purple\", label: \"Purple\" },\n                  { value: \"Magenta\", label: \"Magenta\" },\n                ]}\n              />\n              <FormMultipleUpload\n                name=\"image\"\n                style={GLOBALS.Styles.inputWidth}\n                values={image}\n                onChange={(values) => {\n                  handleChange(\"image\", values);\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"LOCATION :  \" />\n            <Form.Row noMargin width=\"65%\">\n              <CustomInputModal\n                name=\"location\"\n                values={accessabilityPoints}\n                chipDefaultValues={deliveryAndStorageLocations}\n                leftValue={accessabilityPoint}\n                rightValue={\n                  accessabilityPoint === accessabilityPoints[0].value\n                    ? selectedDropdownStorageArea\n                    : selectedDropdownArea\n                }\n                leftId={accessabilityPoint}\n                rightId={\n                  accessabilityPoint === accessabilityPoints[0].value\n                    ? storageAreaId\n                    : deliveryAreaId\n                }\n                chipValues={(values) => {\n                  setDeliveryAndStorageLocations(values);\n                }}\n                leftDropdownValues={accessabilityPoints}\n                leftDropdwonPlaceholder={\"Select Location Type\"}\n                rightDropdownPlaceholder={\"Select Location\"}\n                leftDropdwonValueChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n                  if (index !== -1) {\n                    const item = event.target.value;\n                    setAccessabilityPoint(item);\n                    if (item === accessabilityPoints[0].value) {\n                      getStorageArea();\n                    }\n                    if (item === accessabilityPoints[1].value) {\n                      getDeliveryArea();\n                    } else {\n                      seltSelectedSiteDeliveryAreaIndex(0);\n                      setSelectedDropdownArea(\"\");\n                      setDeilveryAreaId(\"\");\n\n                      setSelectedStorageAreaIndex(0);\n                      setSelectedDropdownStorageArea(\"\");\n                      setStorageAreaId(\"\");\n                    }\n                  } else {\n                    seltSelectedSiteDeliveryAreaIndex(0);\n                    setSelectedDropdownArea(\"\");\n                    setDeilveryAreaId(\"\");\n\n                    setSelectedStorageAreaIndex(0);\n                    setSelectedDropdownStorageArea(\"\");\n                    setStorageAreaId(\"\");\n                  }\n                }}\n                rightDropdownValues={\n                  accessabilityPoint === accessabilityPoints[0].value\n                    ? dropdownStorageAreas\n                    : dropdownDeliveryAreas\n                }\n                // error={addresses}\n                style={GLOBALS.Styles.inputWidth}\n                rightDropdwonValueChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n                  if (index !== -1) {\n                    const item = event.target.value;\n                    if (accessabilityPoints[0].value === accessabilityPoint) {\n                      setStorageAreaId(storageAreas[index]._id);\n                      setSelectedStorageAreaIndex(index);\n                      setSelectedDropdownStorageArea(item);\n                    } else {\n                      setSelectedStorageAreaIndex(0);\n                      setSelectedDropdownStorageArea(\"\");\n                    }\n\n                    if (accessabilityPoints[1].value === accessabilityPoint) {\n                      setDeilveryAreaId(DeliveryAreas[index]._id);\n                      seltSelectedSiteDeliveryAreaIndex(index);\n                      setSelectedDropdownArea(item);\n                    } else {\n                      seltSelectedSiteDeliveryAreaIndex(0);\n                      setSelectedDropdownArea(\"\");\n                    }\n                  } else {\n                    setSelectedStorageAreaIndex(0);\n                    setSelectedDropdownStorageArea(\"\");\n                    seltSelectedSiteDeliveryAreaIndex(0);\n                    setSelectedDropdownArea(\"\");\n                  }\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"DISPONIBILITE :\" />\n            <Form.Row\n              noMargin\n              width=\"65%\"\n              justifyContent=\"flex-start\"\n              style={{ gap: \"20px\" }}\n            >\n              <FormInput\n                type=\"date\"\n                style={{ width: \"300px\" }}\n                placeholder={`Date de début`}\n                name=\"startDate\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={startDate}\n              />\n              <FormInput\n                type=\"date\"\n                placeholder=\"Date de fin\"\n                style={{ width: \"300px\" }}\n                name=\"endDate\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={endDate}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"FICHE TECHNIQUE : \" />\n            <Form.Row noMargin width=\"65%\">\n              <FormMultipleUpload\n                name=\"techSheet\"\n                style={GLOBALS.Styles.inputWidth}\n                values={techSheet}\n                onChange={(values) => {\n                  handleChange(\"techSheet\", values);\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"INDISPONIBILITES: \" />\n            <Form.Row noMargin width=\"65%\">\n              <div\n                // name=\"availability\"\n\n                to={\"/means/add-mean\"}\n                style={{\n                  marginLeft: \"0px\",\n                  marginBottom: \"7px\",\n                  width: \"320px\",\n                  color: \"#fff\",\n                  padding: \"0.8rem 0\",\n                  borderRadius: \"8px\",\n                  textAlign: \"center\",\n                  backgroundColor: \"#140772\",\n                }}\n              >\n                SHOW UNAVAILABILITIES\n              </div>\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"TARIF HORAIRE : \" />\n            <Form.Row noMargin width=\"65%\">\n              <FormInput\n                textArea\n                rows={1}\n                style={{ width: \"300px\", textAlign: \"right\" }}\n                placeholder=\"€\"\n                name=\"rate\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={rate}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"INFORMATIONS COMPLÉMENTAIRES :\" />\n            <Form.Row noMargin width=\"65%\">\n              <FormInput\n                textArea\n                rows={3}\n                style={{ width: \"600px\" }}\n                placeholder=\"Informations complémentaires\"\n                name=\"addInfo\"\n                onChange={({ target: { name, value } }) => {\n                  handleChange(name, value);\n                }}\n                value={addInfo}\n              />\n            </Form.Row>\n          </Form.Row>\n          {type && \"\"}\n          <Form.Row>\n            <Form.ButtonContainer style={{ width: \"80%\" }}>\n              <Button\n                minWidth={200}\n                text=\"VALIDATE\"\n                fullWidth={false}\n                onClick={async () => {\n                  await updateMean();\n                }}\n                // loading={formik.isSubmitting}\n                // disabled={\n                //   !name ||\n                //   location.length === 0 ||\n                //   !type ||\n                //   !color ||\n                //   !startDate\n                // }\n              />\n            </Form.ButtonContainer>\n          </Form.Row>\n        </Form.Form>\n      </div>\n    </div>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Pic/Pic.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/AddMean.js",["532","533","534","535","536","537","538","539","540"],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Incidents/editIncidents.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Incidents/addIncidents.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/AddInvoice.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/EditInvoice.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/VerifyClient.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/AddClient.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/Means.js",["541","542","543","544","545","546","547","548"],"import React, { useState, useEffect } from \"react\";\nimport { useSelector } from \"react-redux\";\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles } from \"@material-ui/core/styles\";\n\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\n\nimport { useFormik } from \"formik\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport FormInput from \"../../../components/FormInput\";\n\nimport moment from \"moment\";\nimport { Images } from \"../../../assets/Assets\";\n\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  link: {\n    marginRight: 20,\n    whiteSpace: \"nowrap\",\n    color: theme.palette.primary.contrastText,\n  },\n  image: {\n    height: 70,\n    borderRadius: theme.shape.borderRadius,\n  },\n}));\n\nconst Means = () => {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n  const [loading, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n\n  const [siteDeliveryAreas, setSiteDeliveryAreas] = useState([]);\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\n  const [\n    selectedSiteDeliveryAreadIndex,\n    seltSelectedSiteDeliveryAreaIndex,\n  ] = useState(null);\n\n  const [locations, setLocations] = useState([]);\n  const [dropdownLocations, setDropdownLocations] = useState([]);\n  const [selectedLocationIndex, setSelectedLocationIndex] = useState(0);\n  const [selectedLocation, setSelectedLocation] = useState(\"\");\n\n  const [types, setTypes] = useState([]);\n  const [doropdownTypes, setDropdownTypes] = useState([]);\n  const [selectedTypeIndex, setSelectedTypeIndex] = useState(0);\n  const [selectedType, setSelectedType] = useState(\"\");\n\n  const [status, setStatus] = useState([]);\n  const [dropdownStatus, setDropdownStatus] = useState([]);\n  const [selectedStatusIndex, setSelectedStatusIndex] = useState(0);\n  const [selectedStatus, setSelectedStatus] = useState(\"\");\n\n  const [company, setCompany] = useState([]);\n  const [dropdownCompany, setDropdownCompany] = useState([]);\n  const [selectedCompanyIndex, setSeletedCompanyIndex] = useState(0);\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\n\n  const [levels, setLevels] = useState([]);\n  const [dropdownLevels, setDropdownLevels] = useState([]);\n  const [selectedDropdownLevelIndex, setSelectedDropdownLevelIndex] = useState(\n    0,\n  );\n  const [selectedLevel, setSelectedLevel] = useState(\"\");\n  const [disableDropdpwn, setDisableDropdown] = useState(true);\n  const [disableStorageDropdown, setDisableStorageDropdow] = useState(true);\n\n  const [storageAreas, setStorageAreas] = useState([]);\n  const [droprownStorageAreas, setDropdownStorageAreas] = useState([]);\n  const [\n    selectedDropdownStorageAreaIndex,\n    setSelectedDropdownStorageAreaIndex,\n  ] = useState(0);\n  const [selectedStorageArea, setSelectedStorageArea] = useState(\"\");\n  const [storageMeans, setStorageMeans] = useState([]);\n  const [means, setMeans] = useState([]);\n  const [meanText, setMeanText] = useState(\"\");\n\n  const getMeans = async () => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_LIST_OF_MEANS}/${adminStore.site.siteId._id}`,\n        token: store.token,\n      });\n      if (response.success) {\n        setMeans(response.data.means);\n\n        if (response.data.means != null) {\n          let temp = [];\n          response.data.means.map((item, index) => {\n            let data = [];\n            data[0] = item.name;\n            data[1] = item.status;\n            data[2] = item.meanType;\n\n            {\n              data[3] = item.location\n                .map((innerItem, index) => {\n                  if (\n                    innerItem.locationType != undefined &&\n                    innerItem.locationType === \"STORAGEAREA\"\n                  ) {\n                    console.log(innerItem.locationType);\n                    return innerItem.storageArea.name;\n                  }\n                  return \"\";\n                })\n                .toString()\n                .replace(/,/g, \" \");\n              data[4] = item.location\n                .map((innerItem, index) => {\n                  if (\n                    innerItem.locationType != undefined &&\n                    innerItem.locationType === \"DELIVERYAREA\"\n                  )\n                    return innerItem.deliveryArea.name;\n                  return \"\";\n                })\n                .toString()\n                .replace(/,/g, \" \");\n            }\n            temp.push(data);\n            return true;\n          });\n\n          setItems(temp);\n        }\n\n        if (response.data.site_delivery_areas != null) {\n          const temp = [];\n          response.data.site_delivery_areas.map((item, index) => {\n            return temp.push({ label: item.name, value: item.name });\n          });\n          setSiteDeliveryAreas(response.data.site_delivery_areas);\n          setDropdownDeliveryAreas(temp);\n        }\n\n        if (response.data.site_companies != null) {\n          const temp = [];\n          response.data.site_companies.map((item, index) => {\n            return temp.push({\n              label: item.companyId.name,\n              value: item.companyId.name,\n            });\n          });\n          setCompany(response.data.site_companies);\n          setDropdownCompany(temp);\n        }\n\n        if (response.data.site_locations != null) {\n          setLocations(response.data.site_locations);\n          const temp = [];\n          response.data.site_locations.map((item, index) => {\n            return temp.push({ label: item.name, value: item.name });\n          });\n          setDropdownLocations(temp);\n        }\n\n        if (response.data.mean_types != null) {\n          setTypes(response.data.mean_types);\n          const temp = [];\n          response.data.mean_types.map((item, index) => {\n            return temp.push({ label: item, value: item });\n          });\n          setDropdownTypes(temp);\n        }\n\n        if (response.data.mean_status != null) {\n          setStatus(response.data.mean_status);\n          const temp = [];\n          response.data.mean_status.map((item, index) => {\n            return temp.push({ label: item, value: item });\n          });\n          setDropdownStatus(temp);\n        }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getExternalMeans = async () => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_EXTERIOR_MEANS}/${adminStore.site.siteId._id}`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        const tempStorageAreas = [];\n        if (response.data != null && response.data.length > 0) {\n          const temp = [];\n\n          response.data.map((item, index) => {\n            item.location.map((innerItem, innerIndex) => {\n              console.log(JSON.stringify(innerItem, null, 2));\n              if (innerItem.locationType === \"STORAGEAREA\") {\n                tempStorageAreas.push(innerItem);\n                return temp.push({\n                  label: innerItem.storageArea.name,\n                  value: innerItem.storageArea.name,\n                });\n              }\n            });\n\n            //\n          });\n          setStorageAreas(tempStorageAreas);\n          setDropdownStorageAreas(temp);\n        }\n\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getLevels = async (buidlingId) => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_LEVELS}/${buidlingId}`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setLevels(response.data);\n        if (response.data != null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) => {\n            return temp.push({ label: item.name, value: item.name });\n          });\n\n          setDropdownLevels(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const formik = useFormik({\n    initialValues: {\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    // validationSchema: addClientYup,\n    // onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  useEffect(() => {\n    filterMean();\n    // eslint-disable-next-line\n  }, [\n    selectedSiteDeliveryAreadIndex,\n    selectedLocationIndex,\n    selectedDropdownLevelIndex,\n    selectedDropdownStorageAreaIndex,\n    selectedStorageArea,\n    selectedTypeIndex,\n    selectedType,\n    selectedCompanyIndex,\n    selectedCompany,\n    selectedStatusIndex,\n    selectedStatus,\n    formik.values.contractStartDate,\n    formik.values.contractEndDate,\n  ]);\n\n  const filterMean = async () => {\n    try {\n      setLoading(true);\n      const params = { siteId: adminStore.site.siteId._id };\n      if (meanText.length !== 0) params[\"name\"] = meanText;\n      if (selectedDropdownArea.length !== 0)\n        params[\"deliveryArea\"] =\n          siteDeliveryAreas[selectedSiteDeliveryAreadIndex]._id;\n      if (selectedStorageArea.length !== 0)\n        params[\"storageArea\"] =\n          storageAreas[selectedDropdownStorageAreaIndex]._id;\n\n      if (selectedCompany.length !== 0)\n        params[\"company\"] = company[selectedCompanyIndex].companyId._id;\n\n      if (selectedType.length !== 0) params[\"type\"] = types[selectedTypeIndex];\n      if (selectedStatus.length !== 0)\n        params[\"status\"] = status[selectedStatusIndex];\n      if (!isNaN(moment(formik.values.contractStartDate)))\n        params[\"startDate\"] = formik.values.contractStartDate;\n      if (!isNaN(moment(formik.values.contractEndDate)))\n        params[\"endDate\"] = formik.values.contractEndDate;\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.FILTER_MEANS}`,\n        token: store.token,\n        method: \"POST\",\n        body: JSON.stringify(params),\n      });\n      if (response.success) {\n        let temp = [];\n\n        response.data.map((item, index) => {\n          let data = [];\n          data[0] = item.name;\n          data[1] = item.status;\n          data[2] = item.meanType;\n          {\n            data[3] = item.location\n              .map((innerItem, index) => {\n                if (\n                  innerItem.locationType != undefined &&\n                  innerItem.locationType === \"STORAGEAREA\"\n                ) {\n                  console.log(innerItem.locationType);\n                  return innerItem.storageArea.name;\n                }\n                return \"\";\n              })\n              .toString()\n              .replace(/,/g, \" \");\n            data[4] = item.location\n              .map((innerItem, index) => {\n                if (\n                  innerItem.locationType != undefined &&\n                  innerItem.locationType === \"DELIVERYAREA\"\n                )\n                  return innerItem.deliveryArea.name;\n                return \"\";\n              })\n              .toString()\n              .replace(/,/g, \" \");\n          }\n          return temp.push(data);\n        });\n        setItems(temp);\n\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getStorageAreasByLevel = async (levelId) => {\n    try {\n      setLoading(true);\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_LEVEL_ID}/${levelId}`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setStorageAreas(response.data);\n        if (response.data != null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) => {\n            return temp.push({ label: item.name, value: item.name });\n          });\n\n          setDropdownStorageAreas(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    getMeans();\n    // eslint-disable-next-line\n  }, []);\n\n  const rows = items.map((item, index) => {\n    return [\n      ...item,\n      <div>\n        <NavLink\n          to={{\n            pathname: \"/means/edit-mean\",\n            mean: means[index],\n          }}\n          style={{ color: \"#959491 !important\", textDecoration: \"none\" }}\n        >\n          <Pencil style={{ width: 18, height: 15, cursor: \"pointer\" }} />\n        </NavLink>\n\n        <NavLink\n          to={{\n            pathname: \"/means/calendar\",\n            mean: means[index],\n          }}\n        >\n          <img\n            src={Images.calender}\n            style={{ width: 18, height: 15, paddingLeft: 5 }}\n            alt=\"Icon\"\n          />\n        </NavLink>\n        <NavLink\n          to={{\n            pathname: \"/means/mean-history\",\n            mean: means[index],\n          }}\n        >\n          <img\n            src={Images.incidents}\n            style={{ width: 18, height: 15, paddingLeft: 5 }}\n            alt=\"Icon\"\n          />\n        </NavLink>\n      </div>,\n    ];\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row alignItems=\"center\">\n        {loading && \"\"}\n        {selectedLocation && \"\"}\n        {company && \"\"}\n        {selectedLevel && \"\"}\n        {storageMeans && \"\"}\n        <Heading primary=\"LIST OF MEANS\" noWrap />\n        <div>\n          <Form.Row\n            alignItems=\"flex-start\"\n            noMargin\n            justifyContent=\"flex-end\"\n            style={{ paddingRight: \"50px\" }}\n          >\n            <SubHeading\n              noMargin\n              topPadding\n              primary={`TOTAL : ${means.length} means`}\n              bold\n            />\n            <Form.Column style={{ width: \"50%\" }}>\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"ADD A MEAN\"\n                to={\"/means/add-mean\"}\n                style={{\n                  marginLeft: \"20px\",\n                  marginBottom: \"7px\",\n                  width: \"200px\",\n                }}\n              />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"MEANS REQUEST\"\n                to={\"/sites/means-request\"}\n                style={{ marginLeft: \"20px\", width: \"200px\" }}\n              />\n            </Form.Column>\n          </Form.Row>\n        </div>\n      </Form.Row>\n      <Form.Row alignItems=\"center\" noMargin>\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          <FormSelect\n            placeholder=\"Delivery area\"\n            values={dropdownDeliveryAreas}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n\n              if (index !== -1) {\n                const item = event.target.value;\n\n                seltSelectedSiteDeliveryAreaIndex(index);\n\n                setSelectedDropdownArea(item);\n              } else {\n                seltSelectedSiteDeliveryAreaIndex(null);\n\n                setSelectedDropdownArea(\"\");\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Location\"\n            values={dropdownLocations}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index !== -1) {\n                const item = event.target.value;\n\n                setSelectedLocationIndex(index);\n                setSelectedLocation(item);\n                // Reset Levels\n                setSelectedDropdownLevelIndex(0);\n                setSelectedLevel(\"\");\n                setDropdownLevels([]);\n                // Reset Storage Area\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                setDropdownStorageAreas([]);\n                setDisableStorageDropdow(true);\n                // Reset Storage Means\n                setStorageMeans([]);\n                if (locations[index].buildingType === \"EXTERIOR\") {\n                  setDisableDropdown(true);\n                  getExternalMeans();\n                  setDisableStorageDropdow(false);\n                } else {\n                  setDisableDropdown(false);\n                  getLevels(locations[index]._id);\n                }\n              } else {\n                setSelectedLocationIndex(0);\n                setSelectedLocation(\"\");\n                // Reset Levels\n                setSelectedDropdownLevelIndex(0);\n                setSelectedLevel(\"\");\n                setDropdownLevels([]);\n                // Reset Storage Area\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                setDropdownStorageAreas([]);\n                // Reset Storage Means\n                setStorageMeans([]);\n                setDisableStorageDropdow(true);\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Level\"\n            values={dropdownLevels}\n            disabled={disableDropdpwn}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index !== -1) {\n                const item = event.target.value;\n                setSelectedDropdownLevelIndex(index);\n                setSelectedLevel(item);\n                // Reset Storage Area\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                setDropdownStorageAreas([]);\n                // Reset Storage Means\n                setStorageMeans([]);\n                setDisableStorageDropdow(false);\n                getStorageAreasByLevel(levels[index]._id);\n              } else {\n                setSelectedDropdownLevelIndex(0);\n                setSelectedLevel(\"\");\n                // Reset Storage Area\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                setDropdownStorageAreas([]);\n                // Reset Storage Means\n                setStorageMeans([]);\n                setDisableStorageDropdow(true);\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Storage area\"\n            values={droprownStorageAreas}\n            disabled={disableStorageDropdown}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index !== -1) {\n                const item = event.target.value;\n\n                setSelectedDropdownStorageAreaIndex(index);\n                setSelectedStorageArea(item);\n                // Reset Storage Means\n                setStorageMeans([]);\n\n                // filterMean();\n              } else {\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                //  filterMean();\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Type\"\n            values={doropdownTypes}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index !== -1) {\n                const item = event.target.value;\n                setSelectedTypeIndex(index);\n                setSelectedType(item);\n                // Reset Storage Means\n                //filterMean();\n              } else {\n                setSelectedTypeIndex(0);\n                setSelectedType(\"\");\n                // Reset Storage Means\n                //filterMean();\n              }\n            }}\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\n          See archived sites\n        </NavLink> */}\n      </Form.Row>\n\n      <Form.Row alignItems=\"center\" noMargin className=\"mt-3\">\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          <FormSelect\n            placeholder=\"Company\"\n            values={dropdownCompany}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              const item = event.target.value;\n              if (index !== -1) {\n                setSeletedCompanyIndex(index);\n                setSelectedCompany(item);\n                //   filterMean();\n              } else {\n                setSeletedCompanyIndex(0);\n                setSelectedCompany(\"\");\n                // filterMean();\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Status\"\n            values={dropdownStatus}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index !== -1) {\n                const item = event.target.value;\n                setSelectedStatusIndex(index);\n                setSelectedStatus(item);\n                // filterMean();\n              } else {\n                setSelectedStatusIndex(0);\n                setSelectedStatus(\"\");\n                //filterMean();\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormInput\n            type=\"date\"\n            placeholder=\"Start date\"\n            name=\"contractStartDate\"\n            icon\n            onChange={formik.handleChange}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormInput\n            type=\"date\"\n            placeholder=\"End date\"\n            name=\"contractEndDate\"\n            icon\n            onChange={formik.handleChange}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <SearchInput\n            placeholder=\"Mean name\"\n            value={meanText}\n            onClick={() => {\n              filterMean();\n            }}\n            onChange={(event) => {\n              setMeanText(event.target.value);\n            }}\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n      </Form.Row>\n      <div className={classes.content}>\n        <Table headers={GLOBALS.Data.means.headings} rows={rows} />\n      </div>\n    </div>\n  );\n};\n\nexport default Means;\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/UserList.js",["549","550"],"import React, { useState, useEffect } from \"react\";\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n// import * as Yup from \"yup\";\n\nimport GLOBALS from \"../../../globals\";\nimport Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Modal from \"../../../components/Modal\";\nimport SmallButton from \"../../../components/SmallButton\";\n\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport AvatarUpload from \"../../../components/AvatarUpload\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n}));\n\n// const updateAdminYup = Yup.object().shape({\n//   email: Yup.string().required(\"Required\"),\n//   phone: Yup.number()\n//     .test(\n//       \"len\",\n//       \"Must be exactly 10 characters\",\n//       (val) => val && val.toString().length === 10,\n//     )\n//     .required(\"Required\"),\n//   image: Yup.object().optional(\"\"),\n//   companyId: Yup.string().required(\"Required\"),\n// });\n\nexport default function UserList(props) {\n  const theme = useTheme();\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n  const [page] = useState(1);\n  const [items, setItems] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [companies, setCompanies] = useState([]);\n  const [open, setOpen] = useState(false);\n\n  const [selectedItem] = useState(\"\");\n\n  const [firstName, setFirstName] = useState(\"\");\n  const [lastName, setLastName] = useState(\"\");\n  const [phone, setPhone] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [companyId, setCompanyId] = useState(\"\");\n  const [companyName, setCompanyName] = useState(\"\");\n  const [users, setUsers] = useState([]);\n  useEffect(() => {\n    getData();\n    // eslint-disable-next-line\n  }, []);\n\n  const getData = async () => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_COMPANY_USERS}/${adminStore.site.siteId._id}/${props.location.id}`,\n        token: store.token,\n      });\n      //console.log(JSON.stringify(response.data[0].usersArray, null, 2));\n      if (response.success) {\n        setCompanyName(response.data[0].company.name);\n        setUsers(response.data[0].usersArray);\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n  const resendVerificaiontRequest = () => {};\n  const handleChange = (name, value) => {\n    if (name === \"firstName\") setFirstName(value);\n    else if (name === \"lastName\") setLastName(value);\n    else if (name === \"phone\") setPhone(value);\n    else if (name === \"image\") setImage(value);\n    else if (name === \"companyId\") setCompanyId(value);\n  };\n\n  const onUpdate = async (e) => {\n    try {\n      e.preventDefault();\n      setLoading(true);\n      var formdata = new FormData();\n      formdata.append(\"firstName\", firstName);\n      formdata.append(\"lastName\", lastName);\n      formdata.append(\"phone\", phone);\n      formdata.append(\"companyId\", companyId);\n      formdata.append(\"userId\", selectedItem._id);\n      image.file && formdata.append(\"image\", image.file);\n\n      const result = await GLOBALS.API({\n        method: \"PUT\",\n        uri: GLOBALS.Constants.ADMINS,\n        headers: {\n          Authorization: store.token,\n        },\n        body: formdata,\n      });\n      const itemsArray = items.map((item) =>\n        item._id === selectedItem._id ? result.data : item,\n      );\n      setItems(itemsArray);\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n  const handleClickOpen = () => {\n    setOpen(true);\n  };\n  const rows = users.map((item) => {\n    console.log(JSON.stringify(item, null, 2));\n    const user = item;\n    return [\n      user.firstName + \" \" + user.lastName,\n      companyName,\n      item.role,\n      user.isVerified ? \"Inscrit\" : \"En attente\",\n      user.email,\n      <SmallButton\n        text={user.isVerified ? \"Edit\" : \"Re-Send\"}\n        onClick={user.isVerified ? handleClickOpen : resendVerificaiontRequest}\n        color={theme.palette.primary.contrastText}\n        to={\"/companies\"}\n        // component={NavLink}\n        style={{\n          marginLeft: 10,\n          borderRadius: 4,\n        }}\n      />,\n    ];\n  });\n\n  return (\n    <>\n      <div className={classes.root}>\n        <Form.Row alignItems=\"center\" className=\"pr-3\">\n          <Heading primary=\"LIST OF USERS\" noWrap />\n          <div>\n            <Form.Row alignItems=\"center\" noMargin>\n              <SubHeading\n                disableMargin\n                primary={`Total : ${users.length} Users`}\n                bold\n              />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"ADD A USER\"\n                style={{ marginLeft: \"20px\" }}\n                to={\"/companies/add-user\"}\n              />\n            </Form.Row>\n          </div>\n        </Form.Row>\n        {companies && \"\"}\n        <Form.Row noMargin>\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\n            <SearchInput placeholder=\"Name OF USER\" />\n            <FormSelect\n              placeholder=\"Company\"\n              name=\"color\"\n              style={{ marginLeft: \"20px\", maxWidth: 250 }}\n              values={[\n                { value: \"green\", label: \"Green\" },\n                { value: \"Yellow\", label: \"Yellow\" },\n                { value: \"Red\", label: \"Red\" },\n                { value: \"Blue\", label: \"Blue\" },\n                { value: \"Orange\", label: \"Orange\" },\n                { value: \"Purple\", label: \"Purple\" },\n                { value: \"Magenta\", label: \"Magenta\" },\n              ]}\n            />\n          </Form.Row>\n        </Form.Row>\n        <div className={classes.content}>\n          <Table headers={GLOBALS.Data.userList.headings} rows={rows} />\n        </div>\n      </div>\n      <Modal\n        title=\"THEIRRY MARLES\"\n        open={open}\n        onClose={() => setOpen(false)}\n        body={\n          <Form.Form onSubmit={onUpdate}>\n            <Form.Row justifyContent=\"center\">\n              <AvatarUpload\n                value={image}\n                // error={image}\n                onChange={(file) => {\n                  const uri = URL.createObjectURL(file);\n                  handleChange(\"image\", { file, uri });\n                }}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"thier@contrco.com\"\n                value={firstName}\n                // error={firstName}\n                placeholder=\"First Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"lastName\"\n                value={lastName}\n                // error={lastName}\n                placeholder=\"Last Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\"></Form.Row>\n            <Form.ButtonContainer>\n              <Button\n                type=\"submit\"\n                minWidth={200}\n                text=\"VALIDATE\"\n                fullWidth={false}\n                disabled={loading}\n              />\n            </Form.ButtonContainer>\n          </Form.Form>\n        }\n      />\n    </>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/AddUser.js",["551","552","553","554","555","556","557","558","559","560"],"import React, { useState, useEffect } from \"react\";\nimport { useFormik } from \"formik\";\nimport { useSelector, useDispatch } from \"react-redux\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport * as Yup from \"yup\";\n\nimport GLOBALS from \"../../../globals\";\nimport Form from \"../../../components/Form\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport FormLabel from \"../../../components/FormLabel\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\nimport TextField from \"@material-ui/core/TextField\";\nimport Actions from \"../../../redux/actions\";\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n}));\n\nconst addClientYup = Yup.object().shape({\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\n  name: Yup.string().required(\"Required\"),\n  email: Yup.string().required(\"Required\"),\n  firstName: Yup.string().required(\"Required\"),\n  lastName: Yup.string().required(\"Required\"),\n  site: Yup.string().required(\"Required\"),\n  phone: Yup.number()\n    .test(\n      \"len\",\n      \"Must be exactly 10 characters\",\n      (val) => val && val.toString().length === 10,\n    )\n    .required(\"Required\"),\n});\n\nexport default function AddUser(props) {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n  const [page] = useState(1);\n  const [companies, setCompanies] = useState([]);\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\n\n  const [roles, setRoles] = useState([]);\n  const [dropdownRoles, setDropdownRoles] = useState([]);\n  const [selectedRole, setSelectedRole] = useState(\"\");\n  const [selectedRoleIndex, setSelectedRoleIndex] = useState(null);\n\n  const [siteParams, setSiteParams] = useState([]);\n\n  const [users, setUsers] = useState([]);\n\n  useEffect(() => {\n    getData();\n  }, []);\n\n  const getData = async () => {\n    try {\n      formik.setFieldValue(\"site\", adminStore.site.siteId.name);\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_ADD_USER}/${adminStore.site.siteId._id}/${store.user._id}`,\n        token: store.token,\n      });\n      if (response.success) {\n        setCompanies(response.data.site_companies.companies);\n        setRoles(response.data.site_companies.companies);\n        setUsers(response.data.users);\n        if (response.data.site_companies != null) {\n          const companyTemp = [];\n\n          response.data.site_companies.companies.map((item, index) => {\n            return companyTemp.push({ label: item.name, value: item.name });\n          });\n          setDropdownCompanies(companyTemp);\n        }\n        if (response.data.roles != null) {\n          const rolesTemp = [];\n\n          response.data.roles.map((item, index) => {\n            return rolesTemp.push({ label: item, value: item });\n          });\n          setDropdownRoles(rolesTemp);\n        }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getUserCompany = async (userId) => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_USER_COMPANY}/${adminStore.site.siteId._id}/${userId}`,\n        token: store.token,\n      });\n      if (response.success) {\n        console.log(JSON.stringify(response, null, 2));\n        if (response.data) {\n          companies.forEach((item, index) => {\n            if (item._id === response.data._id) {\n              item.users.forEach((innerItem, innerIndex) => {\n                console.log(\"innser \", innerItem.userId);\n                if (innerItem.userId === userId) {\n                  setSelectedRoleIndex(innerIndex);\n\n                  setSelectedRole(innerItem.role);\n                }\n              });\n              setSelectedCompanyIndex(index);\n\n              setSelectedCompany(item.name);\n            }\n          });\n        }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const onSubmit = async () => {\n    const values = formik.values;\n    const sites = [];\n    siteParams.forEach((item) => {\n      sites.push({ siteId: item.id, role: selectedRole });\n    });\n    var formdata = new FormData();\n    formdata.append(\"image\", values.logo[0].file);\n    //formdata.append(\"name\", values.name);\n    formdata.append(\"firstName\", values.firstName);\n    formdata.append(\"lastName\", values.lastName);\n    formdata.append(\"email\", values.email);\n    formdata.append(\"phone\", values.phone);\n    formdata.append(\"sites\", JSON.stringify(sites));\n    formdata.append(\"companyId\", companies[selectedCompanyIndex]._id);\n\n    await GLOBALS.API({\n      method: \"POST\",\n      uri: GLOBALS.Constants.ADD_USER_ADMIN,\n      headers: {\n        Authorization: store.token,\n      },\n      body: formdata,\n    });\n    formik.setSubmitting(false);\n    props.history.push(\"/clients\");\n  };\n\n  const formik = useFormik({\n    initialValues: {\n      logo: [],\n      name: \"\",\n      color: \"\",\n      firstName: \"\",\n      lastName: \"\",\n      email: \"\",\n      phone: \"\",\n      site: \"\",\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n    },\n    validationSchema: addClientYup,\n    onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n      <Heading primary=\"ADD USER\" />\n      <div className={classes.content}>\n        <Form.Form onSubmit={formik.handleSubmit}>\n          <Form.Row>\n            <FormLabel bold primary=\"CONTACT INFO* :\" />\n            <Form.Row width=\"48%\">\n              {/* <FormInput\n                name=\"name\"\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\n                placeholder=\"Adresse e-mail\"\n                onChange={formik.handleChange}\n                value={formik.values.name}\n                error={formik.errors.name}\n              /> */}\n              <Autocomplete\n                id=\"free-solo-demo\"\n                freeSolo\n                style={{\n                  ...GLOBALS.Styles.inputWidth,\n                  marginRight: \"10px\",\n                }}\n                onSelect={(event) => {\n                  users.forEach((item, index) => {\n                    if (item.userId.email === event.target.value) {\n                      console.log(JSON.stringify(item.sites, null, 2));\n                      formik.setFieldValue(\"firstName\", item.userId.firstName);\n                      formik.setFieldValue(\"lastName\", item.userId.lastName);\n                      formik.setFieldValue(\"phone\", item.userId.phone);\n                      formik.setFieldValue(\"logo\", [\n                        { uri: item.userId.image },\n                      ]);\n\n                      getUserCompany(item.userId._id);\n                    }\n                  });\n                }}\n                options={users.map((option) => {\n                  if (option.userId.email != undefined)\n                    return option.userId.email;\n                })}\n                renderInput={(params) => (\n                  <TextField\n                    {...params}\n                    label=\"Email\"\n                    margin=\"normal\"\n                    variant=\"outlined\"\n                    name=\"email\"\n                    value={formik.values.email}\n                    error={formik.errors.email}\n                    onChange={formik.handleChange}\n                  />\n                )}\n              />\n              <FormInput\n                name=\"phone\"\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\n                placeholder=\"Téléphone\"\n                onChange={formik.handleChange}\n                value={formik.values.phone}\n                error={formik.errors.phone}\n              />\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"INDENTITY* :\" />\n            <Form.Row width=\"48%\">\n              <FormInput\n                name=\"firstName\"\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\n                placeholder=\"FIRST NAME\"\n                onChange={formik.handleChange}\n                value={formik.values.firstName}\n                error={formik.errors.firstName}\n              />\n              <FormInput\n                name=\"lastName\"\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\n                placeholder=\"LAST NAME\"\n                onChange={formik.handleChange}\n                value={formik.values.lastName}\n                error={formik.errors.name}\n              />\n              <FormMultipleUpload\n                name=\"logo\"\n                style={GLOBALS.Styles.inputWidth}\n                error={formik.errors.logo}\n                values={formik.values.logo}\n                onChange={(values) =>\n                  formik.handleChange({\n                    target: {\n                      type: \"text\",\n                      name: \"logo\",\n                      value: values,\n                    },\n                  })\n                }\n              />\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"COMPANY : \" />\n            <Form.Row noMargin width=\"48%\">\n              <FormSelect\n                placeholder=\"Company\"\n                values={dropdownCompanies}\n                value={selectedCompany}\n                onChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n\n                  if (index !== -1) {\n                    const item = event.target.value;\n\n                    setSelectedCompanyIndex(index);\n\n                    setSelectedCompany(item);\n                  } else {\n                    setSelectedCompanyIndex(null);\n\n                    setSelectedCompany(\"\");\n                  }\n                }}\n                style={{ marginRight: \"20px\", maxWidth: 250 }}\n              />\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"RÔLE : \" />\n            <Form.Row noMargin width=\"48%\">\n              <FormSelect\n                placeholder=\"RÔLE : \"\n                name=\"color\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={formik.handleChange}\n                value={formik.values.color}\n                error={formik.errors.color}\n                values={dropdownRoles}\n                value={selectedRole}\n                onChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n\n                  if (index !== -1) {\n                    const item = event.target.value;\n\n                    setSelectedRoleIndex(index);\n\n                    setSelectedRole(item);\n                  } else {\n                    setSelectedRoleIndex(null);\n\n                    setSelectedRole(\"\");\n                  }\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"CONSTRUCTION SITE : \" />\n            <Form.Row noMargin width=\"48%\">\n              <FormInput\n                name=\"site\"\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\n                placeholder=\"Site\"\n                onChange={formik.handleChange}\n                value={formik.values.site}\n                error={formik.errors.site}\n                disabled={true}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.ButtonContainer>\n            <Button\n              minWidth={200}\n              text=\"CONTINUER\"\n              fullWidth={false}\n              onClick={() => {\n                onSubmit();\n              }}\n              loading={formik.isSubmitting}\n              disabled={formik.isSubmitting}\n            />\n          </Form.ButtonContainer>\n        </Form.Form>\n      </div>\n    </div>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Calender/
\Documents\\github\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep3.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep2.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep1.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\UnavailabilityTimes.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\OpeningTimes.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\MultiAdderInputModal.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\Input.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\CustomFormInput.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\MyWorkWeek.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\popoverModal.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\pages\\Admin\\Pic\\Mean.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\FullScreenModal.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\pages\\Admin\\Pic\\Building.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\pages\\Admin\\Pic\\StorageArea.js",["678","679","680","681"],"import React, { useEffect, useState } from \"react\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport MultiAdderInputModal from \"../../../components/MultiAdderInputModal\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nexport default function StorageArea(props) {\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const [addresses, setAddresses] = useState([]);\r\n  const [loading, setLoading] = useState(false);\r\n  const [incident, setIncident] = useState([]);\r\n  const [sites, setSites] = useState([]);\r\n\r\n  const [incidentId, setIncidentId] = useState(\"\");\r\n  const [startDate, setStartDate] = useState(\"\");\r\n  const [endDate, setEndDate] = useState(\"\");\r\n  const [siteId, setSiteId] = useState(\"\");\r\n  const [amount, setAmount] = useState(0);\r\n  const [description, setDescription] = useState(\"\");\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    incident && fetchSitesByClient();\r\n    // eslint-disable-next-line\r\n  }, [incidentId]);\r\n\r\n  async function fetchData() {\r\n    try {\r\n      // const result = await GLOBALS.API({\r\n      //   uri: `${GLOBALS.Constants.ADD_INCIDENTS}`,\r\n      //   token: store.token,\r\n      // });\r\n      // let itemsArray = result.data.items.map((item) => ({\r\n      //   value: item._id,\r\n      //   label: item.companyId.name,\r\n      // }));\r\n      // setIncident(itemsArray);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  async function fetchSitesByClient() {\r\n    try {\r\n      // const result = await GLOBALS.API({\r\n      //   uri: `${GLOBALS.Constants.SITE_BY_CLIENT}/${incidentId}`,\r\n      //   token: store.token,\r\n      // });\r\n      // let itemsArray = result.data.items.map((item) => ({\r\n      //   value: item._id,\r\n      //   label: item.name,\r\n      // }));\r\n      // setSites(itemsArray);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"clientId\") setIncidentId(value);\r\n    else if (name === \"startDate\") setStartDate(value);\r\n    else if (name === \"endDate\") setEndDate(value);\r\n    else if (name === \"siteId\") setSiteId(value);\r\n    else if (name === \"amount\") setAmount(value);\r\n    else if (name === \"description\") setDescription(value);\r\n  };\r\n\r\n  const onSubmit = async (e) => {\r\n    try {\r\n      e.preventDefault();\r\n      setLoading(true);\r\n      const formdata = JSON.stringify({\r\n        incidentId: incidentId,\r\n        startDate: startDate,\r\n        endDate: endDate,\r\n        siteId: siteId,\r\n        amount: amount,\r\n        description: description,\r\n      });\r\n\r\n      await GLOBALS.API({\r\n        method: \"POST\",\r\n        uri: GLOBALS.Constants.INVOICES,\r\n        token: store.token,\r\n        body: formdata,\r\n      });\r\n      setLoading(false);\r\n      props.history.goBack();\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className={classes.content}>\r\n      <div\r\n        style={{\r\n          marginRight: 20,\r\n          display: \"flex\",\r\n          justifyContent: \"space-between\",\r\n          alignItems: \"center\",\r\n        }}\r\n      >\r\n        <div style={{ marginRight: \"8rem\", color: \"red\" }}>\r\n          <input type=\"checkbox\" name=\"isFull\" />\r\n          <span>FULL ?</span>\r\n        </div>\r\n      </div>\r\n      <Form.Form onSubmit={onSubmit}>\r\n        <Form.Row>\r\n          <FormLabel bold primary=\"NAME* :\" />\r\n          <Form.Row width=\"48%\">\r\n            <FormInput\r\n              name=\"name\"\r\n              style={GLOBALS.Styles.inputWidth}\r\n              placeholder=\"Name\"\r\n            />\r\n            <FormInput\r\n              name=\"color\"\r\n              style={GLOBALS.Styles.inputWidth}\r\n              placeholder=\"Color\"\r\n            />\r\n          </Form.Row>\r\n        </Form.Row>\r\n        <Form.Row>\r\n          <FormLabel bold primary=\"DATE OF AVAILABILITIES* : \" />\r\n          <Form.Row noMargin width=\"48%\">\r\n            <FormInput\r\n              type=\"date\"\r\n              name=\"startDate\"\r\n              value={startDate}\r\n              placeholder=\"Start date\"\r\n              style={GLOBALS.Styles.inputWidth}\r\n              onChange={({ target: { name, value } }) =>\r\n                handleChange(name, value)\r\n              }\r\n            />\r\n            <FormInput\r\n              type=\"date\"\r\n              name=\"endDate\"\r\n              value={endDate}\r\n              placeholder=\"End date\"\r\n              style={GLOBALS.Styles.inputWidth}\r\n              onChange={({ target: { name, value } }) =>\r\n                handleChange(name, value)\r\n              }\r\n            />\r\n          </Form.Row>\r\n        </Form.Row>\r\n        <Form.Row alignItems=\"flex-start\">\r\n          <FormLabel bold primary=\"DELIVERY AREAS :\" />\r\n          <Form.Row style={{ width: \"48%\" }}>\r\n            <MultiAdderInputModal\r\n              name=\"addresses\"\r\n              values={addresses}\r\n              style={GLOBALS.Styles.inputWidth}\r\n              placeholder=\"Enter site addresses\"\r\n              onChange={(values) => handleChange(\"addresses\", values)}\r\n            />\r\n          </Form.Row>\r\n        </Form.Row>\r\n        <Form.Row alignItems=\"flex-start\">\r\n          <FormLabel bold primary=\"AVAILABLE MEANS\" />\r\n          <Form.Row width=\"48%\">\r\n            <div>Moyen 1</div>\r\n            <div>Moyen 2</div>\r\n            <div>Moyen 3</div>\r\n          </Form.Row>\r\n        </Form.Row>\r\n        <Form.Row alignItems=\"flex-start\">\r\n          <FormLabel bold primary=\"UNAVAILABILITIES:\" />\r\n          <Form.Row style={{ width: \"48%\" }}>\r\n            <Button\r\n              fullWidth={false}\r\n              text=\"SHOW THE UNAVAILABILITIES\"\r\n              style={{\r\n                backgroundColor: \"#140772\",\r\n                alignSelf: \"flex-start\",\r\n              }}\r\n            />\r\n          </Form.Row>\r\n        </Form.Row>\r\n        <Form.Row alignItems=\"flex-start\">\r\n          <FormLabel bold primary=\"COMPANIES ALLOWED :\" />\r\n          <Form.Row noMargin width=\"48%\">\r\n            <MultiAdderInputModal\r\n              name=\"addresses\"\r\n              values={addresses}\r\n              style={GLOBALS.Styles.inputWidth}\r\n              placeholder=\"Enter site addresses\"\r\n              onChange={(values) => handleChange(\"addresses\", values)}\r\n            />\r\n          </Form.Row>\r\n        </Form.Row>\r\n        <Form.Row alignItems=\"flex-start\">\r\n          <FormLabel bold primary=\"NOTIFICATION*:\" />\r\n          <Form.Row width=\"48%\" justifyContent=\"flex-start\">\r\n            <Form.Row width=\"25%\">\r\n              <FormInput\r\n                type=\"number\"\r\n                name=\"amount\"\r\n                value={amount}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <span style={{ marginTop: \"15px\" }}>\r\n              Jours avant la fin du contrat\r\n            </span>\r\n          </Form.Row>\r\n        </Form.Row>\r\n        <Form.Row alignItems=\"flex-start\">\r\n          <FormLabel bold primary=\"NOTIFY THE PEOPLE:\" />\r\n          <Form.Row noMargin width=\"48%\">\r\n            <MultiAdderInputModal\r\n              name=\"addresses\"\r\n              values={addresses}\r\n              style={GLOBALS.Styles.inputWidth}\r\n              placeholder=\"Enter site addresses\"\r\n              onChange={(values) => handleChange(\"addresses\", values)}\r\n            />\r\n          </Form.Row>\r\n        </Form.Row>\r\n        <Form.ButtonContainer>\r\n          <Button\r\n            type=\"submit\"\r\n            minWidth={200}\r\n            text=\"VALIDATE\"\r\n            fullWidth={false}\r\n            loading={loading}\r\n            disabled={\r\n              loading ||\r\n              !incidentId ||\r\n              !startDate ||\r\n              !endDate ||\r\n              !siteId ||\r\n              Number(amount) <= 0\r\n            }\r\n          />\r\n        </Form.ButtonContainer>\r\n      </Form.Form>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\pages\\Admin\\Pic\\DeliveryArea.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\Canvas\\index.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\DeliveryAreaAddressModal.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\Canvas\\ConvaExample.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\Canvas\\Components\\Header.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\Canvas\\Components\\Rectangle.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\Canvas\\Components\\Line.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\Canvas\\Components\\data.js",[],"C:\\Users\\user\\Documents\\github\\orgaplan-reactjs\\src\\components\\FormMultiSelect.js",[],{"ruleId":"682","replacedBy
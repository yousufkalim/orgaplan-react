seState([]);\r\n  const [items, setItems] = useState([]);\r\n  const [siteDeliveryArea, setSiteDeliveryArea] = useState([]);\r\n  const [siteStorageArea, setSiteStorageArea] = useState([]);\r\n  const [siteComapny, setSiteComapny] = useState([]);\r\n  const [siteBuilding, setSiteBuilding] = useState([]);   \r\n  const [status, setStatus] = useState([]);\r\n  const [type, setType] = useState([]);\r\n\r\n  // const [page, setPage] = useState(\"\");\r\n  const adminStore = useSelector((state) => state.admin);\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  async function fetchData() {\r\n    try {\r\n      const result = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ALL_SITE_INCIDENTS}/${adminStore.site.siteId._id}`,\r\n      });\r\n      console.log(result.data);\r\n      if (result.success) {\r\n        setIncidents(result.data.incidents);\r\n        setCompleteIncidents(result.data.incidents);\r\n\r\n        if (result.data.incidents) getIncidentsfiltered(result.data.incidents);\r\n        if (result.data.site_delivery_areas) {\r\n            getDeliveryArea(result.data.site_delivery_areas);\r\n        }  if (result.data.site_storage_areas) {\r\n          getStorageArea(result.data.site_storage_areas);\r\n        }\r\n        if (result.data.type) {\r\n          getType(result.data.type);\r\n        }\r\n        if (result.data.status) {\r\n          getStatus(result.data.status);\r\n        }\r\n         if (result.data.site_companies) {\r\n           getCompanies(result.data.site_companies);\r\n        }\r\n        \r\n        \r\n\r\n      }\r\n      // setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n    function getCompanies(data) {\r\n      console.log(data);\r\n      let temp = [];\r\n      data.map((item, index) => {\r\n        return temp.push({\r\n          label: item.companyId.name,\r\n          value: item.companyId._id,\r\n        });\r\n      });\r\n      setSiteComapny(temp);\r\n    }\r\n  function getStatus(data) {\r\n    let temp = [];\r\n    data.map((item, index) => {\r\n      return temp.push({\r\n        label: item,\r\n        value: item,\r\n      });\r\n    });\r\n    setStatus(temp);\r\n  }\r\n\r\n  function getStorageArea(data){\r\n        let temp = [];\r\n        data.map((item, index) => {\r\n          return temp.push({\r\n            label: item.name,\r\n            value: item._id,\r\n          });\r\n        });\r\n        setSiteStorageArea(temp);\r\n  }\r\n\r\n  function getType(data) {\r\n    let temp = [];\r\n    data.map((item, index) => {\r\n      return temp.push({\r\n        label: item,\r\n        value: item,\r\n      });\r\n    });\r\n    setType(temp);\r\n  }\r\n\r\n  function getDeliveryArea(data) {\r\n    let temp = [];\r\n    data.map((item, index) => {\r\n        return temp.push({\r\n          label: item.name,\r\n          value: item._id,\r\n        });\r\n    })\r\n    setSiteDeliveryArea(temp);\r\n  }\r\n\r\n\r\n  function getIncidentsfiltered(data) {\r\n    let temp = [];\r\n    data.map((item, index) => {\r\n      let data = [];\r\n      data[0] = item?.date;\r\n      data[1] = item?.type;\r\n      data[2] = item?.name;\r\n      data[3] = item.companyId?.name;\r\n      data[4] = item.companyId?.status;\r\n      data[5] = item.location?.deliveryArea?.name;\r\n      data[6] = item?.isBillable ? \"Yes\" : \"No\";\r\n      data[7] = item?.price;\r\n      data[8] = item?.isBillable ? \"Yes\" : \"No\";\r\n\r\n      return temp.push(data);\r\n    });\r\n    setItems(temp);\r\n  }\r\n\r\n  const rows = items.map((item, index) => {\r\n    return [\r\n      item[0] ? item[0] : \"\",\r\n      item[1] ? item[1] : \" \",\r\n      item[2] ? item[2] : \" \",\r\n      item[3] ? item[3] : \" \",\r\n      item[4] ? item[4] : \" \",\r\n      item[5] ? item[5] : \" \",\r\n      item[6] ? item[6] : \" \",\r\n      item[7] ? item[7] : \" \",\r\n      item[8] ? item[8] : \" \",\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <Form.Row alignItems=\"center\">\r\n        <Heading icon primary=\"RE-INVOICING\" noWrap />\r\n        <div>\r\n          <Form.Row alignItems=\"flex-start\" noMargin justifyContent=\"flex-end\">\r\n            <SubHeading\r\n              noMargin\r\n              topPadding\r\n              style={{ color: \"#F80303\" }}\r\n              primary=\"TOTAL : 5 RE-INVOICING\r\n              345€ \r\n\"\r\n              bold\r\n            />\r\n            <Form.Column style={{ width: \"50%\" }}>\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"CREATE AN INCIDENT\"\r\n                to={\"/incidents/add-incidents\"}\r\n                style={{\r\n                  marginLeft: \"20px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"200px\",\r\n                  fontWeight: \"bold\",\r\n                  backgroundColor: \"#F80303\",\r\n                }}\r\n              />\r\n              {/* <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"MEANS REQUEST\"\r\n                to={\"/sites/means-request\"}\r\n                style={{ marginLeft: \"20px\", width: \"200px\" }}\r\n              /> */}\r\n            </Form.Column>\r\n          </Form.Row>\r\n        </div>\r\n      </Form.Row>\r\n      <Form.Row alignItems=\"center\" noMargin>\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          {/* <SearchInput\r\n            placeholder=\"Site name\"\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          /> */}\r\n          <FormSelect\r\n            placeholder=\"Delivery area\"\r\n            values={siteDeliveryArea}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Location\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Level\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Storage area\"\r\n            values={siteStorageArea}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Type\"\r\n            values={type}\r\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\r\n          See archived sites\r\n        </NavLink> */}\r\n      </Form.Row>\r\n\r\n      <Form.Row alignItems=\"center\" className=\"mt-3\">\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          <FormSelect\r\n            placeholder=\"Company\"\r\n            values={siteComapny}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n\r\n          <FormInput\r\n            type=\"date\"\r\n            placeholder=\"Start date\"\r\n            name=\"startDate\"\r\n            icon\r\n            // onChange={formik.handleChange}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormInput\r\n            type=\"date\"\r\n            placeholder=\"End date\"\r\n            name=\"endDate\"\r\n            // icon\r\n            // onChange={formik.handleChange}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Status\"\r\n            values={status}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <SearchInput\r\n            placeholder=\"Designation\"\r\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Table\r\n          headers={GLOBALS.Data.incidents.headings}\r\n          rows={rows}\r\n          onClick={(e) => {\r\n            return props.history.push({\r\n              pathname: \"/incidents/edit-incidents\",\r\n              data: incidents[e],\r\n            });\r\n          }}\r\n        />\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Incidents;\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\AddUser.js",["556","557","558","559","560","561","562","563","564","565"],"import React, { useState, useEffect } from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\r\nimport TextField from \"@material-ui/core/TextField\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  site: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n});\r\n\r\nexport default function AddUser(props) {\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [page] = useState(1);\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  const [roles, setRoles] = useState([]);\r\n  const [dropdownRoles, setDropdownRoles] = useState([]);\r\n  const [selectedRole, setSelectedRole] = useState(\"\");\r\n  const [selectedRoleIndex, setSelectedRoleIndex] = useState(null);\r\n\r\n  const [siteParams, setSiteParams] = useState([]);\r\n\r\n  const [users, setUsers] = useState([]);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n  }, []);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_USER}/${adminStore.site.siteId._id}/${store.user._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.site_companies.companies);\r\n        setRoles(response.data.site_companies.companies);\r\n        setUsers(response.data.users);\r\n        if (response.data.site_companies != null) {\r\n          const companyTemp = [];\r\n\r\n          response.data.site_companies.companies.map((item, index) => {\r\n            return companyTemp.push({ label: item.name, value: item.name });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n        if (response.data.roles != null) {\r\n          const rolesTemp = [];\r\n\r\n          response.data.roles.map((item, index) => {\r\n            return rolesTemp.push({ label: item, value: item });\r\n          });\r\n          setDropdownRoles(rolesTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getUserCompany = async (userId) => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_USER_COMPANY}/${adminStore.site.siteId._id}/${userId}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        console.log(JSON.stringify(response, null, 2));\r\n        if (response.data) {\r\n          companies.forEach((item, index) => {\r\n            if (item._id === response.data._id) {\r\n              item.users.forEach((innerItem, innerIndex) => {\r\n                console.log(\"innser \", innerItem.userId);\r\n                if (innerItem.userId === userId) {\r\n                  setSelectedRoleIndex(innerIndex);\r\n\r\n                  setSelectedRole(innerItem.role);\r\n                }\r\n              });\r\n              setSelectedCompanyIndex(index);\r\n\r\n              setSelectedCompany(item.name);\r\n            }\r\n          });\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const onSubmit = async () => {\r\n    const values = formik.values;\r\n    const sites = [];\r\n    siteParams.forEach((item) => {\r\n      sites.push({ siteId: item.id, role: selectedRole });\r\n    });\r\n    var formdata = new FormData();\r\n    formdata.append(\"image\", values.logo[0].file);\r\n    //formdata.append(\"name\", values.name);\r\n    formdata.append(\"firstName\", values.firstName);\r\n    formdata.append(\"lastName\", values.lastName);\r\n    formdata.append(\"email\", values.email);\r\n    formdata.append(\"phone\", values.phone);\r\n    formdata.append(\"sites\", JSON.stringify(sites));\r\n    formdata.append(\"companyId\", companies[selectedCompanyIndex]._id);\r\n\r\n    await GLOBALS.API({\r\n      method: \"POST\",\r\n      uri: GLOBALS.Constants.ADD_USER_ADMIN,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      logo: [],\r\n      name: \"\",\r\n      color: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      site: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n    },\r\n    validationSchema: addClientYup,\r\n    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"ADD USER\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={formik.handleSubmit}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"CONTACT INFO* :\" />\r\n            <Form.Row width=\"48%\">\r\n              {/* <FormInput\r\n                name=\"name\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                placeholder=\"Adresse e-mail\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.name}\r\n                error={formik.errors.name}\r\n              /> */}\r\n              <Autocomplete\r\n                id=\"free-solo-demo\"\r\n                freeSolo\r\n                style={{\r\n                  ...GLOBALS.Styles.inputWidth,\r\n                  marginRight: \"10px\",\r\n                }}\r\n                onSelect={(event) => {\r\n                  users.forEach((item, index) => {\r\n                    if (item.userId.email === event.target.value) {\r\n                      console.log(JSON.stringify(item.sites, null, 2));\r\n                      formik.setFieldValue(\"firstName\", item.userId.firstName);\r\n                      formik.setFieldValue(\"lastName\", item.userId.lastName);\r\n                      formik.setFieldValue(\"phone\", item.userId.phone);\r\n                      formik.setFieldValue(\"logo\", [\r\n                        { uri: item.userId.image },\r\n                      ]);\r\n\r\n                      getUserCompany(item.userId._id);\r\n                    }\r\n                  });\r\n                }}\r\n                options={users.map((option) => {\r\n                  if (option.userId.email != undefined)\r\n                    return option.userId.email;\r\n                })}\r\n                renderInput={(params) => (\r\n                  <TextField\r\n                    {...params}\r\n                    label=\"Email\"\r\n                    margin=\"normal\"\r\n                    variant=\"outlined\"\r\n                    name=\"email\"\r\n                    value={formik.values.email}\r\n                    error={formik.errors.email}\r\n                    onChange={formik.handleChange}\r\n                  />\r\n                )}\r\n              />\r\n              <FormInput\r\n                name=\"phone\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                placeholder=\"Téléphone\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.phone}\r\n                error={formik.errors.phone}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"INDENTITY* :\" />\r\n            <Form.Row width=\"48%\">\r\n              <FormInput\r\n                name=\"firstName\"\r\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\r\n                placeholder=\"FIRST NAME\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.firstName}\r\n                error={formik.errors.firstName}\r\n              />\r\n              <FormInput\r\n                name=\"lastName\"\r\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\r\n                placeholder=\"LAST NAME\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.lastName}\r\n                error={formik.errors.name}\r\n              />\r\n              <FormMultipleUpload\r\n                name=\"logo\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                error={formik.errors.logo}\r\n                values={formik.values.logo}\r\n                onChange={(values) =>\r\n                  formik.handleChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"logo\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"COMPANY : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormSelect\r\n                placeholder=\"Company\"\r\n                values={dropdownCompanies}\r\n                value={selectedCompany}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedCompanyIndex(index);\r\n\r\n                    setSelectedCompany(item);\r\n                  } else {\r\n                    setSelectedCompanyIndex(null);\r\n\r\n                    setSelectedCompany(\"\");\r\n                  }\r\n                }}\r\n                style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"RÔLE : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormSelect\r\n                placeholder=\"RÔLE : \"\r\n                name=\"color\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={formik.handleChange}\r\n                value={formik.values.color}\r\n                error={formik.errors.color}\r\n                values={dropdownRoles}\r\n                value={selectedRole}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedRoleIndex(index);\r\n\r\n                    setSelectedRole(item);\r\n                  } else {\r\n                    setSelectedRoleIndex(null);\r\n\r\n                    setSelectedRole(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"CONSTRUCTION SITE : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormInput\r\n                name=\"site\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                placeholder=\"Site\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.site}\r\n                error={formik.errors.site}\r\n                disabled={true}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              minWidth={200}\r\n              text=\"CONTINUER\"\r\n              fullWidth={false}\r\n              onClick={() => {\r\n                onSubmit();\r\n              }}\r\n              loading={formik.isSubmitting}\r\n              disabled={formik.isSubmitting}\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Admins\\AddAdmin.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddZAC.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\UserList.js",["566","567"],"import React, { useState, useEffect } from \"react\";\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n// import * as Yup from \"yup\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Modal from \"../../../components/Modal\";\r\nimport SmallButton from \"../../../components/SmallButton\";\r\n\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport AvatarUpload from \"../../../components/AvatarUpload\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n}));\r\n\r\n// const updateAdminYup = Yup.object().shape({\r\n//   email: Yup.string().required(\"Required\"),\r\n//   phone: Yup.number()\r\n//     .test(\r\n//       \"len\",\r\n//       \"Must be exactly 10 characters\",\r\n//       (val) => val && val.toString().length === 10,\r\n//     )\r\n//     .required(\"Required\"),\r\n//   image: Yup.object().optional(\"\"),\r\n//   companyId: Yup.string().required(\"Required\"),\r\n// });\r\n\r\nexport default function UserList(props) {\r\n  const theme = useTheme();\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [page] = useState(1);\r\n  const [items, setItems] = useState([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const [companies, setCompanies] = useState([]);\r\n  const [open, setOpen] = useState(false);\r\n\r\n  const [selectedItem] = useState(\"\");\r\n\r\n  const [firstName, setFirstName] = useState(\"\");\r\n  const [lastName, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [image, setImage] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [companyName, setCompanyName] = useState(\"\");\r\n  const [users, setUsers] = useState([]);\r\n  useEffect(() => {\r\n    getData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_COMPANY_USERS}/${adminStore.site.siteId._id}/${props.location.id}`,\r\n        token: store.token,\r\n      });\r\n      //console.log(JSON.stringify(response.data[0].usersArray, null, 2));\r\n      if (response.success) {\r\n        setCompanyName(response.data[0].company.name);\r\n        setUsers(response.data[0].usersArray);\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n  const resendVerificaiontRequest = () => {};\r\n  const handleChange = (name, value) => {\r\n    if (name === \"firstName\") setFirstName(value);\r\n    else if (name === \"lastName\") setLastName(value);\r\n    else if (name === \"phone\") setPhone(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"companyId\") setCompanyId(value);\r\n  };\r\n\r\n  const onUpdate = async (e) => {\r\n    try {\r\n      e.preventDefault();\r\n      setLoading(true);\r\n      var formdata = new FormData();\r\n      formdata.append(\"firstName\", firstName);\r\n      formdata.append(\"lastName\", lastName);\r\n      formdata.append(\"phone\", phone);\r\n      formdata.append(\"companyId\", companyId);\r\n      formdata.append(\"userId\", selectedItem._id);\r\n      image.file && formdata.append(\"image\", image.file);\r\n\r\n      const result = await GLOBALS.API({\r\n        method: \"PUT\",\r\n        uri: GLOBALS.Constants.ADMINS,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      const itemsArray = items.map((item) =>\r\n        item._id === selectedItem._id ? result.data : item,\r\n      );\r\n      setItems(itemsArray);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n  const handleClickOpen = () => {\r\n    setOpen(true);\r\n  };\r\n  const rows = users.map((item) => {\r\n    console.log(JSON.stringify(item, null, 2));\r\n    const user = item;\r\n    return [\r\n      user.firstName + \" \" + user.lastName,\r\n      companyName,\r\n      item.role,\r\n      user.isVerified ? \"Inscrit\" : \"En attente\",\r\n      user.email,\r\n      <SmallButton\r\n        text={user.isVerified ? \"Edit\" : \"Re-Send\"}\r\n        onClick={user.isVerified ? handleClickOpen : resendVerificaiontRequest}\r\n        color={theme.palette.primary.contrastText}\r\n        to={\"/companies\"}\r\n        // component={NavLink}\r\n        style={{\r\n          marginLeft: 10,\r\n          borderRadius: 4,\r\n        }}\r\n      />,\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <>\r\n      <div className={classes.root}>\r\n        <Form.Row alignItems=\"center\" className=\"pr-3\">\r\n          <Heading primary=\"LIST OF USERS\" noWrap />\r\n          <div>\r\n            <Form.Row alignItems=\"center\" noMargin>\r\n              <SubHeading\r\n                disableMargin\r\n                primary={`Total : ${users.length} Users`}\r\n                bold\r\n              />\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"ADD A USER\"\r\n                style={{ marginLeft: \"20px\" }}\r\n                to={\"/companies/add-user\"}\r\n              />\r\n            </Form.Row>\r\n          </div>\r\n        </Form.Row>\r\n        {companies && \"\"}\r\n        <Form.Row noMargin>\r\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\r\n            <SearchInput placeholder=\"Name OF USER\" />\r\n            <FormSelect\r\n              placeholder=\"Company\"\r\n              name=\"color\"\r\n              style={{ marginLeft: \"20px\", maxWidth: 250 }}\r\n              values={[\r\n                { value: \"green\", label: \"Green\" },\r\n                { value: \"Yellow\", label: \"Yellow\" },\r\n                { value: \"Red\", label: \"Red\" },\r\n                { value: \"Blue\", label: \"Blue\" },\r\n                { value: \"Orange\", label: \"Orange\" },\r\n                { value: \"Purple\", label: \"Purple\" },\r\n                { value: \"Magenta\", label: \"Magenta\" },\r\n              ]}\r\n            />\r\n          </Form.Row>\r\n        </Form.Row>\r\n        <div className={classes.content}>\r\n          <Table headers={GLOBALS.Data.userList.headings} rows={rows} />\r\n        </div>\r\n      </div>\r\n      <Modal\r\n        title=\"THEIRRY MARLES\"\r\n        open={open}\r\n        onClose={() => setOpen(false)}\r\n        body={\r\n          <Form.Form onSubmit={onUpdate}>\r\n            <Form.Row justifyContent=\"center\">\r\n              <AvatarUpload\r\n                value={image}\r\n                // error={image}\r\n                onChange={(file) => {\r\n                  const uri = URL.createObjectURL(file);\r\n                  handleChange(\"image\", { file, uri });\r\n                }}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"thier@contrco.com\"\r\n                value={firstName}\r\n                // error={firstName}\r\n                placeholder=\"First Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"lastName\"\r\n                value={lastName}\r\n                // error={lastName}\r\n                placeholder=\"Last Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\"></Form.Row>\r\n            <Form.ButtonContainer>\r\n              <Button\r\n                type=\"submit\"\r\n                minWidth={200}\r\n                text=\"VALIDATE\"\r\n                fullWidth={false}\r\n                disabled={loading}\r\n              />\r\n            </Form.ButtonContainer>\r\n          </Form.Form>\r\n        }\r\n      />\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\EditCompanies.js",["568","569","570","571","572","573","574","575","576","577","578","579","580","581","582","583","584","585","586","587","588","589","590"],"import React, { useState, useEffect } from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport MultiAdderInput from \"../../../components/MultiAdderInput\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport { InputSharp } from \"@material-ui/icons\";\r\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\r\nimport TextField from \"@material-ui/core/TextField\";\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n  error: {\r\n    color: \"red\",\r\n  },\r\n  radioLabel: {\r\n    marginLeft: \"7px\",\r\n    color: \"#7E7878\",\r\n    marginRight: \"50px\",\r\n  },\r\n  radioBtn: {},\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  images: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function EditCompany(props) {\r\n  const dispatch = useDispatch();\r\n\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [name, setName] = useState(\"\");\r\n  const [nameError, setNameError] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [colorError, setColorError] = useState(\"\");\r\n  const [images, setImages] = useState([]);\r\n  const [companyType, setCompanyType] = useState(\"subcontractor\");\r\n  const [companyTypeError, setCompanyTypeError] = useState(\"\");\r\n  const [contract, setContract] = useState(\"\");\r\n  const [contractError, setContractError] = useState(\"\");\r\n  const [typeError, setTypeError] = useState(\"\");\r\n  const [update, setUpdate] = useState(false);\r\n  const [email, setEmail] = useState(\"\");\r\n  const [emailError, setEmailError] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [phoneError, setPhoneError] = useState(\"\");\r\n  const [fname, setFname] = useState(\"\");\r\n  const [lname, setLname] = useState(\"\");\r\n  const [website, setWebsite] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  const [trades, setTrades] = useState([]);\r\n  const [dropdownTrades, setDropdownTrades] = useState([]);\r\n  const [selectedTrade, setSelectedTrade] = useState(\"\");\r\n  const [listOfTrades, setListOfTrades] = useState([]);\r\n  const [fieldsEnabled, setFieldsEnabled] = useState(true);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n  }, []);\r\n  useEffect(() => {\r\n    getCompanyAutoFill();\r\n  }, [companyId]);\r\n  const getData = async () => {\r\n    setCompanyId(props.location.id);\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_COMPANY}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.site_companies);\r\n        setTrades(response.data.site_trades);\r\n        if (response.data.site_companies != null) {\r\n          const companyTemp = [];\r\n\r\n          response.data.site_companies.map((item, index) => {\r\n            return companyTemp.push({\r\n              label: item.companyId.name,\r\n              value: item.companyId.name,\r\n            });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n\r\n        if (response.data.site_trades != null) {\r\n          const tradesTemp = [];\r\n\r\n          response.data.site_trades.map((item, index) => {\r\n            return tradesTemp.push({\r\n              label: item,\r\n              value: item,\r\n            });\r\n          });\r\n          setDropdownTrades(tradesTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getCompanyAutoFill = async () => {\r\n    if (companyId.length === 0) return;\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_COMPANY_AUTOFILL}/${adminStore.site.siteId._id}/${companyId}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.site_companies.length != 0) {\r\n          const company = response.data.site_companies[0].companyId;\r\n          const trades = response.data.site_companies[0].trades;\r\n          formik.setFieldValue(\"email\", company.name);\r\n          setName(company.name);\r\n          if (company.incharge != undefined) {\r\n            const incharge = company.incharge;\r\n            setFname(incharge.firstName);\r\n            setLname(incharge.lastName);\r\n            setEmail(incharge.email);\r\n            setPhone(incharge.phone);\r\n          } else {\r\n            setFname(\"\");\r\n            setLname(\"\");\r\n            setEmail(\"\");\r\n            setPhone(\"\");\r\n          }\r\n          if (company.color != undefined) setColor(company.color);\r\n          if (company.website != undefined) setWebsite(company.website);\r\n          else setWebsite(\"\");\r\n          if (company.description != undefined) setAddInfo(company.description);\r\n          else setAddInfo(\"\");\r\n          if (trades != undefined) {\r\n            const tradesTemp = [];\r\n            trades.forEach((item, index) => {\r\n              tradesTemp.push({ key: item, label: item });\r\n            });\r\n            setListOfTrades(tradesTemp);\r\n          }\r\n        }\r\n        await getGeneralContractor();\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getGeneralContractor = async () => {\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_GENERAL_CONTRACTOR}/${adminStore.site.siteId._id}/${companyId}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.companies.length === 0) {\r\n          await setCompanyType(\"generalcontractor\");\r\n          setSelectedCompany(\"\");\r\n          setSelectedCompanyIndex(null);\r\n        } else {\r\n          await setCompanyType(\"subcontractor\");\r\n          const company = response.data.companies[0].companyId;\r\n          let companyIndex = null;\r\n          let companyValue = null;\r\n          companies.forEach((item, index) => {\r\n            if (item.companyId._id === company._id) {\r\n              companyIndex = index;\r\n              companyValue = item.companyId.name;\r\n            }\r\n          });\r\n          if (companyIndex != null && companyValue != null) {\r\n            setSelectedCompany(companyValue);\r\n            setSelectedCompanyIndex(companyIndex);\r\n          } else {\r\n            setSelectedCompany(\"\");\r\n            setSelectedCompanyIndex(null);\r\n          }\r\n        }\r\n        console.log(JSON.stringify(response, null, 2));\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  // const [startDate, setStartDate] = useState(\"\");\r\n  // const [startDateError, setStartDateError] = useState(\"\");\r\n  // const [isDateSelect, setIsDateSelect] = useState(\"\");\r\n  // const [endDate, setEndDate] = useState(\"\");\r\n  // const [endDateError, setEndDateError] = useState(\"\");\r\n  // const [available, setAvailable] = useState(\"VOIR LES INDISPONIBILITÉS\");\r\n  // const [techSheet, setTechSheet] = useState([]);\r\n  // const [rate, setRate] = useState(\"\");\r\n  // const [rateError, setRateError] = useState(\"\");\r\n\r\n  const onSubmit = async () => {\r\n    // const notificationTo = values.notificationTo.map((item) => item.label);\r\n    const values = formik.values;\r\n    const isSubContractor = companyType === \"subcontractor\";\r\n    let parentCompanyId = undefined;\r\n    if (\r\n      companies.length != 0 &&\r\n      isSubContractor &&\r\n      companies[selectedCompanyIndex].companyId != undefined\r\n    )\r\n      parentCompanyId = companies[selectedCompanyIndex].companyId._id;\r\n\r\n    const trades = [];\r\n\r\n    listOfTrades.forEach((item, index) => {\r\n      trades.push(item.label);\r\n    });\r\n\r\n    var formdata = new FormData();\r\n    //formdata.append(\"logo\", values.images[0].file);\r\n\r\n    formdata.append(\"name\", name);\r\n    formdata.append(\"color\", color);\r\n    formdata.append(\"website\", website);\r\n    formdata.append(\"description\", addInfo);\r\n    formdata.append(\"trades\", JSON.stringify(trades));\r\n    formdata.append(\"siteId\", adminStore.site.siteId._id);\r\n\r\n    if (isSubContractor) {\r\n      if (parentCompanyId === undefined)\r\n        alert(\"You need to select a general contractor\");\r\n      formdata.append(\"parentCompanyId\", parentCompanyId);\r\n    }\r\n    if (\r\n      fname.length !== 0 &&\r\n      lname.length !== 0 &&\r\n      email.length !== 0 &&\r\n      phone.length !== 0\r\n    ) {\r\n      const incharge = {\r\n        firstName: fname,\r\n        lastName: lname,\r\n        email: email,\r\n        phone: phone,\r\n      };\r\n      formdata.append(\"incharge\", JSON.stringify(incharge));\r\n    }\r\n\r\n    const response = await GLOBALS.API({\r\n      method: \"POST\",\r\n\r\n      uri: GLOBALS.Constants.CREATE_COMPANY,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    if (response.success) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(response.message, \"success\"),\r\n        ),\r\n      );\r\n    }\r\n\r\n    formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n\r\n  const inputChange = (e) => {\r\n    if (e.target.name === \"name\") {\r\n      setName(e.target.value);\r\n      if (e.target.name === \"\" || name === null) {\r\n        setNameError(true);\r\n      } else {\r\n        setNameError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"color\") {\r\n      setColor(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setColorError(true);\r\n      } else {\r\n        setColorError(false);\r\n      }\r\n    }\r\n\r\n    if (e.target.name === \"contract\") {\r\n      setContract(e.target.value);\r\n      if (\r\n        e.target.value === \"\" ||\r\n        e.target.value === null ||\r\n        e.target.value === undefined\r\n      ) {\r\n        setContractError(true);\r\n      } else {\r\n        setContractError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"email\") {\r\n      setEmail(e.target.value);\r\n      var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n      if (!e.target.value.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"phone\") {\r\n      setPhone(e.target.value);\r\n      if (e.target.value.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    }\r\n\r\n    if (e.target.name === \"images\") {\r\n      setImages(e.target.value);\r\n    }\r\n    if (e.target.name === \"trades\") {\r\n      setTrades(e.target.value);\r\n    }\r\n\r\n    if (e.target.name === \"addInfo\") {\r\n      setAddInfo(e.target.value);\r\n    }\r\n  };\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"trades\") {\r\n      if (value !== \"\") {\r\n        setUpdate((st) => !st);\r\n        setTrades(value);\r\n      }\r\n    }\r\n  };\r\n\r\n  const submitHandler = (e) => {\r\n    var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n    e.preventDefault();\r\n    if (name === \"\" || name === null) {\r\n      setNameError(true);\r\n    }\r\n    if (color === \"\" || color === null) {\r\n      setColorError(true);\r\n    }\r\n    if (\r\n      companyType === \"\" ||\r\n      companyType === null ||\r\n      companyType === undefined\r\n    ) {\r\n      setCompanyTypeError(true);\r\n    }\r\n    if (contract === \"\" || contract === null || contract === undefined) {\r\n      setContractError(true);\r\n    }\r\n    if (email !== \"\") {\r\n      if (!email.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (phone !== \"\") {\r\n      if (phone.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    } else {\r\n    }\r\n  };\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      images: [],\r\n      name: \"\",\r\n      color: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    validationSchema: addClientYup,\r\n    //    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"Edit A COMPANY\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <Autocomplete\r\n                  id=\"free-solo-demo\"\r\n                  freeSolo\r\n                  disabled={true}\r\n                  defaultValue={name}\r\n                  value={name}\r\n                  style={{\r\n                    ...GLOBALS.Styles.inputWidth,\r\n                    marginRight: \"10px\",\r\n                  }}\r\n                  onSelect={(event) => {\r\n                    let companyId = \"\";\r\n                    let logo = null;\r\n                    companies.forEach((item, index) => {\r\n                      if (item.companyId.name === event.target.value) {\r\n                        companyId = item.companyId._id;\r\n                        logo = item.companyId.logo;\r\n                        setName(item.companyId.name);\r\n                      }\r\n                    });\r\n\r\n                    //                  let fileClone = [{ uri: mean.image }];\r\n                    // setImage(fileClone);\r\n\r\n                    if (companyId.length != 0) {\r\n                      setCompanyId(companyId);\r\n                      setFieldsEnabled(false);\r\n                      formik.setFieldValue(\"images\", [{ uri: logo }]);\r\n                    }\r\n                  }}\r\n                  options={companies.map((option) => {\r\n                    if (option.companyId.name != undefined)\r\n                      return option.companyId.name;\r\n                  })}\r\n                  renderInput={(params) => (\r\n                    <TextField\r\n                      {...params}\r\n                      label=\"Name\"\r\n                      margin=\"normal\"\r\n                      variant=\"outlined\"\r\n                      defaultValue={name}\r\n                      name=\"name\"\r\n                      disabled={true}\r\n                      onChange={(event) => {\r\n                        console.log(event);\r\n                        setName(event.target.value);\r\n                        formik.setFieldValue(\"email\", event.target.value);\r\n                      }}\r\n                      value={formik.values.email}\r\n                      error={formik.errors.email}\r\n                    />\r\n                  )}\r\n                />\r\n                {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"color\"\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Color\"\r\n                  value={color}\r\n                />\r\n                {colorError && (\r\n                  <div className={classes.error}>Please enter color</div>\r\n                )}\r\n              </div>\r\n              <FormMultipleUpload\r\n                name=\"images\"\r\n                enabled={!fieldsEnabled}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={formik.values.images}\r\n                onChange={(values) =>\r\n                  inputChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"images\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n                // onChange={inputChange}\r\n                // onChange={(values) =>\r\n\r\n                //      ( {type: \"text\",\r\n                //       name: \"trades\",\r\n                //       value: values})\r\n\r\n                // }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF COMPANY* :\" />\r\n            <Form.Row width=\"55%\">\r\n              <RadioButton\r\n                name=\"contractType\"\r\n                value={companyType}\r\n                // error={contractType}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  setCompanyType(value)\r\n                }\r\n                items={[\r\n                  {\r\n                    value: \"generalcontractor\",\r\n                    label: \"General Contractor\",\r\n                  },\r\n                  { value: \"subcontractor\", label: \"Subcontractor\" },\r\n                ]}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"GENERAL CONTRACTOR : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"100%\", height: \"100%\" }}>\r\n                <FormSelect\r\n                  placeholder=\"Company\"\r\n                  values={dropdownCompanies}\r\n                  value={selectedCompany}\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  onChange={(event) => {\r\n                    const index = event.target.selectedIndex - 1;\r\n\r\n                    if (index !== -1) {\r\n                      const item = event.target.value;\r\n\r\n                      setSelectedCompanyIndex(index);\r\n\r\n                      setSelectedCompany(item);\r\n                    } else {\r\n                      setSelectedCompanyIndex(null);\r\n\r\n                      setSelectedCompany(\"\");\r\n                    }\r\n                  }}\r\n                  style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n                />\r\n                {/* <select\r\n                  name=\"contract\"\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  id=\"contract\"\r\n                  type={contract}\r\n                  style={{\r\n                    width: \"40%\",\r\n                    height: \"45px\",\r\n                    color: \"#8B8989\",\r\n                    padding: \"0px 10px\",\r\n                  }}\r\n                  onChange={inputChange}\r\n                >\r\n                \r\n                </select> */}\r\n                {contractError === true && (\r\n                  <div className={classes.error}>Please select contract</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TRADES : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <CustomInputModal\r\n                name=\"trades\"\r\n                values={dropdownTrades}\r\n                value={selectedTrade}\r\n                placeholder=\"Select Trades\"\r\n                chipDefaultValues={listOfTrades}\r\n                chipValues={(values) => {\r\n                  const valuesTemp = [];\r\n                  values.forEach((item, index) => {\r\n                    valuesTemp.push(item);\r\n                  });\r\n                  setListOfTrades(valuesTemp);\r\n\r\n                  // setSiteParams(values);\r\n                }}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedTrade(item);\r\n                  } else {\r\n                    setSelectedTrade(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDEMTITY OF RESPONSIBLE* : \" />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"email\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Adresse e-mail\"\r\n                  onChange={inputChange}\r\n                  value={email}\r\n                />\r\n                {emailError === true && (\r\n                  <div className={classes.error}>Please enter valid email</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"phone\"\r\n                  type=\"number\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Téléphone\"\r\n                  onChange={inputChange}\r\n                  value={phone}\r\n                />\r\n                {phoneError === true && (\r\n                  <div className={classes.error}>\r\n                    Telephone should be 10 digits\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"fname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"First Name\"\r\n                  onChange={(e) => setFname(e.target.value)}\r\n                  value={fname}\r\n                />\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"lname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Last Name\"\r\n                  onChange={(e) => setLname(e.target.value)}\r\n                  value={lname}\r\n                />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"Website : \" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                name=\"website\"\r\n                style={{ width: \"50%\" }}\r\n                placeholder=\"http://\"\r\n                onChange={(e) => setWebsite(e.target.value)}\r\n                value={website}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                style={{ width: \"90%\" }}\r\n                onChange={(e) => setAddInfo(e.target.value)}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              onClick={() => {\r\n                onSubmit();\r\n              }}\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              disabled={name === \"\" || color === \"\" || companyType === \"\"}\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\AddCompanies.js",["591","592","593","594","595","596","597","598","599","600","601","602","603","604","605","606","607"],"import React, { useState, useEffect } from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\r\nimport TextField from \"@material-ui/core/TextField\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n  error: {\r\n    color: \"red\",\r\n  },\r\n  radioLabel: {\r\n    marginLeft: \"7px\",\r\n    color: \"#7E7878\",\r\n    marginRight: \"50px\",\r\n  },\r\n  radioBtn: {},\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  images: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function AddCompanies(props) {\r\n  const dispatch = useDispatch();\r\n\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [name, setName] = useState(\"\");\r\n  const [nameError, setNameError] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [colorError, setColorError] = useState(\"\");\r\n  const [images, setImages] = useState([]);\r\n  const [companyType, setCompanyType] = useState(\"subcontractor\");\r\n  const [companyTypeError, setCompanyTypeError] = useState(\"\");\r\n  const [contract, setContract] = useState(\"\");\r\n  const [contractError, setContractError] = useState(\"\");\r\n  const [update, setUpdate] = useState(false);\r\n  const [email, setEmail] = useState(\"\");\r\n  const [emailError, setEmailError] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [phoneError, setPhoneError] = useState(\"\");\r\n  const [fname, setFname] = useState(\"\");\r\n  const [lname, setLname] = useState(\"\");\r\n  const [website, setWebsite] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  const [trades, setTrades] = useState([]);\r\n  const [dropdownTrades, setDropdownTrades] = useState([]);\r\n  const [selectedTrade, setSelectedTrade] = useState(\"\");\r\n  const [listOfTrades, setListOfTrades] = useState([]);\r\n  const [fieldsEnabled, setFieldsEnabled] = useState(true);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    getCompanyAutoFill();\r\n  }, [companyId]);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_COMPANY}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        console.log(\"Response\", JSON.stringify(response, null, 2));\r\n        setCompanies(response.data.site_companies);\r\n        setTrades(response.data.site_trades);\r\n        if (response.data.site_companies != null) {\r\n          const companyTemp = [];\r\n\r\n          response.data.site_companies.map((item, index) => {\r\n            return companyTemp.push({\r\n              label: item.companyId.name,\r\n              value: item.companyId.name,\r\n            });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n\r\n        if (response.data.site_trades != null) {\r\n          const tradesTemp = [];\r\n\r\n          response.data.site_trades.map((item, index) => {\r\n            return tradesTemp.push({\r\n              label: item,\r\n              value: item,\r\n            });\r\n          });\r\n          setDropdownTrades(tradesTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getCompanyAutoFill = async () => {\r\n    if (companyId.length === 0) return;\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_COMPANY_AUTOFILL}/${adminStore.site.siteId._id}/${companyId}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.site_companies.length != 0) {\r\n          const company = response.data.site_companies[0].companyId;\r\n          const trades = response.data.site_companies[0].trades;\r\n          if (company.incharge != undefined) {\r\n            const incharge = company.incharge;\r\n            setFname(incharge.firstName);\r\n            setLname(incharge.lastName);\r\n            setEmail(incharge.email);\r\n            setPhone(incharge.phone);\r\n          } else {\r\n            setFname(\"\");\r\n            setLname(\"\");\r\n            setEmail(\"\");\r\n            setPhone(\"\");\r\n          }\r\n          if (company.color != undefined) setColor(company.color);\r\n          if (company.website != undefined) setWebsite(company.website);\r\n          else setWebsite(\"\");\r\n          if (company.description != undefined) setAddInfo(company.description);\r\n          else setAddInfo(\"\");\r\n          if (trades != undefined) {\r\n            const tradesTemp = [];\r\n            trades.forEach((item, index) => {\r\n              tradesTemp.push({ key: item, label: item });\r\n            });\r\n            setListOfTrades(tradesTemp);\r\n          }\r\n        }\r\n        await getGeneralContractor();\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getGeneralContractor = async () => {\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_GENERAL_CONTRACTOR}/${adminStore.site.siteId._id}/${companyId}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.companies.length === 0) {\r\n          await setCompanyType(\"generalcontractor\");\r\n\r\n          setSelectedCompany(\"\");\r\n          setSelectedCompanyIndex(null);\r\n        } else {\r\n          await setCompanyType(\"subcontractor\");\r\n\r\n          const company = response.data.companies[0].companyId;\r\n          let companyIndex = null;\r\n          let companyValue = null;\r\n          companies.forEach((item, index) => {\r\n            if (item.companyId._id === company._id) {\r\n              companyIndex = index;\r\n              companyValue = item.companyId.name;\r\n            }\r\n          });\r\n          if (companyIndex != null && companyValue != null) {\r\n            setSelectedCompany(companyValue);\r\n            setSelectedCompanyIndex(companyIndex);\r\n          } else {\r\n            setSelectedCompany(\"\");\r\n            setSelectedCompanyIndex(null);\r\n          }\r\n        }\r\n        console.log(JSON.stringify(response, null, 2));\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  // const [startDate, setStartDate] = useState(\"\");\r\n  // const [startDateError, setStartDateError] = useState(\"\");\r\n  // const [isDateSelect, setIsDateSelect] = useState(\"\");\r\n  // const [endDate, setEndDate] = useState(\"\");\r\n  // const [endDateError, setEndDateError] = useState(\"\");\r\n  // const [available, setAvailable] = useState(\"VOIR LES INDISPONIBILITÉS\");\r\n  // const [techSheet, setTechSheet] = useState([]);\r\n  // const [rate, setRate] = useState(\"\");\r\n  // const [rateError, setRateError] = useState(\"\");\r\n\r\n  const onSubmit = async () => {\r\n    // const notificationTo = values.notificationTo.map((item) => item.label);\r\n    const values = formik.values;\r\n    const isSubContractor = companyType === \"subcontractor\";\r\n    let parentCompanyId = undefined;\r\n    if (\r\n      companies.length != 0 &&\r\n      isSubContractor &&\r\n      companies[selectedCompanyIndex].companyId != undefined\r\n    )\r\n      parentCompanyId = companies[selectedCompanyIndex].companyId._id;\r\n\r\n    const trades = [];\r\n\r\n    listOfTrades.forEach((item, index) => {\r\n      trades.push(item.label);\r\n    });\r\n\r\n    var formdata = new FormData();\r\n    formdata.append(\"logo\", values.images[0].file);\r\n\r\n    formdata.append(\"name\", name);\r\n    formdata.append(\"color\", color);\r\n    formdata.append(\"website\", website);\r\n    formdata.append(\"description\", addInfo);\r\n    formdata.append(\"trades\", JSON.stringify(trades));\r\n    formdata.append(\"siteId\", adminStore.site.siteId._id);\r\n\r\n    if (isSubContractor) {\r\n      if (parentCompanyId === undefined)\r\n        alert(\"You need to select a general contractor\");\r\n      formdata.append(\"parentCompanyId\", parentCompanyId);\r\n    }\r\n    if (\r\n      fname.length !== 0 &&\r\n      lname.length !== 0 &&\r\n      email.length !== 0 &&\r\n      phone.length !== 0\r\n    ) {\r\n      const incharge = {\r\n        firstName: fname,\r\n        lastName: lname,\r\n        email: email,\r\n        phone: phone,\r\n      };\r\n      formdata.append(\"incharge\", JSON.stringify(incharge));\r\n    }\r\n\r\n    const response = await GLOBALS.API({\r\n      method: \"POST\",\r\n\r\n      uri: GLOBALS.Constants.CREATE_COMPANY,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    if (response.success) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(response.message, \"success\"),\r\n        ),\r\n      );\r\n    }\r\n\r\n    formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n\r\n  const inputChange = (e) => {\r\n    if (e.target.name === \"name\") {\r\n      setName(e.target.value);\r\n      if (e.target.name === \"\" || name === null) {\r\n        setNameError(true);\r\n      } else {\r\n        setNameError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"color\") {\r\n      setColor(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setColorError(true);\r\n      } else {\r\n        setColorError(false);\r\n      }\r\n    }\r\n\r\n    if (e.target.name === \"contract\") {\r\n      setContract(e.target.value);\r\n      if (\r\n        e.target.value === \"\" ||\r\n        e.target.value === null ||\r\n        e.target.value === undefined\r\n      ) {\r\n        setContractError(true);\r\n      } else {\r\n        setContractError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"email\") {\r\n      setEmail(e.target.value);\r\n      var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n      if (!e.target.value.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"phone\") {\r\n      setPhone(e.target.value);\r\n      if (e.target.value.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    }\r\n\r\n    if (e.target.name === \"images\") {\r\n      setImages(e.target.value);\r\n    }\r\n    if (e.target.name === \"trades\") {\r\n      setTrades(e.target.value);\r\n    }\r\n\r\n    if (e.target.name === \"addInfo\") {\r\n      setAddInfo(e.target.value);\r\n    }\r\n  };\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"trades\") {\r\n      if (value !== \"\") {\r\n        setUpdate((st) => !st);\r\n        setTrades(value);\r\n      }\r\n    }\r\n  };\r\n\r\n  const submitHandler = (e) => {\r\n    var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n    e.preventDefault();\r\n    if (name === \"\" || name === null) {\r\n      setNameError(true);\r\n    }\r\n    if (color === \"\" || color === null) {\r\n      setColorError(true);\r\n    }\r\n    if (\r\n      companyType === \"\" ||\r\n      companyType === null ||\r\n      companyType === undefined\r\n    ) {\r\n      setCompanyTypeError(true);\r\n    }\r\n    if (contract === \"\" || contract === null || contract === undefined) {\r\n      setContractError(true);\r\n    }\r\n    if (email !== \"\") {\r\n      if (!email.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (phone !== \"\") {\r\n      if (phone.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    } else {\r\n    }\r\n  };\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      images: [],\r\n      name: \"\",\r\n      color: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    validationSchema: addClientYup,\r\n    //    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"ADD A COMPANY\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <Autocomplete\r\n                  id=\"free-solo-demo\"\r\n                  freeSolo\r\n                  disabled={!fieldsEnabled}\r\n                  style={{\r\n                    ...GLOBALS.Styles.inputWidth,\r\n                    marginRight: \"10px\",\r\n                  }}\r\n                  onSelect={(event) => {\r\n                    let companyId = \"\";\r\n                    let logo = null;\r\n                    companies.forEach((item, index) => {\r\n                      if (item.companyId.name === event.target.value) {\r\n                        companyId = item.companyId._id;\r\n                        logo = item.companyId.logo;\r\n                        setName(item.companyId.name);\r\n                      }\r\n                    });\r\n\r\n                    //                  let fileClone = [{ uri: mean.image }];\r\n                    // setImage(fileClone);\r\n\r\n                    if (companyId.length != 0) {\r\n                      setCompanyId(companyId);\r\n                      setFieldsEnabled(false);\r\n                      formik.setFieldValue(\"images\", [{ uri: logo }]);\r\n                    }\r\n                  }}\r\n                  options={companies.map((option) => {\r\n                    if (option.companyId.name != undefined)\r\n                      return option.companyId.name;\r\n                  })}\r\n                  renderInput={(params) => (\r\n                    <TextField\r\n                      {...params}\r\n                      label=\"Name\"\r\n                      margin=\"normal\"\r\n                      variant=\"outlined\"\r\n                      name=\"name\"\r\n                      disabled={!fieldsEnabled}\r\n                      onChange={(event) => {\r\n                        console.log(event);\r\n                        setName(event.target.value);\r\n                        formik.setFieldValue(\"email\", event.target.value);\r\n                      }}\r\n                      value={formik.values.email}\r\n                      error={formik.errors.email}\r\n                    />\r\n                  )}\r\n                />\r\n                {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"color\"\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Color\"\r\n                  value={color}\r\n                />\r\n                {colorError && (\r\n                  <div className={classes.error}>Please enter color</div>\r\n                )}\r\n              </div>\r\n              <FormMultipleUpload\r\n                name=\"images\"\r\n                enabled={!fieldsEnabled}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={formik.values.images}\r\n                onChange={(values) =>\r\n                  inputChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"images\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n                // onChange={inputChange}\r\n                // onChange={(values) =>\r\n\r\n                //      ( {type: \"text\",\r\n                //       name: \"trades\",\r\n                //       value: values})\r\n\r\n                // }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF COMPANY* :\" />\r\n            <Form.Row width=\"55%\">\r\n              <RadioButton\r\n                name=\"contractType\"\r\n                value={companyType}\r\n                // error={contractType}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  setCompanyType(value)\r\n                }\r\n                items={[\r\n                  {\r\n                    value: \"generalcontractor\",\r\n                    label: \"General Contractor\",\r\n                  },\r\n                  { value: \"subcontractor\", label: \"Subcontractor\" },\r\n                ]}\r\n              />\r\n\r\n              {/* <input\r\n                    className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    onChange={(e) => {\r\n                      setCompanyType(\"generalcontractor\");\r\n                    }}\r\n                    id=\"generalcontractor\"\r\n                    name=\"companyType\"\r\n                    value={companyType}\r\n                  />\r\n                  <label for=\"generalcontractor\" className={classes.radioLabel}>\r\n                    General Contractor\r\n                  </label>\r\n                  <input\r\n                    className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"subcontractor\"\r\n                    name=\"companyType\"\r\n                    onChange={(e) => {\r\n                      setCompanyType(\"subcontractor\");\r\n                    }}\r\n                    value={companyType}\r\n                    defaultChecked\r\n                  />\r\n                  <label for=\"subcontractor\" className={classes.radioLabel}>\r\n                    Sub contractor\r\n                  </label> */}\r\n              {companyTypeError === true && (\r\n                <div className={classes.error}>Please select company</div>\r\n              )}\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"GENERAL CONTRACTOR : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"100%\", height: \"100%\" }}>\r\n                <FormSelect\r\n                  placeholder=\"Company\"\r\n                  values={dropdownCompanies}\r\n                  value={selectedCompany}\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  onChange={(event) => {\r\n                    const index = event.target.selectedIndex - 1;\r\n\r\n                    if (index !== -1) {\r\n                      const item = event.target.value;\r\n\r\n                      setSelectedCompanyIndex(index);\r\n\r\n                      setSelectedCompany(item);\r\n                    } else {\r\n                      setSelectedCompanyIndex(null);\r\n\r\n                      setSelectedCompany(\"\");\r\n                    }\r\n                  }}\r\n                  style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n                />\r\n                {/* <select\r\n                  name=\"contract\"\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  id=\"contract\"\r\n                  type={contract}\r\n                  style={{\r\n                    width: \"40%\",\r\n                    height: \"45px\",\r\n                    color: \"#8B8989\",\r\n                    padding: \"0px 10px\",\r\n                  }}\r\n                  onChange={inputChange}\r\n                >\r\n                \r\n                </select> */}\r\n                {contractError === true && (\r\n                  <div className={classes.error}>Please select contract</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TRADES : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <CustomInputModal\r\n                name=\"trades\"\r\n                values={dropdownTrades}\r\n                value={selectedTrade}\r\n                placeholder=\"Select Trades\"\r\n                chipDefaultValues={listOfTrades}\r\n                chipValues={(values) => {\r\n                  const valuesTemp = [];\r\n                  values.forEach((item, index) => {\r\n                    valuesTemp.push(item);\r\n                  });\r\n                  setListOfTrades(valuesTemp);\r\n\r\n                  // setSiteParams(values);\r\n                }}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedTrade(item);\r\n                  } else {\r\n                    setSelectedTrade(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDEMTITY OF RESPONSIBLE* : \" />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"email\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Adresse e-mail\"\r\n                  onChange={inputChange}\r\n                  value={email}\r\n                />\r\n                {emailError === true && (\r\n                  <div className={classes.error}>Please enter valid email</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"phone\"\r\n                  type=\"number\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Téléphone\"\r\n                  onChange={inputChange}\r\n                  value={phone}\r\n                />\r\n                {phoneError === true && (\r\n                  <div className={classes.error}>\r\n                    Telephone should be 10 digits\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"fname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"First Name\"\r\n                  onChange={(e) => setFname(e.target.value)}\r\n                  value={fname}\r\n                />\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"lname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Last Name\"\r\n                  onChange={(e) => setLname(e.target.value)}\r\n                  value={lname}\r\n                />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"Website : \" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                name=\"website\"\r\n                style={{ width: \"50%\" }}\r\n                placeholder=\"http://\"\r\n                onChange={(e) => setWebsite(e.target.value)}\r\n                value={website}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                style={{ width: \"90%\" }}\r\n                onChange={(e) => setAddInfo(e.target.value)}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              onClick={() => {\r\n                onSubmit();\r\n              }}\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              disabled={name === \"\" || color === \"\" || companyType === \"\"}\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\Companies.js",["608","609","610","611","612"],"import React, { useState, useEffect } from \"react\";\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n// import * as Yup from \"yup\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Modal from \"../../../components/Modal\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport AvatarUpload from \"../../../components/AvatarUpload\";\r\nimport uploadIcon from \"../../../assets/images/upload.png\";\r\nimport { Images } from \"../../../assets/Assets\";\r\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n}));\r\n\r\n// const updateAdminYup = Yup.object().shape({\r\n//   email: Yup.string().required(\"Required\"),\r\n//   phone: Yup.number()\r\n//     .test(\r\n//       \"len\",\r\n//       \"Must be exactly 10 characters\",\r\n//       (val) => val && val.toString().length === 10,\r\n//     )\r\n//     .required(\"Required\"),\r\n//   image: Yup.object().optional(\"\"),\r\n//   companyId: Yup.string().required(\"Required\"),\r\n// });\r\n\r\nexport default function Companies(props) {\r\n  const theme = useTheme();\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n\r\n  const [page] = useState(1);\r\n  const [items, setItems] = useState([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const [companies, setCompanies] = useState([]);\r\n  const [modal, setModal] = useState(false);\r\n  const [selectedItem] = useState(\"\");\r\n  const [firstName, setFirstName] = useState(\"\");\r\n  const [lastName, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [image, setImage] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [nameOfResponsible, setNameOfResponsible] = useState(\"\");\r\n  const [nameOfCompany, setNameOfCompany] = useState(\"\");\r\n\r\n  useEffect(() => {\r\n    getData();\r\n\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      console.log(adminStore.site.siteId._id);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_SITE_COMPANIES}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.companies);\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n  const handleChange = (name, value) => {\r\n    if (name === \"firstName\") setFirstName(value);\r\n    else if (name === \"lastName\") setLastName(value);\r\n    else if (name === \"phone\") setPhone(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"companyId\") setCompanyId(value);\r\n  };\r\n\r\n  const onUpdate = async (e) => {\r\n    try {\r\n      e.preventDefault();\r\n      setLoading(true);\r\n      var formdata = new FormData();\r\n      formdata.append(\"firstName\", firstName);\r\n      formdata.append(\"lastName\", lastName);\r\n      formdata.append(\"phone\", phone);\r\n      formdata.append(\"companyId\", companyId);\r\n      formdata.append(\"userId\", selectedItem._id);\r\n      image.file && formdata.append(\"image\", image.file);\r\n\r\n      const result = await GLOBALS.API({\r\n        method: \"PUT\",\r\n        uri: GLOBALS.Constants.ADMINS,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      const itemsArray = items.map((item) =>\r\n        item._id === selectedItem._id ? result.data : item,\r\n      );\r\n      setItems(itemsArray);\r\n      setLoading(false);\r\n      setModal(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getSubContractors = (subcontractors) => {\r\n    if (subcontractors && subcontractors.length > 0) {\r\n      const value = subcontractors\r\n        .map((item, index) => {\r\n          if (item.name != undefined) return item.name;\r\n          return \"N/A\";\r\n        })\r\n        .toString()\r\n        .replace(/,/g, \" \");\r\n      return value;\r\n    }\r\n    return \"N/A\";\r\n  };\r\n\r\n  const filterCompany = async () => {\r\n    try {\r\n      setLoading(true);\r\n      const params = { siteId: \"6008169bedbb7816d40b197d\" };\r\n      if (nameOfCompany.length !== 0) params[\"companyName\"] = nameOfCompany;\r\n      if (nameOfResponsible.length !== 0)\r\n        params[\"responsibleName\"] = nameOfResponsible;\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.FILTER_COMPANY_SITES}`,\r\n        token: store.token,\r\n        method: \"POST\",\r\n        body: JSON.stringify(params),\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.companies);\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const rows = companies.map((item) => {\r\n    return [\r\n      <img src={Images.site} alt=\"Icon\" />,\r\n      item.companyId.name,\r\n      getSubContractors(item.subContractors),\r\n      item.companyId.incharge != undefined\r\n        ? item.companyId.incharge.firstName +\r\n          \" \" +\r\n          item.companyId.incharge.lastName\r\n        : \"N/A\",\r\n      item.companyId.incharge != undefined\r\n        ? item.companyId.incharge.phone\r\n        : \"N/A\",\r\n      item.companyId.incharge != undefined\r\n        ? item.companyId.incharge.email\r\n        : \"N/A\",\r\n\r\n      <div>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <NavLink\r\n            to={{\r\n              pathname: \"/companies/user-list\",\r\n              id: item.companyId._id,\r\n            }}\r\n          >\r\n            <img\r\n              src={Images.comapnies}\r\n              style={{ width: 18, height: 17 }}\r\n              alt=\"Icon\"\r\n            />\r\n          </NavLink>\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <NavLink\r\n            to={{\r\n              pathname: \"/companies/edit-companies\",\r\n              id: item.companyId._id,\r\n            }}\r\n          >\r\n            <Pencil style={{ width: 18, height: 15 }} />\r\n          </NavLink>\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <img\r\n            src={Images.calender}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <img\r\n            src={Images.invoices}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <img\r\n            src={Images.incidents}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </IconButton>\r\n      </div>,\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <>\r\n      <div className={classes.root}>\r\n        <Form.Row alignItems=\"center\" className=\"pr-3\">\r\n          <Heading primary=\"LIST OF COMPANIES\" noWrap />\r\n          <div>\r\n            <Form.Row alignItems=\"center\" noMargin>\r\n              <SubHeading\r\n                disableMargin\r\n                primary={`Total : ${companies.length} COMPANIES`}\r\n                bold\r\n              />\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"ADD A COMPANY\"\r\n                style={{ marginLeft: \"20px\" }}\r\n                to={\"/companies/add-companies\"}\r\n              />\r\n            </Form.Row>\r\n          </div>\r\n        </Form.Row>\r\n        <Form.Row noMargin className=\"pr-3\">\r\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\r\n            <SearchInput\r\n              placeholder=\"Name of responsible\"\r\n              value={nameOfResponsible}\r\n              onClick={() => {\r\n                filterCompany();\r\n              }}\r\n              onChange={(event) => {\r\n                setNameOfResponsible(event.target.value);\r\n              }}\r\n            />\r\n            <SearchInput\r\n              style={{ marginLeft: \"20px\" }}\r\n              placeholder=\"Name of company\"\r\n              value={nameOfCompany}\r\n              onClick={() => {\r\n                filterCompany();\r\n              }}\r\n              onChange={(event) => {\r\n                setNameOfCompany(event.target.value);\r\n              }}\r\n            />\r\n            <a href=\"#companies\">\r\n              <img\r\n                style={{\r\n                  width: \"1.3rem\",\r\n                  marginLeft: \"20px\",\r\n                  marginTop: \"10px\",\r\n                }}\r\n                src={uploadIcon}\r\n                alt=\"File Upload Icon\"\r\n              />\r\n            </a>\r\n          </Form.Row>\r\n          <Button\r\n            fullWidth={true}\r\n            component={NavLink}\r\n            text=\"ACCESS REQUEST TO ZONES\"\r\n            style={{ width: \"330px\" }}\r\n            to={\"/admins/add-admin\"}\r\n          />\r\n        </Form.Row>\r\n        <div className={classes.content}>\r\n          <Table headers={GLOBALS.Data.companies.headings} rows={rows} />\r\n        </div>\r\n      </div>\r\n      <Modal\r\n        title=\"EDIT ADMIN\"\r\n        open={selectedItem ? modal : false}\r\n        onClose={() => setModal((st) => !st)}\r\n        body={\r\n          <Form.Form onSubmit={onUpdate}>\r\n            <Form.Row justifyContent=\"center\">\r\n              <AvatarUpload\r\n                value={image}\r\n                // error={image}\r\n                onChange={(file) => {\r\n                  const uri = URL.createObjectURL(file);\r\n                  handleChange(\"image\", { file, uri });\r\n                }}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"firstName\"\r\n                value={firstName}\r\n                // error={firstName}\r\n                placeholder=\"First Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"lastName\"\r\n                value={lastName}\r\n                // error={lastName}\r\n                placeholder=\"Last Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"phone\"\r\n                placeholder=\"Phone Number\"\r\n                value={phone}\r\n                // error={phone}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                style={GLOBALS.Styles.inputWidth}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormSelect\r\n                name=\"companyId\"\r\n                value={companyId}\r\n                // error={companyId}\r\n                values={companies}\r\n                placeholder=\"Company Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Column alignItems=\"center\">\r\n              <Form.Row justifyContent=\"center\">\r\n                <Button\r\n                  type=\"submit\"\r\n                  minWidth={200}\r\n                  text=\"VALIDATE\"\r\n                  fullWidth={false}\r\n                  loading={loading}\r\n                  disabled={\r\n                    loading ||\r\n                    !firstName ||\r\n                    !lastName ||\r\n                    !phone ||\r\n                    image === \"\" ||\r\n                    !companyId\r\n                  }\r\n                />\r\n              </Form.Row>\r\n              <Form.Row justifyContent=\"center\">\r\n                <Button\r\n                  text=\"DELETE\"\r\n                  minWidth=\"30%\"\r\n                  fullWidth={false}\r\n                  disabled={loading || true}\r\n                  color={theme.palette.error.main}\r\n                />\r\n              </Form.Row>\r\n            </Form.Column>\r\n          </Form.Form>\r\n        }\r\n      />\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Pic\\Pic.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Organigramme\\EditContact.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Organigramme\\AddContact.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Organigramme\\Organigramme.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\globals\\Styles.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\globals\\API.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\globals\\Constants.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\FormSelect.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\SearchInput.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\index.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\index.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\index.js",["613","614","615","616","617","618","619","620","621","622","623","624","625"],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\popoverModal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\MyWorkWeek.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Pagination.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Table.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\ColorPcker.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\CustomInputModal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\CustomInputModalSingleSelect.js",["626","627"],"import React, { useState, useEffect } from \"react\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n// import * as Yup from \"yup\";\r\nimport Grid from \"@material-ui/core/Grid\";\r\nimport Chip from \"@material-ui/core/Chip\";\r\nimport { useFormik } from \"formik\";\r\nimport GLOBALS from \"../globals\";\r\nimport FormSelect from \"../components/FormSelect\";\r\n\r\nimport Form from \"./Form\";\r\nimport Modal from \"./Modal\";\r\nimport Button from \"./Button\";\r\nimport { ReactComponent as Plus } from \"../assets/icons/Plus.svg\";\r\n\r\n// const addAddressesYup = Yup.object().shape({\r\n//   street: Yup.string().required(\"Required\"),\r\n//   city: Yup.string().required(\"Required\"),\r\n//   postal: Yup.string().required(\"Required\"),\r\n// });\r\n\r\nexport default function CustomInputModalSingleSelect(props) {\r\n  useEffect(() => {\r\n    if (props.chipDefaultValues !== undefined)\r\n      setChipValues(props.chipDefaultValues);\r\n\r\n    // eslint-disable-next-line\r\n  });\r\n\r\n  const theme = useTheme();\r\n\r\n  const error = theme.palette.error.main;\r\n  const white = theme.palette.common.white;\r\n  const primaryColor = theme.palette.primary.contrastText;\r\n  const borderColor = props.error ? error : theme.palette.grey[100];\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      logo: [],\r\n      name: \"\",\r\n      storage: \"\",\r\n      deliveryAreas: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n\r\n    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n\r\n  const useStyles = makeStyles((theme) => ({\r\n    root: {\r\n      position: \"relative\",\r\n    },\r\n    container: {\r\n      width: 45,\r\n      height: 45,\r\n      outline: 0,\r\n      borderWidth: 1,\r\n      display: \"grid\",\r\n      cursor: \"pointer\",\r\n      borderStyle: \"solid\",\r\n      placeItems: \"center\",\r\n      backgroundColor: white,\r\n      borderColor: borderColor,\r\n    },\r\n    chips: {\r\n      margin: 0,\r\n      marginTop: 15,\r\n      display: \"flex\",\r\n      flexWrap: \"wrap\",\r\n      listStyle: \"none\",\r\n      justifyContent: \"center\",\r\n    },\r\n    chip: {\r\n      color: primaryColor,\r\n      margin: theme.spacing(0.5),\r\n    },\r\n    error: {\r\n      color: error,\r\n      fontWeight: 400,\r\n      position: \"absolute\",\r\n      fontSize: theme.typography.pxToRem(12),\r\n    },\r\n  }));\r\n\r\n  const classes = useStyles();\r\n  const [modal, setModal] = useState(false);\r\n  const [update] = useState(false);\r\n\r\n  // const [street, setStreet] = useState(\"\");\r\n  // const [city, setCity] = useState(\"\");\r\n  // const [postal, setPostal] = useState(\"\");\r\n  const [chipValues, setChipValues] = useState([]);\r\n\r\n  async function onSubmit() {\r\n    let value = props.value;\r\n    let id = props.id;\r\n\r\n    let valuesTemp = [...chipValues];\r\n    if (valuesTemp) {\r\n      const values = {\r\n        key: value.length + Date.now().toString(),\r\n        label: value,\r\n        id: id != undefined ? id : Date.now().toString(),\r\n      };\r\n      valuesTemp.push(values);\r\n      setChipValues(valuesTemp);\r\n      if (props.chipValues !== undefined) props.chipValues(valuesTemp);\r\n    }\r\n\r\n    setModal(false);\r\n  }\r\n\r\n  const handleDelete = (value) => () => {\r\n    const newValues = chipValues.filter((chip) => chip.key !== value.key);\r\n    setChipValues(newValues);\r\n    if (props.chipValues !== undefined) props.chipValues(newValues);\r\n    //props.onChange(newValues);\r\n    //  setUpdate((st) => !st);\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <div className={`${classes.root} ${props.className}`} style={props.style}>\r\n        <Grid container spacing={2}>\r\n          <Grid item xs={4}>\r\n            <div className={classes.container}>\r\n              <div\r\n                onClick={() => {\r\n                  setModal(true);\r\n                  props.onBlur && props.onBlur();\r\n                }}\r\n              >\r\n                <Plus style={{ width: 20, height: 20 }} />\r\n              </div>\r\n            </div>\r\n            {props.error !== \"\" && (\r\n              <span className={classes.error}>{props.error}</span>\r\n            )}\r\n          </Grid>\r\n          {update && \"\"}\r\n          <ul className={classes.chips}>\r\n            {chipValues.map((data) => (\r\n              <li key={data.key}>\r\n                <Chip\r\n                  label={data.label}\r\n                  className={classes.chip}\r\n                  onDelete={handleDelete(data)}\r\n                />\r\n              </li>\r\n            ))}\r\n          </ul>\r\n        </Grid>\r\n      </div>\r\n      <Modal\r\n        title=\"ADD LOCATION\"\r\n        open={modal}\r\n        onClose={() => setModal((st) => !st)}\r\n        body={\r\n          <Form.Form>\r\n            <Form.Row>\r\n              <FormSelect\r\n                placeholder={props.placeholder}\r\n                name=\"deliveryAreas\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={(event) => {\r\n                  props.onChange(event);\r\n                  return formik.handleChange;\r\n                }}\r\n                value={(formik.values.deliveryAreas = props.value)}\r\n                error={formik.errors.deliveryAreas}\r\n                values={props.values}\r\n              />\r\n            </Form.Row>\r\n\r\n            <Form.Row justifyContent=\"center\">\r\n              <Button\r\n                minWidth={200}\r\n                text=\"VALIDATE\"\r\n                fullWidth={false}\r\n                onClick={onSubmit}\r\n                disabled={!props.value}\r\n              />\r\n            </Form.Row>\r\n          </Form.Form>\r\n        }\r\n      />\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\AvatarUpload.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Modal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\FormMultipleUpload.js",["628"],"import React, { useState } from \"react\";\r\nimport { useDispatch } from \"react-redux\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\nimport Grid from \"@material-ui/core/Grid\";\r\nimport Avatar from \"@material-ui/core/Avatar\";\r\nimport ClearIcon from \"@material-ui/icons/Clear\";\r\n\r\nimport Actions from \"../redux/actions\";\r\nimport GLOBALS from \"../globals\";\r\n\r\nimport { ReactComponent as Plus } from \"../assets/icons/Plus.svg\";\r\n\r\nexport default function FormMultipleUpload(props) {\r\n  const theme = useTheme();\r\n\r\n  const white = theme.palette.common.white;\r\n  const errorColor = theme.palette.error.main;\r\n  const borderColor = props.disabled\r\n    ? theme.palette.custom.disabled\r\n    : props.error\r\n    ? errorColor\r\n    : theme.palette.grey[100];\r\n\r\n  const useStyles = makeStyles((theme) => ({\r\n    root: {\r\n      position: \"relative\",\r\n    },\r\n    container: {\r\n      width: 45,\r\n      height: 45,\r\n      outline: 0,\r\n      borderWidth: 1,\r\n      display: \"grid\",\r\n      cursor: \"pointer\",\r\n      borderStyle: \"solid\",\r\n      placeItems: \"center\",\r\n      backgroundColor: white,\r\n      borderColor: borderColor,\r\n    },\r\n    images: {\r\n      marginTop: 15,\r\n    },\r\n    imageWrapper: {\r\n      position: \"relative\",\r\n      width: 45,\r\n      height: 45,\r\n    },\r\n    image: {\r\n      width: \"100%\",\r\n      height: \"100%\",\r\n      color: theme.palette.primary.main,\r\n      backgroundColor: theme.palette.primary.main,\r\n    },\r\n    imageCross: {\r\n      top: 4,\r\n      right: 4,\r\n      width: 10,\r\n      height: 10,\r\n      fontSize: 8,\r\n      display: \"grid\",\r\n      cursor: \"pointer\",\r\n      position: \"absolute\",\r\n      borderRadius: \"100%\",\r\n      placeItems: \"center\",\r\n      color: theme.palette.common.white,\r\n      backgroundColor: theme.palette.common.black,\r\n    },\r\n    error: {\r\n      color: errorColor,\r\n      fontWeight: 400,\r\n      position: \"absolute\",\r\n      fontSize: theme.typography.pxToRem(12),\r\n    },\r\n  }));\r\n\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const [update, setUpdate] = useState(false);\r\n\r\n  const onAdd = (e) => {\r\n    const file = e.target.files[0];\r\n\r\n    let fileSize = 10485760;\r\n    let fileTypes = [\"image/png\", \"image/jpg\", \"image/jpeg\"];\r\n    let errorTypes = \"PNG, JPEG, JPG\";\r\n\r\n    if (props.fileTypes) fileTypes = props.fileTypes;\r\n    if (props.fileSize) fileSize = props.fileSize;\r\n    if (props.errorTypes) errorTypes = props.errorTypes;\r\n    if (\r\n      file &&\r\n      file.size <= fileSize &&\r\n      fileTypes.some((typ) => typ === file.type)\r\n    ) {\r\n      const uri = URL.createObjectURL(file);\r\n      let newValues = props.values;\r\n      props.multiple\r\n        ? newValues.push({ key: newValues.length, file: file, uri: uri })\r\n        : (newValues[0] = { key: newValues.length, file: file, uri: uri });\r\n      props.onChange(newValues);\r\n      document.getElementById(`fileinput-${props.name}`).value = \"\";\r\n      setUpdate((st) => !st);\r\n    } else {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(\r\n            `Max size can be ${fileSize / 1048576}MB of types: ${errorTypes}`,\r\n            \"error\",\r\n          ),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const handleDelete = (value) => () => {\r\n    const newValues = props.values.filter((chip) => chip.key !== value.key);\r\n    props.onChange(newValues);\r\n    setUpdate((st) => !st);\r\n  };\r\n\r\n  return (\r\n    <div className={`${classes.root} ${props.className}`} style={props.style}>\r\n      <Grid container spacing={2}>\r\n        <Grid item xs={2}>\r\n          <div className={classes.container}>\r\n            <div\r\n              onClick={() => {\r\n                if (props.enabled != undefined && props.enabled) return;\r\n                document.getElementById(`fileinput-${props.name}`).click();\r\n              }}\r\n            >\r\n              <Plus style={{ width: 20, height: 20 }} />\r\n            </div>\r\n            <input\r\n              hidden\r\n              type=\"file\"\r\n              id={`fileinput-${props.name}`}\r\n              onChange={onAdd}\r\n              onBlur={props.onBlur}\r\n            />\r\n          </div>\r\n          {props.error !== \"\" && (\r\n            <span className={classes.error}>{props.error}</span>\r\n          )}\r\n        </Grid>\r\n        {update && \"\"}\r\n        {props.values.map((value, index) => (\r\n          <Grid item xs={4} key={index}>\r\n            <div className={classes.imageWrapper}>\r\n              <Avatar\r\n                variant=\"square\"\r\n                className={classes.image}\r\n                src={\r\n                  value.file\r\n                    ? value.uri\r\n                    : GLOBALS.Constants.BASE_URL + value.uri\r\n                }\r\n                alt=\"Natacha\"\r\n              />\r\n              {props.enabled ? (\r\n                <div\r\n                  onClick={handleDelete(value)}\r\n                  className={classes.imageCross}\r\n                >\r\n                  <ClearIcon fontSize=\"inherit\" color=\"inherit\" />\r\n                </div>\r\n              ) : null}\r\n            </div>\r\n          </Grid>\r\n        ))}\r\n      </Grid>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\FormLabel.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Stepper.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep2.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep3.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep1.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep2.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep1.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep3.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\components\\popoverModal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\components\\events.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\components\\MyWorkWeek.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\UnavailabilityTimes.js",["629","630","631"],"import React, { useState } from \"react\";\r\nimport { useDispatch } from \"react-redux\";\r\nimport { useFormik } from \"formik\";\r\nimport GLOBALS from \"../globals\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\nimport * as Yup from \"yup\";\r\nimport Input from \"./Input\";\r\nimport moment from \"moment\";\r\nimport Form from \"./Form\";\r\nimport Modal from \"./Modal\";\r\nimport Button from \"./Button\";\r\nimport FormLabel from \"./FormLabel\";\r\nimport FormSelect from \"./FormSelect\";\r\nimport FormInput from \"./FormInput\";\r\nimport FormControlLabel from \"@material-ui/core/FormControlLabel\";\r\nimport Checkbox from \"@material-ui/core/Checkbox\";\r\nimport Actions from \"../redux/actions\";\r\nimport { FreeBreakfastOutlined } from \"@material-ui/icons\";\r\nimport \"./custom.css\";\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    position: \"relative\",\r\n  },\r\n  chips: {\r\n    margin: 0,\r\n    marginTop: 15,\r\n    display: \"flex\",\r\n    flexWrap: \"wrap\",\r\n    listStyle: \"none\",\r\n    justifyContent: \"center\",\r\n  },\r\n  chip: {\r\n    color: theme.palette.primary.contrastText,\r\n    margin: theme.spacing(0.5),\r\n  },\r\n}));\r\n\r\nconst addUnavailabilityYup = Yup.object().shape({\r\n  key: Yup.number().required(\"Required\"),\r\n  date: Yup.date().required(\"Required\"),\r\n  startHour: Yup.number().required(\"Required\"),\r\n  endHour: Yup.number().required(\"Required\"),\r\n  dayOff: Yup.bool().required(\"Required\"),\r\n  reason: Yup.string().optional(),\r\n});\r\n\r\nexport default function MultiAdderInputModal(props) {\r\n  const {\r\n    unavailabilityDates,\r\n    setUnavailabilityDates,\r\n    startRange,\r\n    endRange,\r\n  } = props;\r\n\r\n  const dispatch = useDispatch();\r\n  const theme = useTheme();\r\n\r\n  const classes = useStyles();\r\n\r\n  const [modal, setModal] = useState(false);\r\n  const [update, setUpdate] = useState(false);\r\n  const [date, setDate] = useState(\"\");\r\n  const [reason, setReason] = useState(\"\");\r\n  const [time, setTime] = useState({\r\n    start: \"0\",\r\n    end: \"23\",\r\n  });\r\n  const [dayOff, setDayOff] = useState(false);\r\n\r\n  async function onSubmit(values) {\r\n    let newValues = props.values;\r\n    props.onChange(newValues);\r\n    setUpdate((st) => !st);\r\n    // setModal(false);\r\n    formik.setSubmitting(false);\r\n    formik.handleReset();\r\n  }\r\n  const getTime = (e) => {\r\n    setTime({ ...time, [e.target.name]: e.target.value });\r\n  };\r\n  const getDate = (e) => {\r\n    setDate(e.target.value);\r\n  };\r\n  const getreason = (e) => {\r\n    setReason(e.target.value);\r\n  };\r\n  const deleteUnavailability = (id) => {\r\n    let deleteArray = [];\r\n    unavailabilityDates.map(\r\n      (key, index) => index !== id && deleteArray.push(key),\r\n    );\r\n    setUnavailabilityDates(deleteArray);\r\n  };\r\n  const handledayOff = (event) => {\r\n    setDayOff(event.target.checked);\r\n\r\n    if (event.target.checked) {\r\n      time.start = \"0\";\r\n      time.end = \"0\";\r\n      setTime(time);\r\n    } else {\r\n      time.start = \"0\";\r\n      time.end = \"23\";\r\n      setTime(time);\r\n    }\r\n  };\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      day1Start: 0,\r\n      day1End: 23,\r\n    },\r\n    validationSchema: addUnavailabilityYup,\r\n    onSubmit: onSubmit,\r\n  });\r\n\r\n  const values = [\r\n    { value: 0, label: \"0\" },\r\n    { value: 1, label: \"1\" },\r\n    { value: 2, label: \"2\" },\r\n    { value: 3, label: \"3\" },\r\n    { value: 4, label: \"4\" },\r\n    { value: 5, label: \"5\" },\r\n    { value: 6, label: \"6\" },\r\n    { value: 7, label: \"7\" },\r\n    { value: 8, label: \"8\" },\r\n    { value: 9, label: \"9\" },\r\n    { value: 10, label: \"10\" },\r\n    { value: 11, label: \"11\" },\r\n    { value: 12, label: \"12\" },\r\n    { value: 13, label: \"13\" },\r\n    { value: 14, label: \"14\" },\r\n    { value: 15, label: \"15\" },\r\n    { value: 16, label: \"16\" },\r\n    { value: 17, label: \"17\" },\r\n    { value: 18, label: \"18\" },\r\n    { value: 19, label: \"19\" },\r\n    { value: 20, label: \"20\" },\r\n    { value: 21, label: \"21\" },\r\n    { value: 22, label: \"22\" },\r\n    { value: 23, label: \"23\" },\r\n  ];\r\n\r\n  const unavailabilityDatesHandal = () => {\r\n    let loop_date1;\r\n    let loop_date2;\r\n    let date1, date2;\r\n    let addvalue = 1;\r\n    const newarray = {\r\n      date: date,\r\n      startHour: time.start,\r\n      endHour: time.end,\r\n      dayOff: dayOff,\r\n      reason: reason,\r\n    };\r\n    date1 = moment(date).format(\"MM-DD-YYYY HH:mm:ss\");\r\n    date1 = moment(date1).set(\"hour\", parseInt(time.start));\r\n    date2 = moment(date).format(\"MM-DD-YYYY HH:mm:ss\");\r\n    date2 = moment(date2).set(\"hour\", parseInt(time.end));\r\n    if (moment(date).isBetween(startRange, endRange, null, \"[]\")) {\r\n      if (\r\n        parseInt(time.start) < parseInt(time.end) ||\r\n        (time.start === \"0\" && time.end === \"0\")\r\n      ) {\r\n        for (let i = 0; i < unavailabilityDates.length; i++) {\r\n          addvalue = 0;\r\n          let localdate = unavailabilityDates[i].date;\r\n          let localstart = unavailabilityDates[i].startHour;\r\n          let localend = unavailabilityDates[i].endHour;\r\n          let localdayOff = unavailabilityDates[i].dayOff;\r\n\r\n          loop_date1 = moment(localdate).format(\"MM-DD-YYYY HH:mm:ss\");\r\n          loop_date1 = moment(loop_date1).set(\"hour\", parseInt(localstart));\r\n          loop_date2 = moment(localdate).format(\"MM-DD-YYYY HH:mm:ss\");\r\n          loop_date2 = moment(loop_date2).set(\"hour\", parseInt(localend));\r\n\r\n          if (\r\n            (moment(date1).isBefore(loop_date1) &&\r\n              moment(date2).isBefore(loop_date2)) ||\r\n            (moment(date1).isAfter(loop_date1) &&\r\n              moment(date2).isAfter(loop_date2))\r\n          ) {\r\n            if (\r\n              moment(date2).isBetween(loop_date1, loop_date2) ||\r\n              moment(date1).isBetween(loop_date1, loop_date2)\r\n            ) {\r\n              console.log(\"is between time\");\r\n              break;\r\n            } else {\r\n              console.log(\"greater or less\");\r\n              if (moment(localdate).isSame(date) && localdayOff === true) {\r\n                break;\r\n              } else if (\r\n                moment(localdate).isSame(date) &&\r\n                dayOff === true &&\r\n                localdayOff === false\r\n              ) {\r\n                break;\r\n              } else {\r\n                addvalue = 1;\r\n              }\r\n            }\r\n          } else {\r\n            console.log(\"greate or less no valid\");\r\n            addvalue = 0;\r\n            break;\r\n          }\r\n        }\r\n        if (addvalue) {\r\n          setUnavailabilityDates((prevState) => [...prevState, newarray]);\r\n          // set value are all value empty\r\n          setDate(\"\");\r\n          setReason(\"\");\r\n          setTime({ start: \"0\", end: \"23\" });\r\n          setDayOff(false);\r\n          // set value are all value empty\r\n        } else {\r\n          dispatch(\r\n            Actions.notistack.enqueueSnackbar(\r\n              Actions.notistack.snackbar(\"This time is not available\", \"error\"),\r\n            ),\r\n          );\r\n        }\r\n      } else {\r\n        dispatch(\r\n          Actions.notistack.enqueueSnackbar(\r\n            Actions.notistack.snackbar(\"Please select a Vaild time \", \"error\"),\r\n          ),\r\n        );\r\n      }\r\n    } else {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(\r\n            \"Please select a Date b/w Start and End Date \",\r\n            \"error\",\r\n          ),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <Button\r\n        minWidth={200}\r\n        fullWidth={false}\r\n        color={theme.palette.blue}\r\n        text=\"SEE UNAVAILABILITIES\"\r\n        onClick={() => setModal(true)}\r\n      />\r\n      {update && \"\"}\r\n      <Modal\r\n        open={modal}\r\n        title=\"UNAVAILABILITIES\"\r\n        onClose={() => setModal((st) => !st)}\r\n        body={\r\n          <>\r\n            <Form.Form>\r\n              <Form.Row>\r\n                <Form.Row noMargin>\r\n                  <FormLabel disableMargin bold primary=\"Date:\" />\r\n                </Form.Row>\r\n                <Form.Row noMargin>\r\n                  <FormInput\r\n                    type=\"date\"\r\n                    name=\"date\"\r\n                    value={date}\r\n                    placeholder=\"Date\"\r\n                    style={GLOBALS.Styles.inputWidth}\r\n                    max={endRange}\r\n                    min={startRange}\r\n                    onChange={getDate}\r\n                  />\r\n\r\n                  <FormControlLabel\r\n                    control={\r\n                      <Checkbox\r\n                        checked={dayOff}\r\n                        onChange={handledayOff}\r\n                        name=\"dayOff\"\r\n                        color=\"primary\"\r\n                      />\r\n                    }\r\n                    label=\"Day Off\"\r\n                  />\r\n                </Form.Row>\r\n              </Form.Row>\r\n              <Form.Row style={{ display: dayOff ? \"none\" : \"flex\" }}>\r\n                <Form.Row noMargin>\r\n                  <FormLabel disableMargin bold primary=\"Time:\" />\r\n                </Form.Row>\r\n\r\n                <Form.Row noMargin>\r\n                  <FormSelect\r\n                    values={values}\r\n                    name=\"start\"\r\n                    value={time.start}\r\n                    onChange={getTime}\r\n                    style={{ marginRight: \"5px\" }}\r\n                  />\r\n\r\n                  <FormSelect\r\n                    name=\"end\"\r\n                    values={values}\r\n                    value={time.end}\r\n                    onChange={getTime}\r\n                  />\r\n                </Form.Row>\r\n              </Form.Row>\r\n\r\n              <Form.Row>\r\n                <Form.Row noMargin>\r\n                  <FormLabel disableMargin bold primary=\"Reason:\" />\r\n                </Form.Row>\r\n\r\n                <Form.Row noMargin>\r\n                  <textarea\r\n                    name=\"reason\"\r\n                    rows=\"3\"\r\n                    value={reason}\r\n                    onChange={getreason}\r\n                    maxLength=\"50\"\r\n                    minLength=\"3\"\r\n                    placeholder=\"Reason\"\r\n                    style={{ width: \"100%\" }}\r\n                  />\r\n                </Form.Row>\r\n              </Form.Row>\r\n\r\n              <Form.Row>\r\n                <Form.Row noMargin></Form.Row>\r\n\r\n                <Form.Row noMargin justifyContent=\"center\">\r\n                  <Button\r\n                    minWidth={200}\r\n                    onClick={unavailabilityDatesHandal}\r\n                    text=\"Add\"\r\n                    fullWidth={false}\r\n                  />\r\n                </Form.Row>\r\n              </Form.Row>\r\n            </Form.Form>\r\n            <table className=\"table\">\r\n              {unavailabilityDates.length > 0 && (\r\n                <>\r\n                  <thead>\r\n                    <tr>\r\n                      <th>Date</th>\r\n                      <th>Start</th>\r\n                      <th>End</th>\r\n                      <th>Reason</th>\r\n                      <th>Action</th>\r\n                    </tr>\r\n                  </thead>\r\n                  <tbody>\r\n                    {unavailabilityDates.map((key, index) => {\r\n                      return (\r\n                        <tr key={index}>\r\n                          <td> {moment(key.date).format(\"DD-MM-YYYY\")} </td>\r\n                          <td>{key.startHour}</td>\r\n                          <td>{key.endHour}</td>\r\n                          <td>{key.reason}</td>\r\n                          <td>\r\n                            <button\r\n                              onClick={() => {\r\n                                deleteUnavailability(index);\r\n                              }}\r\n                              className=\"btn btn-danger\"\r\n                              style={{\r\n                                fontSize: \"13px\",\r\n                                padding: \"0px 12px\",\r\n                              }}\r\n                            >\r\n                              X\r\n                            </button>\r\n                          </td>\r\n                        </tr>\r\n                      );\r\n                    })}\r\n                  </tbody>\r\n                </>\r\n              )}\r\n            </table>\r\n          </>\r\n        }\r\n      />\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\MultiAdderInputModal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\SmallButton.js",[],"C:\\Users\\
ecatedRules":"218"},{"filePath":"434","messages":"435","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"218"},"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/index.js",[],["436","437"],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/App.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/reportWebVitals.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/globals/i18n.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/container/Main.js",["438","439","440","441","442"],"import React, { useState } from \"react\";\nimport { useSelector, useDispatch } from \"react-redux\";\n\nimport Actions from \"../redux/actions\";\nimport Loader from \"../components/Loader\";\n\nimport UnAuth from \"../pages/UnAuth\";\nimport SuperAdmin from \"../pages/SuperAdmin\";\nimport Admin from \"../pages/Admin\";\n\nexport default function Main() {\n  const store = useSelector((state) => state.auth);\n  const dispatch = useDispatch();\n  const [loading, setLoading] = useState(true);\n\n  React.useEffect(() => {\n    dispatch(Actions.auth.checkLogin()).then(() => {\n      setTimeout(() => {\n        setLoading(false);\n      }, 1000);\n    });\n    // eslint-disable-next-line\n  }, []);\n\n  return (\n    <>\n    <Admin />\n      {/* {store.loading && <Loader.AbsoluteLinear />}\n      {loading ? (\n        <Loader.CenterProgress />s\n      ) : store.auth ? (\n        store.user.role === \"SUPERADMIN\" ? (\n          <SuperAdmin />\n        ) : (\n          <Admin />\n        )\n      ) : (\n        <UnAuth />\n      )} */}\n    </>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/redux/store.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/redux/Notifier.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/ErrorBoundary.js",[],"/Users/abc/
ent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\n// const addAdminYup = Yup.object().shape({\r\n//   email: Yup.string().required(\"Required\"),\r\n//   phone: Yup.number()\r\n//     .test(\r\n//       \"len\",\r\n//       \"Must be exactly 10 characters\",\r\n//       (val) => val && val.toString().length === 10,\r\n//     )\r\n//     .required(\"Required\"),\r\n//   firstName: Yup.string().required(\"Required\"),\r\n//   lastName: Yup.string().required(\"Required\"),\r\n//   image: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n//   companyId: Yup.string().required(\"Required\"),\r\n// });\r\n\r\nexport default function AddContact(props) {\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n\r\n  const [loading, setLoading] = useState(false);\r\n  const [dropdownType, setDropdownType] = useState([]);\r\n  const [type, setType] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [firstName, setFirstName] = useState(\"\");\r\n  const [lastName, setLastName] = useState(\"\");\r\n  const [image, setImage] = useState([]);\r\n  const [company, setCompany] = useState(\"\");\r\n  const [role, setRole] = useState(\"\");\r\n\r\n  const [emailError, setEmailError] = useState(\"\");\r\n  const [phoneError, setPhoneError] = useState(\"\");\r\n  const [firstNameError, setFirstNameError] = useState(\"\");\r\n  const [lastNameError, setLastNameError] = useState(\"\");\r\n\r\n\r\n\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  async function fetchData() {\r\n    try {\r\n      // const result = await GLOBALS.API({\r\n      //   uri: `${GLOBALS.Constants.COMPANY}`,\r\n      // });\r\n\r\n        const typeArray = [\r\n        { value: 'LOGISTICS', label: 'LOGISTICS'}, \r\n        { value: 'SITE', label: 'SITE'}\r\n      ];\r\n\r\n      setDropdownType(typeArray);\r\n\r\n      // const itemsArray = [];\r\n      // result.data.items.map((item) => {\r\n      //   if (!item.adminId) {\r\n      //     itemsArray.push({\r\n      //       value: item._id,\r\n      //       label: item.name,\r\n      //     });\r\n      //   }\r\n      //   return true;\r\n      // });\r\n\r\n      // setCompanies(itemsArray);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  }\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"email\") {\r\n      setEmail(value);\r\n      if(value === \"\" || name===null) {\r\n        setEmailError(true);\r\n\r\n      } else {\r\n        setEmailError(false);\r\n\r\n      }\r\n    } \r\n    else if (name === \"phone\") {\r\n       setPhone(value);\r\n        if (value === \"\" || name === null) {\r\n          setPhoneError(true);\r\n        } else {\r\n          setPhoneError(false);\r\n        }\r\n    } \r\n    else if (name === \"firstName\") {\r\n       setFirstName(value);\r\n        if (value === \"\" || name === null) {\r\n          setFirstNameError(true);\r\n        } else {\r\n          setFirstNameError(false);\r\n        }\r\n    } \r\n    else if (name === \"lastName\") {\r\n       setLastName(value);\r\n         if (value === \"\" || name === null) {\r\n           setLastNameError(true);\r\n         } else {\r\n           setLastNameError(false);\r\n         }\r\n    } \r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"company\") setCompany(value);\r\n    else if (name === \"role\") setRole(value);\r\n  };\r\n\r\n  const onSubmit = async (e) => {\r\n    try {\r\n      e.preventDefault();\r\n      setLoading(true);\r\n      var formdata = new FormData();\r\n      console.log(' adminStore.site.siteId._id',  adminStore.site.siteId._id)\r\n      formdata.append(\"email\", email);\r\n      formdata.append(\"phone\", phone);\r\n      formdata.append(\"firstName\", firstName);\r\n      formdata.append(\"lastName\", lastName);\r\n      formdata.append(\"image\", image[0].file);\r\n      formdata.append(\"company\", company);\r\n      formdata.append(\"siteId\", adminStore.site.siteId._id);\r\n      formdata.append(\"type\", type);\r\n      formdata.append(\"role\", role);\r\n      \r\n      await GLOBALS.API({\r\n        method: \"POST\",\r\n        uri: GLOBALS.Constants.POST_SITE_ORGANIGRAMMES,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      setLoading(false);\r\n      props.history.goBack();\r\n      // props.history.push(\"/admins\");\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"ADD A CONTACT\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={onSubmit}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF ORGANIGRAMME*: \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormSelect\r\n                name=\"type\"\r\n                value={type}\r\n                // error={companyId}\r\n                values={dropdownType}\r\n                placeholder=\"Type\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                   onChange={(e) => {\r\n                  const index = e.target.selectedIndex - 1;\r\n                  console.log('index', index);\r\n                  if (index !== -1) {\r\n                    const item = e.target.value;\r\n\r\n                    console.log(item)\r\n                    setType(item);\r\n                  } else {\r\n\r\n                    setType(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"CONTACT INFO*: \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormInput\r\n                name=\"email\"\r\n                value={email}\r\n                // error={firstName}\r\n                placeholder=\"Adresse e-mail\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n              <FormInput\r\n                name=\"phone\"\r\n                value={phone}\r\n                // error={lastName}\r\n                placeholder=\"Téléphone\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY*:  \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormInput\r\n                name=\"firstName\"\r\n                value={firstName}\r\n                // error={firstName}\r\n                placeholder=\"First Name\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n              <FormInput\r\n                name=\"lastName\"\r\n                value={lastName}\r\n                // error={lastName}\r\n                placeholder=\"Last Name\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n              <FormMultipleUpload\r\n                name=\"profile\"\r\n                // error={image}\r\n                values={image}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={(values) => handleChange(\"profile\", values)}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"COMPANY: \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              \r\n             <FormInput\r\n                name=\"company\"\r\n                value={company}\r\n                // error={lastName}\r\n                placeholder=\"Enterprise\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n              {/* <FormSelect\r\n                name=\"company\"\r\n                value={company}\r\n                // error={companyId}\r\n                values={companies}\r\n                placeholder=\"Entreprise\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              /> */}\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"Rôle: \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n                <FormInput\r\n                name=\"role\"\r\n                value={role}\r\n                // error={lastName}\r\n                placeholder=\"Role\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n              {/* <FormSelect\r\n                name=\"companyId\"\r\n                value={companyId}\r\n                // error={companyId}\r\n                values={companies}\r\n                placeholder=\"Rôle\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              /> */}\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              type=\"submit\"\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              fullWidth={false}\r\n              loading={loading}\r\n              disabled={\r\n                loading ||\r\n                !type||\r\n                !email ||\r\n                !phone ||\r\n                !firstName ||\r\n                !lastName ||\r\n                image.length === 0 \r\n              }\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Incidents\\editIncidents.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Incidents\\Incidents.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddZAC.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\Sites.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\or
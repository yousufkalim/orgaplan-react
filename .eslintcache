t getStartDate = (start) => {\r\n    var start = start;\r\n    var dd = String(start.getDate()).padStart(2, \"0\");\r\n    var mm = String(start.getMonth() + 1).padStart(2, \"0\"); //January is 0!\r\n    var yyyy = start.getFullYear();\r\n    start = mm + \"/\" + dd + \"/\" + yyyy;\r\n    return start;\r\n  };\r\n\r\n  const getStartTime = (date) => {\r\n    var dt = moment(date, [\"h:mm A\"]).format(\"HH:mm\");\r\n    return dt;\r\n  };\r\n  if (event) {\r\n    return (\r\n      <Modal show={popoverShow} onHide={handlePopoverClose}>\r\n        <Modal.Header closeButton>\r\n          <Modal.Title>Event Detail </Modal.Title>\r\n        </Modal.Header>\r\n        <Modal.Body>\r\n          <div className=\"showPopover\">\r\n            <h5>{event.title}</h5>\r\n            {/* {console.log(event)} */}\r\n            <p>\r\n              {/* {event.start.getDay()}-{event.start.getMonth() + 1}-\r\n                {event.start.getYear()} */}\r\n              <h6 style={{ \"font-size\": \"12px\", \"padding-top\": \"10px\" }}>\r\n                <span>\r\n                  <b>Start Time:</b> {getStartTime(event.start)}{\" \"}\r\n                </span>{\" \"}\r\n                <span>{getStartDate(event.start)}</span>\r\n                <br />\r\n                <span>\r\n                  <b>End Time:</b> {getStartTime(event.end)}{\" \"}\r\n                </span>{\" \"}\r\n                <span>{getStartDate(event.end)}</span>\r\n              </h6>\r\n            </p>\r\n\r\n            <hr />\r\n            <div className=\"popoverfooter\">\r\n              <div className=\"col-lg-6\">\r\n                <button\r\n                  className=\"btn text-white bg-primary\"\r\n                  onClick={handleEditEvent}\r\n                >\r\n                  <i class=\"fas fa-pencil\"></i> <span>edit</span>\r\n                </button>\r\n              </div>\r\n              <div className=\"col-lg-6\">\r\n                <button\r\n                  className=\"btn text-white bg-danger\"\r\n                  onClick={handleDeleteEvent}\r\n                >\r\n                  <i class=\"fas fa-trash\"></i> <span>Delete</span>\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </Modal.Body>\r\n      </Modal>\r\n    );\r\n  } else {\r\n    return \"\";\r\n  }\r\n};\r\nexport default PopoverModal;\r\n","C:\\Users\\HP\\Desktop\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\MyWorkWeek.js",["413"],"import PropTypes from \"prop-types\";\r\nimport React from \"react\";\r\nimport Week from \"react-big-calendar/lib/Week\";\r\nimport TimeGrid from \"react-big-calendar/lib/TimeGrid\";\r\n\r\nfunction workWeekRange(date, options, custom_week_days) {\r\n  if (custom_week_days == undefined) {\r\n    return Week.range(date, options).filter(\r\n      (d) => [0, 1].indexOf(d.getDay()) === -1\r\n    );\r\n  } else {\r\n    return Week.range(date, options).filter(\r\n      (d) => custom_week_days.indexOf(d.getDay()) === -1\r\n    );\r\n  }\r\n}\r\n\r\nclass MyWorkWeek extends React.Component {\r\n  render() {\r\n    let { custom_week_days, date, ...props } = this.props;\r\n    let range = workWeekRange(date, this.props, custom_week_days);\r\n    return <TimeGrid {...props} range={range} eventOffset={15} />;\r\n  }\r\n}\r\n\r\nMyWorkWeek.propTypes = {\r\n  date: PropTypes.instanceOf(Date).isRequired,\r\n};\r\n\r\nMyWorkWeek.defaultProps = TimeGrid.defaultProps;\r\n\r\nMyWorkWeek.range = workWeekRange;\r\n\r\nMyWorkWeek.navigate = Week.navigate;\r\n\r\nMyWorkWeek.title = (date, { localizer }) => {\r\n  let [start, ...rest] = workWeekRange(date, { localizer });\r\n  return localizer.format({ start, end: rest.pop() }, \"dayRangeHeaderFormat\");\r\n};\r\nexport default MyWorkWeek;\r\n","C:\\Users\\HP\\Desktop\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\overlapSelect.js",["414"],"import React from \"react\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\
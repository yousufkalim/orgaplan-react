   contractEndDate: Yup.string().required(\"Required\"),\r\n//   functionality: Yup.string().required(\"Required\"),\r\n//   additionalInfo: Yup.string(),\r\n//   notificationPriorToDays: Yup.number(),\r\n//   notificationTo: Yup.array(),\r\n// });\r\n\r\nexport default function AddIncidents(props) {\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n\r\n  const [name, setName] = useState(\"\");\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [dropdownLocationType, setDropdownLocationType] = useState([]);\r\n  const [location, setLocations] = useState([]);\r\n  const [selectedLocationType, setselectedLocationType] = useState(\"\");\r\n\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [date, setDate] = useState(\"\");\r\n  const [time, setTime] = useState(\"\");\r\n\r\n  const [nameError, setNameError] = useState(\"\"); //working\r\n\r\n  const [comapnyError, setComapnyError] = useState(\"\");\r\n  const [dateError, setDateError] = useState(\"\");\r\n  const [timeError, setTimeError] = useState(\"\");\r\n\r\n    useEffect(() => {\r\n    fetchData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n   useEffect(() => {\r\n    fetchLocationDataOnTypeChange();\r\n    // eslint-disable-next-line\r\n  }, [selectedLocationType]);\r\n\r\n const fetchData = async () => {\r\n   const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_SITE_INCIDENT}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n\r\n       });\r\n      \r\n    console.log(response)\r\n    \r\n    if(response.success) {\r\n      console.log(response.data.site_companies)\r\n      if(response.data.site_companies) {\r\n        const temp = [];\r\n          response.data.site_companies.map((item, index) => {\r\n            console.log(item)\r\n            return temp.push({ label: item.companyId.name, value: item.companyId._id });\r\n          });\r\n          setDropdownCompanies(temp);\r\n\r\n        console.log(dropdownCompanies)\r\n\r\n      }\r\n\r\n        if (response.data.locationTypes) {\r\n          setLocations(response.data.locationTypes);\r\n          const temp = [];\r\n          response.data.locationTypes.map((item, index) => {\r\n            return temp.push({ label: item, value: item });\r\n          });\r\n          setDropdownLocationType(temp);\r\n        }\r\n\r\n    }\r\n }\r\n\r\n\r\n\r\n  const onSubmit = async (values) => {\r\n  const notificationTo = values.notificationTo.map((item) => item.label);\r\n\r\n  var formdata = new FormData();\r\n  formdata.append(\"logo\", values.logo[0].file);\r\n  formdata.append(\"name\", values.name);\r\n  formdata.append(\"color\", values.color);\r\n  formdata.append(\"firstName\", values.firstName);\r\n  formdata.append(\"lastName\", values.lastName);\r\n  formdata.append(\"email\", values.email);\r\n  formdata.append(\"phone\", values.phone);\r\n    formdata.append(\"contractType\", values.contractType);\r\n    formdata.append(\"contractStartDate\", values.contractStartDate);\r\n    formdata.append(\"contractEndDate\", values.contractEndDate);\r\n    formdata.append(\"functionality\", values.functionality);\r\n    formdata.append(\"additionalInfo\", values.additionalInfo);\r\n    formdata.append(\"notificationPriorToDays\", values.notificationPriorToDays);\r\n    formdata.append(\"notificationTo\", JSON.stringify(notificationTo));\r\n    await GLOBALS.API({\r\n      method: \"POST\",\r\n      uri: GLOBALS.Constants.CLIENTS,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    // formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n   const nameChange = (e) => {\r\n     console.log(e.target.value)\r\n    if (e.target.name === \"name\") {\r\n      setName(e.target.value);\r\n      if (e.target.name === \"\" || name === null) {\r\n        setNameError(true);\r\n      } else {\r\n        setNameError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"company\") {\r\n      setCompanyId(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setComapnyError(true);\r\n      } else {\r\n        setComapnyError(false);\r\n      }\r\n    }\r\n        if (e.target.name === \"date\") {\r\n      setDate(e.target.value);\r\n      // console.log(date)\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setDateError(true);\r\n      } else {\r\n        setDateError(false);\r\n      }\r\n    }\r\n        if (e.target.name === \"time\") { \r\n      setTime(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setTimeError(true);\r\n      } else {\r\n        setTimeError(false);\r\n      }\r\n      \r\n    }\r\n       if (e.target.name === \"location\") {\r\n      setTime(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setTimeError(true);\r\n      } else {\r\n        setTimeError(false);\r\n      }\r\n      \r\n    }\r\n       if (e.target.name === \"additionalInfo\") { //working\r\n      setTime(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setTimeError(true);\r\n      } else {\r\n        setTimeError(false);\r\n      }\r\n      \r\n    }\r\n       if (e.target.name === \"time\") { //working\r\n      setTime(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setTimeError(true);\r\n      } else {\r\n        setTimeError(false);\r\n      }\r\n      \r\n    }\r\n\r\n\r\n\r\n  };\r\n\r\n  const fetchLocationDataOnTypeChange = async () => {\r\n    if(selectedLocationType === 'STORAGEAREA') {\r\n        const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if(response.success) {\r\n        \r\n      }\r\n      console.log(response)\r\n    }\r\n    if(selectedLocationType === 'DELIVERYAREA') {\r\n        const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if(response.success) {\r\n        //  const temp = [];\r\n        //   response.data.map((item, index) => {\r\n        //     return temp.push({ label: item, value: item });\r\n        //   });\r\n        //   setDropdownLocationType(temp);\r\n      }\r\n      console.log(response);\r\n    }\r\n  }\r\n  const locationTypeChange = (e)=> {\r\n     setselectedLocationType(e.target.value);\r\n  }\r\n  const submitHandler = (e) => {\r\n    e.preventDefault();\r\n    if (name === \"\" || name === null) {\r\n      setNameError(true);\r\n    }\r\n    // if (types === \"\" || types === null) {\r\n    //   setTypeError(true);\r\n    // }\r\n    // if (color === \"\" || color === null) {\r\n    //   setColorError(true);\r\n    // }\r\n    // if (startDate === \"\" || startDate === undefined || startDate === null) {\r\n    //   setStartDateError(true);\r\n    //   setIsDateSelect(true);\r\n      \r\n    // } \r\n    // if (endDate === \"\" || endDate === undefined || endDate === null) {\r\n    //   setEndDateError(true);\r\n    // } \r\n    // if( rate === \"\" || rate === null){\r\n    //   setRateError(true);\r\n    // }\r\n    // if( name !== \"\" && types !== \"\" && color !== \"\" && startDate !== \"\" && endDate !== \"\"){\r\n    //   clearFileds();\r\n    // }\r\n    else {\r\n      // clearFileds();\r\n    }\r\n  };\r\n\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"CREATE AN INCIDENTS\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"DESIGNATION* :\" />\r\n            <FormInput\r\n              name=\"name\"\r\n              style={GLOBALS.Styles.inputWidth}\r\n              placeholder=\"Name of incident\"\r\n              onChange={nameChange}\r\n              value={name}\r\n            />\r\n                {/* {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )} */}\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"NAME OF COMPANY* :\" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormSelect\r\n                placeholder=\"Nom de I'enterprise\"\r\n                name=\"comapnyId\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={nameChange}\r\n                // value={formik.values.color}\r\n                values={dropdownCompanies}\r\n              />\r\n              <span\r\n                style={{\r\n                  textAlign: \"center\",\r\n                  marginRight: \"50px\",\r\n                  marginTop: \"10px\",\r\n                }}\r\n              >\r\n                General Contractor name\r\n              </span>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"DATE AND TIME : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormInput\r\n                type=\"date\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                placeholder=\"Date\"\r\n                name=\"date\" \r\n                onChange={nameChange}\r\n                // error={formik.errors.contractStartDate}\r\n              />\r\n              <FormInput\r\n                placeholder=\"TIME\"\r\n                type=\"time\"\r\n                name=\"time\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={nameChange}\r\n                // value={formik.values.color}\r\n                // error={formik.errors.color}\r\n               \r\n              />\r\n            </Form.Row> \r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"LOCATION : \" />\r\n            <Form.Row noMargin width=\"48%\"> \r\n              <FormSelect\r\n                placeholder=\"Type of location\" //working\r\n                name=\"color\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                 onChange={locationTypeChange}\r\n                // value={formik.values.color}\r\n                // error={formik.errors.color}\r\n                values={dropdownLocationType}\r\n              />\r\n              <FormSelect\r\n                placeholder=\"LOCATION\"\r\n                name=\"location\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                // onChange={formik.handleChange}\r\n                // value={formik.values.color}\r\n                // error={formik.errors.color}\r\n                values={[\r\n                  { value: \"green\", label: \"Green\" },\r\n                  { value: \"Yellow\", label: \"Yellow\" },\r\n                  { value: \"Red\", label: \"Red\" },\r\n                  { value: \"Blue\", label: \"Blue\" },\r\n                  { value: \"Orange\", label: \"Orange\" },\r\n                  { value: \"Purple\", label: \"Purple\" },\r\n                  { value: \"Magenta\", label: \"Magenta\" },\r\n                ]}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"DESCRIPTION : \" />\r\n            <FormInput\r\n              textArea\r\n              rows={3}\r\n              style={GLOBALS.Styles.inputWidth}\r\n                onChange={nameChange}\r\n              placeholder=\"Information complementaires\"\r\n              name=\"additionalInfo\"\r\n              // value={formik.values.additionalInfo}\r\n              // error={formik.errors.additionalInfo}\r\n            />\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"ADD PICTURES : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              {/* <FormMultipleUpload\r\n                name=\"logo\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                error={formik.errors.logo}\r\n                values={formik.values.logo}\r\n                onChange={(values) =>\r\n                  formik.handleChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"logo\",\r\n                      value: values,\r\n                    },\r\n                  }\r\n                  )\r\n                }\r\n              /> */}\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"BILLABLE* : \" />\r\n            <FormSelect\r\n              placeholder=\"Select\"\r\n              name=\"color\"\r\n              style={GLOBALS.Styles.inputWidth}\r\n              // onChange={formik.handleChange}\r\n              // value={formik.values.color}\r\n              // error={formik.errors.color}\r\n              values={[\r\n                { value: \"true\", label: \"Yes\" },\r\n                { value: \"false\", label: \"No\" },\r\n              ]}\r\n            />\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"AMOUNT :\" />\r\n            <Form.Row width=\"48%\" noMargin alignItems=\"center\">\r\n              <Form.Row width=\"24%\" noMargin alignItems=\"center\">\r\n                <FormInput\r\n                  type=\"number\"\r\n                  name=\"penaltyforLateDelivery\"\r\n                  // error={penaltyforLateDelivery}\r\n                />\r\n                <SmallText style={{ marginLeft: 10 }} primary=\"€\" />\r\n              </Form.Row>\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"COMMENT ON INVOICE : \" />\r\n            <FormInput\r\n              textArea\r\n              rows={3}\r\n              style={GLOBALS.Styles.inputWidth}\r\n              // onChange={formik.handleChange}\r\n              placeholder=\"Ajouter un commentaire\"\r\n              name=\"additionalInfo\"\r\n              // value={formik.values.additionalInfo}\r\n              // error={formik.errors.additionalInfo}\r\n            />\r\n          </Form.Row>\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              type=\"submit\"\r\n              minWidth={200}\r\n              text=\"VALIDER\"\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              // disabled={formik.isSubmitting}\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\ZACs.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\MyWorkWeek.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\popoverModal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Calender\\components\\events.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Pic\\Pic.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\globals\\Styles.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\globals\\API.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\globals\\Constants.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\SearchInput.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\index.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\FormSelect.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\FormMultipleUpload.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\FormLabel.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Form.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\index.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\AvatarUpload.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Table.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Modal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Pagination.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\index.js",["488"],"import React, { useState } from \"react\";\r\nimport \"./Calender.css\";\r\nimport { Modal, Button, Alert } from \"react-bootstrap\";\r\nimport Radio from \"@material-ui/core/Radio\";\r\nimport RadioGroup from \"@material-ui/core/RadioGroup\";\r\nimport FormControlLabel from \"@material-ui/core/FormControlLabel\";\r\nimport FormControl from \"@material-ui/core/FormControl\";\r\nimport myEventsList from \"./components/events\";\r\nimport moment from \"moment\";\r\nimport { Calendar, momentLocalizer } from \"react-big-calendar\";\r\nimport \"react-big-calendar/lib/css/react-big-calendar.css\";\r\nimport PopoverModal from \"./components/popoverModal\";\r\nimport MyWorkWeek from \"./components/MyWorkWeek\";\r\nimport TimePicker from \"react-time-picker\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport { addDays } from \"date-fns\";\r\nimport DatePicker from \"react-datepicker\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport \"react-datepicker/dist/react-datepicker.css\";\r\n\r\nlet view = {\r\n  month: true,\r\n  day: true,\r\n  work_week: MyWorkWeek,\r\n  agenda: true,\r\n};\r\n\r\nconst localizer = momentLocalizer(moment);\r\n\r\nlet formats = {\r\n  dateFormat: \"DD\",\r\n  monthHeaderFormat: \"DD/MM/YYYY\",\r\n  dayHeaderFormat: \"DD/MM/YYYY\",\r\n  dayRangeHeaderFormat: \"DD/MM/YYYY\",\r\n  timeGutterFormat: (date, culture, localizer) =>\r\n    localizer.format(date, \"HH:mm\", culture),\r\n  eventTimeRangeFormat: ({ start, end }, culture, localizer) =>\r\n    localizer.format(start, \"HH:mm\") + \"-\" + localizer.format(end, \"HH:mm\"),\r\n};\r\n\r\nconst Calender = () => {\r\n  const [alertBoxTime, setAlertBoxTime] = useState(false);\r\n  const [days] = useState([0]);\r\n  const [popoverShow, setpopoverShow] = useState(false);\r\n  const [eventID] = useState(\"\");\r\n  const [event] = useState(\"\");\r\n  const [events, setEvents] = useState(myEventsList);\r\n  const [show, setShow] = useState(false);\r\n  let [startTime, setStartTime] = useState(\"\");\r\n  let [endTime, setEndTime] = useState(\"\");\r\n  let [starttimeslice, setstarttimeslice] = useState(\"\");\r\n  let [Endtimeslice, setEndtimeslice] = useState(\"\");\r\n  const [title, setTitle] = useState(\"\");\r\n  const [value, setValue] = useState(\"\");\r\n  const [statusColor, setStatusColor] = useState(\"#FFFF00\");\r\n  const [showEdit, setShowEdit] = useState(false);\r\n  const [titleEdit, setTitleEdit] = useState(\"\");\r\n  let [startTimeEdit, setStartTimeEdit] = useState(\"\");\r\n  let [endTimeEdit, setEndTimeEdit] = useState(\"\");\r\n  let [starttimesliceEdit, setstarttimesliceEdit] = useState(\"\");\r\n  let [endtimesliceEdit, setEndtimesliceEdit] = useState(\"\");\r\n  const [statusColorEdit, setStatusColorEdit] = useState(\"\");\r\n  const [bookingslot, setbookingslot] = useState(false);\r\n  const [bookingEvent, setbookingEvent] = useState();\r\n  const [bookingTitle, setBookingTitle] = useState();\r\n  let [bookingstartTime, setBookingstartTime] = useState(\"\");\r\n  let [bookingEndTime, setBookingEndTime] = useState(\"\");\r\n  let [bookingstartTimeslice, setBookingstartTimeslice] = useState(\"\");\r\n  let [bookingendTimeslice, setBookingendTimeslice] = useState(\"\");\r\n  const [startDate, setStartDate] = useState(\"\");\r\n  const [cdate, setCdate] = useState(\"\");\r\n  // const [statusbooking, setStatusbooking] = useState(\"#FFFF00\");\r\n  const [overlap] = React.useState(\"Enable\");\r\n  // const [overlapOpen, setoverlapOpen] = React.useState(false);\r\n  // overlap functions **************\r\n  // const handleOverLapChange = (event) => {\r\n  //   setoverlap(event.target.value);\r\n  // };\r\n  // const handleOverLapClose = () => {\r\n  //   setoverlapOpen(false);\r\n  // };\r\n  // const handleOverLapOpen = () => {\r\n  //   setoverlapOpen(true);\r\n  // };\r\n  const handleClose = () => setShow(false);\r\n  let work_week_obj = {\r\n    Sunday: true,\r\n    Monday: true,\r\n    Tuesday: true,\r\n    Wednesday: true,\r\n    Thursday: true,\r\n    Friday: true,\r\n    Saturday: true,\r\n  };\r\n  for (let i = 0; i < days.length; i++) {\r\n    if (days[i] === 0) {\r\n      work_week_obj.Sunday = false;\r\n    } else if (days[i] === 1) {\r\n      work_week_obj.Monday = false;\r\n    } else if (days[i] === 2) {\r\n      work_week_obj.Tuesday = false;\r\n    } else if (days[i] === 3) {\r\n      work_week_obj.Wednesday = false;\r\n    } else if (days[i] === 4) {\r\n      work_week_obj.Thursday = false;\r\n    } else if (days[i] === 5) {\r\n      work_week_obj.Friday = false;\r\n    } else if (days[i] === 6) {\r\n      work_week_obj.Saturday = false;\r\n    }\r\n  }\r\n  // const [workWeekstate, workWeekSetState] = useState(work_week_obj);\r\n  // const workWeekHandleChange = (event) => {\r\n  //   workWeekSetState({\r\n  //     ...workWeekstate,\r\n  //     [event.target.name]: event.target.checked,\r\n  //   });\r\n\r\n  //   // if (event.target.checked === true) {\r\n  //   //   setavailabilitieModal(true);\r\n  //   // }\r\n\r\n  //   // sunday Start\r\n  //   if (event.target.name === \"Sunday\" && event.target.checked === true) {\r\n  //     let remove = days.indexOf(0);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //     // setAvailibilityDateMin();\r\n  //   } else if (\r\n  //     event.target.name === \"Sunday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(0);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // sunday End\r\n  //   // Monday Start\r\n  //   else if (event.target.name === \"Monday\" && event.target.checked === true) {\r\n  //     let remove = days.indexOf(1);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   } else if (\r\n  //     event.target.name === \"Monday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // Monday End\r\n  //   // Tuesday Start\r\n  //   else if (event.target.name === \"Tuesday\" && event.target.checked === true) {\r\n  //     let remove = days.indexOf(2);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   } else if (\r\n  //     event.target.name === \"Tuesday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(2);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // Tuesday End\r\n  //   // Wednesday Start\r\n  //   else if (\r\n  //     event.target.name === \"Wednesday\" &&\r\n  //     event.target.checked === true\r\n  //   ) {\r\n  //     let remove = days.indexOf(3);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   } else if (\r\n  //     event.target.name === \"Wednesday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(3);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // Wednesday End\r\n  //   // Thursday Start\r\n  //   else if (\r\n  //     event.target.name === \"Thursday\" &&\r\n  //     event.target.checked === true\r\n  //   ) {\r\n  //     let remove = days.indexOf(4);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   } else if (\r\n  //     event.target.name === \"Thursday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(4);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // Thursday End\r\n  //   // Friday Start\r\n  //   else if (event.target.name === \"Friday\" && event.target.checked === true) {\r\n  //     let remove = days.indexOf(5);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   } else if (\r\n  //     event.target.name === \"Friday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(5);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // Friday End\r\n  //   // Saturday Start\r\n  //   else if (\r\n  //     event.target.name === \"Saturday\" &&\r\n  //     event.target.checked === true\r\n  //   ) {\r\n  //     let remove = days.indexOf(6);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   } else if (\r\n  //     event.target.name === \"Saturday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(6);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // Saturday End\r\n  // };\r\n  const updateEvent = () => {\r\n    if (titleEdit !== \"\") {\r\n      /* start time*/\r\n      startTimeEdit = String(startTimeEdit);\r\n      starttimesliceEdit = String(starttimesliceEdit);\r\n      startTimeEdit = Array.from(startTimeEdit);\r\n      starttimesliceEdit = Array.from(starttimesliceEdit);\r\n      startTimeEdit[16] = starttimesliceEdit[0];\r\n      startTimeEdit[17] = starttimesliceEdit[1];\r\n      startTimeEdit[18] = starttimesliceEdit[2];\r\n      startTimeEdit[19] = starttimesliceEdit[3];\r\n      startTimeEdit[20] = starttimesliceEdit[4];\r\n      startTimeEdit = String(startTimeEdit);\r\n      startTimeEdit = startTimeEdit.replace(/,/g, \"\");\r\n      startTimeEdit = new Date(startTimeEdit);\r\n      /* start time*/\r\n      /* End time*/\r\n      endTimeEdit = String(endTimeEdit);\r\n      endtimesliceEdit = String(endtimesliceEdit);\r\n      endTimeEdit = Array.from(endTimeEdit);\r\n      endtimesliceEdit = Array.from(endtimesliceEdit);\r\n      endTimeEdit[16] = endtimesliceEdit[0];\r\n      endTimeEdit[17] = endtimesliceEdit[1];\r\n      endTimeEdit[18] = endtimesliceEdit[2];\r\n      endTimeEdit[19] = endtimesliceEdit[3];\r\n      endTimeEdit[20] = endtimesliceEdit[4];\r\n      endTimeEdit = String(endTimeEdit);\r\n      endTimeEdit = endTimeEdit.replace(/,/g, \"\");\r\n      endTimeEdit = new Date(endTimeEdit);\r\n      /* End time*/\r\n\r\n      let preDateTime = new Date();\r\n      let milliseconds = Date.parse(preDateTime);\r\n      milliseconds = milliseconds - 1 * 60 * 1000;\r\n      preDateTime = new Date(milliseconds);\r\n      if (startTimeEdit > preDateTime && startTimeEdit < endTimeEdit) {\r\n        const updateElement = events.filter((e) => e.id === eventID);\r\n        updateElement[0].title = titleEdit;\r\n        updateElement[0].start = startTimeEdit;\r\n        updateElement[0].end = endTimeEdit;\r\n        updateElement[0].color = statusColorEdit;\r\n        setEvents([...events, updateElement]);\r\n        setTitleEdit(\"\");\r\n        setShowEdit(false);\r\n      } else {\r\n        setAlertBoxTime(true);\r\n        setTimeout(function () {\r\n          setAlertBoxTime(false);\r\n        }, 2000);\r\n      }\r\n    } else {\r\n      setAlertBoxTime(true);\r\n      setTimeout(function () {\r\n        setAlertBoxTime(false);\r\n      }, 2000);\r\n    }\r\n  };\r\n  const saveEvent = () => {\r\n    if (title !== \"\") {\r\n      /* start time*/\r\n      startTime = String(startTime);\r\n      starttimeslice = String(starttimeslice);\r\n      startTime = Array.from(startTime);\r\n      starttimeslice = Array.from(starttimeslice);\r\n      startTime[16] = starttimeslice[0];\r\n      startTime[17] = starttimeslice[1];\r\n      startTime[18] = starttimeslice[2];\r\n      startTime[19] = starttimeslice[3];\r\n      startTime[20] = starttimeslice[4];\r\n      startTime = String(startTime);\r\n      startTime = startTime.replace(/,/g, \"\");\r\n      startTime = new Date(startTime);\r\n\r\n      /* start time*/\r\n      /* End time*/\r\n      endTime = String(endTime);\r\n      Endtimeslice = String(Endtimeslice);\r\n      endTime = Array.from(endTime);\r\n      Endtimeslice = Array.from(Endtimeslice);\r\n      endTime[16] = Endtimeslice[0];\r\n      endTime[17] = Endtimeslice[1];\r\n      endTime[18] = Endtimeslice[2];\r\n      endTime[19] = Endtimeslice[3];\r\n      endTime[20] = Endtimeslice[4];\r\n      endTime = String(endTime);\r\n      endTime = endTime.replace(/,/g, \"\");\r\n      endTime = new Date(endTime);\r\n      /* End time*/\r\n      let beforeTime = moment(startTime).format(\"DD/MM/YYYY HH:mm\");\r\n      let afterTime = moment(endTime).format(\"DD/MM/YYYY HH:mm\");\r\n      let dateCheck1 = events.find((item) => {\r\n        return (\r\n          moment(item.start).format(\"DD/MM/YYYY HH:mm\") === beforeTime ||\r\n          moment(item.end).format(\"DD/MM/YYYY HH:mm\") === afterTime\r\n        );\r\n      });\r\n\r\n      let dateCheck2 = events.findIndex((item) => {\r\n        return startTime > item.start;\r\n      });\r\n      let dateCheck3 = events.findIndex((item) => {\r\n        return startTime > item.end;\r\n      });\r\n\r\n      let uniqid = Math.random();\r\n\r\n      /*check not in previous day  Start */\r\n      let preDateTime = new Date();\r\n      let milliseconds = Date.parse(preDateTime);\r\n      milliseconds = milliseconds - 1 * 60 * 1000;\r\n      preDateTime = new Date(milliseconds);\r\n      /*check not in previous day End  */\r\n\r\n      if (startTime > preDateTime && startTime < endTime) {\r\n        if (overlap === \"Enable\") {\r\n          setShow(false);\r\n          const newElement = {\r\n            id: uniqid,\r\n            title: title,\r\n            start: startTime,\r\n            end: endTime,\r\n            color: statusColor,\r\n          };\r\n          setEvents([...events, newElement]);\r\n          setTitle(\"\");\r\n        } else if (\r\n          overlap === \"Disable\" &&\r\n          dateCheck2 !== -1 &&\r\n          dateCheck3 !== -1 &&\r\n          dateCheck1 !== undefined\r\n        ) {\r\n          setAlertBoxTime(true);\r\n          setTimeout(function () {\r\n            setAlertBoxTime(false);\r\n          }, 1000);\r\n        } else {\r\n          setShow(false);\r\n          const newElement = {\r\n            id: uniqid,\r\n            title: title,\r\n            start: startTime,\r\n            end: endTime,\r\n            color: statusColor,\r\n          };\r\n          setEvents([...events, newElement]);\r\n          setTitle(\"\");\r\n        }\r\n      } else {\r\n        setAlertBoxTime(true);\r\n        setTimeout(function () {\r\n          setAlertBoxTime(false);\r\n        }, 1000);\r\n      }\r\n    } else {\r\n      setAlertBoxTime(true);\r\n      setTimeout(function () {\r\n        setAlertBoxTime(false);\r\n      }, 1000);\r\n    }\r\n  };\r\n  const AddEvent = ({ start, end, slots }) => {\r\n    setAlertBoxTime(false);\r\n    let preDateTime = new Date();\r\n    let milliseconds = Date.parse(preDateTime);\r\n    milliseconds = milliseconds - 1 * 60 * 1000;\r\n    preDateTime = new Date(milliseconds);\r\n\r\n    if (\r\n      start.getDay() === days[0] ||\r\n      start.getDay() === days[1] ||\r\n      start.getDay() === days[2] ||\r\n      start.getDay() === days[3] ||\r\n      start.getDay() === days[4] ||\r\n      start.getDay() === days[5] ||\r\n      start.getDay() === days[6]\r\n    ) {\r\n      console.log(\"not active day\");\r\n    } else {\r\n      // active days\r\n      let beforeTime = moment(start).format(\"HH:mm\");\r\n      let afterTime = moment(end).format(\"HH:mm\");\r\n      let dateCheck = events.filter((item) => {\r\n        return (\r\n          moment(item.start).format(\"DD/MM/YYYY HH:mm\") === beforeTime &&\r\n          moment(item.end).format(\"DD/MM/YYYY HH:mm\") === afterTime\r\n        );\r\n      });\r\n      if (dateCheck.length === 0 && overlap) {\r\n        if (start > preDateTime && start < end) {\r\n          if (slots.length >= 2) {\r\n            var format = \"HH:mm\";\r\n            let time = moment(start, format);\r\n            let beforeTime = moment(start).format(\"HH:mm\");\r\n            let afterTime = moment(end).format(\"HH:mm\");\r\n            let checkDiff = time.isBetween(beforeTime, afterTime);\r\n            if (\r\n              beforeTime !== \"17:00\" &&\r\n              beforeTime !== \"17:30\" &&\r\n              checkDiff === false\r\n            ) {\r\n              setShow(!show);\r\n              setStartTime(start);\r\n              setEndTime(end);\r\n              let getstart = String(start);\r\n              let getend = String(end);\r\n              getstart = getstart.slice(16, 21);\r\n              getend = getend.slice(16, 21);\r\n              setstarttimeslice(getstart);\r\n              setEndtimeslice(getend);\r\n            } else {\r\n              return false;\r\n            }\r\n          } else {\r\n            setShow(!show);\r\n            setStartTime(start);\r\n            setEndTime(end);\r\n            let getstart = String(start);\r\n            let getend = String(end);\r\n            getstart = getstart.slice(16, 21);\r\n            getend = getend.slice(16, 21);\r\n            setstarttimeslice(getstart);\r\n            setEndtimeslice(getend);\r\n          }\r\n        } else {\r\n          setAlertBoxTime(true);\r\n          setTimeout(function () {\r\n            setAlertBoxTime(false);\r\n          }, 2000);\r\n          // console.log(\"disable time clicked\");\r\n        }\r\n      } else {\r\n        console.log(\"disable time clicked\");\r\n      }\r\n    }\r\n  };\r\n\r\n  const statusColorChange = (event) => {\r\n    setValue(event.target.value);\r\n  };\r\n  const handlePopoverClose = () => setpopoverShow(false);\r\n  const handleEditEvent = () => {\r\n    setpopoverShow(!popoverShow);\r\n    setShowEdit(true);\r\n    setAlertBoxTime(false);\r\n    const fill = events.filter((e) => e.id === eventID);\r\n    setTitleEdit(fill[0].title);\r\n    let getstart = String(fill[0].start);\r\n    let getend = String(fill[0].end);\r\n    setStartTimeEdit(getstart);\r\n    setEndTimeEdit(getend);\r\n    setStatusColorEdit(fill[0].color);\r\n    // Start slice a time\r\n    getstart = getstart.slice(16, 21);\r\n    getend = getend.slice(16, 21);\r\n    setstarttimesliceEdit(getstart);\r\n    setEndtimesliceEdit(getend);\r\n    // End slice a time\r\n  };\r\n  const handleDeleteEvent = () => {\r\n    const fill = events.filter((e) => e.id !== eventID);\r\n    setEvents(fill);\r\n    setpopoverShow(!popoverShow);\r\n  };\r\n  // const handlePopoverShow = (event) => {\r\n  //   // admin code Start\r\n  //   seteventID(event.id);\r\n  //   const fill = events.filter((e) => e.id === event.id);\r\n  //   setEvent(fill[0]);\r\n  //   setpopoverShow(!popoverShow);\r\n  //   // admin code end\r\n  // };\r\n  const bookingSlot = (event) => {\r\n    // booking Event\r\n    setbookingslot(true);\r\n    const fill = events.filter((e) => e.id === event.id);\r\n    setbookingEvent(fill[0]);\r\n    setBookingstartTime(fill[0].start);\r\n    setBookingEndTime(fill[0].end);\r\n\r\n    /* show time start */\r\n    let getstart = String(fill[0].start);\r\n    let getend = String(fill[0].end);\r\n    getstart = getstart.slice(16, 21);\r\n    getend = getend.slice(16, 21);\r\n\r\n    setBookingstartTimeslice(getstart);\r\n    setBookingendTimeslice(getend);\r\n    /* show time End  */\r\n  };\r\n  const saveBooking = () => {\r\n    /* start time*/\r\n    bookingstartTime = String(bookingstartTime);\r\n    bookingstartTimeslice = String(bookingstartTimeslice);\r\n    bookingstartTime = Array.from(bookingstartTime);\r\n    bookingstartTimeslice = Array.from(bookingstartTimeslice);\r\n    bookingstartTime[16] = bookingstartTimeslice[0];\r\n    bookingstartTime[17] = bookingstartTimeslice[1];\r\n    bookingstartTime[18] = bookingstartTimeslice[2];\r\n    bookingstartTime[19] = bookingstartTimeslice[3];\r\n    bookingstartTime[20] = bookingstartTimeslice[4];\r\n    bookingstartTime = String(bookingstartTime);\r\n    bookingstartTime = bookingstartTime.replace(/,/g, \"\");\r\n    bookingstartTime = new Date(bookingstartTime);\r\n    /* start time*/\r\n    /* End  time*/\r\n    bookingEndTime = String(bookingEndTime);\r\n    bookingendTimeslice = String(bookingendTimeslice);\r\n    bookingEndTime = Array.from(bookingEndTime);\r\n    bookingendTimeslice = Array.from(bookingendTimeslice);\r\n    bookingEndTime[16] = bookingendTimeslice[0];\r\n    bookingEndTime[17] = bookingendTimeslice[1];\r\n    bookingEndTime[18] = bookingendTimeslice[2];\r\n    bookingEndTime[19] = bookingendTimeslice[3];\r\n    bookingEndTime[20] = bookingendTimeslice[4];\r\n    bookingEndTime = String(bookingEndTime);\r\n    bookingEndTime = bookingEndTime.replace(/,/g, \"\");\r\n    bookingEndTime = new Date(bookingEndTime);\r\n    /* End time*/\r\n    // let uniqid = Math.random();\r\n    // const newElement = {\r\n    //   p_id: bookingEvent.id,\r\n    //   id: uniqid,\r\n    //   title: bookingTitle,\r\n    //   start: bookingstartTime,\r\n    //   end: bookingEndTime,\r\n    //   color: statusbooking,\r\n    // };\r\n    if (\r\n      bookingEvent.start <= bookingstartTime &&\r\n      bookingEvent.end >= bookingEndTime\r\n    ) {\r\n      console.log(\"Add time in array \");\r\n    } else {\r\n      setAlertBoxTime(true);\r\n      setTimeout(function () {\r\n        setAlertBoxTime(false);\r\n      }, 1000);\r\n    }\r\n  };\r\n  // const statusBookingChange = (event) => {\r\n  //   setStatusbooking(event.target.value);\r\n  // };\r\n  function Alertbox(props) {\r\n    return (\r\n      <Alert\r\n        show={alertBoxTime}\r\n        variant=\"danger\"\r\n        onClose={() => setAlertBoxTime(!alertBoxTime)}\r\n        dismissible\r\n      >\r\n        {props.message}\r\n      </Alert>\r\n    );\r\n  }\r\n  const customDayPropGetter = (date) => {\r\n    // console.log(getWeekDay(new Date()));\r\n\r\n    if (\r\n      date.getDay() === days[0] ||\r\n      date.getDay() === days[1] ||\r\n      date.getDay() === days[2] ||\r\n      date.getDay() === days[3] ||\r\n      date.getDay() === days[4] ||\r\n      date.getDay() === days[5] ||\r\n      date.getDay() === days[6]\r\n    )\r\n      return {\r\n        className: \"special-day\",\r\n        style: {\r\n          backgroundColor: \"#EBEBE4\",\r\n        },\r\n      };\r\n    else return {};\r\n  };\r\n  return (\r\n    <>\r\n      {/* <div className=\"row \">\r\n        <div className=\"col-md-2\"></div>\r\n        <div className=\"col-md-2\"></div>\r\n        <div className=\"col-md-2\"></div>\r\n        <div className=\"col-md-6\">\r\n          <div\r\n            style={{\r\n              display: \"flex\",\r\n              \"flex-direction\": \"row\",\r\n              \"margin-top\": \"10px\",\r\n              \"align-items\": \"center\",\r\n              \"margin-bottom\": \"10px\",\r\n            }}\r\n          >\r\n            <span\r\n              style={{\r\n                \"background-color\": \"#FFFF00\",\r\n                height: \"20px\",\r\n                width: \"20px\",\r\n              }}\r\n            ></span>\r\n            <span style={{ \"margin-left\": \"10px\" }}>Pending validation</span>\r\n            <span\r\n              style={{\r\n                \"background-color\": \"#808080\",\r\n                height: \"20px\",\r\n                width: \"20px\",\r\n                \"margin-left\": \"10px\",\r\n              }}\r\n            ></span>\r\n            <span style={{ \"margin-left\": \"10px\" }}>Not availble</span>\r\n            <span\r\n              style={{\r\n                \"background-color\": \"#008000\",\r\n                height: \"20px\",\r\n                width: \"20px\",\r\n                \"margin-left\": \"10px\",\r\n              }}\r\n            ></span>\r\n            <span style={{ \"margin-left\": \"10px\" }}>Validate</span>\r\n            \r\n            <div style={{ \"margin-left\": \"auto\", \"margin-right\": \"10px\" }}>\r\n              <OverLapSelect\r\n                overlap={overlap}\r\n                overlapOpen={overlapOpen}\r\n                handleOpen={handleOverLapOpen}\r\n                handleClose={handleOverLapClose}\r\n                handleChange={handleOverLapChange}\r\n              />\r\n            </div>\r\n          </div>\r\n          <div className=\"Custom_weekdays\">\r\n            <label>Work week</label>\r\n            <FormGroup row>\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Sunday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Sunday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Sunday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Monday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Monday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Monday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Tuesday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Tuesday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Tuesday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Wednesday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Wednesday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Wednesday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Thursday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Thursday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Thursday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Friday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Friday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Friday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Saturday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Saturday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Saturday\"\r\n              />\r\n            </FormGroup>\r\n          </div>\r\n        </div>\r\n      </div> */}\r\n      <Modal show={bookingslot} onHide={() => setbookingslot(false)} centered>\r\n        <Modal.Header closeButton style={{ border: \"none\" }}>\r\n          <Modal.Title className=\"text-center w-100\">BOOKING</Modal.Title>\r\n        </Modal.Header>\r\n        <Alertbox message=\"Invalid Time\" />\r\n        <Modal.Body>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-12\">\r\n              <input\r\n                type=\"text\"\r\n                style={{ border: \"1px solid #707070\" }}\r\n                placeholder=\"Company : ConstructBTP\"\r\n                className=\"w-100 p-2 mb-2\"\r\n              />\r\n            </div>\r\n          </div>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-12\">\r\n              <div className=\"starttime\">\r\n                <label>Start time</label>\r\n                <TimePicker\r\n                  value={bookingstartTimeslice}\r\n                  onChange={(e) => setBookingstartTimeslice(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n              {/* <div class=\"form-group statusColor\">\r\n                <label>Status Color </label>\r\n\r\n                <FormControl component=\"fieldset\">\r\n                  <RadioGroup\r\n                    aria-label=\"statusColor\"\r\n                    name=\"statusColor\"\r\n                    value={statusbooking}\r\n                    onChange={statusBookingChange}\r\n                  >\r\n                    <FormControlLabel\r\n                      value=\"#FFFF00\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusbooking(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Pending validation\"\r\n                      className=\"pending\"\r\n                    />\r\n\r\n                    <FormControlLabel\r\n                      value=\"#808080\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusbooking(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Not availble\"\r\n                      className=\"notAvailble\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#008000\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusbooking(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Validate\"\r\n                      className=\"validate\"\r\n                    />\r\n                  </RadioGroup>\r\n                </FormControl>\r\n              </div> */}\r\n            </div>\r\n            <div className=\"col-md-12\">\r\n              <div className=\"endTime\">\r\n                <label>End Time</label>\r\n                <TimePicker\r\n                  value={bookingendTimeslice}\r\n                  onChange={(e) => setBookingendTimeslice(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row pt-3\">\r\n            <div className=\"col-md-12\">\r\n              <div className=\"description\">\r\n                <div className=\"form-group \">\r\n                  {/* <label for=\"exampleFormControlTextarea1\">Add message</label> */}\r\n                  <textarea\r\n                    className=\"form-control\"\r\n                    id=\"exampleFormControlTextarea1\"\r\n                    placeholder=\"Reason of booking\"\r\n                    rows=\"3\"\r\n                    value={bookingTitle}\r\n                    onChange={(e) => setBookingTitle(e.target.value)}\r\n                  ></textarea>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </Modal.Body>\r\n        <Modal.Footer style={{ border: \"none\" }}>\r\n          <button\r\n            className=\"w-100 py-2\"\r\n            onClick={saveBooking}\r\n            style={{\r\n              color: \"#fff\",\r\n              backgroundColor: \"#DBB20A\",\r\n              border: \"none\",\r\n              borderRadius: \"5px\",\r\n            }}\r\n          >\r\n            Book\r\n          </button>\r\n          {/* <Button variant=\"primary\" onClick={saveBooking}>\r\n            Add Booking\r\n          </Button>\r\n          <Button variant=\"secondary\" onClick={() => setbookingslot(false)}>\r\n            Close\r\n          </Button> */}\r\n        </Modal.Footer>\r\n      </Modal>\r\n      <Modal show={show} onHide={() => setShow(false)}>\r\n        <Modal.Header closeButton>\r\n          <Modal.Title>Add Event</Modal.Title>\r\n        </Modal.Header>\r\n        <Alertbox message=\"Please Add valid Time and Event\" />\r\n        <Modal.Body>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-12\">\r\n              <div className=\"description\">\r\n                <div class=\"form-group\">\r\n                  <label for=\"exampleFormControlTextarea1\">Add Event</label>\r\n                  <textarea\r\n                    class=\"form-control\"\r\n                    id=\"exampleFormControlTextarea1\"\r\n                    rows=\"3\"\r\n                    onChange={(e) => setTitle(e.target.value)}\r\n                  ></textarea>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-6\">\r\n              <div className=\"starttime\">\r\n                <label>Start time</label>\r\n                <TimePicker\r\n                  value={starttimeslice}\r\n                  onChange={(e) => setstarttimeslice(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n              <div class=\"form-group statusColor\">\r\n                <label>Status Color </label>\r\n                <FormControl component=\"fieldset\">\r\n                  <RadioGroup\r\n                    aria-label=\"gender\"\r\n                    name=\"statusColor\"\r\n                    value={statusColor}\r\n                    onChange={statusColorChange}\r\n                  >\r\n                    <FormControlLabel\r\n                      value=\"#FFFF00\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColor(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Pending validation\"\r\n                      className=\"pending\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#808080\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColor(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Not availble\"\r\n                      className=\"notAvailble\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#008000\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColor(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Validate\"\r\n                      className=\"validate\"\r\n                    />\r\n                  </RadioGroup>\r\n                </FormControl>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-md-6\">\r\n              <div className=\"endTime\">\r\n                <label>End Time</label>\r\n                <TimePicker\r\n                  value={Endtimeslice}\r\n                  onChange={(e) => setEndtimeslice(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </Modal.Body>\r\n        <Modal.Footer>\r\n          <Button variant=\"primary\" onClick={saveEvent}>\r\n            Save Event\r\n          </Button>\r\n          <Button variant=\"secondary\" onClick={handleClose}>\r\n            Close\r\n          </Button>\r\n        </Modal.Footer>\r\n      </Modal>\r\n      <Modal show={showEdit} onHide={() => setShowEdit(false)}>\r\n        <Modal.Header closeButton>\r\n          <Modal.Title>Edit Event </Modal.Title>\r\n        </Modal.Header>\r\n        <Alertbox message=\"Please Add valid Time and Event\" />\r\n        <Modal.Body>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-12\">\r\n              <div className=\"description\">\r\n                <div class=\"form-group\">\r\n                  <label for=\"exampleFormControlTextarea1\">Edit Event</label>\r\n                  <textarea\r\n                    class=\"form-control\"\r\n                    id=\"exampleFormControlTextarea1\"\r\n                    rows=\"3\"\r\n                    value={titleEdit}\r\n                    onChange={(e) => setTitleEdit(e.target.value)}\r\n                  ></textarea>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-6\">\r\n              <div className=\"starttime\">\r\n                <label>Start time</label>\r\n                <TimePicker\r\n                  value={starttimesliceEdit}\r\n                  onChange={(e) => setstarttimesliceEdit(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n              <div class=\"form-group statusColor\">\r\n                {value && \"\"}\r\n                <label>Status Color </label>\r\n                <FormControl component=\"fieldset\">\r\n                  <RadioGroup\r\n                    aria-label=\"statusColor\"\r\n                    name=\"statusColor\"\r\n                    value={statusColorEdit}\r\n                    onChange={statusColorChange}\r\n                  >\r\n                    <FormControlLabel\r\n                      value=\"#FFFF00\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColorEdit(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Pending validation\"\r\n                      className=\"pending\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#808080\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColorEdit(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Not availble\"\r\n                      className=\"notAvailble\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#008000\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColorEdit(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Validate\"\r\n                      className=\"validate\"\r\n                    />\r\n                  </RadioGroup>\r\n                </FormControl>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-md-6\">\r\n              <div className=\"endTime\">\r\n                <label>End Time</label>\r\n                <TimePicker\r\n                  value={endtimesliceEdit}\r\n                  onChange={(e) => setEndtimesliceEdit(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </Modal.Body>\r\n        <Modal.Footer>\r\n          <Button variant=\"primary\" onClick={updateEvent}>\r\n            Update Event\r\n          </Button>\r\n          <Button variant=\"secondary\" onClick={() => setShowEdit(false)}>\r\n            Close\r\n          </Button>\r\n        </Modal.Footer>\r\n      </Modal>\r\n\r\n      <div className=\"pt-5\">\r\n        <PopoverModal\r\n          popoverShow={popoverShow}\r\n          handlePopoverClose={handlePopoverClose}\r\n          handleDeleteEvent={handleDeleteEvent}\r\n          handleEditEvent={handleEditEvent}\r\n          event={event}\r\n        />\r\n        <div style={{}} className=\"pl-2 pt-3 pb-5 d-flex\">\r\n          <FormSelect\r\n            placeholder=\"Mean\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            onChange={(e) => {\r\n              console.log(\"area ==> \", e.target.value);\r\n            }}\r\n            style={{ marginRight: \"10px\", maxWidth: 250 }}\r\n          />\r\n          <div style={{ width: \"25%\", marginLeft: \"20px\" }}>\r\n            <DatePicker\r\n              showPopperArrow={true}\r\n              dateFormat=\"yyyy-MM-dd\"\r\n              selected={startDate}\r\n              popperPlacement=\"top-start\"\r\n              showYearDropdown\r\n              minDate={addDays(new Date(), 1)}\r\n              placeholderText=\"Delivery date\"\r\n              onChange={(date) => {\r\n                setStartDate(date);\r\n              }}\r\n            />\r\n          </div>\r\n        </div>\r\n        <div className=\"d-flex px-2\">\r\n          <div style={{ flexBasis: \"75%\" }}>\r\n            <Calendar\r\n              popup\r\n              selectable\r\n              formats={formats}\r\n              localizer={localizer}\r\n              events={events}\r\n              views={view}\r\n              step={60}\r\n              timeslots={1}\r\n              // onSelectEvent={handlePopoverShow}\r\n              onSelectEvent={bookingSlot}\r\n              onSelecting={false}\r\n              onSelectSlot={AddEvent}\r\n              // onSelectSlot={AddAvailability}\r\n              startAccessor=\"start\"\r\n              endAccessor=\"end\"\r\n              style={{\r\n                width: \"100%\",\r\n\r\n                height: \"470px\",\r\n              }}\r\n              eventPropGetter={(events, start, end, isSelected) => {\r\n                let newStyle = {\r\n                  backgroundColor: events[\"color\"],\r\n                  color: \"black\",\r\n                  borderRadius: \"0px\",\r\n                  border: \"none\",\r\n                };\r\n\r\n                if (events.isMine) {\r\n                  newStyle.backgroundColor = \"lightgreen\";\r\n                }\r\n\r\n                return {\r\n                  className: \"\",\r\n                  style: newStyle,\r\n                };\r\n              }}\r\n              messages={{\r\n                date: \"Date\",\r\n                time: \"Time\",\r\n                event: \"Event\",\r\n                allDay: \"All Day\",\r\n                week: \"week\",\r\n                work_week: \"Work Week\",\r\n                day: \"Day\",\r\n                month: \"Month\",\r\n                previous: \"Previous\",\r\n                next: \"Next\",\r\n                yesterday: \"Yesterday\",\r\n                tomorrow: \"Tomorrow\",\r\n                today: \"Today\",\r\n                agenda: \"Agenda\",\r\n                noEventsInRange: \"There are no events in this range.\",\r\n                showMore: function (e) {\r\n                  return \"+\" + e + \" more\";\r\n                },\r\n              }}\r\n              custom_week_days={days}\r\n              dayPropGetter={customDayPropGetter}\r\n            />\r\n          </div>\r\n          <div style={{ flexBasis: \"25%\", margin: \"0 20px 0px 10px\" }}>\r\n            <div className=\"calender-sidebar pt-5\">\r\n              <div className=\"text-center w-100 calender-sidebar-heading pb-3\">\r\n                BOOKING\r\n              </div>\r\n              <div className=\"row\">\r\n                <div className=\"col-md-12\">\r\n                  <input\r\n                    disabled\r\n                    type=\"text\"\r\n                    style={{ border: \"1px solid #707070\", textAlign: \"center\" }}\r\n                    placeholder=\"Lundi 03 Septembre 2020\"\r\n                    className=\"w-100 p-2\"\r\n                    value={cdate}\r\n                    onChange={(e) => setCdate(e.target.value)}\r\n                  />\r\n                </div>\r\n              </div>\r\n              <div className=\"row mt-3\">\r\n                <div className=\"col-md-12\">\r\n                  <div className=\"starttime\">\r\n                    <FormSelect\r\n                      placeholder=\"ConstructBTP\"\r\n                      values={[\r\n                        { value: \"green\", label: \"Green\" },\r\n                        { value: \"Yellow\", label: \"Yellow\" },\r\n                        { value: \"Red\", label: \"Red\" },\r\n                        { value: \"Blue\", label: \"Blue\" },\r\n                        { value: \"Orange\", label: \"Orange\" },\r\n                        { value: \"Purple\", label: \"Purple\" },\r\n                        { value: \"Magenta\", label: \"Magenta\" },\r\n                      ]}\r\n                      onChange={(e) => {\r\n                        console.log(\"area ==> \", e.target.value);\r\n                      }}\r\n                      style={{ maxWidth: 300 }}\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"col-md-12 mt-3\">\r\n                  <div className=\"endTime\">\r\n                    <FormSelect\r\n                      placeholder=\"Start hour\"\r\n                      values={[\r\n                        { value: \"green\", label: \"Green\" },\r\n                        { value: \"Yellow\", label: \"Yellow\" },\r\n                        { value: \"Red\", label: \"Red\" },\r\n                        { value: \"Blue\", label: \"Blue\" },\r\n                        { value: \"Orange\", label: \"Orange\" },\r\n                        { value: \"Purple\", label: \"Purple\" },\r\n                        { value: \"Magenta\", label: \"Magenta\" },\r\n                      ]}\r\n                      onChange={(e) => {\r\n                        console.log(\"area ==> \", e.target.value);\r\n                      }}\r\n                      style={{ maxWidth: 300 }}\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"col-md-12 mt-3\">\r\n                  <div className=\"endTime\">\r\n                    <FormSelect\r\n                      placeholder=\"End hour\"\r\n                      values={[\r\n                        { value: \"green\", label: \"Green\" },\r\n                        { value: \"Yellow\", label: \"Yellow\" },\r\n                        { value: \"Red\", label: \"Red\" },\r\n                        { value: \"Blue\", label: \"Blue\" },\r\n                        { value: \"Orange\", label: \"Orange\" },\r\n                        { value: \"Purple\", label: \"Purple\" },\r\n                        { value: \"Magenta\", label: \"Magenta\" },\r\n                      ]}\r\n                      onChange={(e) => {\r\n                        console.log(\"area ==> \", e.target.value);\r\n                      }}\r\n                      style={{ maxWidth: 300 }}\r\n                    />\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <div className=\"row pt-3\">\r\n                <div className=\"col-md-12\">\r\n                  <div className=\"description\">\r\n                    <div className=\"form-group \">\r\n                      {/* <label for=\"exampleFormControlTextarea1\">Add message</label> */}\r\n                      <textarea\r\n                        className=\"form-control\"\r\n                        id=\"exampleFormControlTextarea1\"\r\n                        placeholder=\"Reason of booking\"\r\n                        rows=\"3\"\r\n                        value={bookingTitle}\r\n                        onChange={(e) => setBookingTitle(e.target.value)}\r\n                      ></textarea>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n\r\n              <div>\r\n                <button\r\n                  className=\"w-100 py-2\"\r\n                  onClick={saveBooking}\r\n                  style={{\r\n                    color: \"#fff\",\r\n                    backgroundColor: \"#DBB20A\",\r\n                    border: \"none\",\r\n                    borderRadius: \"5px\",\r\n                  }}\r\n                >\r\n                  Book\r\n                </button>\r\n              </div>\r\n              {/* <Button variant=\"primary\" onClick={saveBooking}>\r\n            Add Booking\r\n          </Button>\r\n          <Button variant=\"secondary\" onClick={() => setbookingslot(false)}>\r\n            Close\r\n          </Button> */}\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default Calender;\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Stepper.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep3.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep2.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\components\\MyWorkWeek.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\components\\popoverModal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\MeanCalender\\components\\events.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep3.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep2.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\EditSite\\EditSiteStep1.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\SmallButton.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\MultiAdderInput.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\OpeningTimes.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\UnavailabilityTimes.js",["489","490","491"],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\MultiAdderInputModal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\RadioButton.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Input.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Sites\\AddSite\\AddSiteStep1.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\AddClient.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\Invoices.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Clients\\Clients.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\AddUser.js",["492","493","494","495","496","497","498","499","500","501"],"import React, { useState, useEffect } from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\r\nimport TextField from \"@material-ui/core/TextField\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  site: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n});\r\n\r\nexport default function AddUser(props) {\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [page] = useState(1);\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  const [roles, setRoles] = useState([]);\r\n  const [dropdownRoles, setDropdownRoles] = useState([]);\r\n  const [selectedRole, setSelectedRole] = useState(\"\");\r\n  const [selectedRoleIndex, setSelectedRoleIndex] = useState(null);\r\n\r\n  const [siteParams, setSiteParams] = useState([]);\r\n\r\n  const [users, setUsers] = useState([]);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n  }, []);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_USER}/${adminStore.site.siteId._id}/${store.user._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.site_companies.companies);\r\n        setRoles(response.data.site_companies.companies);\r\n        setUsers(response.data.users);\r\n        if (response.data.site_companies != null) {\r\n          const companyTemp = [];\r\n\r\n          response.data.site_companies.companies.map((item, index) => {\r\n            return companyTemp.push({ label: item.name, value: item.name });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n        if (response.data.roles != null) {\r\n          const rolesTemp = [];\r\n\r\n          response.data.roles.map((item, index) => {\r\n            return rolesTemp.push({ label: item, value: item });\r\n          });\r\n          setDropdownRoles(rolesTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getUserCompany = async (userId) => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_USER_COMPANY}/${adminStore.site.siteId._id}/${userId}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        console.log(JSON.stringify(response, null, 2));\r\n        if (response.data) {\r\n          companies.forEach((item, index) => {\r\n            if (item._id === response.data._id) {\r\n              item.users.forEach((innerItem, innerIndex) => {\r\n                console.log(\"innser \", innerItem.userId);\r\n                if (innerItem.userId === userId) {\r\n                  setSelectedRoleIndex(innerIndex);\r\n\r\n                  setSelectedRole(innerItem.role);\r\n                }\r\n              });\r\n              setSelectedCompanyIndex(index);\r\n\r\n              setSelectedCompany(item.name);\r\n            }\r\n          });\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const onSubmit = async () => {\r\n    const values = formik.values;\r\n    const sites = [];\r\n    siteParams.forEach((item) => {\r\n      sites.push({ siteId: item.id, role: selectedRole });\r\n    });\r\n    var formdata = new FormData();\r\n    formdata.append(\"image\", values.logo[0].file);\r\n    //formdata.append(\"name\", values.name);\r\n    formdata.append(\"firstName\", values.firstName);\r\n    formdata.append(\"lastName\", values.lastName);\r\n    formdata.append(\"email\", values.email);\r\n    formdata.append(\"phone\", values.phone);\r\n    formdata.append(\"sites\", JSON.stringify(sites));\r\n    formdata.append(\"companyId\", companies[selectedCompanyIndex]._id);\r\n\r\n    await GLOBALS.API({\r\n      method: \"POST\",\r\n      uri: GLOBALS.Constants.ADD_USER_ADMIN,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      logo: [],\r\n      name: \"\",\r\n      color: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      site: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n    },\r\n    validationSchema: addClientYup,\r\n    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"ADD USER\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={formik.handleSubmit}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"CONTACT INFO* :\" />\r\n            <Form.Row width=\"48%\">\r\n              {/* <FormInput\r\n                name=\"name\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                placeholder=\"Adresse e-mail\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.name}\r\n                error={formik.errors.name}\r\n              /> */}\r\n              <Autocomplete\r\n                id=\"free-solo-demo\"\r\n                freeSolo\r\n                style={{\r\n                  ...GLOBALS.Styles.inputWidth,\r\n                  marginRight: \"10px\",\r\n                }}\r\n                onSelect={(event) => {\r\n                  users.forEach((item, index) => {\r\n                    if (item.userId.email === event.target.value) {\r\n                      console.log(JSON.stringify(item.sites, null, 2));\r\n                      formik.setFieldValue(\"firstName\", item.userId.firstName);\r\n                      formik.setFieldValue(\"lastName\", item.userId.lastName);\r\n                      formik.setFieldValue(\"phone\", item.userId.phone);\r\n                      formik.setFieldValue(\"logo\", [\r\n                        { uri: item.userId.image },\r\n                      ]);\r\n\r\n                      getUserCompany(item.userId._id);\r\n                    }\r\n                  });\r\n                }}\r\n                options={users.map((option) => {\r\n                  if (option.userId.email != undefined)\r\n                    return option.userId.email;\r\n                })}\r\n                renderInput={(params) => (\r\n                  <TextField\r\n                    {...params}\r\n                    label=\"Email\"\r\n                    margin=\"normal\"\r\n                    variant=\"outlined\"\r\n                    name=\"email\"\r\n                    value={formik.values.email}\r\n                    error={formik.errors.email}\r\n                    onChange={formik.handleChange}\r\n                  />\r\n                )}\r\n              />\r\n              <FormInput\r\n                name=\"phone\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                placeholder=\"Téléphone\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.phone}\r\n                error={formik.errors.phone}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"INDENTITY* :\" />\r\n            <Form.Row width=\"48%\">\r\n              <FormInput\r\n                name=\"firstName\"\r\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\r\n                placeholder=\"FIRST NAME\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.firstName}\r\n                error={formik.errors.firstName}\r\n              />\r\n              <FormInput\r\n                name=\"lastName\"\r\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\r\n                placeholder=\"LAST NAME\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.lastName}\r\n                error={formik.errors.name}\r\n              />\r\n              <FormMultipleUpload\r\n                name=\"logo\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                error={formik.errors.logo}\r\n                values={formik.values.logo}\r\n                onChange={(values) =>\r\n                  formik.handleChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"logo\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"COMPANY : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormSelect\r\n                placeholder=\"Company\"\r\n                values={dropdownCompanies}\r\n                value={selectedCompany}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedCompanyIndex(index);\r\n\r\n                    setSelectedCompany(item);\r\n                  } else {\r\n                    setSelectedCompanyIndex(null);\r\n\r\n                    setSelectedCompany(\"\");\r\n                  }\r\n                }}\r\n                style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"RÔLE : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormSelect\r\n                placeholder=\"RÔLE : \"\r\n                name=\"color\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={formik.handleChange}\r\n                value={formik.values.color}\r\n                error={formik.errors.color}\r\n                values={dropdownRoles}\r\n                value={selectedRole}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedRoleIndex(index);\r\n\r\n                    setSelectedRole(item);\r\n                  } else {\r\n                    setSelectedRoleIndex(null);\r\n\r\n                    setSelectedRole(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"CONSTRUCTION SITE : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormInput\r\n                name=\"site\"\r\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\r\n                placeholder=\"Site\"\r\n                onChange={formik.handleChange}\r\n                value={formik.values.site}\r\n                error={formik.errors.site}\r\n                disabled={true}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              minWidth={200}\r\n              text=\"CONTINUER\"\r\n              fullWidth={false}\r\n              onClick={() => {\r\n                onSubmit();\r\n              }}\r\n              loading={formik.isSubmitting}\r\n              disabled={formik.isSubmitting}\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\EditCompanies.js",["502","503","504","505","506","507","508","509","510","511","512","513","514","515","516","517","518"],"import React, {useState} from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport MultiAdderInput from \"../../../components/MultiAdderInput\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n  error: {\r\n    color: \"red\",\r\n  },\r\n  radioLabel: {\r\n    marginLeft: \"7px\",\r\n    color: \"#7E7878\",\r\n    marginRight: \"50px\"\r\n\r\n  },\r\n  radioBtn: {\r\n\r\n  }\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function EditCompanies(props) {\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const [name, setName] = useState(\"\");\r\n  const [nameError, setNameError] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [colorError, setColorError] = useState(\"\");\r\n  const [images, setImages] = useState([]);\r\n  const [companyType, setCompanyType] = useState(\"\");\r\n  const [companyTypeError, setCompanyTypeError] = useState(\"\");\r\n  const [contract, setContract] = useState(\"\");\r\n  const [contractError, setContractError] = useState(\"\");\r\n  const [typeError, setTypeError] = useState(\"\");\r\n  const [trades, setTrades] = useState([]);\r\n  const [update, setUpdate] = useState(false);\r\n  const [email, setEmail] = useState(\"\");\r\n  const [emailError, setEmailError] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [phoneError, setPhoneError] = useState(\"\");\r\n  const [fname, setFname] = useState(\"\");\r\n  const [lname, setLname] = useState(\"\");\r\n  const [website, setWebsite] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n\r\n\r\n\r\n\r\n  const inputChange = (e) => {\r\n    if (e.target.name === \"companyType\") {\r\n      setCompanyType(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setCompanyTypeError(true);\r\n      } else {\r\n        setCompanyTypeError(false);\r\n      }\r\n    }\r\n   \r\n    if (e.target.name === \"email\") {\r\n      setEmail(e.target.value);\r\n      var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n      if (!e.target.value.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"addInfo\") {\r\n      setAddInfo(e.target.value);\r\n    }\r\n   \r\n  };\r\n\r\n\r\n  // const onSubmit = async (values) => {\r\n  //   const notificationTo = values.notificationTo.map((item) => item.label);\r\n\r\n  //   var formdata = new FormData();\r\n  //   formdata.append(\"logo\", values.logo[0].file);\r\n  //   formdata.append(\"name\", values.name);\r\n  //   formdata.append(\"color\", values.color);\r\n  //   formdata.append(\"firstName\", values.firstName);\r\n  //   formdata.append(\"lastName\", values.lastName);\r\n  //   formdata.append(\"email\", values.email);\r\n  //   formdata.append(\"phone\", values.phone);\r\n  //   formdata.append(\"contractType\", values.contractType);\r\n  //   formdata.append(\"contractStartDate\", values.contractStartDate);\r\n  //   formdata.append(\"contractEndDate\", values.contractEndDate);\r\n  //   formdata.append(\"functionality\", values.functionality);\r\n  //   formdata.append(\"additionalInfo\", values.additionalInfo);\r\n  //   formdata.append(\"notificationPriorToDays\", values.notificationPriorToDays);\r\n  //   formdata.append(\"notificationTo\", JSON.stringify(notificationTo));\r\n\r\n  //   await GLOBALS.API({\r\n  //     method: \"POST\",\r\n  //     uri: GLOBALS.Constants.CLIENTS,\r\n  //     headers: {\r\n  //       Authorization: store.token,\r\n  //     },\r\n  //     body: formdata,\r\n  //   });\r\n  //   formik.setSubmitting(false);\r\n  //   props.history.push(\"/clients\");\r\n  // };\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"trades\") {\r\n     if(value !== \"\"){\r\n      setUpdate((st) => !st);\r\n      setTrades(value);\r\n      console.log(\"trades\", trades);\r\n    }\r\n     }\r\n  }\r\n\r\n  const submitHandler = (e) => {\r\n    var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n    e.preventDefault();\r\n   \r\n    // if (\r\n    //   companyType === \"\" ||\r\n    //   companyType === null ||\r\n    //   companyType === undefined\r\n    // ) {\r\n    //   setCompanyTypeError(true);\r\n    // }\r\n   \r\n    if (email !== \"\") {\r\n      if (!email.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n  else {\r\n      console.log(\"contarct submit\", companyType);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"EDIT A COMPANY\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"name\"\r\n                  disabled\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Company name\"\r\n                  value={name}\r\n                />\r\n                {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"color\"\r\n                  disabled\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Color\"\r\n                  value={color}\r\n                />\r\n                {colorError && (\r\n                  <div className={classes.error}>Please enter color</div>\r\n                )}\r\n              </div>\r\n              <FormMultipleUpload\r\n                name=\"images\"\r\n                \r\n                style={GLOBALS.Styles.inputWidth}\r\n                multiple\r\n                values={images}\r\n                onChange={(values) =>\r\n                  inputChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"images\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n                // onChange={inputChange}\r\n                // onChange={(values) =>\r\n                \r\n                   \r\n                //      ( {type: \"text\",\r\n                //       name: \"trades\",\r\n                //       value: values})\r\n                   \r\n               \r\n                // }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF COMPANY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div>\r\n                <div onChange={inputChange}>\r\n                  <input\r\n                  className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"generalcontractor\"\r\n                    name=\"companyType\"\r\n                    value=\"generalcontractor\"\r\n                  />\r\n                  <label for=\"generalcontractor\" className={classes.radioLabel}>General Contractor</label>\r\n                  <input\r\n                  className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"subcontractor\"\r\n                    name=\"companyType\"\r\n                    value=\"subcontractor\"\r\n                  />\r\n                  <label for=\"subcontractor\" className={classes.radioLabel}>Sub contractor</label>\r\n                </div>\r\n                {companyTypeError === true && (\r\n                  <div className={classes.error}>Please select company</div>\r\n                )}\r\n              </div>\r\n\r\n              {/* <RadioButton\r\n                name=\"contractType\"\r\n                style={{width: '80%'}}\r\n                value={formik.values.contractType}\r\n                error={formik.errors.contractType}\r\n                onChange={formik.handleChange}\r\n                items={[\r\n                  { value: \"GENERALCONTRACTOR\", label: \"General Contractor\" },\r\n                  { value: \"Subcontractor\", label: \"Subcontract\" },\r\n                ]}\r\n              /> */}\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"GENERAL CONTRACTOR : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"100%\", height: \"100%\" }}>\r\n                <select\r\n                  name=\"contract\"\r\n                  disabled\r\n                  id=\"contract\"\r\n                  type={contract}\r\n                  style={{ width: \"40%\", height: \"45px\", color: \"#8B8989\", padding: '0px 10px' }}\r\n                  onChange={inputChange}\r\n                >\r\n                  <option value=\"\">List</option>\r\n                  <option value=\"Yellow\">Yellow</option>\r\n                  <option value=\"Red\">Red</option>\r\n                  <option value=\"Blue\">Blue</option>\r\n                </select>\r\n                {contractError === true && (\r\n                  <div className={classes.error}>Please select contract</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TRADES : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n            <MultiAdderInput\r\n              name=\"trades\"\r\n              values={trades}\r\n              validateError=\"Please enter trades\"\r\n              placeholder=\"Trades\"\r\n              style={{width: \"40%\"}}\r\n              // disabled={contractType !== \"MASTERCLIENT\"}\r\n              onChange={(values) => handleChange(\"trades\", values)}\r\n              validate={(text) => {\r\n                if(text !== \"\"){\r\n                  return false;\r\n                }\r\n                else{\r\n                  return true;\r\n                }\r\n              }}\r\n            />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDEMTITY OF RESPONSIBLE* : \" />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"email\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Adresse e-mail\"\r\n                  onChange={inputChange}\r\n                  value={email}\r\n                />\r\n                {emailError === true && (\r\n                  <div className={classes.error}>Please enter valid email</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"phone\"\r\n                  disabled\r\n                  type=\"number\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Téléphone\"\r\n                  onChange={inputChange}\r\n                  value={phone}\r\n                />\r\n                {phoneError === true && (\r\n                  <div className={classes.error}>\r\n                    Telephone should be 11 digits\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"fname\"\r\n                  disabled\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"First Name\"\r\n                  onChange={(e) => setFname(e.target.value)}\r\n                  value={fname}\r\n                />\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"lname\"\r\n                  disabled\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Last Name\"\r\n                  onChange={(e) => setLname(e.target.value)}\r\n                  value={lname}\r\n                />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"Website : \" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                name=\"website\"\r\n                disabled\r\n                style={{width: '50%'}}\r\n                placeholder=\"http://\"\r\n                onChange={(e) => setWebsite(e.target.value)}\r\n                value={website}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\r\n            <Form.Row width=\"55%\">\r\n            <FormInput\r\n              textArea\r\n              rows={3}\r\n              style={{width: '90%'}}\r\n              onChange={(e) => setAddInfo(e.target.value)}\r\n              placeholder=\"Informations complémentaires\"\r\n              name=\"addInfo\"\r\n              value={addInfo}\r\n            />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              type=\"submit\"\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              // disabled={\r\n              //   name === \"\" ||\r\n              //   color === \"\" ||\r\n              //   companyType === \"\" ||\r\n              //   contract === \"\" ?\r\n              //   true : false\r\n              // }\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\Historic.js",["519","520","521"],"import React, { useState, useEffect } from \"react\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\n// import Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Table from \"../../../components/Table\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport moment from \"moment\";\r\nimport { Images } from \"../../../assets/Assets\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n  link: {\r\n    marginRight: 20,\r\n    whiteSpace: \"nowrap\",\r\n    color: theme.palette.primary.contrastText,\r\n  },\r\n  image: {\r\n    height: 70,\r\n    borderRadius: theme.shape.borderRadius,\r\n  },\r\n}));\r\n\r\nconst Historic = (props) => {\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [isLoading, setLoading] = useState(true);\r\n  const [history, setHistory] = useState([]);\r\n\r\n  const [means, setMeans] = useState([]);\r\n  const [dorpdownMeans, setDropdownMeans] = useState([]);\r\n  const [selectedMean, setSelectedMean] = useState(\"\");\r\n  const [selectedMeanIndex, setSelectedMeanIndex] = useState(null);\r\n\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    filterBooking();\r\n  }, [selectedMeanIndex, selectedCompanyIndex]);\r\n\r\n  const filterBooking = async () => {\r\n    try {\r\n      setLoading(true);\r\n      const params = { siteId: adminStore.site.siteId._id };\r\n      if (selectedMean.length !== 0)\r\n        params[\"meanId\"] = means[selectedMeanIndex]._id;\r\n      if (selectedCompany.length !== 0)\r\n        params[\"companyId\"] = companies[selectedCompanyIndex].companyId._id;\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.FILTER_BOOKING}`,\r\n        token: store.token,\r\n        method: \"POST\",\r\n        body: JSON.stringify(params),\r\n      });\r\n      if (response.success) {\r\n        setHistory(response.data);\r\n\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getData = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_MEAN_HISTORY}/${props.location.mean._id}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setHistory(response.data.history);\r\n        setCompanies(response.data.site_companies);\r\n        if (response.data.site_means != null) {\r\n          setMeans(response.data.site_means);\r\n          let selectedMeanIndex = 0;\r\n\r\n          const temp = [];\r\n          const companyTemp = [];\r\n          response.data.site_means.map((item, index) => {\r\n            if (item._id === props.location.mean._id) {\r\n              selectedMeanIndex = index;\r\n              setSelectedMean(item.name);\r\n            }\r\n            return temp.push({ label: item.name, value: item.name });\r\n          });\r\n          setDropdownMeans(temp);\r\n\r\n          setSelectedMeanIndex(selectedMeanIndex);\r\n\r\n          response.data.site_companies.map((item, index) => {\r\n            return companyTemp.push({\r\n              label: item.companyId.name,\r\n              value: item.companyId.name,\r\n            });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const rows = history.map((item) => {\r\n    return [\r\n      moment(item.startDate).format(\"MM/DD/yyy\") + \" \" + item.startTime,\r\n      moment(item.endDate).format(\"MM/DD/yyy\") + \" \" + item.endTime,\r\n      item.companyId.name,\r\n      item.bookingReason,\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <Form.Row alignItems=\"center\">\r\n        <Heading primary=\"LIST OF MEANS - HISTORIC\" noWrap />\r\n        <div>\r\n          <Form.Row\r\n            alignItems=\"flex-start\"\r\n            noMargin\r\n            justifyContent=\"flex-end\"\r\n            style={{ paddingRight: \"50px\" }}\r\n          >\r\n            <Form.Column style={{ width: \"50%\", marginRight: \"50px\" }}>\r\n              <img src={Images.site} alt=\"\" />\r\n            </Form.Column>\r\n          </Form.Row>\r\n        </div>\r\n      </Form.Row>\r\n      <Form.Row alignItems=\"center\" noMargin>\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          {/* <SearchInput\r\n            placeholder=\"Site name\"\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          /> */}\r\n          <FormSelect\r\n            placeholder=\"Company\"\r\n            values={dropdownCompanies}\r\n            value={selectedCompany}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n\r\n                setSelectedCompanyIndex(index);\r\n\r\n                setSelectedCompany(item);\r\n              } else {\r\n                setSelectedCompanyIndex(null);\r\n\r\n                setSelectedCompany(\"\");\r\n              }\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Mean\"\r\n            values={dorpdownMeans}\r\n            value={selectedMean}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n\r\n                setSelectedMeanIndex(index);\r\n\r\n                setSelectedMean(item);\r\n              } else {\r\n                setSelectedMeanIndex(null);\r\n\r\n                setSelectedMean(\"\");\r\n              }\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\r\n          See archived sites\r\n        </NavLink> */}\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Table headers={GLOBALS.Data.meansOfHistoric.headings} rows={rows} />\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Historic;\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\EditMean.js",["522","523","524","525","526","527","528","529","530","531","532","533","534","535","536","537","538","539","540","541"],"import React, { useState, useEffect } from \"react\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/CustomFormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport CustomInputModal from \"../../../components/CustomInputModal\";\r\nimport CustomButtonModal from \"../../../components/CustomButtonModal\";\r\nimport moment from \"moment\";\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nconst accessabilityPoints = [\r\n  { label: \"Storage Area\", value: \"Storage Area\" },\r\n  { label: \"Delivery Area\", value: \"Delivery Area\" },\r\n];\r\n\r\nexport default function EditMean(props) {\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [name, setName] = useState(\"\");\r\n  const [type, setType] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [image, setImage] = useState([]);\r\n  const [startDate, setStartDate] = useState(\"\");\r\n  const [endDate, setEndDate] = useState(\"\");\r\n  const [techSheet, setTechSheet] = useState([]);\r\n  const [rate, setRate] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n  const [loading, setLoading] = useState(true);\r\n  const [disableDropdpwn, setDisableDropdown] = useState(false);\r\n  const classes = useStyles();\r\n\r\n  const [accessabilityPoint, setAccessabilityPoint] = useState(\"\");\r\n  const [DeliveryAreas, setDeliveryAreas] = useState([]);\r\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\r\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\r\n  const [\r\n    selectedSiteDeliveryAreadIndex,\r\n    seltSelectedSiteDeliveryAreaIndex,\r\n  ] = useState(null);\r\n\r\n  const [storageAreas, setStorageAreas] = useState([]);\r\n  const [dropdownStorageAreas, setDropdownStorageAreas] = useState([]);\r\n  const [\r\n    selectedDropdownStorageArea,\r\n    setSelectedDropdownStorageArea,\r\n  ] = useState(\"\");\r\n  const [selectedStorageAreaIndex, setSelectedStorageAreaIndex] = useState(\r\n    null,\r\n  );\r\n\r\n  const [deliveryAreaId, setDeilveryAreaId] = useState(\"\");\r\n  const [storageAreaId, setStorageAreaId] = useState(\"\");\r\n\r\n  const [\r\n    deliveryAndStorageLocations,\r\n    setDeliveryAndStorageLocations,\r\n  ] = useState([]);\r\n\r\n  const [buildings, setBuidings] = useState([]);\r\n  const [dropdownBuildings, setDropdownBuildings] = useState([]);\r\n  const [selectedDropdownBuilding, setSelectedDropdownBuilding] = useState(\"\");\r\n  const [selectedBuildingIndex, setSelectedBuildingIndex] = useState(null);\r\n\r\n  const [levels, setLevels] = useState([]);\r\n  const [dropdownLevels, setDropdownLevels] = useState([]);\r\n  const [selectedDropdownLevel, setSelectedDropdownLevel] = useState(\"\");\r\n  const [selectedDropdownIndex, setSelectedLevelIndex] = useState(null);\r\n\r\n  const [meanTypes, setMeanTypes] = useState([]);\r\n  const [dropdownMeanTypes, setDropdownMeanTypes] = useState([]);\r\n  const [selectedMeanType, setSelectedMeanType] = useState(\"\");\r\n  const [selecetedMeanTypeIndex, setSelectedMeanTypeIndex] = useState(null);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  const setValues = () => {\r\n    const mean = props.location.mean;\r\n    setName(mean.name);\r\n    let fileClone = [{ uri: mean.image }];\r\n    setImage(fileClone);\r\n    setSelectedMeanType(mean.meanType);\r\n    let meanTypeIndex = 0;\r\n    dropdownMeanTypes.forEach((item, index) => {\r\n      if (item.value === mean.meanType) meanTypeIndex = index;\r\n    });\r\n\r\n    setSelectedMeanTypeIndex(meanTypeIndex);\r\n\r\n    setColor(mean.color);\r\n\r\n    setStartDate(moment(mean.availability.start).format(\"MM/DD/yyyy\"));\r\n    setEndDate(moment(mean.availability.end).format(\"MM/DD/yyyy\"));\r\n    setRate(mean.pricePerHour);\r\n    setAddInfo(mean.additionalInfo);\r\n    const locationTemp = [];\r\n    mean.location.forEach((item, index) => {\r\n      let loc = { key: \"\", label: \"\", id: \"\", type: \"\" };\r\n\r\n      if (item.locationType === \"STORAGEAREA\") {\r\n        loc.key = item.storageArea._id;\r\n        loc.label = item.storageArea.name;\r\n        loc.id = item.storageArea._id;\r\n        loc.type = accessabilityPoints[0].value;\r\n        locationTemp.push(loc);\r\n      }\r\n      if (item.locationType === \"DELIVERYAREA\") {\r\n        loc.key = item.deliveryArea._id;\r\n        loc.label = item.deliveryArea.name;\r\n        loc.id = item.deliveryArea._id;\r\n        loc.type = accessabilityPoints[1].value;\r\n        locationTemp.push(loc);\r\n      }\r\n    });\r\n    setDeliveryAndStorageLocations(locationTemp);\r\n    console.log(JSON.stringify(locationTemp, null, 2));\r\n    // \"key\": \"61615286801076\",\r\n    // \"label\": \"storqg\",\r\n    // \"id\": \"60096007880eb61e9d7188d2\",\r\n    // \"type\": \"Storage Area\"\r\n  };\r\n  useEffect(() => {}, [\r\n    meanTypes,\r\n    dropdownMeanTypes,\r\n    selecetedMeanTypeIndex,\r\n    selectedMeanType,\r\n  ]);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_MEAN}/6008169bedbb7816d40b197d`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.site_delivery_areas !== null) {\r\n          const temp = [];\r\n          response.data.site_delivery_areas.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name, id: item._id }),\r\n          );\r\n          await setDeliveryAreas(response.data.site_delivery_areas);\r\n          await setDropdownDeliveryAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_storage_areas !== null) {\r\n          const temp = [];\r\n          response.data.site_storage_areas.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name, id: item._id }),\r\n          );\r\n          await setStorageAreas(response.data.site_storage_areas);\r\n          await setDropdownStorageAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_buildings !== null) {\r\n          const temp = [];\r\n          response.data.site_buildings.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n          await setBuidings(response.data.site_buildings);\r\n          await setDropdownBuildings(temp);\r\n        }\r\n\r\n        if (response.data.mean_types !== null) {\r\n          const temp = [];\r\n          response.data.mean_types.map((item, index) =>\r\n            temp.push({ label: item, value: item }),\r\n          );\r\n          await setMeanTypes(response.data.mean_types);\r\n          await setDropdownMeanTypes(temp);\r\n        }\r\n        // if (response.data.mean_types !== null) {\r\n        //   setTypes(response.data.mean_types);\r\n        //   const temp = [];\r\n        //   response.data.mean_types.map((item, index) => {\r\n        //     temp.push({ label: item, value: item });\r\n        //   });\r\n        //   setDropdownTypes(temp);\r\n        // }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n      await setValues();\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  function handleChange(name, value) {\r\n    //alert(JSON.stringify(value, null, 2));\r\n    if (name === \"name\") setName(value);\r\n    else if (name === \"type\") setType(value);\r\n    else if (name === \"color\") setColor(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"startDate\") setStartDate(value);\r\n    else if (name === \"endDate\") setEndDate(value);\r\n    else if (name === \"techSheet\") setTechSheet(value);\r\n    else if (name === \"rate\") setRate(value);\r\n    else if (name === \"addInfo\") setAddInfo(value);\r\n  }\r\n\r\n  const updateMean = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      var formdata = new FormData();\r\n\r\n      let locations = [];\r\n\r\n      deliveryAndStorageLocations.forEach((item) => {\r\n        if (item.type === accessabilityPoints[0].value) {\r\n          let loc = {\r\n            locationType: \"STORAGEAREA\",\r\n            storageArea: item.id,\r\n          };\r\n          locations.push(loc);\r\n        }\r\n        if (item.type === accessabilityPoints[1].value) {\r\n          let loc = {\r\n            locationType: \"DELIVERYAREA\",\r\n            deliveryArea: item.id,\r\n          };\r\n          locations.push(loc);\r\n        }\r\n      });\r\n\r\n      let availabilities = {\r\n        start: startDate,\r\n        end: endDate,\r\n      };\r\n\r\n      // TEST DATA , CALENDAR NOT MADE YET\r\n\r\n      const sampleDateOne = new Date(\"05/20/2021\");\r\n      const sampleDateTwo = new Date(\"05/28/2021\");\r\n      // const unavailabilities = [\r\n      //   {\r\n      //     date: sampleDateOne,\r\n      //     reason: \"Public Holiday\",\r\n      //     startingHour: new Date().getTime(),\r\n      //     endingHour: new Date().getTime(),\r\n      //   },\r\n      //   {\r\n      //     date: sampleDateTwo,\r\n      //     reason: \"Maintenance\",\r\n      //     startingHour: new Date().getTime(),\r\n      //     endingHour: new Date().getTime(),\r\n      //   },\r\n      // ];\r\n\r\n      formdata.append(\"name\", name);\r\n      formdata.append(\"color\", color);\r\n      if (image.length != 0 && image[0].file != undefined)\r\n        formdata.append(\"image\", image[0].file);\r\n      if (image.length != 0 && image[0].file != undefined)\r\n        formdata.append(\"sheet\", image[0].file);\r\n      formdata.append(\"pricePerHour\", rate);\r\n      formdata.append(\"additionalInfo\", addInfo);\r\n      formdata.append(\"siteId\", \"6008169bedbb7816d40b197d\");\r\n      formdata.append(\"meanType\", selectedMeanType);\r\n      formdata.append(\"location\", JSON.stringify(locations));\r\n      formdata.append(\"availability\", JSON.stringify(availabilities));\r\n      //formdata.append(\"unavailability\", JSON.stringify(unavailabilities));\r\n\r\n      const response = await GLOBALS.API({\r\n        method: \"PUT\",\r\n        uri: GLOBALS.Constants.UPDATE_MEAN + \"/\" + props.location.mean._id,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n        dispatch(\r\n          Actions.notistack.enqueueSnackbar(\r\n            Actions.notistack.snackbar(response.message, \"error\"),\r\n          ),\r\n        );\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getDeliveryArea = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data !== null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n\r\n          setDropdownDeliveryAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getStorageArea = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data !== null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n\r\n          setDropdownStorageAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n\r\n      <Form.Row>\r\n        <Heading primary=\"EDIT A MEAN\" />\r\n\r\n        {/* <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"LOCALISATION\"\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginRight: \"100px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\"\r\n                }}\r\n              /> */}\r\n      </Form.Row>\r\n      {loading && \"\"}\r\n      {levels && \"\"}\r\n      {selectedDropdownIndex && \"\"}\r\n      {meanTypes && \"\"}\r\n      {selectedBuildingIndex && \"\"}\r\n      {DeliveryAreas && \"\"}\r\n      {selectedSiteDeliveryAreadIndex && \"\"}\r\n      {storageAreas && \"\"}\r\n      {selectedStorageAreaIndex && \"\"}\r\n      <div className={classes.content}>\r\n        <Form.Form>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY : \" />\r\n            <Form.Row noMargin width=\"65%\" style={{ gap: \"20px\" }}>\r\n              <FormInput\r\n                name=\"name\"\r\n                error\r\n                style={GLOBALS.Styles.inputWidth}\r\n                placeholder=\"name\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={name}\r\n                validateSchema={Yup.string().required()}\r\n              />\r\n              <FormSelect\r\n                placeholder=\"Type\"\r\n                name=\"type\"\r\n                value={selectedMeanType}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    setSelectedMeanTypeIndex(index);\r\n                    setSelectedMeanType(item);\r\n                  } else {\r\n                    setSelectedMeanTypeIndex(null);\r\n                    setSelectedMeanType(\"\");\r\n                  }\r\n                }}\r\n                values={dropdownMeanTypes}\r\n              />\r\n              <FormSelect\r\n                placeholder=\"color\"\r\n                name=\"color\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={color}\r\n                values={[\r\n                  { value: \"green\", label: \"Green\" },\r\n                  { value: \"Yellow\", label: \"Yellow\" },\r\n                  { value: \"Red\", label: \"Red\" },\r\n                  { value: \"Blue\", label: \"Blue\" },\r\n                  { value: \"Orange\", label: \"Orange\" },\r\n                  { value: \"Purple\", label: \"Purple\" },\r\n                  { value: \"Magenta\", label: \"Magenta\" },\r\n                ]}\r\n              />\r\n              <FormMultipleUpload\r\n                name=\"image\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={image}\r\n                onChange={(values) => {\r\n                  handleChange(\"image\", values);\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"LOCATION :  \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <CustomInputModal\r\n                name=\"location\"\r\n                values={accessabilityPoints}\r\n                chipDefaultValues={deliveryAndStorageLocations}\r\n                leftValue={accessabilityPoint}\r\n                rightValue={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? selectedDropdownStorageArea\r\n                    : selectedDropdownArea\r\n                }\r\n                leftId={accessabilityPoint}\r\n                rightId={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? storageAreaId\r\n                    : deliveryAreaId\r\n                }\r\n                chipValues={(values) => {\r\n                  setDeliveryAndStorageLocations(values);\r\n                }}\r\n                leftDropdownValues={accessabilityPoints}\r\n                leftDropdwonPlaceholder={\"Select Location Type\"}\r\n                rightDropdownPlaceholder={\"Select Location\"}\r\n                leftDropdwonValueChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    setAccessabilityPoint(item);\r\n                    if (item === accessabilityPoints[0].value) {\r\n                      getStorageArea();\r\n                    }\r\n                    if (item === accessabilityPoints[1].value) {\r\n                      getDeliveryArea();\r\n                    } else {\r\n                      seltSelectedSiteDeliveryAreaIndex(0);\r\n                      setSelectedDropdownArea(\"\");\r\n                      setDeilveryAreaId(\"\");\r\n\r\n                      setSelectedStorageAreaIndex(0);\r\n                      setSelectedDropdownStorageArea(\"\");\r\n                      setStorageAreaId(\"\");\r\n                    }\r\n                  } else {\r\n                    seltSelectedSiteDeliveryAreaIndex(0);\r\n                    setSelectedDropdownArea(\"\");\r\n                    setDeilveryAreaId(\"\");\r\n\r\n                    setSelectedStorageAreaIndex(0);\r\n                    setSelectedDropdownStorageArea(\"\");\r\n                    setStorageAreaId(\"\");\r\n                  }\r\n                }}\r\n                rightDropdownValues={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? dropdownStorageAreas\r\n                    : dropdownDeliveryAreas\r\n                }\r\n                // error={addresses}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                rightDropdwonValueChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    if (accessabilityPoints[0].value === accessabilityPoint) {\r\n                      setStorageAreaId(storageAreas[index]._id);\r\n                      setSelectedStorageAreaIndex(index);\r\n                      setSelectedDropdownStorageArea(item);\r\n                    } else {\r\n                      setSelectedStorageAreaIndex(0);\r\n                      setSelectedDropdownStorageArea(\"\");\r\n                    }\r\n\r\n                    if (accessabilityPoints[1].value === accessabilityPoint) {\r\n                      setDeilveryAreaId(DeliveryAreas[index]._id);\r\n                      seltSelectedSiteDeliveryAreaIndex(index);\r\n                      setSelectedDropdownArea(item);\r\n                    } else {\r\n                      seltSelectedSiteDeliveryAreaIndex(0);\r\n                      setSelectedDropdownArea(\"\");\r\n                    }\r\n                  } else {\r\n                    setSelectedStorageAreaIndex(0);\r\n                    setSelectedDropdownStorageArea(\"\");\r\n                    seltSelectedSiteDeliveryAreaIndex(0);\r\n                    setSelectedDropdownArea(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"DISPONIBILITE :\" />\r\n            <Form.Row\r\n              noMargin\r\n              width=\"65%\"\r\n              justifyContent=\"flex-start\"\r\n              style={{ gap: \"20px\" }}\r\n            >\r\n              <FormInput\r\n                type=\"date\"\r\n                style={{ width: \"300px\" }}\r\n                placeholder={`Date de début`}\r\n                name=\"startDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={startDate}\r\n              />\r\n              <FormInput\r\n                type=\"date\"\r\n                placeholder=\"Date de fin\"\r\n                style={{ width: \"300px\" }}\r\n                name=\"endDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={endDate}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"FICHE TECHNIQUE : \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormMultipleUpload\r\n                name=\"techSheet\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={techSheet}\r\n                onChange={(values) => {\r\n                  handleChange(\"techSheet\", values);\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"INDISPONIBILITES: \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <div\r\n                // name=\"availability\"\r\n\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"0px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  color: \"#fff\",\r\n                  padding: \"0.8rem 0\",\r\n                  borderRadius: \"8px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\",\r\n                }}\r\n              >\r\n                SHOW UNAVAILABILITIES\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"TARIF HORAIRE : \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormInput\r\n                textArea\r\n                rows={1}\r\n                style={{ width: \"300px\", textAlign: \"right\" }}\r\n                placeholder=\"€\"\r\n                name=\"rate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={rate}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"INFORMATIONS COMPLÉMENTAIRES :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                style={{ width: \"600px\" }}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                onChange={({ target: { name, value } }) => {\r\n                  handleChange(name, value);\r\n                }}\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          {type && \"\"}\r\n          <Form.Row>\r\n            <Form.ButtonContainer style={{ width: \"80%\" }}>\r\n              <Button\r\n                minWidth={200}\r\n                text=\"VALIDATE\"\r\n                fullWidth={false}\r\n                onClick={async () => {\r\n                  await updateMean();\r\n                }}\r\n                // loading={formik.isSubmitting}\r\n                // disabled={\r\n                //   !name ||\r\n                //   location.length === 0 ||\r\n                //   !type ||\r\n                //   !color ||\r\n                //   !startDate\r\n                // }\r\n              />\r\n            </Form.ButtonContainer>\r\n          </Form.Row>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\Means.js",["542","543","544","545","546","547","548","549"],"import React, { useState, useEffect } from \"react\";\r\nimport { useSelector } from \"react-redux\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\n\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport { useFormik } from \"formik\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport FormInput from \"../../../components/FormInput\";\r\n\r\nimport moment from \"moment\";\r\nimport { Images } from \"../../../assets/Assets\";\r\n\r\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n  link: {\r\n    marginRight: 20,\r\n    whiteSpace: \"nowrap\",\r\n    color: theme.palette.primary.contrastText,\r\n  },\r\n  image: {\r\n    height: 70,\r\n    borderRadius: theme.shape.borderRadius,\r\n  },\r\n}));\r\n\r\nconst Means = () => {\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [loading, setLoading] = useState(true);\r\n  const [items, setItems] = useState([]);\r\n\r\n  const [siteDeliveryAreas, setSiteDeliveryAreas] = useState([]);\r\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\r\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\r\n  const [\r\n    selectedSiteDeliveryAreadIndex,\r\n    seltSelectedSiteDeliveryAreaIndex,\r\n  ] = useState(null);\r\n\r\n  const [locations, setLocations] = useState([]);\r\n  const [dropdownLocations, setDropdownLocations] = useState([]);\r\n  const [selectedLocationIndex, setSelectedLocationIndex] = useState(0);\r\n  const [selectedLocation, setSelectedLocation] = useState(\"\");\r\n\r\n  const [types, setTypes] = useState([]);\r\n  const [doropdownTypes, setDropdownTypes] = useState([]);\r\n  const [selectedTypeIndex, setSelectedTypeIndex] = useState(0);\r\n  const [selectedType, setSelectedType] = useState(\"\");\r\n\r\n  const [status, setStatus] = useState([]);\r\n  const [dropdownStatus, setDropdownStatus] = useState([]);\r\n  const [selectedStatusIndex, setSelectedStatusIndex] = useState(0);\r\n  const [selectedStatus, setSelectedStatus] = useState(\"\");\r\n\r\n  const [company, setCompany] = useState([]);\r\n  const [dropdownCompany, setDropdownCompany] = useState([]);\r\n  const [selectedCompanyIndex, setSeletedCompanyIndex] = useState(0);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n\r\n  const [levels, setLevels] = useState([]);\r\n  const [dropdownLevels, setDropdownLevels] = useState([]);\r\n  const [selectedDropdownLevelIndex, setSelectedDropdownLevelIndex] = useState(\r\n    0,\r\n  );\r\n  const [selectedLevel, setSelectedLevel] = useState(\"\");\r\n  const [disableDropdpwn, setDisableDropdown] = useState(true);\r\n  const [disableStorageDropdown, setDisableStorageDropdow] = useState(true);\r\n\r\n  const [storageAreas, setStorageAreas] = useState([]);\r\n  const [droprownStorageAreas, setDropdownStorageAreas] = useState([]);\r\n  const [\r\n    selectedDropdownStorageAreaIndex,\r\n    setSelectedDropdownStorageAreaIndex,\r\n  ] = useState(0);\r\n  const [selectedStorageArea, setSelectedStorageArea] = useState(\"\");\r\n  const [storageMeans, setStorageMeans] = useState([]);\r\n  const [means, setMeans] = useState([]);\r\n  const [meanText, setMeanText] = useState(\"\");\r\n\r\n  const getMeans = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_LIST_OF_MEANS}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        setMeans(response.data.means);\r\n\r\n        if (response.data.means != null) {\r\n          let temp = [];\r\n          response.data.means.map((item, index) => {\r\n            let data = [];\r\n            data[0] = item.name;\r\n            data[1] = item.status;\r\n            data[2] = item.meanType;\r\n\r\n            {\r\n              data[3] = item.location\r\n                .map((innerItem, index) => {\r\n                  if (\r\n                    innerItem.locationType != undefined &&\r\n                    innerItem.locationType === \"STORAGEAREA\"\r\n                  ) {\r\n                    console.log(innerItem.locationType);\r\n                    return innerItem.storageArea.name;\r\n                  }\r\n                  return \"\";\r\n                })\r\n                .toString()\r\n                .replace(/,/g, \" \");\r\n              data[4] = item.location\r\n                .map((innerItem, index) => {\r\n                  if (\r\n                    innerItem.locationType != undefined &&\r\n                    innerItem.locationType === \"DELIVERYAREA\"\r\n                  )\r\n                    return innerItem.deliveryArea.name;\r\n                  return \"\";\r\n                })\r\n                .toString()\r\n                .replace(/,/g, \" \");\r\n            }\r\n            temp.push(data);\r\n            return true;\r\n          });\r\n\r\n          setItems(temp);\r\n        }\r\n\r\n        if (response.data.site_delivery_areas != null) {\r\n          const temp = [];\r\n          response.data.site_delivery_areas.map((item, index) => {\r\n            return temp.push({ label: item.name, value: item.name });\r\n          });\r\n          setSiteDeliveryAreas(response.data.site_delivery_areas);\r\n          setDropdownDeliveryAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_companies != null) {\r\n          const temp = [];\r\n          response.data.site_companies.map((item, index) => {\r\n            return temp.push({\r\n              label: item.companyId.name,\r\n              value: item.companyId.name,\r\n            });\r\n          });\r\n          setCompany(response.data.site_companies);\r\n          setDropdownCompany(temp);\r\n        }\r\n\r\n        if (response.data.site_locations != null) {\r\n          setLocations(response.data.site_locations);\r\n          const temp = [];\r\n          response.data.site_locations.map((item, index) => {\r\n            return temp.push({ label: item.name, value: item.name });\r\n          });\r\n          setDropdownLocations(temp);\r\n        }\r\n\r\n        if (response.data.mean_types != null) {\r\n          setTypes(response.data.mean_types);\r\n          const temp = [];\r\n          response.data.mean_types.map((item, index) => {\r\n            return temp.push({ label: item, value: item });\r\n          });\r\n          setDropdownTypes(temp);\r\n        }\r\n\r\n        if (response.data.mean_status != null) {\r\n          setStatus(response.data.mean_status);\r\n          const temp = [];\r\n          response.data.mean_status.map((item, index) => {\r\n            return temp.push({ label: item, value: item });\r\n          });\r\n          setDropdownStatus(temp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getExternalMeans = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_EXTERIOR_MEANS}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        const tempStorageAreas = [];\r\n        if (response.data != null && response.data.length > 0) {\r\n          const temp = [];\r\n\r\n          response.data.map((item, index) => {\r\n            item.location.map((innerItem, innerIndex) => {\r\n              console.log(JSON.stringify(innerItem, null, 2));\r\n              if (innerItem.locationType === \"STORAGEAREA\") {\r\n                tempStorageAreas.push(innerItem);\r\n                return temp.push({\r\n                  label: innerItem.storageArea.name,\r\n                  value: innerItem.storageArea.name,\r\n                });\r\n              }\r\n            });\r\n\r\n            //\r\n          });\r\n          setStorageAreas(tempStorageAreas);\r\n          setDropdownStorageAreas(temp);\r\n        }\r\n\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getLevels = async (buidlingId) => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_LEVELS}/${buidlingId}`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data != null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) => {\r\n            return temp.push({ label: item.name, value: item.name });\r\n          });\r\n\r\n          setDropdownLevels(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    // validationSchema: addClientYup,\r\n    // onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n\r\n  useEffect(() => {\r\n    filterMean();\r\n    // eslint-disable-next-line\r\n  }, [\r\n    selectedSiteDeliveryAreadIndex,\r\n    selectedLocationIndex,\r\n    selectedDropdownLevelIndex,\r\n    selectedDropdownStorageAreaIndex,\r\n    selectedStorageArea,\r\n    selectedTypeIndex,\r\n    selectedType,\r\n    selectedCompanyIndex,\r\n    selectedCompany,\r\n    selectedStatusIndex,\r\n    selectedStatus,\r\n    formik.values.contractStartDate,\r\n    formik.values.contractEndDate,\r\n  ]);\r\n\r\n  const filterMean = async () => {\r\n    try {\r\n      setLoading(true);\r\n      const params = { siteId: adminStore.site.siteId._id };\r\n      if (meanText.length !== 0) params[\"name\"] = meanText;\r\n      if (selectedDropdownArea.length !== 0)\r\n        params[\"deliveryArea\"] =\r\n          siteDeliveryAreas[selectedSiteDeliveryAreadIndex]._id;\r\n      if (selectedStorageArea.length !== 0)\r\n        params[\"storageArea\"] =\r\n          storageAreas[selectedDropdownStorageAreaIndex]._id;\r\n\r\n      if (selectedCompany.length !== 0)\r\n        params[\"company\"] = company[selectedCompanyIndex].companyId._id;\r\n\r\n      if (selectedType.length !== 0) params[\"type\"] = types[selectedTypeIndex];\r\n      if (selectedStatus.length !== 0)\r\n        params[\"status\"] = status[selectedStatusIndex];\r\n      if (!isNaN(moment(formik.values.contractStartDate)))\r\n        params[\"startDate\"] = formik.values.contractStartDate;\r\n      if (!isNaN(moment(formik.values.contractEndDate)))\r\n        params[\"endDate\"] = formik.values.contractEndDate;\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.FILTER_MEANS}`,\r\n        token: store.token,\r\n        method: \"POST\",\r\n        body: JSON.stringify(params),\r\n      });\r\n      if (response.success) {\r\n        let temp = [];\r\n\r\n        response.data.map((item, index) => {\r\n          let data = [];\r\n          data[0] = item.name;\r\n          data[1] = item.status;\r\n          data[2] = item.meanType;\r\n          {\r\n            data[3] = item.location\r\n              .map((innerItem, index) => {\r\n                if (\r\n                  innerItem.locationType != undefined &&\r\n                  innerItem.locationType === \"STORAGEAREA\"\r\n                ) {\r\n                  console.log(innerItem.locationType);\r\n                  return innerItem.storageArea.name;\r\n                }\r\n                return \"\";\r\n              })\r\n              .toString()\r\n              .replace(/,/g, \" \");\r\n            data[4] = item.location\r\n              .map((innerItem, index) => {\r\n                if (\r\n                  innerItem.locationType != undefined &&\r\n                  innerItem.locationType === \"DELIVERYAREA\"\r\n                )\r\n                  return innerItem.deliveryArea.name;\r\n                return \"\";\r\n              })\r\n              .toString()\r\n              .replace(/,/g, \" \");\r\n          }\r\n          return temp.push(data);\r\n        });\r\n        setItems(temp);\r\n\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getStorageAreasByLevel = async (levelId) => {\r\n    try {\r\n      setLoading(true);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_LEVEL_ID}/${levelId}`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setStorageAreas(response.data);\r\n        if (response.data != null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) => {\r\n            return temp.push({ label: item.name, value: item.name });\r\n          });\r\n\r\n          setDropdownStorageAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    getMeans();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  const rows = items.map((item, index) => {\r\n    return [\r\n      ...item,\r\n      <div>\r\n        <NavLink\r\n          to={{\r\n            pathname: \"/means/edit-mean\",\r\n            mean: means[index],\r\n          }}\r\n          style={{ color: \"#959491 !important\", textDecoration: \"none\" }}\r\n        >\r\n          <Pencil style={{ width: 18, height: 15, cursor: \"pointer\" }} />\r\n        </NavLink>\r\n\r\n        <NavLink\r\n          to={{\r\n            pathname: \"/means/calendar\",\r\n            mean: means[index],\r\n          }}\r\n        >\r\n          <img\r\n            src={Images.calender}\r\n            style={{ width: 18, height: 15, paddingLeft: 5 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </NavLink>\r\n        <NavLink\r\n          to={{\r\n            pathname: \"/means/mean-history\",\r\n            mean: means[index],\r\n          }}\r\n        >\r\n          <img\r\n            src={Images.incidents}\r\n            style={{ width: 18, height: 15, paddingLeft: 5 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </NavLink>\r\n      </div>,\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <Form.Row alignItems=\"center\">\r\n        {loading && \"\"}\r\n        {selectedLocation && \"\"}\r\n        {company && \"\"}\r\n        {selectedLevel && \"\"}\r\n        {storageMeans && \"\"}\r\n        <Heading primary=\"LIST OF MEANS\" noWrap />\r\n        <div>\r\n          <Form.Row\r\n            alignItems=\"flex-start\"\r\n            noMargin\r\n            justifyContent=\"flex-end\"\r\n            style={{ paddingRight: \"50px\" }}\r\n          >\r\n            <SubHeading\r\n              noMargin\r\n              topPadding\r\n              primary={`TOTAL : ${means.length} means`}\r\n              bold\r\n            />\r\n            <Form.Column style={{ width: \"50%\" }}>\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"ADD A MEAN\"\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"20px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"200px\",\r\n                }}\r\n              />\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"MEANS REQUEST\"\r\n                to={\"/sites/means-request\"}\r\n                style={{ marginLeft: \"20px\", width: \"200px\" }}\r\n              />\r\n            </Form.Column>\r\n          </Form.Row>\r\n        </div>\r\n      </Form.Row>\r\n      <Form.Row alignItems=\"center\" noMargin>\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          <FormSelect\r\n            placeholder=\"Delivery area\"\r\n            values={dropdownDeliveryAreas}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n\r\n                seltSelectedSiteDeliveryAreaIndex(index);\r\n\r\n                setSelectedDropdownArea(item);\r\n              } else {\r\n                seltSelectedSiteDeliveryAreaIndex(null);\r\n\r\n                setSelectedDropdownArea(\"\");\r\n              }\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Location\"\r\n            values={dropdownLocations}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n\r\n                setSelectedLocationIndex(index);\r\n                setSelectedLocation(item);\r\n                // Reset Levels\r\n                setSelectedDropdownLevelIndex(0);\r\n                setSelectedLevel(\"\");\r\n                setDropdownLevels([]);\r\n                // Reset Storage Area\r\n                setSelectedDropdownStorageAreaIndex(0);\r\n                setSelectedStorageArea(\"\");\r\n                setDropdownStorageAreas([]);\r\n                setDisableStorageDropdow(true);\r\n                // Reset Storage Means\r\n                setStorageMeans([]);\r\n                if (locations[index].buildingType === \"EXTERIOR\") {\r\n                  setDisableDropdown(true);\r\n                  getExternalMeans();\r\n                  setDisableStorageDropdow(false);\r\n                } else {\r\n                  setDisableDropdown(false);\r\n                  getLevels(locations[index]._id);\r\n                }\r\n              } else {\r\n                setSelectedLocationIndex(0);\r\n                setSelectedLocation(\"\");\r\n                // Reset Levels\r\n                setSelectedDropdownLevelIndex(0);\r\n                setSelectedLevel(\"\");\r\n                setDropdownLevels([]);\r\n                // Reset Storage Area\r\n                setSelectedDropdownStorageAreaIndex(0);\r\n                setSelectedStorageArea(\"\");\r\n                setDropdownStorageAreas([]);\r\n                // Reset Storage Means\r\n                setStorageMeans([]);\r\n                setDisableStorageDropdow(true);\r\n              }\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Level\"\r\n            values={dropdownLevels}\r\n            disabled={disableDropdpwn}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n                setSelectedDropdownLevelIndex(index);\r\n                setSelectedLevel(item);\r\n                // Reset Storage Area\r\n                setSelectedDropdownStorageAreaIndex(0);\r\n                setSelectedStorageArea(\"\");\r\n                setDropdownStorageAreas([]);\r\n                // Reset Storage Means\r\n                setStorageMeans([]);\r\n                setDisableStorageDropdow(false);\r\n                getStorageAreasByLevel(levels[index]._id);\r\n              } else {\r\n                setSelectedDropdownLevelIndex(0);\r\n                setSelectedLevel(\"\");\r\n                // Reset Storage Area\r\n                setSelectedDropdownStorageAreaIndex(0);\r\n                setSelectedStorageArea(\"\");\r\n                setDropdownStorageAreas([]);\r\n                // Reset Storage Means\r\n                setStorageMeans([]);\r\n                setDisableStorageDropdow(true);\r\n              }\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Storage area\"\r\n            values={droprownStorageAreas}\r\n            disabled={disableStorageDropdown}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n\r\n                setSelectedDropdownStorageAreaIndex(index);\r\n                setSelectedStorageArea(item);\r\n                // Reset Storage Means\r\n                setStorageMeans([]);\r\n\r\n                // filterMean();\r\n              } else {\r\n                setSelectedDropdownStorageAreaIndex(0);\r\n                setSelectedStorageArea(\"\");\r\n                //  filterMean();\r\n              }\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Type\"\r\n            values={doropdownTypes}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n                setSelectedTypeIndex(index);\r\n                setSelectedType(item);\r\n                // Reset Storage Means\r\n                //filterMean();\r\n              } else {\r\n                setSelectedTypeIndex(0);\r\n                setSelectedType(\"\");\r\n                // Reset Storage Means\r\n                //filterMean();\r\n              }\r\n            }}\r\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\r\n          See archived sites\r\n        </NavLink> */}\r\n      </Form.Row>\r\n\r\n      <Form.Row alignItems=\"center\" noMargin className=\"mt-3\">\r\n        <Form.Row justifyContent=\"flex-start\" noMargin>\r\n          <FormSelect\r\n            placeholder=\"Company\"\r\n            values={dropdownCompany}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n              const item = event.target.value;\r\n              if (index !== -1) {\r\n                setSeletedCompanyIndex(index);\r\n                setSelectedCompany(item);\r\n                //   filterMean();\r\n              } else {\r\n                setSeletedCompanyIndex(0);\r\n                setSelectedCompany(\"\");\r\n                // filterMean();\r\n              }\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormSelect\r\n            placeholder=\"Status\"\r\n            values={dropdownStatus}\r\n            onChange={(event) => {\r\n              const index = event.target.selectedIndex - 1;\r\n              if (index !== -1) {\r\n                const item = event.target.value;\r\n                setSelectedStatusIndex(index);\r\n                setSelectedStatus(item);\r\n                // filterMean();\r\n              } else {\r\n                setSelectedStatusIndex(0);\r\n                setSelectedStatus(\"\");\r\n                //filterMean();\r\n              }\r\n            }}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormInput\r\n            type=\"date\"\r\n            placeholder=\"Start date\"\r\n            name=\"contractStartDate\"\r\n            icon\r\n            onChange={formik.handleChange}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <FormInput\r\n            type=\"date\"\r\n            placeholder=\"End date\"\r\n            name=\"contractEndDate\"\r\n            icon\r\n            onChange={formik.handleChange}\r\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n          />\r\n          <SearchInput\r\n            placeholder=\"Mean name\"\r\n            value={meanText}\r\n            onClick={() => {\r\n              filterMean();\r\n            }}\r\n            onChange={(event) => {\r\n              setMeanText(event.target.value);\r\n            }}\r\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\r\n          />\r\n        </Form.Row>\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Table headers={GLOBALS.Data.means.headings} rows={rows} />\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Means;\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Means\\AddMean.js",["550","551","552","553","554","555","556","557","558"],"import React, { useState, useEffect } from \"react\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/CustomFormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport CustomInputModal from \"../../../components/CustomInputModal\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n}));\r\n\r\nconst accessabilityPoints = [\r\n  { label: \"Storage Area\", value: \"Storage Area\" },\r\n  { label: \"Delivery Area\", value: \"Delivery Area\" },\r\n];\r\n\r\nexport default function AddMean(props) {\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [name, setName] = useState(\"\");\r\n  const [type, setType] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [image, setImage] = useState([]);\r\n  const [location, setLocation] = useState([]);\r\n  const [startDate, setStartDate] = useState(\"\");\r\n  const [endDate, setEndDate] = useState(\"\");\r\n  const [techSheet, setTechSheet] = useState([]);\r\n  const [rate, setRate] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n  const [loading, setLoading] = useState(true);\r\n  const classes = useStyles();\r\n\r\n  const [accessabilityPoint, setAccessabilityPoint] = useState(\"\");\r\n  const [DeliveryAreas, setDeliveryAreas] = useState([]);\r\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\r\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\r\n  const [\r\n    selectedSiteDeliveryAreadIndex,\r\n    seltSelectedSiteDeliveryAreaIndex,\r\n  ] = useState(null);\r\n\r\n  const [storageAreas, setStorageAreas] = useState([]);\r\n  const [dropdownStorageAreas, setDropdownStorageAreas] = useState([]);\r\n  const [\r\n    selectedDropdownStorageArea,\r\n    setSelectedDropdownStorageArea,\r\n  ] = useState(\"\");\r\n  const [selectedStorageAreaIndex, setSelectedStorageAreaIndex] = useState(\r\n    null,\r\n  );\r\n\r\n  const [deliveryAreaId, setDeilveryAreaId] = useState(\"\");\r\n  const [storageAreaId, setStorageAreaId] = useState(\"\");\r\n\r\n  const [\r\n    deliveryAndStorageLocations,\r\n    setDeliveryAndStorageLocations,\r\n  ] = useState([]);\r\n\r\n  const [buildings, setBuidings] = useState([]);\r\n  const [dropdownBuildings, setDropdownBuildings] = useState([]);\r\n  const [selectedBuildingIndex] = useState(null);\r\n\r\n  const [levels, setLevels] = useState([]);\r\n  const [selectedDropdownIndex] = useState(null);\r\n\r\n  const [meanTypes, setMeanTypes] = useState([]);\r\n  const [dropdownMeanTypes, setDropdownMeanTypes] = useState([]);\r\n  const [selectedMeanType, setSelectedMeanType] = useState(\"\");\r\n  const [selecetedMeanTypeIndex, setSelectedMeanTypeIndex] = useState(null);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  useEffect(() => {}, [\r\n    meanTypes,\r\n    dropdownMeanTypes,\r\n    selecetedMeanTypeIndex,\r\n    selectedMeanType,\r\n  ]);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_MEAN}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.site_delivery_areas !== null) {\r\n          const temp = [];\r\n          response.data.site_delivery_areas.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name, id: item._id }),\r\n          );\r\n          setDeliveryAreas(response.data.site_delivery_areas);\r\n          setDropdownDeliveryAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_storage_areas !== null) {\r\n          const temp = [];\r\n          response.data.site_storage_areas.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name, id: item._id }),\r\n          );\r\n          setStorageAreas(response.data.site_storage_areas);\r\n          setDropdownStorageAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_buildings !== null) {\r\n          const temp = [];\r\n          response.data.site_buildings.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n          setBuidings(response.data.site_buildings);\r\n          setDropdownBuildings(temp);\r\n        }\r\n\r\n        if (response.data.mean_types !== null) {\r\n          const temp = [];\r\n          response.data.mean_types.map((item, index) =>\r\n            temp.push({ label: item, value: item }),\r\n          );\r\n          setMeanTypes(response.data.mean_types);\r\n          setDropdownMeanTypes(temp);\r\n        }\r\n        // if (response.data.mean_types !== null) {\r\n        //   setTypes(response.data.mean_types);\r\n        //   const temp = [];\r\n        //   response.data.mean_types.map((item, index) => {\r\n        //     temp.push({ label: item, value: item });\r\n        //   });\r\n        //   setDropdownTypes(temp);\r\n        // }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  function handleChange(name, value) {\r\n    if (name === \"name\") setName(value);\r\n    else if (name === \"type\") setType(value);\r\n    else if (name === \"color\") setColor(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"location\") setLocation(value);\r\n    else if (name === \"startDate\") setStartDate(value);\r\n    else if (name === \"endDate\") setEndDate(value);\r\n    else if (name === \"techSheet\") setTechSheet(value);\r\n    else if (name === \"rate\") setRate(value);\r\n    else if (name === \"addInfo\") setAddInfo(value);\r\n  }\r\n\r\n  const createMean = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      var formdata = new FormData();\r\n\r\n      let locations = [];\r\n\r\n      deliveryAndStorageLocations.forEach((item) => {\r\n        if (item.type === accessabilityPoints[0].value) {\r\n          let loc = {\r\n            locationType: \"STORAGEAREA\",\r\n            storageArea: item.id,\r\n          };\r\n          locations.push(loc);\r\n        }\r\n        if (item.type === accessabilityPoints[1].value) {\r\n          let loc = {\r\n            locationType: \"DELIVERYAREA\",\r\n            deliveryArea: item.id,\r\n          };\r\n          locations.push(loc);\r\n        }\r\n      });\r\n\r\n      let availabilities = {\r\n        start: startDate,\r\n        end: endDate,\r\n      };\r\n\r\n      // TEST DATA , CALENDAR NOT MADE YET\r\n\r\n      const sampleDateOne = new Date(\"05/20/2021\");\r\n      const sampleDateTwo = new Date(\"05/28/2021\");\r\n      const unavailabilities = [\r\n        {\r\n          date: sampleDateOne,\r\n          reason: \"Public Holiday\",\r\n          startingHour: new Date().getTime(),\r\n          endingHour: new Date().getTime(),\r\n        },\r\n        {\r\n          date: sampleDateTwo,\r\n          reason: \"Maintenance\",\r\n          startingHour: new Date().getTime(),\r\n          endingHour: new Date().getTime(),\r\n        },\r\n      ];\r\n\r\n      formdata.append(\"name\", name);\r\n      formdata.append(\"color\", color);\r\n      formdata.append(\"image\", image[0].file);\r\n      formdata.append(\"sheet\", image[0].file);\r\n      formdata.append(\"pricePerHour\", rate);\r\n      formdata.append(\"additionalInfo\", addInfo);\r\n      formdata.append(\"siteId\", adminStore.site.siteId._id);\r\n      formdata.append(\"meanType\", selectedMeanType);\r\n      formdata.append(\"location\", JSON.stringify(locations));\r\n      formdata.append(\"availability\", JSON.stringify(availabilities));\r\n      formdata.append(\"unavailability\", JSON.stringify(unavailabilities));\r\n\r\n      const response = await GLOBALS.API({\r\n        method: \"POST\",\r\n        uri: GLOBALS.Constants.CREATE_MEAN,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      console.log(JSON.stringify(response, null, 2));\r\n\r\n      if (response.success) {\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n        dispatch(\r\n          Actions.notistack.enqueueSnackbar(\r\n            Actions.notistack.snackbar(response.message, \"error\"),\r\n          ),\r\n        );\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getDeliveryArea = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data !== null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n\r\n          setDropdownDeliveryAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getStorageArea = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data !== null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n\r\n          setDropdownStorageAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  // const getLevels = async (buidlingId) => {\r\n  //   try {\r\n  //     setLoading(true);\r\n\r\n  //     const response = await GLOBALS.API({\r\n  //       uri: `${GLOBALS.Constants.GET_LEVELS}/${buidlingId}`,\r\n  //       token: store.token,\r\n  //     });\r\n\r\n  //     if (response.success) {\r\n  //       setLevels(response.data);\r\n  //       if (response.data !== null && response.data.length > 0) {\r\n  //         const temp = [];\r\n  //         response.data.map((item, index) =>\r\n  //           temp.push({ label: item.name, value: item.name }),\r\n  //         );\r\n\r\n  //         setDropdownLevels(temp);\r\n  //       }\r\n  //       setLoading(false);\r\n  //     } else {\r\n  //       setLoading(false);\r\n  //     }\r\n  //     setLoading(false);\r\n  //   } catch (err) {\r\n  //     setLoading(false);\r\n  //     dispatch(\r\n  //       Actions.notistack.enqueueSnackbar(\r\n  //         Actions.notistack.snackbar(err.message, \"error\"),\r\n  //       ),\r\n  //     );\r\n  //   }\r\n  // };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n\r\n      <Form.Row>\r\n        <Heading primary=\"ADD A MEAN\" />\r\n\r\n        {/* <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"LOCALISATION\"\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginRight: \"100px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\"\r\n                }}\r\n              /> */}\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Form.Form>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY : \" />\r\n            <Form.Row noMargin width=\"65%\" style={{ gap: \"20px\" }}>\r\n              <FormInput\r\n                name=\"name\"\r\n                value={name}\r\n                placeholder=\"name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n              <FormSelect\r\n                placeholder=\"Type\"\r\n                name=\"type\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={dropdownMeanTypes}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    setSelectedMeanTypeIndex(index);\r\n                    setSelectedMeanType(item);\r\n                  } else {\r\n                    setSelectedMeanTypeIndex(null);\r\n                    setSelectedMeanType(\"\");\r\n                  }\r\n                }}\r\n              />\r\n              <FormSelect\r\n                placeholder=\"color\"\r\n                name=\"color\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={color}\r\n                values={[\r\n                  { value: \"green\", label: \"Green\" },\r\n                  { value: \"Yellow\", label: \"Yellow\" },\r\n                  { value: \"Red\", label: \"Red\" },\r\n                  { value: \"Blue\", label: \"Blue\" },\r\n                  { value: \"Orange\", label: \"Orange\" },\r\n                  { value: \"Purple\", label: \"Purple\" },\r\n                  { value: \"Magenta\", label: \"Magenta\" },\r\n                ]}\r\n              />\r\n              <FormMultipleUpload\r\n                name=\"image\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={image}\r\n                onChange={(values) => {\r\n                  handleChange(\"image\", values);\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"LOCATION :  \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <CustomInputModal\r\n                name=\"location\"\r\n                values={accessabilityPoints}\r\n                leftValue={accessabilityPoint}\r\n                rightValue={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? selectedDropdownStorageArea\r\n                    : selectedDropdownArea\r\n                }\r\n                leftId={accessabilityPoint}\r\n                rightId={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? storageAreaId\r\n                    : deliveryAreaId\r\n                }\r\n                chipValues={(values) => {\r\n                  console.log(JSON.stringify(values, null, 2));\r\n                  setDeliveryAndStorageLocations(values);\r\n                }}\r\n                leftDropdownValues={accessabilityPoints}\r\n                leftDropdwonPlaceholder={\"Select Location Type\"}\r\n                rightDropdownPlaceholder={\"Select Location\"}\r\n                leftDropdwonValueChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    setAccessabilityPoint(item);\r\n                    if (item === accessabilityPoints[0].value) {\r\n                      getStorageArea();\r\n                    }\r\n                    if (item === accessabilityPoints[1].value) {\r\n                      getDeliveryArea();\r\n                    } else {\r\n                      seltSelectedSiteDeliveryAreaIndex(0);\r\n                      setSelectedDropdownArea(\"\");\r\n                      setDeilveryAreaId(\"\");\r\n\r\n                      setSelectedStorageAreaIndex(0);\r\n                      setSelectedDropdownStorageArea(\"\");\r\n                      setStorageAreaId(\"\");\r\n                    }\r\n                  } else {\r\n                    seltSelectedSiteDeliveryAreaIndex(0);\r\n                    setSelectedDropdownArea(\"\");\r\n                    setDeilveryAreaId(\"\");\r\n\r\n                    setSelectedStorageAreaIndex(0);\r\n                    setSelectedDropdownStorageArea(\"\");\r\n                    setStorageAreaId(\"\");\r\n                  }\r\n                }}\r\n                rightDropdownValues={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? dropdownStorageAreas\r\n                    : dropdownDeliveryAreas\r\n                }\r\n                // error={addresses}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                rightDropdwonValueChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    if (accessabilityPoints[0].value === accessabilityPoint) {\r\n                      setStorageAreaId(storageAreas[index]._id);\r\n                      setSelectedStorageAreaIndex(index);\r\n                      setSelectedDropdownStorageArea(item);\r\n                    } else {\r\n                      setSelectedStorageAreaIndex(0);\r\n                      setSelectedDropdownStorageArea(\"\");\r\n                    }\r\n\r\n                    if (accessabilityPoints[1].value === accessabilityPoint) {\r\n                      setDeilveryAreaId(DeliveryAreas[index]._id);\r\n                      seltSelectedSiteDeliveryAreaIndex(index);\r\n                      setSelectedDropdownArea(item);\r\n                    } else {\r\n                      seltSelectedSiteDeliveryAreaIndex(0);\r\n                      setSelectedDropdownArea(\"\");\r\n                    }\r\n                  } else {\r\n                    setSelectedStorageAreaIndex(0);\r\n                    setSelectedDropdownStorageArea(\"\");\r\n                    seltSelectedSiteDeliveryAreaIndex(0);\r\n                    setSelectedDropdownArea(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"DISPONIBILITE :\" />\r\n            <Form.Row\r\n              noMargin\r\n              width=\"65%\"\r\n              justifyContent=\"flex-start\"\r\n              style={{ gap: \"20px\" }}\r\n            >\r\n              <FormInput\r\n                type=\"date\"\r\n                style={{ width: \"300px\" }}\r\n                placeholder={`Date de début`}\r\n                name=\"startDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={startDate}\r\n              />\r\n              <FormInput\r\n                type=\"date\"\r\n                placeholder=\"Date de fin\"\r\n                style={{ width: \"300px\" }}\r\n                name=\"endDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={endDate}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"FICHE TECHNIQUE : \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormMultipleUpload\r\n                name=\"techSheet\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={techSheet}\r\n                onChange={(values) => {\r\n                  handleChange(\"techSheet\", values);\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"INDISPONIBILITES: \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <div\r\n                // name=\"availability\"\r\n\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"0px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  color: \"#fff\",\r\n                  padding: \"0.8rem 0\",\r\n                  borderRadius: \"8px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\",\r\n                }}\r\n              >\r\n                SHOW UNAVAILABILITIES\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"TARIF HORAIRE : \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormInput\r\n                textArea\r\n                rows={1}\r\n                style={{ width: \"300px\", textAlign: \"right\" }}\r\n                placeholder=\"€\"\r\n                name=\"rate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={rate}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"INFORMATIONS COMPLÉMENTAIRES :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                style={{ width: \"600px\" }}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                onChange={({ target: { name, value } }) => {\r\n                  handleChange(name, value);\r\n                }}\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          {type && \"\"}\r\n          <Form.Row>\r\n            <Form.ButtonContainer style={{ width: \"80%\" }}>\r\n              <Button\r\n                minWidth={200}\r\n                text=\"VALIDATE\"\r\n                fullWidth={false}\r\n                onClick={async () => {\r\n                  await createMean();\r\n                }}\r\n                // loading={formik.isSubmitting}\r\n                // disabled={\r\n                //   !name ||\r\n                //   location.length === 0 ||\r\n                //   !type ||\r\n                //   !color ||\r\n                //   !startDate\r\n                // }\r\n              />\r\n            </Form.ButtonContainer>\r\n          </Form.Row>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\OutlinedCapsuledButton.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\Card.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\UserList.js",["559","560"],"import React, { useState, useEffect } from \"react\";\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n// import * as Yup from \"yup\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Modal from \"../../../components/Modal\";\r\nimport SmallButton from \"../../../components/SmallButton\";\r\n\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport AvatarUpload from \"../../../components/AvatarUpload\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n}));\r\n\r\n// const updateAdminYup = Yup.object().shape({\r\n//   email: Yup.string().required(\"Required\"),\r\n//   phone: Yup.number()\r\n//     .test(\r\n//       \"len\",\r\n//       \"Must be exactly 10 characters\",\r\n//       (val) => val && val.toString().length === 10,\r\n//     )\r\n//     .required(\"Required\"),\r\n//   image: Yup.object().optional(\"\"),\r\n//   companyId: Yup.string().required(\"Required\"),\r\n// });\r\n\r\nexport default function UserList(props) {\r\n  const theme = useTheme();\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [page] = useState(1);\r\n  const [items, setItems] = useState([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const [companies, setCompanies] = useState([]);\r\n  const [open, setOpen] = useState(false);\r\n\r\n  const [selectedItem] = useState(\"\");\r\n\r\n  const [firstName, setFirstName] = useState(\"\");\r\n  const [lastName, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [image, setImage] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [companyName, setCompanyName] = useState(\"\");\r\n  const [users, setUsers] = useState([]);\r\n  useEffect(() => {\r\n    getData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_COMPANY_USERS}/${adminStore.site.siteId._id}/${props.location.id}`,\r\n        token: store.token,\r\n      });\r\n      //console.log(JSON.stringify(response.data[0].usersArray, null, 2));\r\n      if (response.success) {\r\n        setCompanyName(response.data[0].company.name);\r\n        setUsers(response.data[0].usersArray);\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n  const resendVerificaiontRequest = () => {};\r\n  const handleChange = (name, value) => {\r\n    if (name === \"firstName\") setFirstName(value);\r\n    else if (name === \"lastName\") setLastName(value);\r\n    else if (name === \"phone\") setPhone(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"companyId\") setCompanyId(value);\r\n  };\r\n\r\n  const onUpdate = async (e) => {\r\n    try {\r\n      e.preventDefault();\r\n      setLoading(true);\r\n      var formdata = new FormData();\r\n      formdata.append(\"firstName\", firstName);\r\n      formdata.append(\"lastName\", lastName);\r\n      formdata.append(\"phone\", phone);\r\n      formdata.append(\"companyId\", companyId);\r\n      formdata.append(\"userId\", selectedItem._id);\r\n      image.file && formdata.append(\"image\", image.file);\r\n\r\n      const result = await GLOBALS.API({\r\n        method: \"PUT\",\r\n        uri: GLOBALS.Constants.ADMINS,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      const itemsArray = items.map((item) =>\r\n        item._id === selectedItem._id ? result.data : item,\r\n      );\r\n      setItems(itemsArray);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n  const handleClickOpen = () => {\r\n    setOpen(true);\r\n  };\r\n  const rows = users.map((item) => {\r\n    console.log(JSON.stringify(item, null, 2));\r\n    const user = item;\r\n    return [\r\n      user.firstName + \" \" + user.lastName,\r\n      companyName,\r\n      item.role,\r\n      user.isVerified ? \"Inscrit\" : \"En attente\",\r\n      user.email,\r\n      <SmallButton\r\n        text={user.isVerified ? \"Edit\" : \"Re-Send\"}\r\n        onClick={user.isVerified ? handleClickOpen : resendVerificaiontRequest}\r\n        color={theme.palette.primary.contrastText}\r\n        to={\"/companies\"}\r\n        // component={NavLink}\r\n        style={{\r\n          marginLeft: 10,\r\n          borderRadius: 4,\r\n        }}\r\n      />,\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <>\r\n      <div className={classes.root}>\r\n        <Form.Row alignItems=\"center\" className=\"pr-3\">\r\n          <Heading primary=\"LIST OF USERS\" noWrap />\r\n          <div>\r\n            <Form.Row alignItems=\"center\" noMargin>\r\n              <SubHeading\r\n                disableMargin\r\n                primary={`Total : ${users.length} Users`}\r\n                bold\r\n              />\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"ADD A USER\"\r\n                style={{ marginLeft: \"20px\" }}\r\n                to={\"/companies/add-user\"}\r\n              />\r\n            </Form.Row>\r\n          </div>\r\n        </Form.Row>\r\n        {companies && \"\"}\r\n        <Form.Row noMargin>\r\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\r\n            <SearchInput placeholder=\"Name OF USER\" />\r\n            <FormSelect\r\n              placeholder=\"Company\"\r\n              name=\"color\"\r\n              style={{ marginLeft: \"20px\", maxWidth: 250 }}\r\n              values={[\r\n                { value: \"green\", label: \"Green\" },\r\n                { value: \"Yellow\", label: \"Yellow\" },\r\n                { value: \"Red\", label: \"Red\" },\r\n                { value: \"Blue\", label: \"Blue\" },\r\n                { value: \"Orange\", label: \"Orange\" },\r\n                { value: \"Purple\", label: \"Purple\" },\r\n                { value: \"Magenta\", label: \"Magenta\" },\r\n              ]}\r\n            />\r\n          </Form.Row>\r\n        </Form.Row>\r\n        <div className={classes.content}>\r\n          <Table headers={GLOBALS.Data.userList.headings} rows={rows} />\r\n        </div>\r\n      </div>\r\n      <Modal\r\n        title=\"THEIRRY MARLES\"\r\n        open={open}\r\n        onClose={() => setOpen(false)}\r\n        body={\r\n          <Form.Form onSubmit={onUpdate}>\r\n            <Form.Row justifyContent=\"center\">\r\n              <AvatarUpload\r\n                value={image}\r\n                // error={image}\r\n                onChange={(file) => {\r\n                  const uri = URL.createObjectURL(file);\r\n                  handleChange(\"image\", { file, uri });\r\n                }}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"thier@contrco.com\"\r\n                value={firstName}\r\n                // error={firstName}\r\n                placeholder=\"First Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"lastName\"\r\n                value={lastName}\r\n                // error={lastName}\r\n                placeholder=\"Last Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\"></Form.Row>\r\n            <Form.ButtonContainer>\r\n              <Button\r\n                type=\"submit\"\r\n                minWidth={200}\r\n                text=\"VALIDATE\"\r\n                fullWidth={false}\r\n                disabled={loading}\r\n              />\r\n            </Form.ButtonContainer>\r\n          </Form.Form>\r\n        }\r\n      />\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\AddCompanies.js",["561","562","563","564","565","566","567","568","569","570","571","572","573","574","575"],"import React, { useState, useEffect } from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport MultiAdderInput from \"../../../components/MultiAdderInput\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport { InputSharp } from \"@material-ui/icons\";\r\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\r\nimport Actions from \"../../../redux/actions\";\r\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\r\nimport TextField from \"@material-ui/core/TextField\";\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n  error: {\r\n    color: \"red\",\r\n  },\r\n  radioLabel: {\r\n    marginLeft: \"7px\",\r\n    color: \"#7E7878\",\r\n    marginRight: \"50px\",\r\n  },\r\n  radioBtn: {},\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  images: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function AddCompanies(props) {\r\n  const dispatch = useDispatch();\r\n\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [name, setName] = useState(\"\");\r\n  const [nameError, setNameError] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [colorError, setColorError] = useState(\"\");\r\n  const [images, setImages] = useState([]);\r\n  const [companyType, setCompanyType] = useState(\"subcontractor\");\r\n  const [companyTypeError, setCompanyTypeError] = useState(\"\");\r\n  const [contract, setContract] = useState(\"\");\r\n  const [contractError, setContractError] = useState(\"\");\r\n  const [typeError, setTypeError] = useState(\"\");\r\n  const [update, setUpdate] = useState(false);\r\n  const [email, setEmail] = useState(\"\");\r\n  const [emailError, setEmailError] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [phoneError, setPhoneError] = useState(\"\");\r\n  const [fname, setFname] = useState(\"\");\r\n  const [lname, setLname] = useState(\"\");\r\n  const [website, setWebsite] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n\r\n  const [companies, setCompanies] = useState([]);\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\r\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\r\n\r\n  const [trades, setTrades] = useState([]);\r\n  const [dropdownTrades, setDropdownTrades] = useState([]);\r\n  const [selectedTrade, setSelectedTrade] = useState(\"\");\r\n  const [listOfTrades, setListOfTrades] = useState([]);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n  }, []);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      //formik.setFieldValue(\"site\", adminStore.site.siteId.name);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_COMPANY}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.site_companies);\r\n        setTrades(response.data.site_trades);\r\n        if (response.data.site_companies != null) {\r\n          const companyTemp = [];\r\n\r\n          response.data.site_companies.map((item, index) => {\r\n            return companyTemp.push({\r\n              label: item.companyId.name,\r\n              value: item.companyId.name,\r\n            });\r\n          });\r\n          setDropdownCompanies(companyTemp);\r\n        }\r\n\r\n        if (response.data.site_trades != null) {\r\n          const tradesTemp = [];\r\n\r\n          response.data.site_trades.map((item, index) => {\r\n            return tradesTemp.push({\r\n              label: item,\r\n              value: item,\r\n            });\r\n          });\r\n          setDropdownTrades(tradesTemp);\r\n        }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  // const [startDate, setStartDate] = useState(\"\");\r\n  // const [startDateError, setStartDateError] = useState(\"\");\r\n  // const [isDateSelect, setIsDateSelect] = useState(\"\");\r\n  // const [endDate, setEndDate] = useState(\"\");\r\n  // const [endDateError, setEndDateError] = useState(\"\");\r\n  // const [available, setAvailable] = useState(\"VOIR LES INDISPONIBILITÉS\");\r\n  // const [techSheet, setTechSheet] = useState([]);\r\n  // const [rate, setRate] = useState(\"\");\r\n  // const [rateError, setRateError] = useState(\"\");\r\n\r\n  const onSubmit = async () => {\r\n    // const notificationTo = values.notificationTo.map((item) => item.label);\r\n    const values = formik.values;\r\n    const isSubContractor = companyType === \"subcontractor\";\r\n    const parentCompanyId = companies[selectedCompanyIndex].companyId._id;\r\n\r\n    alert(\r\n      name +\r\n        \" \" +\r\n        phone +\r\n        \" \" +\r\n        fname +\r\n        \" \" +\r\n        lname +\r\n        \" \" +\r\n        website +\r\n        \" \" +\r\n        addInfo,\r\n    );\r\n    return;\r\n\r\n    var formdata = new FormData();\r\n    formdata.append(\"logo\", values.images[0].file);\r\n    formdata.append(\"name\", name);\r\n    formdata.append(\"color\", values.color);\r\n    formdata.append(\"firstName\", values.firstName);\r\n    formdata.append(\"lastName\", values.lastName);\r\n    formdata.append(\"email\", values.email);\r\n    formdata.append(\"phone\", values.phone);\r\n    // formdata.append(\"contractType\", values.contractType);\r\n    //formdata.append(\"contractStartDate\", values.contractStartDate);\r\n    //formdata.append(\"contractEndDate\", values.contractEndDate);\r\n    //formdata.append(\"functionality\", values.functionality);\r\n    //formdata.append(\"additionalInfo\", values.additionalInfo);\r\n    //formdata.append(\"notificationPriorToDays\", values.notificationPriorToDays);\r\n    // formdata.append(\"notificationTo\", JSON.stringify(notificationTo));\r\n    await GLOBALS.API({\r\n      method: \"POST\",\r\n      uri: GLOBALS.Constants.CLIENTS,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n\r\n  const inputChange = (e) => {\r\n    if (e.target.name === \"name\") {\r\n      setName(e.target.value);\r\n      if (e.target.name === \"\" || name === null) {\r\n        setNameError(true);\r\n      } else {\r\n        setNameError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"color\") {\r\n      setColor(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setColorError(true);\r\n      } else {\r\n        setColorError(false);\r\n      }\r\n    }\r\n    // if (e.target.name === \"companyType\") {\r\n    //   console.log(e.target.value);\r\n    //   setCompanyType(e.target.value);\r\n    //   console.log(\"company type\", companyType);\r\n    //   if (e.target.value === \"\" || e.target.value === null) {\r\n    //     setCompanyTypeError(true);\r\n    //   } else {\r\n    //     setCompanyTypeError(false);\r\n    //   }\r\n    // }\r\n    if (e.target.name === \"contract\") {\r\n      setContract(e.target.value);\r\n      if (\r\n        e.target.value === \"\" ||\r\n        e.target.value === null ||\r\n        e.target.value === undefined\r\n      ) {\r\n        setContractError(true);\r\n      } else {\r\n        setContractError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"email\") {\r\n      setEmail(e.target.value);\r\n      var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n      if (!e.target.value.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"phone\") {\r\n      setPhone(e.target.value);\r\n      if (e.target.value.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    }\r\n\r\n    if (e.target.name === \"images\") {\r\n      setImages(e.target.value);\r\n    }\r\n    if (e.target.name === \"trades\") {\r\n      setTrades(e.target.value);\r\n    }\r\n\r\n    if (e.target.name === \"addInfo\") {\r\n      setAddInfo(e.target.value);\r\n    }\r\n  };\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"trades\") {\r\n      if (value !== \"\") {\r\n        setUpdate((st) => !st);\r\n        setTrades(value);\r\n        console.log(\"trades\", trades);\r\n      }\r\n    }\r\n  };\r\n\r\n  const submitHandler = (e) => {\r\n    var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n    e.preventDefault();\r\n    if (name === \"\" || name === null) {\r\n      setNameError(true);\r\n    }\r\n    if (color === \"\" || color === null) {\r\n      setColorError(true);\r\n    }\r\n    if (\r\n      companyType === \"\" ||\r\n      companyType === null ||\r\n      companyType === undefined\r\n    ) {\r\n      setCompanyTypeError(true);\r\n    }\r\n    if (contract === \"\" || contract === null || contract === undefined) {\r\n      setContractError(true);\r\n    }\r\n    if (email !== \"\") {\r\n      if (!email.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (phone !== \"\") {\r\n      if (phone.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    } else {\r\n      console.log(\"contarct submit\", companyType);\r\n    }\r\n  };\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      images: [],\r\n      name: \"\",\r\n      color: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    validationSchema: addClientYup,\r\n    //    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n  console.log(\"type ==> \", companyType);\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"ADD A COMPANY\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <Autocomplete\r\n                  id=\"free-solo-demo\"\r\n                  freeSolo\r\n                  style={{\r\n                    ...GLOBALS.Styles.inputWidth,\r\n                    marginRight: \"10px\",\r\n                  }}\r\n                  onSelect={(event) => {\r\n                    companies.forEach((item, index) => {\r\n                      if (item.companyId.name === event.target.value) {\r\n                        setName(item.companyId.name);\r\n                      }\r\n                    });\r\n                  }}\r\n                  options={companies.map((option) => {\r\n                    if (option.companyId.name != undefined)\r\n                      return option.companyId.name;\r\n                  })}\r\n                  renderInput={(params) => (\r\n                    <TextField\r\n                      {...params}\r\n                      label=\"Email\"\r\n                      margin=\"normal\"\r\n                      variant=\"outlined\"\r\n                      name=\"name\"\r\n                      value={formik.values.email}\r\n                      error={formik.errors.email}\r\n                      onChange={formik.handleChange}\r\n                    />\r\n                  )}\r\n                />\r\n                {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"color\"\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Color\"\r\n                  value={color}\r\n                />\r\n                {colorError && (\r\n                  <div className={classes.error}>Please enter color</div>\r\n                )}\r\n              </div>\r\n              <FormMultipleUpload\r\n                name=\"images\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={formik.values.images}\r\n                onChange={(values) =>\r\n                  inputChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"images\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n                // onChange={inputChange}\r\n                // onChange={(values) =>\r\n\r\n                //      ( {type: \"text\",\r\n                //       name: \"trades\",\r\n                //       value: values})\r\n\r\n                // }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF COMPANY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div>\r\n                <div>\r\n                  <input\r\n                    className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    onChange={(e) => setCompanyType(\"generalcontractor\")}\r\n                    id=\"generalcontractor\"\r\n                    name=\"companyType\"\r\n                    value=\"generalcontractor\"\r\n                  />\r\n                  <label for=\"generalcontractor\" className={classes.radioLabel}>\r\n                    General Contractor\r\n                  </label>\r\n                  <input\r\n                    className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"subcontractor\"\r\n                    name=\"companyType\"\r\n                    onChange={(e) => {\r\n                      setCompanyType(\"subcontractor\");\r\n                      console.log(companyType);\r\n                    }}\r\n                    value=\"subcontractor\"\r\n                    defaultChecked\r\n                  />\r\n                  <label for=\"subcontractor\" className={classes.radioLabel}>\r\n                    Sub contractor\r\n                  </label>\r\n                </div>\r\n                {companyTypeError === true && (\r\n                  <div className={classes.error}>Please select company</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"GENERAL CONTRACTOR : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"100%\", height: \"100%\" }}>\r\n                <FormSelect\r\n                  placeholder=\"Company\"\r\n                  values={dropdownCompanies}\r\n                  value={selectedCompany}\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  onChange={(event) => {\r\n                    const index = event.target.selectedIndex - 1;\r\n\r\n                    if (index !== -1) {\r\n                      const item = event.target.value;\r\n\r\n                      setSelectedCompanyIndex(index);\r\n\r\n                      setSelectedCompany(item);\r\n                    } else {\r\n                      setSelectedCompanyIndex(null);\r\n\r\n                      setSelectedCompany(\"\");\r\n                    }\r\n                  }}\r\n                  style={{ marginRight: \"20px\", maxWidth: 250 }}\r\n                />\r\n                {/* <select\r\n                  name=\"contract\"\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  id=\"contract\"\r\n                  type={contract}\r\n                  style={{\r\n                    width: \"40%\",\r\n                    height: \"45px\",\r\n                    color: \"#8B8989\",\r\n                    padding: \"0px 10px\",\r\n                  }}\r\n                  onChange={inputChange}\r\n                >\r\n                \r\n                </select> */}\r\n                {contractError === true && (\r\n                  <div className={classes.error}>Please select contract</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TRADES : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <CustomInputModal\r\n                name=\"trades\"\r\n                values={dropdownTrades}\r\n                value={selectedTrade}\r\n                placeholder=\"Select Trades\"\r\n                chipValues={(values) => {\r\n                  const valuesTemp = [];\r\n                  values.forEach((item, index) => {\r\n                    valuesTemp.push(item.label);\r\n                  });\r\n                  setListOfTrades(valuesTemp);\r\n                  console.log(JSON.stringify(valuesTemp, null, 2));\r\n\r\n                  // setSiteParams(values);\r\n                }}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n\r\n                    setSelectedTrade(item);\r\n                  } else {\r\n                    setSelectedTrade(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDEMTITY OF RESPONSIBLE* : \" />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"email\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Adresse e-mail\"\r\n                  onChange={inputChange}\r\n                  value={email}\r\n                />\r\n                {emailError === true && (\r\n                  <div className={classes.error}>Please enter valid email</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"phone\"\r\n                  type=\"number\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Téléphone\"\r\n                  onChange={inputChange}\r\n                  value={phone}\r\n                />\r\n                {phoneError === true && (\r\n                  <div className={classes.error}>\r\n                    Telephone should be 10 digits\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"fname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"First Name\"\r\n                  onChange={(e) => setFname(e.target.value)}\r\n                  value={fname}\r\n                />\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"lname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Last Name\"\r\n                  onChange={(e) => setLname(e.target.value)}\r\n                  value={lname}\r\n                />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"Website : \" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                name=\"website\"\r\n                style={{ width: \"50%\" }}\r\n                placeholder=\"http://\"\r\n                onChange={(e) => setWebsite(e.target.value)}\r\n                value={website}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                style={{ width: \"90%\" }}\r\n                onChange={(e) => setAddInfo(e.target.value)}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              onClick={() => {\r\n                onSubmit();\r\n              }}\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              disabled={name === \"\" || color === \"\" || companyType === \"\"}\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Companies\\Companies.js",["576","577","578","579","580"],"import React, { useState, useEffect } from \"react\";\r\nimport { NavLink } from \"react-router-dom\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\r\n// import * as Yup from \"yup\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Actions from \"../../../redux/actions\";\r\n\r\nimport Form from \"../../../components/Form\";\r\nimport Modal from \"../../../components/Modal\";\r\nimport Table from \"../../../components/Table\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport SubHeading from \"../../../components/SubHeading\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport AvatarUpload from \"../../../components/AvatarUpload\";\r\nimport uploadIcon from \"../../../assets/images/upload.png\";\r\nimport { Images } from \"../../../assets/Assets\";\r\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    overflow: \"hidden\",\r\n    borderRadius: theme.shape.borderRadius,\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n    backgroundColor: theme.palette.secondary.main,\r\n  },\r\n}));\r\n\r\n// const updateAdminYup = Yup.object().shape({\r\n//   email: Yup.string().required(\"Required\"),\r\n//   phone: Yup.number()\r\n//     .test(\r\n//       \"len\",\r\n//       \"Must be exactly 10 characters\",\r\n//       (val) => val && val.toString().length === 10,\r\n//     )\r\n//     .required(\"Required\"),\r\n//   image: Yup.object().optional(\"\"),\r\n//   companyId: Yup.string().required(\"Required\"),\r\n// });\r\n\r\nexport default function Companies(props) {\r\n  const theme = useTheme();\r\n  const classes = useStyles();\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n\r\n  const [page] = useState(1);\r\n  const [items, setItems] = useState([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const [companies, setCompanies] = useState([]);\r\n  const [modal, setModal] = useState(false);\r\n  const [selectedItem] = useState(\"\");\r\n  const [firstName, setFirstName] = useState(\"\");\r\n  const [lastName, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [image, setImage] = useState(\"\");\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [nameOfResponsible, setNameOfResponsible] = useState(\"\");\r\n  const [nameOfCompany, setNameOfCompany] = useState(\"\");\r\n\r\n  useEffect(() => {\r\n    getData();\r\n\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      console.log(adminStore.site.siteId._id);\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_SITE_COMPANIES}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.companies);\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n  const handleChange = (name, value) => {\r\n    if (name === \"firstName\") setFirstName(value);\r\n    else if (name === \"lastName\") setLastName(value);\r\n    else if (name === \"phone\") setPhone(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"companyId\") setCompanyId(value);\r\n  };\r\n\r\n  const onUpdate = async (e) => {\r\n    try {\r\n      e.preventDefault();\r\n      setLoading(true);\r\n      var formdata = new FormData();\r\n      formdata.append(\"firstName\", firstName);\r\n      formdata.append(\"lastName\", lastName);\r\n      formdata.append(\"phone\", phone);\r\n      formdata.append(\"companyId\", companyId);\r\n      formdata.append(\"userId\", selectedItem._id);\r\n      image.file && formdata.append(\"image\", image.file);\r\n\r\n      const result = await GLOBALS.API({\r\n        method: \"PUT\",\r\n        uri: GLOBALS.Constants.ADMINS,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      const itemsArray = items.map((item) =>\r\n        item._id === selectedItem._id ? result.data : item,\r\n      );\r\n      setItems(itemsArray);\r\n      setLoading(false);\r\n      setModal(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getSubContractors = (subcontractors) => {\r\n    if (subcontractors && subcontractors.length > 0) {\r\n      const value = subcontractors\r\n        .map((item, index) => {\r\n          if (item.name != undefined) return item.name;\r\n          return \"N/A\";\r\n        })\r\n        .toString()\r\n        .replace(/,/g, \" \");\r\n      return value;\r\n    }\r\n    return \"N/A\";\r\n  };\r\n\r\n  const filterCompany = async () => {\r\n    try {\r\n      setLoading(true);\r\n      const params = { siteId: \"6008169bedbb7816d40b197d\" };\r\n      if (nameOfCompany.length !== 0) params[\"companyName\"] = nameOfCompany;\r\n      if (nameOfResponsible.length !== 0)\r\n        params[\"responsibleName\"] = nameOfResponsible;\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.FILTER_COMPANY_SITES}`,\r\n        token: store.token,\r\n        method: \"POST\",\r\n        body: JSON.stringify(params),\r\n      });\r\n      if (response.success) {\r\n        setCompanies(response.data.companies);\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const rows = companies.map((item) => {\r\n    return [\r\n      <img src={Images.site} alt=\"Icon\" />,\r\n      item.companyId.name,\r\n      getSubContractors(item.subContractors),\r\n      item.incharge != undefined\r\n        ? item.companyId.incharge.firstName +\r\n          \" \" +\r\n          item.companyId.incharge.lastName\r\n        : \"N/A\",\r\n      item.companyId.incharge != undefined\r\n        ? item.companyId.incharge.phone\r\n        : \"N/A\",\r\n      item.companyId.incharge != undefined\r\n        ? item.companyId.incharge.email\r\n        : \"N/A\",\r\n\r\n      <div>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <NavLink\r\n            to={{\r\n              pathname: \"/companies/user-list\",\r\n              id: item.companyId._id,\r\n            }}\r\n          >\r\n            <img\r\n              src={Images.comapnies}\r\n              style={{ width: 18, height: 17 }}\r\n              alt=\"Icon\"\r\n            />\r\n          </NavLink>\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <NavLink to=\"/companies/edit-companies\">\r\n            <Pencil style={{ width: 18, height: 15 }} />\r\n          </NavLink>\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <img\r\n            src={Images.calender}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <img\r\n            src={Images.invoices}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </IconButton>\r\n        <IconButton style={{ padding: \"6px\" }} onClick={() => {}}>\r\n          <img\r\n            src={Images.incidents}\r\n            style={{ width: 18, height: 17 }}\r\n            alt=\"Icon\"\r\n          />\r\n        </IconButton>\r\n      </div>,\r\n    ];\r\n  });\r\n\r\n  return (\r\n    <>\r\n      <div className={classes.root}>\r\n        <Form.Row alignItems=\"center\" className=\"pr-3\">\r\n          <Heading primary=\"LIST OF COMPANIES\" noWrap />\r\n          <div>\r\n            <Form.Row alignItems=\"center\" noMargin>\r\n              <SubHeading\r\n                disableMargin\r\n                primary={`Total : ${companies.length} COMPANIES`}\r\n                bold\r\n              />\r\n              <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"ADD A COMPANY\"\r\n                style={{ marginLeft: \"20px\" }}\r\n                to={\"/companies/add-companies\"}\r\n              />\r\n            </Form.Row>\r\n          </div>\r\n        </Form.Row>\r\n        <Form.Row noMargin className=\"pr-3\">\r\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\r\n            <SearchInput\r\n              placeholder=\"Name of responsible\"\r\n              value={nameOfResponsible}\r\n              onClick={() => {\r\n                filterCompany();\r\n              }}\r\n              onChange={(event) => {\r\n                setNameOfResponsible(event.target.value);\r\n              }}\r\n            />\r\n            <SearchInput\r\n              style={{ marginLeft: \"20px\" }}\r\n              placeholder=\"Name of company\"\r\n              value={nameOfCompany}\r\n              onClick={() => {\r\n                filterCompany();\r\n              }}\r\n              onChange={(event) => {\r\n                setNameOfCompany(event.target.value);\r\n              }}\r\n            />\r\n            <a href=\"#companies\">\r\n              <img\r\n                style={{\r\n                  width: \"1.3rem\",\r\n                  marginLeft: \"20px\",\r\n                  marginTop: \"10px\",\r\n                }}\r\n                src={uploadIcon}\r\n                alt=\"File Upload Icon\"\r\n              />\r\n            </a>\r\n          </Form.Row>\r\n          <Button\r\n            fullWidth={true}\r\n            component={NavLink}\r\n            text=\"ACCESS REQUEST TO ZONES\"\r\n            style={{ width: \"330px\" }}\r\n            to={\"/admins/add-admin\"}\r\n          />\r\n        </Form.Row>\r\n        <div className={classes.content}>\r\n          <Table headers={GLOBALS.Data.companies.headings} rows={rows} />\r\n        </div>\r\n      </div>\r\n      <Modal\r\n        title=\"EDIT ADMIN\"\r\n        open={selectedItem ? modal : false}\r\n        onClose={() => setModal((st) => !st)}\r\n        body={\r\n          <Form.Form onSubmit={onUpdate}>\r\n            <Form.Row justifyContent=\"center\">\r\n              <AvatarUpload\r\n                value={image}\r\n                // error={image}\r\n                onChange={(file) => {\r\n                  const uri = URL.createObjectURL(file);\r\n                  handleChange(\"image\", { file, uri });\r\n                }}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"firstName\"\r\n                value={firstName}\r\n                // error={firstName}\r\n                placeholder=\"First Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"lastName\"\r\n                value={lastName}\r\n                // error={lastName}\r\n                placeholder=\"Last Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormInput\r\n                name=\"phone\"\r\n                placeholder=\"Phone Number\"\r\n                value={phone}\r\n                // error={phone}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                style={GLOBALS.Styles.inputWidth}\r\n              />\r\n            </Form.Row>\r\n            <Form.Row justifyContent=\"center\">\r\n              <FormSelect\r\n                name=\"companyId\"\r\n                value={companyId}\r\n                // error={companyId}\r\n                values={companies}\r\n                placeholder=\"Company Name\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n            </Form.Row>\r\n            <Form.Column alignItems=\"center\">\r\n              <Form.Row justifyContent=\"center\">\r\n                <Button\r\n                  type=\"submit\"\r\n                  minWidth={200}\r\n                  text=\"VALIDATE\"\r\n                  fullWidth={false}\r\n                  loading={loading}\r\n                  disabled={\r\n                    loading ||\r\n                    !firstName ||\r\n                    !lastName ||\r\n                    !phone ||\r\n                    image === \"\" ||\r\n                    !companyId\r\n                  }\r\n                />\r\n              </Form.Row>\r\n              <Form.Row justifyContent=\"center\">\r\n                <Button\r\n                  text=\"DELETE\"\r\n                  minWidth=\"30%\"\r\n                  fullWidth={false}\r\n                  disabled={loading || true}\r\n                  color={theme.palette.error.main}\r\n                />\r\n              </Form.Row>\r\n            </Form.Column>\r\n          </Form.Form>\r\n        }\r\n      />\r\n    </>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\CustomFormInput.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\CustomButtonModal.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\CustomInputModalSingleSelect.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\components\\CustomInputModal.js",[],{"ruleId":"581","replacedBy":"582"},{"ruleId":"583","replacedBy":"584"},{"ruleId":"585","severity":1,"message":"586","line":3,"column":10,"nodeType":"587","messageId":"588","endLine":3,"endColumn":19},{"ruleId":"585","severity":1,"message":"589","line":7,"column":13,"nodeType":"587","messageId":"588","endLine":7,"endColumn":16},{"ruleId":"585","severity":1,"message":"590","line":17,"column":8,"nodeType":"587","messageId":"588","endLine":17,"endColumn":26},{"ruleId":"585","severity":1,"message":"591","line":64,"column":10,"nodeType":"587","messageId":"588","endLine":64,"endColumn":18},{"ruleId":"585","severity":1,"message":"592","line":67,"column":10,"nodeType":"587","messageId":"588","endLine":67,"endColumn":19},{"ruleId":"585","severity":1,"message":"593","line":68,"column":10,"nodeType":"587","messageId":"588","endLine":68,"endColumn":14},{"ruleId":"585","severity":1,"message":"594","line":69,"column":10,"nodeType":"587","messageId":"588","endLine":69,"endColumn":14},{"ruleId":"585","severity":1,"message":"595","line":71,"column":10,"nodeType":"587","messageId":"588","endLine":71,"endColumn":19},{"ruleId":"585","severity":1,"message":"596","line":73,"column":10,"nodeType":"587","messageId":"588","endLine":73,"endColumn":22},{"ruleId":"585","severity":1,"message":"597","line":74,"column":10,"nodeType":"587","messageId":"588","endLine":74,"endColumn":19},{"ruleId":"585","severity":1,"message":"598","line":75,"column":10,"nodeType":"587","messageId":"588","endLine":75,"endColumn":19},{"ruleId":"585","severity":1,"message":"599",
ssabilityPoints = [\r\n  { label: \"Storage Area\", value: \"Storage Area\" },\r\n  { label: \"Delivery Area\", value: \"Delivery Area\" },\r\n];\r\n\r\nexport default function AddMean(props) {\r\n  const dispatch = useDispatch();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n  const [name, setName] = useState(\"\");\r\n  const [type, setType] = useState(\"\");\r\n  const [color, setColor] = useState(\"#d71313\");\r\n  const [image, setImage] = useState([]);\r\n  const [location, setLocation] = useState([]);\r\n  const [startDate, setStartDate] = useState(\"\");\r\n  const [endDate, setEndDate] = useState(\"\");\r\n  const [techSheet, setTechSheet] = useState([]);\r\n  const [rate, setRate] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n  const [loading, setLoading] = useState(true);\r\n  const classes = useStyles();\r\n\r\n  const [accessabilityPoint, setAccessabilityPoint] = useState(\"\");\r\n  const [DeliveryAreas, setDeliveryAreas] = useState([]);\r\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\r\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\r\n  const [\r\n    selectedSiteDeliveryAreadIndex,\r\n    seltSelectedSiteDeliveryAreaIndex,\r\n  ] = useState(null);\r\n\r\n  const [storageAreas, setStorageAreas] = useState([]);\r\n  const [dropdownStorageAreas, setDropdownStorageAreas] = useState([]);\r\n  const [\r\n    selectedDropdownStorageArea,\r\n    setSelectedDropdownStorageArea,\r\n  ] = useState(\"\");\r\n  const [selectedStorageAreaIndex, setSelectedStorageAreaIndex] = useState(\r\n    null,\r\n  );\r\n\r\n  const [deliveryAreaId, setDeilveryAreaId] = useState(\"\");\r\n  const [storageAreaId, setStorageAreaId] = useState(\"\");\r\n\r\n  const [\r\n    deliveryAndStorageLocations,\r\n    setDeliveryAndStorageLocations,\r\n  ] = useState([]);\r\n\r\n  const [buildings, setBuidings] = useState([]);\r\n  const [dropdownBuildings, setDropdownBuildings] = useState([]);\r\n  const [selectedBuildingIndex] = useState(null);\r\n\r\n  const [levels, setLevels] = useState([]);\r\n  const [selectedDropdownIndex] = useState(null);\r\n\r\n  const [meanTypes, setMeanTypes] = useState([]);\r\n  const [dropdownMeanTypes, setDropdownMeanTypes] = useState([]);\r\n  const [selectedMeanType, setSelectedMeanType] = useState(\"\");\r\n  const [selecetedMeanTypeIndex, setSelectedMeanTypeIndex] = useState(null);\r\n\r\n  useEffect(() => {\r\n    getData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n\r\n  useEffect(() => {}, [\r\n    meanTypes,\r\n    dropdownMeanTypes,\r\n    selecetedMeanTypeIndex,\r\n    selectedMeanType,\r\n  ]);\r\n\r\n  const getData = async () => {\r\n    try {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_ADD_MEAN}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data.site_delivery_areas !== null) {\r\n          const temp = [];\r\n          response.data.site_delivery_areas.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name, id: item._id }),\r\n          );\r\n          setDeliveryAreas(response.data.site_delivery_areas);\r\n          setDropdownDeliveryAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_storage_areas !== null) {\r\n          const temp = [];\r\n          response.data.site_storage_areas.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name, id: item._id }),\r\n          );\r\n          setStorageAreas(response.data.site_storage_areas);\r\n          setDropdownStorageAreas(temp);\r\n        }\r\n\r\n        if (response.data.site_buildings !== null) {\r\n          const temp = [];\r\n          response.data.site_buildings.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n          setBuidings(response.data.site_buildings);\r\n          setDropdownBuildings(temp);\r\n        }\r\n\r\n        if (response.data.mean_types !== null) {\r\n          const temp = [];\r\n          response.data.mean_types.map((item, index) =>\r\n            temp.push({ label: item, value: item }),\r\n          );\r\n          setMeanTypes(response.data.mean_types);\r\n          setDropdownMeanTypes(temp);\r\n        }\r\n        // if (response.data.mean_types !== null) {\r\n        //   setTypes(response.data.mean_types);\r\n        //   const temp = [];\r\n        //   response.data.mean_types.map((item, index) => {\r\n        //     temp.push({ label: item, value: item });\r\n        //   });\r\n        //   setDropdownTypes(temp);\r\n        // }\r\n      } else {\r\n      }\r\n\r\n      //   setItems(response.data.items);\r\n      setLoading(false);\r\n    } catch (err) {\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  function handleChange(name, value) {\r\n    if (name === \"name\") {\r\n      setName(value);\r\n    }\r\n    else if (name === \"type\") setType(value);\r\n    else if (name === \"color\") setColor(value);\r\n    else if (name === \"image\") setImage(value);\r\n    else if (name === \"location\") setLocation(value);\r\n    else if (name === \"startDate\") setStartDate(value);\r\n    else if (name === \"endDate\") setEndDate(value);\r\n    else if (name === \"techSheet\") setTechSheet(value);\r\n    else if (name === \"rate\") setRate(value);\r\n    else if (name === \"addInfo\") setAddInfo(value);\r\n  }\r\n\r\n  const createMean = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      var formdata = new FormData();\r\n\r\n      let locations = [];\r\n\r\n      deliveryAndStorageLocations.forEach((item) => {\r\n        if (item.type === accessabilityPoints[0].value) {\r\n          let loc = {\r\n            locationType: \"STORAGEAREA\",\r\n            storageArea: item.id,\r\n          };\r\n          locations.push(loc);\r\n        }\r\n        if (item.type === accessabilityPoints[1].value) {\r\n          let loc = {\r\n            locationType: \"DELIVERYAREA\",\r\n            deliveryArea: item.id,\r\n          };\r\n          locations.push(loc);\r\n        }\r\n      });\r\n\r\n      let availabilities = {\r\n        start: startDate,\r\n        end: endDate,\r\n      };\r\n\r\n      // TEST DATA , CALENDAR NOT MADE YET\r\n\r\n      const sampleDateOne = new Date(\"05/20/2021\");\r\n      const sampleDateTwo = new Date(\"05/28/2021\");\r\n      const unavailabilities = [\r\n        {\r\n          date: sampleDateOne,\r\n          reason: \"Public Holiday\",\r\n          startingHour: new Date().getTime(),\r\n          endingHour: new Date().getTime(),\r\n        },\r\n        {\r\n          date: sampleDateTwo,\r\n          reason: \"Maintenance\",\r\n          startingHour: new Date().getTime(),\r\n          endingHour: new Date().getTime(),\r\n        },\r\n      ];\r\n\r\n      formdata.append(\"name\", name);\r\n      formdata.append(\"color\", color);\r\n      formdata.append(\"image\", image[0].file);\r\n      formdata.append(\"sheet\", image[0].file);\r\n      formdata.append(\"pricePerHour\", rate);\r\n      formdata.append(\"additionalInfo\", addInfo);\r\n      formdata.append(\"siteId\", adminStore.site.siteId._id);\r\n      formdata.append(\"meanType\", selectedMeanType);\r\n      formdata.append(\"location\", JSON.stringify(locations));\r\n      formdata.append(\"availability\", JSON.stringify(availabilities));\r\n      formdata.append(\"unavailability\", JSON.stringify(unavailabilities));\r\n\r\n      const response = await GLOBALS.API({\r\n        method: \"POST\",\r\n        uri: GLOBALS.Constants.CREATE_MEAN,\r\n        headers: {\r\n          Authorization: store.token,\r\n        },\r\n        body: formdata,\r\n      });\r\n      console.log(JSON.stringify(response, null, 2));\r\n\r\n      if (response.success) {\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n        dispatch(\r\n          Actions.notistack.enqueueSnackbar(\r\n            Actions.notistack.snackbar(response.message, \"error\"),\r\n          ),\r\n        );\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getDeliveryArea = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data !== null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n\r\n          setDropdownDeliveryAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  const getStorageArea = async () => {\r\n    try {\r\n      setLoading(true);\r\n\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n\r\n      if (response.success) {\r\n        setLevels(response.data);\r\n        if (response.data !== null && response.data.length > 0) {\r\n          const temp = [];\r\n          response.data.map((item, index) =>\r\n            temp.push({ label: item.name, value: item.name }),\r\n          );\r\n\r\n          setDropdownStorageAreas(temp);\r\n        }\r\n        setLoading(false);\r\n      } else {\r\n        setLoading(false);\r\n      }\r\n      setLoading(false);\r\n    } catch (err) {\r\n      setLoading(false);\r\n      dispatch(\r\n        Actions.notistack.enqueueSnackbar(\r\n          Actions.notistack.snackbar(err.message, \"error\"),\r\n        ),\r\n      );\r\n    }\r\n  };\r\n\r\n  // const getLevels = async (buidlingId) => {\r\n  //   try {\r\n  //     setLoading(true);\r\n\r\n  //     const response = await GLOBALS.API({\r\n  //       uri: `${GLOBALS.Constants.GET_LEVELS}/${buidlingId}`,\r\n  //       token: store.token,\r\n  //     });\r\n\r\n  //     if (response.success) {\r\n  //       setLevels(response.data);\r\n  //       if (response.data !== null && response.data.length > 0) {\r\n  //         const temp = [];\r\n  //         response.data.map((item, index) =>\r\n  //           temp.push({ label: item.name, value: item.name }),\r\n  //         );\r\n\r\n  //         setDropdownLevels(temp);\r\n  //       }\r\n  //       setLoading(false);\r\n  //     } else {\r\n  //       setLoading(false);\r\n  //     }\r\n  //     setLoading(false);\r\n  //   } catch (err) {\r\n  //     setLoading(false);\r\n  //     dispatch(\r\n  //       Actions.notistack.enqueueSnackbar(\r\n  //         Actions.notistack.snackbar(err.message, \"error\"),\r\n  //       ),\r\n  //     );\r\n  //   }\r\n  // };\r\n  const handleChangecolor = (color) => {\r\n    setColor(color.hex )\r\n    console.log(\"color is\", color.hex);\r\n  };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n\r\n      <Form.Row>\r\n        <Heading primary=\"ADD A MEAN\" />\r\n\r\n        {/* <Button\r\n                fullWidth={false}\r\n                component={NavLink}\r\n                text=\"LOCALISATION\"\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginRight: \"100px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\"\r\n                }}\r\n              /> */}\r\n      </Form.Row>\r\n      <div className={classes.content}>\r\n        <Form.Form>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY * : \" />\r\n            <Form.Row noMargin width=\"65%\" style={{ gap: \"20px\", justifyContent: \"flex-start\" }}>\r\n              <FormInput\r\n                name=\"name\"\r\n                value={name}\r\n                placeholder=\"name\"\r\n                style={{width: \"25%\"}}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n              />\r\n              <FormSelect\r\n                placeholder=\"Type\"\r\n                name=\"type\"\r\n                style={{width: \"25%\"}}\r\n                values={dropdownMeanTypes}\r\n                onChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    setSelectedMeanTypeIndex(index);\r\n                    setSelectedMeanType(item);\r\n                  } else {\r\n                    setSelectedMeanTypeIndex(null);\r\n                    setSelectedMeanType(\"\");\r\n                  }\r\n                }}\r\n              />\r\n              <div style={{ width: \"25%\" }}>\r\n                <ColorPicker color={color} handleChange={handleChangecolor} />\r\n              </div>\r\n              {/* <FormSelect\r\n                placeholder=\"color\"\r\n                name=\"color\"  \r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={color}\r\n                values={[\r\n                  { value: \"green\", label: \"Green\" },\r\n                  { value: \"Yellow\", label: \"Yellow\" },\r\n                  { value: \"Red\", label: \"Red\" },\r\n                  { value: \"Blue\", label: \"Blue\" },\r\n                  { value: \"Orange\", label: \"Orange\" },\r\n                  { value: \"Purple\", label: \"Purple\" },\r\n                  { value: \"Magenta\", label: \"Magenta\" },\r\n                ]}\r\n              /> */}\r\n              \r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IMAGE :  \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n            <FormMultipleUpload\r\n                name=\"image\"\r\n                style={{width: \"40%\"}}\r\n                values={image}\r\n                onChange={(values) => {\r\n                  handleChange(\"image\", values);\r\n                }}\r\n              />\r\n            </Form.Row>\r\n            \r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"LOCATION * :  \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <CustomInputModal\r\n                name=\"location\"\r\n                values={accessabilityPoints}\r\n                leftValue={accessabilityPoint}\r\n                rightValue={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? selectedDropdownStorageArea\r\n                    : selectedDropdownArea\r\n                }\r\n                leftId={accessabilityPoint}\r\n                rightId={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? storageAreaId\r\n                    : deliveryAreaId\r\n                }\r\n                chipValues={(values) => {\r\n                  console.log(JSON.stringify(values, null, 2));\r\n                  setDeliveryAndStorageLocations(values);\r\n                }}\r\n                leftDropdownValues={accessabilityPoints}\r\n                leftDropdwonPlaceholder={\"Select Location Type\"}\r\n                rightDropdownPlaceholder={\"Select Location\"}\r\n                leftDropdwonValueChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    setAccessabilityPoint(item);\r\n                    if (item === accessabilityPoints[0].value) {\r\n                      getStorageArea();\r\n                    }\r\n                    if (item === accessabilityPoints[1].value) {\r\n                      getDeliveryArea();\r\n                    } else {\r\n                      seltSelectedSiteDeliveryAreaIndex(0);\r\n                      setSelectedDropdownArea(\"\");\r\n                      setDeilveryAreaId(\"\");\r\n\r\n                      setSelectedStorageAreaIndex(0);\r\n                      setSelectedDropdownStorageArea(\"\");\r\n                      setStorageAreaId(\"\");\r\n                    }\r\n                  } else {\r\n                    seltSelectedSiteDeliveryAreaIndex(0);\r\n                    setSelectedDropdownArea(\"\");\r\n                    setDeilveryAreaId(\"\");\r\n\r\n                    setSelectedStorageAreaIndex(0);\r\n                    setSelectedDropdownStorageArea(\"\");\r\n                    setStorageAreaId(\"\");\r\n                  }\r\n                }}\r\n                rightDropdownValues={\r\n                  accessabilityPoint === accessabilityPoints[0].value\r\n                    ? dropdownStorageAreas\r\n                    : dropdownDeliveryAreas\r\n                }\r\n                // error={addresses}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                rightDropdwonValueChange={(event) => {\r\n                  const index = event.target.selectedIndex - 1;\r\n                  if (index !== -1) {\r\n                    const item = event.target.value;\r\n                    if (accessabilityPoints[0].value === accessabilityPoint) {\r\n                      setStorageAreaId(storageAreas[index]._id);\r\n                      setSelectedStorageAreaIndex(index);\r\n                      setSelectedDropdownStorageArea(item);\r\n                    } else {\r\n                      setSelectedStorageAreaIndex(0);\r\n                      setSelectedDropdownStorageArea(\"\");\r\n                    }\r\n\r\n                    if (accessabilityPoints[1].value === accessabilityPoint) {\r\n                      setDeilveryAreaId(DeliveryAreas[index]._id);\r\n                      seltSelectedSiteDeliveryAreaIndex(index);\r\n                      setSelectedDropdownArea(item);\r\n                    } else {\r\n                      seltSelectedSiteDeliveryAreaIndex(0);\r\n                      setSelectedDropdownArea(\"\");\r\n                    }\r\n                  } else {\r\n                    setSelectedStorageAreaIndex(0);\r\n                    setSelectedDropdownStorageArea(\"\");\r\n                    seltSelectedSiteDeliveryAreaIndex(0);\r\n                    setSelectedDropdownArea(\"\");\r\n                  }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"AVAILAIBILITIES * :\" />\r\n            <Form.Row\r\n              noMargin\r\n              width=\"65%\"\r\n              justifyContent=\"flex-start\"\r\n              style={{ gap: \"20px\" }}\r\n            >\r\n              <FormInput\r\n                type=\"date\"\r\n                style={{ width: \"300px\" }}\r\n                placeholder={`Start date`}\r\n                name=\"startDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={startDate}\r\n              />\r\n              <FormInput\r\n                type=\"date\"\r\n                placeholder=\"End date\"\r\n                style={{ width: \"300px\" }}\r\n                name=\"endDate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={endDate}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TECHNICAL SHEET :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormMultipleUpload\r\n                name=\"techSheet\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                values={techSheet}\r\n                onChange={(values) => {\r\n                  handleChange(\"techSheet\", values);\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"UNAVAILABILITIES\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <div\r\n                // name=\"availability\"\r\n\r\n                to={\"/means/add-mean\"}\r\n                style={{\r\n                  marginLeft: \"0px\",\r\n                  marginBottom: \"7px\",\r\n                  width: \"320px\",\r\n                  color: \"#fff\",\r\n                  padding: \"0.8rem 0\",\r\n                  borderRadius: \"8px\",\r\n                  textAlign: \"center\",\r\n                  backgroundColor: \"#140772\",\r\n                }}\r\n              >\r\n                SHOW UNAVAILABILITIES\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n          <FormLabel bold primary=\"HOURLY RATE :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <div style={{ width: \"30%\", height: \"100%\", position: \"relative\" }}>\r\n                <FormInput\r\n            \r\n                  type=\"number\"\r\n                  name=\"rate\"\r\n                  onChange={({ target: { name, value } }) =>\r\n                    handleChange(name, value)\r\n                  }\r\n                  value={rate}\r\n                />\r\n               <span style={{position: \"absolute\", top: \"25%\", right: \"5%\"}}>€</span>\r\n              </div>\r\n             \r\n            </Form.Row>\r\n          </Form.Row>\r\n          {/* <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"TARIF HORAIRE : \" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormInput\r\n                textArea\r\n                rows={1}\r\n                style={{ width: \"300px\", textAlign: \"right\" }}\r\n                placeholder=\"€\"\r\n                name=\"rate\"\r\n                onChange={({ target: { name, value } }) =>\r\n                  handleChange(name, value)\r\n                }\r\n                value={rate}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row> */}\r\n\r\n          \r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONAL INFORMATION :\" />\r\n            <Form.Row noMargin width=\"65%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                maxLength=\"300\"\r\n                style={{ width: \"100%\" }}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                className=\"means-addinfo\"\r\n                onChange={({ target: { name, value } }) => {\r\n                  handleChange(name, value);\r\n                }}\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          {type && \"\"}\r\n          <Form.Row>\r\n            <Form.ButtonContainer style={{ width: \"80%\" }}>\r\n              <Button\r\n                minWidth={200}\r\n                text=\"VALIDATE\"\r\n                fullWidth={false}\r\n                onClick={async () => {\r\n                  await createMean();\r\n                }}\r\n                // loading={formik.isSubmitting}\r\n                disabled={\r\n                  !name ||\r\n                  !selectedMeanType ||\r\n                  !color ||\r\n                  !startDate ||\r\n                  !deliveryAndStorageLocations\r\n                }\r\n              />\r\n            </Form.ButtonContainer>\r\n          </Form.Row>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\SuperAdmin\\Admins\\Admins.js",[],"C:\\Users\\HP\\Desktop\\Falcon work\\orgaplan-reactjs\\src\\pages\\Admin\\Incidents\\editIncidents.js",["531","532","533","534","535","536","537","538","539","540"],"import React, { useState, useEffect } from \"react\";\r\n\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport SmallText from \"../../../components/SmallText\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\n\r\nconst useStyles = makeStyles(() => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n  error: {\r\n    color: \"red\",\r\n  },\r\n}));\r\n\r\n\r\n\r\nexport default function AddIncidents(props) {\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n\r\n  const [name, setName] = useState(\"\");\r\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\r\n  const [dropdownLocationType, setDropdownLocationType] = useState([]);\r\n  const [dropdownLocation, setDropdownLocation] = useState([]);\r\n  const [selectedLocation, setSelectedLocation] = useState([]);\r\n\r\n  const [location, setLocations] = useState([]);\r\n  const [selectedLocationType, setselectedLocationType] = useState(\"\");\r\n\r\n  const [companyId, setCompanyId] = useState(\"\");\r\n  const [description, setDescription] = useState(\"\");\r\n\r\n  const [date, setDate] = useState(\"\");\r\n  const [time, setTime] = useState(\"\");\r\n\r\n  const [isBillable, setBillable] = useState(false);\r\n  const [price, setPrice] = useState(\"\");\r\n  const [comment, setComment] = useState(\"\");\r\n  const [selctedLocationObject, setselctedLocationObject] = useState(\"\");\r\n\r\n  const [nameError, setNameError] = useState(\"\"); //working\r\n\r\n  const [comapnyError, setComapnyError] = useState(\"\");\r\n  const [dateError, setDateError] = useState(\"\");\r\n  const [timeError, setTimeError] = useState(\"\");\r\n\r\n  useEffect(() => {\r\n    fetchData();\r\n    // eslint-disable-next-line\r\n  }, []);\r\n  useEffect(() => {\r\n    fetchLocationDataOnTypeChange();\r\n    // eslint-disable-next-line\r\n  }, [selectedLocationType]);\r\n\r\n  const fetchData = async () => {\r\n    const response = await GLOBALS.API({\r\n      uri: `${GLOBALS.Constants.GET_SITE_INCIDENT}/${adminStore.site.siteId._id}`,\r\n      token: store.token,\r\n    });\r\n\r\n    console.log(response);\r\n\r\n    if (response.success) {\r\n      if (response.data.site_companies) {\r\n        const temp = [];\r\n        response.data.site_companies.map((item, index) => {\r\n          return temp.push({\r\n            label: item.companyId.name,\r\n            value: item.companyId._id,\r\n          });\r\n        });\r\n        setDropdownCompanies(temp);\r\n\r\n        console.log(dropdownCompanies);\r\n      }\r\n\r\n      if (response.data.locationTypes) {\r\n        setLocations(response.data.locationTypes);\r\n        const temp = [];\r\n        response.data.locationTypes.map((item, index) => {\r\n          return temp.push({ label: item, value: item });\r\n        });\r\n        setDropdownLocationType(temp);\r\n      }\r\n    }\r\n    await setValues();\r\n  };\r\n\r\n  const setValues = () => {\r\n    const incident = props?.location?.data;\r\n    setName(incident.name);\r\n    setCompanyId(incident?.companyId?._id);\r\n    setDate(incident?.date);\r\n    setBillable(incident?.isBillable);\r\n    setPrice(incident?.price);\r\n    console.log(props.location?.data);\r\n\r\n    // setType(contactInfo.type);\r\n    // setEmail(contactInfo.email);\r\n    // setPhone(contactInfo.phone);\r\n    // setFirstName(contactInfo.firstName);\r\n    // setLastName(contactInfo.lastName);\r\n    // setImage([{ key: 0, file: undefined, uri: contactInfo.image }]);\r\n\r\n    // // setImage(fileClone);\r\n\r\n    // setCompany(contactInfo.company);\r\n    // setRole(contactInfo.role);\r\n  };\r\n\r\n  const onFormSubmit = async () => {\r\n    // const notificationTo = values.notificationTo.map((item) => item.label);\r\n\r\n    var formdata = new FormData();\r\n    // formdata.append(\"photos\", values.logo[0].file);\r\n    formdata.append(\"name\", name);\r\n    formdata.append(\"date\", date);\r\n\r\n    formdata.append(\"time\", time);\r\n    formdata.append(\"description\", description);\r\n    formdata.append(\"isBillable\", isBillable);\r\n    formdata.append(\"price\", price);\r\n    formdata.append(\"comment\", comment);\r\n    formdata.append(\r\n      \"location\",\r\n      JSON.stringify({ deliveryArea: \"600952a9df49e51b42fab57b\" }),\r\n    );\r\n    // formdata.append(\"type\", );\r\n    formdata.append(\"companyId\", companyId);\r\n    formdata.append(\"siteId\", adminStore.site.siteId._id);\r\n    console.log(store.token);\r\n    await GLOBALS.API({\r\n      method: \"POST\",\r\n      uri: GLOBALS.Constants.POST_ADD_SITE_INCIDENTS,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n\r\n    props.history.push(\"/incidents\");\r\n  };\r\n  const nameChange = (e) => {\r\n    console.log(e.target.value, e.target.label);\r\n    if (e.target.name === \"name\") {\r\n      setName(e.target.value);\r\n      if (e.target.name === \"\" || name === null) {\r\n        setNameError(true);\r\n      } else {\r\n        setNameError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"comapnyId\") {\r\n      setCompanyId(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setComapnyError(true);\r\n      } else {\r\n        setComapnyError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"date\") {\r\n      setDate(e.target.value);\r\n      // console.log(date)\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setDateError(true);\r\n      } else {\r\n        setDateError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"time\") {\r\n      setTime(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setTimeError(true);\r\n      } else {\r\n        setTimeError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"location\") {\r\n      // setTime(e.target.value);\r\n      const selectedObject = dropdownLocation.filter(\r\n        (x) => x.value === e.target.value,\r\n      );\r\n      console.log(selectedObject[0]);\r\n      setSelectedLocation(selectedObject[0]);\r\n      const locationObject = {};\r\n      locationObject[0] = selectedLocationType;\r\n\r\n      locationObject[1] = e.target.value;\r\n      setselctedLocationObject(locationObject);\r\n\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setTimeError(true);\r\n      } else {\r\n        setTimeError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"description\") {\r\n      setDescription(e.target.value);\r\n      // if (e.target.value === \"\" || e.target.value === null) {\r\n      //   setTimeError(true);\r\n      // } else {\r\n      //   setTimeError(false);\r\n      // }\r\n    }\r\n    if (e.target.name === \"setBillable\") {\r\n      setBillable(e.target.value);\r\n      // if (e.target.value === \"\" || e.target.value === null) {\r\n      //   setTimeError(true);\r\n      // } else {\r\n      //   setTimeError(false);\r\n      // }\r\n    }\r\n    if (e.target.name === \"price\") {\r\n      setPrice(e.target.value);\r\n      // if (e.target.value === \"\" || e.target.value === null) {\r\n      //   setTimeError(true);\r\n      // } else {\r\n      //   setTimeError(false);\r\n      // }\r\n    }\r\n    if (e.target.name === \"comment\") {\r\n      //working\r\n      setComment(e.target.value);\r\n      // if (e.target.value === \"\" || e.target.value === null) {\r\n      //   setTimeError(true);\r\n      // } else {\r\n      //   setTimeError(false);\r\n      // }\r\n    }\r\n  };\r\n\r\n  const fetchLocationDataOnTypeChange = async () => {\r\n    if (selectedLocationType === \"STORAGEAREA\") {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n      }\r\n      console.log(response);\r\n    }\r\n    if (selectedLocationType === \"DELIVERYAREA\") {\r\n      const response = await GLOBALS.API({\r\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/${adminStore.site.siteId._id}`,\r\n        token: store.token,\r\n      });\r\n      if (response.success) {\r\n        if (response.data) {\r\n          const temp = [];\r\n          response.data.map((item, index) => {\r\n            return temp.push({ label: item.name, value: item._id });\r\n          });\r\n          setDropdownLocation(temp);\r\n        }\r\n      }\r\n      console.log(response);\r\n    }\r\n  };\r\n  const locationTypeChange = (e) => {\r\n    setselectedLocationType(e.target.value);\r\n  };\r\n  const submitHandler = (e) => {\r\n    e.preventDefault();\r\n    if (name === \"\" || name === null) {\r\n      setNameError(true);\r\n    }\r\n    // if (types === \"\" || types === null) {\r\n    //   setTypeError(true);\r\n    // }\r\n    // if (color === \"\" || color === null) {\r\n    //   setColorError(true);\r\n    // }\r\n    // if (startDate === \"\" || startDate === undefined || startDate === null) {\r\n    //   setStartDateError(true);\r\n    //   setIsDateSelect(true);\r\n\r\n    // }\r\n    // if (endDate === \"\" || endDate === undefined || endDate === null) {\r\n    //   setEndDateError(true);\r\n    // }\r\n    // if( rate === \"\" || rate === null){\r\n    //   setRateError(true);\r\n    // }\r\n    // if( name !== \"\" && types !== \"\" && color !== \"\" && startDate !== \"\" && endDate !== \"\"){\r\n    //   clearFileds();\r\n    // }\r\n    else {\r\n      // clearFileds();\r\n      // submitIncident()\r\n    }\r\n    onFormSubmit();\r\n  };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"EDIT AN INCIDENTS\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"DESIGNATION* :\" />\r\n            <FormInput\r\n              name=\"name\"\r\n              style={GLOBALS.Styles.inputWidth}\r\n              placeholder=\"Name of incident\"\r\n              onChange={nameChange}\r\n              value={name}\r\n            />\r\n            {/* {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )} */}\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"NAME OF COMPANY* :\" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormSelect\r\n                placeholder=\"Nom de I'enterprise\"\r\n                name=\"comapnyId\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={nameChange}\r\n                value={companyId}\r\n                values={dropdownCompanies}\r\n              />\r\n              <span\r\n                style={{\r\n                  textAlign: \"center\",\r\n                  marginRight: \"50px\",\r\n                  marginTop: \"10px\",\r\n                }}\r\n              >\r\n                General Contractor name\r\n              </span>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"DATE AND TIME : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormInput\r\n                type=\"date\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                placeholder=\"Date\"\r\n                name=\"date\"\r\n                onChange={nameChange}\r\n                value=\"{date}\"\r\n                // error={formik.errors.contractStartDate}\r\n              />\r\n              <FormInput\r\n                placeholder=\"TIME\"\r\n                type=\"number\"\r\n                name=\"time\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={nameChange}\r\n                value=\"time\"\r\n                // value={formik.values.color}\r\n                // error={formik.errors.color}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"LOCATION : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              <FormSelect\r\n                placeholder=\"Type of location\"\r\n                name=\"color\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={locationTypeChange}\r\n                // value={formik.values.color}\r\n                // error={formik.errors.color}\r\n                values={dropdownLocationType}\r\n              />\r\n              <FormSelect\r\n                placeholder=\"LOCATION\"\r\n                name=\"location\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={nameChange}\r\n                // value={formik.values.color}\r\n                // error={formik.errors.color}\r\n                value=\"\"\r\n                values={dropdownLocation}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"DESCRIPTION : \" />\r\n            <FormInput\r\n              textArea\r\n              rows={3}\r\n              style={GLOBALS.Styles.inputWidth}\r\n              onChange={nameChange}\r\n              placeholder=\"Information complementaires\"\r\n              name=\"description\"\r\n              // value={formik.values.additionalInfo} //working\r\n              // error={formik.errors.additionalInfo}\r\n            />\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"ADD PICTURES : \" />\r\n            <Form.Row noMargin width=\"48%\">\r\n              {/* <FormMultipleUpload\r\n                name=\"profile\"\r\n                // error={image}\r\n                values={image}\r\n                style={GLOBALS.Styles.inputWidth}\r\n                onChange={(values) => handleChange(\"profile\", values)}\r\n              /> */}\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"BILLABLE* : \" />\r\n            <FormSelect\r\n              placeholder=\"Select\"\r\n              name=\"billable\"\r\n              style={GLOBALS.Styles.inputWidth}\r\n              onChange={nameChange}\r\n              value={isBillable}\r\n              values={[\r\n                { value: \"true\", label: \"Yes\" },\r\n                { value: \"false\", label: \"No\" },\r\n              ]}\r\n            />\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"AMOUNT :\" />\r\n            <Form.Row width=\"48%\" noMargin alignItems=\"center\">\r\n              <Form.Row width=\"24%\" noMargin alignItems=\"center\">\r\n                <FormInput\r\n                  type=\"number\"\r\n                  name=\"price\"\r\n                  onChange={nameChange}\r\n                  value={price}\r\n\r\n                  // error={penaltyforLateDelivery}\r\n                />\r\n                <SmallText style={{ marginLeft: 10 }} primary=\"€\" />\r\n              </Form.Row>\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"COMMENT ON INVOICE : \" />\r\n            <FormInput\r\n              textArea\r\n              rows={3}\r\n              style={GLOBALS.Styles.inputWidth}\r\n              onChange={nameChange}\r\n              value={comment}\r\n              placeholder=\"Ajouter un commentaire\"\r\n              name=\"comment\"\r\n            />\r\n          </Form.Row>\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              type=\"submit\"
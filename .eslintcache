Styles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  link: {\n    marginRight: 20,\n    whiteSpace: \"nowrap\",\n    color: theme.palette.primary.contrastText,\n  },\n  image: {\n    height: 70,\n    borderRadius: theme.shape.borderRadius,\n  },\n}));\n\nconst Historic = (props) => {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [isLoading, setLoading] = useState(true);\n  const [history, setHistory] = useState([]);\n\n  const [means, setMeans] = useState([]);\n  const [dorpdownMeans, setDropdownMeans] = useState([]);\n  const [selectedMean, setSelectedMean] = useState(\"\");\n  const [selectedMeanIndex, setSelectedMeanIndex] = useState(null);\n\n  const [companies, setCompanies] = useState([]);\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\n\n  useEffect(() => {\n    getData();\n  }, []);\n\n  useEffect(() => {\n    filterBooking();\n  }, [selectedMeanIndex, selectedCompanyIndex]);\n\n  const filterBooking = async () => {\n    try {\n      setLoading(true);\n      const params = { siteId: \"6008169bedbb7816d40b197d\" };\n      if (selectedMean.length !== 0)\n        params[\"meanId\"] = means[selectedMeanIndex]._id;\n      if (selectedCompany.length !== 0)\n        params[\"companyId\"] = companies[selectedCompanyIndex]._id;\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.FILTER_BOOKING}`,\n        token: store.token,\n        method: \"POST\",\n        body: JSON.stringify(params),\n      });\n      if (response.success) {\n        setHistory(response.data);\n\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getData = async () => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_MEAN_HISTORY}/${props.location.mean._id}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setHistory(response.data.history);\n        setCompanies(response.data.site_companies.companies);\n        if (response.data.site_means != null) {\n          setMeans(response.data.site_means);\n          let selectedMeanIndex = 0;\n\n          const temp = [];\n          const companyTemp = [];\n          response.data.site_means.map((item, index) => {\n            if (item._id === props.location.mean._id) {\n              selectedMeanIndex = index;\n              setSelectedMean(item.name);\n            }\n            return temp.push({ label: item.name, value: item.name });\n          });\n          setDropdownMeans(temp);\n\n          setSelectedMeanIndex(selectedMeanIndex);\n\n          response.data.site_companies.companies.map((item, index) => {\n            return companyTemp.push({ label: item.name, value: item.name });\n          });\n          setDropdownCompanies(companyTemp);\n        }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const rows = history.map((item) => {\n    return [\n      moment(item.startDate).format(\"MM/DD/yyy\") + \" \" + item.startTime,\n      moment(item.endDate).format(\"MM/DD/yyy\") + \" \" + item.endTime,\n      item.companyId.name,\n      item.bookingReason,\n    ];\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row alignItems=\"center\">\n        <Heading primary=\"LIST OF MEANS - HISTORIC\" noWrap />\n        <div>\n          <Form.Row\n            alignItems=\"flex-start\"\n            noMargin\n            justifyContent=\"flex-end\"\n            style={{ paddingRight: \"50px\" }}\n          >\n            <Form.Column style={{ width: \"50%\", marginRight: \"50px\" }}>\n              <img src={Images.site} alt=\"\" />\n            </Form.Column>\n          </Form.Row>\n        </div>\n      </Form.Row>\n      <Form.Row alignItems=\"center\" noMargin>\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          {/* <SearchInput\n            placeholder=\"Site name\"\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          /> */}\n          <FormSelect\n            placeholder=\"Company\"\n            values={dropdownCompanies}\n            value={selectedCompany}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n\n              if (index !== -1) {\n                const item = event.target.value;\n\n                setSelectedCompanyIndex(index);\n\n                setSelectedCompany(item);\n              } else {\n                setSelectedCompanyIndex(null);\n\n                setSelectedCompany(\"\");\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Mean\"\n            values={dorpdownMeans}\n            value={selectedMean}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n\n              if (index !== -1) {\n                const item = event.target.value;\n\n                setSelectedMeanIndex(index);\n\n                setSelectedMean(item);\n              } else {\n                setSelectedMeanIndex(null);\n\n                setSelectedMean(\"\");\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\n          See archived sites\n        </NavLink> */}\n      </Form.Row>\n      <div className={classes.content}>\n        <Table headers={GLOBALS.Data.meansOfHistoric.headings} rows={rows} />\n      </div>\n    </div>\n  );\n};\n\nexport default Historic;\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/EditMean.js",["488","489","490","491","492","493","494","495","496","497","498","499","500","501","502","503","504","505","506"],"import React, { useState, useEffect } from \"react\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport * as Yup from \"yup\";\nimport { useSelector, useDispatch } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\nimport GLOBALS from \"../../../globals\";\nimport Form from \"../../../components/Form\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/CustomFormInput\";\nimport FormLabel from \"../../../components/FormLabel\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\nimport CustomInputModal from \"../../../components/CustomInputModal\";\nimport CustomButtonModal from \"../../../components/CustomButtonModal\";\nimport moment from \"moment\";\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n}));\n\nconst accessabilityPoints = [\n  { label: \"Storage Area\", value: \"Storage Area\" },\n  { label: \"Delivery Area\", value: \"Delivery Area\" },\n];\n\nexport default function EditMean(props) {\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const [name, setName] = useState(\"\");\n  const [type, setType] = useState(\"\");\n  const [color, setColor] = useState(\"\");\n  const [image, setImage] = useState([]);\n  const [startDate, setStartDate] = useState(\"\");\n  const [endDate, setEndDate] = useState(\"\");\n  const [techSheet, setTechSheet] = useState([]);\n  const [rate, setRate] = useState(\"\");\n  const [addInfo, setAddInfo] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n  const [disableDropdpwn, setDisableDropdown] = useState(false);\n  const classes = useStyles();\n\n  const [accessabilityPoint, setAccessabilityPoint] = useState(\"\");\n  const [DeliveryAreas, setDeliveryAreas] = useState([]);\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\n  const [\n    selectedSiteDeliveryAreadIndex,\n    seltSelectedSiteDeliveryAreaIndex,\n  ] = useState(null);\n\n  const [storageAreas, setStorageAreas] = useState([]);\n  const [dropdownStorageAreas, setDropdownStorageAreas] = useState([]);\n  const [\n    selectedDropdownStorageArea,\n    setSelectedDropdownStorageArea,\n  ] = useState(\"\");\n  const [selectedStorageAreaIndex, setSelectedStorageAreaIndex] = useState(\n    null,\n  );\n\n  const [deliveryAreaId, setDeilveryAreaId] = useState(\"\");\n  const [storageAreaId, setStorageAreaId] = useState(\"\");\n\n  const [\n    deliveryAndStorageLocations,\n    setDeliveryAndStorageLocations,\n  ] = useState([]);\n\n  const [buildings, setBuidings] = useState([]);\n  const [dropdownBuildings, setDropdownBuildings] = useState([]);\n  const [selectedDropdownBuilding, setSelectedDropdownBuilding] = useState(\"\");\n  const [selectedBuildingIndex, setSelectedBuildingIndex] = useState(null);\n\n  const [levels, setLevels] = useState([]);\n  const [dropdownLevels, setDropdownLevels] = useState([]);\n  const [selectedDropdownLevel, setSelectedDropdownLevel] = useState(\"\");\n  const [selectedDropdownIndex, setSelectedLevelIndex] = useState(null);\n\n  const [meanTypes, setMeanTypes] = useState([]);\n  const [dropdownMeanTypes, setDropdownMeanTypes] = useState([]);\n  const [selectedMeanType, setSelectedMeanType] = useState(\"\");\n  const [selecetedMeanTypeIndex, setSelectedMeanTypeIndex] = useState(null);\n\n  useEffect(() => {\n    getData();\n\n    // eslint-disable-next-line\n  }, []);\n\n  const setValues = () => {\n    const mean = props.location.mean;\n    setName(mean.name);\n    let fileClone = [{ uri: mean.image }];\n    setImage(fileClone);\n    setSelectedMeanType(mean.meanType);\n    let meanTypeIndex = 0;\n    dropdownMeanTypes.forEach((item, index) => {\n      if (item.value === mean.meanType) meanTypeIndex = index;\n    });\n\n    setSelectedMeanTypeIndex(meanTypeIndex);\n\n    setColor(mean.color);\n\n    setStartDate(moment(mean.availability.start).format(\"MM/DD/yyyy\"));\n    setEndDate(moment(mean.availability.end).format(\"MM/DD/yyyy\"));\n    setRate(mean.pricePerHour);\n    setAddInfo(mean.additionalInfo);\n    const locationTemp = [];\n    mean.location.forEach((item, index) => {\n      let loc = { key: \"\", label: \"\", id: \"\", type: \"\" };\n\n      if (item.locationType === \"STORAGEAREA\") {\n        loc.key = item.storageArea._id;\n        loc.label = item.storageArea.name;\n        loc.id = item.storageArea._id;\n        loc.type = accessabilityPoints[0].value;\n        locationTemp.push(loc);\n      }\n      if (item.locationType === \"DELIVERYAREA\") {\n        loc.key = item.deliveryArea._id;\n        loc.label = item.deliveryArea.name;\n        loc.id = item.deliveryArea._id;\n        loc.type = accessabilityPoints[1].value;\n        locationTemp.push(loc);\n      }\n    });\n    setDeliveryAndStorageLocations(locationTemp);\n    console.log(JSON.stringify(locationTemp, null, 2));\n    // \"key\": \"61615286801076\",\n    // \"label\": \"storqg\",\n    // \"id\": \"60096007880eb61e9d7188d2\",\n    // \"type\": \"Storage Area\"\n  };\n  useEffect(() => {}, [\n    meanTypes,\n    dropdownMeanTypes,\n    selecetedMeanTypeIndex,\n    selectedMeanType,\n  ]);\n\n  const getData = async () => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_ADD_MEAN}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n      if (response.success) {\n        if (response.data.site_delivery_areas !== null) {\n          const temp = [];\n          response.data.site_delivery_areas.map((item, index) =>\n            temp.push({ label: item.name, value: item.name, id: item._id }),\n          );\n          await setDeliveryAreas(response.data.site_delivery_areas);\n          await setDropdownDeliveryAreas(temp);\n        }\n\n        if (response.data.site_storage_areas !== null) {\n          const temp = [];\n          response.data.site_storage_areas.map((item, index) =>\n            temp.push({ label: item.name, value: item.name, id: item._id }),\n          );\n          await setStorageAreas(response.data.site_storage_areas);\n          await setDropdownStorageAreas(temp);\n        }\n\n        if (response.data.site_buildings !== null) {\n          const temp = [];\n          response.data.site_buildings.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n          await setBuidings(response.data.site_buildings);\n          await setDropdownBuildings(temp);\n        }\n\n        if (response.data.mean_types !== null) {\n          const temp = [];\n          response.data.mean_types.map((item, index) =>\n            temp.push({ label: item, value: item }),\n          );\n          await setMeanTypes(response.data.mean_types);\n          await setDropdownMeanTypes(temp);\n        }\n        // if (response.data.mean_types !== null) {\n        //   setTypes(response.data.mean_types);\n        //   const temp = [];\n        //   response.data.mean_types.map((item, index) => {\n        //     temp.push({ label: item, value: item });\n        //   });\n        //   setDropdownTypes(temp);\n        // }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n      await setValues();\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  function handleChange(name, value) {\n    //alert(JSON.stringify(value, null, 2));\n    if (name === \"name\") setName(value);\n    else if (name === \"type\") setType(value);\n    else if (name === \"color\") setColor(value);\n    else if (name === \"image\") setImage(value);\n    else if (name === \"startDate\") setStartDate(value);\n    else if (name === \"endDate\") setEndDate(value);\n    else if (name === \"techSheet\") setTechSheet(value);\n    else if (name === \"rate\") setRate(value);\n    else if (name === \"addInfo\") setAddInfo(value);\n  }\n\n  const updateMean = async () => {\n    try {\n      setLoading(true);\n\n      var formdata = new FormData();\n\n      let locations = [];\n\n      deliveryAndStorageLocations.forEach((item) => {\n        if (item.type === accessabilityPoints[0].value) {\n          let loc = {\n            locationType: \"STORAGEAREA\",\n            storageArea: item.id,\n          };\n          locations.push(loc);\n        }\n        if (item.type === accessabilityPoints[1].value) {\n          let loc = {\n            locationType: \"DELIVERYAREA\",\n            deliveryArea: item.id,\n          };\n          locations.push(loc);\n        }\n      });\n\n      let availabilities = {\n        start: startDate,\n        end: endDate,\n      };\n\n      // TEST DATA , CALENDAR NOT MADE YET\n\n      const sampleDateOne = new Date(\"05/20/2021\");\n      const sampleDateTwo = new Date(\"05/28/2021\");\n      // const unavailabilities = [\n      //   {\n      //     date: sampleDateOne,\n      //     reason: \"Public Holiday\",\n      //     startingHour: new Date().getTime(),\n      //     endingHour: new Date().getTime(),\n      //   },\n      //   {\n      //     date: sampleDateTwo,\n      //     reason: \"Maintenance\",\n      //     startingHour: new Date().getTime(),\n      //     endingHour: new Date().getTime(),\n      //   },\n      // ];\n\n      formdata.append(\"name\", name);\n      formdata.append(\"color\", color);\n      if (image.length != 0 && image[0].file != undefined)\n        formdata.append(\"image\", image[0].file);\n      if (image.length != 0 && image[0].file != undefined)\n        formdata.append(\"sheet\", image[0].file);\n      formdata.append(\"pricePerHour\", rate);\n      formdata.append(\"additionalInfo\", addInfo);\n      formdata.append(\"siteId\", \"6008169bedbb7816d40b197d\");\n      formdata.append(\"meanType\", selectedMeanType);\n      formdata.append(\"location\", JSON.stringify(locations));\n      formdata.append(\"availability\", JSON.stringify(availabilities));\n      //formdata.append(\"unavailability\", JSON.stringify(unavailabilities));\n\n      const response = await GLOBALS.API({\n        method: \"PUT\",\n        uri: GLOBALS.Constants.UPDATE_MEAN + \"/\" + props.location.mean._id,\n        headers: {\n          Authorization: store.token,\n        },\n        body: formdata,\n      });\n\n      if (response.success) {\n        setLoading(false);\n      } else {\n        setLoading(false);\n        dispatch(\n          Actions.notistack.enqueueSnackbar(\n            Actions.notistack.snackbar(response.message, \"error\"),\n          ),\n        );\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getDeliveryArea = async () => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setLevels(response.data);\n        if (response.data !== null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n\n          setDropdownDeliveryAreas(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getStorageArea = async () => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setLevels(response.data);\n        if (response.data !== null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n\n          setDropdownStorageAreas(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n\n      <Form.Row>\n        <Heading primary=\"EDIT A MEAN\" />\n\n        {/* <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"LOCALISATION\"\n                to={\"/means/add-mean\"}\n                style={{\n                  marginRight: \"100px\",\n                  marginBottom: \"7px\",\n                  width: \"320px\",\n                  textAlign: \"center\",\n                  backgroundColor: \"#140772\"\n                }}\n              /> */}\n      </Form.Row>\n      {loading && \"\"}\n      {levels && \"\"}\n      {selectedDropdownIndex && \"\"}\n      {meanTypes && \"\"}\n      {selectedBuildingIndex && \"\"}\n      {DeliveryAreas && \"\"}\n      {selectedSiteDeliveryAreadIndex && \"\"}\n      {storageAreas && \"\"}\n      {selectedStorageAreaIndex && \"\"}\n      <div className={classes.content}>\n        <Form.Form>\n          <Form.Row>\n            <FormLabel bold primary=\"IDENTITY : \" />\n            <Form.Row noMargin width=\"65%\" style={{ gap: \"20px\" }}>\n              <FormInput\n                name=\"name\"\n                error\n                style={GLOBALS.Styles.inputWidth}\n                placeholder=\"name\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={name}\n                validateSchema={Yup.string().required()}\n              />\n              <FormSelect\n                placeholder=\"Type\"\n                name=\"type\"\n                value={selectedMeanType}\n                style={GLOBALS.Styles.inputWidth}\n                onChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n\n                  if (index !== -1) {\n                    const item = event.target.value;\n                    setSelectedMeanTypeIndex(index);\n                    setSelectedMeanType(item);\n                  } else {\n                    setSelectedMeanTypeIndex(null);\n                    setSelectedMeanType(\"\");\n                  }\n                }}\n                values={dropdownMeanTypes}\n              />\n              <FormSelect\n                placeholder=\"color\"\n                name=\"color\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={color}\n                values={[\n                  { value: \"green\", label: \"Green\" },\n                  { value: \"Yellow\", label: \"Yellow\" },\n                  { value: \"Red\", label: \"Red\" },\n                  { value: \"Blue\", label: \"Blue\" },\n                  { value: \"Orange\", label: \"Orange\" },\n                  { value: \"Purple\", label: \"Purple\" },\n                  { value: \"Magenta\", label: \"Magenta\" },\n                ]}\n              />\n              <FormMultipleUpload\n                name=\"image\"\n                style={GLOBALS.Styles.inputWidth}\n                values={image}\n                onChange={(values) => {\n                  handleChange(\"image\", values);\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"LOCATION :  \" />\n            <Form.Row noMargin width=\"65%\">\n              <CustomInputModal\n                name=\"location\"\n                values={accessabilityPoints}\n                chipDefaultValues={deliveryAndStorageLocations}\n                leftValue={accessabilityPoint}\n                rightValue={\n                  accessabilityPoint === accessabilityPoints[0].value\n                    ? selectedDropdownStorageArea\n                    : selectedDropdownArea\n                }\n                leftId={accessabilityPoint}\n                rightId={\n                  accessabilityPoint === accessabilityPoints[0].value\n                    ? storageAreaId\n                    : deliveryAreaId\n                }\n                chipValues={(values) => {\n                  setDeliveryAndStorageLocations(values);\n                }}\n                leftDropdownValues={accessabilityPoints}\n                leftDropdwonPlaceholder={\"Select Location Type\"}\n                rightDropdownPlaceholder={\"Select Location\"}\n                leftDropdwonValueChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n                  if (index !== -1) {\n                    const item = event.target.value;\n                    setAccessabilityPoint(item);\n                    if (item === accessabilityPoints[0].value) {\n                      getStorageArea();\n                    }\n                    if (item === accessabilityPoints[1].value) {\n                      getDeliveryArea();\n                    } else {\n                      seltSelectedSiteDeliveryAreaIndex(0);\n                      setSelectedDropdownArea(\"\");\n                      setDeilveryAreaId(\"\");\n\n                      setSelectedStorageAreaIndex(0);\n                      setSelectedDropdownStorageArea(\"\");\n                      setStorageAreaId(\"\");\n                    }\n                  } else {\n                    seltSelectedSiteDeliveryAreaIndex(0);\n                    setSelectedDropdownArea(\"\");\n                    setDeilveryAreaId(\"\");\n\n                    setSelectedStorageAreaIndex(0);\n                    setSelectedDropdownStorageArea(\"\");\n                    setStorageAreaId(\"\");\n                  }\n                }}\n                rightDropdownValues={\n                  accessabilityPoint === accessabilityPoints[0].value\n                    ? dropdownStorageAreas\n                    : dropdownDeliveryAreas\n                }\n                // error={addresses}\n                style={GLOBALS.Styles.inputWidth}\n                rightDropdwonValueChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n                  if (index !== -1) {\n                    const item = event.target.value;\n                    if (accessabilityPoints[0].value === accessabilityPoint) {\n                      setStorageAreaId(storageAreas[index]._id);\n                      setSelectedStorageAreaIndex(index);\n                      setSelectedDropdownStorageArea(item);\n                    } else {\n                      setSelectedStorageAreaIndex(0);\n                      setSelectedDropdownStorageArea(\"\");\n                    }\n\n                    if (accessabilityPoints[1].value === accessabilityPoint) {\n                      setDeilveryAreaId(DeliveryAreas[index]._id);\n                      seltSelectedSiteDeliveryAreaIndex(index);\n                      setSelectedDropdownArea(item);\n                    } else {\n                      seltSelectedSiteDeliveryAreaIndex(0);\n                      setSelectedDropdownArea(\"\");\n                    }\n                  } else {\n                    setSelectedStorageAreaIndex(0);\n                    setSelectedDropdownStorageArea(\"\");\n                    seltSelectedSiteDeliveryAreaIndex(0);\n                    setSelectedDropdownArea(\"\");\n                  }\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"DISPONIBILITE :\" />\n            <Form.Row\n              noMargin\n              width=\"65%\"\n              justifyContent=\"flex-start\"\n              style={{ gap: \"20px\" }}\n            >\n              <FormInput\n                type=\"date\"\n                style={{ width: \"300px\" }}\n                placeholder={`Date de début`}\n                name=\"startDate\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={startDate}\n              />\n              <FormInput\n                type=\"date\"\n                placeholder=\"Date de fin\"\n                style={{ width: \"300px\" }}\n                name=\"endDate\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={endDate}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"FICHE TECHNIQUE : \" />\n            <Form.Row noMargin width=\"65%\">\n              <FormMultipleUpload\n                name=\"techSheet\"\n                style={GLOBALS.Styles.inputWidth}\n                values={techSheet}\n                onChange={(values) => {\n                  handleChange(\"techSheet\", values);\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"INDISPONIBILITES: \" />\n            <Form.Row noMargin width=\"65%\">\n              <div\n                // name=\"availability\"\n\n                to={\"/means/add-mean\"}\n                style={{\n                  marginLeft: \"0px\",\n                  marginBottom: \"7px\",\n                  width: \"320px\",\n                  color: \"#fff\",\n                  padding: \"0.8rem 0\",\n                  borderRadius: \"8px\",\n                  textAlign: \"center\",\n                  backgroundColor: \"#140772\",\n                }}\n              >\n                SHOW UNAVAILABILITIES\n              </div>\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"TARIF HORAIRE : \" />\n            <Form.Row noMargin width=\"65%\">\n              <FormInput\n                textArea\n                rows={1}\n                style={{ width: \"300px\", textAlign: \"right\" }}\n                placeholder=\"€\"\n                name=\"rate\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={rate}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"INFORMATIONS COMPLÉMENTAIRES :\" />\n            <Form.Row noMargin width=\"65%\">\n              <FormInput\n                textArea\n                rows={3}\n                style={{ width: \"600px\" }}\n                placeholder=\"Informations complémentaires\"\n                name=\"addInfo\"\n                onChange={({ target: { name, value } }) => {\n                  handleChange(name, value);\n                }}\n                value={addInfo}\n              />\n            </Form.Row>\n          </Form.Row>\n          {type && \"\"}\n          <Form.Row>\n            <Form.ButtonContainer style={{ width: \"80%\" }}>\n              <Button\n                minWidth={200}\n                text=\"VALIDATE\"\n                fullWidth={false}\n                onClick={async () => {\n                  await updateMean();\n                }}\n                // loading={formik.isSubmitting}\n                // disabled={\n                //   !name ||\n                //   location.length === 0 ||\n                //   !type ||\n                //   !color ||\n                //   !startDate\n                // }\n              />\n            </Form.ButtonContainer>\n          </Form.Row>\n        </Form.Form>\n      </div>\n    </div>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Pic/Pic.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/AddMean.js",["507","508","509","510","511","512","513","514","515","516","517","518","519","520","521","522","523"],"import React, { useState, useEffect } from \"react\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport * as Yup from \"yup\";\nimport { useSelector, useDispatch } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\nimport GLOBALS from \"../../../globals\";\nimport Form from \"../../../components/Form\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/CustomFormInput\";\nimport FormLabel from \"../../../components/FormLabel\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\nimport CustomInputModal from \"../../../components/CustomInputModal\";\nimport CustomButtonModal from \"../../../components/CustomButtonModal\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n}));\n\nconst accessabilityPoints = [\n  { label: \"Storage Area\", value: \"Storage Area\" },\n  { label: \"Delivery Area\", value: \"Delivery Area\" },\n];\n\nexport default function AddMean(props) {\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const [addresses] = useState([]);\n  const [name, setName] = useState(\"\");\n  const [type, setType] = useState(\"\");\n  const [color, setColor] = useState(\"\");\n  const [image, setImage] = useState([]);\n  const [location, setLocation] = useState([]);\n  const [startDate, setStartDate] = useState(\"\");\n  const [endDate, setEndDate] = useState(\"\");\n  const [techSheet, setTechSheet] = useState([]);\n  const [rate, setRate] = useState(\"\");\n  const [addInfo, setAddInfo] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n  const [disableDropdpwn, setDisableDropdown] = useState(false);\n  const [isExterior, setIsExterior] = useState(false);\n  const classes = useStyles();\n\n  const [accessabilityPoint, setAccessabilityPoint] = useState(\"\");\n  const [DeliveryAreas, setDeliveryAreas] = useState([]);\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\n  const [\n    selectedSiteDeliveryAreadIndex,\n    seltSelectedSiteDeliveryAreaIndex,\n  ] = useState(null);\n\n  const [storageAreas, setStorageAreas] = useState([]);\n  const [dropdownStorageAreas, setDropdownStorageAreas] = useState([]);\n  const [\n    selectedDropdownStorageArea,\n    setSelectedDropdownStorageArea,\n  ] = useState(\"\");\n  const [selectedStorageAreaIndex, setSelectedStorageAreaIndex] = useState(\n    null,\n  );\n\n  const [deliveryAreaId, setDeilveryAreaId] = useState(\"\");\n  const [storageAreaId, setStorageAreaId] = useState(\"\");\n\n  const [\n    deliveryAndStorageLocations,\n    setDeliveryAndStorageLocations,\n  ] = useState([]);\n\n  const [buildings, setBuidings] = useState([]);\n  const [dropdownBuildings, setDropdownBuildings] = useState([]);\n  const [selectedDropdownBuilding, setSelectedDropdownBuilding] = useState(\"\");\n  const [selectedBuildingIndex, setSelectedBuildingIndex] = useState(null);\n\n  const [levels, setLevels] = useState([]);\n  const [dropdownLevels, setDropdownLevels] = useState([]);\n  const [selectedDropdownLevel, setSelectedDropdownLevel] = useState(\"\");\n  const [selectedDropdownIndex, setSelectedLevelIndex] = useState(null);\n\n  const [meanTypes, setMeanTypes] = useState([]);\n  const [dropdownMeanTypes, setDropdownMeanTypes] = useState([]);\n  const [selectedMeanType, setSelectedMeanType] = useState(\"\");\n  const [selecetedMeanTypeIndex, setSelectedMeanTypeIndex] = useState(null);\n\n  useEffect(() => {\n    getData();\n    // eslint-disable-next-line\n  }, []);\n\n  useEffect(() => {}, [\n    meanTypes,\n    dropdownMeanTypes,\n    selecetedMeanTypeIndex,\n    selectedMeanType,\n  ]);\n\n  const getData = async () => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_ADD_MEAN}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n      if (response.success) {\n        if (response.data.site_delivery_areas !== null) {\n          const temp = [];\n          response.data.site_delivery_areas.map((item, index) =>\n            temp.push({ label: item.name, value: item.name, id: item._id }),\n          );\n          setDeliveryAreas(response.data.site_delivery_areas);\n          setDropdownDeliveryAreas(temp);\n        }\n\n        if (response.data.site_storage_areas !== null) {\n          const temp = [];\n          response.data.site_storage_areas.map((item, index) =>\n            temp.push({ label: item.name, value: item.name, id: item._id }),\n          );\n          setStorageAreas(response.data.site_storage_areas);\n          setDropdownStorageAreas(temp);\n        }\n\n        if (response.data.site_buildings !== null) {\n          const temp = [];\n          response.data.site_buildings.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n          setBuidings(response.data.site_buildings);\n          setDropdownBuildings(temp);\n        }\n\n        if (response.data.mean_types !== null) {\n          const temp = [];\n          response.data.mean_types.map((item, index) =>\n            temp.push({ label: item, value: item }),\n          );\n          setMeanTypes(response.data.mean_types);\n          setDropdownMeanTypes(temp);\n        }\n        // if (response.data.mean_types !== null) {\n        //   setTypes(response.data.mean_types);\n        //   const temp = [];\n        //   response.data.mean_types.map((item, index) => {\n        //     temp.push({ label: item, value: item });\n        //   });\n        //   setDropdownTypes(temp);\n        // }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  function handleChange(name, value) {\n    alert(JSON.stringify(value, null, 2));\n    if (name === \"name\") setName(value);\n    else if (name === \"type\") setType(value);\n    else if (name === \"color\") setColor(value);\n    else if (name === \"image\") setImage(value);\n    else if (name === \"location\") setLocation(value);\n    else if (name === \"startDate\") setStartDate(value);\n    else if (name === \"endDate\") setEndDate(value);\n    else if (name === \"techSheet\") setTechSheet(value);\n    else if (name === \"rate\") setRate(value);\n    else if (name === \"addInfo\") setAddInfo(value);\n  }\n\n  const createMean = async () => {\n    try {\n      // setLoading(true);\n\n      var formdata = new FormData();\n\n      let locations = [];\n\n      deliveryAndStorageLocations.forEach((item) => {\n        if (item.type === accessabilityPoints[0].value) {\n          let loc = {\n            locationType: \"STORAGEAREA\",\n            storageArea: item.id,\n          };\n          locations.push(loc);\n        }\n        if (item.type === accessabilityPoints[1].value) {\n          let loc = {\n            locationType: \"DELIVERYAREA\",\n            deliveryArea: item.id,\n          };\n          locations.push(loc);\n        }\n      });\n\n      let availabilities = {\n        start: startDate,\n        end: endDate,\n      };\n\n      // TEST DATA , CALENDAR NOT MADE YET\n\n      const sampleDateOne = new Date(\"05/20/2021\");\n      const sampleDateTwo = new Date(\"05/28/2021\");\n      const unavailabilities = [\n        {\n          date: sampleDateOne,\n          reason: \"Public Holiday\",\n          startingHour: new Date().getTime(),\n          endingHour: new Date().getTime(),\n        },\n        {\n          date: sampleDateTwo,\n          reason: \"Maintenance\",\n          startingHour: new Date().getTime(),\n          endingHour: new Date().getTime(),\n        },\n      ];\n\n      formdata.append(\"name\", name);\n      formdata.append(\"color\", color);\n      formdata.append(\"image\", image[0].file);\n      formdata.append(\"sheet\", image[0].file);\n      formdata.append(\"pricePerHour\", rate);\n      formdata.append(\"additionalInfo\", addInfo);\n      formdata.append(\"siteId\", \"6008169bedbb7816d40b197d\");\n      formdata.append(\"meanType\", selectedMeanType);\n      formdata.append(\"location\", JSON.stringify(locations));\n      formdata.append(\"availability\", JSON.stringify(availabilities));\n      formdata.append(\"unavailability\", JSON.stringify(unavailabilities));\n\n      const response = await GLOBALS.API({\n        method: \"POST\",\n        uri: GLOBALS.Constants.CREATE_MEAN,\n        headers: {\n          Authorization: store.token,\n        },\n        body: formdata,\n      });\n      console.log(JSON.stringify(response, null, 2));\n\n      if (response.success) {\n        alert(JSON.stringify(response, null, 2));\n        setLoading(false);\n      } else {\n        setLoading(false);\n        dispatch(\n          Actions.notistack.enqueueSnackbar(\n            Actions.notistack.snackbar(response.message, \"error\"),\n          ),\n        );\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getDeliveryArea = async () => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_DELIVERY_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setLevels(response.data);\n        if (response.data !== null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n\n          setDropdownDeliveryAreas(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getStorageArea = async () => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_SITE_ID}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setLevels(response.data);\n        if (response.data !== null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n\n          setDropdownStorageAreas(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getLevels = async (buidlingId) => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_LEVELS}/${buidlingId}`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setLevels(response.data);\n        if (response.data !== null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) =>\n            temp.push({ label: item.name, value: item.name }),\n          );\n\n          setDropdownLevels(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n\n      <Form.Row>\n        <Heading primary=\"ADD A MEAN\" />\n\n        {/* <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"LOCALISATION\"\n                to={\"/means/add-mean\"}\n                style={{\n                  marginRight: \"100px\",\n                  marginBottom: \"7px\",\n                  width: \"320px\",\n                  textAlign: \"center\",\n                  backgroundColor: \"#140772\"\n                }}\n              /> */}\n      </Form.Row>\n      {loading && \"\"}\n      {levels && \"\"}\n      {selectedDropdownIndex && \"\"}\n      {meanTypes && \"\"}\n      {selectedBuildingIndex && \"\"}\n      {DeliveryAreas && \"\"}\n      {selectedSiteDeliveryAreadIndex && \"\"}\n      {storageAreas && \"\"}\n      {selectedStorageAreaIndex && \"\"}\n      <div className={classes.content}>\n        <Form.Form>\n          <Form.Row>\n            <FormLabel bold primary=\"IDENTITY : \" />\n            <Form.Row noMargin width=\"65%\" style={{ gap: \"20px\" }}>\n              <FormInput\n                name=\"name\"\n                error\n                style={GLOBALS.Styles.inputWidth}\n                placeholder=\"name\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={name}\n                validateSchema={Yup.string().required()}\n              />\n              <FormSelect\n                placeholder=\"Type\"\n                name=\"type\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n\n                  if (index !== -1) {\n                    const item = event.target.value;\n                    setSelectedMeanTypeIndex(index);\n                    setSelectedMeanType(item);\n                  } else {\n                    setSelectedMeanTypeIndex(null);\n                    setSelectedMeanType(\"\");\n                  }\n                }}\n                values={dropdownMeanTypes}\n              />\n              <FormSelect\n                placeholder=\"color\"\n                name=\"color\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={color}\n                values={[\n                  { value: \"green\", label: \"Green\" },\n                  { value: \"Yellow\", label: \"Yellow\" },\n                  { value: \"Red\", label: \"Red\" },\n                  { value: \"Blue\", label: \"Blue\" },\n                  { value: \"Orange\", label: \"Orange\" },\n                  { value: \"Purple\", label: \"Purple\" },\n                  { value: \"Magenta\", label: \"Magenta\" },\n                ]}\n              />\n              <FormMultipleUpload\n                name=\"image\"\n                style={GLOBALS.Styles.inputWidth}\n                values={image}\n                onChange={(values) => {\n                  handleChange(\"image\", values);\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"LOCATION :  \" />\n            <Form.Row noMargin width=\"65%\">\n              <CustomInputModal\n                name=\"location\"\n                values={accessabilityPoints}\n                leftValue={accessabilityPoint}\n                rightValue={\n                  accessabilityPoint === accessabilityPoints[0].value\n                    ? selectedDropdownStorageArea\n                    : selectedDropdownArea\n                }\n                leftId={accessabilityPoint}\n                rightId={\n                  accessabilityPoint === accessabilityPoints[0].value\n                    ? storageAreaId\n                    : deliveryAreaId\n                }\n                chipValues={(values) => {\n                  console.log(JSON.stringify(values, null, 2));\n                  setDeliveryAndStorageLocations(values);\n                }}\n                leftDropdownValues={accessabilityPoints}\n                leftDropdwonPlaceholder={\"Select Location Type\"}\n                rightDropdownPlaceholder={\"Select Location\"}\n                leftDropdwonValueChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n                  if (index !== -1) {\n                    const item = event.target.value;\n                    setAccessabilityPoint(item);\n                    if (item === accessabilityPoints[0].value) {\n                      getStorageArea();\n                    }\n                    if (item === accessabilityPoints[1].value) {\n                      getDeliveryArea();\n                    } else {\n                      seltSelectedSiteDeliveryAreaIndex(0);\n                      setSelectedDropdownArea(\"\");\n                      setDeilveryAreaId(\"\");\n\n                      setSelectedStorageAreaIndex(0);\n                      setSelectedDropdownStorageArea(\"\");\n                      setStorageAreaId(\"\");\n                    }\n                  } else {\n                    seltSelectedSiteDeliveryAreaIndex(0);\n                    setSelectedDropdownArea(\"\");\n                    setDeilveryAreaId(\"\");\n\n                    setSelectedStorageAreaIndex(0);\n                    setSelectedDropdownStorageArea(\"\");\n                    setStorageAreaId(\"\");\n                  }\n                }}\n                rightDropdownValues={\n                  accessabilityPoint === accessabilityPoints[0].value\n                    ? dropdownStorageAreas\n                    : dropdownDeliveryAreas\n                }\n                // error={addresses}\n                style={GLOBALS.Styles.inputWidth}\n                rightDropdwonValueChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n                  if (index !== -1) {\n                    const item = event.target.value;\n                    if (accessabilityPoints[0].value === accessabilityPoint) {\n                      setStorageAreaId(storageAreas[index]._id);\n                      setSelectedStorageAreaIndex(index);\n                      setSelectedDropdownStorageArea(item);\n                    } else {\n                      setSelectedStorageAreaIndex(0);\n                      setSelectedDropdownStorageArea(\"\");\n                    }\n\n                    if (accessabilityPoints[1].value === accessabilityPoint) {\n                      setDeilveryAreaId(DeliveryAreas[index]._id);\n                      seltSelectedSiteDeliveryAreaIndex(index);\n                      setSelectedDropdownArea(item);\n                    } else {\n                      seltSelectedSiteDeliveryAreaIndex(0);\n                      setSelectedDropdownArea(\"\");\n                    }\n                  } else {\n                    setSelectedStorageAreaIndex(0);\n                    setSelectedDropdownStorageArea(\"\");\n                    seltSelectedSiteDeliveryAreaIndex(0);\n                    setSelectedDropdownArea(\"\");\n                  }\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"DISPONIBILITE :\" />\n            <Form.Row\n              noMargin\n              width=\"65%\"\n              justifyContent=\"flex-start\"\n              style={{ gap: \"20px\" }}\n            >\n              <FormInput\n                type=\"date\"\n                style={{ width: \"300px\" }}\n                placeholder={`Date de début`}\n                name=\"startDate\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={startDate}\n              />\n              <FormInput\n                type=\"date\"\n                placeholder=\"Date de fin\"\n                style={{ width: \"300px\" }}\n                name=\"endDate\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={endDate}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"FICHE TECHNIQUE : \" />\n            <Form.Row noMargin width=\"65%\">\n              <FormMultipleUpload\n                name=\"techSheet\"\n                style={GLOBALS.Styles.inputWidth}\n                values={techSheet}\n                onChange={(values) => {\n                  handleChange(\"techSheet\", values);\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"INDISPONIBILITES: \" />\n            <Form.Row noMargin width=\"65%\">\n              <div\n                // name=\"availability\"\n\n                to={\"/means/add-mean\"}\n                style={{\n                  marginLeft: \"0px\",\n                  marginBottom: \"7px\",\n                  width: \"320px\",\n                  color: \"#fff\",\n                  padding: \"0.8rem 0\",\n                  borderRadius: \"8px\",\n                  textAlign: \"center\",\n                  backgroundColor: \"#140772\",\n                }}\n              >\n                SHOW UNAVAILABILITIES\n              </div>\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"TARIF HORAIRE : \" />\n            <Form.Row noMargin width=\"65%\">\n              <FormInput\n                textArea\n                rows={1}\n                style={{ width: \"300px\", textAlign: \"right\" }}\n                placeholder=\"€\"\n                name=\"rate\"\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                value={rate}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"INFORMATIONS COMPLÉMENTAIRES :\" />\n            <Form.Row noMargin width=\"65%\">\n              <FormInput\n                textArea\n                rows={3}\n                style={{ width: \"600px\" }}\n                placeholder=\"Informations complémentaires\"\n                name=\"addInfo\"\n                onChange={({ target: { name, value } }) => {\n                  handleChange(name, value);\n                }}\n                value={addInfo}\n              />\n            </Form.Row>\n          </Form.Row>\n          {type && \"\"}\n          <Form.Row>\n            <Form.ButtonContainer style={{ width: \"80%\" }}>\n              <Button\n                minWidth={200}\n                text=\"VALIDATE\"\n                fullWidth={false}\n                onClick={async () => {\n                  await createMean();\n                }}\n                // loading={formik.isSubmitting}\n                // disabled={\n                //   !name ||\n                //   location.length === 0 ||\n                //   !type ||\n                //   !color ||\n                //   !startDate\n                // }\n              />\n            </Form.ButtonContainer>\n          </Form.Row>\n        </Form.Form>\n      </div>\n    </div>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Incidents/editIncidents.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Incidents/addIncidents.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/AddInvoice.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/EditInvoice.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/VerifyClient.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/AddClient.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/Means.js",["524","525","526","527","528","529","530","531"],"import React, { useState, useEffect } from \"react\";\nimport { useSelector } from \"react-redux\";\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles } from \"@material-ui/core/styles\";\n\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\n\nimport { useFormik } from \"formik\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport FormInput from \"../../../components/FormInput\";\n\nimport moment from \"moment\";\nimport { Images } from \"../../../assets/Assets\";\n\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  link: {\n    marginRight: 20,\n    whiteSpace: \"nowrap\",\n    color: theme.palette.primary.contrastText,\n  },\n  image: {\n    height: 70,\n    borderRadius: theme.shape.borderRadius,\n  },\n}));\n\nconst Means = () => {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const [loading, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n\n  const [siteDeliveryAreas, setSiteDeliveryAreas] = useState([]);\n  const [dropdownDeliveryAreas, setDropdownDeliveryAreas] = useState([]);\n  const [selectedDropdownArea, setSelectedDropdownArea] = useState(\"\");\n  const [\n    selectedSiteDeliveryAreadIndex,\n    seltSelectedSiteDeliveryAreaIndex,\n  ] = useState(null);\n\n  const [locations, setLocations] = useState([]);\n  const [dropdownLocations, setDropdownLocations] = useState([]);\n  const [selectedLocationIndex, setSelectedLocationIndex] = useState(0);\n  const [selectedLocation, setSelectedLocation] = useState(\"\");\n\n  const [types, setTypes] = useState([]);\n  const [doropdownTypes, setDropdownTypes] = useState([]);\n  const [selectedTypeIndex, setSelectedTypeIndex] = useState(0);\n  const [selectedType, setSelectedType] = useState(\"\");\n\n  const [status, setStatus] = useState([]);\n  const [dropdownStatus, setDropdownStatus] = useState([]);\n  const [selectedStatusIndex, setSelectedStatusIndex] = useState(0);\n  const [selectedStatus, setSelectedStatus] = useState(\"\");\n\n  const [company, setCompany] = useState([]);\n  const [dropdownCompany, setDropdownCompany] = useState([]);\n  const [selectedCompanyIndex, setSeletedCompanyIndex] = useState(0);\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\n\n  const [levels, setLevels] = useState([]);\n  const [dropdownLevels, setDropdownLevels] = useState([]);\n  const [selectedDropdownLevelIndex, setSelectedDropdownLevelIndex] = useState(\n    0,\n  );\n  const [selectedLevel, setSelectedLevel] = useState(\"\");\n  const [disableDropdpwn, setDisableDropdown] = useState(true);\n  const [disableStorageDropdown, setDisableStorageDropdow] = useState(true);\n\n  const [storageAreas, setStorageAreas] = useState([]);\n  const [droprownStorageAreas, setDropdownStorageAreas] = useState([]);\n  const [\n    selectedDropdownStorageAreaIndex,\n    setSelectedDropdownStorageAreaIndex,\n  ] = useState(0);\n  const [selectedStorageArea, setSelectedStorageArea] = useState(\"\");\n  const [storageMeans, setStorageMeans] = useState([]);\n  const [means, setMeans] = useState([]);\n  const [meanText, setMeanText] = useState(\"\");\n\n  const getMeans = async () => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_LIST_OF_MEANS}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n      if (response.success) {\n        setMeans(response.data.means);\n\n        if (response.data.means != null) {\n          let temp = [];\n          response.data.means.map((item, index) => {\n            let data = [];\n            data[0] = item.name;\n            data[1] = item.status;\n            data[2] = item.meanType;\n\n            {\n              data[3] = item.location\n                .map((innerItem, index) => {\n                  if (\n                    innerItem.locationType != undefined &&\n                    innerItem.locationType === \"STORAGEAREA\"\n                  ) {\n                    console.log(innerItem.locationType);\n                    return innerItem.storageArea.name;\n                  }\n                  return \"\";\n                })\n                .toString()\n                .replace(/,/g, \" \");\n              data[4] = item.location\n                .map((innerItem, index) => {\n                  if (\n                    innerItem.locationType != undefined &&\n                    innerItem.locationType === \"DELIVERYAREA\"\n                  )\n                    return innerItem.deliveryArea.name;\n                  return \"\";\n                })\n                .toString()\n                .replace(/,/g, \" \");\n            }\n            temp.push(data);\n            return true;\n          });\n\n          setItems(temp);\n        }\n\n        if (response.data.site_delivery_areas != null) {\n          const temp = [];\n          response.data.site_delivery_areas.map((item, index) => {\n            return temp.push({ label: item.name, value: item.name });\n          });\n          setSiteDeliveryAreas(response.data.site_delivery_areas);\n          setDropdownDeliveryAreas(temp);\n        }\n\n        if (response.data.site_companies != null) {\n          const temp = [];\n          response.data.site_companies.map((item, index) => {\n            return temp.push({ label: item.name, value: item.name });\n          });\n          setCompany(response.data.site_companies);\n          setDropdownCompany(temp);\n        }\n\n        if (response.data.site_locations != null) {\n          setLocations(response.data.site_locations);\n          const temp = [];\n          response.data.site_locations.map((item, index) => {\n            return temp.push({ label: item.name, value: item.name });\n          });\n          setDropdownLocations(temp);\n        }\n\n        if (response.data.mean_types != null) {\n          setTypes(response.data.mean_types);\n          const temp = [];\n          response.data.mean_types.map((item, index) => {\n            return temp.push({ label: item, value: item });\n          });\n          setDropdownTypes(temp);\n        }\n\n        if (response.data.mean_status != null) {\n          setStatus(response.data.mean_status);\n          const temp = [];\n          response.data.mean_status.map((item, index) => {\n            return temp.push({ label: item, value: item });\n          });\n          setDropdownStatus(temp);\n        }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getExternalMeans = async () => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_EXTERIOR_MEANS}/6008169bedbb7816d40b197d`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        const tempStorageAreas = [];\n        if (response.data != null && response.data.length > 0) {\n          const temp = [];\n\n          response.data.map((item, index) => {\n            item.location.map((innerItem, innerIndex) => {\n              console.log(JSON.stringify(innerItem, null, 2));\n              if (innerItem.locationType === \"STORAGEAREA\") {\n                tempStorageAreas.push(innerItem);\n                return temp.push({\n                  label: innerItem.storageArea.name,\n                  value: innerItem.storageArea.name,\n                });\n              }\n            });\n\n            //\n          });\n          setStorageAreas(tempStorageAreas);\n          setDropdownStorageAreas(temp);\n        }\n\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getLevels = async (buidlingId) => {\n    try {\n      setLoading(true);\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_LEVELS}/${buidlingId}`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setLevels(response.data);\n        if (response.data != null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) => {\n            return temp.push({ label: item.name, value: item.name });\n          });\n\n          setDropdownLevels(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const formik = useFormik({\n    initialValues: {\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    // validationSchema: addClientYup,\n    // onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  useEffect(() => {\n    filterMean();\n    // eslint-disable-next-line\n  }, [\n    selectedSiteDeliveryAreadIndex,\n    selectedLocationIndex,\n    selectedDropdownLevelIndex,\n    selectedDropdownStorageAreaIndex,\n    selectedStorageArea,\n    selectedTypeIndex,\n    selectedType,\n    selectedCompanyIndex,\n    selectedCompany,\n    selectedStatusIndex,\n    selectedStatus,\n    formik.values.contractStartDate,\n    formik.values.contractEndDate,\n  ]);\n\n  const filterMean = async () => {\n    try {\n      setLoading(true);\n      const params = { siteId: \"6008169bedbb7816d40b197d\" };\n      if (meanText.length !== 0) params[\"name\"] = meanText;\n      if (selectedDropdownArea.length !== 0)\n        params[\"deliveryArea\"] =\n          siteDeliveryAreas[selectedSiteDeliveryAreadIndex]._id;\n      if (selectedStorageArea.length !== 0)\n        params[\"storageArea\"] =\n          storageAreas[selectedDropdownStorageAreaIndex]._id;\n\n      if (selectedCompany.length !== 0)\n        params[\"company\"] = company[selectedCompanyIndex]._id;\n\n      if (selectedType.length !== 0) params[\"type\"] = types[selectedTypeIndex];\n      if (selectedStatus.length !== 0)\n        params[\"status\"] = status[selectedStatusIndex];\n      if (!isNaN(moment(formik.values.contractStartDate)))\n        params[\"startDate\"] = formik.values.contractStartDate;\n      if (!isNaN(moment(formik.values.contractEndDate)))\n        params[\"endDate\"] = formik.values.contractEndDate;\n\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.FILTER_MEANS}`,\n        token: store.token,\n        method: \"POST\",\n        body: JSON.stringify(params),\n      });\n      if (response.success) {\n        let temp = [];\n\n        response.data.map((item, index) => {\n          let data = [];\n          data[0] = item.name;\n          data[1] = item.status;\n          data[2] = item.meanType;\n          {\n            data[3] = item.location\n              .map((innerItem, index) => {\n                if (\n                  innerItem.locationType != undefined &&\n                  innerItem.locationType === \"STORAGEAREA\"\n                ) {\n                  console.log(innerItem.locationType);\n                  return innerItem.storageArea.name;\n                }\n                return \"\";\n              })\n              .toString()\n              .replace(/,/g, \" \");\n            data[4] = item.location\n              .map((innerItem, index) => {\n                if (\n                  innerItem.locationType != undefined &&\n                  innerItem.locationType === \"DELIVERYAREA\"\n                )\n                  return innerItem.deliveryArea.name;\n                return \"\";\n              })\n              .toString()\n              .replace(/,/g, \" \");\n          }\n          return temp.push(data);\n        });\n        setItems(temp);\n\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getStorageAreasByLevel = async (levelId) => {\n    try {\n      setLoading(true);\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_STORAGE_AREA_BY_LEVEL_ID}/${levelId}`,\n        token: store.token,\n      });\n\n      if (response.success) {\n        setStorageAreas(response.data);\n        if (response.data != null && response.data.length > 0) {\n          const temp = [];\n          response.data.map((item, index) => {\n            return temp.push({ label: item.name, value: item.name });\n          });\n\n          setDropdownStorageAreas(temp);\n        }\n        setLoading(false);\n      } else {\n        setLoading(false);\n      }\n      setLoading(false);\n    } catch (err) {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    getMeans();\n    // eslint-disable-next-line\n  }, []);\n\n  const rows = items.map((item, index) => {\n    return [\n      ...item,\n      <div>\n        <NavLink\n          to={{\n            pathname: \"/means/edit-mean\",\n            mean: means[index],\n          }}\n          style={{ color: \"#959491 !important\", textDecoration: \"none\" }}\n        >\n          <Pencil style={{ width: 18, height: 15, cursor: \"pointer\" }} />\n        </NavLink>\n\n        <NavLink\n          to={{\n            pathname: \"/means/calendar\",\n            mean: means[index],\n          }}\n        >\n          <img\n            src={Images.calender}\n            style={{ width: 18, height: 15, paddingLeft: 5 }}\n            alt=\"Icon\"\n          />\n        </NavLink>\n        <NavLink\n          to={{\n            pathname: \"/means/mean-history\",\n            mean: means[index],\n          }}\n        >\n          <img\n            src={Images.incidents}\n            style={{ width: 18, height: 15, paddingLeft: 5 }}\n            alt=\"Icon\"\n          />\n        </NavLink>\n      </div>,\n    ];\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row alignItems=\"center\">\n        {loading && \"\"}\n        {selectedLocation && \"\"}\n        {company && \"\"}\n        {selectedLevel && \"\"}\n        {storageMeans && \"\"}\n        <Heading primary=\"LIST OF MEANS\" noWrap />\n        <div>\n          <Form.Row\n            alignItems=\"flex-start\"\n            noMargin\n            justifyContent=\"flex-end\"\n            style={{ paddingRight: \"50px\" }}\n          >\n            <SubHeading\n              noMargin\n              topPadding\n              primary={`TOTAL : ${means.length} means`}\n              bold\n            />\n            <Form.Column style={{ width: \"50%\" }}>\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"ADD A MEAN\"\n                to={\"/means/add-mean\"}\n                style={{\n                  marginLeft: \"20px\",\n                  marginBottom: \"7px\",\n                  width: \"200px\",\n                }}\n              />\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"MEANS REQUEST\"\n                to={\"/sites/means-request\"}\n                style={{ marginLeft: \"20px\", width: \"200px\" }}\n              />\n            </Form.Column>\n          </Form.Row>\n        </div>\n      </Form.Row>\n      <Form.Row alignItems=\"center\" noMargin>\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          <FormSelect\n            placeholder=\"Delivery area\"\n            values={dropdownDeliveryAreas}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n\n              if (index !== -1) {\n                const item = event.target.value;\n\n                seltSelectedSiteDeliveryAreaIndex(index);\n\n                setSelectedDropdownArea(item);\n              } else {\n                seltSelectedSiteDeliveryAreaIndex(null);\n\n                setSelectedDropdownArea(\"\");\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Location\"\n            values={dropdownLocations}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index !== -1) {\n                const item = event.target.value;\n\n                setSelectedLocationIndex(index);\n                setSelectedLocation(item);\n                // Reset Levels\n                setSelectedDropdownLevelIndex(0);\n                setSelectedLevel(\"\");\n                setDropdownLevels([]);\n                // Reset Storage Area\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                setDropdownStorageAreas([]);\n                setDisableStorageDropdow(true);\n                // Reset Storage Means\n                setStorageMeans([]);\n                if (locations[index].buildingType === \"EXTERIOR\") {\n                  setDisableDropdown(true);\n                  getExternalMeans();\n                  setDisableStorageDropdow(false);\n                } else {\n                  setDisableDropdown(false);\n                  getLevels(locations[index]._id);\n                }\n              } else {\n                setSelectedLocationIndex(0);\n                setSelectedLocation(\"\");\n                // Reset Levels\n                setSelectedDropdownLevelIndex(0);\n                setSelectedLevel(\"\");\n                setDropdownLevels([]);\n                // Reset Storage Area\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                setDropdownStorageAreas([]);\n                // Reset Storage Means\n                setStorageMeans([]);\n                setDisableStorageDropdow(true);\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Level\"\n            values={dropdownLevels}\n            disabled={disableDropdpwn}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index !== -1) {\n                const item = event.target.value;\n                setSelectedDropdownLevelIndex(index);\n                setSelectedLevel(item);\n                // Reset Storage Area\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                setDropdownStorageAreas([]);\n                // Reset Storage Means\n                setStorageMeans([]);\n                setDisableStorageDropdow(false);\n                getStorageAreasByLevel(levels[index]._id);\n              } else {\n                setSelectedDropdownLevelIndex(0);\n                setSelectedLevel(\"\");\n                // Reset Storage Area\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                setDropdownStorageAreas([]);\n                // Reset Storage Means\n                setStorageMeans([]);\n                setDisableStorageDropdow(true);\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Storage area\"\n            values={droprownStorageAreas}\n            disabled={disableStorageDropdown}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index !== -1) {\n                const item = event.target.value;\n\n                setSelectedDropdownStorageAreaIndex(index);\n                setSelectedStorageArea(item);\n                // Reset Storage Means\n                setStorageMeans([]);\n\n                // filterMean();\n              } else {\n                setSelectedDropdownStorageAreaIndex(0);\n                setSelectedStorageArea(\"\");\n                //  filterMean();\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Type\"\n            values={doropdownTypes}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index !== -1) {\n                const item = event.target.value;\n                setSelectedTypeIndex(index);\n                setSelectedType(item);\n                // Reset Storage Means\n                //filterMean();\n              } else {\n                setSelectedTypeIndex(0);\n                setSelectedType(\"\");\n                // Reset Storage Means\n                //filterMean();\n              }\n            }}\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\n          See archived sites\n        </NavLink> */}\n      </Form.Row>\n\n      <Form.Row alignItems=\"center\" noMargin className=\"mt-3\">\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          <FormSelect\n            placeholder=\"Company\"\n            values={dropdownCompany}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              const item = event.target.value;\n              if (index !== -1) {\n                setSeletedCompanyIndex(index);\n                setSelectedCompany(item);\n                //   filterMean();\n              } else {\n                setSeletedCompanyIndex(0);\n                setSelectedCompany(\"\");\n                // filterMean();\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Status\"\n            values={dropdownStatus}\n            onChange={(event) => {\n              const index = event.target.selectedIndex - 1;\n              if (index !== -1) {\n                const item = event.target.value;\n                setSelectedStatusIndex(index);\n                setSelectedStatus(item);\n                // filterMean();\n              } else {\n                setSelectedStatusIndex(0);\n                setSelectedStatus(\"\");\n                //filterMean();\n              }\n            }}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormInput\n            type=\"date\"\n            placeholder=\"Start date\"\n            name=\"contractStartDate\"\n            icon\n            onChange={formik.handleChange}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormInput\n            type=\"date\"\n            placeholder=\"End date\"\n            name=\"contractEndDate\"\n            icon\n            onChange={formik.handleChange}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <SearchInput\n            placeholder=\"Mean name\"\n            value={meanText}\n            onClick={() => {\n              filterMean();\n            }}\n            onChange={(event) => {\n              setMeanText(event.target.value);\n            }}\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n      </Form.Row>\n      <div className={classes.content}>\n        <Table headers={GLOBALS.Data.means.headings} rows={rows} />\n      </div>\n    </div>\n  );\n};\n\nexport default Means;\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/UserList.js",["532","533"],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/AddUser.js",["534","535","536","537","538","539","540","541","542","543"],"import React, { useState, useEffect } from \"react\";\nimport { useFormik } from \"formik\";\nimport { useSelector, useDispatch } from \"react-redux\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport * as Yup from \"yup\";\n\nimport GLOBALS from \"../../../globals\";\nimport Form from \"../../../components/Form\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport FormLabel from \"../../../components/FormLabel\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\nimport Autocomplete from \"@material-ui/lab/Autocomplete\";\nimport TextField from \"@material-ui/core/TextField\";\nimport Actions from \"../../../redux/actions\";\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n}));\n\nconst addClientYup = Yup.object().shape({\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\n  name: Yup.string().required(\"Required\"),\n  email: Yup.string().required(\"Required\"),\n  firstName: Yup.string().required(\"Required\"),\n  lastName: Yup.string().required(\"Required\"),\n  site: Yup.string().required(\"Required\"),\n  phone: Yup.number()\n    .test(\n      \"len\",\n      \"Must be exactly 10 characters\",\n      (val) => val && val.toString().length === 10,\n    )\n    .required(\"Required\"),\n});\n\nexport default function AddUser(props) {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n\n  const store = useSelector((state) => state.auth);\n  const adminStore = useSelector((state) => state.admin);\n  const [page] = useState(1);\n  const [companies, setCompanies] = useState([]);\n  const [dropdownCompanies, setDropdownCompanies] = useState([]);\n  const [selectedCompany, setSelectedCompany] = useState(\"\");\n  const [selectedCompanyIndex, setSelectedCompanyIndex] = useState(null);\n\n  const [roles, setRoles] = useState([]);\n  const [dropdownRoles, setDropdownRoles] = useState([]);\n  const [selectedRole, setSelectedRole] = useState(\"\");\n  const [selectedRoleIndex, setSelectedRoleIndex] = useState(null);\n\n  const [siteParams, setSiteParams] = useState([]);\n\n  const [users, setUsers] = useState([]);\n\n  useEffect(() => {\n    getData();\n  }, []);\n\n  const getData = async () => {\n    try {\n      formik.setFieldValue(\"site\", adminStore.site.siteId.name);\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_ADD_USER}/${adminStore.site.siteId._id}/${store.user._id}`,\n        token: store.token,\n      });\n      if (response.success) {\n        setCompanies(response.data.site_companies.companies);\n        setRoles(response.data.site_companies.companies);\n        setUsers(response.data.users);\n        if (response.data.site_companies != null) {\n          const companyTemp = [];\n\n          response.data.site_companies.companies.map((item, index) => {\n            return companyTemp.push({ label: item.name, value: item.name });\n          });\n          setDropdownCompanies(companyTemp);\n        }\n        if (response.data.roles != null) {\n          const rolesTemp = [];\n\n          response.data.roles.map((item, index) => {\n            return rolesTemp.push({ label: item, value: item });\n          });\n          setDropdownRoles(rolesTemp);\n        }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const getUserCompany = async (userId) => {\n    try {\n      const response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.GET_USER_COMPANY}/${adminStore.site.siteId._id}/${userId}`,\n        token: store.token,\n      });\n      if (response.success) {\n        console.log(JSON.stringify(response, null, 2));\n        if (response.data) {\n          companies.forEach((item, index) => {\n            if (item._id === response.data._id) {\n              item.users.forEach((innerItem, innerIndex) => {\n                console.log(\"innser \", innerItem.userId);\n                if (innerItem.userId === userId) {\n                  setSelectedRoleIndex(innerIndex);\n\n                  setSelectedRole(innerItem.role);\n                }\n              });\n              setSelectedCompanyIndex(index);\n\n              setSelectedCompany(item.name);\n            }\n          });\n        }\n      } else {\n      }\n\n      //   setItems(response.data.items);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n\n  const onSubmit = async () => {\n    const values = formik.values;\n    const sites = [];\n    siteParams.forEach((item) => {\n      sites.push({ siteId: item.id, role: selectedRole });\n    });\n    var formdata = new FormData();\n    formdata.append(\"image\", values.logo[0].file);\n    //formdata.append(\"name\", values.name);\n    formdata.append(\"firstName\", values.firstName);\n    formdata.append(\"lastName\", values.lastName);\n    formdata.append(\"email\", values.email);\n    formdata.append(\"phone\", values.phone);\n    formdata.append(\"sites\", JSON.stringify(sites));\n    formdata.append(\"companyId\", companies[selectedCompanyIndex]._id);\n\n    await GLOBALS.API({\n      method: \"POST\",\n      uri: GLOBALS.Constants.ADD_USER_ADMIN,\n      headers: {\n        Authorization: store.token,\n      },\n      body: formdata,\n    });\n    formik.setSubmitting(false);\n    props.history.push(\"/clients\");\n  };\n\n  const formik = useFormik({\n    initialValues: {\n      logo: [],\n      name: \"\",\n      color: \"\",\n      firstName: \"\",\n      lastName: \"\",\n      email: \"\",\n      phone: \"\",\n      site: \"\",\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n    },\n    validationSchema: addClientYup,\n    onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n      <Heading primary=\"ADD USER\" />\n      <div className={classes.content}>\n        <Form.Form onSubmit={formik.handleSubmit}>\n          <Form.Row>\n            <FormLabel bold primary=\"CONTACT INFO* :\" />\n            <Form.Row width=\"48%\">\n              {/* <FormInput\n                name=\"name\"\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\n                placeholder=\"Adresse e-mail\"\n                onChange={formik.handleChange}\n                value={formik.values.name}\n                error={formik.errors.name}\n              /> */}\n              <Autocomplete\n                id=\"free-solo-demo\"\n                freeSolo\n                style={{\n                  ...GLOBALS.Styles.inputWidth,\n                  marginRight: \"10px\",\n                }}\n                onSelect={(event) => {\n                  users.forEach((item, index) => {\n                    if (item.userId.email === event.target.value) {\n                      console.log(JSON.stringify(item.sites, null, 2));\n                      formik.setFieldValue(\"firstName\", item.userId.firstName);\n                      formik.setFieldValue(\"lastName\", item.userId.lastName);\n                      formik.setFieldValue(\"phone\", item.userId.phone);\n                      formik.setFieldValue(\"logo\", [\n                        { uri: item.userId.image },\n                      ]);\n\n                      getUserCompany(item.userId._id);\n                    }\n                  });\n                }}\n                options={users.map((option) => {\n                  if (option.userId.email != undefined)\n                    return option.userId.email;\n                })}\n                renderInput={(params) => (\n                  <TextField\n                    {...params}\n                    label=\"Email\"\n                    margin=\"normal\"\n                    variant=\"outlined\"\n                    name=\"email\"\n                    value={formik.values.email}\n                    error={formik.errors.email}\n                    onChange={formik.handleChange}\n                  />\n                )}\n              />\n              <FormInput\n                name=\"phone\"\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\n                placeholder=\"Téléphone\"\n                onChange={formik.handleChange}\n                value={formik.values.phone}\n                error={formik.errors.phone}\n              />\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"INDENTITY* :\" />\n            <Form.Row width=\"48%\">\n              <FormInput\n                name=\"firstName\"\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\n                placeholder=\"FIRST NAME\"\n                onChange={formik.handleChange}\n                value={formik.values.firstName}\n                error={formik.errors.firstName}\n              />\n              <FormInput\n                name=\"lastName\"\n                style={(GLOBALS.Styles.inputWidth, { marginRight: \"10px\" })}\n                placeholder=\"LAST NAME\"\n                onChange={formik.handleChange}\n                value={formik.values.lastName}\n                error={formik.errors.name}\n              />\n              <FormMultipleUpload\n                name=\"logo\"\n                style={GLOBALS.Styles.inputWidth}\n                error={formik.errors.logo}\n                values={formik.values.logo}\n                onChange={(values) =>\n                  formik.handleChange({\n                    target: {\n                      type: \"text\",\n                      name: \"logo\",\n                      value: values,\n                    },\n                  })\n                }\n              />\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"COMPANY : \" />\n            <Form.Row noMargin width=\"48%\">\n              <FormSelect\n                placeholder=\"Company\"\n                values={dropdownCompanies}\n                value={selectedCompany}\n                onChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n\n                  if (index !== -1) {\n                    const item = event.target.value;\n\n                    setSelectedCompanyIndex(index);\n\n                    setSelectedCompany(item);\n                  } else {\n                    setSelectedCompanyIndex(null);\n\n                    setSelectedCompany(\"\");\n                  }\n                }}\n                style={{ marginRight: \"20px\", maxWidth: 250 }}\n              />\n            </Form.Row>\n          </Form.Row>\n          <Form.Row>\n            <FormLabel bold primary=\"RÔLE : \" />\n            <Form.Row noMargin width=\"48%\">\n              <FormSelect\n                placeholder=\"RÔLE : \"\n                name=\"color\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={formik.handleChange}\n                value={formik.values.color}\n                error={formik.errors.color}\n                values={dropdownRoles}\n                value={selectedRole}\n                onChange={(event) => {\n                  const index = event.target.selectedIndex - 1;\n\n                  if (index !== -1) {\n                    const item = event.target.value;\n\n                    setSelectedRoleIndex(index);\n\n                    setSelectedRole(item);\n                  } else {\n                    setSelectedRoleIndex(null);\n\n                    setSelectedRole(\"\");\n                  }\n                }}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"CONSTRUCTION SITE : \" />\n            <Form.Row noMargin width=\"48%\">\n              <FormInput\n                name=\"site\"\n                style={{ ...GLOBALS.Styles.inputWidth, marginRight: \"10px\" }}\n                placeholder=\"Site\"\n                onChange={formik.handleChange}\n                value={formik.values.site}\n                error={formik.errors.site}\n                disabled={true}\n              />\n            </Form.Row>\n          </Form.Row>\n\n          <Form.ButtonContainer>\n            <Button\n              minWidth={200}\n              text=\"CONTINUER\"\n              fullWidth={false}\n              onClick={() => {\n                onSubmit();\n              }}\n              loading={formik.isSubmitting}\n              disabled={formik.isSubmitting}\n            />\n          </Form.ButtonContainer>\n        </Form.Form>\n      </div>\n    </div>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Calender/components/MyWorkWeek.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Calender/components/popoverModal.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Calender/components/events.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/EditCompanies.js",["544","545","546","547","548","549","550","551","552","553","554","555","556","557","558","559","560"],"import React, {useState} from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport MultiAdderInput from \"../../../components/MultiAdderInput\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n  error: {\r\n    color: \"red\",\r\n  },\r\n  radioLabel: {\r\n    marginLeft: \"7px\",\r\n    color: \"#7E7878\",\r\n    marginRight: \"50px\"\r\n\r\n  },\r\n  radioBtn: {\r\n\r\n  }\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function EditCompanies(props) {\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n\r\n  const [name, setName] = useState(\"\");\r\n  const [nameError, setNameError] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [colorError, setColorError] = useState(\"\");\r\n  const [images, setImages] = useState([]);\r\n  const [companyType, setCompanyType] = useState(\"\");\r\n  const [companyTypeError, setCompanyTypeError] = useState(\"\");\r\n  const [contract, setContract] = useState(\"\");\r\n  const [contractError, setContractError] = useState(\"\");\r\n  const [typeError, setTypeError] = useState(\"\");\r\n  const [trades, setTrades] = useState([]);\r\n  const [update, setUpdate] = useState(false);\r\n  const [email, setEmail] = useState(\"\");\r\n  const [emailError, setEmailError] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [phoneError, setPhoneError] = useState(\"\");\r\n  const [fname, setFname] = useState(\"\");\r\n  const [lname, setLname] = useState(\"\");\r\n  const [website, setWebsite] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n\r\n\r\n\r\n\r\n  const inputChange = (e) => {\r\n    if (e.target.name === \"companyType\") {\r\n      setCompanyType(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setCompanyTypeError(true);\r\n      } else {\r\n        setCompanyTypeError(false);\r\n      }\r\n    }\r\n   \r\n    if (e.target.name === \"email\") {\r\n      setEmail(e.target.value);\r\n      var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n      if (!e.target.value.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"addInfo\") {\r\n      setAddInfo(e.target.value);\r\n    }\r\n   \r\n  };\r\n\r\n\r\n  // const onSubmit = async (values) => {\r\n  //   const notificationTo = values.notificationTo.map((item) => item.label);\r\n\r\n  //   var formdata = new FormData();\r\n  //   formdata.append(\"logo\", values.logo[0].file);\r\n  //   formdata.append(\"name\", values.name);\r\n  //   formdata.append(\"color\", values.color);\r\n  //   formdata.append(\"firstName\", values.firstName);\r\n  //   formdata.append(\"lastName\", values.lastName);\r\n  //   formdata.append(\"email\", values.email);\r\n  //   formdata.append(\"phone\", values.phone);\r\n  //   formdata.append(\"contractType\", values.contractType);\r\n  //   formdata.append(\"contractStartDate\", values.contractStartDate);\r\n  //   formdata.append(\"contractEndDate\", values.contractEndDate);\r\n  //   formdata.append(\"functionality\", values.functionality);\r\n  //   formdata.append(\"additionalInfo\", values.additionalInfo);\r\n  //   formdata.append(\"notificationPriorToDays\", values.notificationPriorToDays);\r\n  //   formdata.append(\"notificationTo\", JSON.stringify(notificationTo));\r\n\r\n  //   await GLOBALS.API({\r\n  //     method: \"POST\",\r\n  //     uri: GLOBALS.Constants.CLIENTS,\r\n  //     headers: {\r\n  //       Authorization: store.token,\r\n  //     },\r\n  //     body: formdata,\r\n  //   });\r\n  //   formik.setSubmitting(false);\r\n  //   props.history.push(\"/clients\");\r\n  // };\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"trades\") {\r\n     if(value !== \"\"){\r\n      setUpdate((st) => !st);\r\n      setTrades(value);\r\n      console.log(\"trades\", trades);\r\n    }\r\n     }\r\n  }\r\n\r\n  const submitHandler = (e) => {\r\n    var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n    e.preventDefault();\r\n   \r\n    // if (\r\n    //   companyType === \"\" ||\r\n    //   companyType === null ||\r\n    //   companyType === undefined\r\n    // ) {\r\n    //   setCompanyTypeError(true);\r\n    // }\r\n   \r\n    if (email !== \"\") {\r\n      if (!email.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n  else {\r\n      console.log(\"contarct submit\", companyType);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"EDIT A COMPANY\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"name\"\r\n                  disabled\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Company name\"\r\n                  value={name}\r\n                />\r\n                {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"color\"\r\n                  disabled\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Color\"\r\n                  value={color}\r\n                />\r\n                {colorError && (\r\n                  <div className={classes.error}>Please enter color</div>\r\n                )}\r\n              </div>\r\n              <FormMultipleUpload\r\n                name=\"images\"\r\n                \r\n                style={GLOBALS.Styles.inputWidth}\r\n                multiple\r\n                values={images}\r\n                onChange={(values) =>\r\n                  inputChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"images\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n                // onChange={inputChange}\r\n                // onChange={(values) =>\r\n                \r\n                   \r\n                //      ( {type: \"text\",\r\n                //       name: \"trades\",\r\n                //       value: values})\r\n                   \r\n               \r\n                // }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF COMPANY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div>\r\n                <div onChange={inputChange}>\r\n                  <input\r\n                  className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"generalcontractor\"\r\n                    name=\"companyType\"\r\n                    value=\"generalcontractor\"\r\n                  />\r\n                  <label for=\"generalcontractor\" className={classes.radioLabel}>General Contractor</label>\r\n                  <input\r\n                  className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"subcontractor\"\r\n                    name=\"companyType\"\r\n                    value=\"subcontractor\"\r\n                  />\r\n                  <label for=\"subcontractor\" className={classes.radioLabel}>Sub contractor</label>\r\n                </div>\r\n                {companyTypeError === true && (\r\n                  <div className={classes.error}>Please select company</div>\r\n                )}\r\n              </div>\r\n\r\n              {/* <RadioButton\r\n                name=\"contractType\"\r\n                style={{width: '80%'}}\r\n                value={formik.values.contractType}\r\n                error={formik.errors.contractType}\r\n                onChange={formik.handleChange}\r\n                items={[\r\n                  { value: \"GENERALCONTRACTOR\", label: \"General Contractor\" },\r\n                  { value: \"Subcontractor\", label: \"Subcontract\" },\r\n                ]}\r\n              /> */}\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"GENERAL CONTRACTOR : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"100%\", height: \"100%\" }}>\r\n                <select\r\n                  name=\"contract\"\r\n                  disabled\r\n                  id=\"contract\"\r\n                  type={contract}\r\n                  style={{ width: \"40%\", height: \"45px\", color: \"#8B8989\", padding: '0px 10px' }}\r\n                  onChange={inputChange}\r\n                >\r\n                  <option value=\"\">List</option>\r\n                  <option value=\"Yellow\">Yellow</option>\r\n                  <option value=\"Red\">Red</option>\r\n                  <option value=\"Blue\">Blue</option>\r\n                </select>\r\n                {contractError === true && (\r\n                  <div className={classes.error}>Please select contract</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TRADES : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n            <MultiAdderInput\r\n              name=\"trades\"\r\n              values={trades}\r\n              validateError=\"Please enter trades\"\r\n              placeholder=\"Trades\"\r\n              style={{width: \"40%\"}}\r\n              // disabled={contractType !== \"MASTERCLIENT\"}\r\n              onChange={(values) => handleChange(\"trades\", values)}\r\n              validate={(text) => {\r\n                if(text !== \"\"){\r\n                  return false;\r\n                }\r\n                else{\r\n                  return true;\r\n                }\r\n              }}\r\n            />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDEMTITY OF RESPONSIBLE* : \" />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"email\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Adresse e-mail\"\r\n                  onChange={inputChange}\r\n                  value={email}\r\n                />\r\n                {emailError === true && (\r\n                  <div className={classes.error}>Please enter valid email</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"phone\"\r\n                  disabled\r\n                  type=\"number\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Téléphone\"\r\n                  onChange={inputChange}\r\n                  value={phone}\r\n                />\r\n                {phoneError === true && (\r\n                  <div className={classes.error}>\r\n                    Telephone should be 11 digits\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"fname\"\r\n                  disabled\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"First Name\"\r\n                  onChange={(e) => setFname(e.target.value)}\r\n                  value={fname}\r\n                />\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"lname\"\r\n                  disabled\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Last Name\"\r\n                  onChange={(e) => setLname(e.target.value)}\r\n                  value={lname}\r\n                />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"Website : \" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                name=\"website\"\r\n                disabled\r\n                style={{width: '50%'}}\r\n                placeholder=\"http://\"\r\n                onChange={(e) => setWebsite(e.target.value)}\r\n                value={website}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\r\n            <Form.Row width=\"55%\">\r\n            <FormInput\r\n              textArea\r\n              rows={3}\r\n              style={{width: '90%'}}\r\n              onChange={(e) => setAddInfo(e.target.value)}\r\n              placeholder=\"Informations complémentaires\"\r\n              name=\"addInfo\"\r\n              value={addInfo}\r\n            />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              type=\"submit\"\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              // disabled={\r\n              //   name === \"\" ||\r\n              //   color === \"\" ||\r\n              //   companyType === \"\" ||\r\n              //   contract === \"\" ?\r\n              //   true : false\r\n              // }\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/AddCompanies.js",["561","562","563","564","565","566","567","568","569"],"import React, { useState } from \"react\";\r\nimport { useFormik } from \"formik\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport * as Yup from \"yup\";\r\nimport MultiAdderInput from \"../../../components/MultiAdderInput\";\r\n\r\nimport GLOBALS from \"../../../globals\";\r\nimport Form from \"../../../components/Form\";\r\nimport Button from \"../../../components/Button\";\r\nimport Heading from \"../../../components/Heading\";\r\nimport FormInput from \"../../../components/FormInput\";\r\nimport FormLabel from \"../../../components/FormLabel\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport RadioButton from \"../../../components/RadioButton\";\r\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\r\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\r\nimport { InputSharp } from \"@material-ui/icons\";\r\nimport CustomInputModal from \"../../../components/CustomInputModalSingleSelect\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    padding: GLOBALS.Styles.pagePadding,\r\n  },\r\n  content: {\r\n    padding: GLOBALS.Styles.pageContentPadding,\r\n    marginTop: GLOBALS.Styles.pageContentMargin,\r\n  },\r\n  error: {\r\n    color: \"red\",\r\n  },\r\n  radioLabel: {\r\n    marginLeft: \"7px\",\r\n    color: \"#7E7878\",\r\n    marginRight: \"50px\",\r\n  },\r\n  radioBtn: {},\r\n}));\r\n\r\nconst addClientYup = Yup.object().shape({\r\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\r\n  name: Yup.string().required(\"Required\"),\r\n  color: Yup.string().required(\"Required\"),\r\n  firstName: Yup.string().required(\"Required\"),\r\n  lastName: Yup.string().required(\"Required\"),\r\n  email: Yup.string().required(\"Required\"),\r\n  phone: Yup.number()\r\n    .test(\r\n      \"len\",\r\n      \"Must be exactly 10 characters\",\r\n      (val) => val && val.toString().length === 10,\r\n    )\r\n    .required(\"Required\"),\r\n  contractType: Yup.string().required(\"Required\"),\r\n  contractStartDate: Yup.string().required(\"Required\"),\r\n  contractEndDate: Yup.string().required(\"Required\"),\r\n  functionality: Yup.string().required(\"Required\"),\r\n  additionalInfo: Yup.string(),\r\n  notificationPriorToDays: Yup.number(),\r\n  notificationTo: Yup.array(),\r\n});\r\n\r\nexport default function AddCompanies(props) {\r\n  const classes = useStyles();\r\n  const store = useSelector((state) => state.auth);\r\n  const adminStore = useSelector((state) => state.admin);\r\n\r\n  console.log(adminStore.site.siteId._id);\r\n\r\n  const [name, setName] = useState(\"\");\r\n  const [nameError, setNameError] = useState(\"\");\r\n  const [color, setColor] = useState(\"\");\r\n  const [colorError, setColorError] = useState(\"\");\r\n  const [images, setImages] = useState([]);\r\n  const [companyType, setCompanyType] = useState(\"subcontractor\");\r\n  const [companyTypeError, setCompanyTypeError] = useState(\"\");\r\n  const [contract, setContract] = useState(\"\");\r\n  const [contractError, setContractError] = useState(\"\");\r\n  const [typeError, setTypeError] = useState(\"\");\r\n  const [trades, setTrades] = useState([]);\r\n  const [update, setUpdate] = useState(false);\r\n  const [email, setEmail] = useState(\"\");\r\n  const [emailError, setEmailError] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [phoneError, setPhoneError] = useState(\"\");\r\n  const [fname, setFname] = useState(\"\");\r\n  const [lname, setLname] = useState(\"\");\r\n  const [website, setWebsite] = useState(\"\");\r\n  const [addInfo, setAddInfo] = useState(\"\");\r\n\r\n  // const [startDate, setStartDate] = useState(\"\");\r\n  // const [startDateError, setStartDateError] = useState(\"\");\r\n  // const [isDateSelect, setIsDateSelect] = useState(\"\");\r\n  // const [endDate, setEndDate] = useState(\"\");\r\n  // const [endDateError, setEndDateError] = useState(\"\");\r\n  // const [available, setAvailable] = useState(\"VOIR LES INDISPONIBILITÉS\");\r\n  // const [techSheet, setTechSheet] = useState([]);\r\n  // const [rate, setRate] = useState(\"\");\r\n  // const [rateError, setRateError] = useState(\"\");\r\n\r\n  const onSubmit = async (values) => {\r\n    const notificationTo = values.notificationTo.map((item) => item.label);\r\n\r\n    var formdata = new FormData();\r\n    formdata.append(\"logo\", values.logo[0].file);\r\n    formdata.append(\"name\", values.name);\r\n    formdata.append(\"color\", values.color);\r\n    formdata.append(\"firstName\", values.firstName);\r\n    formdata.append(\"lastName\", values.lastName);\r\n    formdata.append(\"email\", values.email);\r\n    formdata.append(\"phone\", values.phone);\r\n    formdata.append(\"contractType\", values.contractType);\r\n    formdata.append(\"contractStartDate\", values.contractStartDate);\r\n    formdata.append(\"contractEndDate\", values.contractEndDate);\r\n    formdata.append(\"functionality\", values.functionality);\r\n    formdata.append(\"additionalInfo\", values.additionalInfo);\r\n    formdata.append(\"notificationPriorToDays\", values.notificationPriorToDays);\r\n    formdata.append(\"notificationTo\", JSON.stringify(notificationTo));\r\n\r\n    await GLOBALS.API({\r\n      method: \"POST\",\r\n      uri: GLOBALS.Constants.CLIENTS,\r\n      headers: {\r\n        Authorization: store.token,\r\n      },\r\n      body: formdata,\r\n    });\r\n    formik.setSubmitting(false);\r\n    props.history.push(\"/clients\");\r\n  };\r\n\r\n  const inputChange = (e) => {\r\n    if (e.target.name === \"name\") {\r\n      setName(e.target.value);\r\n      if (e.target.name === \"\" || name === null) {\r\n        setNameError(true);\r\n      } else {\r\n        setNameError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"color\") {\r\n      setColor(e.target.value);\r\n      if (e.target.value === \"\" || e.target.value === null) {\r\n        setColorError(true);\r\n      } else {\r\n        setColorError(false);\r\n      }\r\n    }\r\n    // if (e.target.name === \"companyType\") {\r\n    //   console.log(e.target.value);\r\n    //   setCompanyType(e.target.value);\r\n    //   console.log(\"company type\", companyType);\r\n    //   if (e.target.value === \"\" || e.target.value === null) {\r\n    //     setCompanyTypeError(true);\r\n    //   } else {\r\n    //     setCompanyTypeError(false);\r\n    //   }\r\n    // }\r\n    if (e.target.name === \"contract\") {\r\n      setContract(e.target.value);\r\n      if (\r\n        e.target.value === \"\" ||\r\n        e.target.value === null ||\r\n        e.target.value === undefined\r\n      ) {\r\n        setContractError(true);\r\n      } else {\r\n        setContractError(false);\r\n      }\r\n    }\r\n\r\n    if (e.target.name === \"email\") {\r\n      setEmail(e.target.value);\r\n      var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n      if (!e.target.value.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (e.target.name === \"phone\") {\r\n      setPhone(e.target.value);\r\n      if (e.target.value.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    }\r\n\r\n    if (e.target.name === \"images\") {\r\n      setImages(e.target.value);\r\n    }\r\n    if (e.target.name === \"trades\") {\r\n      setTrades(e.target.value);\r\n    }\r\n\r\n    if (e.target.name === \"addInfo\") {\r\n      setAddInfo(e.target.value);\r\n    }\r\n  };\r\n\r\n  const handleChange = (name, value) => {\r\n    if (name === \"trades\") {\r\n      if (value !== \"\") {\r\n        setUpdate((st) => !st);\r\n        setTrades(value);\r\n        console.log(\"trades\", trades);\r\n      }\r\n    }\r\n  };\r\n\r\n  const submitHandler = (e) => {\r\n    var mailformat = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$/;\r\n    e.preventDefault();\r\n    if (name === \"\" || name === null) {\r\n      setNameError(true);\r\n    }\r\n    if (color === \"\" || color === null) {\r\n      setColorError(true);\r\n    }\r\n    if (\r\n      companyType === \"\" ||\r\n      companyType === null ||\r\n      companyType === undefined\r\n    ) {\r\n      setCompanyTypeError(true);\r\n    }\r\n    if (contract === \"\" || contract === null || contract === undefined) {\r\n      setContractError(true);\r\n    }\r\n    if (email !== \"\") {\r\n      if (!email.match(mailformat)) {\r\n        setEmailError(true);\r\n      } else {\r\n        setEmailError(false);\r\n      }\r\n    }\r\n    if (phone !== \"\") {\r\n      if (phone.length !== 10) {\r\n        setPhoneError(true);\r\n      } else {\r\n        setPhoneError(false);\r\n      }\r\n    } else {\r\n      console.log(\"contarct submit\", companyType);\r\n    }\r\n  };\r\n  const formik = useFormik({\r\n    initialValues: {\r\n      logo: [],\r\n      name: \"\",\r\n      color: \"\",\r\n      firstName: \"\",\r\n      lastName: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      contractType: \"CLIENTPERSITE\",\r\n      contractStartDate: \"\",\r\n      contractEndDate: \"\",\r\n      functionality: \"DELIVERY\",\r\n      additionalInfo: \"\",\r\n      notificationPriorToDays: \"\",\r\n      notificationTo: [],\r\n    },\r\n    validationSchema: addClientYup,\r\n    onSubmit,\r\n    validateOnBlur: false,\r\n    validateOnChange: false,\r\n    validateOnMount: false,\r\n  });\r\n  console.log(\"type ==> \", companyType);\r\n  return (\r\n    <div className={classes.root}>\r\n      <IconButton onClick={() => props.history.goBack()}>\r\n        <BackArrow style={{ width: 30, height: 30 }} />\r\n      </IconButton>\r\n      <Heading primary=\"ADD A COMPANY\" />\r\n      <div className={classes.content}>\r\n        <Form.Form onSubmit={submitHandler}>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDENTITY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"name\"\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Company name\"\r\n                  value={name}\r\n                />\r\n                {nameError && (\r\n                  <div className={classes.error}>Please enter name</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"color\"\r\n                  onChange={inputChange}\r\n                  style={{ width: \"100%\" }}\r\n                  placeholder=\"Color\"\r\n                  value={color}\r\n                />\r\n                {colorError && (\r\n                  <div className={classes.error}>Please enter color</div>\r\n                )}\r\n              </div>\r\n              <FormMultipleUpload\r\n                name=\"images\"\r\n                style={GLOBALS.Styles.inputWidth}\r\n                multiple\r\n                values={images}\r\n                onChange={(values) =>\r\n                  inputChange({\r\n                    target: {\r\n                      type: \"text\",\r\n                      name: \"images\",\r\n                      value: values,\r\n                    },\r\n                  })\r\n                }\r\n                // onChange={inputChange}\r\n                // onChange={(values) =>\r\n\r\n                //      ( {type: \"text\",\r\n                //       name: \"trades\",\r\n                //       value: values})\r\n\r\n                // }\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TYPE OF COMPANY* :\" />\r\n            <Form.Row width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div>\r\n                <div>\r\n                  <input\r\n                    className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    onChange={(e) => setCompanyType(\"generalcontractor\")}\r\n                    id=\"generalcontractor\"\r\n                    name=\"companyType\"\r\n                    value=\"generalcontractor\"\r\n                  />\r\n                  <label for=\"generalcontractor\" className={classes.radioLabel}>\r\n                    General Contractor\r\n                  </label>\r\n                  <input\r\n                    className={classes.radioBtn}\r\n                    type=\"radio\"\r\n                    id=\"subcontractor\"\r\n                    name=\"companyType\"\r\n                    onChange={(e) => {\r\n                      setCompanyType(\"subcontractor\");\r\n                      console.log(companyType);\r\n                    }}\r\n                    value=\"subcontractor\"\r\n                    defaultChecked\r\n                  />\r\n                  <label for=\"subcontractor\" className={classes.radioLabel}>\r\n                    Sub contractor\r\n                  </label>\r\n                </div>\r\n                {companyTypeError === true && (\r\n                  <div className={classes.error}>Please select company</div>\r\n                )}\r\n              </div>\r\n\r\n              {/* <RadioButton\r\n                name=\"contractType\"\r\n                style={{width: '80%'}}\r\n                value={formik.values.contractType}\r\n                error={formik.errors.contractType}\r\n                onChange={formik.handleChange}\r\n                items={[\r\n                  { value: \"GENERALCONTRACTOR\", label: \"General Contractor\" },\r\n                  { value: \"Subcontractor\", label: \"Subcontract\" },\r\n                ]}\r\n              /> */}\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"GENERAL CONTRACTOR : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <div style={{ width: \"100%\", height: \"100%\" }}>\r\n                <select\r\n                  name=\"contract\"\r\n                  disabled={companyType === \"generalcontractor\" ? true : false}\r\n                  id=\"contract\"\r\n                  type={contract}\r\n                  style={{\r\n                    width: \"40%\",\r\n                    height: \"45px\",\r\n                    color: \"#8B8989\",\r\n                    padding: \"0px 10px\",\r\n                  }}\r\n                  onChange={inputChange}\r\n                >\r\n                  <option value=\"\">List</option>\r\n                  <option value=\"Yellow\">Yellow</option>\r\n                  <option value=\"Red\">Red</option>\r\n                  <option value=\"Blue\">Blue</option>\r\n                </select>\r\n                {contractError === true && (\r\n                  <div className={classes.error}>Please select contract</div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"TRADES : \" />\r\n            <Form.Row noMargin width=\"55%\" style={{ gap: \"20px\" }}>\r\n              <CustomInputModal\r\n                name=\"trades\"\r\n                values={[]}\r\n                value={\"\"}\r\n                placeholder=\"Select Trades\"\r\n                chipValues={(values) => {\r\n                  // setSiteParams(values);\r\n                }}\r\n                onChange={(event) => {\r\n                  // const index = event.target.selectedIndex - 1;\r\n                  // if (index !== -1) {\r\n                  //   const item = event.target.value;\r\n                  //   setSiteId(sites[index].siteId._id);\r\n                  //   setSelectedSiteIndex(index);\r\n                  //   setSelectedSite(item);\r\n                  // } else {\r\n                  //   setSelectedSiteIndex(0);\r\n                  //   setSelectedSite(\"\");\r\n                  // }\r\n                }}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"IDEMTITY OF RESPONSIBLE* : \" />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"email\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Adresse e-mail\"\r\n                  onChange={inputChange}\r\n                  value={email}\r\n                />\r\n                {emailError === true && (\r\n                  <div className={classes.error}>Please enter valid email</div>\r\n                )}\r\n              </div>\r\n              <div style={{ width: \"40%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"phone\"\r\n                  type=\"number\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Téléphone\"\r\n                  onChange={inputChange}\r\n                  value={phone}\r\n                />\r\n                {phoneError === true && (\r\n                  <div className={classes.error}>\r\n                    Telephone should be 10 digits\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel />\r\n            <Form.Row\r\n              width=\"55%\"\r\n              style={{ gap: \"20px\", justifyContent: \"flex-start\" }}\r\n            >\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"fname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"First Name\"\r\n                  onChange={(e) => setFname(e.target.value)}\r\n                  value={fname}\r\n                />\r\n              </div>\r\n              <div style={{ width: \"35%\", height: \"100%\" }}>\r\n                <FormInput\r\n                  name=\"lname\"\r\n                  style={{ width: \"100%\", height: \"45px\", color: \"#8B8989\" }}\r\n                  placeholder=\"Last Name\"\r\n                  onChange={(e) => setLname(e.target.value)}\r\n                  value={lname}\r\n                />\r\n              </div>\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row>\r\n            <FormLabel bold primary=\"Website : \" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                name=\"website\"\r\n                style={{ width: \"50%\" }}\r\n                placeholder=\"http://\"\r\n                onChange={(e) => setWebsite(e.target.value)}\r\n                value={website}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n          <Form.Row alignItems=\"flex-start\">\r\n            <FormLabel bold primary=\"ADDITIONNAL INFORMATION :\" />\r\n            <Form.Row width=\"55%\">\r\n              <FormInput\r\n                textArea\r\n                rows={3}\r\n                style={{ width: \"90%\" }}\r\n                onChange={(e) => setAddInfo(e.target.value)}\r\n                placeholder=\"Informations complémentaires\"\r\n                name=\"addInfo\"\r\n                value={addInfo}\r\n              />\r\n            </Form.Row>\r\n          </Form.Row>\r\n\r\n          <Form.ButtonContainer>\r\n            <Button\r\n              type=\"submit\"\r\n              minWidth={200}\r\n              text=\"VALIDATE\"\r\n              fullWidth={false}\r\n              // loading={formik.isSubmitting}\r\n              disabled={\r\n                name === \"\" ||\r\n                color === \"\" ||\r\n                companyType === \"\" ||\r\n                contract === \"\"\r\n                  ? true\r\n                  : false\r\n              }\r\n            />\r\n          </Form.ButtonContainer>\r\n        </Form.Form>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Incidents/Incidents.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/Companies.js",["570","571","572","573","574"],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/ZACs.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/Invoices.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/Sites.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/Clients.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Admins/AddAdmin.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Admins/Admins.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/globals/Constants.js",["575"],"const BASE_URL = process.env.REACT_APP_SERVER_URL;\nconst BASE_URL_V1 = BASE_URL + \"api/v1/\";\n\nconst endpoints = {\n  BASE_URL,\n  BASE_URL_V1,\n\n  // Auth\n  LOGIN: BASE_URL_V1 + \"auth/sign-in\",\n  REGISTER_USER: BASE_URL_V1 + \"auth/sign-up\",\n  GET_PROFILE: BASE_URL_V1 + \"auth/get-profile-by-jwt\",\n  VALIDATE_TOKEN: BASE_URL_V1 + \"auth/validate-token\",\n\n  // SUPERADMIN\n  ADMINS: BASE_URL_V1 + \"superadmin/admins\",\n  ADMIN_GET: BASE_URL_V1 + \"superadmin/admins/get\",\n  ADMIN_DELETE: BASE_URL_V1 + \"superadmin/admins/delete\",\n  ADMIN_REGISTRATION: BASE_URL_V1 + \"superadmin/admins/complete-registeration\",\n  BUILDINGS: BASE_URL_V1 + \"superadmin/buildings\",\n  BUILDINGS_BY_SITE: BASE_URL_V1 + \"superadmin/buildings/site\",\n  COMPANY: BASE_URL_V1 + \"superadmin/companies\",\n  COMPANY_GET: BASE_URL_V1 + \"superadmin/companies/get\",\n  CLIENTS: BASE_URL_V1 + \"superadmin/clients\",\n  CLIENT_DELETE: BASE_URL_V1 + \"superadmin/clients/delete\",\n  DASHBOARD: BASE_URL_V1 + \"superadmin/dashboard\",\n  INVOICE: BASE_URL_V1 + \"superadmin/invoices/get\",\n  INVOICES: BASE_URL_V1 + \"superadmin/invoices\",\n  INVOICES_BY_CLIENT: BASE_URL_V1 + \"superadmin/invoices/client\",\n  INVOICE_DELETE: BASE_URL_V1 + \"superadmin/invoices/delete\",\n  LEVELS: BASE_URL_V1 + \"superadmin/levels\",\n  LEVEL_IMAGE: BASE_URL_V1 + \"superadmin/levels/image\",\n  LEVELS_BUILDING: BASE_URL_V1 + \"superadmin/levels/building\",\n  QUOTE_VERIFY: BASE_URL_V1 + \"superadmin/quotes/verify\",\n  SITES: BASE_URL_V1 + \"superadmin/sites\",\n  SITE_GET: BASE_URL_V1 + \"superadmin/sites/get\",\n  SITE_DELETE: BASE_URL_V1 + \"superadmin/sites/delete\",\n  SITE_ARCHIVE: BASE_URL_V1 + \"superadmin/sites/archive\",\n  SITES_BY_ADMIN: BASE_URL_V1 + \"superadmin/sites/admin\",\n  SITES_BY_CLIENT: BASE_URL_V1 + \"superadmin/sites/client\",\n  SITE_ARCHIVES: BASE_URL_V1 + \"superadmin/sites/archives\",\n  SITE_UN_ARCHIVE: BASE_URL_V1 + \"superadmin/sites/unarchive\",\n  ZACS: BASE_URL_V1 + \"superadmin/zacs\",\n  ZAC_DELETE: BASE_URL_V1 + \"superadmin/zacs/delete\",\n\n  // ADMIN\n  CREATE_MEAN: BASE_URL_V1 + \"mean\",\n  GET_USER_SITES: BASE_URL_V1 + \"user-sites/user\",\n  GET_LIST_OF_MEANS: BASE_URL_V1 + \"mean/get_list_of_means\",\n  GET_ADD_MEAN: BASE_URL_V1 + \"mean/get_add_mean\",\n  FILTER_MEANS: BASE_URL_V1 + \"mean/filter\",\n  GET_EXTERIOR_MEANS: BASE_URL_V1 + \"mean/get_exterior_means\",\n  GET_LEVELS: BASE_URL_V1 + \"level/get_levels_by_building\",\n  GET_STORAGE_AREA_BY_LEVEL_ID:\n    BASE_URL_V1 + \"storage-area/get_by_level_id/enterprise\",\n\n  GET_STORAGE_AREA_BY_SITE_ID:\n    BASE_URL_V1 + \"storage-area/get_storage_site/enterprise\",\n  GET_DELIVERY_AREA_BY_SITE_ID:\n    BASE_URL_V1 + \"delivery-area/get_delivery_area_site/enterprise\",\n  UPDATE_MEAN: BASE_URL_V1 + \"mean\",\n  CREATE_MEAN: BASE_URL_V1 + \"mean\",\n  GET_MEAN_HISTORY: BASE_URL_V1 + \"mean_booking\",\n  FILTER_BOOKING: BASE_URL_V1 + \"mean_booking/filter\",\n\n  GET_SITE_COMPANIES: BASE_URL_V1 + \"company-sites\",\n  GET_COMPANY_USERS: BASE_URL_V1 + \"company/company_user\",\n  FILTER_COMPANY_SITES: BASE_URL_V1 + \"company-sites/filter\",\n\n  GET_ADD_USER: BASE_URL_V1 + \"users/add_user\",\n  GET_USER_COMPANY: BASE_URL_V1 + \"users/get_user_company\",\n\n  ADD_USER_ADMIN: BASE_URL_V1 + \"users/admin/add_user\",\n};\nexport default endpoints;\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/EditSite/index.js",["576"],"import React, { useState, useEffect } from \"react\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport { useDispatch } from \"react-redux\";\nimport moment from \"moment\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\nimport GLOBALS from \"../../../../globals\";\nimport Actions from \"../../../../redux/actions\";\n\nimport EditSiteStep1 from \"./EditSiteStep1\";\nimport EditSiteStep2 from \"./EditSiteStep2\";\nimport EditSiteStep3 from \"./EditSiteStep3\";\nimport Stepper from \"../../../../components/Stepper\";\nimport Heading from \"../../../../components/Heading\";\nimport { ReactComponent as BackArrow } from \"../../../../assets/icons/BackArrow.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n}));\n\nexport default function EditSite(props) {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  // const store = useSelector((state) => state.auth);\n\n  const [step, setStep] = useState(1);\n  const [data, setData] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n  const [step1Data, setStep1Data] = useState(\"\");\n  const [step2Data, setStep2Data] = useState(\"\");\n  const [step2SubmittedData, setStep2SubmittedData] = useState(\"\");\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      let response = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.SITE_GET}/${props.match.params.siteId}`,\n      });\n      response = response.data;\n\n      const trades = response.trades.map((trade, index) => ({\n        key: index,\n        label: trade,\n      }));\n      const addresses = response.addresses.map((address, index) => ({\n        _id: index,\n        street: address.street,\n        city: address.city,\n        postal: address.postal,\n        label: `${address.street} ${address.city} ${address.postal}`,\n      }));\n      setStep1Data({\n        name: response.name,\n        logo: response.logo,\n        zacId: response.zacId?._id,\n        adminId: response.adminId._id,\n        functionality: response.functionality,\n        addresses: addresses,\n        trades: trades,\n        penaltyforLateDelivery: response.penaltyforLateDelivery,\n        penaltyforUnexpDelivery: response.penaltyforUnexpDelivery,\n      });\n\n      const openingHours = {};\n      response.openingHours.map((day) => {\n        openingHours[`day${day.day}Start`] = day.startHour;\n        openingHours[`day${day.day}End`] = day.endHour;\n        openingHours[`day${day.day}Off`] = day.dayOff;\n        return true;\n      });\n      const unavailabilityDates = [];\n\n      response.unavailabilityDates.map((key) => {\n        unavailabilityDates.push({\n          date: key.date,\n          dayOff: key.dayOff,\n          endHour: key.endHour,\n          reason: key.reason,\n          startHour: key.startHour,\n        });\n      });\n      const notificationToArray = response.notificationTo.map(\n        (notification, index) => ({\n          key: index,\n          label: notification,\n        }),\n      );\n      setStep2Data({\n        start: moment(response.start).format(\"YYYY-MM-DD\"),\n        end: moment(response.end).format(\"YYYY-MM-DD\"),\n        openingHours: openingHours,\n        unavailabilityDates: unavailabilityDates,\n        additionalInfo: response.additionalInfo,\n        notificationPriorToDays: response.notificationPriorToDays,\n        notificationTo: notificationToArray,\n      });\n\n      setData(response);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  return (\n    <div className={classes.root}>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n      </IconButton>\n      <Heading primary=\"EDIT A SITE\" />\n      <Stepper\n        disabled\n        step={step}\n        setStep={setStep}\n        steps={[\"Step 1: General Information\", \"Step 2: Dates\", \"Text 1: PIC\"]}\n      />\n      <div className={classes.content}>\n        {!loading &&\n          (step === 1 ? (\n            <EditSiteStep1\n              {...props}\n              data={data}\n              step={step}\n              setStep={setStep}\n              step1Data={step1Data}\n              step2Data={step2Data}\n              setStep1Data={setStep1Data}\n              setStep2Data={setStep2Data}\n            />\n          ) : step === 2 ? (\n            <EditSiteStep2\n              {...props}\n              data={data}\n              step={step}\n              setStep={setStep}\n              step1Data={step1Data}\n              step2Data={step2Data}\n              setStep1Data={setStep1Data}\n              setStep2Data={setStep2Data}\n              step2SubmittedData={step2SubmittedData}\n              setStep2SubmittedData={setStep2SubmittedData}\n            />\n          ) : (\n            <EditSiteStep3\n              {...props}\n              data={data}\n              step={step}\n              setStep={setStep}\n              step1Data={step1Data}\n              step2Data={step2Data}\n              setStep1Data={setStep1Data}\n              setStep2Data={setStep2Data}\n            />\n          ))}\n      </div>\n    </div>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/globals/Styles.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/globals/API.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/MeanCalender/index.js",["577"],"import React, { useState } from \"react\";\r\nimport \"./Calender.css\";\r\nimport { Modal, Button, Alert } from \"react-bootstrap\";\r\nimport Radio from \"@material-ui/core/Radio\";\r\nimport RadioGroup from \"@material-ui/core/RadioGroup\";\r\nimport FormControlLabel from \"@material-ui/core/FormControlLabel\";\r\nimport FormControl from \"@material-ui/core/FormControl\";\r\nimport myEventsList from \"./components/events\";\r\nimport moment from \"moment\";\r\nimport { Calendar, momentLocalizer } from \"react-big-calendar\";\r\nimport \"react-big-calendar/lib/css/react-big-calendar.css\";\r\nimport PopoverModal from \"./components/popoverModal\";\r\nimport MyWorkWeek from \"./components/MyWorkWeek\";\r\nimport TimePicker from \"react-time-picker\";\r\nimport SearchInput from \"../../../components/SearchInput\";\r\nimport { addDays } from \"date-fns\";\r\nimport DatePicker from \"react-datepicker\";\r\nimport FormSelect from \"../../../components/FormSelect\";\r\nimport \"react-datepicker/dist/react-datepicker.css\";\r\n\r\nlet view = {\r\n  month: true,\r\n  day: true,\r\n  work_week: MyWorkWeek,\r\n  agenda: true,\r\n};\r\n\r\nconst localizer = momentLocalizer(moment);\r\n\r\nlet formats = {\r\n  dateFormat: \"DD\",\r\n  monthHeaderFormat: \"DD/MM/YYYY\",\r\n  dayHeaderFormat: \"DD/MM/YYYY\",\r\n  dayRangeHeaderFormat: \"DD/MM/YYYY\",\r\n  timeGutterFormat: (date, culture, localizer) =>\r\n    localizer.format(date, \"HH:mm\", culture),\r\n  eventTimeRangeFormat: ({ start, end }, culture, localizer) =>\r\n    localizer.format(start, \"HH:mm\") + \"-\" + localizer.format(end, \"HH:mm\"),\r\n};\r\n\r\nconst Calender = () => {\r\n  const [alertBoxTime, setAlertBoxTime] = useState(false);\r\n  const [days] = useState([0]);\r\n  const [popoverShow, setpopoverShow] = useState(false);\r\n  const [eventID] = useState(\"\");\r\n  const [event] = useState(\"\");\r\n  const [events, setEvents] = useState(myEventsList);\r\n  const [show, setShow] = useState(false);\r\n  let [startTime, setStartTime] = useState(\"\");\r\n  let [endTime, setEndTime] = useState(\"\");\r\n  let [starttimeslice, setstarttimeslice] = useState(\"\");\r\n  let [Endtimeslice, setEndtimeslice] = useState(\"\");\r\n  const [title, setTitle] = useState(\"\");\r\n  const [value, setValue] = useState(\"\");\r\n  const [statusColor, setStatusColor] = useState(\"#FFFF00\");\r\n  const [showEdit, setShowEdit] = useState(false);\r\n  const [titleEdit, setTitleEdit] = useState(\"\");\r\n  let [startTimeEdit, setStartTimeEdit] = useState(\"\");\r\n  let [endTimeEdit, setEndTimeEdit] = useState(\"\");\r\n  let [starttimesliceEdit, setstarttimesliceEdit] = useState(\"\");\r\n  let [endtimesliceEdit, setEndtimesliceEdit] = useState(\"\");\r\n  const [statusColorEdit, setStatusColorEdit] = useState(\"\");\r\n  const [bookingslot, setbookingslot] = useState(false);\r\n  const [bookingEvent, setbookingEvent] = useState();\r\n  const [bookingTitle, setBookingTitle] = useState();\r\n  let [bookingstartTime, setBookingstartTime] = useState(\"\");\r\n  let [bookingEndTime, setBookingEndTime] = useState(\"\");\r\n  let [bookingstartTimeslice, setBookingstartTimeslice] = useState(\"\");\r\n  let [bookingendTimeslice, setBookingendTimeslice] = useState(\"\");\r\n  const [startDate, setStartDate] = useState(\"\");\r\n  const [cdate, setCdate] = useState(\"\");\r\n  // const [statusbooking, setStatusbooking] = useState(\"#FFFF00\");\r\n  const [overlap] = React.useState(\"Enable\");\r\n  // const [overlapOpen, setoverlapOpen] = React.useState(false);\r\n  // overlap functions **************\r\n  // const handleOverLapChange = (event) => {\r\n  //   setoverlap(event.target.value);\r\n  // };\r\n  // const handleOverLapClose = () => {\r\n  //   setoverlapOpen(false);\r\n  // };\r\n  // const handleOverLapOpen = () => {\r\n  //   setoverlapOpen(true);\r\n  // };\r\n  const handleClose = () => setShow(false);\r\n  let work_week_obj = {\r\n    Sunday: true,\r\n    Monday: true,\r\n    Tuesday: true,\r\n    Wednesday: true,\r\n    Thursday: true,\r\n    Friday: true,\r\n    Saturday: true,\r\n  };\r\n  for (let i = 0; i < days.length; i++) {\r\n    if (days[i] === 0) {\r\n      work_week_obj.Sunday = false;\r\n    } else if (days[i] === 1) {\r\n      work_week_obj.Monday = false;\r\n    } else if (days[i] === 2) {\r\n      work_week_obj.Tuesday = false;\r\n    } else if (days[i] === 3) {\r\n      work_week_obj.Wednesday = false;\r\n    } else if (days[i] === 4) {\r\n      work_week_obj.Thursday = false;\r\n    } else if (days[i] === 5) {\r\n      work_week_obj.Friday = false;\r\n    } else if (days[i] === 6) {\r\n      work_week_obj.Saturday = false;\r\n    }\r\n  }\r\n  // const [workWeekstate, workWeekSetState] = useState(work_week_obj);\r\n  // const workWeekHandleChange = (event) => {\r\n  //   workWeekSetState({\r\n  //     ...workWeekstate,\r\n  //     [event.target.name]: event.target.checked,\r\n  //   });\r\n\r\n  //   // if (event.target.checked === true) {\r\n  //   //   setavailabilitieModal(true);\r\n  //   // }\r\n\r\n  //   // sunday Start\r\n  //   if (event.target.name === \"Sunday\" && event.target.checked === true) {\r\n  //     let remove = days.indexOf(0);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //     // setAvailibilityDateMin();\r\n  //   } else if (\r\n  //     event.target.name === \"Sunday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(0);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // sunday End\r\n  //   // Monday Start\r\n  //   else if (event.target.name === \"Monday\" && event.target.checked === true) {\r\n  //     let remove = days.indexOf(1);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   } else if (\r\n  //     event.target.name === \"Monday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // Monday End\r\n  //   // Tuesday Start\r\n  //   else if (event.target.name === \"Tuesday\" && event.target.checked === true) {\r\n  //     let remove = days.indexOf(2);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   } else if (\r\n  //     event.target.name === \"Tuesday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(2);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // Tuesday End\r\n  //   // Wednesday Start\r\n  //   else if (\r\n  //     event.target.name === \"Wednesday\" &&\r\n  //     event.target.checked === true\r\n  //   ) {\r\n  //     let remove = days.indexOf(3);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   } else if (\r\n  //     event.target.name === \"Wednesday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(3);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // Wednesday End\r\n  //   // Thursday Start\r\n  //   else if (\r\n  //     event.target.name === \"Thursday\" &&\r\n  //     event.target.checked === true\r\n  //   ) {\r\n  //     let remove = days.indexOf(4);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   } else if (\r\n  //     event.target.name === \"Thursday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(4);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // Thursday End\r\n  //   // Friday Start\r\n  //   else if (event.target.name === \"Friday\" && event.target.checked === true) {\r\n  //     let remove = days.indexOf(5);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   } else if (\r\n  //     event.target.name === \"Friday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(5);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // Friday End\r\n  //   // Saturday Start\r\n  //   else if (\r\n  //     event.target.name === \"Saturday\" &&\r\n  //     event.target.checked === true\r\n  //   ) {\r\n  //     let remove = days.indexOf(6);\r\n  //     days.splice(remove, 1);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   } else if (\r\n  //     event.target.name === \"Saturday\" &&\r\n  //     event.target.checked === false\r\n  //   ) {\r\n  //     days.push(6);\r\n  //     days.sort();\r\n  //     setDays(days);\r\n  //   }\r\n  //   // Saturday End\r\n  // };\r\n  const updateEvent = () => {\r\n    if (titleEdit !== \"\") {\r\n      /* start time*/\r\n      startTimeEdit = String(startTimeEdit);\r\n      starttimesliceEdit = String(starttimesliceEdit);\r\n      startTimeEdit = Array.from(startTimeEdit);\r\n      starttimesliceEdit = Array.from(starttimesliceEdit);\r\n      startTimeEdit[16] = starttimesliceEdit[0];\r\n      startTimeEdit[17] = starttimesliceEdit[1];\r\n      startTimeEdit[18] = starttimesliceEdit[2];\r\n      startTimeEdit[19] = starttimesliceEdit[3];\r\n      startTimeEdit[20] = starttimesliceEdit[4];\r\n      startTimeEdit = String(startTimeEdit);\r\n      startTimeEdit = startTimeEdit.replace(/,/g, \"\");\r\n      startTimeEdit = new Date(startTimeEdit);\r\n      /* start time*/\r\n      /* End time*/\r\n      endTimeEdit = String(endTimeEdit);\r\n      endtimesliceEdit = String(endtimesliceEdit);\r\n      endTimeEdit = Array.from(endTimeEdit);\r\n      endtimesliceEdit = Array.from(endtimesliceEdit);\r\n      endTimeEdit[16] = endtimesliceEdit[0];\r\n      endTimeEdit[17] = endtimesliceEdit[1];\r\n      endTimeEdit[18] = endtimesliceEdit[2];\r\n      endTimeEdit[19] = endtimesliceEdit[3];\r\n      endTimeEdit[20] = endtimesliceEdit[4];\r\n      endTimeEdit = String(endTimeEdit);\r\n      endTimeEdit = endTimeEdit.replace(/,/g, \"\");\r\n      endTimeEdit = new Date(endTimeEdit);\r\n      /* End time*/\r\n\r\n      let preDateTime = new Date();\r\n      let milliseconds = Date.parse(preDateTime);\r\n      milliseconds = milliseconds - 1 * 60 * 1000;\r\n      preDateTime = new Date(milliseconds);\r\n      if (startTimeEdit > preDateTime && startTimeEdit < endTimeEdit) {\r\n        const updateElement = events.filter((e) => e.id === eventID);\r\n        updateElement[0].title = titleEdit;\r\n        updateElement[0].start = startTimeEdit;\r\n        updateElement[0].end = endTimeEdit;\r\n        updateElement[0].color = statusColorEdit;\r\n        setEvents([...events, updateElement]);\r\n        setTitleEdit(\"\");\r\n        setShowEdit(false);\r\n      } else {\r\n        setAlertBoxTime(true);\r\n        setTimeout(function () {\r\n          setAlertBoxTime(false);\r\n        }, 2000);\r\n      }\r\n    } else {\r\n      setAlertBoxTime(true);\r\n      setTimeout(function () {\r\n        setAlertBoxTime(false);\r\n      }, 2000);\r\n    }\r\n  };\r\n  const saveEvent = () => {\r\n    if (title !== \"\") {\r\n      /* start time*/\r\n      startTime = String(startTime);\r\n      starttimeslice = String(starttimeslice);\r\n      startTime = Array.from(startTime);\r\n      starttimeslice = Array.from(starttimeslice);\r\n      startTime[16] = starttimeslice[0];\r\n      startTime[17] = starttimeslice[1];\r\n      startTime[18] = starttimeslice[2];\r\n      startTime[19] = starttimeslice[3];\r\n      startTime[20] = starttimeslice[4];\r\n      startTime = String(startTime);\r\n      startTime = startTime.replace(/,/g, \"\");\r\n      startTime = new Date(startTime);\r\n\r\n      /* start time*/\r\n      /* End time*/\r\n      endTime = String(endTime);\r\n      Endtimeslice = String(Endtimeslice);\r\n      endTime = Array.from(endTime);\r\n      Endtimeslice = Array.from(Endtimeslice);\r\n      endTime[16] = Endtimeslice[0];\r\n      endTime[17] = Endtimeslice[1];\r\n      endTime[18] = Endtimeslice[2];\r\n      endTime[19] = Endtimeslice[3];\r\n      endTime[20] = Endtimeslice[4];\r\n      endTime = String(endTime);\r\n      endTime = endTime.replace(/,/g, \"\");\r\n      endTime = new Date(endTime);\r\n      /* End time*/\r\n      let beforeTime = moment(startTime).format(\"DD/MM/YYYY HH:mm\");\r\n      let afterTime = moment(endTime).format(\"DD/MM/YYYY HH:mm\");\r\n      let dateCheck1 = events.find((item) => {\r\n        return (\r\n          moment(item.start).format(\"DD/MM/YYYY HH:mm\") === beforeTime ||\r\n          moment(item.end).format(\"DD/MM/YYYY HH:mm\") === afterTime\r\n        );\r\n      });\r\n\r\n      let dateCheck2 = events.findIndex((item) => {\r\n        return startTime > item.start;\r\n      });\r\n      let dateCheck3 = events.findIndex((item) => {\r\n        return startTime > item.end;\r\n      });\r\n\r\n      let uniqid = Math.random();\r\n\r\n      /*check not in previous day  Start */\r\n      let preDateTime = new Date();\r\n      let milliseconds = Date.parse(preDateTime);\r\n      milliseconds = milliseconds - 1 * 60 * 1000;\r\n      preDateTime = new Date(milliseconds);\r\n      /*check not in previous day End  */\r\n\r\n      if (startTime > preDateTime && startTime < endTime) {\r\n        if (overlap === \"Enable\") {\r\n          setShow(false);\r\n          const newElement = {\r\n            id: uniqid,\r\n            title: title,\r\n            start: startTime,\r\n            end: endTime,\r\n            color: statusColor,\r\n          };\r\n          setEvents([...events, newElement]);\r\n          setTitle(\"\");\r\n        } else if (\r\n          overlap === \"Disable\" &&\r\n          dateCheck2 !== -1 &&\r\n          dateCheck3 !== -1 &&\r\n          dateCheck1 !== undefined\r\n        ) {\r\n          setAlertBoxTime(true);\r\n          setTimeout(function () {\r\n            setAlertBoxTime(false);\r\n          }, 1000);\r\n        } else {\r\n          setShow(false);\r\n          const newElement = {\r\n            id: uniqid,\r\n            title: title,\r\n            start: startTime,\r\n            end: endTime,\r\n            color: statusColor,\r\n          };\r\n          setEvents([...events, newElement]);\r\n          setTitle(\"\");\r\n        }\r\n      } else {\r\n        setAlertBoxTime(true);\r\n        setTimeout(function () {\r\n          setAlertBoxTime(false);\r\n        }, 1000);\r\n      }\r\n    } else {\r\n      setAlertBoxTime(true);\r\n      setTimeout(function () {\r\n        setAlertBoxTime(false);\r\n      }, 1000);\r\n    }\r\n  };\r\n  const AddEvent = ({ start, end, slots }) => {\r\n    setAlertBoxTime(false);\r\n    let preDateTime = new Date();\r\n    let milliseconds = Date.parse(preDateTime);\r\n    milliseconds = milliseconds - 1 * 60 * 1000;\r\n    preDateTime = new Date(milliseconds);\r\n\r\n    if (\r\n      start.getDay() === days[0] ||\r\n      start.getDay() === days[1] ||\r\n      start.getDay() === days[2] ||\r\n      start.getDay() === days[3] ||\r\n      start.getDay() === days[4] ||\r\n      start.getDay() === days[5] ||\r\n      start.getDay() === days[6]\r\n    ) {\r\n      console.log(\"not active day\");\r\n    } else {\r\n      // active days\r\n      let beforeTime = moment(start).format(\"HH:mm\");\r\n      let afterTime = moment(end).format(\"HH:mm\");\r\n      let dateCheck = events.filter((item) => {\r\n        return (\r\n          moment(item.start).format(\"DD/MM/YYYY HH:mm\") === beforeTime &&\r\n          moment(item.end).format(\"DD/MM/YYYY HH:mm\") === afterTime\r\n        );\r\n      });\r\n      if (dateCheck.length === 0 && overlap) {\r\n        if (start > preDateTime && start < end) {\r\n          if (slots.length >= 2) {\r\n            var format = \"HH:mm\";\r\n            let time = moment(start, format);\r\n            let beforeTime = moment(start).format(\"HH:mm\");\r\n            let afterTime = moment(end).format(\"HH:mm\");\r\n            let checkDiff = time.isBetween(beforeTime, afterTime);\r\n            if (\r\n              beforeTime !== \"17:00\" &&\r\n              beforeTime !== \"17:30\" &&\r\n              checkDiff === false\r\n            ) {\r\n              setShow(!show);\r\n              setStartTime(start);\r\n              setEndTime(end);\r\n              let getstart = String(start);\r\n              let getend = String(end);\r\n              getstart = getstart.slice(16, 21);\r\n              getend = getend.slice(16, 21);\r\n              setstarttimeslice(getstart);\r\n              setEndtimeslice(getend);\r\n            } else {\r\n              return false;\r\n            }\r\n          } else {\r\n            setShow(!show);\r\n            setStartTime(start);\r\n            setEndTime(end);\r\n            let getstart = String(start);\r\n            let getend = String(end);\r\n            getstart = getstart.slice(16, 21);\r\n            getend = getend.slice(16, 21);\r\n            setstarttimeslice(getstart);\r\n            setEndtimeslice(getend);\r\n          }\r\n        } else {\r\n          setAlertBoxTime(true);\r\n          setTimeout(function () {\r\n            setAlertBoxTime(false);\r\n          }, 2000);\r\n          // console.log(\"disable time clicked\");\r\n        }\r\n      } else {\r\n        console.log(\"disable time clicked\");\r\n      }\r\n    }\r\n  };\r\n\r\n  const statusColorChange = (event) => {\r\n    setValue(event.target.value);\r\n  };\r\n  const handlePopoverClose = () => setpopoverShow(false);\r\n  const handleEditEvent = () => {\r\n    setpopoverShow(!popoverShow);\r\n    setShowEdit(true);\r\n    setAlertBoxTime(false);\r\n    const fill = events.filter((e) => e.id === eventID);\r\n    setTitleEdit(fill[0].title);\r\n    let getstart = String(fill[0].start);\r\n    let getend = String(fill[0].end);\r\n    setStartTimeEdit(getstart);\r\n    setEndTimeEdit(getend);\r\n    setStatusColorEdit(fill[0].color);\r\n    // Start slice a time\r\n    getstart = getstart.slice(16, 21);\r\n    getend = getend.slice(16, 21);\r\n    setstarttimesliceEdit(getstart);\r\n    setEndtimesliceEdit(getend);\r\n    // End slice a time\r\n  };\r\n  const handleDeleteEvent = () => {\r\n    const fill = events.filter((e) => e.id !== eventID);\r\n    setEvents(fill);\r\n    setpopoverShow(!popoverShow);\r\n  };\r\n  // const handlePopoverShow = (event) => {\r\n  //   // admin code Start\r\n  //   seteventID(event.id);\r\n  //   const fill = events.filter((e) => e.id === event.id);\r\n  //   setEvent(fill[0]);\r\n  //   setpopoverShow(!popoverShow);\r\n  //   // admin code end\r\n  // };\r\n  const bookingSlot = (event) => {\r\n    // booking Event\r\n    setbookingslot(true);\r\n    const fill = events.filter((e) => e.id === event.id);\r\n    setbookingEvent(fill[0]);\r\n    setBookingstartTime(fill[0].start);\r\n    setBookingEndTime(fill[0].end);\r\n\r\n    /* show time start */\r\n    let getstart = String(fill[0].start);\r\n    let getend = String(fill[0].end);\r\n    getstart = getstart.slice(16, 21);\r\n    getend = getend.slice(16, 21);\r\n\r\n    setBookingstartTimeslice(getstart);\r\n    setBookingendTimeslice(getend);\r\n    /* show time End  */\r\n  };\r\n  const saveBooking = () => {\r\n    /* start time*/\r\n    bookingstartTime = String(bookingstartTime);\r\n    bookingstartTimeslice = String(bookingstartTimeslice);\r\n    bookingstartTime = Array.from(bookingstartTime);\r\n    bookingstartTimeslice = Array.from(bookingstartTimeslice);\r\n    bookingstartTime[16] = bookingstartTimeslice[0];\r\n    bookingstartTime[17] = bookingstartTimeslice[1];\r\n    bookingstartTime[18] = bookingstartTimeslice[2];\r\n    bookingstartTime[19] = bookingstartTimeslice[3];\r\n    bookingstartTime[20] = bookingstartTimeslice[4];\r\n    bookingstartTime = String(bookingstartTime);\r\n    bookingstartTime = bookingstartTime.replace(/,/g, \"\");\r\n    bookingstartTime = new Date(bookingstartTime);\r\n    /* start time*/\r\n    /* End  time*/\r\n    bookingEndTime = String(bookingEndTime);\r\n    bookingendTimeslice = String(bookingendTimeslice);\r\n    bookingEndTime = Array.from(bookingEndTime);\r\n    bookingendTimeslice = Array.from(bookingendTimeslice);\r\n    bookingEndTime[16] = bookingendTimeslice[0];\r\n    bookingEndTime[17] = bookingendTimeslice[1];\r\n    bookingEndTime[18] = bookingendTimeslice[2];\r\n    bookingEndTime[19] = bookingendTimeslice[3];\r\n    bookingEndTime[20] = bookingendTimeslice[4];\r\n    bookingEndTime = String(bookingEndTime);\r\n    bookingEndTime = bookingEndTime.replace(/,/g, \"\");\r\n    bookingEndTime = new Date(bookingEndTime);\r\n    /* End time*/\r\n    // let uniqid = Math.random();\r\n    // const newElement = {\r\n    //   p_id: bookingEvent.id,\r\n    //   id: uniqid,\r\n    //   title: bookingTitle,\r\n    //   start: bookingstartTime,\r\n    //   end: bookingEndTime,\r\n    //   color: statusbooking,\r\n    // };\r\n    if (\r\n      bookingEvent.start <= bookingstartTime &&\r\n      bookingEvent.end >= bookingEndTime\r\n    ) {\r\n      console.log(\"Add time in array \");\r\n    } else {\r\n      setAlertBoxTime(true);\r\n      setTimeout(function () {\r\n        setAlertBoxTime(false);\r\n      }, 1000);\r\n    }\r\n  };\r\n  // const statusBookingChange = (event) => {\r\n  //   setStatusbooking(event.target.value);\r\n  // };\r\n  function Alertbox(props) {\r\n    return (\r\n      <Alert\r\n        show={alertBoxTime}\r\n        variant=\"danger\"\r\n        onClose={() => setAlertBoxTime(!alertBoxTime)}\r\n        dismissible\r\n      >\r\n        {props.message}\r\n      </Alert>\r\n    );\r\n  }\r\n  const customDayPropGetter = (date) => {\r\n    // console.log(getWeekDay(new Date()));\r\n\r\n    if (\r\n      date.getDay() === days[0] ||\r\n      date.getDay() === days[1] ||\r\n      date.getDay() === days[2] ||\r\n      date.getDay() === days[3] ||\r\n      date.getDay() === days[4] ||\r\n      date.getDay() === days[5] ||\r\n      date.getDay() === days[6]\r\n    )\r\n      return {\r\n        className: \"special-day\",\r\n        style: {\r\n          backgroundColor: \"#EBEBE4\",\r\n        },\r\n      };\r\n    else return {};\r\n  };\r\n  return (\r\n    <>\r\n      {/* <div className=\"row \">\r\n        <div className=\"col-md-2\"></div>\r\n        <div className=\"col-md-2\"></div>\r\n        <div className=\"col-md-2\"></div>\r\n        <div className=\"col-md-6\">\r\n          <div\r\n            style={{\r\n              display: \"flex\",\r\n              \"flex-direction\": \"row\",\r\n              \"margin-top\": \"10px\",\r\n              \"align-items\": \"center\",\r\n              \"margin-bottom\": \"10px\",\r\n            }}\r\n          >\r\n            <span\r\n              style={{\r\n                \"background-color\": \"#FFFF00\",\r\n                height: \"20px\",\r\n                width: \"20px\",\r\n              }}\r\n            ></span>\r\n            <span style={{ \"margin-left\": \"10px\" }}>Pending validation</span>\r\n            <span\r\n              style={{\r\n                \"background-color\": \"#808080\",\r\n                height: \"20px\",\r\n                width: \"20px\",\r\n                \"margin-left\": \"10px\",\r\n              }}\r\n            ></span>\r\n            <span style={{ \"margin-left\": \"10px\" }}>Not availble</span>\r\n            <span\r\n              style={{\r\n                \"background-color\": \"#008000\",\r\n                height: \"20px\",\r\n                width: \"20px\",\r\n                \"margin-left\": \"10px\",\r\n              }}\r\n            ></span>\r\n            <span style={{ \"margin-left\": \"10px\" }}>Validate</span>\r\n            \r\n            <div style={{ \"margin-left\": \"auto\", \"margin-right\": \"10px\" }}>\r\n              <OverLapSelect\r\n                overlap={overlap}\r\n                overlapOpen={overlapOpen}\r\n                handleOpen={handleOverLapOpen}\r\n                handleClose={handleOverLapClose}\r\n                handleChange={handleOverLapChange}\r\n              />\r\n            </div>\r\n          </div>\r\n          <div className=\"Custom_weekdays\">\r\n            <label>Work week</label>\r\n            <FormGroup row>\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Sunday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Sunday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Sunday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Monday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Monday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Monday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Tuesday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Tuesday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Tuesday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Wednesday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Wednesday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Wednesday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Thursday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Thursday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Thursday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Friday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Friday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Friday\"\r\n              />\r\n              <FormControlLabel\r\n                control={\r\n                  <Checkbox\r\n                    checked={workWeekstate.Saturday}\r\n                    onChange={workWeekHandleChange}\r\n                    name=\"Saturday\"\r\n                    color=\"primary\"\r\n                  />\r\n                }\r\n                label=\"Saturday\"\r\n              />\r\n            </FormGroup>\r\n          </div>\r\n        </div>\r\n      </div> */}\r\n      <Modal show={bookingslot} onHide={() => setbookingslot(false)} centered>\r\n        <Modal.Header closeButton style={{ border: \"none\" }}>\r\n          <Modal.Title className=\"text-center w-100\">BOOKING</Modal.Title>\r\n        </Modal.Header>\r\n        <Alertbox message=\"Invalid Time\" />\r\n        <Modal.Body>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-12\">\r\n              <input\r\n                type=\"text\"\r\n                style={{ border: \"1px solid #707070\" }}\r\n                placeholder=\"Company : ConstructBTP\"\r\n                className=\"w-100 p-2 mb-2\"\r\n              />\r\n            </div>\r\n          </div>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-12\">\r\n              <div className=\"starttime\">\r\n                <label>Start time</label>\r\n                <TimePicker\r\n                  value={bookingstartTimeslice}\r\n                  onChange={(e) => setBookingstartTimeslice(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n              {/* <div class=\"form-group statusColor\">\r\n                <label>Status Color </label>\r\n\r\n                <FormControl component=\"fieldset\">\r\n                  <RadioGroup\r\n                    aria-label=\"statusColor\"\r\n                    name=\"statusColor\"\r\n                    value={statusbooking}\r\n                    onChange={statusBookingChange}\r\n                  >\r\n                    <FormControlLabel\r\n                      value=\"#FFFF00\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusbooking(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Pending validation\"\r\n                      className=\"pending\"\r\n                    />\r\n\r\n                    <FormControlLabel\r\n                      value=\"#808080\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusbooking(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Not availble\"\r\n                      className=\"notAvailble\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#008000\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusbooking(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Validate\"\r\n                      className=\"validate\"\r\n                    />\r\n                  </RadioGroup>\r\n                </FormControl>\r\n              </div> */}\r\n            </div>\r\n            <div className=\"col-md-12\">\r\n              <div className=\"endTime\">\r\n                <label>End Time</label>\r\n                <TimePicker\r\n                  value={bookingendTimeslice}\r\n                  onChange={(e) => setBookingendTimeslice(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row pt-3\">\r\n            <div className=\"col-md-12\">\r\n              <div className=\"description\">\r\n                <div className=\"form-group \">\r\n                  {/* <label for=\"exampleFormControlTextarea1\">Add message</label> */}\r\n                  <textarea\r\n                    className=\"form-control\"\r\n                    id=\"exampleFormControlTextarea1\"\r\n                    placeholder=\"Reason of booking\"\r\n                    rows=\"3\"\r\n                    value={bookingTitle}\r\n                    onChange={(e) => setBookingTitle(e.target.value)}\r\n                  ></textarea>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </Modal.Body>\r\n        <Modal.Footer style={{ border: \"none\" }}>\r\n          <button\r\n            className=\"w-100 py-2\"\r\n            onClick={saveBooking}\r\n            style={{\r\n              color: \"#fff\",\r\n              backgroundColor: \"#DBB20A\",\r\n              border: \"none\",\r\n              borderRadius: \"5px\",\r\n            }}\r\n          >\r\n            Book\r\n          </button>\r\n          {/* <Button variant=\"primary\" onClick={saveBooking}>\r\n            Add Booking\r\n          </Button>\r\n          <Button variant=\"secondary\" onClick={() => setbookingslot(false)}>\r\n            Close\r\n          </Button> */}\r\n        </Modal.Footer>\r\n      </Modal>\r\n      <Modal show={show} onHide={() => setShow(false)}>\r\n        <Modal.Header closeButton>\r\n          <Modal.Title>Add Event</Modal.Title>\r\n        </Modal.Header>\r\n        <Alertbox message=\"Please Add valid Time and Event\" />\r\n        <Modal.Body>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-12\">\r\n              <div className=\"description\">\r\n                <div class=\"form-group\">\r\n                  <label for=\"exampleFormControlTextarea1\">Add Event</label>\r\n                  <textarea\r\n                    class=\"form-control\"\r\n                    id=\"exampleFormControlTextarea1\"\r\n                    rows=\"3\"\r\n                    onChange={(e) => setTitle(e.target.value)}\r\n                  ></textarea>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-6\">\r\n              <div className=\"starttime\">\r\n                <label>Start time</label>\r\n                <TimePicker\r\n                  value={starttimeslice}\r\n                  onChange={(e) => setstarttimeslice(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n              <div class=\"form-group statusColor\">\r\n                <label>Status Color </label>\r\n                <FormControl component=\"fieldset\">\r\n                  <RadioGroup\r\n                    aria-label=\"gender\"\r\n                    name=\"statusColor\"\r\n                    value={statusColor}\r\n                    onChange={statusColorChange}\r\n                  >\r\n                    <FormControlLabel\r\n                      value=\"#FFFF00\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColor(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Pending validation\"\r\n                      className=\"pending\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#808080\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColor(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Not availble\"\r\n                      className=\"notAvailble\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#008000\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColor(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Validate\"\r\n                      className=\"validate\"\r\n                    />\r\n                  </RadioGroup>\r\n                </FormControl>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-md-6\">\r\n              <div className=\"endTime\">\r\n                <label>End Time</label>\r\n                <TimePicker\r\n                  value={Endtimeslice}\r\n                  onChange={(e) => setEndtimeslice(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </Modal.Body>\r\n        <Modal.Footer>\r\n          <Button variant=\"primary\" onClick={saveEvent}>\r\n            Save Event\r\n          </Button>\r\n          <Button variant=\"secondary\" onClick={handleClose}>\r\n            Close\r\n          </Button>\r\n        </Modal.Footer>\r\n      </Modal>\r\n      <Modal show={showEdit} onHide={() => setShowEdit(false)}>\r\n        <Modal.Header closeButton>\r\n          <Modal.Title>Edit Event </Modal.Title>\r\n        </Modal.Header>\r\n        <Alertbox message=\"Please Add valid Time and Event\" />\r\n        <Modal.Body>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-12\">\r\n              <div className=\"description\">\r\n                <div class=\"form-group\">\r\n                  <label for=\"exampleFormControlTextarea1\">Edit Event</label>\r\n                  <textarea\r\n                    class=\"form-control\"\r\n                    id=\"exampleFormControlTextarea1\"\r\n                    rows=\"3\"\r\n                    value={titleEdit}\r\n                    onChange={(e) => setTitleEdit(e.target.value)}\r\n                  ></textarea>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row\">\r\n            <div className=\"col-md-6\">\r\n              <div className=\"starttime\">\r\n                <label>Start time</label>\r\n                <TimePicker\r\n                  value={starttimesliceEdit}\r\n                  onChange={(e) => setstarttimesliceEdit(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n              <div class=\"form-group statusColor\">\r\n                {value && \"\"}\r\n                <label>Status Color </label>\r\n                <FormControl component=\"fieldset\">\r\n                  <RadioGroup\r\n                    aria-label=\"statusColor\"\r\n                    name=\"statusColor\"\r\n                    value={statusColorEdit}\r\n                    onChange={statusColorChange}\r\n                  >\r\n                    <FormControlLabel\r\n                      value=\"#FFFF00\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColorEdit(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Pending validation\"\r\n                      className=\"pending\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#808080\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColorEdit(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Not availble\"\r\n                      className=\"notAvailble\"\r\n                    />\r\n                    <FormControlLabel\r\n                      value=\"#008000\"\r\n                      control={\r\n                        <Radio\r\n                          color=\"primary\"\r\n                          onChange={(e) => setStatusColorEdit(e.target.value)}\r\n                        />\r\n                      }\r\n                      label=\"Validate\"\r\n                      className=\"validate\"\r\n                    />\r\n                  </RadioGroup>\r\n                </FormControl>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-md-6\">\r\n              <div className=\"endTime\">\r\n                <label>End Time</label>\r\n                <TimePicker\r\n                  value={endtimesliceEdit}\r\n                  onChange={(e) => setEndtimesliceEdit(e)}\r\n                  locale=\"sv-sv\"\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </Modal.Body>\r\n        <Modal.Footer>\r\n          <Button variant=\"primary\" onClick={updateEvent}>\r\n            Update Event\r\n          </Button>\r\n          <Button variant=\"secondary\" onClick={() => setShowEdit(false)}>\r\n            Close\r\n          </Button>\r\n        </Modal.Footer>\r\n      </Modal>\r\n\r\n      <div className=\"pt-5\">\r\n        <PopoverModal\r\n          popoverShow={popoverShow}\r\n          handlePopoverClose={handlePopoverClose}\r\n          handleDeleteEvent={handleDeleteEvent}\r\n          handleEditEvent={handleEditEvent}\r\n          event={event}\r\n        />\r\n        <div style={{}} className=\"pl-2 pt-3 pb-5 d-flex\">\r\n          <FormSelect\r\n            placeholder=\"Mean\"\r\n            values={[\r\n              { value: \"green\", label: \"Green\" },\r\n              { value: \"Yellow\", label: \"Yellow\" },\r\n              { value: \"Red\", label: \"Red\" },\r\n              { value: \"Blue\", label: \"Blue\" },\r\n              { value: \"Orange\", label: \"Orange\" },\r\n              { value: \"Purple\", label: \"Purple\" },\r\n              { value: \"Magenta\", label: \"Magenta\" },\r\n            ]}\r\n            onChange={(e) => {\r\n              console.log(\"area ==> \", e.target.value);\r\n            }}\r\n            style={{ marginRight: \"10px\", maxWidth: 250 }}\r\n          />\r\n          <div style={{ width: \"25%\", marginLeft: \"20px\" }}>\r\n            <DatePicker\r\n              showPopperArrow={true}\r\n              dateFormat=\"yyyy-MM-dd\"\r\n              selected={startDate}\r\n              popperPlacement=\"top-start\"\r\n              showYearDropdown\r\n              minDate={addDays(new Date(), 1)}\r\n              placeholderText=\"Delivery date\"\r\n              onChange={(date) => {\r\n                setStartDate(date);\r\n              }}\r\n            />\r\n          </div>\r\n        </div>\r\n        <div className=\"d-flex px-2\">\r\n          <div style={{ flexBasis: \"75%\" }}>\r\n            <Calendar\r\n              popup\r\n              selectable\r\n              formats={formats}\r\n              localizer={localizer}\r\n              events={events}\r\n              views={view}\r\n              step={60}\r\n              timeslots={1}\r\n              // onSelectEvent={handlePopoverShow}\r\n              onSelectEvent={bookingSlot}\r\n              onSelecting={false}\r\n              onSelectSlot={AddEvent}\r\n              // onSelectSlot={AddAvailability}\r\n              startAccessor=\"start\"\r\n              endAccessor=\"end\"\r\n              style={{\r\n                width: \"100%\",\r\n\r\n                height: \"470px\",\r\n              }}\r\n              eventPropGetter={(events, start, end, isSelected) => {\r\n                let newStyle = {\r\n                  backgroundColor: events[\"color\"],\r\n                  color: \"black\",\r\n                  borderRadius: \"0px\",\r\n                  border: \"none\",\r\n                };\r\n\r\n                if (events.isMine) {\r\n                  newStyle.backgroundColor = \"lightgreen\";\r\n                }\r\n\r\n                return {\r\n                  className: \"\",\r\n                  style: newStyle,\r\n                };\r\n              }}\r\n              messages={{\r\n                date: \"Date\",\r\n                time: \"Time\",\r\n                event: \"Event\",\r\n                allDay: \"All Day\",\r\n                week: \"week\",\r\n                work_week: \"Work Week\",\r\n                day: \"Day\",\r\n                month: \"Month\",\r\n                previous: \"Previous\",\r\n                next: \"Next\",\r\n                yesterday: \"Yesterday\",\r\n                tomorrow: \"Tomorrow\",\r\n                today: \"Today\",\r\n                agenda: \"Agenda\",\r\n                noEventsInRange: \"There are no events in this range.\",\r\n                showMore: function (e) {\r\n                  return \"+\" + e + \" more\";\r\n                },\r\n              }}\r\n              custom_week_days={days}\r\n              dayPropGetter={customDayPropGetter}\r\n            />\r\n          </div>\r\n          <div style={{ flexBasis: \"25%\", margin: \"0 20px 0px 10px\" }}>\r\n            <div className=\"calender-sidebar pt-5\">\r\n              <div className=\"text-center w-100 calender-sidebar-heading pb-3\">\r\n                BOOKING\r\n              </div>\r\n              <div className=\"row\">\r\n                <div className=\"col-md-12\">\r\n                  <input\r\n                    disabled\r\n                    type=\"text\"\r\n                    style={{ border: \"1px solid #707070\", textAlign: \"center\" }}\r\n                    placeholder=\"Lundi 03 Septembre 2020\"\r\n                    className=\"w-100 p-2\"\r\n                    value={cdate}\r\n                    onChange={(e) => setCdate(e.target.value)}\r\n                  />\r\n                </div>\r\n              </div>\r\n              <div className=\"row mt-3\">\r\n                <div className=\"col-md-12\">\r\n                  <div className=\"starttime\">\r\n                    <FormSelect\r\n                      placeholder=\"ConstructBTP\"\r\n                      values={[\r\n                        { value: \"green\", label: \"Green\" },\r\n                        { value: \"Yellow\", label: \"Yellow\" },\r\n                        { value: \"Red\", label: \"Red\" },\r\n                        { value: \"Blue\", label: \"Blue\" },\r\n                        { value: \"Orange\", label: \"Orange\" },\r\n                        { value: \"Purple\", label: \"Purple\" },\r\n                        { value: \"Magenta\", label: \"Magenta\" },\r\n                      ]}\r\n                      onChange={(e) => {\r\n                        console.log(\"area ==> \", e.target.value);\r\n                      }}\r\n                      style={{ maxWidth: 300 }}\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"col-md-12 mt-3\">\r\n                  <div className=\"endTime\">\r\n                    <FormSelect\r\n                      placeholder=\"Start hour\"\r\n                      values={[\r\n                        { value: \"green\", label: \"Green\" },\r\n                        { value: \"Yellow\", label: \"Yellow\" },\r\n                        { value: \"Red\", label: \"Red\" },\r\n                        { value: \"Blue\", label: \"Blue\" },\r\n                        { value: \"Orange\", label: \"Orange\" },\r\n                        { value: \"Purple\", label: \"Purple\" },\r\n                        { value: \"Magenta\", label: \"Magenta\" },\r\n                      ]}\r\n                      onChange={(e) => {\r\n                        console.log(\"area ==> \", e.target.value);\r\n                      }}\r\n                      style={{ maxWidth: 300 }}\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"col-md-12 mt-3\">\r\n                  <div className=\"endTime\">\r\n                    <FormSelect\r\n                      placeholder=\"End hour\"\r\n                      values={[\r\n                        { value: \"green\", label: \"Green\" },\r\n                        { value: \"Yellow\", label: \"Yellow\" },\r\n                        { value: \"Red\", label: \"Red\" },\r\n                        { value: \"Blue\", label: \"Blue\" },\r\n                        { value: \"Orange\", label: \"Orange\" },\r\n                        { value: \"Purple\", label: \"Purple\" },\r\n                        { value: \"Magenta\", label: \"Magenta\" },\r\n                      ]}\r\n                      onChange={(e) => {\r\n                        console.log(\"area ==> \", e.target.value);\r\n                      }}\r\n                      style={{ maxWidth: 300 }}\r\n                    />\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <div className=\"row pt-3\">\r\n                <div className=\"col-md-12\">\r\n                  <div className=\"description\">\r\n                    <div className=\"form-group \">\r\n                      {/* <label for=\"exampleFormControlTextarea1\">Add message</label> */}\r\n                      <textarea\r\n                        className=\"form-control\"\r\n                        id=\"exampleFormControlTextarea1\"\r\n                        placeholder=\"Reason of booking\"\r\n                        rows=\"3\"\r\n                        value={bookingTitle}\r\n                        onChange={(e) => setBookingTitle(e.target.value)}\r\n                      ></textarea>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n\r\n              <div>\r\n                <button\r\n                  className=\"w-100 py-2\"\r\n                  onClick={saveBooking}\r\n                  style={{\r\n                    color: \"#fff\",\r\n                    backgroundColor: \"#DBB20A\",\r\n                    border: \"none\",\r\n                    borderRadius: \"5px\",\r\n                  }}\r\n                >\r\n                  Book\r\n                </button>\r\n              </div>\r\n              {/* <Button variant=\"primary\" onClick={saveBooking}>\r\n            Add Booking\r\n          </Button>\r\n          <Button variant=\"secondary\" onClick={() => setbookingslot(false)}>\r\n            Close\r\n          </Button> */}\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default Calender;\r\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/FormInput.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/FormSelect.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/CustomButtonModal.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/AvatarUpload.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/SearchInput.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Table.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/FormMultipleUpload.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/CustomInputModalSingleSelect.js",["578","579"],"import React, { useState, useEffect } from \"react\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n// import * as Yup from \"yup\";\nimport Grid from \"@material-ui/core/Grid\";\nimport Chip from \"@material-ui/core/Chip\";\nimport { useFormik } from \"formik\";\nimport GLOBALS from \"../globals\";\nimport FormSelect from \"../components/FormSelect\";\n\nimport Form from \"./Form\";\nimport Modal from \"./Modal\";\nimport Button from \"./Button\";\nimport { ReactComponent as Plus } from \"../assets/icons/Plus.svg\";\n\n// const addAddressesYup = Yup.object().shape({\n//   street: Yup.string().required(\"Required\"),\n//   city: Yup.string().required(\"Required\"),\n//   postal: Yup.string().required(\"Required\"),\n// });\n\nexport default function CustomInputModalSingleSelect(props) {\n  useEffect(() => {\n    if (props.chipDefaultValues != undefined)\n      setChipValues(props.chipDefaultValues);\n  });\n\n  const theme = useTheme();\n\n  const error = theme.palette.error.main;\n  const white = theme.palette.common.white;\n  const primaryColor = theme.palette.primary.contrastText;\n  const borderColor = props.error ? error : theme.palette.grey[100];\n\n  const formik = useFormik({\n    initialValues: {\n      logo: [],\n      name: \"\",\n      storage: \"\",\n      deliveryAreas: \"\",\n      firstName: \"\",\n      lastName: \"\",\n      email: \"\",\n      phone: \"\",\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n\n    onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  const useStyles = makeStyles((theme) => ({\n    root: {\n      position: \"relative\",\n    },\n    container: {\n      width: 45,\n      height: 45,\n      outline: 0,\n      borderWidth: 1,\n      display: \"grid\",\n      cursor: \"pointer\",\n      borderStyle: \"solid\",\n      placeItems: \"center\",\n      backgroundColor: white,\n      borderColor: borderColor,\n    },\n    chips: {\n      margin: 0,\n      marginTop: 15,\n      display: \"flex\",\n      flexWrap: \"wrap\",\n      listStyle: \"none\",\n      justifyContent: \"center\",\n    },\n    chip: {\n      color: primaryColor,\n      margin: theme.spacing(0.5),\n    },\n    error: {\n      color: error,\n      fontWeight: 400,\n      position: \"absolute\",\n      fontSize: theme.typography.pxToRem(12),\n    },\n  }));\n\n  const classes = useStyles();\n  const [modal, setModal] = useState(false);\n  const [update] = useState(false);\n\n  // const [street, setStreet] = useState(\"\");\n  // const [city, setCity] = useState(\"\");\n  // const [postal, setPostal] = useState(\"\");\n  const [chipValues, setChipValues] = useState([]);\n\n  async function onSubmit() {\n    let value = props.value;\n    let id = props.id;\n\n    let valuesTemp = [...chipValues];\n\n    if (valuesTemp) {\n      const values = {\n        key: value.length + Date.now().toString(),\n        label: value,\n        id: id,\n      };\n      valuesTemp.push(values);\n      setChipValues(valuesTemp);\n      if (props.chipValues !== undefined) props.chipValues(valuesTemp);\n    }\n\n    setModal(false);\n  }\n\n  const handleDelete = (value) => () => {\n    const newValues = chipValues.filter((chip) => chip.key !== value.key);\n    setChipValues(newValues);\n    if (props.chipValues !== undefined) props.chipValues(newValues);\n    //props.onChange(newValues);\n    //  setUpdate((st) => !st);\n  };\n\n  return (\n    <>\n      <div className={`${classes.root} ${props.className}`} style={props.style}>\n        <Grid container spacing={2}>\n          <Grid item xs={4}>\n            <div className={classes.container}>\n              <div\n                onClick={() => {\n                  setModal(true);\n                  props.onBlur && props.onBlur();\n                }}\n              >\n                <Plus style={{ width: 20, height: 20 }} />\n              </div>\n            </div>\n            {props.error !== \"\" && (\n              <span className={classes.error}>{props.error}</span>\n            )}\n          </Grid>\n          {update && \"\"}\n          <ul className={classes.chips}>\n            {chipValues.map((data) => (\n              <li key={data.key}>\n                <Chip\n                  label={data.label}\n                  className={classes.chip}\n                  onDelete={handleDelete(data)}\n                />\n              </li>\n            ))}\n          </ul>\n        </Grid>\n      </div>\n      <Modal\n        title=\"ADD LOCATION\"\n        open={modal}\n        onClose={() => setModal((st) => !st)}\n        body={\n          <Form.Form>\n            <Form.Row>\n              <FormSelect\n                placeholder={props.placeholder}\n                name=\"deliveryAreas\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={(event) => {\n                  props.onChange(event);\n                  return formik.handleChange;\n                }}\n                value={(formik.values.deliveryAreas = props.value)}\n                error={formik.errors.deliveryAreas}\n                values={props.values}\n              />\n            </Form.Row>\n\n            <Form.Row justifyContent=\"center\">\n              <Button\n                minWidth={200}\n                text=\"VALIDATE\"\n                fullWidth={false}\n                onClick={onSubmit}\n                disabled={!props.value}\n              />\n            </Form.Row>\n          </Form.Form>\n        }\n      />\n    </>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Pagination.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Modal.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/RadioButton.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/SmallButton.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Stepper.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/MultiAdderInput.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep3.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep2.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep1.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/p
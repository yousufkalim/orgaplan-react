op/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/ErrorBoundary.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Loader.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/redux/actions/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/redux/reducers/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/UnAuth/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/redux/actions/notistack.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/redux/actions/auth.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/redux/reducers/notistack.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/redux/reducers/auth.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/AdminHeader.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/UnAuth/ForgotPassword.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/UnAuth/Login.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/SuperAdminHeader.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/UnAuth/LandingPage.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Logs.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Home.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Invoices/Invoices.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Incidents/Incidents.js",["434","435","436","437","438","439","440"],"import React, { useState, useEffect } from \"react\";\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n// import * as Yup from \"yup\";\n\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\n\nimport { useFormik } from \"formik\";\n\n// import Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport FormInput from \"../../../components/FormInput\";\n\nimport SiteImage from \"../../../assets/images/Site.png\";\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  link: {\n    marginRight: 20,\n    whiteSpace: \"nowrap\",\n    color: theme.palette.primary.contrastText,\n  },\n  image: {\n    height: 70,\n    borderRadius: theme.shape.borderRadius,\n  },\n}));\n\nconst Incidents = () => {\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n  const [page] = useState(1);\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.SITES}?page=${page}`,\n      });\n      setItems(result.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const rows = GLOBALS.Data.incidents.items.map((item) => [...item]);\n\n  const formik = useFormik({\n    initialValues: {\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    // validationSchema: addClientYup,\n    // onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row alignItems=\"center\">\n        <Heading icon primary=\"RE-INVOICING\" noWrap />\n        <div>\n          <Form.Row\n            alignItems=\"flex-start\"\n            noMargin\n            justifyContent=\"flex-end\"\n            style={{ paddingRight: \"50px\" }}\n          >\n            <SubHeading\n              disableMargin\n              topPadding\n              style={{ color: \"#F80303\" }}\n              primary=\"TOTAL : 5 RE-INVOICING\n              345€ \n\"\n              bold\n            />\n            <Form.Column style={{ width: \"50%\" }}>\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"CREATE AN INCIDENT\"\n                to={\"/incidents/add-incidents\"}\n                style={{\n                  marginLeft: \"20px\",\n                  marginBottom: \"7px\",\n                  width: \"200px\",\n                  fontWeight: \"bold\",\n                  backgroundColor: \"#F80303\",\n                }}\n              />\n              {/* <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"MEANS REQUEST\"\n                to={\"/sites/means-request\"}\n                style={{ marginLeft: \"20px\", width: \"200px\" }}\n              /> */}\n            </Form.Column>\n          </Form.Row>\n        </div>\n      </Form.Row>\n      <Form.Row alignItems=\"center\" noMargin>\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          {/* <SearchInput\n            placeholder=\"Site name\"\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          /> */}\n          <FormSelect\n            placeholder=\"Delivery area\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Location\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Level\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Storage area\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Type\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\n          See archived sites\n        </NavLink> */}\n      </Form.Row>\n\n      <Form.Row alignItems=\"center\" className=\"mt-3\">\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          <FormSelect\n            placeholder=\"Company\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n\n          <FormInput\n            type=\"date\"\n            style={GLOBALS.Styles.inputWidth}\n            placeholder=\"Start date\"\n            name=\"contractStartDate\"\n            icon\n            onChange={formik.handleChange}\n            // value={formik.values.contractStartDate}\n            // error={formik.errors.contractStartDate}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormInput\n            type=\"date\"\n            style={GLOBALS.Styles.inputWidth}\n            placeholder=\"End date\"\n            name=\"contractStartDate\"\n            icon\n            onChange={formik.handleChange}\n            // value={formik.values.contractStartDate}\n            // error={formik.errors.contractStartDate}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Status\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <SearchInput\n            placeholder=\"Designation\"\n            style={{ marginRight: \"5px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n      </Form.Row>\n      <div className={classes.content}>\n        <Table headers={GLOBALS.Data.incidents.headings} rows={rows} />\n      </div>\n    </div>\n  );\n};\n\nexport default Incidents;\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/assets/Assets.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Calender/index.js",["441","442","443","444","445","446","447","448","449","450","451","452","453","454","455","456","457","458","459","460","461","462","463","464"],"import React, { useState } from \"react\";\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\nimport { Modal, Button, Alert, Row, Col } from \"react-bootstrap\";\nimport Radio from \"@material-ui/core/Radio\";\nimport RadioGroup from \"@material-ui/core/RadioGroup\";\nimport FormControlLabel from \"@material-ui/core/FormControlLabel\";\nimport FormControl from \"@material-ui/core/FormControl\";\nimport myEventsList from \"./components/events\";\nimport moment from \"moment\";\nimport { Calendar, momentLocalizer } from \"react-big-calendar\";\nimport \"react-big-calendar/lib/css/react-big-calendar.css\";\nimport PopoverModal from \"./components/popoverModal\";\nimport MyWorkWeek from \"./components/MyWorkWeek\";\nimport FormGroup from \"@material-ui/core/FormGroup\";\nimport Checkbox from \"@material-ui/core/Checkbox\";\nimport OverLapSelect from \"./components/overlapSelect\";\nimport CheckBoxOutlineBlankIcon from \"@material-ui/icons/CheckBoxOutlineBlank\";\nimport CheckBoxIcon from \"@material-ui/icons/CheckBox\";\nimport TimePicker from \"react-time-picker\";\nimport DateTimePicker from \"react-datetime-picker\";\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n}));\nlet view = {\n  month: true,\n  day: true,\n  work_week: MyWorkWeek,\n  agenda: true,\n};\n\nconst localizer = momentLocalizer(moment);\nconst ColoredDateCellWrapper = ({ children }) =>\n  React.cloneElement(React.Children.only(children), {\n    style: {\n      backgroundColor: \"#fff\",\n    },\n  });\n\nlet formats = {\n  dateFormat: \"DD\",\n  monthHeaderFormat: \"DD/MM/YYYY\",\n  dayHeaderFormat: \"DD/MM/YYYY\",\n  dayRangeHeaderFormat: \"DD/MM/YYYY\",\n  timeGutterFormat: (date, culture, localizer) =>\n    localizer.format(date, \"HH:mm\", culture),\n  eventTimeRangeFormat: ({ start, end }, culture, localizer) =>\n    localizer.format(start, \"HH:mm\") + \"-\" + localizer.format(end, \"HH:mm\"),\n};\n\nconst Calender = () => {\n  const classes = useStyles();\n  const [availabilitieModal, setavailabilitieModal] = useState(false);\n  const [alertBoxTime, setAlertBoxTime] = useState(false);\n  const [days, setDays] = useState([0]);\n  const [popoverShow, setpopoverShow] = useState(false);\n  const [eventID, seteventID] = useState(\"\");\n  const [event, setEvent] = useState(\"\");\n  const [events, setEvents] = useState(myEventsList);\n  const [show, setShow] = useState(false);\n  let [startTime, setStartTime] = useState(\"\");\n  let [endTime, setEndTime] = useState(\"\");\n  let [starttimeslice, setstarttimeslice] = useState(\"\");\n  let [Endtimeslice, setEndtimeslice] = useState(\"\");\n  const [title, setTitle] = useState(\"\");\n  const [value, setValue] = useState(\"\");\n  const [statusColor, setStatusColor] = useState(\"#FFFF00\");\n  const [showEdit, setShowEdit] = useState(false);\n  const [titleEdit, setTitleEdit] = useState(\"\");\n  let [startTimeEdit, setStartTimeEdit] = useState(\"\");\n  let [endTimeEdit, setEndTimeEdit] = useState(\"\");\n  let [starttimesliceEdit, setstarttimesliceEdit] = useState(\"\");\n  let [endtimesliceEdit, setEndtimesliceEdit] = useState(\"\");\n  const [statusColorEdit, setStatusColorEdit] = useState(\"\");\n  const [dayLayoutAlgorithm, setdayLayoutAlgorithm] = useState(\"no-overlap\");\n  const [bookingslot, setbookingslot] = useState(false);\n  const [bookingEvent, setbookingEvent] = useState();\n  const [bookingTitle, setBookingTitle] = useState();\n  let [bookingstartTime, setBookingstartTime] = useState(\"\");\n  let [bookingEndTime, setBookingEndTime] = useState(\"\");\n  let [bookingstartTimeslice, setBookingstartTimeslice] = useState(\"\");\n  let [bookingendTimeslice, setBookingendTimeslice] = useState(\"\");\n  const [statusbooking, setStatusbooking] = useState(\"#FFFF00\");\n  const [overlap, setoverlap] = React.useState(\"Enable\");\n  const [overlapOpen, setoverlapOpen] = React.useState(false);\n  // overlap functions **************\n  const handleOverLapChange = (event) => {\n    setoverlap(event.target.value);\n  };\n  const handleOverLapClose = () => {\n    setoverlapOpen(false);\n  };\n  const handleOverLapOpen = () => {\n    setoverlapOpen(true);\n  };\n  const handleClose = () => setShow(false);\n  let work_week_obj = {\n    Sunday: true,\n    Monday: true,\n    Tuesday: true,\n    Wednesday: true,\n    Thursday: true,\n    Friday: true,\n    Saturday: true,\n  };\n  for (let i = 0; i < days.length; i++) {\n    if (days[i] === 0) {\n      work_week_obj.Sunday = false;\n    } else if (days[i] === 1) {\n      work_week_obj.Monday = false;\n    } else if (days[i] === 2) {\n      work_week_obj.Tuesday = false;\n    } else if (days[i] === 3) {\n      work_week_obj.Wednesday = false;\n    } else if (days[i] === 4) {\n      work_week_obj.Thursday = false;\n    } else if (days[i] === 5) {\n      work_week_obj.Friday = false;\n    } else if (days[i] === 6) {\n      work_week_obj.Saturday = false;\n    }\n  }\n  const [workWeekstate, workWeekSetState] = useState(work_week_obj);\n  const workWeekHandleChange = (event) => {\n    workWeekSetState({\n      ...workWeekstate,\n      [event.target.name]: event.target.checked,\n    });\n\n    // if (event.target.checked === true) {\n    //   setavailabilitieModal(true);\n    // }\n\n    // sunday Start\n    if (event.target.name === \"Sunday\" && event.target.checked === true) {\n      let remove = days.indexOf(0);\n      days.splice(remove, 1);\n      days.sort();\n      setDays(days);\n      // setAvailibilityDateMin();\n    } else if (\n      event.target.name === \"Sunday\" &&\n      event.target.checked === false\n    ) {\n      days.push(0);\n      days.sort();\n      setDays(days);\n    }\n    // sunday End\n    // Monday Start\n    else if (event.target.name === \"Monday\" && event.target.checked === true) {\n      let remove = days.indexOf(1);\n      days.splice(remove, 1);\n      days.sort();\n      setDays(days);\n    } else if (\n      event.target.name === \"Monday\" &&\n      event.target.checked === false\n    ) {\n      days.push(1);\n      days.sort();\n      setDays(days);\n    }\n    // Monday End\n    // Tuesday Start\n    else if (event.target.name === \"Tuesday\" && event.target.checked === true) {\n      let remove = days.indexOf(2);\n      days.splice(remove, 1);\n      days.sort();\n      setDays(days);\n    } else if (\n      event.target.name === \"Tuesday\" &&\n      event.target.checked === false\n    ) {\n      days.push(2);\n      days.sort();\n      setDays(days);\n    }\n    // Tuesday End\n    // Wednesday Start\n    else if (\n      event.target.name === \"Wednesday\" &&\n      event.target.checked === true\n    ) {\n      let remove = days.indexOf(3);\n      days.splice(remove, 1);\n      days.sort();\n      setDays(days);\n    } else if (\n      event.target.name === \"Wednesday\" &&\n      event.target.checked === false\n    ) {\n      days.push(3);\n      days.sort();\n      setDays(days);\n    }\n    // Wednesday End\n    // Thursday Start\n    else if (\n      event.target.name === \"Thursday\" &&\n      event.target.checked === true\n    ) {\n      let remove = days.indexOf(4);\n      days.splice(remove, 1);\n      days.sort();\n      setDays(days);\n    } else if (\n      event.target.name === \"Thursday\" &&\n      event.target.checked === false\n    ) {\n      days.push(4);\n      days.sort();\n      setDays(days);\n    }\n    // Thursday End\n    // Friday Start\n    else if (event.target.name === \"Friday\" && event.target.checked === true) {\n      let remove = days.indexOf(5);\n      days.splice(remove, 1);\n      days.sort();\n      setDays(days);\n    } else if (\n      event.target.name === \"Friday\" &&\n      event.target.checked === false\n    ) {\n      days.push(5);\n      days.sort();\n      setDays(days);\n    }\n    // Friday End\n    // Saturday Start\n    else if (\n      event.target.name === \"Saturday\" &&\n      event.target.checked === true\n    ) {\n      let remove = days.indexOf(6);\n      days.splice(remove, 1);\n      days.sort();\n      setDays(days);\n    } else if (\n      event.target.name === \"Saturday\" &&\n      event.target.checked === false\n    ) {\n      days.push(6);\n      days.sort();\n      setDays(days);\n    }\n    // Saturday End\n  };\n  const updateEvent = () => {\n    if (titleEdit !== \"\") {\n      /* start time*/\n      startTimeEdit = String(startTimeEdit);\n      starttimesliceEdit = String(starttimesliceEdit);\n      startTimeEdit = Array.from(startTimeEdit);\n      starttimesliceEdit = Array.from(starttimesliceEdit);\n      startTimeEdit[16] = starttimesliceEdit[0];\n      startTimeEdit[17] = starttimesliceEdit[1];\n      startTimeEdit[18] = starttimesliceEdit[2];\n      startTimeEdit[19] = starttimesliceEdit[3];\n      startTimeEdit[20] = starttimesliceEdit[4];\n      startTimeEdit = String(startTimeEdit);\n      startTimeEdit = startTimeEdit.replace(/,/g, \"\");\n      startTimeEdit = new Date(startTimeEdit);\n      /* start time*/\n      /* End time*/\n      endTimeEdit = String(endTimeEdit);\n      endtimesliceEdit = String(endtimesliceEdit);\n      endTimeEdit = Array.from(endTimeEdit);\n      endtimesliceEdit = Array.from(endtimesliceEdit);\n      endTimeEdit[16] = endtimesliceEdit[0];\n      endTimeEdit[17] = endtimesliceEdit[1];\n      endTimeEdit[18] = endtimesliceEdit[2];\n      endTimeEdit[19] = endtimesliceEdit[3];\n      endTimeEdit[20] = endtimesliceEdit[4];\n      endTimeEdit = String(endTimeEdit);\n      endTimeEdit = endTimeEdit.replace(/,/g, \"\");\n      endTimeEdit = new Date(endTimeEdit);\n      /* End time*/\n\n      let preDateTime = new Date();\n      let milliseconds = Date.parse(preDateTime);\n      milliseconds = milliseconds - 1 * 60 * 1000;\n      preDateTime = new Date(milliseconds);\n      if (startTimeEdit > preDateTime && startTimeEdit < endTimeEdit) {\n        const updateElement = events.filter((e) => e.id == eventID);\n        updateElement[0].title = titleEdit;\n        updateElement[0].start = startTimeEdit;\n        updateElement[0].end = endTimeEdit;\n        updateElement[0].color = statusColorEdit;\n        setEvents([...events, updateElement]);\n        setTitleEdit(\"\");\n        setShowEdit(false);\n      } else {\n        setAlertBoxTime(true);\n        setTimeout(function () {\n          setAlertBoxTime(false);\n        }, 2000);\n      }\n    } else {\n      setAlertBoxTime(true);\n      setTimeout(function () {\n        setAlertBoxTime(false);\n      }, 2000);\n    }\n  };\n  const saveEvent = () => {\n    if (title !== \"\") {\n      /* start time*/\n      startTime = String(startTime);\n      starttimeslice = String(starttimeslice);\n      startTime = Array.from(startTime);\n      starttimeslice = Array.from(starttimeslice);\n      startTime[16] = starttimeslice[0];\n      startTime[17] = starttimeslice[1];\n      startTime[18] = starttimeslice[2];\n      startTime[19] = starttimeslice[3];\n      startTime[20] = starttimeslice[4];\n      startTime = String(startTime);\n      startTime = startTime.replace(/,/g, \"\");\n      startTime = new Date(startTime);\n\n      /* start time*/\n      /* End time*/\n      endTime = String(endTime);\n      Endtimeslice = String(Endtimeslice);\n      endTime = Array.from(endTime);\n      Endtimeslice = Array.from(Endtimeslice);\n      endTime[16] = Endtimeslice[0];\n      endTime[17] = Endtimeslice[1];\n      endTime[18] = Endtimeslice[2];\n      endTime[19] = Endtimeslice[3];\n      endTime[20] = Endtimeslice[4];\n      endTime = String(endTime);\n      endTime = endTime.replace(/,/g, \"\");\n      endTime = new Date(endTime);\n      /* End time*/\n      let beforeTime = moment(startTime).format(\"DD/MM/YYYY HH:mm\");\n      let afterTime = moment(endTime).format(\"DD/MM/YYYY HH:mm\");\n      let dateCheck1 = events.find((item) => {\n        return (\n          moment(item.start).format(\"DD/MM/YYYY HH:mm\") == beforeTime ||\n          moment(item.end).format(\"DD/MM/YYYY HH:mm\") == afterTime\n        );\n      });\n\n      let dateCheck2 = events.findIndex((item) => {\n        return startTime > item.start;\n      });\n      let dateCheck3 = events.findIndex((item) => {\n        return startTime > item.end;\n      });\n\n      let uniqid = Math.random();\n\n      /*check not in previous day  Start */\n      let preDateTime = new Date();\n      let milliseconds = Date.parse(preDateTime);\n      milliseconds = milliseconds - 1 * 60 * 1000;\n      preDateTime = new Date(milliseconds);\n      /*check not in previous day End  */\n\n      if (startTime > preDateTime && startTime < endTime) {\n        if (overlap == \"Enable\") {\n          setShow(false);\n          const newElement = {\n            id: uniqid,\n            title: title,\n            start: startTime,\n            end: endTime,\n            color: statusColor,\n          };\n          setEvents([...events, newElement]);\n          setTitle(\"\");\n        } else if (\n          overlap == \"Disable\" &&\n          dateCheck2 !== -1 &&\n          dateCheck3 !== -1 &&\n          dateCheck1 !== undefined\n        ) {\n          setAlertBoxTime(true);\n          setTimeout(function () {\n            setAlertBoxTime(false);\n          }, 1000);\n        } else {\n          setShow(false);\n          const newElement = {\n            id: uniqid,\n            title: title,\n            start: startTime,\n            end: endTime,\n            color: statusColor,\n          };\n          setEvents([...events, newElement]);\n          setTitle(\"\");\n        }\n      } else {\n        setAlertBoxTime(true);\n        setTimeout(function () {\n          setAlertBoxTime(false);\n        }, 1000);\n      }\n    } else {\n      setAlertBoxTime(true);\n      setTimeout(function () {\n        setAlertBoxTime(false);\n      }, 1000);\n    }\n  };\n  const AddEvent = ({ start, end, slots }) => {\n    setAlertBoxTime(false);\n    let preDateTime = new Date();\n    let milliseconds = Date.parse(preDateTime);\n    milliseconds = milliseconds - 1 * 60 * 1000;\n    preDateTime = new Date(milliseconds);\n\n    if (\n      start.getDay() === days[0] ||\n      start.getDay() === days[1] ||\n      start.getDay() === days[2] ||\n      start.getDay() === days[3] ||\n      start.getDay() === days[4] ||\n      start.getDay() === days[5] ||\n      start.getDay() === days[6]\n    ) {\n      console.log(\"not active day\");\n    } else {\n      // active days\n      let beforeTime = moment(start).format(\"HH:mm\");\n      let afterTime = moment(end).format(\"HH:mm\");\n      let dateCheck = events.filter((item) => {\n        return (\n          moment(item.start).format(\"DD/MM/YYYY HH:mm\") === beforeTime &&\n          moment(item.end).format(\"DD/MM/YYYY HH:mm\") === afterTime\n        );\n      });\n      if (dateCheck.length == 0 && overlap) {\n        if (start > preDateTime && start < end) {\n          if (slots.length >= 2) {\n            var format = \"HH:mm\";\n            let time = moment(start, format);\n            let beforeTime = moment(start).format(\"HH:mm\");\n            let afterTime = moment(end).format(\"HH:mm\");\n            let checkDiff = time.isBetween(beforeTime, afterTime);\n            if (\n              beforeTime !== \"17:00\" &&\n              beforeTime !== \"17:30\" &&\n              checkDiff == false\n            ) {\n              setShow(!show);\n              setStartTime(start);\n              setEndTime(end);\n              let getstart = String(start);\n              let getend = String(end);\n              getstart = getstart.slice(16, 21);\n              getend = getend.slice(16, 21);\n              setstarttimeslice(getstart);\n              setEndtimeslice(getend);\n            } else {\n              return false;\n            }\n          } else {\n            setShow(!show);\n            setStartTime(start);\n            setEndTime(end);\n            let getstart = String(start);\n            let getend = String(end);\n            getstart = getstart.slice(16, 21);\n            getend = getend.slice(16, 21);\n            setstarttimeslice(getstart);\n            setEndtimeslice(getend);\n          }\n        } else {\n          setAlertBoxTime(true);\n          setTimeout(function () {\n            setAlertBoxTime(false);\n          }, 2000);\n          // console.log(\"disable time clicked\");\n        }\n      } else {\n        console.log(\"disable time clicked\");\n      }\n    }\n  };\n  const AddAvailability = ({ start, end }) => {};\n  const statusColorChange = (event) => {\n    setValue(event.target.value);\n  };\n  const handlePopoverClose = () => setpopoverShow(false);\n  const handleEditEvent = () => {\n    setpopoverShow(!popoverShow);\n    setShowEdit(true);\n    setAlertBoxTime(false);\n    const fill = events.filter((e) => e.id === eventID);\n    setTitleEdit(fill[0].title);\n    let getstart = String(fill[0].start);\n    let getend = String(fill[0].end);\n    setStartTimeEdit(getstart);\n    setEndTimeEdit(getend);\n    setStatusColorEdit(fill[0].color);\n    // Start slice a time\n    getstart = getstart.slice(16, 21);\n    getend = getend.slice(16, 21);\n    setstarttimesliceEdit(getstart);\n    setEndtimesliceEdit(getend);\n    // End slice a time\n  };\n  const handleDeleteEvent = () => {\n    const fill = events.filter((e) => e.id != eventID);\n    setEvents(fill);\n    setpopoverShow(!popoverShow);\n  };\n  const handlePopoverShow = (event) => {\n    // admin code Start\n    seteventID(event.id);\n    const fill = events.filter((e) => e.id === event.id);\n    setEvent(fill[0]);\n    setpopoverShow(!popoverShow);\n    // admin code end\n  };\n  const bookingSlot = (event) => {\n    // booking Event\n    setbookingslot(true);\n    const fill = events.filter((e) => e.id === event.id);\n    setbookingEvent(fill[0]);\n    setBookingstartTime(fill[0].start);\n    setBookingEndTime(fill[0].end);\n\n    /* show time start */\n    let getstart = String(fill[0].start);\n    let getend = String(fill[0].end);\n    getstart = getstart.slice(16, 21);\n    getend = getend.slice(16, 21);\n\n    setBookingstartTimeslice(getstart);\n    setBookingendTimeslice(getend);\n    /* show time End  */\n  };\n  const saveBooking = () => {\n    /* start time*/\n    bookingstartTime = String(bookingstartTime);\n    bookingstartTimeslice = String(bookingstartTimeslice);\n    bookingstartTime = Array.from(bookingstartTime);\n    bookingstartTimeslice = Array.from(bookingstartTimeslice);\n    bookingstartTime[16] = bookingstartTimeslice[0];\n    bookingstartTime[17] = bookingstartTimeslice[1];\n    bookingstartTime[18] = bookingstartTimeslice[2];\n    bookingstartTime[19] = bookingstartTimeslice[3];\n    bookingstartTime[20] = bookingstartTimeslice[4];\n    bookingstartTime = String(bookingstartTime);\n    bookingstartTime = bookingstartTime.replace(/,/g, \"\");\n    bookingstartTime = new Date(bookingstartTime);\n    /* start time*/\n    /* End  time*/\n    bookingEndTime = String(bookingEndTime);\n    bookingendTimeslice = String(bookingendTimeslice);\n    bookingEndTime = Array.from(bookingEndTime);\n    bookingendTimeslice = Array.from(bookingendTimeslice);\n    bookingEndTime[16] = bookingendTimeslice[0];\n    bookingEndTime[17] = bookingendTimeslice[1];\n    bookingEndTime[18] = bookingendTimeslice[2];\n    bookingEndTime[19] = bookingendTimeslice[3];\n    bookingEndTime[20] = bookingendTimeslice[4];\n    bookingEndTime = String(bookingEndTime);\n    bookingEndTime = bookingEndTime.replace(/,/g, \"\");\n    bookingEndTime = new Date(bookingEndTime);\n    /* End time*/\n    let uniqid = Math.random();\n    const newElement = {\n      p_id: bookingEvent.id,\n      id: uniqid,\n      title: bookingTitle,\n      start: bookingstartTime,\n      end: bookingEndTime,\n      color: statusbooking,\n    };\n    if (\n      bookingEvent.start <= bookingstartTime &&\n      bookingEvent.end >= bookingEndTime\n    ) {\n      console.log(\"Add time in array \");\n    } else {\n      setAlertBoxTime(true);\n      setTimeout(function () {\n        setAlertBoxTime(false);\n      }, 1000);\n    }\n  };\n  const statusBookingChange = (event) => {\n    setStatusbooking(event.target.value);\n  };\n  function Alertbox(props) {\n    return (\n      <Alert\n        show={alertBoxTime}\n        variant=\"danger\"\n        onClose={() => setAlertBoxTime(!alertBoxTime)}\n        dismissible\n      >\n        {props.message}\n      </Alert>\n    );\n  }\n  const customDayPropGetter = (date) => {\n    // console.log(getWeekDay(new Date()));\n\n    if (\n      date.getDay() === days[0] ||\n      date.getDay() === days[1] ||\n      date.getDay() === days[2] ||\n      date.getDay() === days[3] ||\n      date.getDay() === days[4] ||\n      date.getDay() === days[5] ||\n      date.getDay() === days[6]\n    )\n      return {\n        className: \"special-day\",\n        style: {\n          backgroundColor: \"#EBEBE4\",\n        },\n      };\n    else return {};\n  };\n  return (\n    <>\n      <div className=\"row \">\n        <div className=\"col-md-2\"></div>\n        <div className=\"col-md-2\"></div>\n        <div className=\"col-md-2\"></div>\n        <div className=\"col-md-6\">\n          <div\n            style={{\n              display: \"flex\",\n              \"flex-direction\": \"row\",\n              \"margin-top\": \"10px\",\n              \"align-items\": \"center\",\n              \"margin-bottom\": \"10px\",\n            }}\n          >\n            <span\n              style={{\n                \"background-color\": \"#FFFF00\",\n                height: \"20px\",\n                width: \"20px\",\n              }}\n            ></span>\n            <span style={{ \"margin-left\": \"10px\" }}>Pending validation</span>\n            <span\n              style={{\n                \"background-color\": \"#808080\",\n                height: \"20px\",\n                width: \"20px\",\n                \"margin-left\": \"10px\",\n              }}\n            ></span>\n            <span style={{ \"margin-left\": \"10px\" }}>Not availble</span>\n            <span\n              style={{\n                \"background-color\": \"#008000\",\n                height: \"20px\",\n                width: \"20px\",\n                \"margin-left\": \"10px\",\n              }}\n            ></span>\n            <span style={{ \"margin-left\": \"10px\" }}>Validate</span>\n            {/* <Button\n              variant=\"primary\"\n              style={{ \"margin-left\": \"auto\", \"margin-right\": \"10px\" }}\n              onClick={() => {\n                setavailabilitieModal(true);\n              }}\n            >\n              Add Availability\n            </Button> */}\n            <div style={{ \"margin-left\": \"auto\", \"margin-right\": \"10px\" }}>\n              <OverLapSelect\n                overlap={overlap}\n                overlapOpen={overlapOpen}\n                handleOpen={handleOverLapOpen}\n                handleClose={handleOverLapClose}\n                handleChange={handleOverLapChange}\n              />\n            </div>\n          </div>\n          <div className=\"Custom_weekdays\">\n            <label>Work week</label>\n            <FormGroup row>\n              <FormControlLabel\n                control={\n                  <Checkbox\n                    checked={workWeekstate.Sunday}\n                    onChange={workWeekHandleChange}\n                    name=\"Sunday\"\n                    color=\"primary\"\n                  />\n                }\n                label=\"Sunday\"\n              />\n              <FormControlLabel\n                control={\n                  <Checkbox\n                    checked={workWeekstate.Monday}\n                    onChange={workWeekHandleChange}\n                    name=\"Monday\"\n                    color=\"primary\"\n                  />\n                }\n                label=\"Monday\"\n              />\n              <FormControlLabel\n                control={\n                  <Checkbox\n                    checked={workWeekstate.Tuesday}\n                    onChange={workWeekHandleChange}\n                    name=\"Tuesday\"\n                    color=\"primary\"\n                  />\n                }\n                label=\"Tuesday\"\n              />\n              <FormControlLabel\n                control={\n                  <Checkbox\n                    checked={workWeekstate.Wednesday}\n                    onChange={workWeekHandleChange}\n                    name=\"Wednesday\"\n                    color=\"primary\"\n                  />\n                }\n                label=\"Wednesday\"\n              />\n              <FormControlLabel\n                control={\n                  <Checkbox\n                    checked={workWeekstate.Thursday}\n                    onChange={workWeekHandleChange}\n                    name=\"Thursday\"\n                    color=\"primary\"\n                  />\n                }\n                label=\"Thursday\"\n              />\n              <FormControlLabel\n                control={\n                  <Checkbox\n                    checked={workWeekstate.Friday}\n                    onChange={workWeekHandleChange}\n                    name=\"Friday\"\n                    color=\"primary\"\n                  />\n                }\n                label=\"Friday\"\n              />\n              <FormControlLabel\n                control={\n                  <Checkbox\n                    checked={workWeekstate.Saturday}\n                    onChange={workWeekHandleChange}\n                    name=\"Saturday\"\n                    color=\"primary\"\n                  />\n                }\n                label=\"Saturday\"\n              />\n            </FormGroup>\n          </div>\n        </div>\n      </div>\n      <Modal show={bookingslot} onHide={() => setbookingslot(false)}>\n        <Modal.Header closeButton>\n          <Modal.Title>Book a slot</Modal.Title>\n        </Modal.Header>\n        <Alertbox message=\"Invalid Time\" />\n        <Modal.Body>\n          <div className=\"row\">\n            <div className=\"col-md-12\">\n              <div className=\"description\">\n                <div class=\"form-group\">\n                  <label for=\"exampleFormControlTextarea1\">Add message</label>\n                  <textarea\n                    class=\"form-control\"\n                    id=\"exampleFormControlTextarea1\"\n                    rows=\"3\"\n                    value={bookingTitle}\n                    onChange={(e) => setBookingTitle(e.target.value)}\n                  ></textarea>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row\">\n            <div className=\"col-md-6\">\n              <div className=\"starttime\">\n                <label>Start time</label>\n                <TimePicker\n                  value={bookingstartTimeslice}\n                  onChange={(e) => setBookingstartTimeslice(e)}\n                  locale=\"sv-sv\"\n                />\n              </div>\n              <div class=\"form-group statusColor\">\n                <label>Status Color </label>\n\n                <FormControl component=\"fieldset\">\n                  <RadioGroup\n                    aria-label=\"statusColor\"\n                    name=\"statusColor\"\n                    value={statusbooking}\n                    onChange={statusBookingChange}\n                  >\n                    <FormControlLabel\n                      value=\"#FFFF00\"\n                      control={\n                        <Radio\n                          color=\"primary\"\n                          onChange={(e) => setStatusbooking(e.target.value)}\n                        />\n                      }\n                      label=\"Pending validation\"\n                      className=\"pending\"\n                    />\n\n                    <FormControlLabel\n                      value=\"#808080\"\n                      control={\n                        <Radio\n                          color=\"primary\"\n                          onChange={(e) => setStatusbooking(e.target.value)}\n                        />\n                      }\n                      label=\"Not availble\"\n                      className=\"notAvailble\"\n                    />\n                    <FormControlLabel\n                      value=\"#008000\"\n                      control={\n                        <Radio\n                          color=\"primary\"\n                          onChange={(e) => setStatusbooking(e.target.value)}\n                        />\n                      }\n                      label=\"Validate\"\n                      className=\"validate\"\n                    />\n                  </RadioGroup>\n                </FormControl>\n              </div>\n            </div>\n            <div className=\"col-md-6\">\n              <div className=\"endTime\">\n                <label>End Time</label>\n                <TimePicker\n                  value={bookingendTimeslice}\n                  onChange={(e) => setBookingendTimeslice(e)}\n                  locale=\"sv-sv\"\n                />\n              </div>\n            </div>\n          </div>\n        </Modal.Body>\n        <Modal.Footer>\n          <Button variant=\"primary\" onClick={saveBooking}>\n            Add Booking\n          </Button>\n          <Button variant=\"secondary\" onClick={() => setbookingslot(false)}>\n            Close\n          </Button>\n        </Modal.Footer>\n      </Modal>\n      <Modal show={show} onHide={() => setShow(false)}>\n        <Modal.Header closeButton>\n          <Modal.Title>Add Event</Modal.Title>\n        </Modal.Header>\n        <Alertbox message=\"Please Add valid Time and Event\" />\n        <Modal.Body>\n          <div className=\"row\">\n            <div className=\"col-md-12\">\n              <div className=\"description\">\n                <div class=\"form-group\">\n                  <label for=\"exampleFormControlTextarea1\">Add Event</label>\n                  <textarea\n                    class=\"form-control\"\n                    id=\"exampleFormControlTextarea1\"\n                    rows=\"3\"\n                    onChange={(e) => setTitle(e.target.value)}\n                  ></textarea>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row\">\n            <div className=\"col-md-6\">\n              <div className=\"starttime\">\n                <label>Start time</label>\n                <TimePicker\n                  value={starttimeslice}\n                  onChange={(e) => setstarttimeslice(e)}\n                  locale=\"sv-sv\"\n                />\n              </div>\n              <div class=\"form-group statusColor\">\n                <label>Status Color </label>\n                <FormControl component=\"fieldset\">\n                  <RadioGroup\n                    aria-label=\"gender\"\n                    name=\"statusColor\"\n                    value={statusColor}\n                    onChange={statusColorChange}\n                  >\n                    <FormControlLabel\n                      value=\"#FFFF00\"\n                      control={\n                        <Radio\n                          color=\"primary\"\n                          onChange={(e) => setStatusColor(e.target.value)}\n                        />\n                      }\n                      label=\"Pending validation\"\n                      className=\"pending\"\n                    />\n                    <FormControlLabel\n                      value=\"#808080\"\n                      control={\n                        <Radio\n                          color=\"primary\"\n                          onChange={(e) => setStatusColor(e.target.value)}\n                        />\n                      }\n                      label=\"Not availble\"\n                      className=\"notAvailble\"\n                    />\n                    <FormControlLabel\n                      value=\"#008000\"\n                      control={\n                        <Radio\n                          color=\"primary\"\n                          onChange={(e) => setStatusColor(e.target.value)}\n                        />\n                      }\n                      label=\"Validate\"\n                      className=\"validate\"\n                    />\n                  </RadioGroup>\n                </FormControl>\n              </div>\n            </div>\n            <div className=\"col-md-6\">\n              <div className=\"endTime\">\n                <label>End Time</label>\n                <TimePicker\n                  value={Endtimeslice}\n                  onChange={(e) => setEndtimeslice(e)}\n                  locale=\"sv-sv\"\n                />\n              </div>\n            </div>\n          </div>\n        </Modal.Body>\n        <Modal.Footer>\n          <Button variant=\"primary\" onClick={saveEvent}>\n            Save Event\n          </Button>\n          <Button variant=\"secondary\" onClick={handleClose}>\n            Close\n          </Button>\n        </Modal.Footer>\n      </Modal>\n      <Modal show={showEdit} onHide={() => setShowEdit(false)}>\n        <Modal.Header closeButton>\n          <Modal.Title>Edit Event </Modal.Title>\n        </Modal.Header>\n        <Alertbox message=\"Please Add valid Time and Event\" />\n        <Modal.Body>\n          <div className=\"row\">\n            <div className=\"col-md-12\">\n              <div className=\"description\">\n                <div class=\"form-group\">\n                  <label for=\"exampleFormControlTextarea1\">Edit Event</label>\n                  <textarea\n                    class=\"form-control\"\n                    id=\"exampleFormControlTextarea1\"\n                    rows=\"3\"\n                    value={titleEdit}\n                    onChange={(e) => setTitleEdit(e.target.value)}\n                  ></textarea>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row\">\n            <div className=\"col-md-6\">\n              <div className=\"starttime\">\n                <label>Start time</label>\n                <TimePicker\n                  value={starttimesliceEdit}\n                  onChange={(e) => setstarttimesliceEdit(e)}\n                  locale=\"sv-sv\"\n                />\n              </div>\n              <div class=\"form-group statusColor\">\n                <label>Status Color </label>\n                <FormControl component=\"fieldset\">\n                  <RadioGroup\n                    aria-label=\"statusColor\"\n                    name=\"statusColor\"\n                    value={statusColorEdit}\n                    onChange={statusColorChange}\n                  >\n                    <FormControlLabel\n                      value=\"#FFFF00\"\n                      control={\n                        <Radio\n                          color=\"primary\"\n                          onChange={(e) => setStatusColorEdit(e.target.value)}\n                        />\n                      }\n                      label=\"Pending validation\"\n                      className=\"pending\"\n                    />\n                    <FormControlLabel\n                      value=\"#808080\"\n                      control={\n                        <Radio\n                          color=\"primary\"\n                          onChange={(e) => setStatusColorEdit(e.target.value)}\n                        />\n                      }\n                      label=\"Not availble\"\n                      className=\"notAvailble\"\n                    />\n                    <FormControlLabel\n                      value=\"#008000\"\n                      control={\n                        <Radio\n                          color=\"primary\"\n                          onChange={(e) => setStatusColorEdit(e.target.value)}\n                        />\n                      }\n                      label=\"Validate\"\n                      className=\"validate\"\n                    />\n                  </RadioGroup>\n                </FormControl>\n              </div>\n            </div>\n            <div className=\"col-md-6\">\n              <div className=\"endTime\">\n                <label>End Time</label>\n                <TimePicker\n                  value={endtimesliceEdit}\n                  onChange={(e) => setEndtimesliceEdit(e)}\n                  locale=\"sv-sv\"\n                />\n              </div>\n            </div>\n          </div>\n        </Modal.Body>\n        <Modal.Footer>\n          <Button variant=\"primary\" onClick={updateEvent}>\n            Update Event\n          </Button>\n          <Button variant=\"secondary\" onClick={() => setShowEdit(false)}>\n            Close\n          </Button>\n        </Modal.Footer>\n      </Modal>\n\n      <div>\n        <PopoverModal\n          popoverShow={popoverShow}\n          handlePopoverClose={handlePopoverClose}\n          handleDeleteEvent={handleDeleteEvent}\n          handleEditEvent={handleEditEvent}\n          event={event}\n        />\n\n        <Calendar\n          popup\n          selectable\n          formats={formats}\n          localizer={localizer}\n          events={events}\n          views={view}\n          step={60}\n          timeslots={1}\n          // onSelectEvent={handlePopoverShow}\n          onSelectEvent={bookingSlot}\n          onSelecting={false}\n          onSelectSlot={AddEvent}\n          // onSelectSlot={AddAvailability}\n          startAccessor=\"start\"\n          endAccessor=\"end\"\n          style={{\n            width: \"99%\",\n            padding: \"0px 10px\",\n            height: \"470px\",\n          }}\n          eventPropGetter={(events, start, end, isSelected) => {\n            let newStyle = {\n              backgroundColor: events[\"color\"],\n              color: \"black\",\n              borderRadius: \"0px\",\n              border: \"none\",\n            };\n\n            if (events.isMine) {\n              newStyle.backgroundColor = \"lightgreen\";\n            }\n\n            return {\n              className: \"\",\n              style: newStyle,\n            };\n          }}\n          messages={{\n            date: \"Date\",\n            time: \"Time\",\n            event: \"Event\",\n            allDay: \"All Day\",\n            week: \"week\",\n            work_week: \"Work Week\",\n            day: \"Day\",\n            month: \"Month\",\n            previous: \"Previous\",\n            next: \"Next\",\n            yesterday: \"Yesterday\",\n            tomorrow: \"Tomorrow\",\n            today: \"Today\",\n            agenda: \"Agenda\",\n            noEventsInRange: \"There are no events in this range.\",\n            showMore: function (e) {\n              return \"+\" + e + \" more\";\n            },\n          }}\n          custom_week_days={days}\n          dayPropGetter={customDayPropGetter}\n        />\n      </div>\n    </>\n  );\n};\n\nexport default Calender;\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/index.js",["465"],"import React from \"react\";\nimport { Switch, Route, Redirect } from \"react-router-dom\";\nimport AddMean from \"./AddMean\";\nimport Mean from \"./Means\";\nimport EditMean from \"./EditMean\";\nimport Historic from \"./Historic\";\n\nexport default function Index(props) {\n  console.log(props.match.path + \"/add-mean\");\n  return (\n    <Switch>\n      {console.log(props.match.path)}\n      <Route exact path={props.match.path + \"/\"} component={Mean} />\n      <Route exact path={props.match.path + \"/add-mean\"} component={AddMean} />\n      <Route\n        exact\n        path={props.match.path + \"/edit-mean\"}\n        component={EditMean}\n      />\n      {/* <Route exact path={props.match.path + \"/add-site\"} component={AddSite} /> */}\n      {/* <Route\n        exact\n        path={props.match.path + \"/archives\"}\n        component={ArchivedSites}\n      /> */}\n      <Redirect from=\"*\" to={props.match.path + \"/\"} />\n    </Switch>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Organigramme/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Pic/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Admins/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/redux/actions/actionTypes.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/redux/utility.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/SmallText.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Heading.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/SubHeading.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/FormInput.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/FormSelect.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/SearchInput.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Button.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Table.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Form.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/globals/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/Historic.js",["466","467","468","469","470","471","472","473","474","475","476","477","478","479"],"import React, { useState, useEffect } from \"react\";\nimport GLOBALS from \"../../../globals\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\nimport * as Yup from \"yup\";\n\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport Actions from \"../../../redux/actions\";\n\nimport { useFormik } from \"formik\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\n// import Actions from \"../../../redux/actions\";\n\nimport Form from \"../../../components/Form\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport SubHeading from \"../../../components/SubHeading\";\nimport SmallButton from \"../../../components/SmallButton\";\nimport SearchInput from \"../../../components/SearchInput\";\nimport FormInput from \"../../../components/FormInput\";\n\nimport SiteImage from \"../../../assets/images/Site.png\";\nimport { Images } from \"../../../assets/Assets\";\n\nimport { ReactComponent as Pencil } from \"../../../assets/icons/Pencil.svg\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n  link: {\n    marginRight: 20,\n    whiteSpace: \"nowrap\",\n    color: theme.palette.primary.contrastText,\n  },\n  image: {\n    height: 70,\n    borderRadius: theme.shape.borderRadius,\n  },\n}));\n\nconst addClientYup = Yup.object().shape({\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\n  name: Yup.string().required(\"Required\"),\n  color: Yup.string().required(\"Required\"),\n  firstName: Yup.string().required(\"Required\"),\n  lastName: Yup.string().required(\"Required\"),\n  email: Yup.string().required(\"Required\"),\n  phone: Yup.number()\n    .test(\n      \"len\",\n      \"Must be exactly 10 characters\",\n      (val) => val && val.toString().length === 10,\n    )\n    .required(\"Required\"),\n  contractType: Yup.string().required(\"Required\"),\n  contractStartDate: Yup.string().required(\"Required\"),\n  contractEndDate: Yup.string().required(\"Required\"),\n  functionality: Yup.string().required(\"Required\"),\n  additionalInfo: Yup.string(),\n  notificationPriorToDays: Yup.number(),\n  notificationTo: Yup.array(),\n});\n\nconst Historic = () => {\n  const classes = useStyles();\n  const theme = useTheme();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n\n  const [loading, setLoading] = useState(true);\n  const [items, setItems] = useState([]);\n  const [page] = useState(1);\n\n  useEffect(() => {\n    fetchData();\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const result = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.SITES}?page=${page}`,\n      });\n      setItems(result.data.items);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const rows = GLOBALS.Data.meansOfHistoric.items.map((item) => {\n    return [...item];\n  });\n\n  async function onArchive(itemId) {\n    try {\n      if (window.confirm(\"Are you sure, you want to do this?\")) {\n        setLoading(true);\n        await GLOBALS.API({\n          method: \"PUT\",\n          token: store.token,\n          uri: GLOBALS.Constants.SITE_ARCHIVE + \"/\" + itemId,\n        });\n        const itemsArray = items.filter((item) => item._id !== itemId);\n        setItems(itemsArray);\n        setLoading(false);\n      }\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const formik = useFormik({\n    initialValues: {\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    // validationSchema: addClientYup,\n    // onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  return (\n    <div className={classes.root}>\n      <Form.Row alignItems=\"center\">\n        <Heading primary=\"LIST OF MEANS - HISTORIC\" noWrap />\n        <div>\n          <Form.Row\n            alignItems=\"flex-start\"\n            noMargin\n            justifyContent=\"flex-end\"\n            style={{ paddingRight: \"50px\" }}\n          >\n            <Form.Column style={{ width: \"50%\", marginRight: \"50px\" }}>\n              <img src={Images.site} alt=\"\" />\n            </Form.Column>\n          </Form.Row>\n        </div>\n      </Form.Row>\n      <Form.Row alignItems=\"center\" noMargin>\n        <Form.Row justifyContent=\"flex-start\" noMargin>\n          {/* <SearchInput\n            placeholder=\"Site name\"\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          /> */}\n          <FormSelect\n            placeholder=\"Company\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n          <FormSelect\n            placeholder=\"Mean\"\n            values={[\n              { value: \"green\", label: \"Green\" },\n              { value: \"Yellow\", label: \"Yellow\" },\n              { value: \"Red\", label: \"Red\" },\n              { value: \"Blue\", label: \"Blue\" },\n              { value: \"Orange\", label: \"Orange\" },\n              { value: \"Purple\", label: \"Purple\" },\n              { value: \"Magenta\", label: \"Magenta\" },\n            ]}\n            style={{ marginRight: \"20px\", maxWidth: 250 }}\n          />\n        </Form.Row>\n        {/* <NavLink className={classes.link} to=\"/sites/archives\">\n          See archived sites\n        </NavLink> */}\n      </Form.Row>\n      <div className={classes.content}>\n        <Table headers={GLOBALS.Data.meansOfHistoric.headings} rows={rows} />\n      </div>\n    </div>\n  );\n};\n\nexport default Historic;\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/AddMean.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/EditMean.js",["480","481","482","483","484","485"],"import React , { useState, useEffect }from \"react\";\nimport { useFormik } from \"formik\";\nimport { useSelector } from \"react-redux\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport * as Yup from \"yup\";\nimport { NavLink } from \"react-router-dom\";\n\nimport GLOBALS from \"../../../globals\";\nimport Form from \"../../../components/Form\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport SmallText from \"../../../components/SmallText\";\nimport FormLabel from \"../../../components/FormLabel\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport RadioButton from \"../../../components/RadioButton\";\nimport MultiAdderInput from \"../../../components/MultiAdderInput\";\nimport FormMultipleUpload from \"../../../components/FormMultipleUpload\";\nimport { ReactComponent as BackArrow } from \"../../../assets/icons/BackArrow.svg\";\nimport MultiAdderInputModal from \"../../../components/MultiAdderInputModal\";\nimport { Images } from \"../../../assets/Assets\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n  },\n}));\n\nconst addClientYup = Yup.object().shape({\n  logo: Yup.array().min(1, \"Required\").required(\"Required\"),\n  name: Yup.string().required(\"Required\"),\n  color: Yup.string().required(\"Required\"),\n  firstName: Yup.string().required(\"Required\"),\n  lastName: Yup.string().required(\"Required\"),\n  email: Yup.string().required(\"Required\"),\n  phone: Yup.number()\n    .test(\n      \"len\",\n      \"Must be exactly 10 characters\",\n      (val) => val && val.toString().length === 10,\n    )\n    .required(\"Required\"),\n  contractType: Yup.string().required(\"Required\"),\n  contractStartDate: Yup.string().required(\"Required\"),\n  contractEndDate: Yup.string().required(\"Required\"),\n  functionality: Yup.string().required(\"Required\"),\n  additionalInfo: Yup.string(),\n  notificationPriorToDays: Yup.number(),\n  notificationTo: Yup.array(),\n});\n\nexport default function EditMean(props) {\n    const [addresses, setAddresses] = useState([]);\n    const [update, setUpdate] = useState(false);\n\n\n  const classes = useStyles();\n  const store = useSelector((state) => state.auth);\n\n  const onSubmit = async (values) => {\n    const notificationTo = values.notificationTo.map((item) => item.label);\n\n    var formdata = new FormData();\n    formdata.append(\"logo\", values.logo[0].file);\n    formdata.append(\"name\", values.name);\n    formdata.append(\"color\", values.color);\n    formdata.append(\"firstName\", values.firstName);\n    formdata.append(\"lastName\", values.lastName);\n    formdata.append(\"email\", values.email);\n    formdata.append(\"phone\", values.phone);\n    formdata.append(\"contractType\", values.contractType);\n    formdata.append(\"contractStartDate\", values.contractStartDate);\n    formdata.append(\"contractEndDate\", values.contractEndDate);\n    formdata.append(\"functionality\", values.functionality);\n    formdata.append(\"additionalInfo\", values.additionalInfo);\n    formdata.append(\"notificationPriorToDays\", values.notificationPriorToDays);\n    formdata.append(\"notificationTo\", JSON.stringify(notificationTo));\n\n    await GLOBALS.API({\n      method: \"POST\",\n      uri: GLOBALS.Constants.CLIENTS,\n      headers: {\n        Authorization: store.token,\n      },\n      body: formdata,\n    });\n    formik.setSubmitting(false);\n    props.history.push(\"/clients\");\n  };\n\n  const formik = useFormik({\n    initialValues: {\n      logo: [],\n      name: \"\",\n      color: \"\",\n      firstName: \"\",\n      lastName: \"\",\n      email: \"\",\n      phone: \"\",\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    validationSchema: addClientYup,\n    onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  function handleChange(name, value) {\n    if (name === \"addresses\") {\n      setUpdate((st) => !st);\n      setAddresses(value);\n    } \n  }\n\n\n  return (\n    <div className={classes.root}>\n      <Form.Row>\n      <IconButton onClick={() => props.history.goBack()}>\n        <BackArrow style={{ width: 30, height: 30 }} />\n\n      </IconButton>\n      <div className=\"text-center pr-5\">\n      <img src={Images.profile2} />\n      <div>Thierry Marles</div>\n      </div>\n\n      </Form.Row>\n      <Form.Row>\n      <Heading primary=\"EDIT A MEAN\" />\n      <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"EDIT LOCATION\"\n                to={\"/means/add-mean\"}\n                style={{\n                  marginRight: \"100px\",\n                  marginBottom: \"7px\",\n                  width: \"320px\",\n                  textAlign: \"left\",\n                  backgroundColor: \"#140772\"\n                }}\n              />\n\n      </Form.Row>\n      <div className={classes.content}>\n        <Form.Form onSubmit={formik.handleSubmit}>\n          <Form.Row >\n            <FormLabel bold primary=\"IDENTITY : \" />\n            <Form.Row noMargin width=\"65%\" style={{gap: \"20px\"}}>\n            <FormInput\n              name=\"name\"\n              style={GLOBALS.Styles.inputWidth}\n              placeholder=\"Company name\"\n              onChange={formik.handleChange}\n              value={formik.values.name}\n              error={formik.errors.name}\n            />\n             <FormSelect\n                placeholder=\"Type\"\n                name=\"color\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={formik.handleChange}\n                value={formik.values.color}\n                error={formik.errors.color}\n                values={[\n                  { value: \"green\", label: \"Green\" },\n                  { value: \"Yellow\", label: \"Yellow\" },\n                  { value: \"Red\", label: \"Red\" },\n                  { value: \"Blue\", label: \"Blue\" },\n                  { value: \"Orange\", label: \"Orange\" },\n                  { value: \"Purple\", label: \"Purple\" },\n                  { value: \"Magenta\", label: \"Magenta\" },\n                ]}\n              />\n               <FormSelect\n                placeholder=\"color\"\n                name=\"color\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={formik.handleChange}\n                value={formik.values.color}\n                error={formik.errors.color}\n                values={[\n                  { value: \"green\", label: \"Green\" },\n                  { value: \"Yellow\", label: \"Yellow\" },\n                  { value: \"Red\", label: \"Red\" },\n                  { value: \"Blue\", label: \"Blue\" },\n                  { value: \"Orange\", label: \"Orange\" },\n                  { value: \"Purple\", label: \"Purple\" },\n                  { value: \"Magenta\", label: \"Magenta\" },\n                ]}\n              />\n              <FormMultipleUpload\n                name=\"logo\"\n                style={GLOBALS.Styles.inputWidth}\n                error={formik.errors.logo}\n                values={formik.values.logo}\n                onChange={(values) =>\n                  formik.handleChange({\n                    target: {\n                      type: \"text\",\n                      name: \"logo\",\n                      value: values,\n                    },\n                  })\n                }\n              />\n            </Form.Row>\n           \n          </Form.Row>\n\n          <Form.Row>\n          <FormLabel bold primary=\"\" />\n          <Form.Row noMargin width=\"65%\">\n          <MultiAdderInputModal\n            name=\"addresses\"\n            values={addresses}\n            // error={addresses}\n            style={GLOBALS.Styles.inputWidth}\n            placeholder=\"Enter site addresses\"\n            onChange={(values) => handleChange(\"addresses\", values)}\n          />\n          </Form.Row>\n        </Form.Row>\n\n        <Form.Row>\n            <FormLabel bold primary=\"DISPONIBILITE : \" />\n            <Form.Row noMargin width=\"65%\" justifyContent=\"flex-start\" style={{gap: \"20px\"}}>\n              <FormInput\n                type=\"date\"\n                style={{width: \"300px\"}}\n                placeholder=\"Date de début\"\n                name=\"contractStartDate\"\n                onChange={formik.handleChange}\n                value={formik.values.contractStartDate}\n                error={formik.errors.contractStartDate}\n              />\n              <FormInput\n                type=\"date\"\n                placeholder=\"Date de fin\"\n                style={{width: \"300px\"}}\n                name=\"contractEndDate\"\n                onChange={formik.handleChange}\n                value={formik.values.contractEndDate}\n                error={formik.errors.contractEndDate}\n              />\n            </Form.Row>\n          </Form.Row>\n\n\n          <Form.Row>\n            <FormLabel bold primary=\"FICHE TECHNIQUE : \" />\n            <Form.Row noMargin width=\"65%\">\n              <FormMultipleUpload\n                name=\"logo\"\n                style={GLOBALS.Styles.inputWidth}\n                error={formik.errors.logo}\n                values={formik.values.logo}\n                onChange={(values) =>\n                  formik.handleChange({\n                    target: {\n                      type: \"text\",\n                      name: \"logo\",\n                      value: values,\n                    },\n                  })\n                }\n              />\n              \n            </Form.Row>\n          </Form.Row>\n\n          <Form.Row>\n            <FormLabel bold primary=\"INDISPONIBILITES : \" />\n            <Form.Row noMargin width=\"65%\">\n            <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"VOIR LES INDISPONIBILITÉS\"\n                to={\"/means/add-mean\"}\n                style={{\n                  marginLeft: \"0px\",\n                  marginBottom: \"7px\",\n                  width: \"320px\",\n                  textAlign: \"center\",\n                  backgroundColor: \"#140772\"\n                }}\n              />\n              \n            </Form.Row>\n          </Form.Row>\n\n\n         \n         \n          \n          \n         \n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"TARIF HORAIRE : \" />\n           <Form.Row noMargin width=\"65%\">\n           <FormInput\n              textArea\n              rows={1}\n              style={{width: \"300px\", textAlign: \"right\"}}\n              onChange={formik.handleChange}\n              placeholder=\"€\"\n              name=\"additionalInfo\"\n              value={formik.values.additionalInfo}\n              error={formik.errors.additionalInfo}\n            />\n           </Form.Row>\n          </Form.Row>\n\n          <Form.Row alignItems=\"flex-start\">\n            <FormLabel bold primary=\"INFORMATIONS COMPLÉMENTAIRES : \" />\n           <Form.Row noMargin width=\"65%\">\n           <FormInput\n              textArea\n              rows={3}\n              style={{width: \"600px\"}}\n              onChange={formik.handleChange}\n              placeholder=\"Informations complémentaires\"\n              name=\"additionalInfo\"\n              value={formik.values.additionalInfo}\n              error={formik.errors.additionalInfo}\n            />\n           </Form.Row>\n          </Form.Row>\n          \n         \n          <Form.Row>\n          <Form.ButtonContainer style={{width: \"80%\"}}>\n            <Button\n              type=\"submit\"\n              minWidth={200}\n              text=\"VALIDATE\"\n              fullWidth={false}\n              loading={formik.isSubmitting}\n              disabled={formik.isSubmitting}\n            />\n          </Form.ButtonContainer>\n          </Form.Row>\n        </Form.Form>\n      </div>\n    </div>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Organigramme/Organigramme.js",["486","487","488"],"import React, { useState, useEffect } from \"react\";\nimport { NavLink } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n// import * as Yup from \"yup\";\n\nimport GLOBALS from \"../../../globals\";\nimport Actions from \"../../../redux/actions\";\nimport { Images } from \"../../../assets/Assets\";\n\nimport Form from \"../../../components/Form\";\nimport Modal from \"../../../components/Modal\";\nimport Table from \"../../../components/Table\";\nimport Button from \"../../../components/Button\";\nimport Heading from \"../../../components/Heading\";\nimport FormInput from \"../../../components/FormInput\";\nimport FormSelect from \"../../../components/FormSelect\";\nimport AvatarUpload from \"../../../components/AvatarUpload\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    padding: GLOBALS.Styles.pagePadding,\n  },\n  content: {\n    overflow: \"hidden\",\n    borderRadius: theme.shape.borderRadius,\n    padding: GLOBALS.Styles.pageContentPadding,\n    marginTop: GLOBALS.Styles.pageContentMargin,\n    backgroundColor: theme.palette.secondary.main,\n  },\n}));\n\n// const updateAdminYup = Yup.object().shape({\n//   email: Yup.string().required(\"Required\"),\n//   phone: Yup.number()\n//     .test(\n//       \"len\",\n//       \"Must be exactly 10 characters\",\n//       (val) => val && val.toString().length === 10,\n//     )\n//     .required(\"Required\"),\n//   image: Yup.object().optional(\"\"),\n//   companyId: Yup.string().required(\"Required\"),\n// });\n\nexport default function Organigramme() {\n  const theme = useTheme();\n  const classes = useStyles();\n  const dispatch = useDispatch();\n  const store = useSelector((state) => state.auth);\n  const [open, setOpen] = useState(false);\n  const [page] = useState(1);\n  const [items, setItems] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [companies, setCompanies] = useState([]);\n\n  const [modal, setModal] = useState(false);\n  const [selectedItem] = useState(\"\");\n\n  const [firstName, setFirstName] = useState(\"\");\n  const [lastName, setLastName] = useState(\"\");\n  const [phone, setPhone] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [companyId, setCompanyId] = useState(\"\");\n  const [companyName] = useState(\"\");\n\n  useEffect(() => {\n    fetchData();\n    console.log(\"items\", items);\n    // eslint-disable-next-line\n  }, []);\n\n  async function fetchData() {\n    try {\n      const admins = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.ADMINS}?page=${page}`,\n      });\n      const companies = await GLOBALS.API({\n        uri: `${GLOBALS.Constants.COMPANY}`,\n      });\n\n      const companiesArray = [];\n      companies.data.items.map((item) => {\n        if (!item.adminId) {\n          companiesArray.push({\n            value: item._id,\n            label: item.name,\n          });\n        }\n        return true;\n      });\n\n      setItems(admins.data.items);\n      setCompanies(companiesArray);\n      setLoading(false);\n    } catch (err) {\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  }\n\n  const handleChange = (name, value) => {\n    if (name === \"firstName\") setFirstName(value);\n    else if (name === \"lastName\") setLastName(value);\n    else if (name === \"phone\") setPhone(value);\n    else if (name === \"image\") setImage(value);\n    else if (name === \"companyId\") setCompanyId(value);\n  };\n\n  const onUpdate = async (e) => {\n    try {\n      e.preventDefault();\n      setLoading(true);\n      var formdata = new FormData();\n      formdata.append(\"firstName\", firstName);\n      formdata.append(\"lastName\", lastName);\n      formdata.append(\"phone\", phone);\n      formdata.append(\"companyId\", companyId);\n      formdata.append(\"userId\", selectedItem._id);\n      image.file && formdata.append(\"image\", image.file);\n\n      const result = await GLOBALS.API({\n        method: \"PUT\",\n        uri: GLOBALS.Constants.ADMINS,\n        headers: {\n          Authorization: store.token,\n        },\n        body: formdata,\n      });\n      const itemsArray = items.map((item) =>\n        item._id === selectedItem._id ? result.data : item,\n      );\n      setItems(itemsArray);\n      setLoading(false);\n      setModal(false);\n    } catch (err) {\n      setLoading(false);\n      dispatch(\n        Actions.notistack.enqueueSnackbar(\n          Actions.notistack.snackbar(err.message, \"error\"),\n        ),\n      );\n    }\n  };\n  const handleClickOpen = () => {\n    setOpen(true);\n  };\n  const rows = GLOBALS.Data.oranigramme.items.map((item) => {\n    return [\n      <img src={Images.avatar} style={{ width: 50, height: 50 }} />,\n      ...item,\n    ];\n  });\n\n  const modalHandler = (btn) => {\n    setOpen(btn);\n  };\n  return (\n    <>\n      <div className={classes.root}>\n        <Form.Row alignItems=\"center\">\n          <Heading primary=\"ORGANNIGRAMME\" noWrap />\n          <div>\n            <Form.Row alignItems=\"center\" noMargin>\n              <Button\n                fullWidth={false}\n                component={NavLink}\n                text=\"ADD A CONTACT\"\n                style={{ marginLeft: \"20px\" }}\n                to={\"/organigramme/add-contact\"}\n              />\n            </Form.Row>\n          </div>\n        </Form.Row>\n        <Form.Row noMargin>\n          <Form.Row style={{ justifyContent: \"flex-start\" }} noMargin>\n            <Button\n              fullWidth={false}\n              component={NavLink}\n              text=\"SITE ORGANIGAMME\"\n              style={{\n                marginLeft: \"20px\",\n                backgroundColor: \"#140772\",\n              }}\n              to={\"/\"}\n            />\n            <Button\n              fullWidth={false}\n              component={NavLink}\n              text=\"LOGISTIC ORGANIGAMME\"\n              style={{\n                marginLeft: \"20px\",\n                backgroundColor: \"#fff\",\n                border: \"1px solid #707070\",\n              }}\n              textColor=\"#7E7878\"\n              to={\"/\"}\n            />\n          </Form.Row>\n        </Form.Row>\n        <div className={classes.content}>\n          <Table\n            headers={GLOBALS.Data.oranigramme.headings}\n            rows={rows}\n            modalHandler={modalHandler}\n          />\n        </div>\n      </div>\n      <Modal\n        title=\"THIERRY MARLES\"\n        open={open}\n        onClose={() => modalHandler(false)}\n        body={\n          <Form.Form onSubmit={onUpdate}>\n            <Form.Row justifyContent=\"center\">\n              <AvatarUpload\n                value={image}\n                // error={image}\n                onChange={(file) => {\n                  const uri = URL.createObjectURL(file);\n                  handleChange(\"image\", { file, uri });\n                }}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"firstName\"\n                value={firstName}\n                // error={firstName}\n                placeholder=\"First Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"lastName\"\n                value={lastName}\n                // error={lastName}\n                placeholder=\"Last Name\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormInput\n                name=\"phone\"\n                placeholder=\"Phone Number\"\n                value={phone}\n                // error={phone}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n                style={GLOBALS.Styles.inputWidth}\n              />\n            </Form.Row>\n            <Form.Row justifyContent=\"center\">\n              <FormSelect\n                name=\"companyId\"\n                value={companyId}\n                // error={companyId}\n                values={companies}\n                placeholder={companyName}\n                style={GLOBALS.Styles.inputWidth}\n                onChange={({ target: { name, value } }) =>\n                  handleChange(name, value)\n                }\n              />\n            </Form.Row>\n            <Form.Column alignItems=\"center\">\n              <Form.Row justifyContent=\"center\">\n                <Button\n                  type=\"submit\"\n                  minWidth={200}\n                  text=\"VALIDATE\"\n                  fullWidth={false}\n                  loading={loading}\n                  disabled={\n                    loading ||\n                    !firstName ||\n                    !lastName ||\n                    !phone ||\n                    image === \"\" ||\n                    !companyId\n                  }\n                />\n              </Form.Row>\n              <Form.Row justifyContent=\"center\">\n                <Button\n                  text=\"DELETE\"\n                  minWidth=\"30%\"\n                  fullWidth={false}\n                  disabled={loading || true}\n                  color={theme.palette.error.main}\n                />\n              </Form.Row>\n            </Form.Column>\n          </Form.Form>\n        }\n      />\n    </>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Means/Means.js",["489","490","491","492","493","494","495","496","497","498","499","500","501","502","503","504","505","506","507","508","509","510","511","512","513","514","515","516","517","518","519","520","521","522","523"],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Organigramme/AddContact.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Pic/Pic.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/ArchivedSites.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/ZACs.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Admins/AddAdmin.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/Sites.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Admins/Admins.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/VerifyClient.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/AddInvoice.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/Invoices.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/Clients.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Clients/AddClient.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddZAC.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/AddCompanies.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/EditCompanies.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/Companies.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/AddUser.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Companies/UserList.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Calender/components/overlapSelect.js",["524"],"import React from \"react\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport InputLabel from \"@material-ui/core/InputLabel\";\nimport MenuItem from \"@material-ui/core/MenuItem\";\nimport FormControl from \"@material-ui/core/FormControl\";\nimport Select from \"@material-ui/core/Select\";\nimport Button from \"@material-ui/core/Button\";\n\nconst useStyles = makeStyles((theme) => ({\n  button: {\n    display: \"block\",\n    marginTop: theme.spacing(0),\n  },\n  formControl: {\n    minWidth: 170,\n    marginTop: theme.spacing(-2),\n  },\n}));\n\nexport default function ControlledOpenSelect({\n  overlap,\n  overlapOpen,\n  handleOpen,\n  handleClose,\n  handleChange,\n}) {\n  const classes = useStyles();\n\n  return (\n    <div>\n      <FormControl className={classes.formControl}>\n        <InputLabel id=\"demo-controlled-open-select-label\">Overlap</InputLabel>\n        <Select\n          labelId=\"demo-controlled-open-select-label\"\n          id=\"demo-controlled-open-select\"\n          open={overlapOpen}\n          onClose={handleClose}\n          onOpen={handleOpen}\n          value={overlap}\n          onChange={handleChange}\n        >\n          <MenuItem value=\"Enable\">Enable</MenuItem>\n          <MenuItem value=\"Disable\">Disable</MenuItem>\n        </Select>\n      </FormControl>\n    </div>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Calender/components/MyWorkWeek.js",["525"],"import PropTypes from \"prop-types\";\nimport React from \"react\";\nimport Week from \"react-big-calendar/lib/Week\";\nimport TimeGrid from \"react-big-calendar/lib/TimeGrid\";\n\nfunction workWeekRange(date, options, custom_week_days) {\n  if (custom_week_days == undefined) {\n    return Week.range(date, options).filter(\n      (d) => [0, 1].indexOf(d.getDay()) === -1\n    );\n  } else {\n    return Week.range(date, options).filter(\n      (d) => custom_week_days.indexOf(d.getDay()) === -1\n    );\n  }\n}\n\nclass MyWorkWeek extends React.Component {\n  render() {\n    let { custom_week_days, date, ...props } = this.props;\n    let range = workWeekRange(date, this.props, custom_week_days);\n    return <TimeGrid {...props} range={range} eventOffset={15} />;\n  }\n}\n\nMyWorkWeek.propTypes = {\n  date: PropTypes.instanceOf(Date).isRequired,\n};\n\nMyWorkWeek.defaultProps = TimeGrid.defaultProps;\n\nMyWorkWeek.range = workWeekRange;\n\nMyWorkWeek.navigate = Week.navigate;\n\nMyWorkWeek.title = (date, { localizer }) => {\n  let [start, ...rest] = workWeekRange(date, { localizer });\n  return localizer.format({ start, end: rest.pop() }, \"dayRangeHeaderFormat\");\n};\nexport default MyWorkWeek;\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Calender/components/popoverModal.js",["526","527","528","529","530"],"import React from \"react\";\nimport { FontAwesomeIcon } from \"@fortawesome/react-fontawesome\";\nimport Modal from \"react-bootstrap/Modal\";\nimport Button from \"react-bootstrap/Button\";\nimport Card from \"react-bootstrap/Card\";\nimport moment from \"moment\";\nimport \"./sass/custom.scss\";\nvar days = [\n  \"Sunday\",\n  \"Monday\",\n  \"Tuesday\",\n  \"Wednesday\",\n  \"Thursday\",\n  \"Friday\",\n  \"Saturday\",\n];\nconst PopoverModal = ({\n  popoverShow,\n  handlePopoverClose,\n  handleDeleteEvent,\n  handleEditEvent,\n  event,\n}) => {\n  const getStartDate = (start) => {\n    var start = start;\n    var dd = String(start.getDate()).padStart(2, \"0\");\n    var mm = String(start.getMonth() + 1).padStart(2, \"0\"); //January is 0!\n    var yyyy = start.getFullYear();\n    start = mm + \"/\" + dd + \"/\" + yyyy;\n    return start;\n  };\n\n  const getStartTime = (date) => {\n    var dt = moment(date, [\"h:mm A\"]).format(\"HH:mm\");\n    return dt;\n  };\n  if (event) {\n    return (\n      <Modal show={popoverShow} onHide={handlePopoverClose}>\n        <Modal.Header closeButton>\n          <Modal.Title>Event Detail </Modal.Title>\n        </Modal.Header>\n        <Modal.Body>\n          <div className=\"showPopover\">\n            <h5>{event.title}</h5>\n            {/* {console.log(event)} */}\n            <p>\n              {/* {event.start.getDay()}-{event.start.getMonth() + 1}-\n                {event.start.getYear()} */}\n              <h6 style={{ \"font-size\": \"12px\", \"padding-top\": \"10px\" }}>\n                <span>\n                  <b>Start Time:</b> {getStartTime(event.start)}{\" \"}\n                </span>{\" \"}\n                <span>{getStartDate(event.start)}</span>\n                <br />\n                <span>\n                  <b>End Time:</b> {getStartTime(event.end)}{\" \"}\n                </span>{\" \"}\n                <span>{getStartDate(event.end)}</span>\n              </h6>\n            </p>\n\n            <hr />\n            <div className=\"popoverfooter\">\n              <div className=\"col-lg-6\">\n                <button\n                  className=\"btn text-white bg-primary\"\n                  onClick={handleEditEvent}\n                >\n                  <i class=\"fas fa-pencil\"></i> <span>edit</span>\n                </button>\n              </div>\n              <div className=\"col-lg-6\">\n                <button\n                  className=\"btn text-white bg-danger\"\n                  onClick={handleDeleteEvent}\n                >\n                  <i class=\"fas fa-trash\"></i> <span>Delete</span>\n                </button>\n              </div>\n            </div>\n          </div>\n        </Modal.Body>\n      </Modal>\n    );\n  } else {\n    return \"\";\n  }\n};\nexport default PopoverModal;\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/Admin/Calender/components/events.js",["531"],"export default [\n  {\n    id: 0,\n    title: \"All Day Event very long title\",\n    allDay: true,\n    start: new Date(),\n    end: new Date(),\n    color: \"#008000\",\n  },\n  {\n    id: 1,\n    title: \"Long Event\",\n    start: new Date(2021, 2, 24),\n    end: new Date(),\n    color: \"#FFFF00\",\n  },\n  {\n    id: 2,\n    title: \"mubashar is testing an event\",\n    start: new Date(),\n    end: new Date(),\n    color: \"#808080\",\n  },\n  {\n    id: 3,\n    title: \"Big Calendar testing an event\",\n    start: new Date(),\n    end: new Date(),\n    color: \"#008000\",\n  },\n];\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/globals/Constants.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/globals/Styles.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/globals/API.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/MultiAdderInputModal.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/CustomButtonModal.js",["532","533","534","535"],"import React, { useState } from \"react\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n// import * as Yup from \"yup\";\nimport Grid from \"@material-ui/core/Grid\";\nimport Chip from \"@material-ui/core/Chip\";\nimport { useFormik } from \"formik\";\nimport GLOBALS from \"../globals\";\nimport FormSelect from \"../components/FormSelect\";\n\n\n\nimport Form from \"./Form\";\nimport Modal from \"./Modal\";\nimport Button from \"./Button\";\nimport FormInput from \"./FormInput\";\n\nimport { ReactComponent as Plus } from \"../assets/icons/Plus.svg\";\n\n// const addAddressesYup = Yup.object().shape({\n//   street: Yup.string().required(\"Required\"),\n//   city: Yup.string().required(\"Required\"),\n//   postal: Yup.string().required(\"Required\"),\n// });\n\nexport default function CustomButtonModal(props) {\n  const theme = useTheme();\n\n  const error = theme.palette.error.main;\n  const white = theme.palette.common.white;\n  const primaryColor = theme.palette.primary.contrastText;\n  const borderColor = props.error ? error : theme.palette.grey[100];\n\n  const formik = useFormik({\n    initialValues: {\n      logo: [],\n      name: \"\",\n      color: \"\",\n      firstName: \"\",\n      lastName: \"\",\n      email: \"\",\n      phone: \"\",\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    \n    onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  const useStyles = makeStyles((theme) => ({\n    root: {\n      position: \"relative\",\n    },\n    container: {\n      width: 300,\n      height: 45,\n      outline: 0,\n      borderWidth: 1,\n      color: \"#fff\",\n      borderRadius: \"8px\",\n      marginRight: \"100px\",\n      display: \"grid\",\n      cursor: \"pointer\",\n      borderStyle: \"solid\",\n      placeItems: \"center\",\n      backgroundColor: \"#140772\",\n      borderColor: borderColor,\n    },\n    chips: {\n      margin: 0,\n      marginTop: 15,\n      display: \"flex\",\n      flexWrap: \"wrap\",\n      listStyle: \"none\",\n      justifyContent: \"center\",\n    },\n    chip: {\n      color: primaryColor,\n      margin: theme.spacing(0.5),\n    },\n    error: {\n      color: error,\n      fontWeight: 400,\n      position: \"absolute\",\n      fontSize: theme.typography.pxToRem(12),\n    },\n  }));\n\n  const classes = useStyles();\n  const [modal, setModal] = useState(false);\n  const [update, setUpdate] = useState(false);\n\n  const [street, setStreet] = useState(\"\");\n  const [city, setCity] = useState(\"\");\n  const [postal, setPostal] = useState(\"\");\n\n  const handleChange = (name, value) => {\n    if (name === \"street\") setStreet(value);\n    else if (name === \"city\") setCity(value);\n    else if (name === \"postal\") setPostal(value);\n  };\n\n  async function onSubmit() {\n    let newValues = props.values;\n\n    const values = {\n      key: newValues.length,\n      street: street,\n      city: city,\n      postal: postal,\n      label: `${street} ${city} ${postal}`,\n    };\n    newValues.push(values);\n    props.onChange(newValues);\n\n    setUpdate((st) => !st);\n    setModal(false);\n    setStreet(\"\");\n    setCity(\"\");\n    setPostal(\"\");\n  }\n\n  const handleDelete = (value) => () => {\n    const newValues = props.values.filter((chip) => chip.key !== value.key);\n    props.onChange(newValues);\n    setUpdate((st) => !st);\n  };\n\n  return (\n    <>\n      <div className={`${classes.root} ${props.className}`} style={props.style}>\n        <Grid container spacing={2}>\n          <Grid item xs={10}>\n            <div className={classes.container}>\n              <div\n                onClick={() => {\n                  setModal(true);\n                  props.onBlur && props.onBlur();\n                }}\n              >\n                {props.title}\n              </div>\n            </div>\n            {props.error !== \"\" && (\n              <span className={classes.error}>{props.error}</span>\n            )}\n          </Grid>\n          {update && \"\"}\n          <ul className={classes.chips}>\n            {props.values.map((data) => (\n              <li key={data.key}>\n                <Chip\n                  label={data.label}\n                  className={classes.chip}\n                  onDelete={handleDelete(data)}\n                />\n              </li>\n            ))}\n          </ul>\n        </Grid>\n      </div>\n      <Modal\n        title=\"ADD LOCATION\"\n        open={modal}\n        onClose={() => setModal((st) => !st)}\n        body={\n          <Form.Form>\n            \n            <Form.Row>\n            <FormSelect\n                placeholder=\"Storage\"\n                name=\"Storage\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={formik.handleChange}\n                value={formik.values.color}\n                error={formik.errors.color}\n                values={[\n                  { value: \"green\", label: \"Green\" },\n                  { value: \"Yellow\", label: \"Yellow\" },\n                  { value: \"Red\", label: \"Red\" },\n                  { value: \"Blue\", label: \"Blue\" },\n                  { value: \"Orange\", label: \"Orange\" },\n                  { value: \"Purple\", label: \"Purple\" },\n                  { value: \"Magenta\", label: \"Magenta\" },\n                ]}\n              />\n              <FormSelect\n                placeholder=\"Delivery Areas\"\n                name=\"color\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={formik.handleChange}\n                value={formik.values.color}\n                error={formik.errors.color}\n                values={[\n                  { value: \"green\", label: \"Green\" },\n                  { value: \"Yellow\", label: \"Yellow\" },\n                  { value: \"Red\", label: \"Red\" },\n                  { value: \"Blue\", label: \"Blue\" },\n                  { value: \"Orange\", label: \"Orange\" },\n                  { value: \"Purple\", label: \"Purple\" },\n                  { value: \"Magenta\", label: \"Magenta\" },\n                ]}\n              />\n            </Form.Row>\n            \n    \n            <Form.Row justifyContent=\"center\">\n              <Button\n                minWidth={200}\n                text=\"VALIDATE\"\n                fullWidth={false}\n                onClick={onSubmit}\n                disabled={ !formik.values.color}\n              />\n            </Form.Row>\n          </Form.Form>\n        }\n      />\n    </>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/SmallButton.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/AvatarUpload.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/FormMultipleUpload.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/RadioButton.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Modal.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/FormLabel.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep2.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep3.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Stepper.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/AddSite/AddSiteStep1.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/MultiAdderInput.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/UnavailabilityTimes.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/OpeningTimes.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/CustomInputModal.js",["536","537"],"import React, { useState } from \"react\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\n// import * as Yup from \"yup\";\nimport Grid from \"@material-ui/core/Grid\";\nimport Chip from \"@material-ui/core/Chip\";\nimport { useFormik } from \"formik\";\nimport GLOBALS from \"../globals\";\nimport FormSelect from \"../components/FormSelect\";\n\n\n\nimport Form from \"./Form\";\nimport Modal from \"./Modal\";\nimport Button from \"./Button\";\nimport FormInput from \"./FormInput\";\n\nimport { ReactComponent as Plus } from \"../assets/icons/Plus.svg\";\n\n// const addAddressesYup = Yup.object().shape({\n//   street: Yup.string().required(\"Required\"),\n//   city: Yup.string().required(\"Required\"),\n//   postal: Yup.string().required(\"Required\"),\n// });\n\nexport default function CustomInputModal(props) {\n  const theme = useTheme();\n\n  const error = theme.palette.error.main;\n  const white = theme.palette.common.white;\n  const primaryColor = theme.palette.primary.contrastText;\n  const borderColor = props.error ? error : theme.palette.grey[100];\n\n  const formik = useFormik({\n    initialValues: {\n      logo: [],\n      name: \"\",\n      storage: \"\",\n      deliveryAreas:\"\",\n      firstName: \"\",\n      lastName: \"\",\n      email: \"\",\n      phone: \"\",\n      contractType: \"CLIENTPERSITE\",\n      contractStartDate: \"\",\n      contractEndDate: \"\",\n      functionality: \"DELIVERY\",\n      additionalInfo: \"\",\n      notificationPriorToDays: \"\",\n      notificationTo: [],\n    },\n    \n    onSubmit,\n    validateOnBlur: false,\n    validateOnChange: false,\n    validateOnMount: false,\n  });\n\n  const useStyles = makeStyles((theme) => ({\n    root: {\n      position: \"relative\",\n    },\n    container: {\n      width: 45,\n      height: 45,\n      outline: 0,\n      borderWidth: 1,\n      display: \"grid\",\n      cursor: \"pointer\",\n      borderStyle: \"solid\",\n      placeItems: \"center\",\n      backgroundColor: white,\n      borderColor: borderColor,\n    },\n    chips: {\n      margin: 0,\n      marginTop: 15,\n      display: \"flex\",\n      flexWrap: \"wrap\",\n      listStyle: \"none\",\n      justifyContent: \"center\",\n    },\n    chip: {\n      color: primaryColor,\n      margin: theme.spacing(0.5),\n    },\n    error: {\n      color: error,\n      fontWeight: 400,\n      position: \"absolute\",\n      fontSize: theme.typography.pxToRem(12),\n    },\n  }));\n\n  const classes = useStyles();\n  const [modal, setModal] = useState(false);\n  const [update, setUpdate] = useState(false);\n\n  const [street, setStreet] = useState(\"\");\n  const [city, setCity] = useState(\"\");\n  const [postal, setPostal] = useState(\"\");\n\n  const handleChange = (name, value) => {\n    if (name === \"street\") setStreet(value);\n    else if (name === \"city\") setCity(value);\n    else if (name === \"postal\") setPostal(value);\n  };\n\n  async function onSubmit() {\n    let newValues = props.values;\n\n    const values = {\n      key: newValues.length,\n      street: street,\n      city: city,\n      postal: postal,\n      label: `${street} ${city} ${postal}`,\n    };\n    newValues.push(values);\n    props.onChange(newValues);\n\n    setUpdate((st) => !st);\n    setModal(false);\n    setStreet(\"\");\n    setCity(\"\");\n    setPostal(\"\");\n  }\n\n  const handleDelete = (value) => () => {\n    const newValues = props.values.filter((chip) => chip.key !== value.key);\n    props.onChange(newValues);\n    setUpdate((st) => !st);\n  };\n\n  return (\n    <>\n      <div className={`${classes.root} ${props.className}`} style={props.style}>\n        <Grid container spacing={2}>\n          <Grid item xs={4}>\n            <div className={classes.container}>\n              <div\n                onClick={() => {\n                  setModal(true);\n                  props.onBlur && props.onBlur();\n                }}\n              >\n                <Plus style={{ width: 20, height: 20 }} />\n              </div>\n            </div>\n            {props.error !== \"\" && (\n              <span className={classes.error}>{props.error}</span>\n            )}\n          </Grid>\n          {update && \"\"}\n          <ul className={classes.chips}>\n            {props.values.map((data) => (\n              <li key={data.key}>\n                <Chip\n                  label={data.label}\n                  className={classes.chip}\n                  onDelete={handleDelete(data)}\n                />\n              </li>\n            ))}\n          </ul>\n        </Grid>\n      </div>\n      <Modal\n        title=\"ADD LOCATION\"\n        open={modal}\n        onClose={() => setModal((st) => !st)}\n        body={\n          <Form.Form>\n            \n            <Form.Row>\n            <FormSelect\n                placeholder=\"Storage\"\n                name=\"Storage\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={formik.handleChange}\n                value={formik.values.storage}\n                error={formik.errors.storage}\n                values={[\n                  { value: \"green\", label: \"Green\" },\n                  { value: \"Yellow\", label: \"Yellow\" },\n                  { value: \"Red\", label: \"Red\" },\n                  { value: \"Blue\", label: \"Blue\" },\n                  { value: \"Orange\", label: \"Orange\" },\n                  { value: \"Purple\", label: \"Purple\" },\n                  { value: \"Magenta\", label: \"Magenta\" },\n                ]}\n              />\n              <FormSelect\n                placeholder=\"Delivery Areas\"\n                name=\"deliveryAreas\"\n                style={GLOBALS.Styles.inputWidth}\n                onChange={formik.handleChange}\n                value={formik.values.deliveryAreas}\n                error={formik.errors.deliveryAreas}\n                values={[\n                  { value: \"green\", label: \"Green\" },\n                  { value: \"Yellow\", label: \"Yellow\" },\n                  { value: \"Red\", label: \"Red\" },\n                  { value: \"Blue\", label: \"Blue\" },\n                  { value: \"Orange\", label: \"Orange\" },\n                  { value: \"Purple\", label: \"Purple\" },\n                  { value: \"Magenta\", label: \"Magenta\" },\n                ]}\n              />\n            </Form.Row>\n            \n    \n            <Form.Row justifyContent=\"center\">\n              <Button\n                minWidth={200}\n                text=\"VALIDATE\"\n                fullWidth={false}\n                onClick={onSubmit}\n                disabled={ !formik.values.storage || !formik.values.deliveryAreas}\n              />\n            </Form.Row>\n          </Form.Form>\n        }\n      />\n    </>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/CustomFormInput.js",["538"],"import React from \"react\";\nimport { makeStyles, useTheme } from \"@material-ui/core/styles\";\nimport {Images} from \"../assets/Assets\";\n\nexport default function Input(props) {\n  const theme = useTheme();\n\n  const error = theme.palette.error.main;\n\n  const white = theme.palette.common.white;\n  const color = props.error ? error : theme.palette.primary.contrastText;\n  const borderColor = props.error ? error : theme.palette.grey[100];\n\n  const useStyles = makeStyles((theme) => ({\n    root: {\n      position: \"relative\",\n      width: \"100%\",\n    },\n    input: {\n      border: 0,\n      outline: 0,\n      height: 45,\n      color: color,\n      width: \"100%\",\n      borderWidth: 1,\n      display: \"flex\",\n      overflow: \"hidden\",\n      textAlign: \"center\",\n      padding: \"14px 12px\",\n      borderStyle: \"solid\",\n      flexDirection: \"row\",\n      alignItems: \"center\",\n      backgroundColor: white,\n      borderColor: borderColor,\n      transition: \"background-color 200ms cubic-bezier(0.0, 0, 0.2, 1) 0ms\",\n      \"&::placeholder\": {\n        color: color,\n      },\n    },\n    textArea: {\n      border: 0,\n      outline: 0,\n      color: color,\n      width: \"100%\",\n      resize: \"none\",\n      borderWidth: 1,\n      display: \"flex\",\n      overflow: \"hidden\",\n      padding: \"14px 12px\",\n      borderStyle: \"solid\",\n      flexDirection: \"row\",\n      alignItems: \"center\",\n      backgroundColor: white,\n      borderColor: borderColor,\n      transition: \"background-color 200ms cubic-bezier(0.0, 0, 0.2, 1) 0ms\",\n      \"&::placeholder\": {\n        color: color,\n      },\n    },\n    error: {\n      color: error,\n      fontWeight: 400,\n      position: \"absolute\",\n      fontSize: theme.typography.pxToRem(12),\n    },\n  }));\n  const classes = useStyles();\n\n  return (\n    <div className={`${classes.root} ${props.className}`} style={props.style}>\n      {props.textArea ? (\n        <textarea\n          name={props.name}\n          rows={props.rows}\n          value={props.value}\n          onBlur={props.onBlur}\n          onFocus={props.onFocus}\n          onChange={props.onChange}\n          disabled={props.disabled}\n          readOnly={props.readOnly}\n          maxLength={props.maxLength}\n          minLength={props.minLength}\n          className={classes.textArea}\n          placeholder={props.placeholder}\n        />\n      ) : props.type === \"date\" ? (\n        <input\n          type=\"text\"\n          name={props.name}\n          value={props.value}\n          className={classes.input}\n          // startIcon={Images.calender}\n          onChange={props.onChange}\n          disabled={props.disabled}\n          placeholder={props.placeholder}\n          onFocus={(e) => {\n            e.target.type = \"date\";\n            props.focus && props.onFocus(e);\n          }}\n          onBlur={(e) => {\n            if (e.target.value === \"\") {\n              e.target.type = \"text\";\n            }\n            props.onBlur && props.onBlur(e);\n          }}\n        />\n      ) : (\n        <input\n          name={props.name}\n          type={props.type}\n          value={props.value}\n          onBlur={props.onBlur}\n          onFocus={props.onFocus}\n          className={classes.input}\n          onChange={(value) => {\n            if(props.validateSchema){\n              props.validateSchema.validate(value) && props.onChange()\n            }\n          }}\n          disabled={props.disabled}\n          placeholder={props.placeholder}\n        />\n      )}\n      {props.error !== \"\" && (\n        <span className={classes.error}>{props.error}</span>\n      )}\n    </div>\n  );\n}\n","/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Footer.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Card.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/UnAuth/UnAuthHeader.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/components/Input.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/EditSite/index.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/EditSite/EditSiteStep1.js",[],"/Users/abc/Desktop/Ograplan/orgaplan front end/orgaplan-reactjs/src/pages/SuperAdmin/Sites/EditSite/EditSiteStep